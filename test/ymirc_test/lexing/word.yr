use ymirc::lexing::word;
use ymirc::utils::_;

use std::io;

/**
 * A fake file content, so the words have something to point into. The words
 * built below do not have to be a faithful lexing of it, only the locations
 * matter here
 * */
lazy CONTENT = "let x = 12;\nlet y = 1.5;\n";

/**
 * @returns: a location word placed in "a.yr"
 * */
fn loc(str: [c8], line: u64 = 1u64, col: u64 = 0u64, filename: [c8] = "a.yr")-> &Word {
    copy LocWord(str-> str, filename-> filename, fileContent-> CONTENT,
                 line-> line, col-> col, seek-> cast!{usize}(col), lineSeek-> 0us)
}

/**
 * @returns: one word of each concrete kind, all with the content 'str'
 * */
fn allKinds(str: [c8])-> [&Word] {
    copy [copy LocWord(str-> str, filename-> "a.yr", line-> 1u64, col-> 0u64),
     copy NameWord(str, "a.yr", CONTENT, 1u64, 0u64, 0us, 0us),
     copy KeyWord(str, "a.yr", CONTENT, 1u64, 0u64, 0us, 0us),
     copy TokenWord(str, "a.yr", CONTENT, 1u64, 0u64, 0us, 0us),
     copy StringWord(str, EOF_WORD, EOF_WORD, 0us, EOF_WORD, "a.yr", CONTENT, 1u64, 0u64, 0us, 0us),
     copy NumericWord(str, EOF_WORD, NumericNotation::DEC, "a.yr", CONTENT, 1u64, 0u64, 0us, 0us),
     copy FloatWord(str, EOF_WORD, EOF_WORD, EOF_WORD, EOF_WORD, EOF_WORD, FloatNotation::DEC,
                    "a.yr", CONTENT, 1u64, 0u64, 0us, 0us),
     copy EofWord()]
}

/**
 * ======================================================================
 * ==========================     KINDS      ============================
 * ======================================================================
 */

__test a_word_has_one_kind {
    // the hierarchy is flat, so a word belongs to exactly one kind
    for w in allKinds("x") {
        let mut n = 0;
        if w.isLoc { n += 1; }
        if w.isName { n += 1; }
        if w.isKey { n += 1; }
        if w.isToken { n += 1; }
        if w.isString { n += 1; }
        if w.isNumeric { n += 1; }
        if w.isFloat { n += 1; }
        if w.isEof { n += 1; }

        assert(n == 1, format("% kinds matched for %", n, w));
    }
}

__test each_predicate_recognizes_its_kind {
    // and each predicate recognizes its own kind
    let kinds = allKinds("x");
    assert(kinds[0].isLoc);
    assert(kinds[1].isName);
    assert(kinds[2].isKey);
    assert(kinds[3].isToken);
    assert(kinds[4].isString);
    assert(kinds[5].isNumeric);
    assert(kinds[6].isFloat);
    assert(kinds[7].isEof);
}

__test word_length {
    // the length of a word is the length of its content, EOF being empty
    assert(loc("").len == 0us);
    assert(loc("x").len == 1us);
    assert(loc("hello").len == 5us);
    assert(EOF_WORD.len == 0us);
    assert((copy EofWord(filename-> "a.yr", line-> 12u64, col-> 3u64)).len == 0us);
}

/**
 * ======================================================================
 * =======================     COMPARISON      ==========================
 * ======================================================================
 */

__test comparison_with_a_raw_string {
    // comparing against a raw string compares the content, for the kinds that
    // carry only a content
    assert(loc("foo") == "foo");
    assert(loc("foo") != "bar");
    assert((copy NameWord("foo", "a.yr", CONTENT, 1u64, 0u64, 0us, 0us)) == "foo");
    assert((copy KeyWord("if", "a.yr", CONTENT, 1u64, 0u64, 0us, 0us)) == "if");
    assert((copy TokenWord("+", "a.yr", CONTENT, 1u64, 0u64, 0us, 0us)) == "+");
}

__test rich_kinds_never_match_a_raw_string {
    // the kinds that carry more than a content never match a raw string, since
    // the string alone cannot tell whether the rest agrees
    assert((copy StringWord("s", EOF_WORD, EOF_WORD, 0us, EOF_WORD, "a.yr", CONTENT, 1u64, 0u64, 0us, 0us)) != "s");
    assert((copy NumericWord("12", EOF_WORD, NumericNotation::DEC, "a.yr", CONTENT, 1u64, 0u64, 0us, 0us)) != "12");
    assert(EOF_WORD != "");
}

__test equality_on_kind_and_content {
    // two words are equal when they have the same kind and the same content,
    // whatever their location
    for w in allKinds("x") {
        for o in allKinds("x") {
            let same = w.__typeid__ == o.__typeid__;
            assert((w == o) == same,
                   format("% and % should % be equal", w, o, if same { "" } else { "not " }));
        }
    }
}

__test same_kind_with_another_content {
    // the same kind with a different content is not equal
    let a = allKinds("x");
    let b = allKinds("y");
    for i in 0us .. a.len {
        // EOF carries no content, so all EOF words are equal
        if !a[i].isEof {
            assert(a[i] != b[i], format("% and % should differ", a[i], b[i]));
        }
    }
}

__test equality_ignores_the_location {
    // equality ignores the location entirely
    assert(loc("x", line-> 1u64, col-> 0u64) == loc("x", line-> 40u64, col-> 12u64));
    assert(loc("x", filename-> "a.yr") == loc("x", filename-> "b.yr"));
}

__test all_eof_words_are_equal {
    // all EOF words are equal, they carry no content to tell them apart
    assert(EOF_WORD == copy EofWord());
    assert(EOF_WORD == copy EofWord(filename-> "a.yr", line-> 3u64, col-> 7u64));
}

/**
 * ======================================================================
 * ========================     LOCATION      ===========================
 * ======================================================================
 */

__test is_same_loc {
    // isSameLoc compares the location, and only the location
    assert(loc("x", line-> 2u64, col-> 4u64).isSameLoc(loc("completely other", line-> 2u64, col-> 4u64)));

    // any differing component is enough
    assert(!loc("x", line-> 2u64).isSameLoc(loc("x", line-> 3u64)));
    assert(!loc("x", col-> 2u64).isSameLoc(loc("x", col-> 3u64)));
    assert(!loc("x", filename-> "a.yr").isSameLoc(loc("x", filename-> "b.yr")));
}

__test is_same_loc_is_reflexive_and_symmetric {
    // isSameLoc is reflexive and symmetric
    let ws = [loc("x", line-> 1u64, col-> 0u64),
              loc("y", line-> 1u64, col-> 4u64),
              loc("z", line-> 2u64, col-> 0u64),
              EOF_WORD];

    for a in ws {
        assert(a.isSameLoc(a), format("% is not at its own location", a));
        for b in ws {
            assert(a.isSameLoc(b) == b.isSameLoc(a), format("% and % disagree", a, b));
        }
    }
}

__test is_before {
    // a word is before another one on a later line, or further on the same line
    assert(loc("a", line-> 1u64, col-> 0u64).isBefore(loc("b", line-> 2u64, col-> 0u64)));
    assert(loc("a", line-> 1u64, col-> 0u64).isBefore(loc("b", line-> 1u64, col-> 4u64)));
    assert(!loc("a", line-> 2u64, col-> 0u64).isBefore(loc("b", line-> 1u64, col-> 0u64)));
    assert(!loc("a", line-> 1u64, col-> 4u64).isBefore(loc("b", line-> 1u64, col-> 0u64)));
}

__test is_before_is_reflexive {
    // the same location counts as before, so isBefore is reflexive
    let w = loc("a", line-> 3u64, col-> 5u64);
    assert(w.isBefore(w));
    assert(w.isBefore(loc("b", line-> 3u64, col-> 5u64)));
}

__test eof_is_after_everything {
    // EOF is after everything, since it closes the file
    assert(loc("a", line-> 1u64).isBefore(EOF_WORD));
    assert(loc("a", line-> 9999u64).isBefore(EOF_WORD));
    assert(EOF_WORD.isBefore(EOF_WORD));
}

__test words_of_different_files_are_unordered {
    // two words of different files are never ordered, in either direction
    let a = loc("a", line-> 1u64, col-> 0u64, filename-> "a.yr");
    let b = loc("b", line-> 2u64, col-> 0u64, filename-> "b.yr");
    assert(!a.isBefore(b));
    assert(!b.isBefore(a));
}

__test ordering_within_a_file_is_total {
    // ordering the words of a single file is total: of two distinct words, one
    // is before the other
    let ws = [loc("a", line-> 1u64, col-> 0u64),
              loc("b", line-> 1u64, col-> 4u64),
              loc("c", line-> 2u64, col-> 0u64),
              loc("d", line-> 2u64, col-> 8u64),
              loc("e", line-> 7u64, col-> 1u64)];

    for i in 0us .. ws.len {
        for j in 0us .. ws.len {
            assert(ws[i].isBefore(ws[j]) || ws[j].isBefore(ws[i]),
                   format("% and % are not ordered", ws[i], ws[j]));

            // and the order matches the index order, the list being sorted
            if i < j { assert(ws[i].isBefore(ws[j]), format("% should be before %", ws[i], ws[j])); }
        }
    }
}

/**
 * ======================================================================
 * =========================     LOCATE      ============================
 * ======================================================================
 */

__test locate_at_an_absolute_position {
    // locate keeps the file it was called on, and moves to the given position
    let w = loc("let", line-> 1u64, col-> 0u64);
    let n = w.locate("y", 2u64, 4u64, 12us);

    assert(n.str == "y");
    assert(n.filename == "a.yr");
    assert(n.fileContent == CONTENT);
    assert(n.line == 2u64);
    assert(n.col == 4u64);
    assert(n.lineSeek == 12us);

    // the seek of a word is the seek of its line plus its column
    assert(n.seek == 16us);
}

__test locate_relative {
    // the relative overload adds to the current position
    let w = loc("let", line-> 3u64, col-> 2u64);
    let n = w.locate("x", 0u64, 5u64);

    assert(n.line == 3u64);
    assert(n.col == 7u64);
    assert(n.seek == w.seek + 5us);

    // staying on the same line keeps the line seek valid
    assert(n.lineSeek == w.lineSeek);
}

__test locate_on_another_line_drops_the_seek {
    // changing line invalidates the line seek, there is no way to recompute it
    let w = loc("let", line-> 3u64, col-> 2u64);
    let n = w.locate("x", 2u64, 0u64);

    assert(n.line == 5u64);
    assert(n.lineSeek == 0us);
}

__test locate_content_only {
    // the content-only overload keeps the whole location
    let w = loc("let", line-> 3u64, col-> 2u64);
    let n = w.locate("x");

    assert(n.str == "x");
    assert(n.isSameLoc(w));
}

__test locate_always_gives_a_loc_word {
    // whatever the kind it started from, locate produces a location word
    for w in allKinds("x") {
        assert(w.locate("y").isLoc, format("locate on % did not give a LocWord", w));
        assert(w.locate("y", 0u64, 0u64).isLoc);
        assert(w.locate("y", 0u64, 0u64, 0us).isLoc);
    }
}
