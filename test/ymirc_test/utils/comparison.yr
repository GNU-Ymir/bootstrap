use ymirc::utils::comparison;
use ymirc::utils::_;

use std::io;

/**
 * The trait is always implemented on the subclasses of a hierarchy, parameterized by
 * the base type, the way every syntax and generator node of the compiler does it
 * */
@abstract
class Shape {
    pub self () {}

    // the base terminates the chain, the way Declaration and Expression do
    impl Comparable!{&Shape} {
        pub over opEquals(self, _: &Shape)-> bool {
            return true;
        }
    }
}

class Point over Shape {
    pub let x: i32;
    pub let y: i32;

    pub self (x: i32, y: i32) with super(), x = x, y = y {}

    impl Comparable!{&Shape};
}

/**
 * A subclass, to check the fields of the superclass are taken into account
 * */
class Point3D over Point {
    pub let z: i32;

    pub self (x: i32, y: i32, z: i32) with super(x, y), z = z {}

    impl Comparable!{&Shape};
}

/**
 * A second class with the very same fields, to check the dynamic type is checked too
 * */
class Pair over Shape {
    pub let x: i32;
    pub let y: i32;

    pub self (x: i32, y: i32) with super(), x = x, y = y {}

    impl Comparable!{&Shape};
}

__test equal_when_every_field_is {
    // equal iif every field is equal
    let a: &Shape = copy Point(1, 2);

    assert(a == copy Point(1, 2));
    assert(a != copy Point(1, 3));
    assert(a != copy Point(3, 2));
    assert(a != copy Point(2, 1));
}

__test an_instance_equals_itself {
    // the same instance is equal to itself
    let p: &Shape = copy Point(4, 5);
    assert(p == p);
}

__test the_fields_of_the_superclass_count {
    // the fields of the superclass count, not only the ones of the subclass
    let a: &Shape = copy Point3D(1, 2, 3);

    assert(a == copy Point3D(1, 2, 3));
    assert(a != copy Point3D(1, 2, 4));
    assert(a != copy Point3D(9, 2, 3));
}

__test across_a_subclass_boundary {
    // across a subclass boundary equality fails both ways: the trait compares the
    // dynamic types, not merely their compatibility, so a Point is never equal to a
    // Point3D even on the fields a Point knows about
    let a: &Shape = copy Point(1, 2);
    let b: &Shape = copy Point3D(1, 2, 0);

    assert(a != b, "a superclass instance must not accept a subclass one");
    assert(b != a, "the subclass view refuses a bare superclass instance");
}

__test unrelated_classes_with_the_same_fields {
    // two unrelated classes carrying the same fields are not equal either
    let a: &Shape = copy Point(1, 2);
    let b: &Shape = copy Pair(1, 2);

    assert(a != b);
    assert(b != a);
}

__test symmetry {
    // within a single dynamic type equality is symmetric
    let a1: &Shape = copy Point(0, 0), a2: &Shape = copy Point(1, 0);
    let a3: &Shape = copy Point(0, 1), a4: &Shape = copy Pair(0, 0);
    let ps = [a1, a2, a3, a4];

    for a in ps {
        for b in ps {
            assert((a == b) == (b == a), "equality is not symmetric");
        }
    }
}

__test transitivity {
    // and transitive on the values that are equal
    let a: &Shape = copy Point(7, 8);
    let b: &Shape = copy Point(7, 8);
    let c: &Shape = copy Point(7, 8);

    assert(a == b && b == c && a == c);
}
