use ymirc::utils::format;
use ymirc::utils::_;

use std::io;

/**
 * ======================================================================
 * ==========================     FORMAT      ===========================
 * ======================================================================
 */

__test {
    // every '%' takes the next argument, in order
    assert(format("x = %, y = %", 1, 2) == "x = 1, y = 2");
    assert(format("%", 42) == "42");
    assert(format("%%", 1, 2) == "12");

    // a format without any placeholder is written as it is
    assert(format("no args") == "no args");
    assert(format("") == "");
}

__test {
    // primitives are written the way they read in the source
    assert(format("%", true) == "true");
    assert(format("%", false) == "false");
    assert(format("%", 'a'c8) == "a");
    assert(format("%", "str") == "str");
    assert(format("%", -7) == "-7");
}

__test {
    // slices and tuples have a structural form
    assert(format("%", [1, 2, 3]) == "[1, 2, 3]");
    assert(format("%", [""]) == "[]");
    assert(format("%", (1, 'a'c8)) == "(1,a)");
}

/**
 * ======================================================================
 * =========================     FORMATTER      =========================
 * ======================================================================
 */

__test {
    // a Formatter accumulates, and reading it back does not consume it
    let dmut s = copy Formatter();
    s:.write("a");
    s:.write('b'c8);
    s:.write(3);

    assert(s[] == "ab3");
    assert(s[] == "ab3", "reading the formatter twice gives the same text");
}

__test {
    // writes chain, so a whole line can be built in one expression
    let dmut s = copy Formatter();
    s:.write("a"):.write("b"):.write("c");

    assert(s[] == "abc");
}

__test {
    let dmut s = copy Formatter();
    s:.write([1, 2, 3]);

    assert(s[] == "[1, 2, 3]");
}

/**
 * ======================================================================
 * ========================     INDENTATION      ========================
 * ======================================================================
 */

__test {
    // entabing indents what follows every newline, until detabing
    let dmut s = copy Formatter();
    s:.write("a\n");
    s:.entabing();
    s:.write("b\n");
    s:.write("b2\n");
    s:.detabing();
    s:.write("c");

    assert(s[] == "a\n    b\n    b2\nc");
}

__test {
    // the indentation string is a parameter
    let dmut s = copy Formatter();
    s:.entabing(txt-> "..");
    s:.write("x\ny");

    assert(s[] == "x\n..y");
}

/**
 * ======================================================================
 * ===========================     COLORS      ==========================
 * ======================================================================
 */

__test {
    // '%(x)' colors the argument it takes, and restores the previous state after
    let dmut s = copy Formatter();
    s:.writef("%(r)", 42);

    assert(s[] == format("%%%", Colors::RED, 42, Colors::RESET));
}

__test {
    let colors = [('r'c8, Colors::RED), ('b'c8, Colors::BLUE), ('y'c8, Colors::YELLOW),
                  ('p'c8, Colors::PURPLE), ('g'c8, Colors::GREEN), ('B'c8, Colors::BOLD)];

    for c in colors {
        let dmut s = copy Formatter();
        s:.writef("%(" ~ [c.0] ~ ")", 1);

        assert(s[] == format("%%%", c.1, 1, Colors::RESET),
               format("the % directive did not color its argument", c.0));
    }
}

__test {
    // '@(x=...)' colors a literal piece of the format itself
    let dmut s = copy Formatter();
    s:.writef("a @(g=hi) b %", 7);

    assert(s[] == "a " ~ format("%%%", Colors::GREEN, "hi", Colors::RESET) ~ " b 7");
}

__test {
    // '@(x=...)' is only understood by the overloads that take an argument, the
    // one that takes none writes the directive out as it is
    let dmut s = copy Formatter();
    s:.writef("@(g=hi) there");

    assert(s[] == "@(g=hi) there");
}

/**
 * ======================================================================
 * ==========================     OPTIONS      ==========================
 * ======================================================================
 */

__test {
    // an option is written through its constructor, so an empty one stays visible
    let a : (i32)? = (12)?;
    let b : (i32)? = none;

    assert(format("%", a) == "Ok(12)");
    assert(format("%", b) == "Err()");
}

/**
 * ======================================================================
 * =========================     FORMATTAGS      ========================
 * ======================================================================
 */

__test {
    // the tags default to off, and travel with the formatter
    let d = FormatTags();
    assert(!d.withParams && !d.withErrorIds && !d.withVarIds && !d.forParams);
    assert(!d.forDebug && !d.verbose && !d.short && !d.withVars);

    let t = FormatTags(withParams-> true, forDebug-> true);
    assert(t.withParams && t.forDebug);
    assert(!t.verbose && !t.short);

    let dmut s = copy Formatter(tags-> t);
    assert(s.tags.withParams && s.tags.forDebug);
}

/**
 * ======================================================================
 * ==========================     YIL IDS      ==========================
 * ======================================================================
 */

__test {
    // yil ids are handed out in order, and are stable for a given input
    let dmut s = copy Formatter();
    let a = s:.getYilId(100us);
    let b = s:.getYilId(200us);

    assert(a != b, "two different values must not share an id");
    assert(s:.getYilId(100us) == a, "the id of a value must not change");
    assert(s:.getYilId(200us) == b);
}

__test {
    // written errors and values are remembered, so a cycle prints only once
    let dmut s = copy Formatter();
    assert(!s.hasWrittenError(1us));
    assert(!s.hasWrittenValue(1us));
    assert(!s.hasWrittenSomeErrors());

    s:.registerError(1us);
    assert(s.hasWrittenError(1us));
    assert(!s.hasWrittenError(2us));

    s:.registerValue(1us);
    assert(s.hasWrittenValue(1us));
    assert(!s.hasWrittenValue(2us));

    s:.wroteErrors(true);
    assert(s.hasWrittenSomeErrors());
}
