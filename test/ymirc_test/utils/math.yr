use ymirc::utils::math;
use ymirc::utils::_;

use std::io;

__test abs {
    assert(abs(0is) == 0is);
    assert(abs(7is) == 7is);
    assert(abs(-7is) == 7is);
}

__test next_pow2_of_a_usize {
    // the usize overload
    assert(nextPow2(0us) == 1us);
    assert(nextPow2(1us) == 1us);
    assert(nextPow2(2us) == 2us);
    assert(nextPow2(3us) == 4us);
    assert(nextPow2(5us) == 8us);
    assert(nextPow2(8us) == 8us);
    assert(nextPow2(9us) == 16us);
    assert(nextPow2(1000us) == 1024us);
    assert(nextPow2(1024us) == 1024us);
    assert(nextPow2(1025us) == 2048us);
}

__test the_two_next_pow2_overloads_agree {
    // the u32 overload agrees with it over the range they share
    for i in 0u32 .. 300u32 {
        assert(cast!{usize}(nextPow2(i)) == nextPow2(cast!{usize}(i)),
               format("the two overloads disagree on %", i));
    }
}

__test a_power_of_two_is_its_own_next_one {
    // an exact power of two is its own next power of two
    let mut p = 1us;
    for _ in 0us .. 40us {
        assert(nextPow2(p) == p, format("% is already a power of 2", p));
        p *= 2us;
    }
}

__test next_pow2_is_the_closest_power_of_two {
    // and the result is always a power of two, no smaller than the input
    for i in 1us .. 200us {
        let n = nextPow2(i);
        assert(n >= i, format("nextPow2(%) went backward", i));
        assert((n & (n - 1us)) == 0us, format("nextPow2(%) = % is not a power of 2", i, n));
        assert(n / 2us < i, format("nextPow2(%) = % is not the closest one", i, n));
    }
}
