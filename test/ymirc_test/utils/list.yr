use ymirc::utils::list;
use ymirc::utils::_;

use std::io;

__test a_fresh_list_is_empty {
    // a fresh list is empty
    let dmut l = copy List!{i32}();

    assert(l.isEmpty);
    assert(l.len == 0us);
    assert(l[] == []);
}

__test push_and_access {
    let dmut l = copy List!{i32}();
    l:.push(1);
    l:.push(2);
    l:.push(3);

    assert(!l.isEmpty);
    assert(l.len == 3us);
    assert(l[] == [1, 2, 3]);
    assert(l[0us] == 1);
    assert(l[2us] == 3);
    assert(l.front == 1);
    assert(l.back == 3);
}

__test growing_past_the_initial_capacity {
    // pushing past the initial capacity grows the storage without losing anything
    let dmut l = copy List!{usize}();
    for i in 0us .. 1000us {
        l:.push(i);
    }

    assert(l.len == 1000us);
    assert(l.front == 0us);
    assert(l.back == 999us);

    for i in 0us .. 1000us {
        assert(l[i] == i, format("element % was lost while growing", i));
    }
}

__test pop {
    let dmut l = copy List!{i32}();
    l:.push(1);
    l:.push(2);
    l:.push(3);

    l:.pop();
    assert(l.len == 2us);
    assert(l.back == 2);
    assert(l[] == [1, 2]);

    l:.pop();
    l:.pop();
    assert(l.isEmpty);

    // popping an empty list is a no-op rather than an error
    l:.pop();
    assert(l.isEmpty);
    assert(l.len == 0us);
}

__test clear_and_reuse {
    let dmut l = copy List!{i32}();
    for i in 0 .. 10 {
        l:.push(i);
    }

    l:.clear();
    assert(l.isEmpty);
    assert(l.len == 0us);
    assert(l[] == []);

    // the list is usable again after a clear, and starts from scratch
    l:.push(42);
    assert(l.len == 1us);
    assert(l[] == [42]);
    assert(l.front == 42 && l.back == 42);
}

__test a_list_of_slices {
    // a list of slices, to check the element type is not restricted to scalars
    let dmut l = copy List!{[c8]}();
    l:.push("a");
    l:.push("bb");

    assert(l.len == 2us);
    assert(l.front == "a");
    assert(l.back == "bb");
}
