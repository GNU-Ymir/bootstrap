use ymirc::utils::bigint;
use ymirc::utils::_;

use std::io;

/**
 * ======================================================================
 * ==========================     PARSING      ==========================
 * ======================================================================
 */

__test {
    // a BigInt is built from a string, and printed back the same way
    assert(format("%", copy BigInt("0")) == "0");
    assert(format("%", copy BigInt("42")) == "42");
    assert(format("%", copy BigInt("-42")) == "-42");

    // wider than any native integer, which is the whole point of the type
    let big = "123456789012345678901234567890";
    assert(format("%", copy BigInt(big)) == big);
    assert(format("%", copy BigInt("-" ~ big)) == "-" ~ big);
}

__test {
    // the base is a parameter of the constructor
    assert(format("%", copy BigInt("ff", base-> 16u32)) == "255");
    assert(format("%", copy BigInt("FF", base-> 16u32)) == "255");
    assert(format("%", copy BigInt("0", base-> 16u32)) == "0");
    assert(format("%", copy BigInt("777", base-> 8u32)) == "511");
    assert(format("%", copy BigInt("1011", base-> 2u32)) == "11");
    assert(format("%", copy BigInt("-ff", base-> 16u32)) == "-255");
}

__test {
    // every native integer type has its own constructor
    assert(format("%", copy BigInt(0u8)) == "0");
    assert(format("%", copy BigInt(255u8)) == "255");
    assert(format("%", copy BigInt(i8::min)) == "-128");
    assert(format("%", copy BigInt(65535u16)) == "65535");
    assert(format("%", copy BigInt(i32::min)) == "-2147483648");
    assert(format("%", copy BigInt(4294967295u32)) == "4294967295");
    assert(format("%", copy BigInt(9223372036854775807i64)) == "9223372036854775807");
    assert(format("%", copy BigInt(18446744073709551615u64)) == "18446744073709551615");
}

/**
 * ======================================================================
 * ========================     ARITHMETIC      =========================
 * ======================================================================
 */

__test {
    let a = copy BigInt("100"), b = copy BigInt("7");

    assert(format("%", a + b) == "107");
    assert(format("%", a - b) == "93");
    assert(format("%", b - a) == "-93");
    assert(format("%", a * b) == "700");
}

__test {
    // an operand that is not a BigInt is converted to one
    let a = copy BigInt("100");

    assert(format("%", a + 7) == "107");
    assert(format("%", a - 7) == "93");
    assert(format("%", a * 7) == "700");

    // and the same with the BigInt on the right
    assert(format("%", 7 + a) == "107");
    assert(format("%", 7 - a) == "-93");
    assert(format("%", 7 * a) == "700");
}

__test {
    // the result does not wrap, whatever the size of the operands
    let max = copy BigInt(18446744073709551615u64);

    assert(format("%", max + 1) == "18446744073709551616");
    assert(format("%", max * max) == "340282366920938463426481119284349108225");
}

__test {
    // exponentiation
    let two = copy BigInt("2");

    assert(format("%", two ^^ 0) == "1");
    assert(format("%", two ^^ 10) == "1024");
    assert(format("%", two ^^ 64) == "18446744073709551616");
}

/**
 * ======================================================================
 * ==========================     DIVISION      =========================
 * ======================================================================
 */

__test {
    let a = copy BigInt("100"), b = copy BigInt("7");

    assert(format("%", a / b) == "14");
    assert(format("%", a % b) == "2");
} catch {
    err: &AssertError => throw err;
    _: &BigIntError => { assert(false, "no division by zero here"); }
}

__test {
    // the quotient is truncated toward zero, and the remainder keeps the sign of the
    // dividend, which is what the language expects of '/' and '%'
    assert(format("%", copy BigInt("-7") / copy BigInt("2")) == "-3");
    assert(format("%", copy BigInt("7") / copy BigInt("-2")) == "-3");
    assert(format("%", copy BigInt("-7") / copy BigInt("-2")) == "3");

    assert(format("%", copy BigInt("-7") % copy BigInt("2")) == "-1");
    assert(format("%", copy BigInt("7") % copy BigInt("-2")) == "1");
    assert(format("%", copy BigInt("-7") % copy BigInt("-2")) == "-1");
} catch {
    err: &AssertError => throw err;
    _: &BigIntError => { assert(false, "no division by zero here"); }
}

__test {
    // dividing by zero is an error, not a crash
    let mut caught = false;
    {
        let _ = copy BigInt("1") / copy BigInt("0");
    } catch {
        _: &BigIntError => { caught = true; }
    }

    assert(caught, "a division by zero must throw");
}

__test {
    let mut caught = false;
    {
        let _ = copy BigInt("1") % copy BigInt("0");
    } catch {
        _: &BigIntError => { caught = true; }
    }

    assert(caught, "a modulo by zero must throw");
}

/**
 * ======================================================================
 * ========================     COMPARISON      =========================
 * ======================================================================
 */

__test {
    let a = copy BigInt("10"), b = copy BigInt("20"), c = copy BigInt("10");

    assert(a < b);
    assert(b > a);
    assert(a <= c);
    assert(a >= c);
    assert(a == c);
    assert(a != b);

    // comparison against a native value goes through the same operator
    assert(a == 10);
    assert(a < 20);
    assert(a > 9);
}

__test {
    // signs are ordered the way they should be, even far outside native ranges
    let neg = copy BigInt("-123456789012345678901234567890");
    let pos = copy BigInt("123456789012345678901234567890");

    assert(neg < pos);
    assert(neg < 0);
    assert(pos > 0);
    assert(neg < copy BigInt(i64::min));
}

__test {
    assert(format("%", (copy BigInt("-42")).abs()) == "42");
    assert(format("%", (copy BigInt("42")).abs()) == "42");
    assert(format("%", (copy BigInt("0")).abs()) == "0");
}

/**
 * ======================================================================
 * =======================     CONVERSIONS      =========================
 * ======================================================================
 */

__test {
    // 'to' converts to a native type when the value fits
    assert((copy BigInt("42")).to!{i32}() == 42);
    assert((copy BigInt("-42")).to!{i32}() == -42);
    assert((copy BigInt("2147483647")).to!{i32}() == 2147483647);
    assert((copy BigInt("-2147483648")).to!{i32}() == i32::min);
    assert((copy BigInt("255")).to!{u8}() == 255u8);
} catch {
    err: &AssertError => throw err;
    _: &BigIntError => { assert(false, "all these values fit"); }
}

__test {
    // and refuses when it does not, rather than silently truncating
    for v in ["2147483648", "-2147483649", "99999999999999999999"] {
        let mut caught = false;
        {
            let _ = (copy BigInt(v)).to!{i32}();
        } catch {
            _: &BigIntError => { caught = true; }
        }

        assert(caught, format("% does not fit in an i32", v));
    }
}

__test {
    // an unsigned target refuses a negative value
    let mut caught = false;
    {
        let _ = (copy BigInt("-1")).to!{u32}();
    } catch {
        _: &BigIntError => { caught = true; }
    }

    assert(caught, "-1 does not fit in a u32");
}
