use ymirc::utils::string;
use ymirc::utils::_;

use std::io;

/**
 * ======================================================================
 * ==========================     FINDLAST      =========================
 * ======================================================================
 */

__test {
    assert(findLast("abcabc", 'a'c8) == 3us);
    assert(findLast("abcabc", 'c'c8) == 5us);
    assert(findLast("a", 'a'c8) == 0us);

    // a character that is not there gives back the length of the string, the
    // callers rely on that sentinel rather than on an option
    assert(findLast("abc", 'z'c8) == 3us);
    assert(findLast("", 'z'c8) == 0us);
}

__test {
    // the utf32 overload behaves the same
    assert(findLast("abcabc"s32, 'a'c32) == 3us);
    assert(findLast("abc"s32, 'z'c32) == 3us);
}

/**
 * ======================================================================
 * ===========================     SHORTEN      =========================
 * ======================================================================
 */

__test {
    // the marker is passed explicitly, the default one carries color codes
    let add = "[...]";

    // the documented example
    assert(shorten("abcdefghijklmnopqrstuvwxyz", max-> 10u64, add-> add) == "abc[...]yz");

    // a string shorter than the limit is left alone
    assert(shorten("abc", max-> 10u64, add-> add) == "abc");
    assert(shorten("", max-> 10u64, add-> add) == "");
}

__test {
    let add = "[...]";

    // the result never exceeds the limit
    for n in [10us, 12us, 20us, 30us] {
        let res = shorten("abcdefghijklmnopqrstuvwxyz", max-> cast!{u64}(n), add-> add);
        assert(res.len <= n, format("shorten to % gave % chars", n, res.len));
    }
}

/**
 * ======================================================================
 * ============================     CENTER      =========================
 * ======================================================================
 */

__test {
    assert(center("test", 10us) == "   test   ");

    // an odd padding puts the extra character on the right
    assert(center("test", 9us) == "  test   ");

    // no room to pad, the string comes back untouched
    assert(center("test", 4us) == "test");
    assert(center("test", 2us) == "test");
}

__test {
    // the padding character is a parameter
    assert(center("ab", 6us, concat-> '-'c8) == "--ab--");

    // whatever the width, the result is exactly that wide when it pads at all
    for n in [5us, 6us, 7us, 8us] {
        assert(center("ab", n).len == n, format("center to % gave the wrong width", n));
    }
}

/**
 * ======================================================================
 * =====================     LEVENSHTEIN      ===========================
 * ======================================================================
 */

__test {
    // the distance to oneself is zero, and it is symmetric
    assert(levenshteinDistance("", "") == 0us);
    assert(levenshteinDistance("kitten", "kitten") == 0us);

    // an empty operand costs the length of the other one
    assert(levenshteinDistance("", "abc") == 3us);
    assert(levenshteinDistance("abc", "") == 3us);
}

__test {
    // one edit of each kind
    assert(levenshteinDistance("abc", "abd") == 1us);   // substitution
    assert(levenshteinDistance("abc", "abcd") == 1us);  // insertion
    assert(levenshteinDistance("abcd", "abc") == 1us);  // deletion

    // the textbook case
    assert(levenshteinDistance("kitten", "sitting") == 3us);
    assert(levenshteinDistance("saturday", "sunday") == 3us);
}

__test {
    // symmetry, on the pairs a suggestion engine actually sees
    let pairs = [("lenght", "length"), ("recieve", "receive"), ("fro", "for"),
                 ("validaor", "validator"), ("", "x")];

    for p in pairs {
        assert(levenshteinDistance(p.0, p.1) == levenshteinDistance(p.1, p.0),
               format("% and % are not symmetric", p.0, p.1));
    }
}

/**
 * ======================================================================
 * ========================     STRIPUNDERS      ========================
 * ======================================================================
 */

__test {
    // the documented examples
    assert(stripUnders("__foo") == "foo");
    assert(stripUnders("foo__") == "foo");
    assert(stripUnders("_a_b_") == "a_b");
    assert(stripUnders("___") == "");

    // nothing to strip
    assert(stripUnders("foo") == "foo");
    assert(stripUnders("") == "");

    // only the outer underscores go, the inner ones are kept as they are
    assert(stripUnders("__a__b__") == "a__b");
}

/**
 * ======================================================================
 * ======================     MAXLINELENGTH      ========================
 * ======================================================================
 */

__test {
    // the longest line wins, the newline itself is not counted
    assert(maxLineLength("ab\nabcd\nabc") == 4us);
    assert(maxLineLength("abcd\nab") == 4us);

    // no newline at all, the whole string is the line
    assert(maxLineLength("abc") == 3us);
    assert(maxLineLength("") == 0us);
}
