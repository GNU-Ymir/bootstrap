use ymirc::utils::string;
use ymirc::utils::_;

use std::io;

/**
 * ======================================================================
 * ==========================     FINDLAST      =========================
 * ======================================================================
 */

__test find_last {
    assert(findLast("abcabc", 'a'c8) == 3us);
    assert(findLast("abcabc", 'c'c8) == 5us);
    assert(findLast("a", 'a'c8) == 0us);

    // a character that is not there gives back the length of the string, the
    // callers rely on that sentinel rather than on an option
    assert(findLast("abc", 'z'c8) == 3us);
    assert(findLast("", 'z'c8) == 0us);
}

__test find_last_on_utf32 {
    // the utf32 overload behaves the same
    assert(findLast("abcabc"s32, 'a'c32) == 3us);
    assert(findLast("abc"s32, 'z'c32) == 3us);
}

/**
 * ======================================================================
 * ===========================     SHORTEN      =========================
 * ======================================================================
 */

__test shorten {
    // the marker is passed explicitly, the default one carries color codes
    let add = "[...]";

    // the documented example
    assert(shorten("abcdefghijklmnopqrstuvwxyz", max-> 10u64, add-> add) == "abc[...]yz");

    // a string shorter than the limit is left alone
    assert(shorten("abc", max-> 10u64, add-> add) == "abc");
    assert(shorten("", max-> 10u64, add-> add) == "");
}

__test shorten_never_exceeds_the_limit {
    let add = "[...]";

    // the result never exceeds the limit
    for n in [10us, 12us, 20us, 30us] {
        let res = shorten("abcdefghijklmnopqrstuvwxyz", max-> cast!{u64}(n), add-> add);
        assert(res.len <= n, format("shorten to % gave % chars", n, res.len));
    }
}

/**
 * ======================================================================
 * =====================     VISIBLE WIDTH      =========================
 * ======================================================================
 */

/**
 * The escapes are written out rather than taken from Colors, which is empty in
 * a NO_COLORS build. What is measured here is the colored output a user sees on
 * a terminal, and that is exactly what the goldens cannot state
 * */
lazy BOLD = "\u{0x001B}[1;50m";
lazy RESET = "\u{0x001B}[0m";

__test skip_ansi {
    // nothing to skip, the index comes back untouched
    assert(skipAnsi("abc", 0us) == 0us);
    assert(skipAnsi("abc", 2us) == 2us);

    // past the end
    assert(skipAnsi("abc", 3us) == 3us);
    assert(skipAnsi("", 0us) == 0us);

    // a whole sequence is skipped, whatever its parameters
    assert(skipAnsi(BOLD, 0us) == BOLD.len);
    assert(skipAnsi(RESET, 0us) == RESET.len);
    assert(skipAnsi(BOLD ~ "abc", 0us) == BOLD.len);

    // and only that one, a second sequence is a second skip
    assert(skipAnsi(BOLD ~ RESET, BOLD.len) == BOLD.len + RESET.len);
}

__test skip_ansi_on_malformed_escapes {
    // an escape that is not the start of a sequence is skipped alone, it is not
    // printed either
    assert(skipAnsi("\u{0x001B}", 0us) == 1us);
    assert(skipAnsi("\u{0x001B}x", 0us) == 1us);

    // a sequence with no final byte runs to the end of the string
    assert(skipAnsi("\u{0x001B}[1;5", 0us) == 5us);
}

__test visible_width_counts_columns_not_bytes {
    // plain ascii, a byte is a column
    assert(visibleWidth("abc") == 3us);
    assert(visibleWidth("") == 0us);

    // color costs bytes and no column at all
    assert(visibleWidth(BOLD ~ "abc" ~ RESET) == 3us);
    assert(visibleWidth(BOLD ~ RESET) == 0us);

    // a multi byte character is one column, not one per byte
    assert(visibleWidth("é") == 1us);
    assert(visibleWidth("café") == 4us);
    assert("café".len == 5us);

    // a tab is one byte and counted as one, the terminal decides how wide it is
    assert(visibleWidth("a\tb") == 3us);
}

__test the_elision_marker_is_wider_in_bytes_than_in_columns {
    // this is the whole of YMI-223: shorten bakes the color into its marker, so
    // the result is 'max' bytes of which the escapes are invisible, and a caret
    // indented by one space per byte lands that many columns too far right
    let add = BOLD ~ "[...]" ~ RESET;
    assert(add.len == 16us);
    assert(visibleWidth(add) == 5us);

    let mut long = "";
    for _ in 0us .. 12us {
        long ~= "abcdefghij";
    }

    let short = shorten(long, add-> add);
    assert(short.len == 100us);
    assert(visibleWidth(short) == short.len - (BOLD.len + RESET.len));
}

/**
 * ======================================================================
 * ============================     CENTER      =========================
 * ======================================================================
 */

__test center {
    assert(center("test", 10us) == "   test   ");

    // an odd padding puts the extra character on the right
    assert(center("test", 9us) == "  test   ");

    // no room to pad, the string comes back untouched
    assert(center("test", 4us) == "test");
    assert(center("test", 2us) == "test");
}

__test the_padding_character_is_a_parameter {
    // the padding character is a parameter
    assert(center("ab", 6us, concat-> '-'c8) == "--ab--");

    // whatever the width, the result is exactly that wide when it pads at all
    for n in [5us, 6us, 7us, 8us] {
        assert(center("ab", n).len == n, format("center to % gave the wrong width", n));
    }
}

/**
 * ======================================================================
 * =====================     LEVENSHTEIN      ===========================
 * ======================================================================
 */

__test levenshtein_on_trivial_cases {
    // the distance to oneself is zero, and it is symmetric
    assert(levenshteinDistance("", "") == 0us);
    assert(levenshteinDistance("kitten", "kitten") == 0us);

    // an empty operand costs the length of the other one
    assert(levenshteinDistance("", "abc") == 3us);
    assert(levenshteinDistance("abc", "") == 3us);
}

__test levenshtein_on_single_edits {
    // one edit of each kind
    assert(levenshteinDistance("abc", "abd") == 1us);   // substitution
    assert(levenshteinDistance("abc", "abcd") == 1us);  // insertion
    assert(levenshteinDistance("abcd", "abc") == 1us);  // deletion

    // the textbook case
    assert(levenshteinDistance("kitten", "sitting") == 3us);
    assert(levenshteinDistance("saturday", "sunday") == 3us);
}

__test levenshtein_is_symmetric {
    // symmetry, on the pairs a suggestion engine actually sees
    let pairs = [("lenght", "length"), ("recieve", "receive"), ("fro", "for"),
                 ("validaor", "validator"), ("", "x")];

    for p in pairs {
        assert(levenshteinDistance(p.0, p.1) == levenshteinDistance(p.1, p.0),
               format("% and % are not symmetric", p.0, p.1));
    }
}

/**
 * ======================================================================
 * ========================     STRIPUNDERS      ========================
 * ======================================================================
 */

__test strip_unders {
    // the documented examples
    assert(stripUnders("__foo") == "foo");
    assert(stripUnders("foo__") == "foo");
    assert(stripUnders("_a_b_") == "a_b");
    assert(stripUnders("___") == "");

    // nothing to strip
    assert(stripUnders("foo") == "foo");
    assert(stripUnders("") == "");

    // only the outer underscores go, the inner ones are kept as they are
    assert(stripUnders("__a__b__") == "a__b");
}

/**
 * ======================================================================
 * ======================     MAXLINELENGTH      ========================
 * ======================================================================
 */

__test max_line_length {
    // the longest line wins, the newline itself is not counted
    assert(maxLineLength("ab\nabcd\nabc") == 4us);
    assert(maxLineLength("abcd\nab") == 4us);

    // no newline at all, the whole string is the line
    assert(maxLineLength("abc") == 3us);
    assert(maxLineLength("") == 0us);
}

/**
 * ======================================================================
 * =============================     MD5      ===========================
 * ======================================================================
 */

/**
 * @returns: the bytes of 'txt', md5 works on raw data rather than on text
 * */
fn bytes(txt: [c8])-> [u8] {
    let mut res: [u8] = [];
    for c in txt {
        res ~= [cast!{u8}(c)];
    }

    res
}

__test md5_over_the_rfc_1321_vectors {
    // the test suite of rfc 1321, so a rewrite of the digest can be trusted
    let vectors = [("", "d41d8cd98f00b204e9800998ecf8427e"),
                   ("a", "0cc175b9c0f1b6a831c399e269772661"),
                   ("abc", "900150983cd24fb0d6963f7d28e17f72"),
                   ("message digest", "f96b697d7cb7938d525a2f31aaf161d0"),
                   ("abcdefghijklmnopqrstuvwxyz", "c3fcd3d76192e4007dfb496cca67e13b"),
                   ("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789",
                    "d174ab98d277d9f5a5611c2c9f419d9f"),
                   ("12345678901234567890123456789012345678901234567890123456789012345678901234567890",
                    "57edf4a22be3c955ac49da2e2107b67a")];

    for v in vectors {
        assert(md5(bytes(v.0)) == v.1, format("md5 of % gave %", v.0, md5(bytes(v.0))));
    }
}

__test an_md5_digest_is_32_hex_characters {
    // the digest is always 32 lowercase hexadecimal characters, whatever the length
    // of the input, which is what the mangler relies on
    for n in [0us, 1us, 55us, 56us, 63us, 64us, 65us, 119us, 120us, 200us] {
        let mut txt = "";
        for i in 0us .. n {
            txt ~= ["abcdefghijklmnopqrstuvwxyz"[i % 26us]];
        }

        let h = md5(bytes(txt));
        assert(h.len == 32us, format("a % byte input gave a % char digest", n, h.len));
        for c in h {
            assert((c >= '0'c8 && c <= '9'c8) || (c >= 'a'c8 && c <= 'f'c8),
                   format("% is not a lowercase hex digit", c));
        }
    }
}
