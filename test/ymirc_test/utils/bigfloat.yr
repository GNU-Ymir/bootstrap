use ymirc::utils::{bigfloat, bigint};
use ymirc::utils::_;

use std::io;

/**
 * ======================================================================
 * ==========================     PARSING      ==========================
 * ======================================================================
 */

__test from_a_f64 {
    // printing goes through mpfr "%Rg", which keeps 6 significant digits and
    // drops a trailing '.0'
    assert(format("%", copy BigFloat(1.5)) == "1.5");
    assert(format("%", copy BigFloat(2.25)) == "2.25");
    assert(format("%", copy BigFloat(-3.75)) == "-3.75");
    assert(format("%", copy BigFloat(100.0)) == "100");
    assert(format("%", copy BigFloat(0.0)) == "0");
    assert(format("%", copy BigFloat::zero()) == "0");
}

__test from_a_string {
    // built from a string, in any base
    assert(format("%", copy BigFloat("1.5")) == "1.5");
    assert(format("%", copy BigFloat("-2.25")) == "-2.25");
    assert(format("%", copy BigFloat("0.5")) == "0.5");
    assert(format("%", copy BigFloat("1e10")) == "1e+10");
    assert(format("%", copy BigFloat("1e-10")) == "1e-10");

    // more digits than the print precision, the value is kept but the print is cut
    assert(format("%", copy BigFloat("0.3333333333333333333333")) == "0.333333");
}

__test from_a_f32 {
    // an f32 goes through the f64 constructor
    assert(format("%", copy BigFloat(1.5f)) == "1.5");
    assert(format("%", copy BigFloat(0.5f)) == "0.5");
}

__test from_a_bigint {
    // and a BigFloat can be built from a BigInt, without losing anything
    assert(format("%", copy BigFloat(copy BigInt("42"))) == "42");
    assert(format("%", copy BigFloat(copy BigInt("-42"))) == "-42");
    assert(format("%", copy BigFloat(copy BigInt("0"))) == "0");
}

__test hexadecimal_form {
    // the hexadecimal form is the exact binary value, not a rounded decimal
    assert((copy BigFloat(1.5)).toHexString() == "0X1.8P+0");
}

/**
 * ======================================================================
 * ======================     NAN AND INFINITY      =====================
 * ======================================================================
 */

__test nan_and_infinities {
    let nan = copy BigFloat::nan();
    let pinf = copy BigFloat::inf(true);
    let ninf = copy BigFloat::inf(false);

    assert(nan.isNan);
    assert(!nan.isPositiveInf && !nan.isNegativeInf);

    assert(pinf.isPositiveInf && !pinf.isNegativeInf && !pinf.isNan);
    assert(ninf.isNegativeInf && !ninf.isPositiveInf && !ninf.isNan);

    assert(format("%", nan) == "nan");
    assert(format("%", pinf) == "inf");
    assert(format("%", ninf) == "-inf");
}

__test a_finite_value_is_neither {
    // a finite value is neither
    let one = copy BigFloat(1.0);
    assert(!one.isNan && !one.isPositiveInf && !one.isNegativeInf);
}

__test nan_propagates {
    // nan swallows everything it touches
    let nan = copy BigFloat::nan(), one = copy BigFloat(1.0);

    assert((nan + one).isNan);
    assert((one + nan).isNan);
    assert((nan - one).isNan);
    assert((nan * one).isNan);
}

__test arithmetic_on_infinities {
    let pinf = copy BigFloat::inf(true), ninf = copy BigFloat::inf(false);
    let one = copy BigFloat(1.0);

    // same sign adds up, opposite signs are undefined
    assert((pinf + pinf).isPositiveInf);
    assert((ninf + ninf).isNegativeInf);
    assert((pinf + ninf).isNan);
    assert((ninf + pinf).isNan);

    // an infinity absorbs any finite operand
    assert((pinf + one).isPositiveInf);
    assert((one + pinf).isPositiveInf);
    assert((ninf + one).isNegativeInf);
}

/**
 * ======================================================================
 * ========================     ARITHMETIC      =========================
 * ======================================================================
 */

__test arithmetic {
    let a = copy BigFloat(1.5), b = copy BigFloat(0.25);

    assert(format("%", a + b) == "1.75");
    assert(format("%", a - b) == "1.25");
    assert(format("%", b - a) == "-1.25");
    assert(format("%", a * b) == "0.375");
}

__test a_native_operand_is_converted {
    // a native operand is converted first, on either side
    let a = copy BigFloat(1.5);

    assert(format("%", a + 1.0) == "2.5");
    assert(format("%", a * 2.0) == "3");
    assert(format("%", 1.0 + a) == "2.5");
    assert(format("%", 1.0 - a) == "-0.5");
}

__test exponentiation {
    let two = copy BigFloat(2.0);

    assert(format("%", two ^^ 0i64) == "1");
    assert(format("%", two ^^ 10i64) == "1024");
}

/**
 * ======================================================================
 * ==========================     DIVISION      =========================
 * ======================================================================
 */

__test division_and_modulo {
    {
        assert(format("%", copy BigFloat(3.0) / copy BigFloat(2.0)) == "1.5");
        assert(format("%", copy BigFloat(-3.0) / copy BigFloat(2.0)) == "-1.5");

        // fmod keeps the sign of the dividend
        assert(format("%", copy BigFloat(5.5) % copy BigFloat(2.0)) == "1.5");
        assert(format("%", copy BigFloat(-5.5) % copy BigFloat(2.0)) == "-1.5");
    } catch {
        err: &AssertError => throw err;
        _: &BigFloatError => { assert(false, "no division by zero here"); }
    }
}

__test division_by_zero {
    // dividing a finite value by zero is an error, not an infinity
    let mut caught = false;
    {
        let _ = copy BigFloat(1.0) / copy BigFloat(0.0);
    } catch {
        _: &BigFloatError => { caught = true; }
    }

    assert(caught, "a division by zero must throw");
}

__test modulo_by_zero {
    let mut caught = false;
    {
        let _ = copy BigFloat(1.0) % copy BigFloat(0.0);
    } catch {
        _: &BigFloatError => { caught = true; }
    }

    assert(caught, "a modulo by zero must throw");
}

__test division_with_infinities {
    {
        let pinf = copy BigFloat::inf(true), one = copy BigFloat(1.0);

        // inf / inf is undefined, a finite value over an infinity vanishes
        assert((pinf / pinf).isNan);
        assert(format("%", one / pinf) == "0");

        // an infinity over a finite value stays infinite
        assert((pinf / one).isPositiveInf);
    } catch {
        err: &AssertError => throw err;
        _: &BigFloatError => { assert(false, "no division by zero here"); }
    }
}

__test modulo_with_infinities {
    {
        let pinf = copy BigFloat::inf(true), one = copy BigFloat(1.0);

        // an infinite dividend has no remainder, an infinite divisor divides nothing
        assert((pinf % one).isNan);
        assert(format("%", one % pinf) == "1");
    } catch {
        err: &AssertError => throw err;
        _: &BigFloatError => { assert(false, "no division by zero here"); }
    }
}

/**
 * ======================================================================
 * ========================     COMPARISON      =========================
 * ======================================================================
 */

__test comparison {
    let a = copy BigFloat(1.5), b = copy BigFloat(2.5), c = copy BigFloat(1.5);

    assert(a < b);
    assert(b > a);
    assert(a <= c);
    assert(a >= c);
    assert(a == c);
    assert(a != b);

    // and against a native value
    assert(a < 2.0);
    assert(a > 1.0);
}

__test comparison_with_infinities {
    let pinf = copy BigFloat::inf(true), ninf = copy BigFloat::inf(false);
    let one = copy BigFloat(1.0);

    assert(ninf < one);
    assert(one < pinf);
    assert(ninf < pinf);
    assert(pinf == copy BigFloat::inf(true));
}

__test nan_sorts_above_everything {
    // deliberate, and not the ieee rule: nan sorts above everything, and two nans
    // are equal, so that sorting a list of values always terminates
    let nan = copy BigFloat::nan();

    assert(nan > copy BigFloat(1.0));
    assert(nan > copy BigFloat::inf(true));
    assert(nan == copy BigFloat::nan());
}
