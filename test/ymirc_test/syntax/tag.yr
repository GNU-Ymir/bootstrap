use ymirc::errors;
use ymirc::syntax::{declaration::_, visitor};
use ymirc::utils::format;

/**
 * @returns: the first declaration of the module read from `src`, a protection
 * block around it being looked through
 * */
fn first (src: [c8])-> &Declaration
    throws ErrorMsg
{
    let dmut visitor = copy SyntaxVisitor::fromStr("tag.yr", src);
    let mut decl = visitor:.read().decls[0us];
    while let b: &BlockDecl = decl {
        decl = b.decls[0us];
    }

    decl
}

/**
 * @returns: why the doc comment of the declaration tagged in `tagged` is not
 * the one of the same declaration untagged in `untagged`, empty if it is
 * */
fn differs (tagged: [c8], untagged: [c8])-> [c8] {
    {
        let expected = first(untagged).comm;
        if (expected == "") return "the untagged declaration has no doc comment";

        if let t: &TaggedDecl = first(tagged) {
            if (t.comm != "") return format("the tags have the comment %", t.comm);
            if (t.decl.comm != expected) return format("the tagged declaration has the comment %", t.decl.comm);
            return "";
        }

        "the declaration is not tagged"
    } catch {
        err: &ErrorMsg => format("%", err)
    }
}

/**
 * ======================================================================
 * =====================     DOC COMMENTS     ===========================
 * ======================================================================
 */

__test a_doc_comment_before_the_tags_is_the_one_of_the_declaration {
    let why = differs("/** the doc */\n#[a]\nfn foo () {}\n",
                      "/** the doc */\nfn foo () {}\n");
    assert(why == "", why);
}

__test a_doc_comment_before_the_tags_reaches_a_protected_declaration {
    let why = differs("/** the doc */\n#[a] #[b] @inline pub fn foo () {}\n",
                      "/** the doc */\npub fn foo () {}\n");
    assert(why == "", why);
}

__test a_doc_comment_after_the_tags_is_the_one_of_the_declaration {
    let why = differs("#[a]\n/** the doc */\nfn foo () {}\n",
                      "/** the doc */\nfn foo () {}\n");
    assert(why == "", why);
}
