use ymirc::errors;
use ymirc::syntax::{declaration::_, visitor};
use ymirc::utils::format;

/**
 * @returns: the first declaration of the module read from `src`, the
 * protection, extern and tagged blocks around it being looked through
 * */
fn declared (src: [c8])-> &Declaration
    throws ErrorMsg
{
    let dmut visitor = copy SyntaxVisitor::fromStr("attribute.yr", src);
    let mut decl = visitor:.read().decls[0us];
    loop {
        match decl {
            b: &BlockDecl       => { decl = b.decls[0us]; }
            e: &ExternBlockDecl => { decl = e.decls[0us]; }
            t: &TaggedDecl      => { decl = t.decl; }
            _                   => { break; }
        }
    }

    decl
}

/**
 * @returns: why the doc comment of the declaration in `attributed` is not the
 * one of the same declaration without attributes in `plain`, empty if it is
 * */
fn differs (attributed: [c8], plain: [c8])-> [c8] {
    {
        let expected = declared(plain).comm;
        if (expected == "") return "the declaration without attributes has no doc comment";

        let comm = declared(attributed).comm;
        if (comm != expected) return format("the declaration has the comment %", comm);
        ""
    } catch {
        err: &ErrorMsg => format("%", err)
    }
}

/**
 * ======================================================================
 * =====================     DOC COMMENTS     ===========================
 * ======================================================================
 */

__test a_doc_comment_before_the_attributes_is_the_one_of_the_declaration {
    let why = differs("/** the doc */\n@inline\nfn foo () {}\n",
                      "/** the doc */\nfn foo () {}\n");
    assert(why == "", why);
}

__test a_doc_comment_before_the_attributes_reaches_a_protected_declaration {
    let why = differs("/** the doc */\n@inline\npub fn foo () {}\n",
                      "/** the doc */\npub fn foo () {}\n");
    assert(why == "", why);
}

__test a_doc_comment_between_the_tags_and_the_attributes_reaches_a_protected_declaration {
    let why = differs("#[a]\n/** the doc */\n@inline pub fn foo () {}\n",
                      "/** the doc */\npub fn foo () {}\n");
    assert(why == "", why);
}

__test a_doc_comment_before_the_attributes_reaches_an_extern_declaration {
    let why = differs("/** the doc */\n@inline\nextern (C) fn foo ();\n",
                      "/** the doc */\nextern (C) fn foo ();\n");
    assert(why == "", why);
}

__test a_doc_comment_before_the_attributes_reaches_a_protected_extern_declaration {
    let why = differs("/** the doc */\n@inline\npub extern (C) fn foo ();\n",
                      "/** the doc */\npub extern (C) fn foo ();\n");
    assert(why == "", why);
}

__test a_doc_comment_before_the_attributes_reaches_an_extern_declaration_of_a_protected_block {
    let why = differs("pub {\n/** the doc */\n@inline\nextern (C) fn foo ();\n}\n",
                      "pub {\n/** the doc */\nextern (C) fn foo ();\n}\n");
    assert(why == "", why);
}
