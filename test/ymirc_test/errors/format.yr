use ymirc::errors;
use ymirc::errors::snippet::suggestion;
use ymirc::lexing::word;
use ymirc::utils::_;

use std::io;

/**
 * A line long enough that formatLocation elides its beginning, with two markers
 * near the end to point at. The '@' sits past byte 100, so the excerpt printed
 * before it is shortened and carries the color codes of the elision marker
 * */
lazy LONG = "let a0 = 0; let a1 = 1; let a2 = 2; let a3 = 3; let a4 = 4; let a5 = 5; let a6 = 6; let a7 = 7; let z = @; let w = #;\n";

/**
 * A short line, so nothing is elided, holding a non ascii identifier. The
 * accented character is two bytes and one column
 * */
lazy ACCENT = "let café = 1; let x = @;\n";

/**
 * A short ascii line, the case where a byte and a column are the same thing
 * */
lazy PLAIN = "let x = 1; let y = @;\n";

/**
 * @returns: a word pointing at the single occurrence of 'c' in 'content'
 * */
fn at(content: [c8], c: c8)-> &Word {
    let idx = findLast(content, c);
    copy LocWord(str-> content[idx .. idx + 1us], filename-> "a.yr", fileContent-> content,
                 line-> 1u64, col-> cast!{u64}(idx + 1us), seek-> idx, lineSeek-> 0us)
}

/**
 * @returns: a file of 'nb' numbered lines, "let lN = N;"
 *
 * The text of a line names the line it is, so an excerpt can be checked
 * against the place it claims to show
 * */
fn numbered(nb: u64)-> [c8] {
    let mut res = "";
    for i in 1u64 .. nb + 1u64 {
        res = res ~ format("let l% = %;\n", i, i);
    }

    res
}

/**
 * @returns: a word pointing at the identifier of line 'line' of a numbered file
 * */
fn atLine(content: [c8], filename: [c8], line: u64)-> &Word {
    let mut seek = 0us;
    for _ in 1u64 .. line {
        while seek < content.len && content[seek] != '\n' {
            seek += 1us;
        }

        seek += 1us;
    }

    // "let lN = N;", so the identifier starts on the fifth column
    let col = 5us;
    let idx = seek + col - 1us;
    let len = format("l%", line).len;

    copy LocWord(str-> content[idx .. idx + len], filename-> filename, fileContent-> content,
                 line-> line, col-> cast!{u64}(col), seek-> idx, lineSeek-> seek)
}

/**
 * @returns: the line number an excerpt row shows, none for any other row
 *
 * The number is the first thing an excerpt row writes, styling excepted; every
 * other row of a report starts on a box drawing character or on a dash
 * */
fn rowNumber(str: [c8])-> (u64)? {
    let mut i = 0us;
    while i < str.len {
        let j = skipAnsi(str, i);
        if (j != i) { i = j; }
        else if (str[i] == ' ') { i += 1us; }
        else break;
    }

    let mut res = 0u64;
    let mut some = false;
    while i < str.len && str[i] >= '0' && str[i] <= '9' {
        res = res * 10u64 + cast!{u64}(cast!{u8}(str[i]) - cast!{u8}('0'));
        some = true;
        i += 1us;
    }

    if (!some) return none;

    (res)?
}

/**
 * @returns: the lines a report shows an excerpt of, in the order it shows them
 * */
fn excerptLines(ls: [[c8]])-> [u64] {
    let mut res: [u64] = [];
    for l in ls {
        match rowNumber(l) {
            Ok(n: u64) => { res ~= [n]; }
        }
    }

    res
}

/**
 * @returns: the columns at which 'needle' is printed on 'str'
 *
 * This is what a terminal shows, so the escape sequences are stepped over and
 * count for nothing, cf. skipAnsi
 * */
fn columnsOf(str: [c8], needle: [c8])-> [usize] {
    let mut res: [usize] = [];
    let mut col = 0us;
    let mut i = 0us;

    while i < str.len {
        let j = skipAnsi(str, i);
        if (j != i) {
            i = j;
        } else {
            if (i + needle.len <= str.len && str[i .. i + needle.len] == needle) {
                res ~= [col];
            }

            if ((cast!u8(str[i]) & 0xC0u8) != 0x80u8) { col += 1us; }
            i += 1us;
        }
    }

    res
}

/**
 * @returns: the lines of 'str'
 * */
fn lines(str: [c8])-> [[c8]] {
    let mut res: [[c8]] = [];
    let mut last = 0us;
    for i in 0us .. str.len {
        if (str[i] == '\n') {
            res ~= [str[last .. i]];
            last = i + 1us;
        }
    }

    if (last < str.len) { res ~= [str[last .. $]]; }
    res
}

/**
 * @returns: the first line of 'ls' holding 'needle'
 * */
fn lineWith(ls: [[c8]], needle: [c8])-> [c8] {
    for l in ls {
        if (contains(l, needle)) return l;
    }

    ""
}

/**
 * @returns: the header lines of a rendered diagnostic, one per excerpt
 * */
fn headsOf(ls: [[c8]])-> [[c8]] {
    let mut res: [[c8]] = [];
    for l in ls {
        if (contains(l, "-->")) res ~= [l];
    }

    res
}

/**
 * @returns: the excerpt line and the caret line of a formatted location
 * */
fn render(err: &ErrorMsg)-> [[c8]] {
    lines(renderText(err))
}

/**
 * @returns: a formatted diagnostic, as one string
 * */
fn renderText(err: &ErrorMsg)-> [c8] {
    let dmut f = copy Formatter(tags-> FormatTags(verbose-> true));
    f:.write(err);

    f[]
}

/**
 * @returns: the excerpt line and the caret line of a diagnostic on 'c'
 * */
fn excerptAndCaret(content: [c8], c: c8, notes: [&ErrorMsg] = [])-> ([c8], [c8]) {
    let ls = render(copy ErrorMsg::fatal(at(content, c), msg-> "e", notes-> notes));

    (lineWith(ls, "┃"), lineWith(ls, "╋"))
}

/**
 * ======================================================================
 * ======================     CARET COLUMN      =========================
 * ======================================================================
 */

__test the_caret_sits_under_the_token {
    // the plain case, nothing elided and nothing but ascii
    let (src, caret) = excerptAndCaret(PLAIN, '@'c8);

    let tok = columnsOf(src, "@");
    let hat = columnsOf(caret, "^");

    assert(tok.len == 1us && hat.len == 1us, format("expected one of each, got % and %", tok.len, hat.len));
    assert(tok[0] == hat[0], format("the token is at column %, the caret at %", tok[0], hat[0]));
}

__test the_caret_sits_under_the_token_past_an_accented_identifier {
    // 'café' is five bytes and four columns, so a caret indented per byte lands
    // one column too far right
    let (src, caret) = excerptAndCaret(ACCENT, '@'c8);

    assert(columnsOf(src, "é").len == 1us, "the excerpt lost the accented identifier");
    assert(columnsOf(src, "@")[0] == columnsOf(caret, "^")[0]);
}

__test the_caret_sits_under_the_token_on_an_elided_line {
    // YMI-223: the excerpt before the token is shortened, and its marker carries
    // eleven bytes of color that the terminal does not print
    let (src, caret) = excerptAndCaret(LONG, '@'c8);

    assert(contains(src, "[...]"), format("the excerpt was not elided :\n%", src));

    let tok = columnsOf(src, "@");
    let hat = columnsOf(caret, "^");

    assert(tok.len == 1us && hat.len == 1us, format("expected one of each, got % and %", tok.len, hat.len));
    assert(tok[0] == hat[0], format("the token is at column %, the caret at %", tok[0], hat[0]));
}

/**
 * ======================================================================
 * =========================     MESSAGES      ==========================
 * ======================================================================
 */

__test a_note_hangs_under_the_caret_it_belongs_to {
    // the continuation lines of a multi message note are indented the same way,
    // so they inherit the shift when it is there
    let notes = copy [copy ErrorMsg::note(at(LONG, '@'c8), msg-> "first", oneLine-> true),
                      copy ErrorMsg::note(at(LONG, '@'c8), msg-> "second", oneLine-> true)];

    let ls = render(copy ErrorMsg::fatal(at(LONG, '@'c8), msg-> "e", notes-> notes));
    let src = lineWith(ls, "┃");
    let cont = lineWith(ls, "┗━");

    let tok = columnsOf(src, "@");
    let con = columnsOf(cont, "┗━");

    assert(tok.len == 1us && con.len == 1us, format("expected one of each, got % and %", tok.len, con.len));

    // the token is one column wide, so the connector hangs right under it. The
    // caret line and this one are indented the same way, so checking it against
    // the caret would only say they drifted together
    assert(tok[0] == con[0], format("the token is at column %, the connector at %", tok[0], con[0]));
}

/**
 * ======================================================================
 * ========================     TWO CARETS      =========================
 * ======================================================================
 */

__test both_carets_sit_under_their_token {
    // the one line form indents twice, once over the elided beginning and once
    // over what separates the two tokens, so the second caret drifts twice.
    // The second one is the end of the span, a secondary label, so it is
    // underlined with '-' and not with '^'
    let ls = render(copy ErrorMsg::fatal(at(LONG, '@'c8), end-> at(LONG, '#'c8), msg-> "e"));
    let src = lineWith(ls, "┃");
    let caret = lineWith(ls, "╋");

    let fst = columnsOf(src, "@");
    let snd = columnsOf(src, "#");
    let hat = columnsOf(caret, "^");
    let dash = columnsOf(caret, "-");

    assert(hat.len == 1us && dash.len == 1us,
           format("expected one caret and one dash, got % and % :\n%", hat.len, dash.len, caret));
    assert(fst[0] == hat[0], format("the first token is at column %, its caret at %", fst[0], hat[0]));
    assert(snd[0] == dash[0], format("the second token is at column %, its caret at %", snd[0], dash[0]));
}

__test an_elided_excerpt_is_measured_in_columns {
    // YMI-69: the marker standing for what was dropped is written in bold, and
    // the escapes that carries are not columns. The excerpt therefore keeps a
    // hundred of them, and not a hundred minus the styling of its own marker
    let (src, _) = excerptAndCaret(LONG, '@'c8);

    assert(contains(src, "[...]"), format("the excerpt was not elided :\n%", src));

    // the gutter is the line number cell, then " ┃ ", so the excerpt starts two
    // columns past the bar
    let bar = columnsOf(src, "┃")[0];
    let tok = columnsOf(src, "@")[0];

    assert(tok - (bar + 2us) == 100us,
           format("the elided excerpt is % columns wide, expected 100", tok - (bar + 2us)));
}

/**
 * ======================================================================
 * ====================     LABELLED LOCATIONS      =====================
 * ======================================================================
 */

__test a_cited_location_is_shown_rather_than_named {
    // YMI-70: a note used to cite its place as '-- (a.yr:(9,5))' and stop,
    // which is the reader opening the file to see what the note is about
    let content = numbered(12u64);
    let notes = copy [copy ErrorMsg::note(atLine(content, "a.yr", 9u64), msg-> "n",
                                          oneLine-> true, withLoc-> true)];

    let err = copy ErrorMsg::fatal(atLine(content, "a.yr", 5u64), msg-> "e", notes-> notes);
    let txt = renderText(err);

    assert(!contains(txt, "-- ("), format("the location is still cited :\n%", txt));

    // the labelled run of the line is styled, so what is contiguous in the
    // rendered text is what follows it
    assert(format("%", excerptLines(render(err))) == "{5, 9}",
           format("line 9 is not shown :\n%", txt));
    assert(contains(txt, " = 9;"), format("line 9 is shown without its source :\n%", txt));
}

__test the_labels_of_an_excerpt_come_out_in_source_order {
    // the notes name line 20 first, and the excerpt shows line 9 before it all
    // the same: the order is decided when the diagnostic is laid out, so a
    // throw site stays free to build its notes in whatever order suits it
    let content = numbered(24u64);
    let notes = copy [copy ErrorMsg::note(atLine(content, "a.yr", 20u64), msg-> "later",
                                          oneLine-> true, withLoc-> true),
                      copy ErrorMsg::note(atLine(content, "a.yr", 9u64), msg-> "earlier",
                                          oneLine-> true, withLoc-> true)];

    let err = copy ErrorMsg::fatal(atLine(content, "a.yr", 5u64), msg-> "e", notes-> notes);
    let shown = excerptLines(render(err));

    assert(format("%", shown) == "{5, 9, 20}",
           format("the excerpt shows the lines %, expected {5, 9, 20} :\n%", shown, renderText(err)));
}

__test the_place_that_broke_is_shown_before_the_places_explaining_it {
    // the note names line 5 and the diagnostic is reported on line 9. Source
    // order would show the note first, so the reader meets an explanation
    // before the thing it explains and the caret that is the error is only
    // told apart by being a '^': the primary's excerpt is cut out and put first
    let content = numbered(12u64);
    let notes = copy [copy ErrorMsg::note(atLine(content, "a.yr", 5u64), msg-> "n",
                                          oneLine-> true, withLoc-> true)];

    let err = copy ErrorMsg::fatal(atLine(content, "a.yr", 9u64), msg-> "e", notes-> notes);
    let ls = render(err);

    assert(format("%", excerptLines(ls)) == "{9, 5}",
           format("the excerpt shows the lines % :\n%", excerptLines(ls), renderText(err)));
    assert(contains(lineWith(ls, "-->"), "a.yr:(9,5)"),
           format("the header cites % :\n%", lineWith(ls, "-->"), renderText(err)));
}

__test the_labels_of_two_files_do_not_interleave {
    // one excerpt per file, the one the diagnostic is reported in first, so the
    // line numbers of the second never run between those of the first
    let a = numbered(12u64);
    let b = numbered(12u64);
    let notes = copy [copy ErrorMsg::note(atLine(b, "b.yr", 2u64), msg-> "in b",
                                          oneLine-> true, withLoc-> true),
                      copy ErrorMsg::note(atLine(a, "a.yr", 10u64), msg-> "in a",
                                          oneLine-> true, withLoc-> true)];

    let err = copy ErrorMsg::fatal(atLine(a, "a.yr", 3u64), msg-> "e", notes-> notes);
    let ls = render(err);
    let shown = excerptLines(ls);

    assert(format("%", shown) == "{3, 10, 2}",
           format("the excerpt shows the lines %, expected {3, 10, 2} :\n%", shown, renderText(err)));

    // three: the primary's line in a, the rest of a, then b
    let heads = headsOf(ls);

    assert(heads.len == 3us, format("expected three excerpts, got % :\n%", heads.len, renderText(err)));
    assert(contains(heads[0], "a.yr") && contains(heads[1], "a.yr") && contains(heads[2], "b.yr"),
           format("the excerpts come out in the order % :\n%", heads, renderText(err)));
}

__test a_label_near_the_primary_shares_its_excerpt {
    // MAX_GAP: one unlabelled line between two labelled ones is shown, and the
    // note is close enough to the failure to be read with it
    let content = numbered(12u64);
    let notes = copy [copy ErrorMsg::note(atLine(content, "a.yr", 7u64), msg-> "n",
                                          oneLine-> true, withLoc-> true)];

    let err = copy ErrorMsg::fatal(atLine(content, "a.yr", 5u64), msg-> "e", notes-> notes);
    let ls = render(err);

    assert(format("%", excerptLines(ls)) == "{5, 6, 7}",
           format("expected line 6 for context :\n%", renderText(err)));
    assert(headsOf(ls).len == 1us,
           format("expected one excerpt, got % :\n%", headsOf(ls).len, renderText(err)));
}

__test a_label_out_of_reach_of_the_primary_opens_an_excerpt_of_its_own {
    // two unlabelled lines is more than the separator standing for them is
    // worth, and a place that far from the failure is a place of its own: it
    // gets a header rather than an "..." inside the primary's excerpt
    let content = numbered(12u64);
    let notes = copy [copy ErrorMsg::note(atLine(content, "a.yr", 8u64), msg-> "n",
                                          oneLine-> true, withLoc-> true)];

    let err = copy ErrorMsg::fatal(atLine(content, "a.yr", 5u64), msg-> "e", notes-> notes);
    let ls = render(err);

    assert(format("%", excerptLines(ls)) == "{5, 8}",
           format("expected lines 6 and 7 to be dropped :\n%", renderText(err)));
    assert(headsOf(ls).len == 2us,
           format("expected two excerpts, got % :\n%", headsOf(ls).len, renderText(err)));
}

__test two_distant_labels_of_one_excerpt_are_joined_by_an_elision {
    // the split only cuts the primary out, so the places explaining it stay in
    // one excerpt however far apart they are, and the lines between them are
    // dropped to an "..." the way they always were
    let content = numbered(16u64);
    let notes = copy [copy ErrorMsg::note(atLine(content, "a.yr", 6u64), msg-> "first",
                                          oneLine-> true, withLoc-> true),
                      copy ErrorMsg::note(atLine(content, "a.yr", 12u64), msg-> "second",
                                          oneLine-> true, withLoc-> true)];

    let err = copy ErrorMsg::fatal(atLine(content, "a.yr", 2u64), msg-> "e", notes-> notes);
    let ls = render(err);

    assert(format("%", excerptLines(ls)) == "{2, 6, 12}",
           format("the excerpt shows the lines % :\n%", excerptLines(ls), renderText(err)));
    assert(headsOf(ls).len == 2us,
           format("expected two excerpts, got % :\n%", headsOf(ls).len, renderText(err)));
    assert(contains(renderText(err), "..."),
           format("the dropped lines are not marked :\n%", renderText(err)));
}

/**
 * ======================================================================
 * =======================     FLATTENING      ==========================
 * ======================================================================
 */

/**
 * @returns: a context frame message, the kind `reports` puts in the trace
 * */
fn validating(what: [c8])-> Error {
    Error(NO_CODE, "when validating " ~ what, isContext-> true)
}

/**
 * @returns: the lines of a rendered diagnostic that are trace frames
 *
 * A frame is written under the gutter rather than in it, so what tells it from
 * a label carrying the same text is the "=" cell and the absence of a "\u{2503}"
 * one. The two are not contiguous in the rendered text, the styling sits
 * between them
 * */
fn traceOf(ls: [[c8]])-> [[c8]] {
    let mut res: [[c8]] = [];
    for l in ls {
        if (contains(l, "when validating") && contains(l, "=") && !contains(l, "┃")) {
            res ~= [l];
        }
    }

    res
}

/**
 * @returns: how many headers a rendered diagnostic has, one per report
 * */
fn reportCount(ls: [[c8]])-> usize {
    let mut res = 0us;
    for l in ls {
        if (contains(l, "-->")) res += 1us;
    }

    res
}

__test a_context_frame_is_a_trace_line_and_not_a_box {
    // YMI-71: 'when validating X' used to be the header of a box the real error
    // was printed inside of, one gutter deeper. It says how the compiler got
    // there, not what it found, so it belongs at the bottom
    let content = numbered(12u64);
    let inner = copy ErrorMsg::fatal(atLine(content, "a.yr", 9u64), msg-> "boom");
    let err = copy ErrorMsg::fatal(atLine(content, "a.yr", 3u64),
                                   msg-> validating("a::foo"),
                                   notes-> copy [inner]);

    let ls = render(err);

    assert(reportCount(ls) == 1us,
           format("expected one report, got % :\n%", reportCount(ls), renderText(err)));
    assert(contains(ls[0], "boom"),
           format("the failure is not the header :\n%", renderText(err)));

    let trace = traceOf(ls);
    assert(trace.len == 1us && contains(trace[0], "a::foo"),
           format("the frame is not in the trace :\n%", renderText(err)));

    // the frame cites its line rather than showing it: a chain of them would
    // drag one excerpt per enclosing symbol into a report about line 9
    assert(format("%", excerptLines(ls)) == "{9}",
           format("the excerpt shows the lines % :\n%", excerptLines(ls), renderText(err)));
}

__test the_trace_reads_deepest_frame_first {
    // a backtrace is read from where it broke outwards, so the frame closest to
    // the failure comes first
    let content = numbered(12u64);
    let inner = copy ErrorMsg::fatal(atLine(content, "a.yr", 9u64), msg-> "boom");
    let mid = copy ErrorMsg::fatal(atLine(content, "a.yr", 5u64),
                                   msg-> validating("a::inner"),
                                   notes-> copy [inner]);
    let err = copy ErrorMsg::fatal(atLine(content, "a.yr", 3u64),
                                   msg-> validating("a::outer"),
                                   notes-> copy [mid]);

    let trace = traceOf(render(err));

    assert(trace.len == 2us, format("expected two frames, got % :\n%", trace.len, renderText(err)));
    assert(contains(trace[0], "a::inner") && contains(trace[1], "a::outer"),
           format("the trace reads outwards :\n%", renderText(err)));
}

__test a_context_frame_over_several_failures_becomes_several_reports {
    // the frame introduces each of them, so each is a report of its own and
    // carries the frame: a report is what one failure prints, whole
    let content = numbered(12u64);
    let notes = copy [copy ErrorMsg::fatal(atLine(content, "a.yr", 7u64), msg-> "first"),
                      copy ErrorMsg::fatal(atLine(content, "a.yr", 9u64), msg-> "second")];

    let err = copy ErrorMsg::fatal(atLine(content, "a.yr", 3u64),
                                   msg-> validating("a::foo"),
                                   notes-> notes);

    let ls = render(err);

    assert(reportCount(ls) == 2us,
           format("expected two reports, got % :\n%", reportCount(ls), renderText(err)));
    assert(traceOf(ls).len == 2us,
           format("both reports say what they were reached through :\n%", renderText(err)));
}

__test no_source_line_is_printed_twice {
    // the whole point: every level used to re-print its own excerpt, so a chain
    // naming one line showed it once per level
    let content = numbered(12u64);
    let deep = copy ErrorMsg::fatal(atLine(content, "a.yr", 9u64), msg-> "boom");
    let mid = copy ErrorMsg::fatal(atLine(content, "a.yr", 9u64), msg-> "why", notes-> copy [deep]);
    let err = copy ErrorMsg::fatal(atLine(content, "a.yr", 9u64), msg-> "what", notes-> copy [mid]);

    let ls = render(err);
    let shown = excerptLines(ls);

    assert(format("%", shown) == "{9}",
           format("the excerpt shows the lines % :\n%", shown, renderText(err)));
}

__test a_note_with_nothing_to_show_is_written_at_the_bottom {
    // an EOF location has no line to label, and the note is worth reading all
    // the same, so it lands under the excerpt rather than being dropped. A
    // one-line note is the other case and not this one: saying it has no
    // excerpt of its own is saying it explains the caret it hangs under, cf.
    // ErrorMsg::gather
    let content = numbered(12u64);
    let notes = copy [copy ErrorMsg::note(EOF_WORD, msg-> "read the manual")];

    let err = copy ErrorMsg::fatal(atLine(content, "a.yr", 5u64), msg-> "e", notes-> notes);
    let ls = render(err);

    assert(reportCount(ls) == 1us,
           format("expected one report, got % :\n%", reportCount(ls), renderText(err)));
    let note = lineWith(ls, "read the manual");
    assert(contains(note, "=") && !contains(note, "┃"),
           format("the note is not a trailing one :\n%", renderText(err)));
}

__test the_reason_a_note_gives_hangs_under_that_note {
    // a note that became a label is a place the report points at - a candidate,
    // a declaration - and what is under it is why that place is worth pointing
    // at. Routed by its own location it would land on the failing call instead,
    // where two candidates' reasons are indistinguishable
    let content = numbered(12u64);
    let why = copy ErrorMsg::fatal(atLine(content, "a.yr", 9u64), msg-> "why it failed");
    let cand = copy ErrorMsg::note(atLine(content, "a.yr", 3u64), msg-> "candidate",
                                   oneLine-> true, withLoc-> true, notes-> copy [why]);

    let err = copy ErrorMsg::fatal(atLine(content, "a.yr", 7u64), msg-> "e", notes-> copy [cand]);
    let ls = render(err);

    // line 9 is never shown: the reason moved to the caret of the note it
    // explains, and its own span went with it
    assert(format("%", excerptLines(ls)) == "{7, 3}",
           format("the excerpt shows the lines % :\n%", excerptLines(ls), renderText(err)));

    let said = lineWith(ls, "why it failed");
    assert(contains(said, "┃") && !contains(said, "╋"),
           format("the reason is not a message of a caret :\n%", renderText(err)));
}

/**
 * ======================================================================
 * ======================     SUGGESTIONS      ==========================
 * ======================================================================
 */

/**
 * @returns: 'str' as a terminal shows it, escape sequences dropped
 * */
fn plain(str: [c8])-> [c8] {
    let mut res = "";
    let mut i = 0us;
    while i < str.len {
        let j = skipAnsi(str, i);
        if (j != i) { i = j; }
        else {
            res = res ~ str[i .. i + 1us];
            i += 1us;
        }
    }

    res
}

/**
 * @returns: the character standing in the "┃" cell of a row of a report, none
 *           for a row that has no line number cell
 *
 * A row of a suggestion is an excerpt row whose bar is a "-" or a "+", so this
 * is the whole of what tells the two apart. The bar is three bytes and the two
 * markers are one, and only their first byte is read here, which is enough:
 * neither of them starts a multi byte character
 * */
fn rowMark(str: [c8])-> (c8)? {
    let mut i = 0us;
    while i < str.len {
        let j = skipAnsi(str, i);
        if (j != i) { i = j; }
        else if (str[i] == ' ') { i += 1us; }
        else break;
    }

    let mut some = false;
    while i < str.len && str[i] >= '0' && str[i] <= '9' {
        some = true;
        i += 1us;
    }

    if (!some) return none;

    while i < str.len {
        let j = skipAnsi(str, i);
        if (j != i) { i = j; }
        else if (str[i] == ' ') { i += 1us; }
        else break;
    }

    if (i >= str.len) return none;

    (str[i])?
}

/**
 * @returns: the row of a rendered report carrying the given diff marker, empty
 *           when it has none
 * */
fn diffRow(ls: [[c8]], marker: c8)-> [c8] {
    for l in ls {
        match rowMark(l) {
            Ok(m: c8) => { if (m == marker) return l; }
        }
    }

    ""
}

/**
 * @returns: how many rows of a rendered report carry the given diff marker
 * */
fn diffRowCount(ls: [[c8]], marker: c8)-> usize {
    let mut nb = 0us;
    for l in ls {
        match rowMark(l) {
            Ok(m: c8) => { if (m == marker) { nb += 1us; } }
        }
    }

    nb
}

/**
 * @returns: a word covering 'str' at the given column of the first line of 'content'
 * */
fn wordAt(content: [c8], col: usize, str: [c8])-> &Word {
    copy LocWord(str-> str, filename-> "a.yr", fileContent-> content,
                 line-> 1u64, col-> cast!{u64}(col), seek-> col - 1us, lineSeek-> 0us)
}

/**
 * @returns: true iif the row ends on 'txt', once its styling is dropped
 * */
fn rowShows(row: [c8], txt: [c8])-> bool {
    let str = plain(row);
    if (str.len < txt.len) return false;

    str[str.len - txt.len .. $] == txt
}

/**
 * @returns: a report on the last 'c' of 'content', proposing an edit there
 * */
fn withEdit(content: [c8], c: c8, replacement: [c8], len: usize = 0us)-> &ErrorMsg {
    let w = at(content, c);

    (copy ErrorMsg::fatal(w, msg-> "e")).withFix(Edit(w, replacement-> replacement, msg-> "do that", len-> len))
}

__test the_pair_is_the_edit_applied_to_the_line {
    // the point of YMI-72: the "+" row is the source line with the replacement
    // spliced in at the span, and nothing else. Nobody writes it - a sentence
    // saying what to do is not something a quick fix can apply, and a rendering
    // written next to the edit can disagree with it
    let src = "let x = 1; let y = @;";
    let w = at(PLAIN, '@'c8);
    let col = cast!{usize}(w.col);
    let after = src[0us .. col - 1us] ~ "copy " ~ src[col - 1us .. $];

    let ls = render(withEdit(PLAIN, '@'c8, "copy "));
    let minus = diffRow(ls, '-'c8);
    let plus = diffRow(ls, '+'c8);

    assert(minus != "" && plus != "",
           format("the report has no pair of lines :\n%", renderText(withEdit(PLAIN, '@'c8, "copy "))));
    assert(rowShows(minus, src), format("the '-' row is %, expected %", plain(minus), src));
    assert(rowShows(plus, after), format("the '+' row is %, expected %", plain(plus), after));
}

__test the_pair_names_the_line_it_edits {
    // both rows carry the number of the line they show, so a fix reads under
    // the excerpt as one more thing said about that line
    let content = numbered(12u64);
    let w = atLine(content, "a.yr", 7u64);
    let err = (copy ErrorMsg::fatal(atLine(content, "a.yr", 7u64), msg-> "e"))
        .withFix(Edit(w, replacement-> "mut ", msg-> "do that"));

    let ls = render(err);

    assert(format("%", rowNumber(diffRow(ls, '-'c8))) == "Ok(7)",
           format("the '-' row names % :\n%", rowNumber(diffRow(ls, '-'c8)), renderText(err)));
    assert(format("%", rowNumber(diffRow(ls, '+'c8))) == "Ok(7)",
           format("the '+' row names % :\n%", rowNumber(diffRow(ls, '+'c8)), renderText(err)));
    assert(rowShows(diffRow(ls, '+'c8), "let mut l7 = 7;"),
           format("the '+' row is % :\n%", plain(diffRow(ls, '+'c8)), renderText(err)));
}

__test an_edit_standing_in_for_a_word_replaces_it {
    // a span of its own, and not only the empty one before the word: the
    // replacement takes the place of what the word covers
    let ls = render(withEdit(PLAIN, '@'c8, "42", len-> 1us));

    assert(rowShows(diffRow(ls, '+'c8), "let x = 1; let y = 42;"),
           format("the '+' row is % :\n%", plain(diffRow(ls, '+'c8)),
                  renderText(withEdit(PLAIN, '@'c8, "42", len-> 1us))));
}

__test an_edit_that_cannot_be_applied_keeps_what_it_says {
    // a span running past the line it names is a throw site bug, and dropping
    // the suggestion would answer it by saying less than the prose form said.
    // The sentence comes back as a trailing note instead
    let w = at(PLAIN, '@'c8);
    let far = copy LocWord(str-> w.str, filename-> w.filename, fileContent-> w.fileContent,
                           line-> 1u64, col-> 900u64, seek-> w.seek, lineSeek-> 0us);

    let err = (copy ErrorMsg::fatal(at(PLAIN, '@'c8), msg-> "e"))
        .withFix(Edit(far, replacement-> "copy ", msg-> "do that"));
    let ls = render(err);

    assert(diffRow(ls, '-'c8) == "" && diffRow(ls, '+'c8) == "",
           format("an edit that does not fit was applied :\n%", renderText(err)));

    let said = lineWith(ls, "do that");
    assert(contains(said, "=") && !contains(said, "┃"),
           format("what the edit says was lost :\n%", renderText(err)));
}

__test an_edit_disagreeing_with_the_line_is_refused {
    // the word says it covers a '@' and the line holds a '1' there. The excerpt
    // is what the file holds, so replacing those bytes would be replacing
    // something else, cf. snippet::applyEdit
    let w = at(PLAIN, '@'c8);
    let off = copy LocWord(str-> w.str, filename-> w.filename, fileContent-> w.fileContent,
                           line-> 1u64, col-> 9u64, seek-> w.seek, lineSeek-> 0us);

    let err = (copy ErrorMsg::fatal(at(PLAIN, '@'c8), msg-> "e"))
        .withFix(Edit(off, replacement-> "42", msg-> "do that", len-> 1us));
    let ls = render(err);

    assert(diffRow(ls, '+'c8) == "",
           format("an edit disagreeing with the line was applied :\n%", renderText(err)));
}

__test a_suggestion_hanging_under_a_note_reaches_the_report {
    // a throw site attaches the fix at whatever depth suits what it is
    // building, and the report is where the whole subtree ends up: a note that
    // became a label of the excerpt still proposes its edit
    let content = numbered(12u64);
    let w = atLine(content, "a.yr", 9u64);
    let note = (copy ErrorMsg::note(w, msg-> "n", oneLine-> true, withLoc-> true))
        .withFix(Edit(w, replacement-> "mut ", msg-> "do that"));

    let err = copy ErrorMsg::fatal(atLine(content, "a.yr", 5u64), msg-> "e", notes-> copy [note]);
    let ls = render(err);

    assert(rowShows(diffRow(ls, '+'c8), "let mut l9 = 9;"),
           format("the edit of the note did not reach the report :\n%", renderText(err)));
}

__test a_two_word_edit_writes_each_word_where_the_other_one_is {
    // neither half of an inversion is a fix on its own - `copy (lazy i)` with
    // only its first word rewritten is `lazy (lazy i)` - and what lies between
    // the two words belongs to the reader and comes out untouched
    let content = "let a = copy (lazy i);\n";
    let fst = wordAt(content, 9us, "copy");
    let snd = wordAt(content, 15us, "lazy");

    let err = (copy ErrorMsg::fatal(fst, end-> snd, msg-> "e"))
        .withFix(Edit(fst, snd, msg-> "do that"));
    let ls = render(err);

    assert(diffRowCount(ls, '+'c8) == 1us,
           format("the inversion is % pairs :\n%", diffRowCount(ls, '+'c8), renderText(err)));
    assert(rowShows(diffRow(ls, '+'c8), "let a = lazy (copy i);"),
           format("the '+' row is % :\n%", plain(diffRow(ls, '+'c8)), renderText(err)));
}

__test a_two_word_edit_over_two_lines_has_no_pair_to_print {
    // an edit prints as a pair of lines, so one whose halves are not on the
    // same line has nothing to print. It keeps what it says, the way an edit
    // that runs past its line does
    let content = numbered(12u64);
    let fst = atLine(content, "a.yr", 5u64);
    let snd = atLine(content, "a.yr", 7u64);

    let err = (copy ErrorMsg::fatal(fst, end-> snd, msg-> "e"))
        .withFix(Edit(fst, snd, msg-> "do that"));
    let ls = render(err);

    assert(diffRow(ls, '+'c8) == "",
           format("an edit of two lines was applied :\n%", renderText(err)));

    let said = lineWith(ls, "do that");
    assert(contains(said, "=") && !contains(said, "┃"),
           format("what the edit says was lost :\n%", renderText(err)));
}

__test a_note_carrying_only_a_fix_is_not_read_as_nothing {
    // a note that became a suggestion says nothing of its own - what it would
    // have said is the "help:" line, cf. withFix - so it is a node with an
    // empty message, and the flattening of the tree must not drop it: the fix
    // would go with it
    let w = at(PLAIN, '@'c8);
    let note = (copy ErrorMsg::note(w, msg-> "", oneLine-> true))
        .withFix(Edit(w, replacement-> "42", msg-> "do that", len-> 1us));

    let err = copy ErrorMsg::fatal(at(PLAIN, '@'c8), msg-> "e", notes-> copy [note]);
    let ls = render(err);

    assert(rowShows(diffRow(ls, '+'c8), "let x = 1; let y = 42;"),
           format("the fix of a wordless note was dropped :\n%", renderText(err)));
}

__test only_so_many_pairs_are_printed {
    // a typo the compiler finds five candidates for would answer it with five
    // diff blocks and bury the failure it is about. What is over the cap is
    // not dropped - it says what it says as a note
    let w = at(PLAIN, '@'c8);
    let mut notes: [&ErrorMsg] = [];
    for i in 0us .. MAX_FIXES + 2us {
        notes ~= [(copy ErrorMsg::note(w, msg-> "", oneLine-> true))
                      .withFix(Edit(w, replacement-> format("c%", i), msg-> format("try c%", i), len-> 1us))];
    }

    let err = copy ErrorMsg::fatal(at(PLAIN, '@'c8), msg-> "e", notes-> notes);
    let ls = render(err);

    assert(diffRowCount(ls, '+'c8) == MAX_FIXES,
           format("% pairs were printed, the cap is % :\n%",
                  diffRowCount(ls, '+'c8), MAX_FIXES, renderText(err)));

    let last = lineWith(ls, format("try c%", MAX_FIXES + 1us));
    assert(contains(last, "=") && !contains(last, "┃"),
           format("what the capped edits say was lost :\n%", renderText(err)));
}

/**
 * ======================================================================
 * ==========================     REGION      ===========================
 * ======================================================================
 */

/**
 * @returns: a word covering the identifiers of lines 'from' to 'to' of a
 *           numbered file
 * */
fn spanLines(content: [c8], from: u64, to: u64)-> &Word {
    atLine(content, "a.yr", from).spanTo(atLine(content, "a.yr", to))
}

/**
 * @returns: the first line of 'ls' holding both needles
 * */
fn lineWithBoth(ls: [[c8]], a: [c8], b: [c8])-> [c8] {
    for l in ls {
        if (contains(l, a) && contains(l, b)) return l;
    }

    ""
}

/**
 * @returns: the source row an excerpt shows the given line on
 * */
fn rowOf(ls: [[c8]], num: u64)-> [c8] {
    for l in ls {
        match rowNumber(l) {
            Ok(n: u64) => { if (n == num) return l; }
        }
    }

    ""
}

__test a_span_crossing_lines_is_one_region {
    // the two ends are labelled and everything between them carried by the
    // margin column, so the whole of it reads as one thing under one gutter
    let content = numbered(4u64);
    let err = copy ErrorMsg::fatal(spanLines(content, 2u64, 4u64), msg-> "e");
    let ls = render(err);

    assert(headsOf(ls).len == 1us,
           format("expected one excerpt, got % :\n%", headsOf(ls).len, renderText(err)));
    assert(format("%", excerptLines(ls)) == "{2, 3, 4}",
           format("the excerpt shows the lines % :\n%", excerptLines(ls), renderText(err)));

    let open = lineWithBoth(ls, "╋", "┏");
    let close = lineWithBoth(ls, "╋", "┗");

    assert(open != "" && close != "", format("the region has no arms :\n%", renderText(err)));
    assert(columnsOf(open, "^").len == 1us && columnsOf(close, "^").len == 1us,
           format("an end of the region points at nothing :\n%", renderText(err)));
}

__test the_arms_of_a_region_reach_the_ends_it_covers {
    // the arm leaves the margin and runs to the very byte the region opens or
    // closes at, so both of them are read off the source above them
    let content = numbered(4u64);
    let err = copy ErrorMsg::fatal(spanLines(content, 2u64, 4u64), msg-> "e");
    let ls = render(err);

    let open = columnsOf(lineWithBoth(ls, "╋", "┏"), "^");
    let close = columnsOf(lineWithBoth(ls, "╋", "┗"), "^");

    // the span runs from the first byte of "l2" to the last one of "l4". Both
    // of those are labelled, so what is read off the source around them is the
    // run before the one and the run after the other
    assert(columnsOf(rowOf(ls, 2u64), "let")[0] + 4us == open[0],
           format("the region opens at column % :\n%", open[0], renderText(err)));
    assert(columnsOf(rowOf(ls, 4u64), " = ")[0] - 1us == close[0],
           format("the region closes at column % :\n%", close[0], renderText(err)));
}

__test the_column_of_a_region_is_carried_down_the_lines_it_covers {
    // a line inside the region writes the bar left of its source, the one the
    // region opens at does not - it is only reached from its caret row on
    let content = numbered(4u64);
    let err = copy ErrorMsg::fatal(spanLines(content, 2u64, 4u64), msg-> "e");
    let ls = render(err);

    assert(columnsOf(rowOf(ls, 2u64), "┃").len == 1us,
           format("the line the region opens at is already inside it :\n%", renderText(err)));
    assert(columnsOf(rowOf(ls, 3u64), "┃").len == 2us,
           format("the region does not reach the line it covers :\n%", renderText(err)));
    assert(columnsOf(rowOf(ls, 4u64), "┃").len == 2us,
           format("the region does not reach the line it closes at :\n%", renderText(err)));
}

__test the_separator_of_a_region_keeps_its_column {
    // the lines an "..." stands for are covered by the region as well, so the
    // column carrying it is not interrupted by them
    let content = numbered(12u64);
    let err = copy ErrorMsg::fatal(spanLines(content, 2u64, 10u64), msg-> "e");
    let ls = render(err);

    assert(format("%", excerptLines(ls)) == "{2, 10}",
           format("the excerpt shows the lines % :\n%", excerptLines(ls), renderText(err)));
    assert(columnsOf(lineWith(ls, "..."), "┃").len == 1us,
           format("the separator dropped the column of the region :\n%", renderText(err)));
}

__test an_excerpt_showing_a_region_is_not_split {
    // splitting would leave the arm opening the region in one excerpt and the
    // one closing it in another, which is no longer a region
    let content = numbered(16u64);
    let notes = copy [copy ErrorMsg::note(atLine(content, "a.yr", 14u64), msg-> "far",
                                          oneLine-> true, withLoc-> true)];

    let err = copy ErrorMsg::fatal(spanLines(content, 2u64, 4u64), msg-> "e", notes-> notes);
    let ls = render(err);

    assert(headsOf(ls).len == 1us,
           format("expected one excerpt, got % :\n%", headsOf(ls).len, renderText(err)));
}

__test a_location_that_does_not_cross_a_line_has_no_margin {
    // the margin column costs two columns of every row, so an excerpt without a
    // region to draw does not open one
    let ls = render(copy ErrorMsg::fatal(at(PLAIN, '@'c8), msg-> "e"));

    assert(!contains(renderText(copy ErrorMsg::fatal(at(PLAIN, '@'c8), msg-> "e")), "┏"));
    assert(columnsOf(lineWith(ls, "┃"), "┃").len == 1us,
           format("the excerpt opened a margin :\n%", lineWith(ls, "┃")));
}

__test the_two_ends_of_a_region_are_underlined_the_same_way {
    // the region opens where the report is reported at, so the region is what
    // the report points at - and a region with one end of each kind reads as
    // two unrelated places rather than as one
    let content = numbered(6u64);
    let notes = copy [copy ErrorMsg::note(spanLines(content, 2u64, 5u64), msg-> "the whole of it")];

    let err = copy ErrorMsg::fatal(atLine(content, "a.yr", 2u64), msg-> "e", notes-> notes);
    let ls = render(err);

    let open = lineWithBoth(ls, "╋", "┏");
    let close = lineWithBoth(ls, "╋", "┗");

    assert(columnsOf(open, "^").len != 0us && columnsOf(close, "^").len != 0us,
           format("an end of the region is not the one the report points at :\n%", renderText(err)));
    assert(columnsOf(close, "-").len == 0us,
           format("the ends of the region do not agree :\n%", renderText(err)));
}
