use ymirc::lint::optimizer::dataflow;

/**
 * @returns: the set of `nb` facts holding the given ones
 * */
fn setOf(nb: usize, facts: [usize])-> [usize] {
    let dmut res = setEmpty(nb);
    for f in facts { setAdd(alias res, f); }

    res
}

/**
 * @returns: the facts a set holds, in increasing order
 * */
fn elems(set: [usize])-> [usize] {
    copy [i for i in setElems(set)]
}

__test a_set_spans_as_many_words_as_its_facts_need {
    assert(setEmpty(0us).len == 0us);
    assert(setEmpty(WORD_BITS).len == 1us);
    assert(setEmpty(WORD_BITS + 1us).len == 2us);
}

__test a_full_set_holds_no_fact_past_the_last_one {
    let nb = WORD_BITS + 6us;
    let full = setFull(nb);

    assert(elems(full) == copy [i for i in 0us .. nb]);
    assert(!setHas(full, nb));
    assert(full == setOf(nb, copy [i for i in 0us .. nb]));
    assert(setFull(WORD_BITS) == [usize::max]);
}

__test facts_are_added_and_removed_across_words {
    let nb = 2us * WORD_BITS;
    let dmut set = setEmpty(nb);
    setAdd(alias set, 3us);
    setAdd(alias set, WORD_BITS);
    setAdd(alias set, nb - 1us);
    setAdd(alias set, 5us * WORD_BITS);

    assert(elems(set) == copy [3us, WORD_BITS, nb - 1us]);
    assert(setHas(set, WORD_BITS));
    assert(!setHas(set, WORD_BITS + 1us));
    assert(!setHas(set, 5us * WORD_BITS));

    setRemove(alias set, WORD_BITS);
    setRemove(alias set, 4us);
    assert(elems(set) == copy [3us, nb - 1us]);
}

__test sets_combine_word_by_word {
    let nb = WORD_BITS + 10us;
    let a = setOf(nb, copy [1us, WORD_BITS, WORD_BITS + 2us]);
    let b = setOf(nb, copy [1us, 2us, WORD_BITS + 2us]);

    assert(elems(setUnion(a, b)) == copy [1us, 2us, WORD_BITS, WORD_BITS + 2us]);
    assert(elems(setInter(a, b)) == copy [1us, WORD_BITS + 2us]);
    assert(elems(setDiff(a, b)) == copy [WORD_BITS]);
}

__test the_transfer_is_gen_and_what_was_not_killed {
    let nb = WORD_BITS + 10us;
    let gen = setOf(nb, copy [0us, WORD_BITS + 1us]);
    let src = setOf(nb, copy [2us, 3us, WORD_BITS + 3us]);
    let kill = setOf(nb, copy [3us, WORD_BITS + 3us, WORD_BITS + 1us]);

    let dmut dst = setFull(nb);
    setTransferInto(alias dst, gen, src, kill);
    assert(elems(dst) == copy [0us, 2us, WORD_BITS + 1us]);
}
