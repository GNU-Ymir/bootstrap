in lexing;

pub mod ::word;

use integration;

use ymirc::{errors, lexing::_, utils::_};
use ymirc::global::state;

use std::{conv, io, syntax};
use std::fs::{file, path};

/**
 * Unescape the string `txt` (e.g. \n => \\n)

 *
 * */
fn unescape(txt: [c8])-> [c8] {
    let mut res = "";
    for c in txt {
        if c == '\n' { res ~= "\\n"; }
        else if c == '\t' { res ~= "\\t"; }
        else if c == '\r' { res ~= "\\r"; }
        else res ~= [c];
    }

    res
}

/**
 * Open a file, and uses lines as VERSION activations
 *
 * */
fn activateVersions(p: Path) {
    if !std::fs::sys::isFile(p)
        return;

    let version = {
        let dmut f = File::open(p);
        f:.readAll()
    };

    state::resetToDefault();
    let mut cursor = 0us;
    while cursor < version.len {
        let line = utils::getUntilLineEnd(version[cursor .. $]);

        cursor += (line.len + 1); // skipping '\n'
        state::addVersion(line);
        if line.len == 0
            break;
    }
} catch {
    _ => {} // file open fail?
}

/**
 * @yields: the index of every 'test_resources/lexing/test<i>.yr' case, the serie
 * stopping at the first index with no file
 * */
yield lexingCases()-> i32 {
    let mut i = 1;
    while std::fs::sys::isFile(Path(format("test_resources/lexing/test%.yr", i))) {
        yield i;
        i += 1;
    }
}

@parameters(lexingCases())
__test lexer_over_a_test_file (i: i32) {
    let p = Path(format("test_resources/lexing/test%.yr", i));
    let outP = Path(format("test_resources/lexing/test%.out", i));

    let txt = {
        let dmut f = File::open(p);
        f:.readAll()
    };

    activateVersions(Path(format("test_resources/lexing/test%.version", i)));
    let dmut stream = copy Formatter();
    {
        let dmut lex = copy SrcLexer("main.yr", txt);
        loop {
            let (word, comm) = lex:.next();
            stream:.write(word);
            match word {
                EofWord() => { stream:.write(" @eof\n"); break; }
                StringWord() => { stream:.write(" @str\n"); }
                TokenWord() => { stream:.write(" @tok\n"); }
                KeyWord() => { stream:.write(" @key\n"); }
                NameWord() => { stream:.write(" @name\n"); }
                NumericWord() => { stream:.write(" @num\n"); }
                FloatWord() => { stream:.write(" @fl\n"); }
                LocWord() => { stream:.write(" @loc\n"); }
            }

            stream:.write("COMM: [", comm, "]\n");
        }

        let output = {
            let dmut f = File::open(outP);
            f:.readAll()
        };

        utils::compareResultWithString(stream, output);
    } catch {
        // a case whose golden is the diagnostic the lexer raises rather than the words it reads
        err: &ErrorMsg => {
            utils::compareErrorWithFile(err?, outP);
        }
        err: &AssertError => throw err;
        err: &std::fs::errors::FsError => throw err;
    }
}
