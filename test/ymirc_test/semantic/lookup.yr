use ymirc::lexing::word;
use ymirc::semantic::symbol;
use ymirc::syntax::declaration::block;

use std::fs::path;

/**
 * @returns: a module symbol named 'name', holding no symbol
 * */
fn module(name: [c8], protection: Protection = Protection::PUBLIC)-> dmut &ModuleSymbol {
    let loc = copy LocWord(str-> name, filename-> "lookup.yr", line-> 1, col-> 1);
    copy ModuleSymbol(loc, EOF_WORD, "", isExtern-> false, isGlobal-> false, protection-> protection)
}

/**
 * @returns: the number of symbols named 'name' a lookup through 'scope' finds
 * */
fn found(dmut scope: &Symbol, name: [c8])-> usize {
    let dmut lst = scope:.getSymbols(name);
    lst:[].len
}

/**
 * ======================================================================
 * =====================     MEMOIZED LOOKUP     ========================
 * ======================================================================
 */

// A lookup memoizes what it finds in the scopes it goes through, so each case looks
// up from 'inner' and changes 'root', the scope holding the memoized lookup

__test a_repeated_lookup_finds_the_same_symbols {
    let dmut root = module("root");
    let dmut inner = module("inner");
    root:.insert(alias inner);
    root:.insert(module("foo"));

    assert(found(alias inner, "foo") == 1us, "the first lookup finds the inserted symbol");
    assert(found(alias inner, "foo") == 1us, "the memoized lookup finds it as well");
}

__test a_symbol_inserted_after_a_lookup_is_found {
    // inserted in a used module: the enclosing tables themselves are searched anew
    // by every lookup, whatever it memoized
    let dmut root = module("root");
    let dmut inner = module("inner");
    let dmut lib = module("lib");
    root:.insert(alias inner);
    root:.useModule(Path(""), alias lib);

    assert(found(alias inner, "foo") == 0us, "nothing is named foo yet");

    lib:.insert(module("foo"));
    assert(found(alias inner, "foo") == 1us, "a symbol inserted in a used module is found");
}

__test a_symbol_removed_after_a_lookup_is_not_found {
    let dmut root = module("root");
    let dmut inner = module("inner");
    let dmut foo = module("foo");
    root:.insert(alias inner);
    root:.insert(alias foo);

    assert(found(alias inner, "foo") == 1us, "the symbol is found before its removal");

    root:.remove(alias foo);
    assert(found(alias inner, "foo") == 0us, "a removed symbol is not found anymore");
}

__test a_module_used_after_a_lookup_is_searched {
    let dmut root = module("root");
    let dmut inner = module("inner");
    let dmut lib = module("lib");
    root:.insert(alias inner);
    lib:.insert(module("bar"));

    assert(found(alias inner, "bar") == 0us, "bar is not reachable before the use");

    root:.useModule(Path(""), alias lib);
    assert(found(alias inner, "bar") == 1us, "bar is reachable through the module the enclosing scope uses");
}
