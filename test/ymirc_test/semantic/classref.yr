use ymirc::lexing::word;
use ymirc::semantic::symbol;
use ymirc::semantic::generator::{type::_, value::_};
use ymirc::syntax::declaration::block;
use ymirc::syntax::expression::_;
use ymirc::utils::_;

use std::io;

/**
 * @returns: a bare class symbol, enough to hang a ClassRefType on
 * */
fn classSym()-> dmut &ClassSymbol {
    copy ClassSymbol(EOF_WORD, ""s8, EMPTY_EXPR,
                     isEntity-> false,
                     isRecord-> false,
                     isPacked-> false,
                     isOverlaid-> false,
                     isData-> false,
                     isAbstract-> false,
                     isFinal-> false,
                     protection-> Protection::PUBLIC)
}

/**
 * @returns: a typeinfo value, as ClassTypeInfoValidation would build one. A fake
 *           one carries a size of 0, but nothing in the value itself says so
 * */
fn typeInfo(size: usize)-> &TypeInfoValue {
    copy TypeInfoValue(EOF_WORD, VOID_TYPE, 0us, size, UNIT_VALUE, "T"s8)
}

/**
 * ======================================================================
 * ========================     TYPEINFO      ===========================
 * ======================================================================
 */

__test no_typeinfo_by_default {
    // a fresh class reference has no typeinfo at all
    let dmut sym = classSym();
    let cref = copy ClassRefType(EOF_WORD, sym);

    assert(!cref.hasTypeInfo, "a fresh ClassRefType must not have a typeinfo");
    assert(!cref.hasCompleteTypeInfo, "a fresh ClassRefType must not have a complete typeinfo");
}

__test a_fake_typeinfo_is_incomplete {
    // a fake typeinfo is set(so the class can be referenced during a precary
    // validation), but it must never pass for a fully validated layout - its
    // fields are still ERROR_TYPE placeholders
    let dmut sym = classSym();
    let dmut cref = copy ClassRefType(EOF_WORD, sym);
    cref:.setTypeInfo(typeInfo(0us), fake-> true);

    assert(cref.hasTypeInfo, "a fake typeinfo is still a typeinfo");
    assert(!cref.hasCompleteTypeInfo, "a fake typeinfo must not count as a complete one");
}

__test a_definitive_typeinfo_is_complete {
    // a definitive typeinfo counts for both
    let dmut sym = classSym();
    let dmut cref = copy ClassRefType(EOF_WORD, sym);
    cref:.setTypeInfo(typeInfo(8us));

    assert(cref.hasTypeInfo, "a definitive typeinfo is a typeinfo");
    assert(cref.hasCompleteTypeInfo, "a definitive typeinfo is a complete one");
}

__test revalidation_replaces_the_fake_typeinfo {
    // a class re-validated after a precary pass replaces its fake typeinfo, and
    // is complete from then on
    let dmut sym = classSym();
    let dmut cref = copy ClassRefType(EOF_WORD, sym);
    cref:.setTypeInfo(typeInfo(0us), fake-> true);
    cref:.setTypeInfo(typeInfo(8us));

    assert(cref.hasCompleteTypeInfo, "re-validation must clear the fake flag");
}
