in overlay;

use std::conv;

@parameters(utils::range (1, 5))
__test source_overlay (i: i32) {
    let case = "test_resources/overlay/test" ~ conv::to!{[c8]}(i);
    utils::registerTest (case ~ ".yr", withOverlay-> case ~ ".overlay");
}

// an extern package included through a relative directory only existing in the overlay
__test extern_overlay {
    utils::registerTest ("test_resources/overlay/test6.yr", withOverlay-> "test_resources/overlay/test6.overlay",
                         withImports-> copy ["test_resources/overlay/test6_lib"]);
}
