in utils;

pub mod ::diff;

use integration::utils::diff;

use ymirc::{args, errors, global::_, parser, utils::_};
use ymirc::lexing::word;
use ymirc::lint::node::{_, global::_};
use ymirc::semantic::generator::_;
use ymirc::syntax::{_, declaration::_};

use std::{config::_, conv, fs::_, io, time::_};

lazy EMPTY_MODULE = copy ModuleDecl(EOF_WORD, "", EOF_WORD,
                                    copy BlockDecl(EOF_WORD, "", [], Protection::PRIVATE, false),
                                    true);

pub record CompileResult {
    pub let synt: &Declaration = EMPTY_MODULE;
    pub let sem: [&Generator] = [];
    pub let exp: [&YILNode] = [];
    pub let types: [&YILType] = [];
    pub let withLint: bool = true;
    pub let err: (&ErrorMsg)? = none;

    pub self (synt: &Declaration = EMPTY_MODULE,
              sem: [&Generator] = [],
              exp: [&YILNode] = [],
              types: [&YILType] = [],
              withLint: bool = true,
              err: (&ErrorMsg)? = none)
        with synt = synt
        , sem = sem
        , exp = exp
        , types = types
        , err = err
        , withLint = withLint
    {}
}

/**
 * Register a test
 * @params:
 *    - package: the root file of the compilation
 *    - results: the name of the output files(where adding extension .err, .sem and .yil will point to those files)
 *    - withYIL: generate yil, or stop at semantic
 *    - withImports: list of external package to import
 *    - removeWeak: true iif not comparing weak symbols in yil
 *    - withCoverage: compile in unittest mode, so that coverage instrumentation is emitted
 * */
pub fn registerTest(package: [c8],
                    results: [c8] = "",
                    withImports: [[c8]] = [],
                    removeWeak: bool = false,
                    withCoverage: bool = false)
    throws AssertError
{
    let rpath = if results == "" {
        Path(package).stripExtension()
    } else { Path(results).stripExtension() };

    let withYIL = fs::sys::isFile(rpath.addExtension("yil"));
    let compileRes = compileFile(Path(package).stripExtension().addExtension("yr"),
                                 withLint-> withYIL,
                                 withImports-> withImports,
                                 withCoverage-> withCoverage);

    compareResultWithFiles(compileRes, rpath, removeWeak-> removeWeak);
}

/**
 * Register a numbered serie of tests, 'dir/test<lo>.yr' up to 'dir/test<hi>.yr'
 * Contrarily to a hand written loop, a failing case does not prevent the next ones
 * from running, every error is kept and they are all reported at once at the end
 * @params:
 *    - dir: the directory containing the test files
 *    - lo: index of the first test
 *    - hi: index of the last test (included)
 *    - suffix: what follows the index, e.g. "/foo.yr" when each case has its own directory
 *    - name: the name displayed in the logs (the basename of 'dir' by default)
 *    - removeWeak: true iif not comparing weak symbols in yil
 *    - withCoverage: compile in unittest mode, so that coverage instrumentation is emitted
 * */
pub fn registerTests(dir: [c8], lo: i32, hi: i32, suffix: [c8] = ".yr", name: [c8] = "", removeWeak: bool = false, withCoverage: bool = false)
    throws AssertError
{
    let disp = if name == "" { Path(dir).file() } else { name };
    let mut failures: [([c8], &AssertError)] = [];

    for i in lo ... hi {
        let index = conv::to!{[c8]}(i);
        logging::setRelativeTime();
        logging::info(" Test % % start", disp, index);
        {
            registerTest(dir ~ "/test" ~ index ~ suffix, removeWeak-> removeWeak, withCoverage-> withCoverage);
            logging::success(" Test % % finished", disp, index);
        } catch {
            err: &AssertError => {
                logging::failure(" Test % % failed", disp, index);
                failures ~= [(index, err)];
            }
        }
    }

    if (failures.len != 0us) {
        let mut report = format("% : %/% cases failed", disp, failures.len, hi - lo + 1);
        for f in failures {
            report = report ~ format("\n  - test%% : %", f.0, suffix, (f.1).msg);
        }

        throw copy AssertError(report);
    }
}

/**
 * Compile a package and hand back the raw result, for tests asserting on the produced nodes
 * rather than comparing them to a golden file
 * @params:
 *    - package: the root file of the compilation
 *    - withCoverage: compile in unittest mode, so that coverage instrumentation is emitted
 *    - withStandalone: compile in standalone mode, the package providing the core library itself
 *    - withYILExport: directory in which to write the .yil bytecode of the package(none if empty)
 * */
pub fn compilePackage(package: [c8], withCoverage: bool = false, withStandalone: bool = false, withYILExport: Path = Path(""))-> CompileResult {
    return compileFile(Path(package).stripExtension().addExtension("yr"),
                       withLint-> true,
                       withCoverage-> withCoverage,
                       withStandalone-> withStandalone,
                       withYILExport-> withYILExport);
}

/**
 * Compile a package
 * */
fn compileFile(filename: Path,
               withLint: bool = false,
               withImports: [[c8]] = [],
               withCoverage: bool = false,
               withStandalone: bool = false,
               withYILExport: Path = Path(""))-> CompileResult
{
    ymirc::global::state::resetToDefault(); // reset all global informations
    if withCoverage { // coverage probes are only emitted in unittest mode
        ymirc::global::state::activateUnittest();
    }

    if withStandalone { // core is not loaded from the include prefix, the package provides it
        ymirc::global::state::activateStandalone();
    }

    if withYILExport.toStr() != "" { // the expansion step serializes the produced YIL there
        ymirc::global::state::activateYILExport(withYILExport);
    }

    let args = YmirArguments(file-> filename.toStr(),
                              noLint-> !withLint,
                              includes-> withImports);

    let dmut parser = copy Parser(args);

    parser:.parseAll();

    return CompileResult(synt-> parser.getSyntaxModule(),
                          sem-> parser.getSemGenerators(),
                          exp-> parser.getExpYILNodes(),
                          types-> parser.getExpYILTypes(),
                          withLint-> withLint);

} catch {
    err: &ErrorMsg => {
        return CompileResult(err-> err?);
    }
}

/**
 * Compare result of compilation with output files
 * */
fn compareResultWithFiles(result: CompileResult, loc: Path, removeWeak: bool = false)
    throws AssertError
{
    if fs::sys::isFile(loc.addExtension("err")) {
        compareErrorWithFile(result.err, loc.addExtension("err"));
    } else {
        ensureErrorEmpty(result.err);
        if fs::sys::isFile(loc.addExtension("sem")) {
            compareResultWithFile(result.sem, loc.addExtension("sem"), removeWeak-> removeWeak);
        }

        if result.withLint && fs::sys::isFile(loc.addExtension("yil")) {
            compareResultWithFile(result.types, result.exp, loc.addExtension("yil"), removeWeak-> removeWeak);
        }
    }
} catch {
    f: &FsError => {
        throw copy AssertError(format("%", f));
    }
    err: &AssertError => throw err;
}


fn compareResultWithFile(gens: [&Generator], filename: Path, removeWeak: bool = false)
    throws AssertError, FsError
{
    let output = {
        let dmut f = File::open(filename);
        f:.readAll()
    };

    let dmut stream = copy Formatter(tags-> FormatTags(forDebug-> true, withVarIds-> false));
    let mut valids: [mut([c8], &GlobalGen)] = [];
    for i in gens {
        if let f: &FrameGenerator = i {
            valids ~= [(Mangler::mangle(f), f)];
        }
        else if let u: &UnitTestGenerator = i {
            valids ~= [(Mangler::mangle(u), u)];
        }
    }

    valids = std::algorithm::sorting::sort(alias valids, |a, b| => { a.0 < b.0 });
    for v in valids {
        if (!removeWeak || !(v.1).isWeak) {
            stream:.write(format("%\n", v.1, tags-> FormatTags(withParams-> false, forDebug-> true)));
        }
    }

    compareResultWithString(stream, output, origin-> filename.toStr());
}

fn compareResultWithFile(types: [&YILType], yil: [&YILNode], filename: Path, removeWeak: bool = false, onlyFrames: bool = false)
    throws AssertError, FsError
{
    let output = {
        let dmut f = File::open(filename);
        f:.readAll()
    };

    let dmut stream = copy Formatter(tags-> FormatTags(forDebug-> true, withVarIds-> false));
    for t in std::algorithm::sorting::sort(copy types, |a, b| => { a.uid < b.uid }) {
        stream:.write(format("%;\n", t, tags-> FormatTags(withParams-> true, forDebug-> true)));
    }

    for i in yil {
        let remove = if (removeWeak || onlyFrames) {
            match i {
                f: &YILFrame => { f.isWeak && removeWeak }
                g: &YILGlobalVar => { g.isWeak || onlyFrames }
                c: &YILConstant => { c.isWeak || onlyFrames }
                _ => { false }
            }
        } else { false };

        if (!remove) {
            // use a new stream for each node, to reset counters
            stream:.write(format("%", i, tags-> FormatTags(forDebug-> true)), '\n'c8);
        }
    }

    compareResultWithString(stream, output, origin-> filename.toStr(), canonicalizeIds-> true);
}

// Golden dumps use this in place of the absolute path to the installed standard library
// (see expandRuntimePathPlaceholder), since that path isn't portable across machines/toolchains.
def RUNTIME_PATH_PLACEHOLDER = "{{RUNTIME_PATH}}";

/**
 * A panic embeds the source location it was raised from as a literal string — for a check
 * that lives inside a generic/template defined by the standard library itself(e.g. an array
 * bounds check embeds the location of the runtime's own `core::types::array.yr`), that is
 * the absolute install path of the runtime, not a path relative to the compiled package(see
 * `state::relativePath`, which only relativizes paths under the current working directory).
 * That install path isn't portable(`/usr/include/ymir/<version>` by default, but
 * configurable, and the version component changes with the runtime), so golden dumps spell
 * it as `{{RUNTIME_PATH}}` instead. Expand it back to whatever path this run's toolchain
 * actually used before comparing against the produced dump.
 * */
fn expandRuntimePathPlaceholder(txt: [c8])-> [c8] {
    let placeholder = RUNTIME_PATH_PLACEHOLDER;
    let actual = ymirc::global::state::corePath().toStr();

    let mut res: [c8] = [];
    let mut i = 0us;
    while i < txt.len {
        if (i + placeholder.len <= txt.len && txt[i .. i + placeholder.len] == placeholder) {
            res ~= actual;
            i += placeholder.len;
        } else {
            res ~= [txt[i]];
            i += 1us;
        }
    }

    res
}

/**
 * Compare a produced result with the expected text, printing a line diff and throwing
 * when they differ
 * @params:
 *    - stream: the produced result
 *    - output: the expected text
 *    - origin: what to name in the error message(the golden file, usually)
 *    - canonicalizeIds: renumber the T_/P_/A_ global type ids of both texts before comparing,
 *      so a harmless renumbering (nondeterministic type-discovery order during expansion)
 *      does not fail the test — see canonicalizeTypeIds
 * */
pub fn compareResultWithString(stream: &Formatter, output: [c8], origin: [c8] = "", canonicalizeIds: bool = false)
    throws AssertError
{
    let mut res = removeColors(stream[]);
    let mut exp = expandRuntimePathPlaceholder(output);
    if (canonicalizeIds) {
        res = canonicalizeTypeIds(res);
        exp = canonicalizeTypeIds(exp);
    }

    if (res != exp) {
        let d = diff::diffLines(diff::splitLines(exp), diff::splitLines(res));
        let name = if origin == "" { "result" } else { origin };

        eprintln(Colors::YELLOW, "--- ", name, " (expected)", Colors::RESET);
        eprintln(Colors::YELLOW, "+++ produced", Colors::RESET);
        eprint(diff::formatDiff(d));

        assert(false, format("% differs at line % (% lines)", name,
                             diff::firstDiffLine(d), diff::countChanges(d)));
    }
}

/**
 * Find every occurrence of a global YIL type id(T_<n>, P_<n>, A_<n>) in a line
 * @returns: the list of(offset, full token), in left to right order
 * */
fn findTypeIds(line: [c8])-> [(usize, [c8])] {
    let mut res: [(usize, [c8])] = [];
    let mut i = 0us;
    while i < line.len {
        let c = line[i];
        let isBoundary = i == 0us || !isIdentChar(line[i - 1us]);
        if (c == 'T' || c == 'P' || c == 'A') && isBoundary
            && i + 2us < line.len && line[i + 1us] == '_'
            && line[i + 2us] >= '0' && line[i + 2us] <= '9'
        {
            let mut j = i + 2us;
            while j < line.len && line[j] >= '0' && line[j] <= '9' {
                j += 1us;
            }

            res ~= [(i, line[i .. j])];
            i = j;
        } else {
            i += 1us;
        }
    }

    res
}

fn isIdentChar(c: c8)-> bool {
    (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
}

/**
 * @returns: true iif line is a top level type declaration("tuple T_.. ;", "pointer P_.. ;",
 *           "array A_.. ;"), as opposed to a const/frame body line
 * */
fn isTypeDecl(line: [c8])-> bool {
    (line.len >= 6us && line[0us .. 6us] == "tuple ")
        || (line.len >= 8us && line[0us .. 8us] == "pointer ")
        || (line.len >= 6us && line[0us .. 6us] == "array ")
}

/**
 * Renumber the global type ids(T_<n>, P_<n>, A_<n>) referenced in a line, following the
 * mapping built by canonicalizeTypeIds
 * */
fn renumberTypeIds(line: [c8], canon: [[c8] => usize])-> [c8] {
    let mut res: [c8] = [];
    let mut pos = 0us;
    for m in findTypeIds(line) {
        res ~= line[pos .. m.0];
        res ~= [m.1[0us]];
        res ~= "_";
        if let Ok(cid: usize) = canon[m.1] {
            res ~= conv::to!{[c8]}(cid);
        }
        pos = m.0 + (m.1).len;
    }

    res ~= line[pos .. $];

    res
}

/**
 * The `.yil` dump lists every generated YIL type(tuple/pointer/array) with a global id,
 * assigned in the order the TypeExpander first discovers each distinct type while walking
 * the semantic tree(see TypeExpander._uid, ymirc::lint::expander::type). That discovery
 * order is not guaranteed stable across runs(hash-map/set iteration order somewhere
 * upstream), so the exact ids — and sometimes the order the type declarations are printed
 * in — can shift between two otherwise-identical compilations(see YMI-146).
 *
 * So instead of comparing raw ids, renumber every type in two passes.
 *
 * Pass 1 walks the frame/const bodies — printed in a fixed, source-derived order, so
 * already deterministic — in that fixed order, and every time a not yet-numbered type is
 * referenced, numbers it and recurses into whatever types *it* references. This is what
 * correctly tells apart types that are structurally identical but conceptually distinct,
 * e.g. three classes with the same empty vtable+monitor layout: nothing in their own
 * declaration text differs, only *which frame uses which one* does.
 *
 * Pass 2 orders whatever pass 1 never reached(a type only ever referenced from other
 * types' declarations, never named directly in a body — e.g. a class name string's own
 * length/pointer/block-info tuple, which const dumps print inlined rather than by id) by a
 * structural fixpoint instead: repeatedly canonicalize whichever remaining types have every
 * type they reference already numbered(their declaration, with those references
 * substituted, is then a pure function of structure), ordering same-round types by that
 * text. A reference cycle confined entirely to this leftover set(nothing analogous has
 * been seen in practice, but two mutually-recursive types with no direct body user aren't
 * impossible) is broken by sorting on declaration text with unresolved references left
 * blank — still never a raw numeric id, so still run-independent.
 *
 * Two structurally equivalent dumps always end up with the same canonical ids this way,
 * regardless of which raw ids the two runs happened to assign, so only a genuine structural
 * difference(a real extra/missing/mismatched type) still shows up as a diff.
 * */
fn canonicalizeTypeIds(txt: [c8])-> [c8] {
    let lines = diff::splitLines(txt);

    let dmut headerMap: [[c8] => [c8]] = copy [];
    let mut headerOrder: [[c8]] = [];
    let mut bodyLines: [[c8]] = [];

    for line in lines {
        let mut isHeader = false;
        if (isTypeDecl(line)) {
            let ids = findTypeIds(line);
            if (ids.len != 0us) {
                headerMap[ids[0us].1] = copy line;
                headerOrder ~= [ids[0us].1];
                isHeader = true;
            }
        }

        if (!isHeader) {
            bodyLines ~= [line];
        }
    }

    let dmut canon: [[c8] => usize] = copy [];
    let mut nextId = 1us;

    // Pass 1: forward walk from the bodies.
    let mut queue: [[c8]] = [];
    for line in bodyLines {
        for m in findTypeIds(line) {
            if (m.1 !in canon) {
                canon[m.1] = nextId;
                nextId += 1us;
                queue ~= [m.1];
            }
        }
    }

    let mut qi = 0us;
    while qi < queue.len {
        let id = queue[qi];
        qi += 1us;

        if let Ok(declLine: [c8]) = headerMap[id] {
            let refs = findTypeIds(declLine);
            for i in 1us .. refs.len {
                let m = refs[i];
                if (m.1 !in canon) {
                    canon[m.1] = nextId;
                    nextId += 1us;
                    queue ~= [m.1];
                }
            }
        }
    }

    // Pass 2: structural fixpoint over whatever pass 1 left unreached.
    let mut remaining = 0us;
    for id in headerOrder {
        if (id !in canon) { remaining += 1us; }
    }

    while remaining != 0us {
        let mut ready: [mut([c8], [c8])] = [];

        for id in headerOrder {
            if (id !in canon) {
                if let Ok(declLine: [c8]) = headerMap[id] {
                    let refs = findTypeIds(declLine);
                    let mut allKnown = true;
                    for i in 1us .. refs.len {
                        if ((refs[i]).1 !in canon) { allKnown = false; }
                    }

                    if (allKnown) {
                        ready ~= [(id, renumberTypeIds(declLine, canon))];
                    }
                }
            }
        }

        if (ready.len == 0us) {
            // A reference cycle confined to the leftover set: sort by declaration text with
            // unresolved references left blank(renumberTypeIds already does this), so the
            // key is still never a raw numeric id.
            for id in headerOrder {
                if (id !in canon) {
                    if let Ok(declLine: [c8]) = headerMap[id] {
                        ready ~= [(id, renumberTypeIds(declLine, canon))];
                    }
                }
            }
        }

        ready = std::algorithm::sorting::sort(alias ready, |a, b| => { a.1 < b.1 });
        for r in ready {
            if (r.0 !in canon) {
                canon[r.0] = nextId;
                nextId += 1us;
                remaining -= 1us;
            }
        }
    }

    let mut headerPairs: [mut(usize, [c8])] = [];
    for id in headerOrder {
        if let Ok(cid: usize) = canon[id] {
            if let Ok(declLine: [c8]) = headerMap[id] {
                headerPairs ~= [(cid, renumberTypeIds(declLine, canon))];
            }
        }
    }

    headerPairs = std::algorithm::sorting::sort(alias headerPairs, |a, b| => { a.0 < b.0 });

    let mut res: [c8] = [];
    for p in headerPairs {
        res ~= p.1;
        res ~= "\n";
    }

    for line in bodyLines {
        res ~= renumberTypeIds(line, canon);
        res ~= "\n";
    }

    res
}

pub fn compareErrorWithFile(error: (&ErrorMsg)?, filename: Path)
    throws AssertError
{
    let output = {
        let dmut f = File::open(filename);
        f:.readAll().trimLineEnds()
    };

    match error {
        Ok(err: &ErrorMsg) => {
            let dmut stream = copy Formatter(tags-> FormatTags(verbose-> true));
            stream:.write(err, "\n");

            let dmut trimmed = copy Formatter();
            trimmed:.write(removeColors(stream[]).trimLineEnds());

            compareResultWithString(trimmed, output, origin-> filename.toStr());
        }
        _ => {
            assert(output.len == 0us,
                   format("% expects an error, but the compilation succeeded", filename.toStr()));
        }
    }

} catch {
    f: &FsError => {
        assert(false, format("could not read % : %", filename.toStr(), f));
    }
    err: &AssertError => throw err;
}


fn ensureResultEmpty(gens: [&Generator])
    throws AssertError
{
    if (gens.len != 0us) {
        let dmut stream = copy Formatter();
        for i in gens {
            stream:.write(i, '\n');
        }

        eprintln("Result not empty: ", stream[]);
        assert(false, "result not empty");
    }
}

fn ensureErrorEmpty(error: (&ErrorMsg)?)
    throws AssertError
{
    match error {
        Ok(err: &ErrorMsg) => {
            let dmut stream = copy Formatter();
            stream:.write(err, "\n");

            let res = removeColors(stream[]).trimLineEnds();

            eprintln("Error not empty: \n", res);
            assert(false, "compilation failed, but no .err file was expected");
        }
    }
}

pub fn removeColors(txt: [c8])-> [c8] {
    let mut res: [c8] = [];
    let mut i = 0us;
    while i < txt.len {
        let col = isColor(txt[i..$]);
        if (col.len != 0) {
            i += col.len;
        } else if (txt[i] != '\u{0}') {
            res ~= [txt[i]];
            i += 1us;
        } else i += 1us;
    }

    res
}

pub fn isColor(current: [c8])-> [c8] {
    for i in Colors::__members__ {
        if (current.len >= i.len) {
            if (current[0us .. i.len] == i) return i;
        }
    }

    []
}

pub fn trimLineEnds(txt: [c8])-> [c8] {
    let mut res: [c8] = [];
    let mut nb = 0us;
    for i in 0us .. txt.len {
        if (txt[i] == ' ') {
            nb += 1us;
        } else if (txt[i] == '\t') {
            nb += 4us;
        } else {
            if (txt[i] != '\n') {
                for _ in 0us .. nb {
                    res ~= [' '];
                }
            }
            nb = 0us;
            res ~= [txt[i]];
        }
    }

    res
}

pub fn getUntilLineEnd(txt: [c8])-> [c8] {
    let mut e = 0us;
    while (e < txt.len) {
        if (txt[e] == '\n') return txt[0us .. e];
        e += 1us;
    }

    txt
}
