in versions;

@parameters(utils::range (1, 7))
__test versions (i: i32) {
    utils::registerCase ("test_resources/version", i,
                         withVersions-> copy ["foo=12", "ALSO_TWELVE=12", "Pi=1.5", "MODE=fast", "EQ=a=b", "EMPTY=",
                                              "BARE", "WORD=abc", "TWICE=1", "TWICE=2", "RESET=1", "RESET"]);
}
