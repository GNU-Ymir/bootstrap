in core_root_lookup;

use ymirc::utils::log;

// fix: the paths the compiler resolves on its own behalf(core::types::info::TypeInfo of a
// class layout, here) were relative expressions, resolved from the scope being validated.
// In standalone mode nothing implicitly uses the core modules, so a module that never
// writes `core` had to import it anyway, and only ever noticed when it was the first of
// the batch to reach the resolution.
__test core_path_resolved_from_the_root {
    logging::setRelativeTime ();
    logging::info (" Test regression core_root_lookup start");
    utils::registerTest ("test_resources/regressions/core_root_lookup/test1.yr",
                         withImports-> copy ["test_resources/regressions/core_root_lookup/coreinc"],
                         withStandalone-> true);
    utils::registerTest ("test_resources/regressions/core_root_lookup/test2.yr",
                         withImports-> copy ["test_resources/regressions/core_root_lookup/coreinc"],
                         withStandalone-> true);
    logging::success (" Test regression core_root_lookup finished");
}
