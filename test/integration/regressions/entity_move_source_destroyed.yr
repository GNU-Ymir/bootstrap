in entity_move_source_destroyed;

use ymirc::utils::_;
use utils;

// fix: a moved-from entity is reconstructed by the reset ctor, so it is alive again and must be destroyed
__test moved_from_entity_is_destroyed {
    logging::setRelativeTime ();
    logging::info (" Test regression entity_move_source_destroyed 1 start");
    utils::registerTest ("test_resources/regressions/entity_move_source_destroyed/test1.yr");
    logging::success (" Test regression entity_move_source_destroyed 1 finished");
}
