in record_field_and_ctor_redirect;

use ymirc::utils::_;
use utils;

// c7d8dde => fix: nested record field assignment through an index, and ctor redirect to 'self ()'
__test {
    for i in 1 ... 2 {
        logging::setRelativeTime ();
        logging::info (" Test regression record_field_and_ctor_redirect % start", i);
        utils::registerTest ("test_resources/regressions/record_field_and_ctor_redirect/test" ~ std::conv::to!{[c8]} (i) ~ ".yr");
        logging::success (" Test regression record_field_and_ctor_redirect % finished", i);
    }
}
