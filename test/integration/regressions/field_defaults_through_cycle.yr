in field_defaults_through_cycle;

// YMI-214 => fix: the default values of the fields of a class are kept when its ctor is
// validated by a field of another class it reaches through an import cycle
__test whole_package {
    utils::registerTest ("test_resources/regressions/field_defaults_through_cycle/test1.yr",
                         results-> "test_resources/regressions/field_defaults_through_cycle/whole");
}

__test from_the_constructed_class {
    utils::registerTest ("test_resources/regressions/field_defaults_through_cycle/test1.yr",
                         results-> "test_resources/regressions/field_defaults_through_cycle/compose",
                         withModuleFilters-> copy ["test1/compose.yr"]);
}

__test from_the_middle_of_the_cycle {
    utils::registerTest ("test_resources/regressions/field_defaults_through_cycle/test1.yr",
                         results-> "test_resources/regressions/field_defaults_through_cycle/node_compose",
                         withModuleFilters-> copy ["test1/node.yr", "test1/compose.yr"]);
}

__test from_the_constructing_class {
    utils::registerTest ("test_resources/regressions/field_defaults_through_cycle/test1.yr",
                         results-> "test_resources/regressions/field_defaults_through_cycle/scene",
                         withModuleFilters-> copy ["test1/scene.yr"]);
}

__test class_from_the_constructed_class {
    utils::registerTest ("test_resources/regressions/field_defaults_through_cycle/test2.yr",
                         results-> "test_resources/regressions/field_defaults_through_cycle/class_compose",
                         withModuleFilters-> copy ["test2/compose.yr"]);
}
