in class_completed_for_another_class;

// YMI-201 => fix: a class validated at the deepest level is completed again for another class needing its methods
@parameters(utils::range (1, 5))
__test class_completed_for_another_class (i: i32) {
    utils::registerCase ("test_resources/regressions/class_completed_for_another_class", i);
}
