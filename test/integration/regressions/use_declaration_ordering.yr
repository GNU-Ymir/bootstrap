in use_declaration_ordering;
use ymirc::utils::_;
use utils;

// 600ea => fix: use declaration is now placed at a final stage of declaration, it is more logical there
__test use_of_a_local_module {
    logging::setRelativeTime ();
    logging::info (" Test regression use_declaration_ordering 1 start");
    utils::registerTest ("test_resources/regressions/use_declaration_ordering/test1.yr");
    logging::success (" Test regression use_declaration_ordering 1 finished");
}

__test use_of_an_imported_package {
    logging::setRelativeTime ();
    logging::info (" Test regression use_declaration_ordering 2 start");
    utils::registerTest ("test_resources/regressions/use_declaration_ordering/test2.yr", withImports-> copy ["test_resources/regressions/use_declaration_ordering/foo.yr"]);
    logging::success (" Test regression use_declaration_ordering 2 finished");
}
