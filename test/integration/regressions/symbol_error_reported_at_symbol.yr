in symbol_error_reported_at_symbol;

// YMI-213 => fix: the failure of a symbol is reported at the symbol, once, whatever the uses reaching it
__test outside_the_filter {
    utils::registerTest ("test_resources/regressions/symbol_error_reported_at_symbol/test1.yr",
                         results-> "test_resources/regressions/symbol_error_reported_at_symbol/camera",
                         withModuleFilters-> copy ["test1/camera.yr", "test1/indexed.yr"]);
}

__test through_a_cycle {
    utils::registerTest ("test_resources/regressions/symbol_error_reported_at_symbol/test2.yr",
                         results-> "test_resources/regressions/symbol_error_reported_at_symbol/subpass",
                         withModuleFilters-> copy ["test2/subpass.yr", "test2/window.yr", "test2/activity.yr"]);
}

__test whole_package {
    utils::registerTest ("test_resources/regressions/symbol_error_reported_at_symbol/test2.yr",
                         results-> "test_resources/regressions/symbol_error_reported_at_symbol/whole");
}
