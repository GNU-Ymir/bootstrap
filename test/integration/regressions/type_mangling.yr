in type_mangling;

use ymirc::utils::_;
use utils;

// 29465 => fix: missing mangling of type
__test {
    for i in 1 ... 2 {
        logging::setRelativeTime ();
        logging::info (" Test regression type_mangling % start", i);
        utils::registerTest ("test_resources/regressions/type_mangling/test" ~ std::conv::to!{[c8]} (i) ~ ".yr");
        logging::success (" Test regression type_mangling % finished", i);
    }
}
