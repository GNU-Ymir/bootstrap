in for_loop_continue_step;

use ymirc::utils::_;
use utils;

// YMI-97 => fix: 'continue' inside a 'for' loop used to jump straight to the test,
// skipping the iterator increment that was appended at the end of the loop body. The
// increment is now a loop step of its own, and 'continue' targets it.
__test continue_runs_the_loop_step {
    logging::setRelativeTime ();
    logging::info (" Test regression for_loop_continue_step start");
    utils::registerTests ("test_resources/regressions/for_loop_continue_step", 1, 2);
    logging::success (" Test regression for_loop_continue_step finished");
}
