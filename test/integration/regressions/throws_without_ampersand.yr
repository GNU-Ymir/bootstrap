in throws_without_ampersand;

use ymirc::utils::_;
use utils;

// b2ebe => change: change throws &X to throws X, as the & was useless
__test {
    for i in 1 ... 3 {
        logging::setRelativeTime ();
        logging::info (" Test regression throws_without_ampersand % start", i);
        utils::registerTest ("test_resources/regressions/throws_without_ampersand/test" ~ std::conv::to!{[c8]} (i) ~ ".yr");
        logging::success (" Test regression throws_without_ampersand % finished", i);
    }
}
