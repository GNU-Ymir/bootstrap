in ctor_method_same_name;

use ymirc::utils::log;

// YMI-198 => fix: a named ctor and a method of the same name do not shadow each other
__test ctor_and_method_share_a_name {
    logging::setRelativeTime ();
    logging::info (" Test regression ctor_method_same_name 1 start");
    utils::registerTest ("test_resources/regressions/ctor_method_same_name/test1.yr");
    logging::success (" Test regression ctor_method_same_name 1 finished");
}

// YMI-198 => fix: std::fs::File declares a named ctor and a method both named open
__test std_file_ctor_and_method_share_a_name {
    logging::setRelativeTime ();
    logging::info (" Test regression ctor_method_same_name 2 start");
    utils::registerTest ("test_resources/regressions/ctor_method_same_name/test2.yr");
    logging::success (" Test regression ctor_method_same_name 2 finished");
}
