in lazy_module_sibling_use;

use ymirc::utils::_;
use utils;

// fix: a module imported as a sibling ('mod .fmt;') by a module that is itself only
// loaded lazily was declared outside the subtree the lazy loader finalizes, so its
// 'use' declarations were never resolved and every symbol they brought in came out
// undefined. Reproducing it needs a '-fmodule' filter that keeps the sibling but not
// the module importing it, which is what gyllir's parallel batching produced by chance.
__test sibling_of_a_lazy_module {
    logging::setRelativeTime ();
    logging::info (" Test regression lazy_module_sibling_use 1 start");
    utils::registerTest ("test_resources/regressions/lazy_module_sibling_use/test1.yr",
                         results-> "test_resources/regressions/lazy_module_sibling_use/filtered",
                         withModuleFilters-> copy ["test1/fmt.yr", "test1/user.yr"]);
    logging::success (" Test regression lazy_module_sibling_use 1 finished");
}

// the same package with no filter at all: 'base' is declared during the main pass, so
// 'fmt' is covered by the global finalize sweep. This is the path that always worked,
// kept so a fix that only ever runs under a filter cannot pass unnoticed.
__test package_without_a_filter {
    logging::setRelativeTime ();
    logging::info (" Test regression lazy_module_sibling_use 2 start");
    utils::registerTest ("test_resources/regressions/lazy_module_sibling_use/test1.yr",
                         results-> "test_resources/regressions/lazy_module_sibling_use/whole");
    logging::success (" Test regression lazy_module_sibling_use 2 finished");
}

// and with the importing module kept by the filter too, so it is declared eagerly:
// 'fmt' is then a normal eager sibling, again covered by the main sweep
__test sibling_of_an_eager_module {
    logging::setRelativeTime ();
    logging::info (" Test regression lazy_module_sibling_use 3 start");
    utils::registerTest ("test_resources/regressions/lazy_module_sibling_use/test1.yr",
                         results-> "test_resources/regressions/lazy_module_sibling_use/eager",
                         withModuleFilters-> copy ["test1/base.yr", "test1/fmt.yr", "test1/user.yr"]);
    logging::success (" Test regression lazy_module_sibling_use 3 finished");
}
