in float_properties;

use ymirc::utils::_;
use utils;

// b1185 => feat: floating point properties
__test {
    for i in 1 ... 2 {
        logging::setRelativeTime ();
        logging::info (" Test regression float_properties % start", i);
        utils::registerTest ("test_resources/regressions/float_properties/test" ~ std::conv::to!{[c8]} (i) ~ ".yr");
        logging::success (" Test regression float_properties % finished", i);
    }
}
