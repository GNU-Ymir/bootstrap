in named_ctor_not_unnamed;

use ymirc::utils::log;

// YMI-197 => fix: Foo(...) only considers the unnamed constructors of Foo
__test unnamed_call_rejects_named_ctor {
    logging::setRelativeTime ();
    logging::info (" Test regression named_ctor_not_unnamed 1 start");
    utils::registerTest ("test_resources/regressions/named_ctor_not_unnamed/test1.yr");
    logging::success (" Test regression named_ctor_not_unnamed 1 finished");
}

// YMI-197 => fix: a named ctor is reached through Foo::name(...)
__test named_call_reaches_named_ctor {
    logging::setRelativeTime ();
    logging::info (" Test regression named_ctor_not_unnamed 2 start");
    utils::registerTest ("test_resources/regressions/named_ctor_not_unnamed/test2.yr");
    logging::success (" Test regression named_ctor_not_unnamed 2 finished");
}

// YMI-197 => fix: Foo(...) does not reach a named template ctor
__test unnamed_call_rejects_named_template_ctor {
    logging::setRelativeTime ();
    logging::info (" Test regression named_ctor_not_unnamed 3 start");
    utils::registerTest ("test_resources/regressions/named_ctor_not_unnamed/test3.yr");
    logging::success (" Test regression named_ctor_not_unnamed 3 finished");
}

// YMI-197 => fix: super(...) without a rename does not reach a named ctor of the parent
__test super_call_rejects_named_ctor {
    logging::setRelativeTime ();
    logging::info (" Test regression named_ctor_not_unnamed 4 start");
    utils::registerTest ("test_resources/regressions/named_ctor_not_unnamed/test4.yr");
    logging::success (" Test regression named_ctor_not_unnamed 4 finished");
}
