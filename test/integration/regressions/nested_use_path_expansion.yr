in nested_use_path_expansion;
use ymirc::utils::_;
use utils;

// fix: the '{ ... }' part of a use path was rebased on the first segment of the
// path instead of the whole prefix, so 'a::b::{c}' was resolved as 'a::c'
__test {
    logging::setRelativeTime ();
    logging::info (" Test regression nested_use_path_expansion 1 start");
    utils::registerTest ("test_resources/regressions/nested_use_path_expansion/test1.yr",
                         withImports-> copy ["test_resources/regressions/nested_use_path_expansion/imports"]);
    logging::success (" Test regression nested_use_path_expansion 1 finished");
}

__test {
    logging::setRelativeTime ();
    logging::info (" Test regression nested_use_path_expansion 2 start");
    utils::registerTest ("test_resources/regressions/nested_use_path_expansion/test2.yr",
                         withImports-> copy ["test_resources/regressions/nested_use_path_expansion/imports"]);
    logging::success (" Test regression nested_use_path_expansion 2 finished");
}
