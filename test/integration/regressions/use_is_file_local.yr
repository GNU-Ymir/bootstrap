in use_is_file_local;

use ymirc::utils::_;
use utils;

// a3993 => fix: fix use of module is only local to a file
__test {
    for i in 1 ... 3 {
        logging::setRelativeTime ();
        logging::info (" Test regression use_is_file_local % start", i);
        utils::registerTest ("test_resources/regressions/use_is_file_local/test" ~ std::conv::to!{[c8]} (i) ~ "/foo.yr");
        logging::success (" Test regression use_is_file_local % finished", i);
    }
}
