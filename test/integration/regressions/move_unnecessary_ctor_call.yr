in move_unnecessary_ctor_call;

use ymirc::utils::_;
use utils;

// fix: moving the result of a constructor call crashed the expander instead of being rejected,
// since the ctor call never needs an explicit move (it is already a fresh, owned value)
__test {
    logging::setRelativeTime ();
    logging::info (" Test regression move_unnecessary_ctor_call 1 start");
    utils::registerTest ("test_resources/regressions/move_unnecessary_ctor_call/test1.yr");
    logging::success (" Test regression move_unnecessary_ctor_call 1 finished");
}
