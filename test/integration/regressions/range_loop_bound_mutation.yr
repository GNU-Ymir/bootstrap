in range_loop_bound_mutation;

// YMI-157 => fix: a range loop read its start and step at every iteration, so a body
// mutating a bound shifted the index. They are now bound before the loop.
@parameters(utils::range (1, 4))
__test range_read_once (i: i32) {
    utils::registerCase ("test_resources/regressions/range_loop_bound_mutation", i);
}
