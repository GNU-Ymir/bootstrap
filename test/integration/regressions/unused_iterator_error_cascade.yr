in unused_iterator_error_cascade;

use ymirc::utils::log;

// 7e3964c => fix: an unused variable of a nested scope no longer types the statement declaring it as error
__test unused_iterator_in_comprehension {
    logging::setRelativeTime ();
    logging::info (" Test regression unused_iterator_error_cascade 1 start");
    utils::registerTest ("test_resources/regressions/unused_iterator_error_cascade/test1.yr");
    logging::success (" Test regression unused_iterator_error_cascade 1 finished");
}

// 7e3964c => fix: an unused variable of a nested scope no longer types the statement declaring it as error
__test unused_variable_in_nested_block {
    logging::setRelativeTime ();
    logging::info (" Test regression unused_iterator_error_cascade 2 start");
    utils::registerTest ("test_resources/regressions/unused_iterator_error_cascade/test2.yr");
    logging::success (" Test regression unused_iterator_error_cascade 2 finished");
}
