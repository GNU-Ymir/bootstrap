in module_import_errors;

use ymirc::utils::_;
use utils;

// 7e73ed => fix: recursive imports, and child global modules imported outside a global module
__test {
    for i in 1 ... 2 {
        logging::setRelativeTime ();
        logging::info (" Test regression module_import_errors % start", i);
        utils::registerTest ("test_resources/regressions/module_import_errors/test" ~ std::conv::to!{[c8]} (i) ~ ".yr");
        logging::success (" Test regression module_import_errors % finished", i);
    }
}
