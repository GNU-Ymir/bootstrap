in method_delegate_call;

use ymirc::utils::_;
use utils;

// bcb4012 => feat: method call on method delegate value
__test {
    for i in 1 ... 2 {
        logging::setRelativeTime ();
        logging::info (" Test regression method_delegate_call % start", i);
        utils::registerTest ("test_resources/regressions/method_delegate_call/test" ~ std::conv::to!{[c8]} (i) ~ ".yr");
        logging::success (" Test regression method_delegate_call % finished", i);
    }
}
