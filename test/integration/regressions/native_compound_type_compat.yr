in native_compound_type_compat;

use ymirc::utils::_;
use utils;

use std::io;

//  fix: fix type compability of native compound types
__test {
    for i in 1 ... 2 {
        logging::setRelativeTime ();
        logging::info (" Test regression native_compound_type_compat % start", i);
        utils::registerTest ("test_resources/regressions/native_compound_type_compat/test" ~ std::conv::to!{[c8]} (i) ~ ".yr");
        logging::success (" Test regression native_compound_type_compat % finished", i);
    }
}
