in cast_operator_implicit_validation;

use ymirc::utils::_;
use utils;

use std::io;

//  fix: moved implicit casting validation to the cast operator validation
__test {
    for i in 1 ... 2 {
        logging::setRelativeTime ();
        logging::info (" Test regression cast_operator_implicit_validation % start", i);
        utils::registerTest ("test_resources/regressions/cast_operator_implicit_validation/test" ~ std::conv::to!{[c8]} (i) ~ ".yr");
        logging::success (" Test regression cast_operator_implicit_validation % finished", i);
    }
}
