in cte_int_auto_cast;

use std::io;
use ymirc::utils::_;
use utils;

// 540f03 => fix: automatic cast of cte int value to any int value
__test {
    for i in 1 ... 2 {
        logging::setRelativeTime ();
        logging::info (" Test regression cte_int_auto_cast % start", i);
        utils::registerTest ("test_resources/regressions/cte_int_auto_cast/test" ~ std::conv::to!{[c8]} (i) ~ ".yr");
        logging::success (" Test regression cte_int_auto_cast % finished", i);
    }
}
