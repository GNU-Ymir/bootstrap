in undefined_symbol_error_cascade;

use ymirc::utils::_;
use utils;

// e0110 => fix: keep validating after an undefined symbol, instead of cascading a bogus error
__test {
    logging::setRelativeTime ();
    logging::info (" Test regression undefined_symbol_error_cascade 1 start");
    utils::registerTest ("test_resources/regressions/undefined_symbol_error_cascade/test1.yr");
    logging::success (" Test regression undefined_symbol_error_cascade 1 finished");
}
