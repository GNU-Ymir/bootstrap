in mut_future_syntax;

use ymirc::utils::_;
use utils;

// 9651f0 => fix: syntax reading should allow (mut future-> i32)
__test {
    for i in 1 ... 4 {
        logging::setRelativeTime ();
        logging::info (" Test regression mut_future_syntax % start", i);
        utils::registerTest ("test_resources/regressions/mut_future_syntax/test" ~ std::conv::to!{[c8]} (i) ~ ".yr");
        logging::success (" Test regression mut_future_syntax % finished", i);
    }
}
