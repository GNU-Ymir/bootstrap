in auto_cast_value_mutation;

use ymirc::utils::_;
use utils;

// 8bdc49 => fix: auto casting can change value during compatibility verification
__test {
    for i in 1 ... 2 {
        logging::setRelativeTime ();
        logging::info (" Test regression auto_cast_value_mutation % start", i);
        utils::registerTest ("test_resources/regressions/auto_cast_value_mutation/test" ~ std::conv::to!{[c8]} (i) ~ ".yr");
        logging::success (" Test regression auto_cast_value_mutation % finished", i);
    }
}
