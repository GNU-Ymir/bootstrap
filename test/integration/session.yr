in session;

use ymirc::{errors, parser, session};
use ymirc::global::state;
use ymirc::syntax::visitor;
use ymirc::utils::format;

use std::fs::path;

/**
 * @returns: the semantic generators of the package `file` compiled in `session`, as text
 * */
fn compileIn (dmut session: &Session, file: [c8], overlay: [Path => [c8]] = copy [])-> [c8]
    throws ErrorMsg
{
    let dmut p = copy Parser::inSession(alias session, file, overlay-> overlay);
    p:.parseAll();

    let dmut stream = copy Formatter();
    for g in p.getSemGenerators() {
        stream:.write(g, "\n");
    }

    stream[]
}

__test sessions_keep_their_own_configuration {
    ymirc::global::state::resetToDefault();

    let dmut a = copy Session();
    a:.enter();
    state::addVersion("FEATURE");
    a:.exit();

    let dmut b = copy Session();

    // alternately on the same thread, each compilation sees the configuration of its session
    assert(string::contains(compileIn(alias a, "test_resources/session/test1.yr"), "return 1"));
    assert(string::contains(compileIn(alias b, "test_resources/session/test1.yr"), "return 2"));
    assert(string::contains(compileIn(alias a, "test_resources/session/test1.yr"), "return 1"));

    // and the configuration of the thread is left as it was
    assert(!state::isVersionActive("FEATURE"));

    // entered by the caller, the session stays installed after the compilation, to render its results
    a:.enter();
    assert(string::contains(compileIn(alias a, "test_resources/session/test1.yr"), "return 1"));
    assert(state::isVersionActive("FEATURE"));
    a:.exit();
    assert(!state::isVersionActive("FEATURE"));
}

__test a_session_reads_a_file_again_only_when_it_changed {
    ymirc::global::state::resetToDefault();

    let dmut s = copy Session();
    let first = compileIn(alias s, "test_resources/session/test1.yr");
    let read = s:.syntaxCache().hits();

    // the package and the libraries it imports are reused, giving the same result
    let second = compileIn(alias s, "test_resources/session/test1.yr");
    assert(s:.syntaxCache().hits() > read);
    assert(first == second);

    // an edited module is read again
    let dmut overlay: [Path => [c8]] = copy [];
    overlay[Path("test_resources/session/test1.yr")] = copy "in test1;\n\npub fn value ()-> i32 {\n    3\n}\n";
    assert(string::contains(compileIn(alias s, "test_resources/session/test1.yr", overlay-> overlay), "return 3"));
}

__test a_session_reads_a_file_again_when_its_versions_changed {
    ymirc::global::state::resetToDefault();

    let dmut s = copy Session();
    assert(string::contains(compileIn(alias s, "test_resources/session/test2.yr"), "return 2"));

    s:.enter();
    state::addVersion("FEATURE");
    s:.exit();

    assert(string::contains(compileIn(alias s, "test_resources/session/test2.yr"), "return 1"));
}

__test a_cancelled_compilation_stops {
    ymirc::global::state::resetToDefault();

    let dmut token = copy CancellationToken();
    token:.cancel();
    state::setCancellationToken(token);
    let msg = {
        let dmut p = copy Parser("test_resources/session/test1.yr");
        p:.parseAll();
        ""
    } catch {
        err: &ErrorMsg => format("%", err)
    };

    assert(string::contains(msg, errors::diagnostic::CANCELLED));
    state::resetToDefault();

    // a session gives each of its compilations a token of its own
    let dmut s = copy Session();
    s:.cancel();
    assert(string::contains(compileIn(alias s, "test_resources/session/test1.yr"), "return 2"));

    // the one of a compilation started but not running yet
    let dmut p = copy Parser::inSession(alias s, "test_resources/session/test1.yr");
    s:.cancel();
    let pending = {
        p:.parseAll();
        ""
    } catch {
        err: &ErrorMsg => format("%", err)
    };

    assert(string::contains(pending, errors::diagnostic::CANCELLED));
    assert(!state::isCancelled());
}
