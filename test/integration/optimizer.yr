in optimizer;

use ymirc::utils::_;
use ymirc::lint::node::{_, global::_};
use utils;

/**
 * The packages the pass pipeline is swept over at `-O1`. They are picked for
 * what they make the expander produce rather than for what they compute: class
 * hierarchies and destruction, closures, nested loops, scope guards, pattern
 * matching and template instantiation.
 * */
def SWEEP = ["test_resources/control_flow/test11.yr",
             "test_resources/control_flow/test19.yr",
             "test_resources/control_flow/test23.yr",
             "test_resources/entities/test1.yr",
             "test_resources/entities/test4.yr",
             "test_resources/entities/test7.yr",
             "test_resources/lit_class/test1.yr",
             "test_resources/lazyness/test2.yr",
             "test_resources/scope_guards/test1.yr",
             "test_resources/scope_guards/test2.yr",
             "test_resources/for_loops/arrays/test1.yr",
             "test_resources/pattern_match/test1.yr",
             "test_resources/templates/test1.yr"];

/**
 * One case per optimization pass, each a snippet small enough that its optimized
 * form can be read off the source.
 *
 * A case here carries a `.yil.opt` golden, so it is compiled at `-O1` and its
 * golden is the YIL the pass pipeline hands the backend. As long as no pass is
 * registered the goldens are the raw expander output, which is exactly the
 * "before" a pass is written against: landing a pass shows up as a diff on the
 * case it was written for, and as an unexpected diff anywhere else.
 * */
__test {
    utils::registerTests ("test_resources/optimizer", 1, 7);
}

/**
 * The pass pipeline over real packages.
 *
 * There is no golden here: what is asserted is that running the passes over
 * something bigger than a snippet raises nothing, the YIL verifier being active
 * in the test suite and checking every frame after every pass.
 *
 * A structural check is not a proof that the frames still mean what they meant:
 * that comparison is on observed behaviour, and observing it needs a backend,
 * which this frontend has no part of.
 * */
__test {
    for package in SWEEP {
        let res = utils::compilePackage(package, optLevel-> 1u32);
        if let Ok(err) = res.err {
            throw copy AssertError(format("% : -O1 : %", package, err));
        }

        assert (res.opt.len != 0us, format("% : -O1 : no node", package));
    }
}
