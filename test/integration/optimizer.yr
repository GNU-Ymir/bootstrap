in optimizer;

use ymirc::global::core_;
use ymirc::lexing::word;
use ymirc::lint::optimizer;
use ymirc::lint::optimizer::defuse;
use ymirc::lint::node::{_, global::_, instr::_, type::_, value::_};
use ymirc::utils::format;

use std::{fs::_, fs::path, io};

/**
 * The packages the pass pipeline is swept over at `-O1`. They are picked for
 * what they make the expander produce rather than for what they compute: class
 * hierarchies and destruction, closures, nested loops, scope guards, pattern
 * matching and template instantiation.
 * */
def SWEEP = ["test_resources/control_flow/test11.yr",
             "test_resources/control_flow/test19.yr",
             "test_resources/control_flow/test23.yr",
             "test_resources/entities/test1.yr",
             "test_resources/entities/test4.yr",
             "test_resources/entities/test7.yr",
             "test_resources/lit_class/test1.yr",
             "test_resources/lazyness/test2.yr",
             "test_resources/scope_guards/test1.yr",
             "test_resources/scope_guards/test2.yr",
             "test_resources/scope_guards/test5.yr",
             "test_resources/scope_guards/test8.yr",
             "test_resources/scope_guards/test9.yr",
             "test_resources/for_loops/arrays/test1.yr",
             "test_resources/pattern_match/test1.yr",
             "test_resources/templates/test1.yr"];

/**
 * The mangled segment naming a destructor: the length prefixed `__dtor` followed
 * by the marker of the frame kind. `__dtor` alone appears again inside the
 * mangling of a template argument.
 * */
def DTOR_SEGMENT = "6__dtorDT";

/**
 * One case per optimization pass, each a snippet small enough that its optimized
 * form can be read off the source.
 *
 * A case here carries a `.yil.opt` golden, so it is compiled at `-O1` and its
 * golden is the YIL the pass pipeline hands the backend. A case whose pass is
 * not written yet holds the raw expander output, which is exactly the "before"
 * that pass is written against: landing it shows up as a diff on the case it
 * was written for, and as an unexpected diff anywhere else.
 * */
@parameters(utils::range (1, 51))
__test one_snippet_per_pass (i: i32) {
    utils::registerCase ("test_resources/optimizer", i);
}

/**
 * The pass pipeline over real packages.
 *
 * There is no golden here: what is asserted is that running the passes over
 * something bigger than a snippet raises nothing(the YIL verifier is active in
 * the test suite, and checks every frame after every pass), and that they leave
 * fewer statements than the expander produced. The corpus is compiled twice, so
 * the two counts come from the same run and the report is the honest one.
 *
 * A count is not a proof that the frames still mean what they meant: that
 * comparison is on observed behaviour, and observing it needs a backend, which
 * this frontend has no part of.
 * */
__test pipeline_over_packages {
    let mut before = 0us, mut after = 0us;
    let mut padsBefore = 0us, mut padsAfter = 0us;

    for package in SWEEP {
        let res = utils::compilePackage(package, optLevel-> 1u32);
        if let Ok(err) = res.err {
            throw copy AssertError(format("% : -O1 : %", package, err));
        }

        assert (res.opt.len != 0us, format("% : -O1 : no node", package));

        let raw = countInstrs(res.exp), opt = countInstrs(res.opt);
        assert (opt <= raw, format("% : -O1 : % statements, up from %", package, opt, raw));

        let rawPads = countPads(res.exp), optPads = countPads(res.opt);
        assert (optPads <= rawPads, format("% : -O1 : % landing pads, up from %", package, optPads, rawPads));

        before += raw;
        after += opt;
        padsBefore += rawPads;
        padsAfter += optPads;
    }

    // the number the epic asks for: what the pipeline removes over a corpus
    // that is not the snippets it was written against
    println("optimizer : -O1 over ", SWEEP.len, " packages : ", after, " statements, down from ", before);
    assert (after < before, format("-O1 : % statements, nothing removed of %", after, before));

    // a collapsed try/finally is not a statement removed -- the region and the
    // part protecting it are both kept, one after the other -- so what the
    // elision pass does is invisible in the count above, and stating it takes a
    // count of its own. It is also what says the pass has not quietly become a
    // no-op: what it recognizes is the shape the expander produces, and a change
    // there would leave it correct and idle
    println("optimizer : -O1 over ", SWEEP.len, " packages : ", padsAfter, " landing pads, down from ", padsBefore);
    assert (padsAfter < padsBefore, format("-O1 : % landing pads, nothing removed of %", padsAfter, padsBefore));
}

/**
 * The directories whose cases handle slices, arrays and the values shared with a
 * future: every one of them that compiles is compiled at `-O1`.
 * */
def ALLOC_SWEEP = ["test_resources/lit_slices",
                   "test_resources/lit_arrays",
                   "test_resources/references",
                   "test_resources/concurrency"];

/**
 * The runtime functions allocating the block of a slice.
 * */
def ALLOC_CALLS = ["_yrt_dup_slice", "_yrt_alloc_slice", "_yrt_alloc_slice_no_set",
                   "_yrt_concat_slices", "_yrt_concat_slices_n"];

/**
 * The allocations the pipeline removes over the cases handling slices.
 *
 * Every case of the corpus is compiled at `-O1`, with the verifier checking every
 * frame after every pass, and no frame is allowed to allocate more than the
 * expander made it. A case whose golden is an error is not compiled at all.
 * */
__test allocations_over_slices {
    let mut before = 0us, mut after = 0us;

    for dir in ALLOC_SWEEP {
        for package in compilingCases(dir) {
            let res = utils::compilePackage(package, optLevel-> 1u32);
            if let Ok(err) = res.err {
                throw copy AssertError(format("% : -O1 : %", package, err));
            }

            let raw = countAllocs(res.exp), opt = countAllocs(res.opt);
            assert (opt <= raw, format("% : -O1 : % allocations, up from %", package, opt, raw));

            before += raw;
            after += opt;
        }
    }

    println("optimizer : -O1 over ", ALLOC_SWEEP.len, " directories : ", after, " allocations, down from ", before);
    assert (after < before, format("-O1 : % allocations, nothing removed of %", after, before));
}

/**
 * The directories whose cases index slices and arrays, a loop walking one above
 * all: every one of them that compiles is compiled at `-O1`.
 * */
def BOUNDS_SWEEP = ["test_resources/lit_slices",
                    "test_resources/lit_arrays",
                    "test_resources/for_loops/arrays",
                    "test_resources/for_loops/slices"];

/**
 * The bounds checks the pipeline removes over the cases indexing slices.
 *
 * A check is counted by the panic it guards. No frame is allowed to panic in more
 * places than the expander made it, and a check the pass proves always taken is
 * a warning, which outside debug mode fails the compilation of the case.
 * */
__test bounds_checks_over_slices {
    let mut before = 0us, mut after = 0us;

    for dir in BOUNDS_SWEEP {
        for package in compilingCases(dir) {
            let res = utils::compilePackage(package, optLevel-> 1u32);
            if let Ok(err) = res.err {
                throw copy AssertError(format("% : -O1 : %", package, err));
            }

            let raw = countPanics(res.exp), opt = countPanics(res.opt);
            assert (opt <= raw, format("% : -O1 : % panics, up from %", package, opt, raw));

            before += raw;
            after += opt;
        }
    }

    println("optimizer : -O1 over ", BOUNDS_SWEEP.len, " directories : ", after, " panics, down from ", before);
    assert (after < before, format("-O1 : % panics, nothing removed of %", after, before));
}

/**
 * The directories whose cases compute on integers and floats, and index slices by
 * a constant: every one of them that compiles is compiled at `-O1`.
 * */
def FOLD_SWEEP = ["test_resources/binary_int",
                  "test_resources/binary_float",
                  "test_resources/binary_ops",
                  "test_resources/lit_slices"];

/**
 * The operations the pipeline folds over the cases computing on numbers.
 *
 * An operation is a binary or a unary one, wherever it is written. No frame is
 * allowed to compute more of them than the expander made it.
 * */
__test operations_over_arithmetic {
    let mut before = 0us, mut after = 0us;

    for dir in FOLD_SWEEP {
        for package in compilingCases(dir) {
            let res = utils::compilePackage(package, optLevel-> 1u32);
            if let Ok(err) = res.err {
                throw copy AssertError(format("% : -O1 : %", package, err));
            }

            let raw = countPerFrame(res.exp, &isOperation), opt = countPerFrame(res.opt, &isOperation);
            for name, n in opt {
                let mut was = 0us;
                if let Ok(r) = raw[name] { was = r; }
                assert (n <= was, format("% : -O1 : % : % operations, up from %", package, name, n, was));
            }

            for _, n in raw { before += n; }
            for _, n in opt { after += n; }
        }
    }

    println("optimizer : -O1 over ", FOLD_SWEEP.len, " directories : ", after, " operations, down from ", before);
    assert (after < before, format("-O1 : % operations, nothing removed of %", after, before));
}

/**
 * @params:
 *    - nodes:   the nodes of a module
 *    - counted: tells the values to count
 * @returns: the number of values counted every frame of the module evaluates or writes
 * */
fn countPerFrame(nodes: [&YILNode], counted: fn (&YILValue)-> bool)-> [[c8] => usize] {
    let mut res: [[c8] => mut usize] = copy [];
    for n in nodes {
        if let f: &YILFrame = n {
            let mut nb = 0us;
            for v in defuse::allValues(f.body) {
                if (counted(v)) nb += 1us;
            }

            res[f.name] = nb;
        }
    }

    res
}

/**
 * @returns: true iif a value is a binary or a unary operation
 * */
fn isOperation(value: &YILValue)-> bool {
    value of YILBinaryValue || value of YILUnaryValue
}

/**
 * @params:
 *    - nodes: the nodes of a module
 * @returns: the number of calls to the runtime panic the frames of the module make
 * */
fn countPanics(nodes: [&YILNode])-> usize {
    let mut res = 0us;
    for n in nodes {
        if let f: &YILFrame = n { res += countPanic(f.body); }
    }

    res
}

/**
 * @returns: the number of calls to the runtime panic an instruction holds
 * */
fn countPanic(instr: &YILInstr)-> usize {
    let mut res = 0us;
    match instr {
        b: &YILBlock => { for i in b.instrs { res += countPanic(i); } }
        t: &YILTryCatch => {
            for i in t.tryPart { res += countPanic(i); }
            for i in t.catchPart { res += countPanic(i); }
        }
        t: &YILTryFinally => {
            for i in t.tryPart { res += countPanic(i); }
            for i in t.finPart { res += countPanic(i); }
        }
        c: &YILCall => {
            if let n: &YILNameCallValue = c.content {
                if (n.funcName == YRuntimeFuncs::PANIC) return 1us;
            }
        }
    }

    res
}

/**
 * @params:
 *    - dir: a directory of cases
 * @returns: the root file of every case of the directory whose golden is not an error
 * */
fn compilingCases(dir: [c8])-> [[c8]]
    throws AssertError
{
    let mut res: [[c8]] = [];
    for entry in fs::sys::readDir(Path(dir)) {
        if (entry.path.extension() != "yr") continue;
        if (fs::sys::isFile(entry.path.stripExtension().addExtension("err"))) continue;

        res ~= [entry.path.toStr()];
    }

    res
} catch {
    f: &FsError => throw copy AssertError(format("% : %", dir, f));
}

/**
 * @params:
 *    - nodes: the nodes of a module
 * @returns: the number of calls to a runtime function allocating a slice the
 * frames of the module make
 * */
fn countAllocs(nodes: [&YILNode])-> usize {
    let mut res = 0us;
    for n in nodes {
        if let f: &YILFrame = n { res += countAlloc(f.body); }
    }

    res
}

/**
 * @returns: the number of calls to a runtime function allocating a slice an
 * instruction holds
 * */
fn countAlloc(instr: &YILInstr)-> usize {
    let mut res = 0us;
    match instr {
        b: &YILBlock => { for i in b.instrs { res += countAlloc(i); } }
        t: &YILTryCatch => {
            for i in t.tryPart { res += countAlloc(i); }
            for i in t.catchPart { res += countAlloc(i); }
        }
        t: &YILTryFinally => {
            for i in t.tryPart { res += countAlloc(i); }
            for i in t.finPart { res += countAlloc(i); }
        }
        c: &YILCall => {
            if let n: &YILNameCallValue = c.content {
                for name in ALLOC_CALLS {
                    if (n.funcName == name) return 1us;
                }
            }
        }
    }

    res
}

/**
 * @params:
 *    - nodes: the nodes of a module
 * @returns: the number of try/finally the frames of the module hold
 * */
fn countPads(nodes: [&YILNode])-> usize {
    let mut res = 0us;
    for n in nodes {
        if let f: &YILFrame = n { res += countPad(f.body); }
    }

    res
}

/**
 * @returns: the number of try/finally an instruction holds, itself included
 * */
fn countPad(instr: &YILInstr)-> usize {
    let mut res = 0us;
    match instr {
        b: &YILBlock => { for i in b.instrs { res += countPad(i); } }
        t: &YILTryCatch => {
            for i in t.tryPart { res += countPad(i); }
            for i in t.catchPart { res += countPad(i); }
        }
        t: &YILTryFinally => {
            res += 1us;
            for i in t.tryPart { res += countPad(i); }
            for i in t.finPart { res += countPad(i); }
        }
    }

    res
}

/**
 * @params:
 *    - nodes: the nodes of a module
 * @returns: the number of instructions the frames of the module hold
 *
 * A declaration is not counted: it is not an instruction the backend emits
 * anything for, and a pass that only leaves a variable unused must not look like
 * a pass that removed a statement.
 * */
fn countInstrs(nodes: [&YILNode])-> usize {
    let mut res = 0us;
    for n in nodes {
        if let f: &YILFrame = n { res += countInstr(f.body); }
    }

    res
}

/**
 * @params:
 *    - instr: the instruction to count
 * @returns: the number of instructions it holds, itself included when it is not
 * a container
 * */
fn countInstr(instr: &YILInstr)-> usize {
    let mut res = 0us;
    match instr {
        b: &YILBlock => {
            for i in b.instrs { res += countInstr(i); }
            return res;
        }
        t: &YILTryCatch => {
            for i in t.tryPart { res += countInstr(i); }
            for i in t.catchPart { res += countInstr(i); }
            return res;
        }
        t: &YILTryFinally => {
            for i in t.tryPart { res += countInstr(i); }
            for i in t.finPart { res += countInstr(i); }
            return res;
        }
        _: &YILVarDecl => { return 0us; }
    }

    1us
}

/**
 * What the landing pads of a frame hold is still in the frame after the pipeline.
 *
 * A landing pad is entered by the personality routine and by nothing the frame
 * does, so a pass rooting its reachability at the entry alone sees the handler
 * of every region it believes cannot throw as dead code, and removes what it
 * holds. What is asserted here is the property that catches that: a frame that
 * made a call before the pipeline makes it after.
 *
 * Both sides are counted over the whole frame rather than handler by handler: a
 * handler is allowed to disappear, the elision pass moving the calls of one into
 * the region it protected without losing any.
 *
 * The frames looked at are the ones whose handlers call something, and the calls
 * are what is counted rather than the instructions. A handler is cleaned like
 * anything else -- the `exit` of `test9::foo2` is a store to a variable nothing
 * reads, and leaving it empty is right -- so a count of instructions has a
 * legitimate reason to drop, and asserting on it would state
 * nothing. A call is never a dead store and never a pure value, so a pass has
 * exactly one reason to remove one on the ground of reachability, and that is
 * the mistake this states.
 * */
__test handlers_survive_the_pipeline {
    for package in ["test_resources/scope_guards/test1.yr",
                    "test_resources/scope_guards/test2.yr",
                    "test_resources/scope_guards/test5.yr",
                    "test_resources/scope_guards/test8.yr",
                    "test_resources/scope_guards/test9.yr"] {
        let res = utils::compilePackage(package, optLevel-> 1u32);
        if let Ok(err) = res.err {
            throw copy AssertError(format("% : -O1 : %", package, err));
        }

        let handlers = countHandlers(res.exp);
        let raw = countCallsPerFrame(res.exp), opt = countCallsPerFrame(res.opt);
        assert (handlers.len != 0us, format("% : no frame with a handler to check", package));

        let mut checked = 0us;
        for name, before in raw {
            let mut nb = 0us;
            if let Ok(hs) = handlers[name] { for h in hs { nb += h; } }
            if (nb == 0us) continue;

            let mut after = 0us;
            if let Ok(a) = opt[name] { after = a; }

            assert (after >= before,
                    format("% : -O1 : % : % calls, down from the % it made, % of them in a handler",
                           package, name, after, before, nb));

            checked += nb;
        }

        assert (checked != 0us, format("% : no handler makes a call, nothing to check", package));
    }
}

/**
 * @params:
 *    - nodes: the nodes of a module
 * @returns: the number of calls the body of every frame of the module makes
 * */
fn countCallsPerFrame(nodes: [&YILNode])-> [[c8] => usize] {
    let mut res: [[c8] => mut usize] = copy [];
    for n in nodes {
        if let f: &YILFrame = n { res[f.name] = countCalls(f.body); }
    }

    res
}

/**
 * The pipeline runs the destructors of a frame as often as the expander
 * scheduled them.
 *
 * Dropping a destructor that was needed is a leak, and a leak is what no golden
 * file notices: the frames still compile, the verifier still passes, and the
 * memory is simply never given back. The corpus is the cases whose destructor
 * does something, and what is asserted, per frame, is the number of destructor
 * calls -- which the elision pass moves, out of a finally part and into the
 * region that part protected, and must never lower.
 *
 * A case whose destructor is empty is left out on purpose: removing the calls to
 * it is what the pass is for, and `test_resources/optimizer/test16.yr` is where
 * that is stated.
 * */
__test destructor_calls_survive_the_pipeline {
    for package in ["test_resources/for_loops/override/test8.yr",
                    "test_resources/for_loops/override/test11.yr",
                    "test_resources/for_loops/override/test12.yr",
                    "test_resources/for_loops/lst_compr_class/test8.yr",
                    "test_resources/regressions/entity_reassign_rhs_throws/test1.yr",
                    "test_resources/optimizer/test17.yr",
                    "test_resources/optimizer/test18.yr"] {
        let res = utils::compilePackage(package, optLevel-> 1u32);
        if let Ok(err) = res.err {
            throw copy AssertError(format("% : -O1 : %", package, err));
        }

        let raw = countDtorCalls(res.exp), opt = countDtorCalls(res.opt);
        assert (raw.len != 0us, format("% : no frame runs a destructor", package));

        for name, before in raw {
            let mut after = 0us;
            if let Ok(a) = opt[name] { after = a; }

            assert (after == before,
                    format("% : -O1 : % : % destructor calls, % were scheduled",
                           package, name, after, before));
        }
    }
}

/**
 * @params:
 *    - nodes: the nodes of a module
 * @returns: for every frame making one, the number of destructor calls it makes
 * */
fn countDtorCalls(nodes: [&YILNode])-> [[c8] => usize] {
    let mut res: [[c8] => mut usize] = copy [];
    for n in nodes {
        if let f: &YILFrame = n {
            let nb = countDtorCall(f.body);
            if (nb != 0us) { res[f.name] = nb; }
        }
    }

    res
}

/**
 * @returns: the number of destructor calls an instruction holds
 * */
fn countDtorCall(instr: &YILInstr)-> usize {
    let mut res = 0us;
    match instr {
        b: &YILBlock => { for i in b.instrs { res += countDtorCall(i); } }
        t: &YILTryCatch => {
            for i in t.tryPart { res += countDtorCall(i); }
            for i in t.catchPart { res += countDtorCall(i); }
        }
        t: &YILTryFinally => {
            for i in t.tryPart { res += countDtorCall(i); }
            for i in t.finPart { res += countDtorCall(i); }
        }
        c: &YILCall => { return isDtorCall(c.content); }
        a: &YILAffect => { return isDtorCall(a.right); }
    }

    res
}

/**
 * @returns: 1 iif the value is a call to a destructor, 0 otherwise
 * */
fn isDtorCall(value: &YILValue)-> usize {
    match value {
        n: &YILNameCallValue => {
            if (holds(n.funcName, DTOR_SEGMENT)) { return 1us; }
        }
    }

    0us
}

/**
 * @returns: true iif the name holds the needle
 * */
fn holds(name: [c8], needle: [c8])-> bool {
    if (needle.len > name.len) return false;

    for i in 0us .. ((name.len - needle.len) + 1us) {
        if (name[i .. i + needle.len] == needle) return true;
    }

    false
}

/**
 * The pass never turns a jump into a jump to nowhere.
 *
 * Removing a label nothing names, retargeting a jump onto the end of the chain
 * of jumps it starts and dropping the jump that falls into the label following
 * it are three transformations that all end with a label being deleted, and the
 * failure they share is deleting one something still names. The YIL verifier
 * catches it after every pass, this states it on the optimized output itself so
 * that the case reads as what it checks.
 * */
__test no_jump_to_a_deleted_label {
    for package in SWEEP {
        let res = utils::compilePackage(package, optLevel-> 1u32);
        if let Ok(err) = res.err {
            throw copy AssertError(format("% : -O1 : %", package, err));
        }

        for n in res.opt {
            if let f: &YILFrame = n {
                let mut defined: [usize => mut ()] = copy [];
                collectLabels(f.body, ref defined);

                let mut named: [usize => mut ()] = copy [];
                collectJumps(f.body, ref named);

                for id, _ in named {
                    assert (id in defined, format("% : % : the jump to #% names no label", package, f.name, id));
                }
            }
        }
    }
}

/**
 * @params:
 *    - nodes: the nodes of a module
 * @returns: for every frame of the module holding one, the number of calls each
 * of its handlers makes
 *
 * A pass rooting its reachability wrong does not remove the try itself, it
 * removes what the pad holds, so what is reported is one number per handler:
 * comparing the lists tells a handler that is gone from a handler that is still
 * there with its body taken away, which a sum over the module cannot -- one
 * handler that kept its calls would answer for all of them.
 *
 * The handlers of a frame are listed in the order the body holds them, the
 * enclosing one before the ones its parts hold, which is an order the pass does
 * not move: it removes instructions, it does not reorder the tree.
 * */
fn countHandlers(nodes: [&YILNode])-> [[c8] => [usize]] {
    let mut res: [[c8] => mut [usize]] = copy [];
    for n in nodes {
        if let f: &YILFrame = n {
            let mut inFrame: [usize] = [];
            collectHandlers(f.body, ref inFrame);
            if (inFrame.len != 0us) res[f.name] = inFrame;
        }
    }

    res
}

/**
 * Append the number of calls every handler an instruction holds makes.
 *
 * A handler is counted whole, the handlers nested in it included: those appear
 * again as entries of their own, so a nested one being emptied is caught by its
 * own entry as well and does not have to be told apart in the enclosing count.
 * */
fn collectHandlers(instr: &YILInstr, ref mut res: [usize]) {
    match instr {
        b: &YILBlock => {
            for i in b.instrs { collectHandlers(i, ref res); }
        }
        t: &YILTryCatch => {
            let mut nb = 0us;
            for i in t.catchPart { nb += countCalls(i); }
            res ~= [nb];

            for i in t.tryPart { collectHandlers(i, ref res); }
            for i in t.catchPart { collectHandlers(i, ref res); }
        }
        t: &YILTryFinally => {
            let mut nb = 0us;
            for i in t.finPart { nb += countCalls(i); }
            res ~= [nb];

            for i in t.tryPart { collectHandlers(i, ref res); }
            for i in t.finPart { collectHandlers(i, ref res); }
        }
    }
}

/**
 * @returns: the number of instructions an instruction holds that call something
 *
 * A call made for what it does(`YILCall`) and a call whose result is stored
 * (`__self_1 = _yrt_alloc_class(...)`) both count, and a call nested deeper in a
 * value is not looked for: what the number is for is naming the instructions the
 * pass has no licence to remove whatever the dataflow says, and one per calling
 * instruction says that.
 * */
fn countCalls(instr: &YILInstr)-> usize {
    let mut res = 0us;
    match instr {
        b: &YILBlock => { for i in b.instrs { res += countCalls(i); } }
        t: &YILTryCatch => {
            for i in t.tryPart { res += countCalls(i); }
            for i in t.catchPart { res += countCalls(i); }
        }
        t: &YILTryFinally => {
            for i in t.tryPart { res += countCalls(i); }
            for i in t.finPart { res += countCalls(i); }
        }
        _: &YILCall => { return 1us; }
        a: &YILAffect => {
            match a.right {
                _: &YILNameCallValue => { return 1us; }
                _: &YILPtrCallValue => { return 1us; }
            }
        }
    }

    res
}

/**
 * Collect the identifier of every label an instruction defines.
 * */
fn collectLabels(instr: &YILInstr, ref mut res: [usize => mut ()]) {
    match instr {
        b: &YILBlock => { for i in b.instrs { collectLabels(i, ref res); } }
        t: &YILTryCatch => {
            for i in t.tryPart { collectLabels(i, ref res); }
            for i in t.catchPart { collectLabels(i, ref res); }
        }
        t: &YILTryFinally => {
            for i in t.tryPart { collectLabels(i, ref res); }
            for i in t.finPart { collectLabels(i, ref res); }
        }
        l: &YILLabel => { res[l.id] = (); }
    }
}

/**
 * Collect the identifier of every label an instruction jumps to.
 * */
fn collectJumps(instr: &YILInstr, ref mut res: [usize => mut ()]) {
    match instr {
        b: &YILBlock => { for i in b.instrs { collectJumps(i, ref res); } }
        t: &YILTryCatch => {
            for i in t.tryPart { collectJumps(i, ref res); }
            for i in t.catchPart { collectJumps(i, ref res); }
        }
        t: &YILTryFinally => {
            for i in t.tryPart { collectJumps(i, ref res); }
            for i in t.finPart { collectJumps(i, ref res); }
        }
        g: &YILGoto => { res[g.label.id] = (); }
        c: &YILCondJmp => { res[c.then.id] = (); res[c.else_.id] = (); }
    }
}

/**
 * A copy carrying the result of a chain the fusion cannot move, made between the
 * two concatenations of another chain, is not taken for a part of that one.
 * */
__test a_carrier_of_another_chain_is_kept {
    let ptr = copy YILPointer(YIL_SINT_32, uid-> 8us);
    let slc = copy YILTuple(copy [YIL_UINT_64, ptr, YIL_PTR_VOID], uid-> 9us);

    let mut decls: [&YILInstr] = [];
    let mut vars: [&YILVar] = [];
    for i, n in ["a", "b", "c", "d", "e", "f", "tA", "tA2", "tB", "tB2", "r", "y"] {
        vars ~= copy [copy YILVar(EOF_WORD, n, slc, i + 1us)];
        decls ~= copy [copy YILVarDecl(EOF_WORD, n, slc, i + 1us)];
    }

    let (a, b, c, d, e, f) = (vars[0], vars[1], vars[2], vars[3], vars[4], vars[5]);
    let (tA, tA2, tB, tB2, r, y) = (vars[6], vars[7], vars[8], vars[9], vars[10], vars[11]);

    let carrier: &YILInstr = copy YILAffect(EOF_WORD, tA2, tA);
    let body = decls ~ copy [concatOf(tA, a, b),
                             concatOf(tB, c, d),
                             carrier,
                             concatOf(tB2, tB, e),
                             concatOf(r, tA2, f),
                             copy YILAffect(EOF_WORD, y, copy YILNameCallValue(EOF_WORD, slc, "_Y4test3barFS3i32ZS3i32", copy [tB2])),
                             copy YILReturn(EOF_WORD, r)];

    let frame = copy YILFrame(EOF_WORD, EOF_WORD, "_Y4test3fooFZS3i32", [], slc,
                              body-> copy YILBlock(EOF_WORD, body), refs-> copy []);

    let dmut types = copy TypeTable(types-> copy [ptr, slc]);
    let dmut pass = copy ConcatFusionPass();
    pass:.useTypes(alias types);

    let res = pass:.apply(frame);
    let mut kept = false;
    if let bl: &YILBlock = res.body {
        for i in bl.instrs { if (i is carrier) kept = true; }
    }

    assert (kept, format("the copy the unfused chain reads was removed :\n%", res));
}

/**
 * @returns: the call concatenating two slices into a third
 * */
fn concatOf(out: &YILValue, left: &YILValue, right: &YILValue)-> &YILInstr {
    copy YILCall(EOF_WORD, copy YILNameCallValue(EOF_WORD, YIL_VOID, YRuntimeFuncs::CONCAT_SLICE,
                                                 copy [copy YILAddrValue(EOF_WORD, YIL_PTR_VOID, out),
                                                       copy YILAddrValue(EOF_WORD, YIL_PTR_VOID, left),
                                                       copy YILAddrValue(EOF_WORD, YIL_PTR_VOID, right),
                                                       copy YILIntValue(EOF_WORD, YIL_UINT_64, 4us)]))
}
