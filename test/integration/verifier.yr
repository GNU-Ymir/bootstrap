in verifier;

use ymirc::errors;
use ymirc::utils::_;
use ymirc::lexing::word;
use ymirc::lint::node::{_, global::_, instr::_, type::_, value::_};
use ymirc::lint::optimizer;

use std::{io, fs::path};

use utils;

/**
 * The frames verified here are built by hand rather than compiled: the point is
 * to check that the verifier catches an intermediate language no pass has any
 * right to produce, and no source program makes the expander produce one.
 * */

/**
 * Build a frame around a body, with the parameters, the return type and the
 * dependencies the checks need.
 * */
fn frame(body: [&YILInstr], retType: &YILType = YIL_VOID, params: [&YILVarDecl] = [], refs: [[c8] => Path] = copy [])-> &YILFrame {
    copy YILFrame(EOF_WORD, EOF_WORD, "_YtestFZv",
                  params,
                  retType,
                  body-> copy YILBlock(EOF_WORD, body),
                  refs-> refs)
}

/**
 * Assert that the verifier rejects a frame, and that it says why.
 *
 * @params:
 *    - f:      the malformed frame
 *    - reason: a fragment of the message the verification must report
 * */
fn assertRejected(f: &YILFrame, reason: [c8])
    throws AssertError
{
    let dmut ver = copy Verifier(pass-> "test-pass");
    let mut rejected = false;
    {
        ver:.verify(f);
    } catch {
        err: &errors::ErrorMsg => {
            let msg = format("%", err);
            assert (string::contains(msg, reason), format("expected %(y) in :\n%", reason, msg));
            assert (string::contains(msg, "test-pass"), format("the pass is not named in :\n%", msg));
            rejected = true;
        }
    }

    assert (rejected, format("the verifier accepted :\n%", f));
}

/**
 * Assert that the verifier accepts a frame.
 * */
fn assertAccepted(f: &YILFrame)
    throws AssertError
{
    let dmut ver = copy Verifier();
    {
        ver:.verify(f);
    } catch {
        err: &errors::ErrorMsg => {
            throw copy AssertError(format("the verifier rejected :\n%\n%", f, err));
        }
    }
}

__test {
    // the shape a pass leaves behind when it deletes a declaration but keeps the
    // uses of the variable it declared
    let decl = copy YILVarDecl(EOF_WORD, "x", YIL_SINT_32, 12us);
    let use_ = copy YILAffect(EOF_WORD,
                              copy YILVar(EOF_WORD, "x", YIL_SINT_32, 12us),
                              copy YILIntValue(EOF_WORD, YIL_SINT_32, 1));

    assertAccepted(frame(copy [decl, use_]));
    assertRejected(frame(copy [use_]), "is used but never declared");
}

__test {
    // a variable declared twice under the same identifier, which two passes
    // duplicating a block produce
    let decl = copy YILVarDecl(EOF_WORD, "x", YIL_SINT_32, 12us);

    assertRejected(frame(copy [decl, decl]), "is declared twice");
}

__test {
    // a jump retargeted at a label the frame does not define
    let label = copy YILLabel(EOF_WORD, "end", 3us);
    let gone = copy YILLabel(EOF_WORD, "gone", 4us);

    assertAccepted(frame(copy [copy YILGoto(EOF_WORD, label), label]));
    assertRejected(frame(copy [copy YILGoto(EOF_WORD, gone), label]), "which the frame does not define");
}

__test {
    // two labels sharing an identifier, which makes the jumps to it ambiguous
    let label = copy YILLabel(EOF_WORD, "end", 3us);
    let twin = copy YILLabel(EOF_WORD, "other", 3us);

    assertRejected(frame(copy [label, twin]), "is defined twice");
}

__test {
    // a conditional jump is a jump too, both of its targets are checked
    let then_ = copy YILLabel(EOF_WORD, "then", 5us);
    let else_ = copy YILLabel(EOF_WORD, "else", 6us);
    let cond = copy YILIntValue(EOF_WORD, YIL_UINT_8, 1);

    assertAccepted(frame(copy [copy YILCondJmp(EOF_WORD, cond, then_, else_), then_, else_]));
    assertRejected(frame(copy [copy YILCondJmp(EOF_WORD, cond, then_, else_), then_]),
                   "which the frame does not define");
}

__test {
    // a float moved into an integer slot, the shape of a substitution that
    // dropped the cast around the value it substituted
    let decl = copy YILVarDecl(EOF_WORD, "x", YIL_SINT_32, 12us);
    let bad = copy YILAffect(EOF_WORD,
                             copy YILVar(EOF_WORD, "x", YIL_SINT_32, 12us),
                             copy YILFloatValue(EOF_WORD, YIL_FLOAT_64, copy BigFloat(1.0)));

    assertRejected(frame(copy [decl, bad]), "affecting a value of type");
}

__test {
    // an exception bound outside of the catching part, where no personality
    // routine ever selected one
    let bind: &YILInstr = copy YILCall(EOF_WORD, copy YILBeginCatch(EOF_WORD, "AssertError"));
    let handler: [&YILInstr] = copy [bind];

    assertAccepted(frame(copy [copy YILTryCatch(EOF_WORD, YIL_PTR_VOID, [], handler)]));
    assertRejected(frame(copy [bind]), "caught outside of the catching part");
}

__test {
    // a call to a symbol the frame does not declare depending on, which is how
    // the dependency files go stale
    let call = copy YILCall(EOF_WORD, copy YILNameCallValue(EOF_WORD, YIL_VOID, "_Y3foo4barFZv", []));
    let refs: [[c8] => Path] = copy ["_Y3foo4barFZv" => Path("foo")];

    assertAccepted(frame(copy [call], refs-> refs));
    assertRejected(frame(copy [call]), "which is not part of the symbols it declares depending on");
}

__test {
    // the runtime is called by name from every frame, and is a dependency of none
    let call = copy YILCall(EOF_WORD, copy YILNameCallValue(EOF_WORD, YIL_VOID, "_yrt_exc_throw", []));

    assertAccepted(frame(copy [call]));
}

__test {
    // a frame returning a value whose body falls out of its last instruction
    let ret = copy YILReturn(EOF_WORD, copy YILIntValue(EOF_WORD, YIL_SINT_32, 0));
    let decl = copy YILVarDecl(EOF_WORD, "x", YIL_SINT_32, 12us);

    assertAccepted(frame(copy [ret], retType-> YIL_SINT_32));
    assertRejected(frame(copy [decl], retType-> YIL_SINT_32), "reaches its end without a return");
}
