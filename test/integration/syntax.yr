in syntax;

/**
 * Syntax tree tests, each case carries a `.stx` golden: the syntax module as
 * re-printed by the `Formattable` impl of every syntax node it contains. The
 * point is the printing itself -- the rest of the suite only ever asserts on
 * what comes *after* the syntax tree(`.sem`, `.yil`), so nothing else exercises
 * those `format` overrides.
 * */
@parameters(utils::range (1, 22))
__test syntax_tree_printing (i: i32) {
    utils::registerCase ("test_resources/syntax", i);
}
