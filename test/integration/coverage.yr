in coverage;

use ymirc::utils::_;
use ymirc::lint::node::{_, global::_, value::_};

use std::{io, conv, algorithm::searching};

use utils;

/**
 * Read back the `__COV__` table of every instrumented frame of `res`, as
 * (mangledFrameName, [(line, column, kind)]) in table order.
 *
 * The table is what the runtime turns into a coverage report, so asserting on it is asserting
 * on what the report can possibly say: how many coverable units a function has, where they are,
 * and whether they describe a line or one outcome of a branch.
 * */
fn coverageTables(res: utils::CompileResult)-> [([c8], [(u32, u32, u32)])] {
    // YmirMangleCsts::COVERAGE_TABLE, which is private to the mangler
    let COVERAGE_TABLE = "__COV__";

    let mut result: [([c8], [(u32, u32, u32)])] = [];

    for node in res.exp {
        if let c: &YILConstant = node if searching::startsWith(c.name, COVERAGE_TABLE) {
            let mut locs: [(u32, u32, u32)] = [];
            if let arr: &YILArrayValue = c.value {
                for entry in arr.value {
                    if let tu: &YILTupleValue = entry {
                        if let l: &YILIntValue = tu.values[0us] {
                            if let c_: &YILIntValue = tu.values[1us] {
                                if let k: &YILIntValue = tu.values[2us] {
                                    locs ~= [(l.value.toT!u32(), c_.value.toT!u32(), k.value.toT!u32())];
                                }
                            }
                        }
                    }
                }
            }

            result ~= [(c.name, locs)];
        }
    }

    return result;
}

/**
 * @returns: true iff `hay` contains `needle`
 * */
fn contains(hay: [c8], needle: [c8])-> bool {
    if needle.len > hay.len { return false; }
    for i in 0us .. (hay.len - needle.len) + 1us {
        if hay[i .. i + needle.len] == needle { return true; }
    }

    return false;
}

/**
 * @returns: the table of the only instrumented frame whose mangled name contains `name`
 * */
fn tableOf(tables: [([c8], [(u32, u32, u32)])], name: [c8])-> [(u32, u32, u32)]
    throws AssertError
{
    for entry in tables {
        if contains(entry._0, name) { return entry._1; }
    }

    throw copy AssertError(format("no coverage table for '%'", name));
}

/**
 * Read back the file name of the `__COI__` frame info of every instrumented frame of `res`, as
 * (mangledFrameName, file).
 *
 * The file is the only thing that tells the runtime which source file a covered function
 * belongs to, so a frame whose file is empty has its lines attributed to no file at all in the
 * report(see `CoverageFormat::reportCoverage` in midgard's test-rt).
 * */
fn coverageFiles(res: utils::CompileResult)-> [([c8], [c8])] {
    // YmirMangleCsts::COVERAGE_INFO, which is private to the mangler
    let COVERAGE_INFO = "__COI__";

    let mut result: [([c8], [c8])] = [];

    for node in res.exp {
        if let c: &YILConstant = node if searching::startsWith(c.name, COVERAGE_INFO) {
            if let info: &YILTupleValue = c.value {
                result ~= [(c.name, sliceContent(info.values[0us]))];
            }
        }
    }

    return result;
}

/**
 * @returns: the content of `value`, a slice literal(see `LiteralExpander::finalizeStrUtf8`),
 *           or "" if it is the empty slice
 * */
fn sliceContent(value: &YILValue)-> [c8] {
    if let slc: &YILTupleValue = value {
        if let str: &YILStringValue = slc.values[1us] {
            // finalizeStrUtf8 null terminates the array backing the slice
            return copy [cast!c8(u) for u in str.value[0us .. str.value.len - 1us]];
        }
    }

    return "";
}

/**
 * @returns: the file of the only instrumented frame whose mangled name contains `name`
 * */
fn fileOf(files: [([c8], [c8])], name: [c8])-> [c8]
    throws AssertError
{
    for entry in files {
        if contains(entry._0, name) { return entry._1; }
    }

    throw copy AssertError(format("no coverage frame info for '%'", name));
}

__test {
    let res = utils::compilePackage("test_resources/coverage/test1.yr", withCoverage-> true);
    if let Ok(err) = res.err {
        throw copy AssertError(format("%", err));
    }

    let tables = coverageTables(res);

    // 0 = LINE, 1 = BRANCH_TRUE, 2 = BRANCH_FALSE (CoverageLocKinds)

    // The three bounds checks and the two short-circuit jumps of the condition are lowering
    // details: the line holding the condition is one line entry and one branch, not six.
    assert (tableOf(tables, "multiTerm") == [(8u32, 5u32, 0u32),     // if (...) {
                                             (9u32, 9u32, 0u32),     //     return true;
                                             (8u32, 5u32, 1u32),     // condition taken
                                             (8u32, 5u32, 2u32),     // condition not taken
                                             (12u32, 5u32, 0u32)]);  // return false;

    // An 'if' without an 'else' still has two outcomes, both anchored on the 'if' itself
    assert (tableOf(tables, "withoutElse") == [(19u32, 13u32, 0u32),
                                               (20u32, 5u32, 0u32),
                                               (21u32, 11u32, 0u32),
                                               (20u32, 5u32, 1u32),
                                               (20u32, 5u32, 2u32),
                                               (24u32, 5u32, 0u32)]);

    // A ternary and its enclosing statement share a line, and thus share a single line entry
    assert (tableOf(tables, "withElse") == [(31u32, 9u32, 0u32),
                                            (31u32, 13u32, 1u32),
                                            (31u32, 13u32, 2u32),
                                            (32u32, 5u32, 0u32),
                                            (33u32, 9u32, 0u32),
                                            (35u32, 9u32, 0u32),
                                            (32u32, 5u32, 1u32),
                                            (32u32, 5u32, 2u32)]);

    // Entering the body of a loop and falling out of it are the two outcomes of the loop
    assert (tableOf(tables, "loop_") == [(43u32, 13u32, 0u32),
                                         (44u32, 5u32, 0u32),
                                         (45u32, 13u32, 0u32),
                                         (44u32, 5u32, 1u32),
                                         (44u32, 5u32, 2u32),
                                         (48u32, 5u32, 0u32)]);

    // An 'assert' is a check, not a branch: instrumenting its panic path would leave a location
    // that no passing run can ever cover
    assert (tableOf(tables, "asserting") == [(57u32, 5u32, 0u32),
                                             (59u32, 5u32, 0u32)]);
}

__test {
    let res = utils::compilePackage("test_resources/coverage/test2.yr", withCoverage-> true);
    if let Ok(err) = res.err {
        throw copy AssertError(format("%", err));
    }

    let files = coverageFiles(res);
    let SRC = "test_resources/coverage/test2.yr";

    // Every instrumented frame knows the file it comes from, whatever its body ends on. A body
    // ending on a statement is located on the unit value the ';' closing it produces - EOF_WORD,
    // which has no file name - and used to be left with no file at all in its coverage info,
    // making the test runner attribute its lines to no file.
    assert (contains(fileOf(files, "endsOnAssign"), SRC));
    assert (contains(fileOf(files, "endsOnCall"), SRC));
    assert (contains(fileOf(files, "endsOnReturn"), SRC));
    assert (contains(fileOf(files, "endsOnValue"), SRC));
}

/**
 * @returns: true iff no instrumented frame of `tables` has a mangled name containing `name`
 * */
fn hasNoTable(tables: [([c8], [(u32, u32, u32)])], name: [c8])-> bool {
    for entry in tables {
        if contains(entry._0, name) { return false; }
    }

    return true;
}

__test {
    // In standalone mode the package compiles the core library itself
    let res = utils::compilePackage("test_resources/coverage_core/__lib__.yr",
                                    withCoverage-> true, withStandalone-> true);
    if let Ok(err) = res.err {
        throw copy AssertError(format("%", err));
    }

    let tables = coverageTables(res);

    // The rest of the package is instrumented as usual
    assert (tableOf(tables, "appFn").len != 0us);

    // Core is not: the coverage hooks are themselves written in Ymir, and their bookkeeping calls
    // back into core on every hit, so an instrumented core recurses until the stack is exhausted.
    assert (hasNoTable(tables, "coreFn"));

    // A template declared by core is core too, wherever it happens to be instantiated
    assert (hasNoTable(tables, "coreTemplate"));
}

__test {
    // The same package, compiled against an installed core: 'core' is then a module of the user's
    // package like any other, and there is no reason not to cover it
    let res = utils::compilePackage("test_resources/coverage_core/__lib__.yr", withCoverage-> true);
    if let Ok(err) = res.err {
        throw copy AssertError(format("%", err));
    }

    let tables = coverageTables(res);

    assert (tableOf(tables, "appFn").len != 0us);
    assert (tableOf(tables, "coreFn").len != 0us);
    assert (tableOf(tables, "coreTemplate").len != 0us);
}
