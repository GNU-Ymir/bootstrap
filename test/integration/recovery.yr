in recovery;

/**
 * Every syntax error of a file is reported at once, the reading carrying on
 * at the next declaration or instruction.
 * */
@parameters(utils::range (1, 8))
__test syntax_recovery (i: i32) {
    utils::registerCase ("test_resources/syntax_recovery", i);
}

/**
 * With error recovery, a module with syntax errors is validated from what was
 * read of it.
 * */
@parameters(utils::range (1, 5))
__test error_recovery (i: i32) {
    utils::registerCase ("test_resources/error_recovery", i, withRecovery-> true);
}
