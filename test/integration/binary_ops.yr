in binary_ops;

// Tests for the binary operator families that binary_int/binary_float do not
// reach: bitwise, logical, containment, concatenation, range, type and class
// comparison, and their class-overload and error paths.
@parameters(utils::range (1, 34))
__test operator_families (i: i32) {
    utils::registerCase ("test_resources/binary_ops", i);
}
