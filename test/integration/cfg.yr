in cfg;

use ymirc::utils::_;
use ymirc::lint::node::{_, global::_};
use ymirc::lint::optimizer;

use std::{io, fs::_};

use utils;

/**
 * The packages the graph is built over to check that no frame breaks the
 * construction. They are picked for their control flow: nested loops, class
 * destruction(which wraps frame bodies in a try/finally), atomic blocks, scope
 * guards and pattern matching.
 * */
def SWEEP = ["test_resources/control_flow/test11.yr",
             "test_resources/control_flow/test13.yr",
             "test_resources/control_flow/test19.yr",
             "test_resources/control_flow/test23.yr",
             "test_resources/control_flow/test24.yr",
             "test_resources/entities/test1.yr",
             "test_resources/entities/test4.yr",
             "test_resources/entities/test7.yr",
             "test_resources/scope_guards/test1.yr",
             "test_resources/scope_guards/test2.yr",
             "test_resources/for_loops/arrays/test1.yr",
             "test_resources/pattern_match/test1.yr"];

/**
 * Build the control flow graph of every frame of a compiled package.
 *
 * @params:
 *    - res: the result of the compilation of the package
 *    - withWeak: true iif the graph of the weak frames is built as well
 * @returns: the graphs, in the order the frames were produced by the expander
 * */
fn buildGraphs(res: utils::CompileResult, withWeak: bool = true)-> [&CFG]
    throws AssertError
{
    if let Ok(err) = res.err {
        throw copy AssertError(format("%", err));
    }

    let mut graphs: [&CFG] = [];
    for node in res.exp {
        if let f: &YILFrame = node {
            if (withWeak || !f.isWeak) {
                graphs ~= [copy CFG(f)];
            }
        }
    }

    graphs
}

/**
 * Assert that a graph is well formed.
 *
 * A block is either reachable from the entry, and then something jumps to it, or
 * it is unreachable and reported as such: there is no third case, and in
 * particular no block that the construction left dangling in the graph.
 * */
fn checkGraph(g: &CFG)
    throws AssertError
{
    let blocks = g.getBlocks();
    let rpo = g.reversePostOrder();
    let unreach = g.unreachableBlocks();

    assert (rpo.len + unreach.len == blocks.len,
            format("% : % blocks, % reachable, % unreachable", g.getName(), blocks.len, rpo.len, unreach.len));

    assert (rpo.len != 0us && rpo[0us].getUid() == g.getEntry().getUid(),
            format("% : the entry is not the first block of the reverse post order", g.getName()));

    for b in rpo {
        if (b.getUid() == g.getEntry().getUid()) continue;
        assert (b.getPrevious().len != 0us,
                format("% : the reachable block BB% has no predecessor", g.getName(), b.getUid()));
    }

    for b in unreach {
        assert (b.getUid() != g.getEntry().getUid(),
                format("% : the entry block is unreachable", g.getName()));
    }
}

/**
 * Compare the graphs of a package with a golden `.dot` file.
 *
 * Weak frames are left out: they are the runtime helpers instantiated by the
 * compiler, and their graph says nothing about the package.
 * */
fn compareDot(package: [c8])
    throws AssertError
{
    let expected = {
        let dmut f = File::open(Path(package).stripExtension().addExtension("dot"));
        f:.readAll()
    } catch {
        err: &FsError => throw copy AssertError(format("%", err));
    };

    let graphs = buildGraphs(utils::compilePackage(package), withWeak-> false);
    let dmut stream = copy Formatter();
    for g in graphs {
        checkGraph(g);
        stream:.write(g.toDot());
    }

    utils::compareResultWithString(stream, expected, origin-> Path(package).stripExtension().addExtension("dot").toStr());
}

__test {
    // an if/else, the two branches of the condition and the return of one of them
    compareDot("test_resources/cfg/test1.yr");
}

__test {
    // a loop, the back edge closing on the block of the condition
    compareDot("test_resources/cfg/test2.yr");
}

__test {
    // a try/catch, the exception edges entering the handler
    compareDot("test_resources/cfg/test3.yr");
}

__test {
    // a scope guard, the finally part entered from the normal and the abnormal
    // exits of the region it protects
    compareDot("test_resources/cfg/test4.yr");
}

__test {
    // a scope guard over a region that can throw, in a frame returning a value:
    // the unwind copy of the finally part leaves the frame without a return, the
    // unwinding it resumes being what leaves it
    compareDot("test_resources/cfg/test5.yr");
}

__test {
    // a bounds check, the panic helper closing the path it ends: a call the
    // `runtimeNeverReturns` table describes gives control back to nothing
    compareDot("test_resources/cfg/test6.yr");
}

__test {
    // a throw leaving the frame, and one protected by nothing: the block ends
    // there, what follows it is only reached by the jump around it
    compareDot("test_resources/cfg/test7.yr");
}

__test {
    // every frame of a package with a rich control flow builds a well formed graph
    for package in SWEEP {
        let graphs = buildGraphs(utils::compilePackage(package));
        assert (graphs.len != 0us, format("% : no frame", package));

        for g in graphs {
            checkGraph(g);
            assert (g.toDot().len != 0us, format("% : % : empty dot", package, g.getName()));
        }
    }
}
