in default_ctor;

/**
 * Constructors generated from the fields of a class, a record or an entity, on
 * the request of a `self;` declaration. The `@data` record asks for the same
 * ctor by its attribute instead, and is covered by `integration::data_record`.
 * */
@parameters(copy [i for i in 1 ... 12])
__test generated_constructors (i: i32) {
    utils::registerCase ("test_resources/default_ctor", i);
}
