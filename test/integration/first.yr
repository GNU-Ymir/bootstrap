in first;

use ymirc::utils::colors;
use ymirc::utils::format;
use ymirc::utils::log;
use std::io;

use utils;

__test colors {
    println (Colors::PURPLE, "PURPLE", Colors::RESET);
    println (Colors::BLUE, "BLUE", Colors::RESET);
    println (Colors::YELLOW, "YELLOW", Colors::RESET);
    println (Colors::RED, "RED", Colors::RESET);
    println (Colors::GREEN, "GREEN", Colors::RESET);
    println (Colors::BOLD, "BOLD", Colors::RESET);
    println (Colors::UNDERLINE, "UNDERLINE", Colors::RESET);
    println (Colors::UNDERLINE, Colors::YELLOW, "YELLOW_UNDERLINE", Colors::RESET);
}

__test format_markup_keeps_balanced_parentheses {
    // the colored substring ends on the parenthesis closing the directive, not on
    // the first one it contains
    assert (utils::removeColors (format ("write @(y=move () (...)) to move it")) == "write move () (...) to move it");
    assert (utils::removeColors (format ("a @(y=b (c) d) e")) == "a b (c) d e");
    assert (utils::removeColors (format ("plain @(y=text) here")) == "plain text here");
}

__test logging {
    logging::info ("Test de log info ", 1, " ", 2, " ", 3);
    logging::success ("Test de log success ", 1, " ", 2, " ", 3);
    logging::warn ("Test de log warn ", 1, " ", 2, " ", 3);
    logging::failure ("Test de log error ", 1, " ", 2, " ", 3);
}
