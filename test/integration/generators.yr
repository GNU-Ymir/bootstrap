in generators;

@parameters(utils::range (1, 113))
__test cases (i: i32) {
    utils::registerCase ("test_resources/generators", i);
}

__test generator_of_a_module_compiled_apart {
    utils::registerTest ("test_resources/generators/test104.yr",
                         results-> "test_resources/generators/test104/user",
                         withModuleFilters-> copy ["test104/user.yr"]);
}
