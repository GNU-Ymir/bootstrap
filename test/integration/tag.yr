in tag;

use ymirc::{errors, parser};
use ymirc::semantic::symbol;
use ymirc::syntax::declaration::{block, custom, function, module};
use ymirc::utils::format;

@parameters(utils::range (1, 94))
__test tags (i: i32) {
    utils::registerCase ("test_resources/tag", i);
}

/**
 * @returns: the module `name` declared by the compilation of `file`
 */
fn compile (file: [c8], name: [c8])-> &Symbol
    throws ErrorMsg
{
    ymirc::global::state::resetToDefault();
    let dmut p = copy Parser(file-> file);
    p:.parseAll();

    p.getModuleSymbol().getLocalSymbols(name, protection-> Protection::PRIVATE)[][0]
}

/**
 * @returns: the tags of `sym`, each written as its path and the number of its arguments
 */
fn sites (sym: &Symbol)-> [[c8]] {
    copy [format("% %", t.tag, t.args.len) for t in sym.tags]
}

/**
 * @returns: the tags of the symbol `name` declared in `scope`, cf. `sites`
 */
fn sites (scope: &Symbol, name: [c8])-> [[c8]] {
    sites(scope.getLocalSymbols(name, protection-> Protection::PRIVATE)[][0])
}

__test the_tags_are_kept_on_the_tagged_symbols_in_the_order_they_are_written {
    let m = compile("test_resources/tag/test2.yr", "test2");

    assert(sites(m, "foo") == ["a 0"]);
    assert(sites(m, "Bar") == ["a 0", "b 1", "web::route 1"]);
    assert(sites(m, "Baz") == ["a 0"]);
    assert(sites(m, "Color") == ["a 0"]);
    assert(sites(m, "Value") == ["a 0"]);
    assert(sites(m, "Qux") == []);

    let local = m.getLocalSymbols("local", protection-> Protection::PRIVATE)[][0];
    assert(sites(local, "inModule") == ["a 0"]);
}

__test a_specialization_keeps_the_tags_of_its_template {
    let m = compile("test_resources/tag/test2.yr", "test2");
    assert(sites(m, "generic") == ["web::route 1"]);

    let mut found = 0us;
    for s in m.templates if s.loc.str == "generic" {
        assert(sites(s) == ["web::route 1"]);
        found += 1us;
    }

    assert(found == 1us, "generic is specialized once");
}

/**
 * @returns: the tags of `sym`, resolved, as their name, the parameters they bind,
 * and the `apply` and `self` overloads they select, cf. `overload`
 */
fn resolutions (sym: &Symbol)-> [[c8]] {
    copy [format("% % % %", r.site.tag, r.params.mappingSorted, overload(r.apply), overload(r.ctor)) for r in sym.resolvedTags]
}

/**
 * @returns: the kind of the declaration of the overload `o`, prefixed by
 * `template` and followed by its template parameters for a template, none if
 * there is no overload
 */
fn overload (o: (TagOverload)?)-> [c8] {
    if let Ok(x) = o {
        let (prefix, decl) = if let t: &TemplateDecl = x.decl { ("template ", t.decl) } else { ("", x.decl) };
        let kind = match decl {
            CtorDecl()     => { "self" }
            FunctionDecl() => { "fn" }
            c: &TypeDecl   => { format("%", c.kind) }
            EnumDecl()     => { "enum" }
            _              => { "union" }
        };

        if let t: &TemplateDecl = x.decl {
            return format("%% %", prefix, kind, t.params);
        }

        return prefix ~ kind;
    }

    "none"
}

/**
 * @returns: the tags of the symbol `name` declared in `scope`, resolved, cf. `resolutions`
 */
fn resolutions (scope: &Symbol, name: [c8])-> [[c8]] {
    resolutions(scope.getLocalSymbols(name, protection-> Protection::PRIVATE)[][0])
}

__test a_tag_site_selects_the_overloads_receiving_the_tagged_symbol {
    let m = compile("test_resources/tag/test17.yr", "test17");

    assert(resolutions(m, "foo") == ["truc {\"/foo\"s8, 1} template fn {F: fn (_: T)-> i32, T...} self"]);
    assert(resolutions(m, "zero") == ["truc {\"/zero\"s8, 1} template fn {F: fn ()-> i32} template self {F: fn ()-> i32}"]);
    assert(resolutions(m, "Bar") == ["truc {\"/bar\"s8, 8} template class {class C} self"]);
    assert(resolutions(m, "Baz") == ["truc {\"/baz\"s8, 1} template record {record R} self"]);
    assert(resolutions(m, "Color") == ["truc {\"/color\"s8, 1} template enum {enum E} self"]);
    assert(resolutions(m, "Value") == ["truc {\"/value\"s8, 1} template union {union U} self", "registered {5} none none"]);
}

__test a_template_resolves_its_tag_sites_for_each_specialization {
    let m = compile("test_resources/tag/test18.yr", "test18");
    assert(resolutions(m, "identity") == []);

    let mut found: [[c8]] = [];
    for s in m.templates if s.loc.str == "identity" {
        found ~= resolutions(s);
    }

    assert(found.len == 2us, "identity is specialized twice");
    assert("sized {4us} template fn {F: fn (_: T)-> T, T} none" in found);
    assert("sized {1us} template fn {F: fn (_: T)-> T, T} none" in found);
}
