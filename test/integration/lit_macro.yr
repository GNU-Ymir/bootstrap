in lit_macro;


@parameters(copy [i for i in 1 ... 30])
__test macros (i: i32) {
    utils::registerCase ("test_resources/lit_macro", i);
}

// the cases importing a macro from another package
@parameters(copy [i for i in 31 ... 32])
__test imported_macros (i: i32) {
    utils::registerCase ("test_resources/lit_macro", i,
                         withImports-> copy ["test_resources/lit_macro/imports"]);
}
