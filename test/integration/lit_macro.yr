in lit_macro;


use ymirc::utils::_;
use utils;

__test {
    utils::registerTests ("test_resources/lit_macro", 1, 30);

    // the last cases import a macro from another package
    utils::registerTest ("test_resources/lit_macro/test31.yr",
                         withImports-> copy ["test_resources/lit_macro/imports"]);

    utils::registerTest ("test_resources/lit_macro/test32.yr",
                         withImports-> copy ["test_resources/lit_macro/imports"]);
}
