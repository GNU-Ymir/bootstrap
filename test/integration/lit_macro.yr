in lit_macro;


@parameters(utils::range (1, 30))
__test macros (i: i32) {
    utils::registerCase ("test_resources/lit_macro", i);
}

// the cases importing a macro from another package
@parameters(utils::range (31, 32))
__test imported_macros (i: i32) {
    utils::registerCase ("test_resources/lit_macro", i,
                         withImports-> copy ["test_resources/lit_macro/imports"]);
}

// the cases restricting a rule to a keyword, or to a list of values
@parameters(utils::range (33, 43))
__test filtered_rules (i: i32) {
    utils::registerCase ("test_resources/lit_macro", i);
}
