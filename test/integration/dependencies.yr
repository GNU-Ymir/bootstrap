in dependencies;

use ymirc::{errors, global::_, parser, utils::_};

use std::{fs::_, io};

/**
 * Compile a package with dependency dumping active.
 * @params:
 *    - package: the root file of the package to compile
 *    - dumpDir: the directory the '.deps' files are written to
 * */
fn compileWithDeps (package: [c8], dumpDir: Path) {
    ymirc::global::state::resetToDefault();
    ymirc::global::state::activateDependencyDumping(dumpDir);

    let dmut p = copy Parser(file-> package);
    {
        p:.parseAll();
    } catch {
        err: &ErrorMsg => println(format("%", err));
    }
}

/**
 * @returns: the content of the '.deps' file of a module, "" if there is none
 * */
fn readDeps (dumpDir: Path, module: [c8])-> [c8] {
    let dmut f = File::open(dumpDir.push(module).addExtension("deps"));
    f:.readAll()
} catch {
    _ => ""
}

__test a_read_compile_time_constant_is_a_dependency {
    let dumpDir = Path("/tmp/ymir_deps_dependencies");
    compileWithDeps("test_resources/dependencies/test1.yr", dumpDir);

    // 'reader' reads an enum member and a def constant of 'codes', both folded into
    // literals, so the dependency is only visible in the reads
    let reader = readDeps(dumpDir, "test1_reader");
    assert(string::contains(reader, "test_resources/dependencies/test1/codes.yr"));

    // an unused import is not a dependency
    let silent = readDeps(dumpDir, "test1_silent");
    assert(!string::contains(silent, "test_resources/dependencies/test1/codes.yr"));
}
