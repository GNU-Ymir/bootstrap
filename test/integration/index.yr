in index;

use ymirc::{errors, parser};
use ymirc::semantic::index;
use ymirc::semantic::generator::value::_;

use std::{conv, env};

@parameters(utils::range (1, 8))
__test semantic_index (i: i32) {
    utils::registerCase ("test_resources/index", i);
}

/**
 * @returns: the index of the package `file`, and the absolute path its tokens name the file by
 * */
fn indexOf (file: [c8])-> (&SemanticIndex, [c8]) {
    ymirc::global::state::resetToDefault();
    let dmut p = copy Parser(file-> file, index-> true);
    {
        p:.parseAll();
    } catch {
        _: &ErrorMsg => {}
    }

    (p.getIndex(), env::currentDir().push(file).toStr())
}

__test a_position_is_resolved_by_the_token_covering_it {
    let (index, file) = indexOf("test_resources/index/test1.yr");

    // `sum` of the line `    sum`, from its first to its last character
    for col in 5u64 ... 7u64 {
        if let Ok(o) = index.at(file, 9u64, col) {
            assert(o.kind == OccurrenceKind::REFERENCE);
            assert(o.loc.str == "sum");
        } else {
            assert(false, "no occurrence at 9:" ~ conv::to!{[c8]}(col));
        }
    }

    // the indentation before it and the line after it name nothing
    if let Ok(_) = index.at(file, 9u64, 4u64) { assert(false, "an occurrence at 9:4"); }
    if let Ok(_) = index.at(file, 9u64, 8u64) { assert(false, "an occurrence at 9:8"); }
}

__test the_declaration_and_references_of_an_entity {
    let (index, file) = indexOf("test_resources/index/test1.yr");

    // `x` in `add (x, x)` is declared by `let x`
    if let Ok(ref_) = index.at(file, 14u64, 18u64) {
        if let Ok(decl) = index.declarationOf(ref_) {
            assert(decl.loc.line == 13u64 && decl.loc.col == 9u64);
        } else {
            assert(false, "no declaration of x");
        }

        assert(index.referencesOf(ref_).len == 3us);
    } else {
        assert(false, "no occurrence of x");
    }

    // `add` is declared once and called twice
    if let Ok(call) = index.at(file, 13u64, 13u64) {
        assert(call.loc.str == "add" && call.decl of UnitValue);
        assert(index.referencesOf(call).len == 3us);
    } else {
        assert(false, "no occurrence of add");
    }
}

/**
 * @returns: the line declaring the entity named at `line`:`col` of `file`, and the
 * number of tokens naming it, (0, 0) if none is named there
 * */
fn resolve (index: &SemanticIndex, file: [c8], line: u64, col: u64)-> (u64, usize) {
    if let Ok(o) = index.at(file, line, col) {
        if let Ok(decl) = index.declarationOf(o) {
            return (decl.loc.line, index.referencesOf(o).len);
        }
    }

    (0u64, 0us)
}

__test an_entity_is_resolved_through_overloads_recursion_and_closures {
    let (overloads, file5) = indexOf("test_resources/index/test5.yr");

    // each call names the overload it selects
    assert(resolve(overloads, file5, 17u64, 13u64) == (11u64, 2us));
    assert(resolve(overloads, file5, 18u64, 13u64) == (12u64, 2us));

    let (index, file6) = indexOf("test_resources/index/test6.yr");

    // `n` is declared once, though `fact` is called before its body is validated
    assert(resolve(index, file6, 19u64, 38u64) == (18u64, 4us));

    // `base` is named in the closure enclosing it
    assert(resolve(index, file6, 14u64, 32u64) == (13u64, 2us));
}
