in dataflow;

use ymirc::utils::_;
use ymirc::lint::node::{_, global::_, instr::_, value::_};
use ymirc::lint::optimizer;
use ymirc::lint::optimizer::dataflow;

use std::{io, fs::_};

use utils;

/**
 * The packages the dataflow is solved over to check that no frame breaks the
 * analyses. They are the ones of the control flow graph, plus the scope guards
 * and the try/catch cases: an exception edge that liveness gets wrong is what
 * makes a dead store elimination miscompile every catching frame of the
 * codebase, so they are part of this test rather than of the one of the pass
 * consuming it.
 * */
def SWEEP = ["test_resources/control_flow/test11.yr",
             "test_resources/control_flow/test13.yr",
             "test_resources/control_flow/test19.yr",
             "test_resources/control_flow/test23.yr",
             "test_resources/control_flow/test24.yr",
             "test_resources/control_flow/test4.yr",
             "test_resources/entities/test1.yr",
             "test_resources/entities/test4.yr",
             "test_resources/entities/test7.yr",
             "test_resources/scope_guards/test1.yr",
             "test_resources/scope_guards/test2.yr",
             "test_resources/scope_guards/test5.yr",
             "test_resources/scope_guards/test8.yr",
             "test_resources/for_loops/arrays/test1.yr",
             "test_resources/pattern_match/test1.yr"];

/**
 * Solve the dataflow of every frame of a compiled package.
 *
 * @params:
 *    - res: the result of the compilation of the package
 *    - withWeak: true iif the weak frames are analysed as well
 * @returns: the dataflows, in the order the frames were produced by the expander
 * */
fn buildDataflows(res: utils::CompileResult, withWeak: bool = true)-> [&FrameDataflow]
    throws AssertError
{
    if let Ok(err) = res.err {
        throw copy AssertError(format("%", err));
    }

    let mut dfs: [&FrameDataflow] = [];
    for node in res.exp {
        if let f: &YILFrame = node {
            if (withWeak || !f.isWeak) {
                dfs ~= [copy FrameDataflow(f)];
            }
        }
    }

    dfs
}

/**
 * @params:
 *    - package: the root file of the compilation
 *    - name:    a fragment of the mangled name of the frame to analyse
 * @returns: the dataflow of that frame
 * */
fn dataflowOf(package: [c8], name: [c8])-> &FrameDataflow
    throws AssertError
{
    for df in buildDataflows(utils::compilePackage(package), withWeak-> false) {
        if (string::contains(df.getName(), name)) return df;
    }

    throw copy AssertError(format("% : no frame named %", package, name));
}

/**
 * Assert that a solution is a solution: every block satisfies the transfer
 * function of the analysis, and nothing entering a block is missing from what
 * leaves the blocks flowing into it.
 *
 * That is what a fixpoint is, and checking it is what makes a sweep over a
 * package worth more than checking that nothing crashed.
 * */
fn checkFixpoint(df: &FrameDataflow, sol: &Solution)
    throws AssertError
{
    let a = sol.getAnalysis();
    for b in sol.getBlocks() {
        let uid = b.getUid();
        let after = dataflow::setUnion(a.genOf(uid), dataflow::setDiff(sol.outOf(b), a.killOf(uid)));
        let before = dataflow::setUnion(a.genOf(uid), dataflow::setDiff(sol.inOf(b), a.killOf(uid)));

        if (a.direction == Direction::BACKWARD) {
            assert (sol.inOf(b) == after,
                    format("% : % : BB% : the transfer function is not applied", df.getName(), a.name, uid));

            for n in b.getNext() {
                let out = sol.outOf(b);
                assert (dataflow::setUnion(out, sol.inOf(n.0)) == out,
                        format("% : % : BB% does not carry everything BB% needs", df.getName(), a.name, uid, (n.0).getUid()));
            }
        } else {
            assert (sol.outOf(b) == before,
                    format("% : % : BB% : the transfer function is not applied", df.getName(), a.name, uid));
        }
    }
}

/**
 * Assert that the three analyses of a frame reached their fixpoint.
 * */
fn checkFixpoints(df: &FrameDataflow)
    throws AssertError
{
    checkFixpoint(df, df.getLiveness());
    checkFixpoint(df, df.getReachingDefs());
    checkFixpoint(df, df.getAvailableExprs());
}

/**
 * Compare the dataflow of a package with a golden `.df` file.
 * */
fn compareDump(package: [c8])
    throws AssertError
{
    let expected = {
        let dmut f = File::open(Path(package).stripExtension().addExtension("df"));
        f:.readAll()
    } catch {
        err: &FsError => throw copy AssertError(format("%", err));
    };

    let dfs = buildDataflows(utils::compilePackage(package), withWeak-> false);
    let dmut stream = copy Formatter();
    for df in dfs {
        checkFixpoints(df);
        stream:.write(df.toDump());
    }

    utils::compareResultWithString(stream, expected,
                                   origin-> Path(package).stripExtension().addExtension("df").toStr(),
                                   canonicalizeIds-> true);
}

/**
 * @returns: true iif the list contains the identifier
 * */
fn contains(ids: [usize], id: usize)-> bool {
    for i in ids {
        if (i == id) return true;
    }

    false
}

/**
 * @params:
 *    - instr: an instruction of a frame
 * @returns: the variables the two first parameters of a `_yrt_dup_slice` call
 * name, none iif the instruction is not such a call
 * */
fn dupSliceArgs(instr: &YILInstr)-> ((usize, usize))? {
    let mut params: [&YILValue] = [];
    match instr {
        c: &YILCall => {
            match c.content {
                n: &YILNameCallValue => {
                    if (n.funcName != "_yrt_dup_slice") return none;
                    params = n.params;
                }
            }
        }
    }

    if (params.len < 2us) return none;

    let mut ids: [usize] = [];
    for i in 0us .. 2us {
        match params[i] {
            a: &YILAddrValue => {
                match a.value {
                    v: &YILVar => { ids ~= [v.id]; }
                }
            }
        }
    }

    if (ids.len != 2us) return none;

    (ids[0us], ids[1us])?
}

__test {
    // a branch and a loop, the liveness of the locals across them
    compareDump("test_resources/dataflow/test1.yr");
}

__test {
    // a try/catch, a variable read by the handler only
    compareDump("test_resources/dataflow/test2.yr");
}

__test {
    // a local whose address escapes, and a store through the pointer
    compareDump("test_resources/dataflow/test3.yr");
}

__test {
    // a slice copy, the out parameter of the runtime call
    compareDump("test_resources/dataflow/test4.yr");
}

__test {
    // the address passed to a runtime function that writes it is a definition,
    // the one passed to a parameter it reads is a use. Reading the first one as
    // a use is what makes the framework useless for the temporaries the expander
    // produces, and reading the second one as a definition is unsound
    let df = dataflowOf("test_resources/dataflow/test4.yr", "foo");
    let du = df.getDefUse();
    let mut nb = 0us;

    for b in df.getCfg().getBlocks() {
        for i in b.getInstrs() {
            if let Ok(args) = dupSliceArgs(i) {
                nb += 1us;
                let set = du.ofInstr(i);

                assert (contains(set.getDefs(), args.0),
                        format("the out parameter #% is not defined by the call", args.0));
                assert (!contains(set.getUses(), args.0),
                        format("the out parameter #% is read by the call", args.0));
                assert (contains(set.getUses(), args.1),
                        format("the in parameter #% is not read by the call", args.1));
                assert (!contains(set.getDefs(), args.1),
                        format("the in parameter #% is written by the call", args.1));
                assert (!contains(du.getEscaped(), args.0),
                        format("the out parameter #% escaped, though the callee is known", args.0));
            }
        }
    }

    assert (nb != 0us, "test4 : no call to _yrt_dup_slice in the frame");
}

__test {
    // the address of a local taken by the frame escapes, and a store through a
    // pointer may write it: nothing but a direct assignment kills it
    let df = dataflowOf("test_resources/dataflow/test3.yr", "foo");
    let mut a = 0us;
    if let Ok(id) = df.varNamed("a") { a = id; }

    assert (a != 0us, "test3 : the frame declares no variable named a");
    assert (contains(df.getDefUse().getEscaped(), a), "test3 : the address of a did not escape");

    let mut nbStores = 0us;
    let du = df.getDefUse();
    for b in df.getCfg().getBlocks() {
        for i in b.getInstrs() {
            match i {
                af: &YILAffect => {
                    match af.left {
                        _: &YILUnrefValue => {
                            nbStores += 1us;
                            let set = du.ofInstr(i);

                            assert (contains(set.getMayDefs(), a),
                                    "the store through a pointer does not write a, though its address escaped");
                            assert (!contains(set.getDefs(), a),
                                    "the store through a pointer kills a, though nothing says the pointer points at it");
                        }
                    }
                }
            }
        }
    }

    assert (nbStores != 0us, "test3 : no store through a pointer in the frame");
}

__test {
    // a variable a catch handler reads is live on the exception edges entering
    // it: it is live across every throwing instruction of the region the handler
    // protects, though nothing there mentions it
    let df = dataflowOf("test_resources/dataflow/test2.yr", "foo");
    let mut msg = 0us;
    if let Ok(id) = df.varNamed("msg") { msg = id; }

    assert (msg != 0us, "test2 : the frame declares no variable named msg");

    let mut nbHandlers = 0us;
    for b in df.getCfg().getBlocks() {
        let mut isHandler = false;
        for p in b.getPrevious() {
            if (p.2 == EdgeKind::EXCEPTION) isHandler = true;
        }

        if (!isHandler) continue;
        nbHandlers += 1us;

        for u in b.getGens() {
            for p in b.getPrevious() {
                if (p.2 != EdgeKind::EXCEPTION) continue;

                assert (df.isLiveOut(p.0, u),
                        format("the variable #% the handler BB% reads is dead on the exception edge leaving BB%",
                               u, b.getUid(), (p.0).getUid()));
            }
        }
    }

    assert (nbHandlers != 0us, "test2 : no handler entered by an exception edge");

    let mut liveInHandler = false;
    for b in df.getCfg().getBlocks() {
        for p in b.getPrevious() {
            if (p.2 == EdgeKind::EXCEPTION && df.isLiveOut(p.0, msg)) liveInHandler = true;
        }
    }

    assert (liveInHandler, "test2 : msg is dead on every exception edge, though the handler reads it");
}

__test {
    // every frame of a package with a rich control flow reaches a fixpoint
    for package in SWEEP {
        let dfs = buildDataflows(utils::compilePackage(package));
        assert (dfs.len != 0us, format("% : no frame", package));

        for df in dfs {
            checkFixpoints(df);
            assert (df.toDump().len != 0us, format("% : % : empty dump", package, df.getName()));
        }
    }
}
