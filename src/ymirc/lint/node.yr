in node;

pub mod ::global;
pub mod ::instr;
pub mod ::type;
pub mod ::value;

use ymirc::lexing::word;
use ymirc::utils::format;

use std::{io, stream};

/**
 * YILNode
 *
 * Abstract base class for all Ymir Intermediate Language nodes.
 *
 */
@abstract
pub class YILNode {

    pub {
        // The location of the node
        let loc: &Word;
    }

    /**
     * @params:
     *   - loc: the location of the generator
     */
    pub self (loc: &Word)
        with loc = loc
    {}

    /**
     * Compare two nodes
     * @returns: true, iif the two nodes are strictly identical
     */
    pub fn opEquals(self, o: &YILNode)-> bool;


    impl Streamable;
    impl Formattable;
}
