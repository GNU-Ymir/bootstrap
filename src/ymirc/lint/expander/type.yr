/*
 * TypeExpander — expands high-level semantic types into concrete YIL types.
 *
 * The TypeExpander is responsible for lowering semantic types(NativeType,
 * CustomType, TemporaryType, CompoundType, etc.) into their corresponding
 * YILType representations. During expansion, it:
 *
 *   - generates tuple, array, and pointer types,
 *   - assigns unique type identifiers,
 *   - caches previously generated types to ensure structural uniqueness,
 *   - handles built-in composite types(delegate, lazy, map, future, class),
 *   - resolves class references and closure environments,
 *   - produces all YIL types required for code generation.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::lint::expander::type
 * @File: ymirc/lint/expander/type.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2024-01-29
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in type;

use ymirc::lint::expander;
use ymirc::lint::node::_;

use std::io;

use ymirc::utils::format;
use ymirc::semantic::generator::_;
use ymirc::global::core_;
use ymirc::lexing::keys;
use ymirc::lexing::word;

use std::fs::path;

use ymirc::semantic::{symbol, generator::_};
use ymirc::semantic::generator::{type::_, value::_};

/**
 * TypeExpander
 *
 * Expands semantic types into concrete YIL types. It maintains internal
 * caches for:
 *
 *   - tuple types,
 *   - array types,
 *   - pointer types,
 *
 * and assigns unique identifiers to newly created types. It also stores
 * pre-constructed built-in tuple types:
 *
 *   - delegate type,
 *   - lazy option type,
 *   - map type,
 *   - future type,
 *   - generic class type.
 *
 * The expander is used by the semantic generator to produce all YIL types
 * required for IR generation.
 *
 */
@final
pub class TypeExpander {

    prv {
        // The list of tuple types the expander has generated
        let mut _tuples: [&YILTuple => mut &YILTuple] = copy [];

        // The list of array types the expander has generated
        let mut _arrays: [&YILArray => mut &YILArray] = copy [];

        // The list of pointer types the expander has generated
        let mut _pointers: [&YILPointer => mut &YILPointer] = copy [];

        // The uniq id for tuples insertion
        let mut _uid: usize = 0us;

        // The delegate type
        let _dgType: &YILTuple;

        // The lazyOpt type
        let _lazyOpt: &YILTuple;

        // The future tuple type
        let _futureType: &YILTuple;

        // The tuple of a map
        let _mapType: &YILTuple;

        // The generic class tuple
        let _genericClass: &YILTuple;
    }

    /**
     * Construct an empty type expander.
     *
     * Initializes:
     *   - built-in tuple types(delegate, lazyOpt, map, future, genericClass),
     *   - pointer caches for *void and **void,
     *   - the unique-ID counter for generated types.
     *
     */
    pub self ()
        with _dgType = copy YILTuple(copy [YIL_PTR_VOID, YIL_PTR_VOID], fieldNames-> copy [DelegateKeys::CLOSURE, DelegateKeys::FUNC], uid-> 3us, prepared-> true)
        , _lazyOpt = copy YILTuple(copy [YIL_UINT_8, YIL_PTR_VOID, YIL_UINT_32, copy YILTuple(copy [YIL_PTR_VOID, YIL_PTR_VOID], fieldNames-> copy [DelegateKeys::CLOSURE, DelegateKeys::FUNC], uid-> 3us, prepared-> true)],
                                   fieldNames-> copy [LazyKeys::IS_SET, LazyKeys::VALUE, LazyKeys::SIZE, LazyKeys::FUNC], uid-> 4us, prepared-> true)
        , _mapType = copy YILTuple(copy [YIL_PTR_VOID, YIL_PTR_VOID, YIL_UINT_MAX, YIL_UINT_MAX, YIL_UINT_MAX],
                                   fieldNames-> copy [MapKeys::BLK_INFO, MapKeys::ENTRIES, MapKeys::LEN, MapKeys::CAP, MapKeys::LOADED], uid-> 5us, prepared-> true)
        , _futureType =  copy YILTuple(copy [YIL_UINT_MAX, YIL_PTR_VOID],
                                       fieldNames-> copy [FutureKeys::THREAD_ID, FutureKeys::CONTENT], uid-> 6us, prepared-> true)
        , _genericClass = copy YILTuple(copy [YIL_PTR_2_VOID, YIL_PTR_VOID],
                                        fieldNames-> copy [ClassKeys::VTABLE, ClassKeys::MONITOR], uid-> 7us, prepared-> true)
        , _uid = 8us
    {
        // *void and **void have respectively uids 1 and 2
        self._pointers[YIL_PTR_VOID] = YIL_PTR_VOID;
        self._pointers[YIL_PTR_2_VOID] = YIL_PTR_2_VOID;
    }

    /**
     * Finalize a semantic type into a YILType.
     *
     * Dispatches based on the concrete semantic type:
     *   - NativeType,
     *   - CustomType,
     *   - TemporaryType.
     *
     * @params:
     *   - context: the expansion context
     *   - ty:      the semantic type to expand
     *
     * @returns:
     *   - &YILType: the finalized YIL type
     *
     * @throws:
     *   - panic: for unsupported or invalid types
     */
    pub fn finalize(mut self, dmut context: &Expander, ty: &Type)-> &YILType {
        match ty {
            b: &NativeType => {
                return self:.finalizeNative(alias context, b);
            }
            c: &CustomType => {
                return self:.finalizeCustom(alias context, c);
            }
            t: &TemporaryType => {
                return self:.finalizeTemporary(alias context, t);
            }
        }

        eprintln("internal type expansion error: ", ty.__typeinfo__.name);
        panic;
    }

    /**
     * Compute the depth of a pointer type.
     *
     * @example:
     *   *i32 => 1
     *   *(*i32) => 2
     *   *(*(*i32)) => 3
     *   i32 => 0
     *
     * @params:
     *   - ty: the YIL type to inspect
     *
     * @returns:
     *   - usize: pointer nesting depth
     */
    pub fn getPointerDepth(self, ty: &YILType)-> usize {
        match ty {
            p: &YILPointer => { 1us + self.getPointerDepth(p.inner) }
            _ => { 0us }
        }
    }

    /**
     * Return all YIL types generated during expansion.
     *
     * Includes:
     *   - tuple types,
     *   - array types,
     *   - pointer types.
     *
     * @params:
     *   - none
     *
     * @returns:
     *   - [&YILType]: list of generated types
     */
    pub fn getTypes(self)-> [&YILType] {
        let tuples: [&YILType] = copy [v for _, v in self._tuples];
        let arrays: [&YILType] = copy [v for _, v in self._arrays];
        let ptrs: [&YILType] = copy [v for _, v in self._pointers];

        return tuples ~ arrays ~ ptrs;
    }

    /*!
     * =====================================================================================
     * =====================================================================================
     * =========================            NATIVE TYPES           =========================
     * =====================================================================================
     * =====================================================================================
     */

    /**
     * Finalize a native type.
     *
     * @params:
     *   - context: expansion context
     *   - ty:      native type to expand
     *
     * @returns:
     *   - &YILType
     */
    fn finalizeNative(mut self, dmut context: &Expander, ty: &NativeType)-> &YILType {
        match ty {
            BoolType() => { return YIL_UINT_8; }
            VoidType() => { return YIL_VOID; }
            NoneType() => { return YIL_VOID; }
            DelegateType() => { return self:.finalizeDelegate(); }
            FuncPtrType() => { return self:.finalizeFuncPtr(); }

            c: &CharType => { return self.finalizeChar(c); }
            f: &FloatType => { return self.finalizeFloat(f); }
            i: &IntType => { return self.finalizeInt(i); }
            f: &FutureType => { return self:.finalizeFuture(alias context, f); }
            c: &CompoundType => { return self:.finalizeCompound(alias context, c); }
        }

        eprintln("internal type expansion error: ", ty.__typeinfo__.name);
        panic;
    }

    /**
     * Finalize a character type.
     *
     * @params:
     *   - c: the CharType
     *
     * @returns:
     *   - &YILType
     */
    fn finalizeChar(self, c: &CharType)-> &YILType {
        match c.size {
            8u16 => { YIL_UINT_8 }
            16u16 => { YIL_UINT_16 }
            _ => { YIL_UINT_32 }
        }
    }

    /**
     * Finalize an integer type.
     *
     * Maps(size, signedness) to the corresponding YILInt.
     *
     * @params:
     *   - i: the IntType
     *
     * @returns:
     *   - &YILInt
     */
    fn finalizeInt(self, i: &IntType)-> &YILInt {
        match (i.size, i.isSigned) {
            (8u16, true) => { YIL_SINT_8 }
            (16u16, true) => { YIL_SINT_16 }
            (32u16, true) => { YIL_SINT_32 }
            (64u16, true) => { YIL_SINT_64 }
            (_, true) => { YIL_SINT_MAX }

            (8u16, false) => { YIL_UINT_8 }
            (16u16, false) => { YIL_UINT_16 }
            (32u16, false) => { YIL_UINT_32 }
            (64u16, false) => { YIL_UINT_64 }
            _ => { YIL_UINT_MAX }
        }
    }

    /**
     * Finalize a floating‑point type.
     *
     * @params:
     *   - f: the FloatType
     *
     * @returns:
     *   - &YILType
     */
    fn finalizeFloat(self, f: &FloatType)-> &YILType {
        match f.size {
            32u16 => { YIL_FLOAT_32 }
            64u16 => { YIL_FLOAT_64 }
            80u16 => { YIL_FLOAT_80 }
            _ => { YIL_FLOAT_MAX }
        }
    }

    /**
     * Finalize a delegate type.
     *
     * Ensures the built-in delegate tuple type is registered and returns it.
     *
     * @returns:
     *   - &YILType
     */
    pub fn finalizeDelegate(mut self)-> &YILType {
        self._tuples[self._dgType] = self._dgType;
        self._dgType
    }

    /**
     * Finalize a lazy option type.
     *
     * Registers the delegate and lazyOpt tuple types and returns lazyOpt.
     *
     * @returns:
     *   - &YILType
     */
    pub fn finalizeLazy(mut self)-> &YILType {
        self._tuples[self._dgType] = self._dgType;
        self._tuples[self._lazyOpt] = self._lazyOpt;
        self._lazyOpt
    }

    /**
     * Finalize a function pointer type.
     *
     * All function pointers lower to *void.
     *
     * @returns:
     *   - &YILType: YIL_PTR_VOID
     */
    pub fn finalizeFuncPtr(mut self)-> &YILType {
        YIL_PTR_VOID
    }

    /**
     * Finalize a compound types.
     *
     * @params:
     *   - context: expansion context
     *   - ty:      ArrayType
     *
     * @returns:
     *   - &YILArray
     */
    fn finalizeCompound(mut self, dmut context: &Expander, ty: &CompoundType)-> &YILType {
        match ty {
            a: &ArrayType => { return self:.finalizeArray(alias context, a); }
            p: &PointerType => { return self:.finalizePointer(alias context, p); }
            r: &RangeType => {  return self:.finalizeRange(alias context, r); }
            s: &SliceType => { return self:.finalizeSlice(alias context, s); }
            t: &TupleType => { return self:.finalizeTuple(alias context, t); }
            o: &OptionType => { return self:.finalizeOption(alias context, o); }
            m: &MapType => { return self:.finalizeMap(alias context, m); }
        }

        eprintln("internal type expansion error: ", ty.__typeinfo__.name);
        panic;
    }

    /**
     * Finalize an array type.
     * Expands the inner type, then calls finalizeArray(inner, len).
     *
     * @params:
     *   - context: expansion context
     *   - ty:      ArrayType
     *
     * @returns:
     *   - &YILArray
     */
    fn finalizeArray(mut self, dmut context: &Expander, ty: &ArrayType)-> &YILType {
        let inner = context:.finalizeType(ty.inners[0]);
        self:.finalizeArray(inner, ty.len)
    }

    /**
     * Finalize an array from inner type and length.
     * Ensures structural uniqueness via the array cache.
     *
     * @params:
     *   - inner: inner YIL type
     *   - len:   array length
     *
     * @returns:
     *   - &YILArray
     */
    pub fn finalizeArray(mut self, inner: &YILType, len: usize)-> &YILArray {
        let ret = copy YILArray(inner, len, uid-> self._uid);
        if let Ok(a) = self._arrays[ret] {
            return a;
        }

        self._uid += 1;
        self._arrays[ret] = ret;
        ret
    }

    /**
     * Finalize a pointer type.
     *
     * Special cases:
     *   - *void  → YIL_PTR_VOID
     *   - **void → YIL_PTR_2_VOID
     *
     * Otherwise creates or reuses a YILPointer.
     *
     * @params:
     *   - inner: inner YIL type
     *
     * @returns:
     *   - &YILPointer
     */
    fn finalizePointer(mut self, dmut context: &Expander, ty: &PointerType)-> &YILType {
        let inner = context:.finalizeType(ty.inners[0]);
        self:.finalizePointer(inner)
    }

    /**
     * Finalize a pointer from an inner type
     * */
    pub fn finalizePointer(mut self, inner: &YILType)-> &YILPointer {
        if (inner of YILVoid) return YIL_PTR_VOID;
        if let p: &YILPointer = inner && p.inner of YILVoid {
            return YIL_PTR_2_VOID;
        }

        let ret = copy YILPointer(inner, uid-> self._uid);
        if let Ok(t) = self._pointers[ret] {
            return t;
        }

        self._uid += 1;
        self._pointers[ret] = ret;
        ret
    }

    /**
     * Finalize a range type.
     *
     * Produces a tuple:
     *   (fst, scd, step, contains)
     *
     * @params:
     *   - rng: RangeType
     *
     * @returns:
     *   - &YILTuple
     */
    fn finalizeRange(mut self, dmut _: &Expander, rng: &RangeType)-> &YILType {
        let inner = self.finalizeInt(rng.start);
        let step = self.finalizeInt(rng.step);
        self:.finalizeTuple(copy [inner, inner, step, YIL_UINT_8],
                            fieldNames-> copy [RangeKeys::FST, RangeKeys::SCD, RangeKeys::STEP, RangeKeys::CONTAINS])
    }

    /**
     * Finalize a slice type.
     *
     * Produces a tuple:
     *   (len, ptr, blk_info)
     *
     * @params:
     *   - inner: element type
     *
     * @returns:
     *   - &YILTuple
     */
    fn finalizeSlice(mut self, dmut context: &Expander, sl: &SliceType)-> &YILType {
        let inner = context:.finalizeType(sl.inners[0]);
        let len = YIL_UINT_MAX;

        self:.finalizeTuple(copy [len, self:.finalizePointer(inner), YIL_PTR_VOID],
                            fieldNames-> copy [SliceKeys::LEN, SliceKeys::PTR, SliceKeys::BLK_INFO])
    }

    /**
     * Finalize a slice type
     * */
    pub fn finalizeSlice(mut self, inner: &YILType)-> &YILType {
        let len = YIL_UINT_MAX;

        self:.finalizeTuple(copy [len, self:.finalizePointer(inner), YIL_PTR_VOID],
                            fieldNames-> copy [SliceKeys::LEN, SliceKeys::PTR, SliceKeys::BLK_INFO])
    }

    /**
     * Finalize a tuple type.
     *
     * Ensures structural uniqueness via the tuple cache.
     *
     * @params:
     *   - inners:     list of YIL types
     *   - fieldNames: optional field names
     *   - isUnion:    whether the tuple is a union
     *   - isPacked:   whether the tuple is packed
     *
     * @returns:
     *   - &YILTuple
     */
    fn finalizeTuple(mut self, dmut context: &Expander, tu: &TupleType)-> &YILType {
        let inners = copy [context:.finalizeType(ti) for ti in tu.inners];
        self:.finalizeTuple(inners)
    }

    /**
     * Finalize a tuple from pre validated inners
     * */
    pub fn finalizeTuple(mut self, inners: [&YILType], fieldNames: [[c8]] = [], isUnion: bool = false, isPacked: bool = false)-> &YILTuple {
        let ret = copy YILTuple(inners, fieldNames-> fieldNames, isUnion-> isUnion, isPacked-> isPacked, uid-> self._uid);
        if let Ok(t: &YILTuple) = self._tuples[ret] {
            return t;
        }

        self._uid += 1;
        self._tuples[ret] = ret;

        ret
    }

    /**
     * Finalize an option type.
     *
     * Produces:
     *   (isSet: u8, content: union(error, value))
     *
     * @params:
     *   - o: OptionType
     *
     * @returns:
     *   - &YILType
     */
    fn finalizeOption(mut self, dmut context: &Expander, o: &OptionType)-> &YILType {
        let inner = if (o.inners[0] of VoidType || o.inners[0] of NoneType) {
            YIL_UINT_8
        } else { context:.finalizeType(o.inners[0]) };

        let isSet = YIL_UINT_8;
        let error = self:.finalizeGenericClassPtr(alias context);

        let value = self:.finalizeTuple(copy [error, inner],
                                        fieldNames-> copy [OptionKeys::ERROR, OptionKeys::VALUE],
                                        isUnion-> true);

        self:.finalizeTuple(copy [isSet, value],
                            fieldNames-> copy [OptionKeys::SET, OptionKeys::CONTENT])
    }

    /**
     * Finalize a map type.
     *
     * Registers the built‑in map tuple type and returns a pointer to it.
     *
     * @returns:
     *   - &YILType
     */
    fn finalizeMap(mut self, dmut _: &Expander, _: &MapType)-> &YILType {
        self._tuples[self._mapType] = self._mapType;
        self:.finalizePointer(self._mapType)
    }

    /**
     * Finalize a future type.
     *
     * Registers and returns the built‑in future tuple type.
     *
     * @returns:
     *   - &YILType
     */
    pub fn finalizeFuture(mut self, dmut _: &Expander, _: &FutureType)-> &YILType {
        self._tuples[self._futureType] = self._futureType;
        self._futureType
    }

    /*!
     * =====================================================================================
     * =====================================================================================
     * =========================            CUSTOM TYPES           =========================
     * =====================================================================================
     * =====================================================================================
     */

    /**
     * Finalize a custom type.
     *
     * Handles:
     *   - class pointer types,
     *   - enum types,
     *   - proxies.
     *
     * @params:
     *   - context: expansion context
     *   - c:       CustomType
     *
     * @returns:
     *   - &YILType
     */
    fn finalizeCustom(mut self, dmut context: &Expander, c: &CustomType)-> &YILType {
        match c {
            cl: &ClassPtrType => { self:.finalizeClassPtr(alias context, cl) }
            en: &EnumType => {
                let name = Mangler::mangle(en);
                context:.registerTouchSym(name, en.sym.loc);

                self:.finalize(alias context, en.proxy)
            }
            _ => {
                eprintln(c.__typeinfo__.name);
                panic;
            }
        }
    }

    /**
     * Finalize a class pointer type.
     *
     * Expands the class reference, then:
     *   - returns a pointer for classes,
     *   - returns the struct tuple directly for structs.
     *
     * @params:
     *   - c: ClassPtrType
     *
     * @returns:
     *   - &YILType
     */
    fn finalizeClassPtr(mut self, dmut context: &Expander, c: &ClassPtrType)-> &YILType {
        let inner = {
            self:.finalizeClassRef(alias context, c.inner, c.isStruct, c.sym.isOverlaid)
        } catch {
            _ => panic; // invalid class
        }

        if (!c.isStruct) {
            self:.finalizePointer(inner)
        } else {
            inner
        }
    }

    /**
     * Finalize a generic class pointer type.
     *
     * Registers the built‑in generic class tuple and returns a pointer to it.
     *
     * @returns:
     *   - &YILType
     */
    pub fn finalizeGenericClassPtr(mut self, dmut _: &Expander)-> &YILType {
        self._tuples[self._genericClass] = self._genericClass;
        self:.finalizePointer(self._genericClass)
    }


    /*!
     * =====================================================================================
     * =====================================================================================
     * =======================            TEMPORARY TYPES           ========================
     * =====================================================================================
     * =====================================================================================
     */

    /**
     * Finalize a temporary type.
     *
     * @params:
     *   - context: expansion context
     *   - t:       TemporaryType
     *
     * @returns:
     *   - &YILType
     */
    fn finalizeTemporary(mut self, dmut context: &Expander, t: &TemporaryType)-> &YILType {
        match t {
            c: &ClassRefType => { self:.finalizeClassRef(alias context, c, c.sym.isStruct, c.sym.isOverlaid) }
            c: &ClassFieldAccType => {
                let inner = self:.finalizeTemporary(alias context, c.classRef);
                if !(c.classRef.sym.isStruct) {
                    self:.finalizePointer(inner)
                } else {
                    inner
                }
            }
            c: &ClosureType => { self:.finalizeClosure(alias context, c) }
            m: &MapIteratorType => { self:.finalizeMapIterator(alias context, m) }
            _ => {
                eprintln(t.__typeinfo__.name);
                panic;
            }
        }
    }

    /**
     * Finalize a class reference type.
     *
     * Builds a tuple representing the class layout, including:
     *   - vtable/monitor for classes,
     *   - entity flag for entities,
     *   - all fields.
     *
     * Uses context‑based recursion guards to avoid infinite recursion.
     *
     * @params:
     *   - cr:       ClassRefType
     *   - isStruct: whether the class is a struct
     *   - isUnion:  whether the class is a union
     *
     * @returns:
     *   - &YILTuple
     */
    fn finalizeClassRef(mut self, dmut context: &Expander, cr: &ClassRefType, isStruct: bool, isUnion: bool)-> &YILType {
        if let Ok(t) = context.isInClassValidation(cr) {
            t
        } else {
            let dmut tuple = copy YILTuple::empty(uid-> self._uid, isUnion-> isUnion);
            self._uid += 1;

            context:.enterClassValidation(cr, tuple);

            let mut params: [mut &YILType] = [];
            let mut names: [mut[c8]] = [];

            if (!isStruct) {
                params ~= [YIL_PTR_2_VOID, YIL_PTR_VOID];
                names ~= [ClassKeys::VTABLE, ClassKeys::MONITOR];
            } else if (cr.sym.isEntity) {
                params ~= [YIL_UINT_8];
                names ~= [ClassKeys::SET];
            }

            for v in cr.fields {
                params ~= [context:.finalizeType(v.varType)];
                names  ~= [v.loc.str];
            }

            tuple.inners = params;
            tuple.fieldNames = names;
            self._tuples[tuple] = tuple;

            return tuple;
        }
    }

    /**
     * Finalize a closure type.
     *
     * Produces a tuple containing all captured variables, then returns a pointer
     * to that tuple.
     *
     * @params:
     *   - cl: ClosureType
     *
     * @returns:
     *   - &YILType
     */
    fn finalizeClosure(mut self, dmut context: &Expander, cl: &ClosureType)-> &YILType {
        let mut params: [mut &YILType] = [];
        for pi in cl.types {
            params ~= [context:.finalizeType(pi)];
        }

        let inner = self:.finalizeTuple(params, fieldNames-> cl.names);
        self:.finalizePointer(inner)
    }

    /**
     * Finalize a map iterator type.
     *
     * Map iterators lower to *void.
     *
     * @returns:
     *   - &YILType: YIL_PTR_VOID
     */
    fn finalizeMapIterator(mut self, dmut _: &Expander, _: &MapIteratorType)-> &YILType {
        YIL_PTR_VOID
    }
}
