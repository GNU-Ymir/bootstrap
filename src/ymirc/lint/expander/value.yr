/*
 * ValueExpander — expands all semantic Value nodes into YIL instructions.
 *
 * The ValueExpander is the central dispatcher for value expansion. It lowers
 * every semantic Value into concrete YILValue and YILInstr nodes. It handles:
 *
 *   - control-flow values(break, continue, return, throw, panic),
 *   - variable declarations and references,
 *   - literal values,
 *   - operator expressions,
 *   - memory operations,
 *   - delegate construction,
 *   - scope blocks,
 *   - named values,
 *   - unit test registration,
 *   - coverage instrumentation.
 *
 * It also provides helper utilities for:
 *   - creating temporary variables inside a block,
 *   - registering unique values to ensure single evaluation,
 *   - scheduling and removing destructor calls.
 *
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::lint::expander::value
 * @File: ymirc/lint/expander/value.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2024-01-29
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in value;

use ymirc::lint::expander;
use ymirc::lint::node::_;

use ymirc::semantic::{symbol, generator::_};
use ymirc::semantic::generator::{type::_, value::_};

use ymirc::utils::format;
use ymirc::utils::{bigint, bigfloat};

use ymirc::semantic::generator::_;
use ymirc::global::{core_, state};
use ymirc::lexing::keys;

use ymirc::lexing::word;
use std::{io, fs::path};

use ymirc::lint::expander::value::_;


/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

mod ::call;
mod ::control;
mod ::field;
mod ::instr;
mod ::literal;
mod ::map;
mod ::memory;
mod ::operator;
mod ::slice;
mod ::delegate;

pub def LiteralExpander = literal::LiteralExpander;


/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          ROOT          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * ValueExpander
 *
 * Expands all semantic Value nodes into YILValue expressions and YILInstr
 * sequences. Acts as the root dispatcher for all value-level constructs.
 *
 * All functions append instructions to a StmtList and return the resulting
 * YILValue representing the expanded expression.
 */
pub mod ValueExpander {

    /**
     * Finalize a semantic Value.
     *
     * Dispatches based on the concrete Value type:
     *   - NamedValue,
     *   - BreakValue / ContinueValue / PanicValue / ThrowValue / ReturnValue,
     *   - VarDeclValue,
     *   - OperatorValue,
     *   - ScopeValue,
     *   - VarRefValue / GlobalVarRefValue,
     *   - LiteralValue,
     *   - MemoryValue,
     *   - DelegateValue.
     *
     * @params:
     *   - context: the expansion context
     *   - value:   the semantic value to expand
     *   - list:    the statement list to append instructions to
     *   - asLeft:  whether the value is used as an l-value
     *
     * @returns:
     *   - &YILValue: the expanded value
     *
     * @throws:
     *   - panic: for unsupported value types
     */
    pub fn finalize(dmut context: &Expander,
                    value:        &Value,
                    ref mut list: StmtList,
                    asLeft:       bool)-> &YILValue
    {
        match value {
            n: &NamedValue => return ValueExpander::finalize(alias context, n.value, ref list, asLeft-> asLeft);

            b: &BreakValue => return InstructionExpander::finalizeBreak(alias context, b, ref list);
            c: &ContinueValue => return InstructionExpander::finalizeContinue(alias context, c, ref list);
            p: &PanicValue => return InstructionExpander::finalizePanic(alias context, p, ref list);
            v: &VarDeclValue => return InstructionExpander::finalizeVarDecl(alias context, v, ref list);
            t: &ThrowValue => return InstructionExpander::finalizeThrow(alias context, t, ref list);
            r: &ReturnValue => return InstructionExpander::finalizeReturn(alias context, r, ref list);

            o: &OperatorValue => return OperatorExpander::finalizeOperator(alias context, o, ref list, asLeft-> asLeft);

            s: &ScopeValue => return ControlExpander::finalize(alias context, s, ref list, asLeft-> asLeft);

            v: &VarRefValue => return LiteralExpander::finalizeVarRef(alias context, v, ref list);
            v: &GlobalVarRefValue => return LiteralExpander::finalizeGlobalVarRef(alias context, v, ref list);
            l: &LiteralValue => return LiteralExpander::finalize(alias context, l, ref list, asLeft-> asLeft);

            m: &MemoryValue => return MemoryExpander::finalize(alias context, m, ref list, asLeft-> asLeft);
            d: &DelegateValue => return DelegateExpander::finalize(alias context, d, ref list, asLeft-> asLeft);
        }

        eprintln("internal value expansion error: ", value.__typeinfo.name);
        panic;
    }

    /**
     * Generate a code-coverage branch hit call.
     *
     * Behavior:
     *   - checks whether coverage is active and whether the current frame
     *     participates in coverage,
     *   - generates a unique coverage ID,
     *   - emits COVERAGE_HIT_BRANCH(frameAddr, coverageAddr, id).
     *
     * @params:
     *   - context: the expansion context
     *   - loc:     source location
     *   - list:    the statement list to append instructions to
     *
     * @returns:
     *   - void
     */
    pub fn generateCoverageCall(dmut context: &Expander, loc: &Word, ref mut list: StmtList) {
        if !state::isCodeCoverageActive() { // no coverage monitoring
            return;
        }

        if !context.isInCoverageFrame() {
            return;
        }

        let coverageId = context:.generateCoverageId(loc);
        let yilId = copy YILIntValue(loc, YIL_UINT_32, coverageId);

        let call = copy YILNameCallValue(loc,
                                         YIL_VOID,
                                         YRuntimeFuncs::COVERAGE_HIT_BRANCH,
                                         copy [context.getCurrentFrameAddr(),
                                               context.getCurrentFrameCoverageAddr(),
                                               yilId]);

        list:.append(copy YILCall(loc, call));
    }

    /**
     * Finalize registration of a unit test.
     *
     * Behavior:
     *   - obtains the function pointer of the test,
     *   - expands the test name into a string literal,
     *   - extracts the string pointer,
     *   - emits REGISTER_UNIT_TEST(namePtr, funcPtr).
     *
     * @params:
     *   - context:     the expansion context
     *   - name:        the test name
     *   - mangledName: the mangled function symbol
     *   - loc:         source location
     *   - list:        the statement list to append instructions to
     *
     * @returns:
     *   - void
     */
    pub fn finalizeRegisterUnitTest(dmut context: &Expander,
                                    name:         [c8],
                                    mangledName:  [c8],
                                    loc:          &Word,
                                    ref mut list: StmtList) {
        let funcAddr = copy YILAddrValue(EOF_WORD, YIL_PTR_VOID, copy YILVar(EOF_WORD, mangledName, YIL_VOID, 0));

        let funcStr = ValueExpander::finalize(alias context, copy StringValue(loc, name),
                                              ref list,
                                              asLeft-> false);

        let funcStrPtr = if let t: &YILTupleValue = funcStr { t.values[1] } else { panic; };
        let funcStrType = if let t: &YILTuple = funcStr.type { t.inners[1] } else { panic; };

        let (funcStrPtrU, _) = ValueExpander::createVarForBlock(alias context, loc, NONE_TYPE, funcStrType,
                                                                ref list,
                                                                withValue-> funcStrPtr);

        let call = copy YILNameCallValue(loc,
                                         YIL_VOID,
                                         YRuntimeFuncs::REGISTER_UNIT_TEST,
                                         copy [funcStrPtrU, funcAddr]);

        list:.append(copy YILCall(EOF_WORD, call));
    }

    /**
     * Create a temporary variable inside the current block.
     *
     * Behavior:
     *   - allocates a YILVarDecl with a unique name,
     *   - optionally initializes it with a value,
     *   - schedules a destructor if the generated type is movable,
     *   - optionally returns the variable's address.
     *
     * @params:
     *   - context:   the expansion context
     *   - loc:       source location
     *   - genType:   the semantic type of the generated value
     *   - type:      the YIL type of the variable
     *   - list:      the statement list to append instructions to
     *   - name:      the base name for the variable(default: "YI_%")
     *   - withValue: optional initializer
     *   - getAddr:   whether to also return the variable's address
     *
     * @returns:
     *   - (&YILValue, &YILValue): (variable, addressOrUnit)
     */
    pub fn createVarForBlock(dmut context: &Expander,
                             loc:          &Word,
                             genType:      &Type,
                             type:         &YILType,
                             ref mut list: StmtList,
                             name:         [c8] = "YI_%",
                             withValue:    &YILValue = YIL_UNIT_VALUE,
                             getAddr:      bool = false)-> (&YILValue, &YILValue)
    {
        if type of YILVoid {
            return (YIL_UNIT_VALUE, YIL_UNIT_VALUE);
        }

        let varId = context:.generateVarId();
        let fullName = format(name, varId);
        let blckVar = copy YILVarDecl(loc, fullName, type, varId,
                                      isTemp-> (name == "YI_%"));
        list:.append(blckVar);

        let var = copy YILVar(loc, fullName, type, varId,
                              isTemp-> (name == "YI_%"));

        if (withValue !of YILUnit) {
            OperatorExpander::finalizeAffect(loc, var, withValue,
                                             ref list);
        }

        if genType.isMovable {
            ValueExpander::registerDestroy(alias context, var, genType,
                                           ref list,
                                           implicit-> true);
        }

        if (getAddr) {
            let addr = MemoryExpander::createAddress(alias context, var,
                                                     type-> context.typeExpander:.finalizePointer(type),
                                                     ref list);
            return (var, addr);
        }

        return (var, YIL_UNIT_VALUE);
    }

    /**
     * Register a unique value for a semantic node.
     *
     * Ensures that expensive or side-effecting expressions are evaluated only
     * once by storing the result in a temporary variable and associating it
     * with the node's uniqId.
     *
     * @params:
     *   - context: the expansion context
     *   - gen:     the semantic value being expanded
     *   - value:   the computed YILValue
     *   - list:    the statement list to append instructions to
     *   - name:    the base name for the temporary variable
     *
     * @returns:
     *   - &YILValue: the registered variable
     */
    pub fn registerUniqValue(dmut context: &Expander,
                             gen:          &Value,
                             value:        &YILValue,
                             ref mut list: StmtList,
                             name:         [c8] = "YI_%")-> &YILValue {
        if (!context.isInAFrame()) {
            return value;
        }

        let type = context:.finalizeType(gen.type);
        let (varref, _) = ValueExpander::createVarForBlock(alias context, gen.loc, gen.type, type,
                                                           ref list,
                                                           name-> name);

        if (varref !of YILUnit) {
            context:.registerVariable(gen.uniqId, varref);
            OperatorExpander::finalizeAffect(gen.loc, varref, value, ref list);
        }

        return varref;
    }

    /**
     * Register a unique value with an explicit YIL type.
     *
     * Same as the other registerUniqValue overload, but allows specifying the
     * YIL type explicitly.
     *
     * @params:
     *   - context: the expansion context
     *   - gen:     the semantic value being expanded
     *   - type:    the YIL type of the temporary variable
     *   - value:   the computed YILValue
     *   - list:    the statement list to append instructions to
     *   - name:    the base name for the temporary variable
     *
     * @returns:
     *   - &YILValue: the registered variable
     */
    pub fn registerUniqValue(dmut context: &Expander,
                             gen:          &Value,
                             type:         &YILType,
                             value:        &YILValue,
                             ref mut list: StmtList,
                             name:         [c8] = "YI_%")-> &YILValue {
        if (!context.isInAFrame()) {
            return value;
        }

        let (varref, _) = ValueExpander::createVarForBlock(alias context, gen.loc, gen.type, type,
                                                           ref list,
                                                           name-> name);

        if (varref !of YILUnit) {
            context:.registerVariable(gen.uniqId, varref);
            OperatorExpander::finalizeAffect(gen.loc, varref, value, ref list);
        }

        return varref;
    }

    /**
     * Register a destructor call for a class instance.
     *
     * Behavior:
     *   - checks whether the type is a class pointer with a destructor,
     *   - ensures the destructor is not already scheduled,
     *   - emits a conditional block that:
     *       * checks the SET field,
     *       * calls the destructor,
     *       * resets the SET field,
     *   - optionally emits an explicit SET reset for non-parameter variables.
     *
     * @params:
     *   - context: the expansion context
     *   - gen:     the YILVar representing the instance
     *   - type:    the semantic type of the instance
     *   - list:    the statement list to append instructions to
     *   - implicit: whether the destructor is implicit
     *   - param:    whether the variable is a function parameter
     *
     * @returns:
     *   - void
     */
    pub fn registerDestroy(dmut context: &Expander,
                           gen:          &YILVar,
                           type:         &Type,
                           ref mut list: StmtList,
                           implicit:     bool,
                           param:        bool = false) {
        {
            let cptr = if let c: &ClassPtrType = type {
                if (!c.sym.isEntity) {
                    return;
                }
                c
            } else {
                return;
            };

            if let p: &PrototypeValue = cptr.inner.dtor {
                if (!list.hasToDestroy(gen.id)) {
                    let thenLabel = copy YILLabel(gen.loc, "then", context:.generateLblId());
                    let endLabel = copy YILLabel(gen.loc, "end", context:.generateLblId());
                    let test = copy YILFieldValue(gen.loc, YIL_UINT_8, gen, name-> ClassKeys::SET);

                    let name = Mangler::mangle(p);
                    context:.registerTouchSym(name, p.loc);

                    let call = copy YILNameCallValue(gen.loc, YIL_VOID, name, copy [copy YILAddrValue(gen.loc, YIL_PTR_VOID, gen)]);
                    let instr = copy YILCall(gen.loc, call);
                    let mut condList = StmtList();

                    condList:.append(copy YILCondJmp(gen.loc, test, thenLabel, endLabel));
                    condList:.append(thenLabel);
                    condList:.append(instr);
                    condList:.append(copy YILAffect(gen.loc, test, copy YILIntValue(gen.loc, YIL_UINT_8, 0)));
                    condList:.append(endLabel);

                    let set = if (!param) {
                        let field = copy YILFieldValue(gen.loc, YIL_UINT_8, gen, name-> ClassKeys::SET);
                        (copy YILAffect(gen.loc, field, copy YILIntValue(gen.loc, YIL_UINT_8, 0)))?
                    } else {
                        none
                    };

                    list:.registerDestroy(gen.id, copy YILBlock(gen.loc, condList[]), set, implicit);
                }
            }
        } catch {
            _ => {}
        }
    }

    /**
     * Remove a pending destructor for a variable.
     *
     * Used when a variable is returned or moved, preventing double destruction.
     *
     * @params:
     *   - p:    the YILValue to remove destruction for
     *   - list: the statement list to update
     *
     * @returns:
     *   - void
     */
    pub fn removeDestroy(p: &YILValue, ref mut list: StmtList) {
        if let v: &YILVar = p {
            list:.removeDestroyNotImplicit(v.id);
        }
    }
}
