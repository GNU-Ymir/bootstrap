 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in union_;

use ymirc::lint::node::_;
use ymirc::semantic::generator::mangler;
use ymirc::semantic::generator::type::{custom, temporary};
use ymirc::semantic::generator::value::prototype;


/**
 * Expands union metadata into YIL constants.
 *
 * One constant is emitted per member of the union, holding the implementation
 * that member provides for each method of the synthesized vtable. The tables
 * all have the same length, so a slot identifies the same method whichever
 * member is held. The table of a record member starts with its typeinfo, as a
 * class vtable does.
 */
pub mod UnionExpander {

    /**
     * Finalize union metadata.
     *
     * Nothing is emitted for a union declaring a base, whose slot holds the
     * member's own class vtable, nor for a union of classes whose members
     * agree on no method, whose slot is null.
     *
     * @params:
     *   - context: the expansion context
     *   - ur:      the union reference type
     *
     * @returns:
     *   - void
     */
    pub fn finalizeUnion(dmut context: &Expander, ur: &UnionRefType) {
        if (ur.base.hasValue || (ur.vtable.len == 0us && !ur.isRecord)) return;

        for i, table in ur.memberVtables {
            context:.enterSymbol();
            let vtableValue = UnionExpander::finalizeMemberVtable(alias context, ur, ur.members[i], table);
            let vtableName = Mangler::mangleUnionVtable(ur, i);
            let touchings = context:.exitSymbol();

            let cst = copy YILConstant(ur.loc,
                                       vtableName,
                                       vtableValue,
                                       isWeak-> ur.sym.isWeak,
                                       refs-> touchings);

            if (ur.sym.isWeak) {
                context:.insertWeak(vtableName, cst);
            } else {
                context:.insertSymbol(vtableName, cst);
            }
        }
    }

    /**
     * Finalize the vtable constant of one member of a union.
     *
     * The table carries no destructor, the union naming none: it is the
     * methods of the union, in slot order, preceded for a record member by its
     * typeinfo. A class member carries its typeinfo in its own vtable instead.
     *
     * @params:
     *   - context: the expansion context
     *   - ur:      the union reference type
     *   - member:  the member the table is the one of
     *   - table:   the implementation the member provides for each slot
     *
     * @returns:
     *   - &YILValue: the vtable array
     */
    fn finalizeMemberVtable(dmut context: &Expander, ur: &UnionRefType, member: &Type, table: [&MethodPrototypeValue])-> &YILValue {
        let mut params: [&YILValue] = [];
        if let c: &ClassPtrType = member && ur.isRecord if let Ok(cref) = c.inner? {
            let TIN = Mangler::mangleTypeInfo(cref);
            context:.registerTouchSym(TIN, cref.loc);

            params ~= [copy YILAddrValue(cref.loc, YIL_PTR_VOID, copy YILVar(cref.loc, TIN, YIL_PTR_VOID, 0us))];
        }

        for mt in table {
            let name = Mangler::mangle(mt);
            context:.registerTouchSym(name, mt.loc);

            params ~= [copy YILAddrValue(mt.loc, YIL_PTR_VOID, copy YILVar(mt.loc, name, YIL_VOID, 0us))];
        }

        let resultType = context.typeExpander:.finalizeArray(YIL_PTR_VOID, params.len);
        return copy YILArrayValue(ur.loc, resultType, params);
    }
}
