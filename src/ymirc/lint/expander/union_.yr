 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in union_;

use ymirc::lint::node::_;
use ymirc::semantic::generator::mangler;
use ymirc::semantic::generator::type::temporary;
use ymirc::semantic::generator::value::prototype;


/**
 * Expands union metadata into YIL constants.
 *
 * One constant is emitted per member of the union, holding the implementation
 * that member provides for each method of the synthesized vtable. The tables
 * all have the same length, so a slot identifies the same method whichever
 * member is held.
 */
pub mod UnionExpander {

    /**
     * Finalize union metadata.
     *
     * Nothing is emitted for a union declaring a base, whose slot holds the
     * member's own class vtable, nor for a union whose members agree on no
     * method, whose slot is null.
     *
     * @params:
     *   - context: the expansion context
     *   - ur:      the union reference type
     *
     * @returns:
     *   - void
     */
    pub fn finalizeUnion(dmut context: &Expander, ur: &UnionRefType) {
        if (ur.base.hasValue || ur.vtable.len == 0us) return;

        for i, table in ur.memberVtables {
            context:.enterSymbol();
            let vtableValue = UnionExpander::finalizeMemberVtable(alias context, ur, table);
            let vtableName = Mangler::mangleUnionVtable(ur, i);
            let touchings = context:.exitSymbol();

            let cst = copy YILConstant(ur.loc,
                                       vtableName,
                                       vtableValue,
                                       isWeak-> ur.sym.isWeak,
                                       refs-> touchings);

            if (ur.sym.isWeak) {
                context:.insertWeak(vtableName, cst);
            } else {
                context:.insertSymbol(vtableName, cst);
            }
        }
    }

    /**
     * Finalize the vtable constant of one member of a union.
     *
     * Unlike a class vtable the table carries no typeinfo and no destructor,
     * the union naming neither: it is the methods of the union and nothing
     * else, in slot order.
     *
     * @params:
     *   - context: the expansion context
     *   - ur:      the union reference type
     *   - table:   the implementation the member provides for each slot
     *
     * @returns:
     *   - &YILValue: the vtable array
     */
    fn finalizeMemberVtable(dmut context: &Expander, ur: &UnionRefType, table: [&MethodPrototypeValue])-> &YILValue {
        let resultType = context.typeExpander:.finalizeArray(YIL_PTR_VOID, table.len);
        let mut params: [&YILValue] = [];

        for mt in table {
            let name = Mangler::mangle(mt);
            context:.registerTouchSym(name, mt.loc);

            params ~= [copy YILAddrValue(mt.loc, YIL_PTR_VOID, copy YILVar(mt.loc, name, YIL_VOID, 0us))];
        }

        return copy YILArrayValue(ur.loc, resultType, params);
    }
}
