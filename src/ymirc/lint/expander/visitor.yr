/*
 * Expander — orchestrates the finalization of all semantic generators into YIL symbols.
 *
 * The Expander is the central coordinator of the finalization phase. It:
 *
 *   - receives all validated semantic generators,
 *   - dispatches each generator to its corresponding expander module,
 *   - manages symbol-touch tracking for dependency resolution,
 *   - manages frame, block, loop, and inline contexts,
 *   - manages variable and label uniq-ID allocation,
 *   - manages lazy references and declared variables,
 *   - manages coverage ID tracking,
 *   - manages class-validation state,
 *   - collects strong and weak symbols,
 *   - resolves weak-symbol dependencies via graph traversal,
 *   - returns the final ordered list of YIL symbols.
 *
 * The Expander is stateful and stack-based: entering/exiting frames, blocks,
 * loops, and inline contexts pushes/pops state layers.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::lint::expander::visitor
 * @File: ymirc/lint/expander/visitor.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2024-01-27
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in visitor;

use ymirc::lint::expander;
use ymirc::lint::node::_;

use ymirc::semantic::{symbol, generator::_};
use ymirc::semantic::generator::{type::_, value::_};

use ymirc::utils::{format, list};

use ymirc::global::{core_, state};
use ymirc::lexing::keys;

use ymirc::lexing::word;

use std::{io, fs::path, algorithm::sorting};

/**
 * Tracks foreign symbols referenced during the expansion of a symbol.
 *
 * Stored as:
 *   content: [symbolName => modulePath]
 */
class Touching {
    pub let mut content: [[c8] => mut Path] = copy [];
    pub self () {}
}

/**
 * Tracks declared variables in the current block scope.
 *
 * Stored as:
 *   content: [uniqId => &YILValue]
 */
class DeclaredVars {
    pub let mut content: [usize => mut &YILValue] = copy [];
    pub self () {}
}

/**
 * Tracks lazy variable references in the current block scope.
 *
 * Stored as:
 *   content: [uniqId => &YILVar]
 */
class LazyRefs {
    pub let mut content: [usize => mut &YILVar] = copy [];
    pub self () {}
}

/**
 * Tracks coverage locations(line/column pairs) for the current frame.
 *
 * Stored as:
 *   content: [&Word]
 */
class CoverageLocs {
    pub let mut content: [&Word] = [];
    pub self () {}
}

/**
 * Central orchestrator for the finalization phase. Converts semantic generators
 * into YIL symbols, manages all contextual state(frames, blocks, loops, inline
 * scopes, variable IDs, label IDs, lazy refs, coverage IDs), and resolves weak
 * symbol dependencies.
 *
 * All expander modules(FrameExpander, ClassExpander, GlobalExpander, etc.)
 * operate through this class.
 */
pub class Expander {

    /*!
     * =====================================================================================
     * =====================================================================================
     * =========================         GLOBAL GENERATORS         =========================
     * =====================================================================================
     * =====================================================================================
     */

    // The list of generators provided by the previous pass(validation)
    let mut _generators: [&Generator] = [];

    // The list of symbols created during finalization
    let mut _symbols: [[c8] => mut &YILSymbol] = copy [];

    // The list of weak symbols created during finalization
    let mut _weakSymbols: [[c8] => mut &YILSymbol] = copy [];

    // The set of modules that export an unittest
    let mut _moduleWithUnittests: [Path => mut[mut(&Word, [c8], [c8])]] = copy [];

    /*!
     * =====================================================================================
     * =====================================================================================
     * ====================         FINALIZER AND MISC VISITORS         ====================
     * =====================================================================================
     * =====================================================================================
     */

    // The expander responsible for value expansions
    let dmut _typeExpander: &TypeExpander; // = TypeExpander();

    /*!
     * =====================================================================================
     * =====================================================================================
     * =======================         CONTEXT FINALIZATION         ========================
     * =====================================================================================
     * =====================================================================================
     */

    // The name of the frame being validated
    let dmut _frameName: &List!{[c8]} = copy List!{[c8]} ();

    // The name of the frame being validated
    let dmut _frameAddr: &List!{&YILValue} = copy List!{&YILValue} ();

    // The name of the frame being validated
    let dmut _frameCoverAddr: &List!{&YILValue} = copy List!{&YILValue} ();

    // The list of symbols touched by the current symbol
    let dmut _touchings: &List!{dmut &Touching} = copy List!{dmut &Touching} ();

    // The current scope variable declarations
    let dmut _variables: &List!{dmut &DeclaredVars} = copy List!{dmut &DeclaredVars} ();

    // The current scope lazy references declarations
    let dmut _lazyRefs: &List!{dmut &LazyRefs} = copy List!{dmut &LazyRefs} ();

    // The current uniq id for variables in the current frame
    let dmut _varUniqId: &List!{usize} = copy List!{usize} ();

    // The current uniq id for labels in the current frame
    let dmut _lblUniqId: &List!{usize} = copy List!{usize} ();

    // The current uniq id for the coverage calls in the current frame
    let dmut _coverageUniqIds: &List!{dmut &CoverageLocs} = copy List!{dmut &CoverageLocs} ();

    // The var in which to put the result of loops(when breaking)
    let dmut _loopVar: &List!{&YILValue} = copy List!{&YILValue} ();

    // The label to exit the loop
    let dmut _loopLabel: &List!{(&YILLabel, &YILLabel)} = copy List!{(&YILLabel, &YILLabel)} ();

    // The var in which to put the result of inlined function
    let dmut _inlineVar: &List!{&YILValue} = copy List!{&YILValue} ();

    // The label to exit the current inline function
    let dmut _inlineLabel: &List!{&YILLabel} = copy List!{&YILLabel} ();

    // The list of classes already validated
    let mut _classValidated: [[c8] => mut &YILType] = copy [];

    // Global string stored in the text segment
    let mut _strConsts: [[c8] => mut &YILValue] = copy [];


    /*!
     * =====================================================================================
     * =====================================================================================
     * ==============================         CTORS         ================================
     * =====================================================================================
     * =====================================================================================
     */

    /**
     * Construct a new empty expander.
     *
     * Initializes:
     *   - empty symbol tables,
     *   - empty context stacks,
     *   - a fresh TypeExpander instance.
     */
    pub self ()
        with _typeExpander = copy TypeExpander()
    {}

    /**
     * Finalize a list of semantic generators.
     *
     * @returns:
     *   - [&YILSymbol]: all finalized symbols
     */
    pub fn finalize(mut self, generators: [&Generator])-> [&YILSymbol] {
        self._generators = generators;
        for gen in self._generators {
            self:.finalize(gen);
        }

        if (state::isUnittestActive()) {
            for m, lst in self._moduleWithUnittests {
                UnitTestExpander::finalizeUnitTestRegistrationFrame(alias self, m, lst);
            }

            UnitTestExpander::finalizeUnitTestCall(alias self);
        }

        return self:.traverseSymbolGraph();
    }

    /**
     * Finalize a single generator. Dispatches based on generator type.
     *
     * @throws:
     *   - panic: for unsupported generator types
     */
    pub fn finalize(mut self, gen: &Generator) {
        match gen {
            frame: &FrameGenerator => {
                FrameExpander::finalizeFrame(alias self, frame);
            }
            cl: &ClassRefType => {
                ClassExpander::finalizeClass(alias self, cl);
            }
            m: &MapInfoGenerator => {
                GlobalExpander::finalizeMapInfo(alias self, m);
            }
            u: &UnitTestGenerator => {
                UnitTestExpander::finalizeUnitTest(alias self, u);
            }
            g: &GlobalVarGenerator => {
                GlobalExpander::finalizeGlobalVar(alias self, g);
            }
            _ => {
                eprintln("internal symbol expansion error: ", gen.__typeinfo.name);
                panic;
            }
        }
    }

    /**
     * Finalize a semantic type into a YILType.
     *
     * Delegates to TypeExpander::finalize().
     *
     * @returns:
     *   - &YILType
     */
    pub fn finalizeType(mut self, ty: &Type)-> &YILType {
        self._typeExpander:.finalize(alias self, ty)
    }


    /*!
     * =====================================================================================
     * =====================================================================================
     * =========================              GETTERS              =========================
     * =====================================================================================
     * =====================================================================================
     */

    /**
     * @returns: all YIL types created during expansion.
     */
    pub fn getTypes(self)-> [&YILType] {
        self._typeExpander.getTypes()
    }

    /**
     * Resolve weak-symbol dependencies and return the final ordered symbol list.
     *
     * @returns:
     *   - [&YILSymbol]
     */
    fn traverseSymbolGraph(mut self)-> [&YILSymbol] {
        let mut consts: [mut &YILSymbol] = [];
        let mut vars: [mut &YILSymbol] = [];
        let mut frames: [mut &YILSymbol] = [];

        while self._symbols.len > 0us {
            let mut syms: [mut &YILSymbol] = [];
            for _, j in self._symbols { syms ~= [j]; }
            self._symbols = copy [];

            for i in syms {
                for t in i.references if let Ok(n: &YILSymbol) = self._weakSymbols[t] {
                    self._symbols[t] = n;
                    self._weakSymbols:.remove(t);
                }

                match i {
                    YILFrame() => { frames ~= [i]; }
                    YILConstant() => { consts ~= [i]; }
                    YILGlobalVar() => { vars ~= [i]; }
                    _ => panic;
                }
            }
        }

        let csts = sort(alias consts, |a, b| => {
            a.name < b.name
        });

        let frs = sort(alias frames, |a, b| => {
            a.name < b.name
        });

        let vrs = sort(alias vars, |a, b| => {
            a.name < b.name
        });

        return csts ~ vrs ~ frs;
    }

    /**
     * @returns: the expander used to finalize types
     * */
    @field
    pub fn typeExpander(mut self)-> dmut &TypeExpander {
        alias self._typeExpander
    }

    /*!
     * =====================================================================================
     * =====================================================================================
     * =========================              CONTEXT              =========================
     * =====================================================================================
     * =====================================================================================
     */

    /**
     * Insert a weak symbol into the weak‑symbol table.
     */
    pub fn insertWeak(mut self, name: [c8], sym: &YILSymbol) {
        self._weakSymbols[name] = sym;
    }

    /**
     * Insert a strong symbol into the strong‑symbol table.
     */
    pub fn insertSymbol(mut self, name: [c8], sym: &YILSymbol) {
        self._symbols[name] = sym;
    }

    /**
     * @returns: the variable receiving loop break values.
     */
    pub fn getLoopVarRef(self)-> &YILValue {
        self._loopVar.back
    }

    /**
     * @returns: the label used to exit the current loop.
     */
    pub fn getLoopExitLabel(self)-> &YILLabel {
        self._loopLabel.back._1
    }

    /**
     * @returns: the label used to continue the current loop.
     */
    pub fn getLoopNextLabel(self)-> &YILLabel {
        self._loopLabel.back._0
    }

    /**
     * Enter a loop context.
     *
     * Pushes:
     *   - loop result variable,
     *   - next‑iteration label,
     *   - exit label.
     */
    pub fn enterLoop(mut self, varref: &YILValue, nextLabel: &YILLabel, endLabel: &YILLabel) {
        self._loopVar:.push(varref);
        self._loopLabel:.push((nextLabel, endLabel));
    }

    /**
     * Exit the current loop context.
     */
    pub fn exitLoop(mut self) {
        self._loopVar:.pop();
        self._loopLabel:.pop();
    }

    /**
     * Enter an inline‑function context.
     *
     * Pushes:
     *   - inline result variable,
     *   - inline exit label.
     */
    pub fn enterInline(mut self, varref: &YILValue, endLabel: &YILLabel) {
        self._inlineVar:.push(varref);
        self._inlineLabel:.push(endLabel);
    }

    /**
     * Exit the current inline context.
     */
    pub fn exitInline(mut self) {
        self._inlineVar:.pop();
        self._inlineLabel:.pop();
    }

    /**
     * @returns: true if currently inside an inline block.
     */
    pub fn isInline(self)-> bool {
        return self._inlineVar.len != 0;
    }

    /**
     * @returns: the inline result variable.
     */
    pub fn getInlineVarRef(self)-> &YILValue {
        return self._inlineVar.back;
    }

    /**
     * @returns: the inline exit label.
     */
    pub fn getInlineExitLabel(self)-> &YILLabel {
        return self._inlineLabel.back;
    }

    /**
     * Enter a new symbol‑tracking scope.
     *
     * Pushes a fresh Touching record.
     */
    pub fn enterSymbol(mut self) {
        self._touchings:.push(copy Touching());
    }

    /**
     * Exit the current symbol‑tracking scope.
     *
     * @returns:
     *   - [[c8] => Path]: all foreign symbols touched in this scope.
     */
    pub fn exitSymbol(mut self)-> [[c8] => Path] {
        let touchs = self._touchings.back;
        self._touchings:.pop();

        touchs.content
    }

    /**
     * Register that the current symbol references another symbol.
     *
     * Stores:
     *   name → modulePath(loc.filename)
     */
    pub fn registerTouchSym(mut self, name: [c8], loc: &Word) {
        if !self._touchings.isEmpty {
            self._touchings.back.content[name] = Path(loc.filename).stripExtension();
        }
    }

    /**
     * Register that the current symbol references a class's typeinfo.
     *
     * Handles struct vs class pointer differences.
     */
    pub fn registerTouchClass(mut self, cl: &Type) {
        if let cptr: &ClassPtrType = cl if let Ok(cref) = cptr.inner? {
            if (!cptr.isStruct) {
                let TIN = Mangler::mangleTypeInfo(cref);
                self:.registerTouchSym(TIN, cptr.sym.loc);
            } else {
                let TIN = Mangler::mangleType(cptr, false);
                self:.registerTouchSym(TIN, cptr.sym.loc);
            }
        }
    }

    /**
     * Enter a new frame context.
     *
     * Pushes:
     *   - frame name,
     *   - frame address,
     *   - coverage frame address,
     *   - fresh variable ID counter,
     *   - fresh label ID counter,
     *   - fresh coverage ID list.
     */
    pub fn enterFrame(mut self, name: [c8], frameAddr: &YILValue = YIL_UNIT_VALUE, frameCoverAddr: &YILValue = YIL_UNIT_VALUE) {
        self._frameName:.push(name);
        self._frameAddr:.push(frameAddr);
        self._frameCoverAddr:.push(frameCoverAddr);

        self._varUniqId:.push(1us); // first ID id 1, 0 means no ref
        self._lblUniqId:.push(1us);
        self._coverageUniqIds:.push(copy CoverageLocs());
    }

    /**
     * Exit the current frame context.
     */
    pub fn exitFrame(mut self) {
        self._frameName:.pop();
        self._frameAddr:.pop();
        self._frameCoverAddr:.pop();

        self._varUniqId:.pop();
        self._lblUniqId:.pop();
        self._coverageUniqIds:.pop();
    }

    /**
     * @returns: true if currently inside a frame.
     */
    pub fn isInAFrame(self)-> bool {
        return self._varUniqId.len != 0us;
    }

    /**
     * @returns: the name of the current frame.
     */
    pub fn getCurrentFrameName(self)-> [c8] {
        return self._frameName.back;
    }

    /**
     * @returns: the address of the current frame.
     */
    pub fn getCurrentFrameAddr(self)-> &YILValue {
        return self._frameAddr.back;
    }

    /**
     * @returns: the coverage‑frame address of the current frame.
     */
    pub fn getCurrentFrameCoverageAddr(self)-> &YILValue {
        return self._frameCoverAddr.back;
    }

    /**
     * @returns: true if the current frame emits coverage metrics.
     */
    pub fn isInCoverageFrame(self)-> bool {
        if self._frameCoverAddr.len != 0 {
            return self._frameCoverAddr.back !of YILUnit;
        }

        return false;
    }

    /**
     * Restore variable and label uniq‑ID counters for the current frame.
     */
    pub fn setUniqIds(mut self, varIds: usize, lblIds: usize) {
        self._varUniqId.back = varIds;
        self._lblUniqId.back = lblIds;
    }

    /**
     * @returns: (nextVarId, nextLblId)
     */
    pub fn getUniqIds(mut self)-> (usize, usize) {
        return (self._varUniqId.back, self._lblUniqId.back);
    }

    /**
     * @returns: the next uniq variable ID for the current frame.
     */
    pub fn generateVarId(mut self)-> usize {
        let id = self._varUniqId.back;
        self._varUniqId.back = (id + 1);
        id
    }

    /**
     * @returns: the next uniq label ID for the current frame.
     */
    pub fn generateLblId(mut self)-> usize {
        let id = self._lblUniqId.back;
        self._lblUniqId.back = (id + 1);
        return id;
    }

    /**
     * Register a coverage location and return its uniq ID.
     */
    pub fn generateCoverageId(mut self, loc: &Word)-> usize {
        let dmut lst = self._coverageUniqIds.back;
        lst.content ~= [loc];

        return lst.content.len - 1us;
    }

    /**
     * @returns: the coverage ID list for the current frame.
     */
    pub fn getCoverageUniqIds(self)-> &CoverageLocs {
        return self._coverageUniqIds.back;
    }

    /**
     * Enter a new block scope.
     *
     * Pushes:
     *   - DeclaredVars,
     *   - LazyRefs.
     */
    pub fn enterBlock(mut self) {
        self._variables:.push(copy DeclaredVars());
        self._lazyRefs:.push(copy LazyRefs());
    }

    /**
     * Exit the current block scope.
     */
    pub fn exitBlock(mut self) {
        self._variables:.pop();
        self._lazyRefs:.pop();
    }

    /**
     * Register a variable reference for a uniq ID in the current frame.
     */
    pub fn registerVariable(mut self, uid: usize, vref: &YILValue) {
        self._variables.back.content[uid] = vref;
    }

    /**
     * Search for a variable reference by uniq ID.
     *
     * @returns:
     *   - (&YILValue)? — the variable reference or none.
     */
    pub fn getVariable(self, uid: usize)-> (&YILValue)? {
        for i in self._variables[] {
            if let Ok(n: &YILValue) = i.content[uid] {
                return n?;
            }
        }

        return none;
    }

    /**
     * Register a lazy variable reference by uniq ID.
     */
    pub fn registerLazyRef(mut self, uid: usize, vref: &YILVar) {
        self._lazyRefs.back.content[uid] = vref;
    }

    /**
     * Search for a lazy variable reference by uniq ID.
     *
     * @returns:
     *   - (&YILVar)? — the lazy reference or none.
     */
    pub fn getLazyRef(self, uid: usize)-> (&YILVar)? {
        for i in self._lazyRefs[] {
            if let Ok(n: &YILVar) = i.content[uid] {
                return n?;
            }
        }

        return none;
    }

    /**
     * @returns: the YILType of a class currently being validated, or none.
     */
    pub fn isInClassValidation(self, cr: &ClassRefType)-> (&YILType)? {
        self._classValidated[cr.sym.path.toStr()]
    }

    /**
     * Register that a class type is currently being validated.
     */
    pub fn enterClassValidation(mut self, cr: &ClassRefType, tu: &YILType) {
        self._classValidated[cr.sym.path.toStr()] = tu;
    }

    /**
     * Register a unittest for a module.
     *
     * Stores:
     *   modulePath → list of (loc, testName, mangledName)
     */
    pub fn insertInUnittest(mut self, modPath: Path, loc: &Word, symPath: &SymbolPath, name: [c8]) {
        if let Ok(mut lst: [mut(&Word, [c8], [c8])]) = alias self._moduleWithUnittests[modPath] {
            lst ~= [(loc, symPath.toStr(), name)];
            self._moduleWithUnittests[modPath] = alias lst;
        } else {
            self._moduleWithUnittests[modPath] = copy [(loc, symPath.toStr(), name)];
        }
    }
}
