 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in class_;

use ymirc::lint::expander;
use ymirc::lint::node::_;

use ymirc::semantic::{symbol, generator::_};
use ymirc::semantic::generator::{type::_, value::_};

use ymirc::utils::{format, list};

use ymirc::global::{core_, state};
use ymirc::lexing::keys;

use ymirc::lexing::word;

use std::io;

/**
 * Expands class metadata into YIL constants. Handles:
 *
 *   - vtable construction for non-abstract, non-struct classes,
 *   - typeinfo construction for all classes,
 *   - symbol-touch tracking for dependency resolution,
 *   - insertion of weak or strong constants into the global symbol table.
 *
 * All functions return YILValue constants representing class metadata.
 */
pub mod ClassExpander {

    /**
     * Finalize class metadata.
     *
     * @params:
     *   - context: the expansion context
     *   - cl:      the class reference type
     *
     * @returns:
     *   - void
     */
    pub fn finalizeClass(dmut context: &Expander, cl: &ClassRefType) {
        if (!cl.sym.isStruct && !cl.sym.isAbstract) {
            // abstract classes and structures don't have vtable
            // abstract because some of their methods are empty
            // and structures because their methods are not virtual
            //

            context:.enterSymbol();
            let vtableValue = ClassExpander::finalizeClassVtable(alias context, cl);
            let vtableName = Mangler::mangleVtable(cl);
            let touchings = context:.exitSymbol();

            // Const VTABLE
            let cst = copy YILConstant(cl.loc,
                                       vtableName,
                                       vtableValue,
                                       isWeak-> cl.sym.isWeak,
                                       refs-> touchings);

            if (cl.sym.isWeak) {
                context:.insertWeak(vtableName, cst);
            } else {
                context:.insertSymbol(vtableName, cst);
            }
        } else if (!cl.sym.isStruct) {
            ClassExpander::anchorClassMethods(alias context, cl);
        }

        context:.enterSymbol();
        let typeinfoValue = ClassExpander::finalizeClassTypeInfo(alias context, cl);
        let tiName = Mangler::mangleTypeInfo(cl);
        let touchings = context:.exitSymbol();

        // Const TYPEINFO
        let cst = copy YILConstant(cl.loc,
                                   tiName,
                                   typeinfoValue,
                                   isWeak-> cl.sym.isWeak,
                                   refs-> touchings);

        if (cl.sym.isWeak) {
            context:.insertWeak(tiName, cst);
        } else {
            context:.insertSymbol(tiName, cst);
        }
    }

    /**
     * Finalize the typeinfo constant for a class.
     *
     * @params:
     *   - context: the expansion context
     *   - cl:      the class reference type
     *
     * @returns:
     *   - &YILValue: the typeinfo tuple
     */
    pub fn finalizeClassTypeInfo(dmut context: &Expander, cl: &ClassRefType)-> &YILValue {
        let mut list = StmtList();

        let slcType = context.typeExpander:.finalizeSlice(YIL_VOID);

        let ancestorSlice = match cl.ancestor {
            Ok(anc) => {
                let ancTIN = Mangler::mangleTypeInfo(anc);
                context:.registerTouchSym(ancTIN, anc.loc);

                let ancTIV = copy YILAddrValue(cl.loc, YIL_PTR_VOID,
                                               copy YILVar(cl.loc, ancTIN, YIL_PTR_VOID, 0us));

                let len = copy YILIntValue(cl.loc, YIL_UINT_MAX, 1us);
                copy YILTupleValue(cl.loc, slcType, copy [len, ancTIV, YIL_NULL_VALUE],
                                   fieldNames-> copy [SliceKeys::LEN, SliceKeys::PTR, SliceKeys::BLK_INFO])
            }
            _ => {
                copy YILTupleValue(cl.loc, slcType,
                                   copy [copy YILIntValue(cl.loc, YIL_UINT_MAX, 0us), YIL_NULL_VALUE, YIL_NULL_VALUE],
                                   fieldNames-> copy [SliceKeys::LEN, SliceKeys::PTR, SliceKeys::BLK_INFO])
            }
        };

        let ti = if let t: &TypeInfoValue = cl.typeInfo { t } else { panic; };
        let id = ValueExpander::finalize(alias context, ti.id, ref list, asLeft-> false);
        let size = ValueExpander::finalize(alias context, ti.size, ref list, asLeft-> false);
        let name = ValueExpander::finalize(alias context, ti.name, ref list, asLeft-> false);
        let type = context:.finalizeType(ti.type);
        let fields = if let t: &YILTuple = type {
            t.fieldNames
        } else {
            panic;
        };

        // Dynamic objects in the typeinfo
        if (list.len != 0us) panic;

        return copy YILTupleValue(cl.loc, type,
                                  copy [id, size, ancestorSlice, name],
                                  fieldNames-> fields);
    }

    /**
     * Finalize the vtable constant for a class.
     *
     * @params:
     *   - context: the expansion context
     *   - cl:      the class reference type
     *
     * @returns:
     *   - &YILValue: the vtable array
     */
    pub fn finalizeClassVtable(dmut context: &Expander, cl: &ClassRefType)-> &YILValue {
        let len = cl.vtable.len + 2us; // TI, Dtor, vtable

        let resultType = context.typeExpander:.finalizeArray(YIL_PTR_VOID, len);
        let mut params: [&YILValue] = [];

        let TIN = Mangler::mangleTypeInfo(cl);
        context:.registerTouchSym(TIN, cl.loc);

        let TIV = copy YILAddrValue(cl.loc, YIL_PTR_VOID, copy YILVar(cl.loc, TIN, YIL_PTR_VOID, 0us));
        params ~= [TIV];

        match cl.dtor {
            UnitValue() => {
                params ~= [YIL_NULL_VALUE];
            }
            p: &PrototypeValue => {
                let name = Mangler::mangle(p);
                context:.registerTouchSym(name, cl.loc);

                let addr = copy YILAddrValue(p.loc, YIL_PTR_VOID, copy YILVar(p.loc, name, YIL_VOID, 0us));
                params ~= [addr];
            }
            _ => panic;
        };

        for mt in cl.vtable {
            let name = Mangler::mangle(mt);
            context:.registerTouchSym(name, mt.loc);

            let addr = copy YILAddrValue(mt.loc, YIL_PTR_VOID, copy YILVar(mt.loc, name, YIL_VOID, 0us));
            params ~= [addr];
        }

        return copy YILArrayValue(cl.loc, resultType, params);
    }

    /**
     * Anchor the methods implemented by an abstract class, taking the place of the vtable it
     * does not have.
     *
     * Nothing strong in the module declaring an abstract class refers to the methods it does
     * implement - a concrete class has its vtable for that. The methods a trait gives it are
     * weak symbols, and the symbol graph traversal only keeps a weak symbol reachable from a
     * strong one, so they would be dropped. No other module makes up for it: the module
     * declaring the class is the only one finalizing their body, the heirs merely reference
     * them(`self.super.opEquals`, say), which leaves them referenced everywhere and defined
     * nowhere.
     *
     * An anchor is a name and nothing else: it adds no symbol to the YIL, it only tells the
     * traversal to start from the method as it does from a strong symbol.
     *
     * @params:
     *   - context: the expansion context
     *   - cl:      the class reference type
     */
    pub fn anchorClassMethods(dmut context: &Expander, cl: &ClassRefType) {
        for mt in cl.vtable {
            if (!mt.isEmpty) { // an empty method has no body here, the heirs define their own
                context:.insertAnchor(Mangler::mangle(mt));
            }
        }
    }
}
