/*
 * StmtList — container for YIL instructions with destruction scheduling.
 *
 * A StmtList stores YIL instructions in evaluation order while enforcing
 * structural constraints:
 *
 *   - variable declarations are stored separately and always emitted first,
 *   - normal instructions preserve insertion order,
 *   - destructor blocks are registered and emitted at the end of the block,
 *   - SET-reset instructions for destroyable variables are tracked separately.
 *
 * The list supports:
 *   - appending instructions or other StmtLists,
 *   - registering destructor blocks,
 *   - removing implicit destructor scheduling,
 *   - querying destroyable variables,
 *   - producing the final ordered instruction sequence.
 *
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::lint::expander::stmtlist
 * @File: ymirc/lint/expander/stmtlist.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2024-01-31
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in stmtlist;


use ymirc::lint::node::instr;
use ymirc::utils::format;

/**
 * Represents an ordered list of YIL instructions with special handling for:
 *
 *   - variable declarations(emitted first),
 *   - normal instructions(emitted in insertion order),
 *   - destructor blocks(emitted at the end of the block),
 *   - SET-reset instructions for destroyable variables.
 *
 * Provides utilities for appending instructions, registering destruction,
 * removing implicit destruction, and producing the final ordered sequence.
 */
pub record StmtList {

    let mut _list: [mut &YILInstr] = [];

    let mut _decls: [mut &YILInstr] = [];

    let mut _setToDestroy: [usize => mut &YILInstr] = copy [];

    let mut _toDestroy: [usize => mut(&YILInstr, bool)] = copy [];

    /**
     * Construct an empty statement list.
     *
     * @returns:
     *   - an empty StmtList
     */
    pub self () {}

    /**
     * Append all instructions from another StmtList.
     *
     * Preserves declaration ordering and instruction ordering.
     *
     * @params:
     *   - v: the statement list to append
     *
     * @returns:
     *   - void
     */
    pub fn append(mut self, v: StmtList) {
        for il in v[] {
            self:.append(il);
        }
    }

    /**
     * Append a single instruction.
     *
     * Behavior:
     *   - YILVarDecl instructions are stored in _decls,
     *   - all other instructions are stored in _list.
     *
     * @params:
     *   - v: the instruction to append
     *
     * @returns:
     *   - void
     */
    pub fn append(mut self, v: &YILInstr) {
        match v {
            var: &YILVarDecl => {
                self._decls ~= [var];
            }
            _ => {
                self._list ~= [v];
            }
        }
    }

    /**
     * Append a list of instructions.
     *
     * Each instruction is appended using the standard append logic.
     *
     * @params:
     *   - v: the list of instructions
     *
     * @returns:
     *   - void
     */
    pub fn append(mut self, v: [&YILInstr]) {
        for il in v {
            self:.append(il);
        }
    }

    /**
     * Register a destructor block for a variable.
     *
     * Behavior:
     *   - stores the destructor block in _toDestroy[id],
     *   - optionally stores a SET‑reset instruction in _setToDestroy[id].
     *
     * @params:
     *   - id:      the variable identifier
     *   - v:       the destructor instruction block
     *   - setting: optional SET‑reset instruction
     *   - implicit: whether the destructor is implicit
     *
     * @returns:
     *   - void
     */
    pub fn registerDestroy(mut self, id: usize, v: &YILInstr, setting: (&YILInstr)?, implicit: bool) {
        self._toDestroy[id] = (v, implicit);

        if let Ok(s) = setting {
            self._setToDestroy[id] = s;
        }
    }

    /**
     * Remove a destructor block only if it was implicitly registered.
     *
     * Used when a variable is returned or moved, preventing double destruction.
     *
     * @params:
     *   - id: the variable identifier
     *
     * @returns:
     *   - void
     */
    pub fn removeDestroyNotImplicit(mut self, id: usize) {
        if let Ok((_, _ = true)) = self._toDestroy[id]  {
            self._toDestroy:.remove(id);
            self._setToDestroy:.remove(id);
        }
    }

    /**
     * Check whether a variable is scheduled for destruction.
     *
     * @params:
     *   - uid: the variable identifier
     *
     * @returns:
     *   - bool: true if a destructor block exists
     */
    pub fn hasToDestroy(self, uid: usize)-> bool {
        uid in self._toDestroy
    }

    /**
     * Check whether any variable in the list has a destructor scheduled.
     *
     * @returns:
     *   - bool: true if destruction is required
     */
    @field
    pub fn hasDestroy(self)-> bool {
        self._toDestroy.len != 0us
    }

    /**
     * Retrieve all destructor instruction blocks.
     *
     * @returns:
     *   - [&YILInstr]: the destructor blocks
     */
    pub fn getToDestroy(self)-> [&YILInstr] {
        return copy [v.0 for _, v in self._toDestroy];
    }

    /**
     * Retrieve all variable identifiers scheduled for destruction.
     *
     * @returns:
     *   - [usize]: the variable IDs
     */
    pub fn getToDestroyVars(self)-> [usize] {
        return copy [i for i, _ in self._toDestroy];
    }

    /**
     * Retrieve all SET-reset instructions for destroyable variables.
     *
     * @returns:
     *   - [&YILInstr]: the SET-reset instructions
     */
    pub fn getSetToDestroy(self)-> [&YILInstr] {
        return copy [v for _, v in self._setToDestroy];
    }

    /**
     * Produce the final ordered instruction list.
     *
     * Order:
     *   1. variable declarations,
     *   2. SET-reset instructions,
     *   3. normal instructions.
     *
     * Destructor blocks are appended by the enclosing block logic.
     *
     * @returns:
     *   - [&YILInstr]: the ordered instruction sequence
     */
    pub fn opIndex(self)-> [&YILInstr] {
        self._decls ~ self.getSetToDestroy() ~ self._list
    }

    /**
     * Return the number of instructions in the list.
     *
     * Counts:
     *   - variable declarations,
     *   - normal instructions.
     *
     * @returns:
     *   - usize: the number of instructions
     */
    @field
    pub fn len(self)-> usize {
        self._list.len  + self._decls.len
    }
}
