/*
 * TagExpander — expands the constructions of the tag sites.
 *
 * Every module the tag sites of which construct something gets one package
 * constructor frame, calling the instance of the `self` overload of each of its
 * sites, in the order the sites are written in the module. Each module has a
 * frame of its own: the order the frames of different modules run in is the
 * one the program loader runs the package constructors in, unspecified, as
 * against the unittest registration frames. Every package constructor runs
 * before `main`, so does every tag site.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::lint::expander::tag
 * @File: ymirc/lint/expander/tag.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-10-23
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in tag;

use ymirc::global::state;
use ymirc::lexing::{keys, word};
use ymirc::lint::node::_;
use ymirc::semantic::generator::_;

use std::algorithm::sorting;
use std::fs::path;

/**
 * Expands the constructions of the tag sites into one package constructor
 * frame per module.
 */
pub mod TagExpander {

    /**
     * Finalize the frame constructing the tag sites of a module.
     *
     * @params:
     *   - context: the expansion context
     *   - module:  the file of the module
     *   - sites:   the constructions of its sites, in the order they were validated
     */
    pub fn finalizeTagCtorFrame(dmut context: &Expander, module: Path, sites: [&TagCtorGenerator]) {
        let modulePath = module.removePrefix(state::package());

        let loc = copy LocWord(filename-> modulePath.toStr(), 0, 0);
        let name = Keys::TAG_CTOR_REGISTER ~ Mangler::manglePath(modulePath.stripExtension());

        let mut ordered: [mut (usize, &TagCtorGenerator)] = copy [(i, s) for i, s in sites];
        let sorted = sort(alias ordered, |a, b| => TagExpander::isBefore(a, b));

        context:.enterSymbol();
        context:.enterFrame(Keys::TAG_CTOR_REGISTER ~ modulePath.stripExtension().toStr(sep-> "::"));
        context:.enterBlock();

        let mut list = StmtList();
        for site in sorted {
            let (_, s) = site;
            ValueExpander::finalize(alias context, s.call, ref list, asLeft-> false);
        }

        context:.exitBlock();
        context:.exitFrame();
        let touchings = context:.exitSymbol();

        let final = copy YILFrame(loc,
                                  loc,
                                  name,
                                  [],
                                  YIL_VOID,
                                  body-> copy YILBlock(EOF_WORD, list[]),
                                  isGlobalCtor-> true,
                                  refs-> touchings);

        context:.insertSymbol(name, final);
    }

    /**
     * @returns: true iff the site `a` is written before the site `b`, or at the
     * same place and validated before it, both given with the rank they were validated in
     */
    fn isBefore(a: (usize, &TagCtorGenerator), b: (usize, &TagCtorGenerator))-> bool {
        let (i, x) = a;
        let (j, y) = b;
        if (x.loc.line != y.loc.line) return x.loc.line < y.loc.line;
        if (x.loc.col != y.loc.col) return x.loc.col < y.loc.col;

        i < j
    }
}
