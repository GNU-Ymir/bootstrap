in generator;

use ymirc::global::core_;
use ymirc::lexing::{keys, word};
use ymirc::lint::node::_;
use ymirc::lint::expander::value::_;
use ymirc::lint::optimizer;
use ymirc::lint::optimizer::defuse;
use ymirc::semantic::generator::{_, value::_};
use ymirc::semantic::generator::type::native;
use ymirc::utils::format;

/**
 * The states of a generator or async frame, a state above DONE resumes the body after a suspension.
 */
enum GeneratorStates
| START = 0us
| DONE  = 1us;

/**
 * Expands a generator into three frames:
 *
 *   - the function initializing the generator in a frame reserved by its caller: it
 *     stores the parameters and returns the handle `{frame, &resume}`, `init (frame, params...)`,
 *   - the function called by the user, that allocates the frame of the generator and
 *     initializes it,
 *   - the function resuming the body up to its next yield: `resume (frame, out)-> bool`.
 *
 * An async is expanded into the same three frames, its resume function taking the waker
 * of its driver: `resume (frame, out, waker)-> u8`, 1 while pending, 0 once it completed,
 * its value written to `out`. Resuming a completed async panics, where a completed
 * generator yields no value.
 *
 * A variable of the resume function whose value crosses a suspension is a field of the
 * frame, any other is a local of the resume function. Suspending the body is thus only
 * a return, whose resumption is a jump dispatched on the state of the frame.
 *
 * A generator consumed where it is created (YieldInitValue) is initialized in a frame
 * reserved by the consumer, a local or a field of the frame of the consuming generator,
 * when its frame is known: the generator is lowered by this expansion, and its frame
 * does not embed the one of the consumer.
 */
pub mod GeneratorExpander {

    /**
     * Finalize the frame of a generator or of an async into its init, create and resume frames,
     * unless a consumer already did.
     *
     * @params:
     *   - context: the expansion context
     *   - frame:   the frame generator node, a generator or an async
     */
    pub fn finalizeGenerator(dmut context: &Expander, frame: &FrameGenerator) {
        let name = Mangler::mangle(frame);
        if !context:.startGenerator(name) {
            return;
        }

        let outType = if let y: &YieldType = frame.retType {
            y.retType
        } else if let a: &AsyncType = frame.retType {
            a.retType
        } else { panic; };

        let dmut tuple = context.typeExpander:.createEmptyTuple();
        let framePtr = context.typeExpander:.finalizePointer(tuple);

        GeneratorExpander::finalizeResumeFrame(alias context, frame, outType, alias tuple, framePtr);
        context:.endGenerator(name, tuple);

        GeneratorExpander::finalizeInitFrame(alias context, frame, framePtr);
        GeneratorExpander::finalizeCreateFrame(alias context, frame, tuple, framePtr);
    }

    /**
     * Finalize the creation of a generator consumed in place: its frame is reserved in the
     * current frame and initialized by `init (&frame, params...)`, or allocated by the
     * generator when its frame is not known.
     *
     * @returns:
     *   - &YILValue: the call, returning the handle of the generator
     */
    pub fn finalizeInit(dmut context: &Expander, i: &YieldInitValue, ref mut list: StmtList)-> &YILValue {
        let frame = match context.getGeneratorDecl(Mangler::mangle(i.call.proto)) {
            Ok(f) => { f }
            _ => { return CallExpander::finalizeSimpleCall(alias context, i.call, ref list); }
        };

        let tuple = match GeneratorExpander::getFrame(alias context, frame) {
            Ok(t) => { t }
            _ => { return CallExpander::finalizeSimpleCall(alias context, i.call, ref list); }
        };

        let (_, frameAddr) = ValueExpander::createVarForBlock(alias context, i.loc, NONE_TYPE, tuple, ref list,
                                                              getAddr-> true);
        let params = CallExpander::finalizeArgs(alias context, i.call, ref list);

        let name = Mangler::mangleInitFrame(frame);
        context:.registerTouchSym(name, frame.implLoc);

        return copy YILNameCallValue(i.loc, context:.finalizeType(i.type), name, copy [frameAddr] ~ params);
    }

    /**
     * Get the frame of a generator, lowering it first if it was not.
     *
     * @returns: the frame, none while the generator is being lowered, its frame being incomplete
     */
    fn getFrame(dmut context: &Expander, frame: &FrameGenerator)-> (&YILTuple)? {
        let name = Mangler::mangle(frame);
        if !context.isGeneratorStarted(name) {
            let scopes = context:.suspendScopes();
            GeneratorExpander::finalizeGenerator(alias context, frame);
            context:.resumeScopes(scopes);
        }

        context.getGeneratorTuple(name)
    }

    /**
     * Finalize a yield: store the value, record the state resuming after it, and return.
     *
     * @returns:
     *   - &YILValue: always YIL_UNIT_VALUE
     */
    pub fn finalizeYield(dmut context: &Expander, y: &YieldValue, ref mut list: StmtList)-> &YILValue {
        let value = ValueExpander::finalize(alias context, y.value, ref list, asLeft-> false);
        let resume = copy YILLabel(y.loc, "resume", context:.generateLblId());

        let dmut gen = context:.getGenerator();
        gen.resumes ~= [resume];

        let valueType = if let p: &YILPointer = gen.out.type { p.inner } else { panic; };
        OperatorExpander::finalizeAffect(y.loc, copy YILUnrefValue(y.loc, valueType, gen.out), value, ref list);

        let state = copy YILFieldValue(y.loc, YIL_UINT_32, gen.frame, GeneratorKeys::STATE);
        list:.append(copy YILAffect(y.loc, state, copy YILIntValue(y.loc, YIL_UINT_32, cast!usize (GeneratorStates::DONE) + gen.resumes.len)));
        list:.append(copy YILReturn(y.loc, copy YILIntValue(y.loc, YIL_UINT_8, 1us)));
        list:.append(resume);

        return YIL_UNIT_VALUE;
    }

    /**
     * Finalize a `yield in`: the handle is stored in the frame, and the body resumes it
     * after its own resume label, returning each value it writes to `out`, until it is over.
     *
     * @returns:
     *   - &YILValue: always YIL_UNIT_VALUE
     */
    pub fn finalizeYieldIn(dmut context: &Expander, y: &YieldInValue, ref mut list: StmtList)-> &YILValue {
        let value = ValueExpander::finalize(alias context, y.generator, ref list, asLeft-> false);
        let (handle, _) = ValueExpander::createVarForBlock(alias context, y.loc, NONE_TYPE, value.type, ref list,
                                                           withValue-> value);
        let resume = copy YILLabel(y.loc, "resume", context:.generateLblId());
        let yielded = copy YILLabel(y.loc, "yielded", context:.generateLblId());
        let over = copy YILLabel(y.loc, "over", context:.generateLblId());

        let dmut gen = context:.getGenerator();
        gen.resumes ~= [resume];

        let state = copy YILFieldValue(y.loc, YIL_UINT_32, gen.frame, GeneratorKeys::STATE);
        list:.append(copy YILAffect(y.loc, state, copy YILIntValue(y.loc, YIL_UINT_32, cast!usize (GeneratorStates::DONE) + gen.resumes.len)));
        list:.append(resume);

        let func = copy YILFieldValue(y.loc, YIL_PTR_VOID, handle, DelegateKeys::FUNC);
        let closure = copy YILFieldValue(y.loc, YIL_PTR_VOID, handle, DelegateKeys::CLOSURE);
        let next = copy YILPtrCallValue(y.loc, YIL_UINT_8, func, copy [closure, gen.out]);

        list:.append(copy YILCondJmp(y.loc, next, yielded, over));
        list:.append(yielded);
        list:.append(copy YILReturn(y.loc, copy YILIntValue(y.loc, YIL_UINT_8, 1us)));
        list:.append(over);

        return YIL_UNIT_VALUE;
    }

    /**
     * Finalize an `await` of an async value, resuming it with the waker of the current async until
     * it completes, an `await` of a future value, or an `await;` calling that waker before giving
     * control back.
     *
     * @returns:
     *   - &YILValue: the value the awaited async or thread completed with, YIL_UNIT_VALUE when there is none
     */
    pub fn finalizeAwait(dmut context: &Expander, a: &AwaitValue, ref mut list: StmtList)-> &YILValue {
        if a.handle of UnitValue {
            return GeneratorExpander::finalizeYieldNow(alias context, a, ref list);
        }

        if a.handle.type of FutureType {
            return GeneratorExpander::finalizeAwaitFuture(alias context, a, ref list);
        }

        let value = ValueExpander::finalize(alias context, a.handle, ref list, asLeft-> false);
        let (handle, _) = ValueExpander::createVarForBlock(alias context, a.loc, NONE_TYPE, value.type, ref list,
                                                           withValue-> value);
        let (out, outAddr) = if a.type of VoidType {
            (YIL_UNIT_VALUE, YIL_NULL_VALUE)
        } else {
            ValueExpander::createVarForBlock(alias context, a.loc, NONE_TYPE, context:.finalizeType(a.type), ref list,
                                             getAddr-> true)
        };

        let resume = copy YILLabel(a.loc, "resume", context:.generateLblId());
        let pending = copy YILLabel(a.loc, "pending", context:.generateLblId());
        let ready = copy YILLabel(a.loc, "ready", context:.generateLblId());

        let dmut gen = context:.getGenerator();
        gen.resumes ~= [resume];
        list:.append(resume);

        let func = copy YILFieldValue(a.loc, YIL_PTR_VOID, handle, DelegateKeys::FUNC);
        let closure = copy YILFieldValue(a.loc, YIL_PTR_VOID, handle, DelegateKeys::CLOSURE);
        let poll = copy YILPtrCallValue(a.loc, YIL_UINT_8, func, copy [closure, outAddr, gen.waker]);

        list:.append(copy YILCondJmp(a.loc, poll, pending, ready));
        list:.append(pending);
        GeneratorExpander::finalizeSuspend(a.loc, gen, ref list);
        list:.append(ready);

        return out;
    }

    /**
     * Finalize an `await` of a future value, registering the waker of the current async on its
     * thread until it finished, the value it computed being read without blocking once it did.
     *
     * @returns:
     *   - &YILValue: the value the thread computed, YIL_UNIT_VALUE when there is none
     */
    fn finalizeAwaitFuture(dmut context: &Expander, a: &AwaitValue, ref mut list: StmtList)-> &YILValue {
        let value = ValueExpander::finalize(alias context, a.handle, ref list, asLeft-> false);
        let (handle, _) = ValueExpander::createVarForBlock(alias context, a.loc, NONE_TYPE, value.type, ref list,
                                                           withValue-> value);

        let resume = copy YILLabel(a.loc, "resume", context:.generateLblId());
        let pending = copy YILLabel(a.loc, "pending", context:.generateLblId());
        let ready = copy YILLabel(a.loc, "ready", context:.generateLblId());

        let dmut gen = context:.getGenerator();
        gen.resumes ~= [resume];
        list:.append(resume);

        let finished = copy YILNameCallValue(a.loc, YIL_UINT_8, YRuntimeFuncs::FUTURE_AWAIT, copy [handle, gen.waker]);
        list:.append(copy YILCondJmp(a.loc, finished, ready, pending));
        list:.append(pending);
        GeneratorExpander::finalizeSuspend(a.loc, gen, ref list);
        list:.append(ready);

        if a.type of VoidType {
            return YIL_UNIT_VALUE;
        }

        let retType = context:.finalizeType(a.type);
        let wait = copy YILNameCallValue(a.loc, context.typeExpander:.finalizePointer(retType), YRuntimeFuncs::WAIT_FUTURE,
                                         copy [handle]);
        let (ptr, _) = ValueExpander::createVarForBlock(alias context, a.loc, NONE_TYPE, wait.type, ref list,
                                                        withValue-> wait);
        return copy YILUnrefValue(a.loc, retType, ptr);
    }

    /**
     * Finalize an `await;`: the waker of the current async is called, so that its driver
     * resumes it, before it gives control back.
     *
     * @returns:
     *   - &YILValue: always YIL_UNIT_VALUE
     */
    fn finalizeYieldNow(dmut context: &Expander, a: &AwaitValue, ref mut list: StmtList)-> &YILValue {
        let resume = copy YILLabel(a.loc, "resume", context:.generateLblId());
        let dmut gen = context:.getGenerator();
        gen.resumes ~= [resume];

        let func = copy YILFieldValue(a.loc, YIL_PTR_VOID, gen.waker, DelegateKeys::FUNC);
        let closure = copy YILFieldValue(a.loc, YIL_PTR_VOID, gen.waker, DelegateKeys::CLOSURE);
        list:.append(copy YILCall(a.loc, copy YILPtrCallValue(a.loc, YIL_VOID, func, copy [closure])));

        GeneratorExpander::finalizeSuspend(a.loc, gen, ref list);
        list:.append(resume);

        return YIL_UNIT_VALUE;
    }

    /**
     * Suspend the body at its last resume label: the state resuming there is recorded, and
     * the resume function returns that it is pending.
     *
     * @params:
     *   - gen: the generator frame, whose last resume label is the one of the suspension
     */
    fn finalizeSuspend(loc: &Word, gen: &GeneratorFrame, ref mut list: StmtList) {
        let state = copy YILFieldValue(loc, YIL_UINT_32, gen.frame, GeneratorKeys::STATE);
        list:.append(copy YILAffect(loc, state, copy YILIntValue(loc, YIL_UINT_32, cast!usize (GeneratorStates::DONE) + gen.resumes.len)));
        list:.append(copy YILReturn(loc, copy YILIntValue(loc, YIL_UINT_8, 1us)));
    }

    /**
     * Finalize a return inside a generator or an async, that ends it, the value an async
     * completes with being written to `out`.
     *
     * @returns:
     *   - &YILValue: always YIL_UNIT_VALUE
     */
    pub fn finalizeReturn(dmut context: &Expander, r: &ReturnValue, ref mut list: StmtList)-> &YILValue {
        let value = ValueExpander::finalize(alias context, r.value, ref list, asLeft-> false);
        let gen = context:.getGenerator();
        if r.value.type !of VoidType {
            let valueType = if let p: &YILPointer = gen.out.type { p.inner } else { panic; };
            OperatorExpander::finalizeAffect(r.loc, copy YILUnrefValue(r.loc, valueType, gen.out), value, ref list);
        }

        list:.append(copy YILGoto(r.loc, gen.done));

        return YIL_UNIT_VALUE;
    }

    /**
     * Finalize the resumption of a generator: `(g.func)(g.closure, &out)`.
     *
     * @returns:
     *   - &YILValue: the call, true iff a value was yielded
     */
    pub fn finalizeNext(dmut context: &Expander, n: &YieldNextValue, ref mut list: StmtList)-> &YILValue {
        let gen = ValueExpander::finalize(alias context, n.generator, ref list, asLeft-> false);
        let out = ValueExpander::finalize(alias context, n.out, ref list, asLeft-> true);
        let outAddr = MemoryExpander::createAddress(alias context, out, context.typeExpander:.finalizePointer(out.type), ref list);

        let func = copy YILFieldValue(n.loc, YIL_PTR_VOID, gen, DelegateKeys::FUNC);
        let closure = copy YILFieldValue(n.loc, YIL_PTR_VOID, gen, DelegateKeys::CLOSURE);

        return copy YILPtrCallValue(n.loc, YIL_UINT_8, func, copy [closure, outAddr]);
    }

    /**
     * Finalize the run of an async: `_yrt_async_run (h, &out)`, driving it to completion.
     *
     * @returns:
     *   - &YILValue: the value the async completed with, read from `out`, or the call itself
     *                for an async-> void, which writes no value
     */
    pub fn finalizeRun(dmut context: &Expander, r: &AsyncRunValue, ref mut list: StmtList)-> &YILValue {
        let handle = ValueExpander::finalize(alias context, r.handle, ref list, asLeft-> false);
        if r.type of VoidType {
            return copy YILNameCallValue(r.loc, YIL_VOID, YRuntimeFuncs::ASYNC_RUN, copy [handle, YIL_NULL_VALUE]);
        }

        let (out, outAddr) = ValueExpander::createVarForBlock(alias context, r.loc, NONE_TYPE, context:.finalizeType(r.type), ref list,
                                                              getAddr-> true);
        list:.append(copy YILCall(r.loc, copy YILNameCallValue(r.loc, YIL_VOID, YRuntimeFuncs::ASYNC_RUN, copy [handle, outAddr])));

        return out;
    }

    /**
     * Finalize the poll of an async, resuming it once with the waker:
     * `if (h.func) (h.closure, &out, waker) { none } else { out? }`.
     *
     * @returns:
     *   - &YILValue: the option of the value the async completed with, empty while it is pending
     */
    pub fn finalizePoll(dmut context: &Expander, p: &AsyncPollValue, ref mut list: StmtList)-> &YILValue {
        let optType = if let o: &OptionType = p.type { o } else { panic; };
        let value = ValueExpander::finalize(alias context, p.handle, ref list, asLeft-> false);
        let (handle, _) = ValueExpander::createVarForBlock(alias context, p.loc, NONE_TYPE, value.type, ref list,
                                                           withValue-> value);
        let waker = ValueExpander::finalize(alias context, p.waker, ref list, asLeft-> false);

        let (out, outAddr) = if optType.inners[0] of VoidType {
            (copy YILIntValue(p.loc, YIL_UINT_8, 0us), YIL_NULL_VALUE)
        } else {
            ValueExpander::createVarForBlock(alias context, p.loc, NONE_TYPE, context:.finalizeType(optType.inners[0]), ref list,
                                             getAddr-> true)
        };

        let resultType = context:.finalizeType(optType);
        let (result, _) = ValueExpander::createVarForBlock(alias context, p.loc, NONE_TYPE, resultType, ref list);

        let func = copy YILFieldValue(p.loc, YIL_PTR_VOID, handle, DelegateKeys::FUNC);
        let closure = copy YILFieldValue(p.loc, YIL_PTR_VOID, handle, DelegateKeys::CLOSURE);
        let poll = copy YILPtrCallValue(p.loc, YIL_UINT_8, func, copy [closure, outAddr, waker]);

        let mut pendingList = StmtList();
        let mut readyList = StmtList();
        let empty = LiteralExpander::finalizeErrOpt(alias context, copy ErrOptionValue(p.loc, type-> optType), ref pendingList);
        pendingList:.append(copy YILAffect(p.loc, result, empty));

        if let t: &YILTuple = resultType {
            let content = copy YILTupleValue(p.loc, t.inners[1], fieldNames-> copy [OptionKeys::VALUE], copy [out]);
            let ready = copy YILTupleValue(p.loc, resultType, fieldNames-> copy [OptionKeys::SET, OptionKeys::CONTENT],
                                          copy [copy YILIntValue(p.loc, YIL_UINT_8, 1us), content]);
            readyList:.append(copy YILAffect(p.loc, result, ready));
        } else panic;

        ControlExpander::finalizeCond(p.loc, alias context, ref list, poll, pendingList, readyList, cover-> false);
        return result;
    }

    /**
     * Finalize the function resuming a generator or an async.
     *
     * @params:
     *   - valueType: the type of the values the generator yields, or of the one the async completes with
     *
     * @info: the fields of `tuple` are complete once this function returns.
     */
    fn finalizeResumeFrame(dmut context: &Expander, frame: &FrameGenerator, valueType: &Type, dmut tuple: &YILTuple, framePtr: &YILPointer) {
        let name = Mangler::mangleResumeFrame(frame);
        let enterCoverage = FrameExpander::isCoverageFrame(frame);
        let FRAME_INFO = Mangler::mangleCoverageFrameInfo(frame);

        let frameAddr = copy YILAddrValue(EOF_WORD, YIL_PTR_VOID, copy YILVar(EOF_WORD, name, YIL_VOID, 0us));
        let frameCoverAddr = if enterCoverage {
            copy YILAddrValue(EOF_WORD, YIL_PTR_VOID, copy YILVar(EOF_WORD, FRAME_INFO, YIL_VOID, 0us))
        } else { YIL_UNIT_VALUE };

        context:.enterSymbol();
        context:.enterFrame(frame.name.toStr(), frameAddr-> frameAddr, frameCoverAddr-> frameCoverAddr);
        context:.enterBlock();

        let outType = context.typeExpander:.finalizePointer(context:.finalizeType(valueType));
        let frameId = context:.generateVarId();
        let outId = context:.generateVarId();

        let mut params = copy [copy YILVarDecl(frame.loc, GeneratorKeys::FRAME, framePtr, frameId),
                               copy YILVarDecl(frame.loc, GeneratorKeys::OUT, outType, outId)];
        let mut waker: &YILValue = YIL_UNIT_VALUE;
        if frame.isAsync {
            let wakerType = context.typeExpander:.finalizeDelegate();
            let wakerId = context:.generateVarId();
            params = params ~ [copy YILVarDecl(frame.loc, GeneratorKeys::WAKER, wakerType, wakerId)];
            waker = copy YILVar(frame.loc, GeneratorKeys::WAKER, wakerType, wakerId);
        }

        let frameRef = copy YILUnrefValue(frame.loc, tuple, copy YILVar(frame.loc, GeneratorKeys::FRAME, framePtr, frameId));
        let outRef = copy YILVar(frame.loc, GeneratorKeys::OUT, outType, outId);
        let done = copy YILLabel(frame.loc, "done", context:.generateLblId());

        context:.enterGenerator(frameRef, alias tuple, outRef, done, waker-> waker);

        let state = context:.declareGeneratorField(frame.loc, GeneratorKeys::STATE, YIL_UINT_32);
        for p in frame.params {
            let field = context:.declareGeneratorField(p.loc, p.loc.str, context:.finalizeType(p.type));
            context:.registerVariable(p.uniqId, field);
        }

        let mut body = StmtList();
        ValueExpander::finalize(alias context, frame.body, ref body, asLeft-> false);
        body:.append(done);
        body:.append(copy YILAffect(frame.loc, state, copy YILIntValue(frame.loc, YIL_UINT_32, cast!usize (GeneratorStates::DONE))));
        body:.append(copy YILReturn(frame.loc, copy YILIntValue(frame.loc, YIL_UINT_8, 0us)));

        let finished = if frame.isAsync {
            GeneratorExpander::finalizeCompleted(alias context, frame, ref body)
        } else { done };

        let gen = context:.exitGenerator();
        let mut list = StmtList();
        GeneratorExpander::finalizeDispatch(alias context, frame.loc, state, gen, finished, ref list);
        list:.append(body);

        let resume = copy YILFrame(frame.loc, frame.implLoc, name, params, YIL_UINT_8,
                                   body-> copy YILBlock(frame.loc, list[]),
                                   refs-> copy []);
        let (inner, locals) = GeneratorExpander::promoteLocals(resume, gen);

        GeneratorExpander::layoutFrame(alias tuple, copy [(t, gen.names[i]) for i, t in gen.types] ~ locals);
        context.typeExpander:.registerTuple(tuple);

        let mut instr = inner;
        if enterCoverage {
            instr = FrameExpander::finalizeCoverage(alias context, frame, instr, frameAddr, frameCoverAddr);
        }

        context:.exitBlock();
        context:.exitFrame();
        let touching = context:.exitSymbol();

        let final = copy YILFrame(frame.loc,
                                  frame.implLoc,
                                  name,
                                  params,
                                  YIL_UINT_8,
                                  body-> instr,
                                  isWeak-> frame.isWeak,
                                  refs-> touching);

        if (frame.isWeak) {
            context:.insertWeak(name, final);
        } else {
            context:.insertSymbol(name, final);
        }
    }

    /**
     * Emit the panic of an async resumed after it completed.
     *
     * @params:
     *   - frame: the frame of the async
     *   - list:  the body of the resume function, the panic is appended to it
     *
     * @returns: the label of the panic, where the dispatch of a completed async jumps
     */
    fn finalizeCompleted(dmut context: &Expander, frame: &FrameGenerator, ref mut list: StmtList)-> &YILLabel {
        let completed = copy YILLabel(frame.loc, "completed", context:.generateLblId());
        list:.append(completed);

        InstructionExpander::finalizePanic(alias context, copy PanicValue(frame.loc), ref list);
        list:.append(copy YILReturn(frame.loc, copy YILIntValue(frame.loc, YIL_UINT_8, 0us)));

        completed
    }

    /**
     * Make a field of the frame of every local of the resume function whose value crosses a
     * suspension: it is live at a resume label, or its address is taken and a pointer to it
     * may be read after the suspension.
     *
     * @params:
     *   - resume: the resume function, whose locals are not fields yet
     *   - gen:    the generator frame, whose resume labels are all known
     *
     * @returns: (the body of the resume function, those locals read from their fields, the fields)
     */
    fn promoteLocals(resume: &YILFrame, gen: &GeneratorFrame)-> (&YILInstr, [(&YILType, [c8])]) {
        let flow = copy FrameDataflow(resume, withReaching-> false, withAvailable-> false);
        let vars = flow.getDefUse().getVars();
        let escaped = flow.getDefUse().getEscaped();

        let mut fields: [usize => mut &YILValue] = copy [];
        let mut locals: [(&YILType, [c8])] = [];
        for v in vars[resume.params.len .. $] {
            let mut crosses = defuse::containsId(escaped, v.id);
            for r in gen.resumes {
                if let Ok(bb) = flow.getCfg().getLabel(r.id) {
                    crosses = crosses || (flow.hasFacts(bb) && flow.isLiveIn(bb, v.id));
                }
            }

            if crosses {
                let name = if v.isTemp { "#" ~ v.name } else { format("%#%", v.name, v.id) };
                fields[v.id] = copy YILFieldValue(v.loc, v.type, gen.frame, name);
                locals ~= [(v.type, name)];
            }
        }

        let dmut rewriter = copy FieldRewriter(fields);
        (rewriter:.rewriteInstr(resume.body), locals)
    }

    /**
     * Complete the fields of the frame, ordered by decreasing alignment then size, so that
     * none of them is padded, those of the same layout staying in declaration order.
     * Accessed by name only, the fields of a frame can be laid out freely.
     *
     * @params:
     *   - tuple:  the frame, whose fields are set
     *   - fields: the type and name of every field, in declaration order
     */
    fn layoutFrame(dmut tuple: &YILTuple, fields: [(&YILType, [c8])]) {
        use std::algorithm::sorting;

        let sorted = sort(copy [((f._0).align, (f._0).size, i, f._0, f._1) for i, f in fields], |a, b| => {
            if (a._0 != b._0) return a._0 > b._0;
            if (a._1 != b._1) return a._1 > b._1;
            a._2 < b._2
        });

        tuple.inners = copy [f._3 for f in sorted];
        tuple.fieldNames = copy [f._4 for f in sorted];
    }

    /**
     * Emit the jumps resuming the body where the state of the frame says, the body
     * starts right after them in the START state.
     *
     * @params:
     *   - state:    the state field of the frame
     *   - gen:      the generator frame, whose resume labels are all known
     *   - finished: the label a frame resumed in the DONE state jumps to
     */
    fn finalizeDispatch(dmut context: &Expander, loc: &Word, state: &YILValue, gen: &GeneratorFrame, finished: &YILLabel, ref mut list: StmtList) {
        let targets = copy [finished] ~ gen.resumes;
        for i, target in targets {
            let next = copy YILLabel(loc, "next", context:.generateLblId());
            let test = copy YILBinaryValue(loc, YIL_UINT_8, BinaryOperators::DEQUAL, state,
                                           copy YILIntValue(loc, YIL_UINT_32, cast!usize (GeneratorStates::DONE) + i));

            list:.append(copy YILCondJmp(loc, test, target, next));
            list:.append(next);
        }
    }

    /**
     * Finalize the function initializing a generator in a frame it does not own: it stores
     * the parameters in it, and returns the handle pairing the frame and the resume function.
     * A parameter passed by reference (the `self` of a record) is copied into the frame.
     *
     * @params:
     *   - framePtr: the type of the pointer to the frame
     */
    fn finalizeInitFrame(dmut context: &Expander, frame: &FrameGenerator, framePtr: &YILPointer) {
        let name = Mangler::mangleInitFrame(frame);
        let resumeName = Mangler::mangleResumeFrame(frame);
        let loc = frame.loc;
        let mut list = StmtList();

        context:.enterSymbol();
        context:.enterFrame(frame.name.toStr());
        context:.enterBlock();

        let frameId = context:.generateVarId();
        let framePtrVar = copy YILVar(loc, GeneratorKeys::FRAME, framePtr, frameId);
        let (params, vars) = GeneratorExpander::finalizeParams(alias context, frame);
        let frameRef = copy YILUnrefValue(loc, framePtr.inner, framePtrVar);

        list:.append(copy YILAffect(loc, copy YILFieldValue(loc, YIL_UINT_32, frameRef, GeneratorKeys::STATE),
                                    copy YILIntValue(loc, YIL_UINT_32, cast!usize (GeneratorStates::START))));
        for i, p in frame.params {
            let type = context:.finalizeType(p.type);
            let arg = if p.isReference { copy YILUnrefValue(p.loc, type, vars[i]) } else { vars[i] };

            list:.append(copy YILAffect(p.loc, copy YILFieldValue(p.loc, type, frameRef, p.loc.str), arg));
        }

        context:.registerTouchSym(resumeName, frame.implLoc);
        let resume = copy YILAddrValue(loc, YIL_PTR_VOID, copy YILVar(loc, resumeName, YIL_VOID, 0us));
        let handle = copy YILTupleValue(loc, context.typeExpander:.finalizeDelegate(),
                                        copy [copy YILCastValue(loc, YIL_PTR_VOID, framePtrVar), resume],
                                        fieldNames-> copy [DelegateKeys::CLOSURE, DelegateKeys::FUNC]);

        list:.append(copy YILReturn(loc, handle));

        context:.exitBlock();
        context:.exitFrame();
        let touching = context:.exitSymbol();

        let final = copy YILFrame(loc,
                                  frame.implLoc,
                                  name,
                                  copy [copy YILVarDecl(loc, GeneratorKeys::FRAME, framePtr, frameId)] ~ params,
                                  context:.finalizeType(frame.retType),
                                  body-> copy YILBlock(loc, list[]),
                                  isWeak-> frame.isWeak,
                                  refs-> touching);

        GeneratorExpander::insertFrame(alias context, frame, name, final);
    }

    /**
     * Finalize the function creating a generator: it allocates the frame, and initializes it.
     *
     * @params:
     *   - tuple: the complete type of the frame
     */
    fn finalizeCreateFrame(dmut context: &Expander, frame: &FrameGenerator, tuple: &YILTuple, framePtr: &YILPointer) {
        let name = Mangler::mangle(frame);
        let initName = Mangler::mangleInitFrame(frame);
        let loc = frame.loc;
        let retType = context:.finalizeType(frame.retType);
        let mut list = StmtList();

        context:.enterSymbol();
        context:.enterFrame(frame.name.toStr());
        context:.enterBlock();

        let (params, args) = GeneratorExpander::finalizeParams(alias context, frame);

        let alloc = copy YILNameCallValue(loc, framePtr, YRuntimeFuncs::ALLOC_BLOCK,
                                          copy [copy YILIntValue(loc, YIL_UINT_MAX, tuple.size)]);
        let (framePtrVar, _) = ValueExpander::createVarForBlock(alias context, loc, NONE_TYPE, framePtr, ref list,
                                                                withValue-> alloc);

        context:.registerTouchSym(initName, frame.implLoc);
        let init = copy YILNameCallValue(loc, retType, initName, copy [framePtrVar] ~ args);
        let (handle, _) = ValueExpander::createVarForBlock(alias context, loc, NONE_TYPE, retType, ref list,
                                                           withValue-> init);

        list:.append(copy YILReturn(loc, handle));

        context:.exitBlock();
        context:.exitFrame();
        let touching = context:.exitSymbol();

        let final = copy YILFrame(loc,
                                  frame.implLoc,
                                  name,
                                  params,
                                  retType,
                                  body-> copy YILBlock(loc, list[]),
                                  isWeak-> frame.isWeak,
                                  refs-> touching);

        GeneratorExpander::insertFrame(alias context, frame, name, final);
    }

    /**
     * Declare the parameters of the generator in the current frame, those passed by reference
     * being pointers.
     *
     * @returns: (the declarations of the parameters, the variables reading them)
     */
    fn finalizeParams(dmut context: &Expander, frame: &FrameGenerator)-> ([&YILVarDecl], [&YILValue]) {
        let mut params: [&YILVarDecl] = [];
        let mut vars: [&YILValue] = [];
        for p in frame.params {
            let varId = context:.generateVarId();
            let mut type = context:.finalizeType(p.type);
            if p.isReference {
                type = context.typeExpander:.finalizePointer(type);
            }

            params ~= [copy YILVarDecl(p.loc, p.loc.str, type, varId)];
            vars ~= [copy YILVar(p.loc, p.loc.str, type, varId)];
        }

        (params, vars)
    }

    /**
     * Insert a frame of the generator `frame`, weak if the generator is.
     */
    fn insertFrame(dmut context: &Expander, frame: &FrameGenerator, name: [c8], final: &YILFrame) {
        if (frame.isWeak) {
            context:.insertWeak(name, final);
        } else {
            context:.insertSymbol(name, final);
        }
    }
}

/**
 * Rewrites the locals of a resume function that are fields of the frame of its generator
 * into accesses to those fields, their declarations removed.
 */
class FieldRewriter over YILRewriter {

    // the access to the field of each promoted local, by variable id
    let _fields: [usize => &YILValue];

    pub self (fields: [usize => &YILValue])
        with super ()
        , _fields = fields
    {}

    pub over rewriteValue(mut self, value: &YILValue)-> &YILValue {
        if let v: &YILVar = value {
            if let Ok(f) = self._fields[v.id] { return f; }
            return v;
        }

        self:.rewriteOperands(value)
    }

    prot over rewriteDest(mut self, value: &YILValue)-> &YILValue {
        if let v: &YILVar = value {
            return self:.rewriteValue(v);
        }

        self.super:.rewriteDest(value)
    }

    prot over rewriteList(mut self, instrs: [&YILInstr])-> [&YILInstr] {
        let mut res: [&YILInstr] = [];
        for i in instrs {
            if let v: &YILVarDecl = i {
                if v.id in self._fields { continue; }
            }

            res ~= [self:.rewriteInstr(i)];
        }

        res
    }
}
