in union_;

use ymirc::global::core_;
use ymirc::lexing::keys;
use ymirc::lint::node::_;
use ymirc::lint::expander::value::field;
use ymirc::semantic::generator::{mangler, type::_};
use ymirc::semantic::generator::value::operator;

/**
 * UnionValueExpander
 *
 * Expands the widening of a member value into the union listing it, which is
 * the only way a union object is ever built.
 *
 * The object carries the three fields of a union: the index of the member
 * held, the vtable the union dispatches through, and the overlay in which the
 * member is stored. A union of records is that object, a union of classes a
 * pointer to one, so the widening allocates a block for it.
 *
 * A match arm reads that same object back: the index tells it which member is
 * held, the overlay holds the member itself. The base a union declares is
 * reached without the index, every member descending from it.
 *
 * The typeinfo of a union of classes is read out of the object held, and the
 * one of a union of records out of its vtable.
 */
pub mod UnionValueExpander {

    /**
     * Finalize the widening of a member into a union.
     *
     * @params:
     *   - context: the expansion context
     *   - w:       the widening value
     *   - list:    the statement list to append instructions to
     *
     * @returns:
     *   - &YILValue: the union object, or the pointer to it for a union of classes
     */
    pub fn finalizeWiden(dmut context: &Expander, w: &UnionWidenValue, ref mut list: StmtList)-> &YILValue {
        let un = w.unionType;
        let unType = context:.finalizeType(un);
        let objType = if (un.isRecord) { unType } else {
            match unType {
                p: &YILPointer => { p.inner }
                _ => { panic; } // a union of classes is a pointer to its object
            }
        };

        let member = UnionValueExpander::finalizeMember(alias context, w, ref list);

        // the union of records is the object, the union of classes a block holding it
        let (object, result) = if (un.isRecord) {
            let (var, _) = ValueExpander::createVarForBlock(alias context, w.loc, NONE_TYPE, objType, ref list);
            (var, var)
        } else {
            let alloc = copy YILNameCallValue(w.loc, unType, YRuntimeFuncs::ALLOC_BLOCK,
                                              copy [copy YILIntValue(w.loc, YIL_UINT_MAX, objType.size)]);
            let (var, _) = ValueExpander::createVarForBlock(alias context, w.loc, NONE_TYPE, unType, ref list,
                                                            withValue-> alloc);
            (copy YILUnrefValue(w.loc, objType, var), var)
        };

        list:.append(copy YILAffect(w.loc,
                                    copy YILFieldValue(w.loc, YIL_UINT_32, object, name-> UnionKeys::TYPE),
                                    copy YILIntValue(w.loc, YIL_UINT_32, w.index)));

        list:.append(copy YILAffect(w.loc,
                                    copy YILFieldValue(w.loc, YIL_PTR_2_VOID, object, name-> UnionKeys::VTABLE),
                                    UnionValueExpander::finalizeVtable(alias context, w, member)));

        let valuesType = UnionValueExpander::innerType(objType, 2us);
        let values = copy YILFieldValue(w.loc, valuesType, object, name-> UnionKeys::VALUES);
        list:.append(copy YILAffect(w.loc,
                                    copy YILFieldValue(w.loc, UnionValueExpander::innerType(valuesType, w.index), values, w.index),
                                    member));

        return result;
    }

    /**
     * Expand the member the union is made to hold.
     *
     * A union declaring a base reads the vtable out of the member as well as
     * storing it, so the member is bound to a variable rather than evaluated
     * twice, unless it already is one.
     *
     * @params:
     *   - context: the expansion context
     *   - w:       the widening value
     *   - list:    the statement list to append instructions to
     *
     * @returns:
     *   - &YILValue: the member value
     */
    fn finalizeMember(dmut context: &Expander, w: &UnionWidenValue, ref mut list: StmtList)-> &YILValue {
        let member = ValueExpander::finalize(alias context, w.value, ref list, asLeft-> false);
        if (member of YILVar || !UnionValueExpander::unionRef(w).base.hasValue) return member;

        let (var, _) = ValueExpander::createVarForBlock(alias context, w.loc, NONE_TYPE, member.type, ref list,
                                                        withValue-> member);
        var
    }

    /**
     * Compute the vtable the union object dispatches through.
     *
     * A union declaring a base dispatches through the class vtable the member
     * carries, which is read out of the member itself so that a member
     * overriding a method of the base dispatches its own implementation. A
     * union without a base dispatches through the table synthesized for that
     * member, and a union of classes whose members agree on no method
     * dispatches nothing -- the table of a record member always holds at least
     * its typeinfo.
     *
     * @params:
     *   - context: the expansion context
     *   - w:       the widening value
     *   - member:  the expanded member value
     *
     * @returns:
     *   - &YILValue: the vtable stored in the union object
     */
    fn finalizeVtable(dmut context: &Expander, w: &UnionWidenValue, member: &YILValue)-> &YILValue {
        let ur = UnionValueExpander::unionRef(w);
        if ur.base.hasValue {
            let object = match member.type {
                p: &YILPointer => { copy YILUnrefValue(w.loc, p.inner, member) }
                _ => { panic; } // a union declaring a base is a union of classes
            };

            return copy YILFieldValue(w.loc, YIL_PTR_2_VOID, object, name-> ClassKeys::VTABLE);
        }

        if (ur.vtable.len == 0us && !w.unionType.isRecord) return YIL_NULL_VALUE;

        // the table is what makes the union reachable, nothing else names it
        let name = Mangler::mangleUnionVtable(ur, w.index);
        context:.registerTouchSym(name, ur.loc);

        copy YILAddrValue(w.loc, YIL_PTR_2_VOID, copy YILVar(w.loc, name, YIL_PTR_2_VOID, 0us))
    }

    /**
     * Finalize the test of the member a union holds.
     *
     * The union object carries the index of the member it holds, so the test
     * is an integer comparison, whichever kind of member the union lists.
     *
     * @params:
     *   - context: the expansion context
     *   - t:       the test value
     *   - list:    the statement list to append instructions to
     *
     * @returns:
     *   - &YILValue: the comparison of the index held with the one tested
     */
    pub fn finalizeTest(dmut context: &Expander, t: &UnionTestValue, ref mut list: StmtList)-> &YILValue {
        let object = UnionValueExpander::finalizeObject(alias context, t.value, asLeft-> false, ref list);

        copy YILBinaryValue(t.loc, YIL_UINT_8, BinaryOperators::DEQUAL,
                            copy YILFieldValue(t.loc, YIL_UINT_32, object, name-> UnionKeys::TYPE),
                            copy YILIntValue(t.loc, YIL_UINT_32, t.index))
    }

    /**
     * Finalize the narrowing of a union to the member it holds.
     *
     * The member is read out of the overlay, so it is the field of the union
     * object the widening wrote, and it stays an l-value.
     *
     * @params:
     *   - context: the expansion context
     *   - n:       the narrowing value
     *   - list:    the statement list to append instructions to
     *   - asLeft:  whether the narrowing is used as an l-value
     *
     * @returns:
     *   - &YILValue: the member read out of the overlay
     */
    pub fn finalizeNarrow(dmut context: &Expander, n: &UnionNarrowValue, ref mut list: StmtList, asLeft: bool)-> &YILValue {
        let object = UnionValueExpander::finalizeObject(alias context, n.value, asLeft-> asLeft, ref list);
        let valuesType = UnionValueExpander::innerType(object.type, 2us);
        let values = copy YILFieldValue(n.loc, valuesType, object, name-> UnionKeys::VALUES);

        copy YILFieldValue(n.loc, UnionValueExpander::innerType(valuesType, n.index), values, n.index)
    }

    /**
     * Finalize the reading of a union as the base it declares.
     *
     * Every member is a pointer to an object descending from the base, and the
     * overlay holds them all at the same offset, so the base pointer is the
     * first slot of the overlay read as one -- whichever member is held.
     *
     * @params:
     *   - context: the expansion context
     *   - b:       the reading value
     *   - list:    the statement list to append instructions to
     *
     * @returns:
     *   - &YILValue: the member pointer, seen as a pointer to the base
     */
    pub fn finalizeBase(dmut context: &Expander, b: &UnionBaseValue, ref mut list: StmtList)-> &YILValue {
        let object = UnionValueExpander::finalizeObject(alias context, b.value, asLeft-> false, ref list);
        let valuesType = UnionValueExpander::innerType(object.type, 2us);
        let values = copy YILFieldValue(b.loc, valuesType, object, name-> UnionKeys::VALUES);
        let member = copy YILFieldValue(b.loc, UnionValueExpander::innerType(valuesType, 0us), values, 0us);

        copy YILCastValue(b.loc, context:.finalizeType(b.type), member)
    }

    /**
     * Finalize the dynamic typeinfo access of a union.
     *
     * A union of records reads it out of the first slot of its own vtable,
     * which is the table of the member held. A union of classes reads it out
     * of the object held, which is the first slot of the overlay whichever
     * member it is, so that it is the typeinfo of its runtime class.
     *
     * @params:
     *   - context: the expansion context
     *   - ti:      the typeinfo access value
     *   - list:    the statement list to append instructions to
     *
     * @returns:
     *   - &YILValue: the typeinfo of the member held
     */
    pub fn finalizeTypeInfo(dmut context: &Expander, ti: &UnionTypeInfoAccessValue, ref mut list: StmtList)-> &YILValue {
        let typeInfoT = context:.finalizeType(ti.type);
        let object = UnionValueExpander::finalizeObject(alias context, ti.object, asLeft-> false, ref list);
        if let u: &UnionType = ti.object.type && u.isRecord {
            let vtable = copy YILFieldValue(ti.loc, YIL_PTR_2_VOID, object, name-> UnionKeys::VTABLE);
            return FieldExpander::finalizeTypeInfoIn(alias context, ti.loc, vtable, typeInfoT, ref list);
        }

        let valuesType = UnionValueExpander::innerType(object.type, 2us);
        let values = copy YILFieldValue(ti.loc, valuesType, object, name-> UnionKeys::VALUES);
        let member = copy YILFieldValue(ti.loc, UnionValueExpander::innerType(valuesType, 0us), values, 0us);

        FieldExpander::finalizeTypeInfoOf(alias context, ti.loc, member, typeInfoT, ref list)
    }

    /**
     * Expand a union value into the object it is, or the one it points to.
     *
     * @params:
     *   - context: the expansion context
     *   - value:   the union value
     *   - asLeft:  whether the object is used as an l-value
     *   - list:    the statement list to append instructions to
     *
     * @returns:
     *   - &YILValue: the three field aggregate the union is
     */
    fn finalizeObject(dmut context: &Expander, value: &Value, asLeft: bool, ref mut list: StmtList)-> &YILValue {
        let inst = ValueExpander::finalize(alias context, value, ref list, asLeft-> asLeft);
        if let u: &UnionType = value.type && u.isRecord {
            return inst;
        }

        match inst.type {
            p: &YILPointer => { copy YILUnrefValue(value.loc, p.inner, inst) }
            _ => { panic; } // a union of classes is a pointer to its object
        }
    }

    /**
     * @returns the type of the field of a YIL tuple
     */
    fn innerType(type: &YILType, index: usize)-> &YILType {
        match type {
            t: &YILTuple => { return t.inners[index]; }
            _ => { panic; } // the union object and its overlay are tuples
        }
    }

    /**
     * @returns the reference of the union the value widens into
     */
    fn unionRef(w: &UnionWidenValue)-> &UnionRefType {
        match w.unionType.sym.generator {
            r: &UnionRefType => { return r; }
            _ => { panic; } // invalid union
        }
    }
}
