in begincatch;

use ymirc::lint::node::type;

use ymirc::lexing::word;
use ymirc::utils::format;

use std::{io, conv, stream};

/**
 * Representation of a the retreival of the caught error.
 *
 * */
@final
pub class YILBeginCatch over YILValue {

    pub {
        // The name of the function making the catch
        let name: [c8];
    }

    /**
     * @params:
     *    - loc: source location of the catch
     *    - name: the name of the function performing the catch
     */
    pub self (loc: &Word, name: [c8])
        with super (loc, YIL_PTR_VOID)
        , name = name
    {}

    /**
     * Compare two nodes
     * @returns: true, iif the two nodes are strictly identical
     */
    pub over opEquals(self, o: &YILNode)-> bool {
        match o {
            s: &YILBeginCatch => {
                if (self.name != s.name) return false;
                true
            }
            _ => { false }
        }
    }

    impl Streamable;
    impl Formattable {
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(self.name, " (ephtr(0))");
        }
    }
}
