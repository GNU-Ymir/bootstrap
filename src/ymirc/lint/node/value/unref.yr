in unref;

use ymirc::lint::node::type;

use ymirc::lexing::word;
use ymirc::utils::format;

use std::{io, conv, stream};


/**
 * Address derefenrence operator.
 *
 * */
@final
pub class YILUnrefValue over YILValue {

    pub {
        // The content of the literal
        let value: &YILValue;
    }

    /**
     * @params:
     *    - loc: source location
     *    - type: the resulting type of the operation
     *    - value: the pointer value to access
     */
    pub self (loc: &Word, type: &YILType, value: &YILValue)
        with super (loc, type)
        , value = value
    {}

    /**
     * Compare two nodes
     * @returns: true, iif the two nodes are strictly identical
     */
    pub over opEquals(self, o: &YILNode)-> bool {
        match o {
            i: &YILUnrefValue => {
                if self.type != i.type { return false };
                self.value == i.value
            }
            _ => { false }
        }
    }

    impl Streamable;
    impl Formattable {
        pub over format(self, dmut stream: &Formatter) {
            stream:.write('*');
            stream:.write(self.value);
        }
    }
}
