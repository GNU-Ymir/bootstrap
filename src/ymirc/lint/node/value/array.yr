in array;

use ymirc::lint::node::type;

use ymirc::lexing::word;
use ymirc::utils::format;

use std::{io, conv, stream};

/**
 * Ymir Intermediate Language array construction.
 *
 * */
@final
pub class YILArrayValue over YILValue {

    pub {
        // The content of the literal
        let value: [&YILValue];
    }

    /**
     * @params:
     *    - loc: source location of the construction
     *    - type: the resulting type of the operation
     *    - value: the list of values being placed in the array
     */
    pub self (loc: &Word, type: &YILType, value: [&YILValue])
        with super (loc, type)
        , value = value
    {}

    /**
     * Compare two nodes
     * @returns: true, iif the two nodes are strictly identical
     */
    pub over opEquals(self, o: &YILNode)-> bool {
        match o {
            i: &YILArrayValue => {
                if self.type != i.type { return false; };
                self.value == i.value
            }
            _ => { false }
        }
    }

    impl Streamable;
    impl Formattable {
        pub over format(self, dmut stream: &Formatter) {
            stream:.write('['c8);
            for i, vi in self.value {
                if (i != 0us) stream:.write(", ");
                if (stream.tags.short && i >= 3us) {
                    stream:.write("...");
                    break;
                }
                stream:.write(vi);
            }
            stream:.write(']'c8);
        }
    }
}
