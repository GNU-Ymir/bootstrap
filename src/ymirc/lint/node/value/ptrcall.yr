in ptrcall;

use ymirc::lint::node::type;

use ymirc::lexing::word;
use ymirc::utils::format;
use std::{io, conv, stream};

/**
 * Function call by pointer.
 *
 * */
@final
pub class YILPtrCallValue over YILValue {

    pub {
        let params: [&YILValue];

        // The ptr of the function being called
        let funcPtr: &YILValue;
    }

    /**
     * @params:
     *    - loc: source location
     *    - type: the resulting type of the call
     *    - funcPtr: the address of the function to call
     *    - params: the list of parameters to pass to the function
     *
     */
    pub self (loc: &Word, type: &YILType, funcPtr: &YILValue, params: [&YILValue])
        with super (loc, type)
        , params = params
        , funcPtr = funcPtr
    {}

    /**
     * Compare two nodes
     * @returns: true, iif the two nodes are strictly identical
     */
    pub over opEquals(self, o: &YILNode)-> bool {
        match o {
            v: &YILPtrCallValue => {
                if self.funcPtr != v.funcPtr { return false; }
                if self.params != v.params { return false; }
                true
            }
            _ => { false }
        }
    }

    impl Streamable;
    impl Formattable {
        pub over format(self, dmut stream: &Formatter) {
            stream:.write("(*", self.funcPtr, ")(");
            for i, ti in self.params {
                if (i != 0us) stream:.write(", ");
                stream:.write(ti);
            }
            stream:.write(')');
        }
    }
}
