in var;

use ymirc::lint::node::type;

use ymirc::lexing::word;
use ymirc::utils::format;
use std::{io, conv, stream};

/**
 * A variable reference.
 *
 * */
@final
pub class YILVar over YILValue {

    pub {
        // The name of the vardecl
        let name: [c8];

        let isTemp: bool;

        // The uniq id used to refer to the variable
        let id: usize;

        // True if the var is thread local
        let isThreadLocal: bool;
    }

    /**
     * @params:
     *    - loc: source location
     *    - name: the name of the variable (for debug purpose)
     *    - type: the type of the variable
     *    - varId: the uniq id (to actually reference it)
     *    - isTemp: true iff the variable is created by the compiler
     *    - isThreadLocal: true iff referencing a global variable that is thread local
     *
     */
    pub self (loc:           &Word,
              name:          [c8],
              type:          &YILType,
              varId:         usize,
              isTemp:        bool = false,
              isThreadLocal: bool = false)
        with super (loc, type)
        , name = name
        , id = varId
        , isThreadLocal = isThreadLocal
        , isTemp = isTemp
    {}

    /**
     * Compare two nodes
     * @returns: true, iif the two nodes are strictly identical
     */
    pub over opEquals(self, o: &YILNode)-> bool {
        match o {
            v: &YILVar => {
                self.id == v.id
            }
            _ => { false }
        }
    }

    impl Streamable;
    impl Formattable {
        pub over format(self, dmut stream: &Formatter) {
            if (self.isTemp && self.id != 0us) {
                let id = stream:.getYilId(self.id);
                stream:.write("YI_", id);
            } else {
                stream:.write(self.name);
                if (self.isThreadLocal) stream:.write("@tl");
                if (stream.tags.withVarIds && self.id != 0us) {
                    stream:.write("(#", self.id.to!{[c8], 36us} (), ')');
                }
            }
        }
    }
}
