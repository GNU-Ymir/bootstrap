in field;

use ymirc::lint::node::{type, value::unref};

use ymirc::lexing::word;
use ymirc::lexing::keys;
use ymirc::utils::format;

use std::{io, conv, stream};

/**
 * Tuple field access
 * */
@final
pub class YILFieldValue over YILValue {

    pub {
        let tuple: &YILValue;

        let index: usize;

        let name: [c8];
    }

    /**
     * Construct a tuple access by index
     *
     * @params:
     *   - loc: source location of the operation
     *   - type: the resulting type of the operation
     *   - tuple: the tuple being accessed
     *   - index: the index of the field to access
     *
     */
    pub self (loc: &Word, type: &YILType, tuple: &YILValue, index: usize)
        with super (loc, type)
        , tuple = tuple
        , index = index
        , name = ""
    {}

    /**
     * Construct a tuple access by name
     *
     * @params:
     *   - loc: source location of the operation
     *   - type: the resulting type of the operation
     *   - tuple: the tuple being accessed
     *   - name: the name of the field to the access
     *
     */
    pub self (loc: &Word, type: &YILType, tuple: &YILValue, name: [c8])
        with super (loc, type)
        , tuple = tuple
        , index = 0
        , name = name
    {}


    /**
     * Compare two nodes
     * @returns: true, iif the two nodes are strictly identical
     */
    pub over opEquals(self, o: &YILNode)-> bool {
        match o {
            v: &YILFieldValue => {
                if self.tuple != v.tuple { return false; }
                if self.name != v.name { return false; }
                if self.index != v.index { return false; }
                true
            }
            _ => { false }
        }
    }

    impl Streamable;
    impl Formattable {
        pub over format(self, dmut stream: &Formatter) {
            match self.tuple {
                p: &YILUnrefValue => { stream:.write(p.value, "-> "); }
                o: _ => { stream:.write(o, "."); }
            }

            if (self.name.len != 0us) stream:.write(self.name);
            else stream:.write('_', self.index);
        }
    }
}
