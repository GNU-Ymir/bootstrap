in access;

use ymirc::lint::node::type;

use ymirc::lexing::word;
use ymirc::utils::format;

use std::{conv, io, stream};

/**
 * Ymir Intermediate Language index operator.
 *
 * */
@final
pub class YILArrayAccessValue over YILValue {

    pub {
        // The content of the literal
        let value: &YILValue;

        // THe index of the access
        let index: &YILValue;
    }

    /**
     * @params:
     *    - loc: source location of the access
     *    - type: the result type of the operation
     *    - value: the value being indexed
     *    - index: the index of the operation
     */
    pub self (loc:   &Word,
              type:  &YILType,
              value: &YILValue,
              index: &YILValue)
        with super (loc, type)
        , value = value
        , index = index
    {}

    /**
     * Compare two nodes
     * @returns: true, iif the two nodes are strictly identical
     */
    pub over opEquals(self, o: &YILNode)-> bool {
        match o {
            i: &YILArrayAccessValue => {
                if self.type != i.type { return false; };
                if self.value != i.value { return false; }
                self.index == i.index
            }
            _ => { false }
        }
    }

    impl Streamable;
    impl Formattable {
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(self.value, '['c8, self.index, ']'c8);
        }
    }
}
