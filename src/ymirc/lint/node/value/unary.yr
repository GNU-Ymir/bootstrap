in unary;

use ymirc::lint::node::type;

use ymirc::lexing::word;
use ymirc::lexing::keys;
use ymirc::utils::format;

use std::{io, conv, stream};

/**
 * Unary operator
 *
 * */
@final
pub class YILUnaryValue over YILValue {

    pub {
        let left: &YILValue;

        // The name of the function being called
        let op: UnaryOperators;
    }

    /**
     * @params:
     *    - loc: source location of the operator
     *    - type: resulting type of the operation
     *    - op: the operator to apply
     *    - left: the operand
     */
    pub self (loc: &Word, type: &YILType, op: UnaryOperators, left: &YILValue)
        with super (loc, type)
        , op = op
        , left = left
    {}

    /**
     * Compare two nodes
     * @returns: true, iif the two nodes are strictly identical
     */
    pub over opEquals(self, o: &YILNode)-> bool {
        match o {
            v: &YILUnaryValue => {
                if self.op != v.op { return false; }
                if self.left != v.left { return false; }
                true
            }
            _ => { false }
        }
    }

    impl Streamable;
    impl Formattable {
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(self.op, ' ', self.left);
        }
    }
}
