in value;

use ymirc::lint::node::type;
use ymirc::lexing::word;
use std::stream;

use ymirc::lint::node::value::_;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

mod ::access;
mod ::addr;
mod ::array;
mod ::begincatch;
mod ::binary;
mod ::cast_;
mod ::field;
mod ::float;
mod ::int;
mod ::namecall;
mod ::ptrcall;
mod ::string;
mod ::tuple;
mod ::unary;
mod ::unit;
mod ::unref;
mod ::var;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBTYPES          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub def YILArrayAccessValue: access::YILArrayAccessValue;
pub def YILAddrValue: addr::YILAddrValue;
pub def YILArrayValue: array::YILArrayValue;
pub def YILBeginCatch: begincatch::YILBeginCatch;
pub def YILBinaryValue: binary::YILBinaryValue;
pub def YILCastValue: cast_::YILCastValue;
pub def YILFieldValue: field::YILFieldValue;
pub def YILFloatValue: float::YILFloatValue;
pub def YILIntValue: int::YILIntValue;
pub def YILNameCallValue: namecall::YILNameCallValue;
pub def YILPtrCallValue: ptrcall::YILPtrCallValue;
pub def YILStringValue: string::YILStringValue;
pub def YILTupleValue: tuple::YILTupleValue;
pub def YILUnaryValue: unary::YILUnaryValue;
pub def YILUnit: unit::YILUnit;
pub def YILUnrefValue: unref::YILUnrefValue;
pub def YILVar: var::YILVar;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =================================          NATIVE VALUES          ==================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub lazy YIL_NULL_VALUE = copy YILIntValue(EOF_WORD,
                                           YIL_UINT_MAX,
                                           0us);

pub lazy YIL_UNIT_VALUE = copy YILUnit(EOF_WORD, YIL_VOID);

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          ROOT          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */


/**
 * Abstract base class for all YIL value nodes.
 *
 * A YILValue represents any computed or literal value in the Ymir
 * Intermediate Language.
 *
 */
@abstract
pub class YILValue over YILNode {
    pub {
        let type: &YILType;
    }

    pub self (loc: &Word, type: &YILType)
        with super (loc)
        , type = type
    {}
}
