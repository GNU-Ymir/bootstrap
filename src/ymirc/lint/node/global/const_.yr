in const_;

use ymirc::lint::node::{value, type};

use ymirc::lexing::word;
use ymirc::utils::format;
use std::{stream, fs::path};

/**
 * Final class representing a global constant in the Ymir Intermediate
 * Language.
 *
 */
@final
pub class YILConstant over YILSymbol {

    pub {
        // The value of the constant
        let value: &YILValue;
        
        // True if the symbol is a local symbol
        let isLocal: bool;
    }

    /**     
     * @params:
     *   - loc:     source location of the constant
     *   - name:    constant name
     *   - value:   static YILValue associated with the constant
     *   - refs:    list of referenced symbols (name -> Path)
     *   - isWeak:  true iff the constant is a weak symbol (default: false)
     *   - isLocal: true iff the constant is local to the module (default: false)
     *
     */
    pub self (loc:     &Word,
              name:    [c8],
              value:   &YILValue,
              refs:    [[c8] => Path],
              isWeak:  bool = false,
              isLocal: bool = false)
        with super (loc, loc, name, isWeak, refs)
        , value = value
        , isLocal = isLocal
    {}

    pub over opEquals(self, o: &YILNode)-> bool {
        match o {
            c: &YILConstant => {
                if self.name != c.name { return false; }
                if self.value != c.value { return false; }
                if self.isWeak != c.isWeak { return false; }

                return true;
            }
        }

        return false;
    }

    impl Streamable;
    impl Formattable {
        pub over format(self, dmut stream: &Formatter) {
            stream:.write("const: ");
            if (self.isLocal || self.isWeak) {
                stream:.write("[");
                if (self.isWeak) {
                    stream:.write("weak");
                    if (self.isLocal) stream:.write(",");
                }
                if (self.isLocal) { stream:.write("local"); }
                stream:.write("]");
            }

            stream:.write(' ', self.name, ' ');
            self.value.format(alias stream);
        }
    }
}
