in globvar;

use ymirc::lint::node::value;
use ymirc::lexing::word;
use ymirc::utils::format;
use std::{stream, fs::path};

/**
 * Final class representing a global variable in the Ymir Intermediate
 * Language.
 *
 */
@final
pub class YILGlobalVar over YILSymbol {

    pub {
        // The value of the constant
        let value: &YILValue;

        // True iif the global var is local
        let isThreadLocal: bool;
    }

    /**     
     * @params:
     *   - loc:           source location of the global variable
     *   - name:          variable name
     *   - value:         static YILValue associated with the variable
     *   - refs:          list of referenced symbols (name -> Path)
     *   - isWeak:        true iff the variable is a weak symbol (default: false)
     *   - isThreadLocal: true iff the variable is thread-local (default: false)
     *
     */
    pub self (loc:           &Word,
              name:          [c8],
              value:         &YILValue,
              refs:          [[c8] => Path],
              isWeak:        bool = false,
              isThreadLocal: bool = false)
        with super (loc, loc, name, isWeak, refs)
        , value = value
        , isThreadLocal = isThreadLocal
    {}

    pub over opEquals(self, o: &YILNode)-> bool {
        match o {
            c: &YILGlobalVar => {
                if self.name != c.name { return false; }
                if self.value != c.value { return false; }
                if self.isWeak != c.isWeak { return false; }
                if self.isThreadLocal != c.isThreadLocal { return false; }

                return true;
            }
        }

        false
    }

    impl Streamable;
    impl Formattable {
        pub over format(self, dmut stream: &Formatter) {
            stream:.write("var: ");
            if (self.isWeak) {
                stream:.write("[weak]");
            }

            stream:.write(' ', self.name);
            if (self.isThreadLocal) stream:.write("@tl");

            stream:.write(' ');
            self.value.format(alias stream);
        }
    }
}
