in float;

use ymirc::lexing::word;
use ymirc::utils::format;
use std::{io, conv, stream};

use ymirc::global::state;

/**
 * A Ymir Intermediate Language float type.
 *
 * */
@final
pub class YILFloat over YILType {

    prv {
        // The size of the float in bits
        let _size: u32;
    }

    /**
     * @params:
     *    - size: in bits
     */
    pub self (size: u32)
        with _size = size
    {}

    /**
     * @returns: the code size of the type(size before conversion to arch size)
     * */
    @field
    pub fn codeSize(self)-> u32 {
        self._size
    }

    @field
    pub over size(self)-> u32 {
        if (self._size == 0u32) {
            state::floatArchSize() / 8u32
        } else {
            self._size / 8u32
        }
    }

    @field
    pub over align(self)-> u32 {
        if self._size == 0u32 {
            state::floatArchSize() / 8u32
        } else {
            self._size / 8u32
        }
    }

    /**
     * Compare two nodes
     * @returns: true, iif the two nodes are strictly identical
     */
    pub over opEquals(self, o: &YILNode)-> bool {
        match o {
            f: &YILFloat => {
                self._size == f._size
            }
            _ => { false }
        }
    }

    impl Hashable;
    impl Streamable;
    impl Formattable {
        pub over format(self, dmut stream: &Formatter) {
            stream:.write("f", self.size * 8u32);
        }
    }
}
