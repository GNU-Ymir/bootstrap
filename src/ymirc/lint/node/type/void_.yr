in void_;

use ymirc::lexing::word;
use ymirc::utils::format;
use std::{conv, io, stream};

/**
 * A Ymir Intermediate Language void type.
 * 
 * */
@final
pub class YILVoid over YILType {

    pub self () {}

    @field
    pub over size(self)-> u32 {
        return 1u32;
    }

    @field
    pub over align(self)-> u32 {
        return 1u32;
    }

    /**
     * Compare two nodes
     * @returns: true, iif the two nodes are strictly identical
     */
    pub over opEquals(self, o: &YILNode)-> bool {
        match o {
            YILVoid() => { true }
            _ => { false }
        }
    }

    impl Hashable;
    impl Streamable;
    impl Formattable {
        pub over format(self, dmut stream: &Formatter) {
            stream:.write("void");
        }
    }
}
