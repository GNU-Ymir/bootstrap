in int;

use ymirc::lexing::word;
use ymirc::utils::format;
use std::{io, conv, stream};

use ymirc::global::state;

/**
 * A Ymir Intermediate Language int type.
 * 
 * */
@final
pub class YILInt over YILType {

    prv {
        // The size of the int in bit
        let _size: u32;
    }

    pub {
        // True if the type is signed
        let signed: bool;
    }

    /**
     * @params:
     *    - signed: true iff the type can represent negative values
     *    - size: the size in bits
     */
    pub self (signed: bool, size: u32)
        with _size = size
        , signed = signed
    {}

    /**
     * @returns: the code size of the int(before conversion to arch size)
     * */
    @field
    pub fn codeSize(self)-> u32 {
        self._size
    }

    @field
    pub over size(self)-> u32 {
        if (self._size == 0u32) {
            state::pointerArchSize() / 8u32
        } else {
            self._size / 8u32
        }
    }

    @field
    pub over align(self)-> u32 {
        if self._size == 0u32 {
            state::pointerArchSize() / 8u32
        } else {
            self._size / 8u32
        }
    }

    /**
     * Compare two nodes
     * @returns: true, iif the two nodes are strictly identical
     */
    pub over opEquals(self, o: &YILNode)-> bool {
        match o {
            i: &YILInt => {
                self._size == i._size && self.signed == i.signed
            }
            _ => { false }
        }
    }

    impl Hashable;
    impl Streamable;
    impl Formattable {
        pub over format(self, dmut stream: &Formatter) {
            if (self.signed) {
                stream:.write("i", self.size * 8u32);
            } else {
                stream:.write("u", self.size * 8u32);
            }
        }
    }
}
