in tuple;

use ymirc::lexing::word;
use ymirc::utils::format;
use std::{io, conv, stream};

lazy dmut __TUPLE_CHECKER__: [*void => ()] = copy [];

fn toAddr(tu: &YILTuple)-> *void {
    unsafe {
        let addr: *(*void) = cast!{*(*void)} (&tu);
        *addr
    }
}

/**
 * A Ymir Intermediate Language tuple type.
 *
 * */
@final
pub class YILTuple over YILType {

    pub {
        // The type inside the pointer
        let mut inners: [&YILType];

        // The name of the fiels(@warning: .len <= _inners.len)
        let mut fieldNames: [[c8]];

        // When the tuple is created from empty(so its uid overrides every other checks)
        let mut prepared: bool = false;

        // True if the type is an union type
        let isUnion: bool;

        // True if the type is packed
        let isPacked: bool;
    }

    /**
     * @params:
     *    - inners: the list of types contained in the tuple
     *    - uid: the uniq id of the tuple
     *    - fieldNames: the name of the fields
     *    - isUnion: if all fields are overlaid
     *    - isPacked: if all fields are aligned with 1(!isUnion)
     *    - prepared: true iff the uid is just used to prepare the tuple and will be reused once all fields are set
     *
     * @notes:
     *    1. The length of fieldNames can be lower than the number of inner
     *    types. In which case only the first fields are named, others are
     *    accessed by index.
     *
     *    2. prepared is used in comparison and hash, to define that the tuple
     *    cannot be compared against similar tuple, and that only address or uid
     *    prevail. It's used for serialization/deserialization.
     *
     */
    pub self (inners:     [&YILType],
              uid:        usize,
              fieldNames: [[c8]] = [],
              isUnion:    bool = false,
              isPacked:   bool = false,
              prepared:   bool = false)
        with super (uid-> uid)
        , inners = inners
        , fieldNames = fieldNames
        , isUnion = isUnion
        , isPacked = isPacked
        , prepared = prepared
    {}

    /**
     * Create a tuple with not fields
     * @notes:
     *   self.prepared is true
     */
    pub self empty(isUnion: bool = false, isPacked: bool = false, uid: usize)
        with super (uid-> uid)
        , inners = []
        , fieldNames = []
        , isUnion = isUnion
        , isPacked = isPacked
        , prepared = true
    {}

    @field
    pub over size(self)-> u32 {
        if (self.isUnion) return self.getSizeUnion();
        if (self.isPacked) return self.getSizePacked();

        let mut current = 0u32;
        let mut glob = 0u32;
        let mut globAlign = 1u32;

        for inner in self.inners {
            let innerSize = inner.size;
            let align = inner.align;

            if (align > globAlign) {
                globAlign = align;
            }

            let padding = (align - (current % align)) % align;
            let aligned = (current + padding);

            current = aligned + innerSize;
            glob += padding + innerSize;
        }

        if (glob % globAlign != 0u32) {
            glob = glob + (globAlign - (glob % globAlign));
        }

        return glob;
    }

    @field
    pub over align(self)-> u32 {
        if (self.isPacked) { return 1u32; };

        let mut max = 1u32;
        for i in self.inners {
            let align = i.align;
            if (align > max) {
                max = align;
            }
        }

        return max;
    }

    prv fn getSizeUnion(self)-> u32 {
        let mut max = 1u32;
        for i in self.inners {
            let size = i.size;
            if (size > max) {
                max = size;
            }
        }

        return max;
    }

    prv fn getSizePacked(self)-> u32 {
        let mut all = 0u32;
        for i in self.inners {
            all += i.size;
        }

        if (all == 0u32) {
            return 1u32;
        }

        return all;
    }

    /**
     * Compare two nodes
     * @returns: true, iif the two nodes are strictly identical
     */
    pub over opEquals(self, o: &YILNode)-> bool {
        match o {
            v: &YILTuple => {
                if self is v { return true; }
                if self.prepared { return false; }


                if self.isUnion != v.isUnion { return false; }
                if self.isPacked != v.isPacked { return false; }

                let addrS = toAddr(self);
                let addrO = toAddr(v);

                let sIn = (addrS in __TUPLE_CHECKER__);
                let oIn = (addrO in __TUPLE_CHECKER__);

                if sIn && oIn { return true; }

                __TUPLE_CHECKER__[addrS] = ();
                __TUPLE_CHECKER__[addrO] = ();

                {
                    if self.fieldNames != v.fieldNames { return false; }
                    if self.inners != v.inners { return false; }
                } exit {
                    __TUPLE_CHECKER__:.remove(addrS);
                    __TUPLE_CHECKER__:.remove(addrO);
                }

                true
            }
            _ => { false }
        }
    }

    impl Hashable {
        pub over toHash(self)-> u64 {
            if self.prepared {
                cast!u64(self.uid)
            } else {
                core::types::hash::__hash((self._typeinfo.name, self.fieldNames, self.isPacked, self.isUnion))
            }
        }
    }

    impl Streamable;
    impl Formattable {
        pub over format(self, dmut stream: &Formatter) {
            if stream.tags.withParams {
                stream:.write("tuple T_", self.uid);
                let sIn = toAddr(self);

                if sIn !in __TUPLE_CHECKER__ {
                    __TUPLE_CHECKER__[sIn] = ();
                    {
                        stream:.write(" (");
                        if (self.isUnion) stream:.write("@union");
                        else if (self.isPacked) stream:.write("@packed");

                        for i, ti in self.inners {
                            if (i != 0us || self.isUnion || self.isPacked) stream:.write(", ");
                            if (self.fieldNames.len > i) {
                                stream:.write(self.fieldNames[i], "-> ");
                            }
                            stream:.write(format("%", ti)); // do not print parameters of inner types
                        }

                        stream:.write(')');
                    } exit {
                        __TUPLE_CHECKER__:.remove(sIn);
                    }
                } else stream:.write("...");
            }  else {
                stream:.write("T_", self.uid);
            }
        }
    }
}
