in pointer;

use ymirc::lint::node::type::void_;

use ymirc::lexing::word;
use ymirc::utils::format;
use std::{io, conv, stream};

use ymirc::global::state;

/**
 * A Ymir Intermediate Language pointer type.
 *
 * */
@final
pub class YILPointer over YILType {

    pub {
        // The type inside the pointer
        let mut inner: &YILType;
    }

    /**
     * @params:
     *    - inner: the inner type of the pointer
     *    - uid: the uniq id of the type
     */
    pub self (inner: &YILType, uid: usize = 0us)
        with super (uid-> uid)
        , inner = inner
    {}

    /**
     * @returns: the size in bytes of the type
     * */
    @field
    pub over size(self)-> u32 {
        state::pointerArchSize() / 8u32
    }

    @field
    pub over align(self)-> u32 {
        state::pointerArchSize() / 8u32
    }

    /**
     * Compare two nodes
     * @returns: true, iif the two nodes are strictly identical
     */
    pub over opEquals(self, o: &YILNode)-> bool {
        match o {
            v: &YILPointer => {
                self.inner == v.inner
            }
            _ => { false }
        }
    }

    impl Hashable {
        pub over toHash(self)-> u64 {
            core::types::hash::__hash((self._typeinfo.name, self.inner))
        }
    }

    impl Streamable;
    impl Formattable {
        pub over format(self, dmut stream: &Formatter) {
            if stream.tags.withParams {
                stream:.write("pointer P_", self.uid);
                // Don't print parameters of inner type
                stream:.write(" *(", format("%", self.inner), ')');
            } else {
                stream:.write("P_", self.uid);
            }
        }
    }
}
