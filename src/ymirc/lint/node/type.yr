in type;


use ymirc::lexing::word;
use ymirc::utils::format;
use std::stream;

use ymirc::lint::node::type::_;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

mod ::array;
mod ::float;
mod ::int;
mod ::pointer;
mod ::tuple;
mod ::void_;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBTYPES          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub def YILArray: array::YILArray;
pub def YILFloat: float::YILFloat;
pub def YILInt: int::YILInt;
pub def YILPointer: pointer::YILPointer;
pub def YILTuple: tuple::YILTuple;
pub def YILVoid: void_::YILVoid;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ==================================          NATIVE TYPES          ==================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub lazy YIL_FLOAT_32  = copy YILFloat(32u32);
pub lazy YIL_FLOAT_64  = copy YILFloat(64u32);
pub lazy YIL_FLOAT_80  = copy YILFloat(80u32);
pub lazy YIL_FLOAT_MAX = copy YILFloat(0u32);

pub lazy YIL_SINT_8  = copy YILInt(true, 8u32);
pub lazy YIL_SINT_16 = copy YILInt(true, 16u32);
pub lazy YIL_SINT_32 = copy YILInt(true, 32u32);
pub lazy YIL_SINT_64 = copy YILInt(true, 64u32);

pub lazy YIL_UINT_8  = copy YILInt(false, 8u32);
pub lazy YIL_UINT_16 = copy YILInt(false, 16u32);
pub lazy YIL_UINT_32 = copy YILInt(false, 32u32);
pub lazy YIL_UINT_64 = copy YILInt(false, 64u32);

pub lazy YIL_UINT_MAX = copy YILInt(false, 0u32);
pub lazy YIL_SINT_MAX = copy YILInt(true, 0u32);

pub lazy YIL_PTR_VOID = copy YILPointer(YIL_VOID, uid-> 1us);
pub lazy YIL_PTR_2_VOID = copy YILPointer(YIL_PTR_VOID, uid-> 2us);

pub lazy YIL_VOID = copy YILVoid();

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          ROOT          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * Abstract base class for all YIL type nodes.
 *
 * A YILType represents any type in the Ymir Intermediate Language.
 *
 * Each YILType stores a unique identifier (`uid`) and exposes size and
 * alignment information through abstract fields.
 */
@abstract
pub class YILType over YILNode {

    pub {
        // The uniq id of the type
        let mut uid: usize;
    }

    pub self (uid: usize = 0us)
    // Types don't really have a location
        with super (EOF_WORD)
        , uid = uid
    {}

    /**
     * Return the size of the type in bytes.
     *
     * Concrete YIL types must implement this field to provide their size.
     *
     * @returns:
     *   - u32: size of the type in bytes
     */
    @field
    pub fn size(self)-> u32;

    /**
     * Return the alignment of the type in bytes.
     *
     * Concrete YIL types must implement this field to provide their alignment.
     *
     * @returns:
     *   - u32: alignment of the type in bytes
     */
    @field
    pub fn align(self)-> u32;

    impl Hashable;
}
