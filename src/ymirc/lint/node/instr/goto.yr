in goto;

use ymirc::lint::node::instr::label;

use ymirc::lexing::word;
use ymirc::utils::format;
use std::stream;

/**
 * Final class representing an unconditional jump instruction in the Ymir
 * Intermediate Language.
 *
 */
@final
pub class YILGoto over YILInstr {

    pub {
        // The label to goto
        let label: &YILLabel;
    }

    /**
     * @params:
     *   - loc:   source location of the goto instruction
     *   - label: label to jump
     */
    pub self (loc: &Word, label: &YILLabel)
        with super (loc)
        , label = label
    {}

    pub over opEquals(self, o: &YILNode)-> bool {
        match o {
            v: &YILGoto => {
                self.label == v.label
            }
            _ => { false }
        }
    }

    impl Streamable;
    impl Formattable {
        pub over format(self, dmut stream: &Formatter) {
            stream:.detabing();
            stream:.write("#GOTO ", self.label.name);
            stream:.write("(#", std::conv::to!{[c8], 36} (self.label.id), ')');
            stream:.entabing();
        }
    }
}
