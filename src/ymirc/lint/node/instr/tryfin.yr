in tryfin;

use ymirc::lint::node::instr::vardecl;

use ymirc::lexing::word;
use ymirc::utils::format;
use std::stream;

/**
 * Final class representing a try/finally instruction in Ymir Intermediate
 * Language.
 *
 * */
@final
pub class YILTryFinally over YILInstr {

    pub {
        // List of instruction to execute inside the try
        let tryPart: [&YILInstr];

        // List of instruction to execute when exiting
        let finPart: [&YILInstr];
    }

    /**
     * @params:
     *    - loc: source location of the instruction
     *    - tryPart: list of instructions in the try part
     *    - finPart: list of instructions in the finally part
     */
    pub self (loc: &Word, tryPart: [&YILInstr], finPart: [&YILInstr])
        with super (loc)
        , tryPart = tryPart
        , finPart = finPart
    {}

    pub over opEquals(self, o: &YILNode)-> bool {
        match o {
            v: &YILTryFinally => {
                if self.tryPart != v.tryPart return false;
                if self.finPart != v.finPart return false;
                true
            }
            _ => { false }
        }
    }

    impl Streamable;
    impl Formattable {
        pub over format(self, dmut stream: &Formatter) {
            stream:.write("try {\n");
            stream:.entabing();
            for i in self.tryPart match i {
                YILVarDecl() => {
                    if stream.tags.withVars {
                        stream:.write(i, ";\n");
                    }
                }
                _ => {
                    stream:.write(i, ";\n");
                }
            }

            stream:.detabing();
            stream:.write("}\nfinally{\n");
            stream:.entabing();
            for i in self.finPart match i {
                YILVarDecl() => {
                    if stream.tags.withVars {
                        stream:.write(i, ";\n");
                    }
                }
                _ => {
                    stream:.write(i, ";\n");
                }
            }

            stream:.detabing();
            stream:.write("}");
        }
    }
}
