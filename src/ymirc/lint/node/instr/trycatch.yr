in trycatch;

use ymirc::lint::node::{instr::vardecl, type};

use ymirc::lexing::word;
use ymirc::utils::format;
use std::stream;


/**
 * Final class representing a try/catch block in Ymir Intermediate Language.
 *
 * */
@final
pub class YILTryCatch over YILInstr {

    pub {
        // The type of the catcher var
        let catchType: &YILType;

        // List of instruction to execute inside the try
        let tryPart: [&YILInstr];

        // List of instruction to execute when exiting
        let catchPart: [&YILInstr];
    }

    /**
     * @params:
     *    - loc: source location of the instruction
     *    - catchType: the type of the variable that receives the caught error
     *    - tryPart: the list of instructions in the try block
     *    - catchPart: the list of instructions in the catch block
     */
    pub self (loc: &Word, catchType: &YILType, tryPart: [&YILInstr], catchPart: [&YILInstr])
        with super (loc)
        , catchType = catchType
        , tryPart = tryPart
        , catchPart = catchPart
    {}

    pub over opEquals(self, o: &YILNode)-> bool {
        match o {
            v: &YILTryCatch => {
                if self.tryPart != v.tryPart return false;
                if self.catchPart != v.catchPart return false;
                if self.catchType != v.catchType return false;
                true
            }
            _ => { false }
        }
    }

    impl Streamable;
    impl Formattable {
        pub over format(self, dmut stream: &Formatter) {
            stream:.write("try {\n");
            stream:.entabing();
            for i in self.tryPart match i {
                YILVarDecl() => {
                    if stream.tags.withVars {
                        stream:.write(i, ";\n");
                    }
                }
                _ => {
                    stream:.write(i, ";\n");
                }
            }

            stream:.detabing();
            stream:.write("}\ncatch{\n");
            stream:.entabing();
            for i in self.catchPart match i {
                YILVarDecl() => {
                    if stream.tags.withVars {
                        stream:.write(i, ";\n");
                    }
                }
                _ => {
                    stream:.write(i, ";\n");
                }
            }
            stream:.detabing();
            stream:.write("}");
        }
    }
}
