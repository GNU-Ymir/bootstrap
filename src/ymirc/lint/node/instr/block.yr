in block;

use ymirc::lint::node::instr::vardecl;

use ymirc::lexing::word;
use ymirc::utils::format;
use std::stream;

/**
 * Final class representing a block of instructions in the Ymir Intermediate
 * Language.
 *
 */
@final
pub class YILBlock over YILInstr {

    pub {
        let instrs: [&YILInstr];
    }

    /**
     * @params:
     *   - loc:    source location of the block
     *   - instrs: ordered list of instructions in the block
     *
     */
    pub self (loc: &Word, instrs: [&YILInstr])
        with super (loc)
        , instrs = instrs
    {}

    pub over opEquals(self, o: &YILNode)-> bool {
        match o {
            v: &YILBlock => {
                self.instrs == v.instrs
            }
            _ => { false }
        }
    }

    impl Streamable;
    impl Formattable {
        pub over format(self, dmut stream: &Formatter) {
            stream:.write("{\n");
            stream:.entabing();
            for i in self.instrs match i {
                YILVarDecl() => {
                    if stream.tags.withVars {
                        stream:.write(i, ";\n");
                    }
                }
                _ => {
                    stream:.write(i, ";\n");
                }
            }
            stream:.detabing();
            stream:.write("}");
        }
    }
}
