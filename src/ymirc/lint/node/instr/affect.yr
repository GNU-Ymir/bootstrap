in affect;

use ymirc::lint::node::value;

use ymirc::lexing::word;
use ymirc::utils::format;
use std::stream;

/**
 * Final class representing an assignment instruction in the Ymir
 * Intermediate Language.
 *
 */
@final
pub class YILAffect over YILInstr {

    pub {
        // The left operand
        let left: &YILValue;

        // The right operand
        let right: &YILValue;
    }

    /**
     * @params:
     *   - loc:   source location of the assignment
     *   - left:  left-hand side value
     *   - right: right-hand side value
     *
     */    
    pub self (loc: &Word, left: &YILValue, right: &YILValue)
        with super (loc)
        , left = left
        , right = right
    {}

    pub over opEquals(self, o: &YILNode)-> bool {
        match o {
            v: &YILAffect => {
                if self.left != v.left return false;
                if self.right != v.right return false;
                true
            }
            _ => { false }
        }
    }

    impl Streamable;
    impl Formattable {
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(self.left, " = ", self.right);
        }
    }
}
