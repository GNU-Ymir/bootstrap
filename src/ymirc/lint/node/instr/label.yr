in label;

use ymirc::lexing::word;
use ymirc::utils::format;
use std::stream;

/**
 * Final class representing a label instruction in the Ymir Intermediate
 * Language.
 *
 */
@final
pub class YILLabel over YILInstr {

    pub {
        // The name of the label
        let name: [c8];

        // The uniq id used to refer to the variable
        let id: usize;
    }

    /**    
     * @params:
     *   - loc:     source location of the label
     *   - name:    label name
     *   - labelId: unique identifier used for referencing the
     *
     */
    pub self (loc: &Word, name: [c8], labelId: usize)
        with super (loc)
        , name = name
        , id = labelId
    {}
    
    pub over opEquals(self, o: &YILNode)-> bool {
        match o {
            v: &YILLabel => {
                self.id == v.id
            }
            _ => { false }
        }
    }

    impl Streamable;
    impl Formattable {
        pub over format(self, dmut stream: &Formatter) {
            stream:.detabing();
            stream:.write("#LABEL ", self.name);
            stream:.write("(#", std::conv::to!{[c8], 36} (self.id), ')');
            stream:.entabing();
        }
    }
}
