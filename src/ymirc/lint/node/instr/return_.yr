in return_;

use ymirc::lint::node::value;

use ymirc::lexing::word;
use ymirc::utils::format;
use std::stream;

/**
 * Final class representing a return instruction in the Ymir Intermediate
 * Language.
 *
 * */
@final
pub class YILReturn over YILInstr {

    pub {
        // The left operand
        let value: &YILValue;
    }

    /**
     * @params:
     *     - loc: source location of the instruction
     *     - value: returned value
     */
    pub self (loc: &Word, value: &YILValue)
        with super (loc)
        , value = value
    {}

    pub over opEquals(self, o: &YILNode)-> bool {
        match o {
            v: &YILReturn => {
                self.value == v.value
            }
            _ => { false }
        }
    }

    impl Streamable;
    impl Formattable {
        pub over format(self, dmut stream: &Formatter) {
            stream:.write("return ", self.value);
        }
    }
}
