in call;

use ymirc::lint::node::value;

use ymirc::lexing::word;
use ymirc::utils::format;
use std::stream;

/**
 * A Ymir Intermediate Language Call
 * */

/**
 * Final class representing a call instruction in the Ymir Intermediate
 * Language.
 *
 */
@final
pub class YILCall over YILInstr {

    pub {
        // The left operand
        let content: &YILValue;
    }

    /**
     * @params:
     *   - loc:     source location of the call
     *   - content: the value being invoked
     *
     */
    pub self (loc: &Word, content: &YILValue)
        with super (loc)
        , content = content
    {}

    pub over opEquals(self, o: &YILNode)-> bool {
        match o {
            v: &YILCall => {
                if self.content != v.content return false;
                true
            }
            _ => { false }
        }
    }

    impl Streamable;
    impl Formattable {
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(self.content);
        }
    }
}
