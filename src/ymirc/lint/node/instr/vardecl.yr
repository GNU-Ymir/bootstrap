in vardecl;

use ymirc::lint::node::type;

use ymirc::lexing::word;
use ymirc::utils::format;
use std::stream;

/**
 * Final class representing a Variable Declaration in Ymir Intermediate
 * Language.
 *
 * */
@final
pub class YILVarDecl over YILInstr {

    pub {
        // The name of the vardecl
        let name: [c8];

        // The uniq id used to refer to the variable
        let id: usize;

        // The type of the variable
        let type: &YILType;

        let isTemp: bool;
    }

    /**
     * @params:
     *    - loc: source location of the instruction
     *    - name: name of the variable
     *    - type: type of the variable
     *    - varId: uniq id used to reference the variable
     *    - isTemp: true iff created by the intermediate language expansion, and not by the user
     */
    pub self (loc: &Word, name: [c8], type: &YILType, varId: usize, isTemp: bool = false)
        with super (loc)
        , name = name
        , id = varId
        , type = type
        , isTemp = isTemp
    {}

    pub over opEquals(self, o: &YILNode)-> bool {
        match o {
            v: &YILVarDecl => {
                self.id == v.id
            }
            _ => { false }
        }
    }

    impl Streamable;
    impl Formattable {
        pub over format(self, dmut stream: &Formatter) {
            if (self.isTemp && self.id != 0us) {
                let id = stream:.getYilId(self.id);
                stream:.write("let YI_", id);
                stream:.write(": ", self.type);
            } else {
                stream:.write("let ", self.name);
                if (stream.tags.withVarIds) {
                    stream:.write("(#", std::conv::to!{[c8], 36} (self.id), ')');
                }
                stream:.write(": ", self.type);
            }
        }
    }
}
