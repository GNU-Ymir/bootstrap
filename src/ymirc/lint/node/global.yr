in global;


use ymirc::lexing::word;
use ymirc::utils::format;
use std::{stream, fs::path};
use ymirc::lint::node::global::_;


/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */


mod ::const_;
mod ::frame;
mod ::globvar;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBTYPES          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub def YILConstant: const_::YILConstant;
pub def YILFrame: frame::YILFrame;
pub def YILGlobalVar: globvar::YILGlobalVar;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          ROOT          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 *
 * Abstract base class for all global YIL symbols.
 *
 * A YILSymbol represents any global-scope entity in the Ymir Intermediate
 * Language.
 *
 *   - the module path where the symbol is declared,
 *   - the symbol name,
 *   - the list of referenced symbols,
 *   - a weak-symbol flag.
 *
 */
@abstract
pub class YILSymbol over YILNode {

    pub {

        // The path to the module that declared the symbol
        let path: Path;

        // THe name of the symbol
        let name: [c8];

        // The list of symbols referenced in this symbol
        let references: [[c8] => Path];

        // True if the symbol is weak
        let isWeak: bool;

    }

    /**
     *
     * @params:
     *   - loc:      source location of the symbol
     *   - implLoc:  location of the implementation file
     *   - name:     symbol name
     *   - isWeak:   true iff the symbol is weak
     *   - refs:     list of referenced symbols(name-> Path)
     *
     */
    pub self (loc: &Word, implLoc: &Word, name: [c8], isWeak: bool, refs: [[c8] => Path])
        with super (loc)
        , path = Path(implLoc.filename).stripExtension()
        , name = name
        , isWeak = isWeak
        , references = refs
    {}

    impl Streamable;
    impl Formattable;
}
