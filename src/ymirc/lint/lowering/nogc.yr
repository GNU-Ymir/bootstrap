in nogc;

use ymirc::errors;
use ymirc::global::core_;
use ymirc::lexing::word;
use ymirc::lint::optimizer;
use ymirc::lint::node::{_, global::_, value::_};
use ymirc::utils::format;

/**
 * @params:
 *    - name: the name of a runtime function
 * @returns: true iif the function allocates on the GC heap
 * */
fn isGCAllocator(name: [c8])-> bool {
    match name {
        YRuntimeFuncs::ALLOC_BLOCK | YRuntimeFuncs::ALLOC_CLASS
        | YRuntimeFuncs::ALLOC_NO_SET_SLICE | YRuntimeFuncs::ALLOC_SET_SLICE
        | YRuntimeFuncs::APPEND_SLICE | YRuntimeFuncs::ASYNC_RUN | YRuntimeFuncs::CALL_LAZY
        | YRuntimeFuncs::CONCAT_SLICE | YRuntimeFuncs::CONCAT_SLICE_N
        | YRuntimeFuncs::DUPLICATE_SLICE | YRuntimeFuncs::DUPLICATE_TUPLE
        | YRuntimeFuncs::MAP_COPY | YRuntimeFuncs::MAP_EMPTY | YRuntimeFuncs::MAP_INSERT
        | YRuntimeFuncs::MAP_ITER_BEGIN | YRuntimeFuncs::SPAWN_FUTURE
        | YRuntimeFuncs::THROW_EXCEPT => { true }
        _ => { false }
    }
}

/**
 * Checks that the frames of the `@nogc` functions never call a runtime function allocating on
 * the GC heap: a closure, a copy, a concatenation, a map, a lazy value, a thrown exception, ...
 * The validator only sees the calls the source spells out, these allocations are the ones the
 * expander introduces, so the check runs on its output, before any pass could remove one of
 * them at some optimization level only.
 * */
pub mod NoGCVerifier {

    /**
     * @params:
     *    - nodes: the symbols of the module, as the expander produced them
     * @throws:
     *    - ErrorMsg: the allocations of every `@nogc` frame, grouped by frame
     * */
    pub fn verify(nodes: [&YILSymbol])
        throws ErrorMsg
    {
        let mut errors: [&ErrorMsg] = [];
        for n in nodes {
            if let f: &YILFrame = n && f.isNoGC {
                let dmut finder = copy AllocationFinder(f.loc);
                finder:.rewriteInstr(f.body);

                let found = finder.getErrors();
                if (found.len != 0us) {
                    errors ~= [copy ErrorMsg::fatal(f.loc, format(LoweringErrorMessage::NOGC_FRAME), notes-> found)];
                }
            }
        }

        if (errors.len != 0us) {
            throw copy ErrorMsg::list(errors);
        }
    }
}

/**
 * Collects the calls to a runtime function allocating on the GC heap, leaving the frame as it is.
 * */
class AllocationFinder over YILRewriter {

    // where an allocation the expander did not locate is reported
    let _frameLoc: &Word;

    let mut _errors: [&ErrorMsg] = [];

    /**
     * @params:
     *    - frameLoc: the location of the frame being searched
     * */
    pub self (frameLoc: &Word)
        with super ()
        , _frameLoc = frameLoc
    {}

    /**
     * @returns: one error per allocation found
     * */
    pub fn getErrors(self)-> [&ErrorMsg] {
        self._errors
    }

    pub over rewriteValue(mut self, value: &YILValue)-> &YILValue {
        if let n: &YILNameCallValue = value && isGCAllocator(n.funcName) {
            let loc = if (n.loc.isEof) { self._frameLoc } else { n.loc };
            self._errors ~= [copy ErrorMsg::fatal(loc, format(LoweringErrorMessage::NOGC_ALLOCATION, n.funcName))];
        }

        self:.rewriteOperands(value)
    }
}
