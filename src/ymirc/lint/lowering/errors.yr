in errors;

use ymirc::errors::code;

/// Local shorthand for the catalogue entry type, cf. `ymirc::errors::code`.
def Error: code::Error;
def NO_CODE = code::NO_CODE;

/**
 * Diagnostics the lowering stage reports on the program it lowers.
 *
 * Codes are in the E5xxx range, cf. `ymirc::errors::code`.
 */
pub enum LoweringErrorMessage: Error
| NOGC_ALLOCATION = Error (5012,    "a @(y=nogc) function cannot allocate on the GC heap, the runtime call %(y) does")
| NOGC_FRAME      = Error (NO_CODE, "when lowering this @(y=nogc) function", isContext-> true);
