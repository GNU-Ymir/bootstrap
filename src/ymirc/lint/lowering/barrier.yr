in barrier;

use ymirc::global::core_;
use ymirc::lint::optimizer;
use ymirc::lint::node::{_, global::_, instr::_, type::_, value::_};

/**
 * The name of the temporaries holding the value of a store while its barrier runs.
 * */
def TEMP_NAME = "#_wb";

/**
 * Inserts the write barriers of the garbage collector. A store of a value holding pointers into
 * memory that is not a local of the frame (a heap object, a global, what a pointer points at) is
 * made by the runtime, which hands the overwritten value and the stored one to the collector while
 * it marks, concurrently with the program, so that it loses track of neither:
 *
 * ```text
 * t = R;
 * _yrt_nh_store_ptr(&L, t);   // _yrt_nh_store(&L, &t, size) for an aggregate
 * ```
 *
 * The runtime tests whether the collector marks and stores in one go, no handshake of the
 * collector parking the thread in between. The frames of the `@nogc` functions get no barrier.
 * */
pub mod WriteBarriers {

    /**
     * @params:
     *    - nodes: the symbols of the module, optimized
     * @returns: the symbols of the module, their frames with the barriers inserted
     * */
    pub fn insert(nodes: [&YILSymbol])-> [&YILSymbol] {
        let mut res: [&YILSymbol] = [];
        for n in nodes {
            if let f: &YILFrame = n && !f.isNoGC {
                let dmut inserter = copy BarrierInserter(f);
                let body = inserter:.rewriteInstr(f.body);
                if (body is f.body) {
                    res ~= [f];
                } else {
                    res ~= [f.withBody(body)];
                }
            } else {
                res ~= [n];
            }
        }

        res
    }
}

/**
 * Rewrites the stores of a frame that need a write barrier.
 * */
class BarrierInserter over YILRewriter {

    // the identifier of the next temporary
    let mut _nextVar: usize;

    /**
     * @params:
     *    - frame: the frame to rewrite
     * */
    pub self (frame: &YILFrame)
        with super ()
        , _nextVar = maxVarId(frame) + 1us
    {}

    prot over rewriteList(mut self, instrs: [&YILInstr])-> [&YILInstr] {
        let mut res: [&YILInstr] = [];
        for i in instrs {
            if let a: &YILAffect = i && needsBarrier(a) {
                res ~= self:.lowerStore(a);
            } else {
                res ~= [self:.rewriteInstr(i)];
            }
        }

        res
    }

    /**
     * @params:
     *    - a: a store that needs a barrier
     * @returns: the instructions making the store, its barrier included
     * */
    fn lowerStore(mut self, a: &YILAffect)-> [&YILInstr] {
        let loc = a.loc;
        let type = a.left.type;
        let mut res: [&YILInstr] = [];

        let src: &YILValue = if let v: &YILVar = a.right {
            v
        } else {
            let id = self:.nextVar();
            let t = copy YILVar(loc, TEMP_NAME, type, id, isTemp-> true);
            res ~= [copy YILVarDecl(loc, TEMP_NAME, type, id, isTemp-> true), copy YILAffect(loc, t, a.right)];
            t
        };

        let store = if (type of YILPointer && src.type of YILPointer) {
            copy YILNameCallValue(loc, YIL_VOID, YRuntimeFuncs::NH_STORE_PTR,
                                  copy [addressOf(a.left), copy YILCastValue(loc, YIL_PTR_VOID, src)])
        } else {
            let size = copy YILIntValue(loc, YIL_UINT_64, type.size);
            copy YILNameCallValue(loc, YIL_VOID, YRuntimeFuncs::NH_STORE, copy [addressOf(a.left), addressOf(src), size])
        };

        res ~= [copy YILCall(loc, store)];
        res
    }

    /**
     * @returns: a fresh variable identifier
     * */
    fn nextVar(mut self)-> usize {
        self._nextVar += 1us;
        self._nextVar - 1us
    }
}

/**
 * @params:
 *    - a: a store
 * @returns: true iif the store may hide a pointer from a concurrent collector
 * */
fn needsBarrier(a: &YILAffect)-> bool {
    isOutOfFrame(a.left) && hasPointers(a.left.type)
}

/**
 * @params:
 *    - dest: the destination of a store
 * @returns: true iif the destination may not be a local of the frame
 *
 * A thread local global is not one either, but it is scanned with the stack of its thread, and
 * as the stack, needs no barrier.
 * */
fn isOutOfFrame(dest: &YILValue)-> bool {
    match dest {
        v: &YILVar              => { return v.id == 0us && !v.isThreadLocal; }
        f: &YILFieldValue       => { return isOutOfFrame(f.tuple); }
        c: &YILCastValue        => { return isOutOfFrame(c.value); }
        a: &YILArrayAccessValue => { return (a.value.type of YILPointer) || isOutOfFrame(a.value); }
    }

    true
}

/**
 * @params:
 *    - type: a type
 * @returns: true iif a value of the type can hold a pointer
 * */
fn hasPointers(type: &YILType)-> bool {
    match type {
        YILPointer() => { return true; }
        a: &YILArray => { return a.len != 0us && hasPointers(a.inner); }
        t: &YILTuple => {
            for i in t.inners if hasPointers(i) {
                return true;
            }
        }
    }

    false
}

/**
 * @returns: the address of a place, as an untyped pointer
 * */
fn addressOf(value: &YILValue)-> &YILValue {
    copy YILAddrValue(value.loc, YIL_PTR_VOID, value)
}

/**
 * @returns: the largest variable identifier the frame declares
 * */
fn maxVarId(frame: &YILFrame)-> usize {
    let mut res = 0us;
    for p in frame.params if p.id > res {
        res = p.id;
    }

    let inner = maxDeclId(frame.body);
    if (inner > res) { inner } else { res }
}

/**
 * @params:
 *    - instr: an instruction
 * @returns: the largest identifier of a declaration under the instruction
 * */
fn maxDeclId(instr: &YILInstr)-> usize {
    let mut res = 0us;
    let children: [&YILInstr] = match instr {
        b: &YILBlock      => { b.instrs }
        t: &YILTryCatch   => { t.tryPart ~ t.catchPart }
        t: &YILTryFinally => { t.tryPart ~ t.finPart }
        v: &YILVarDecl    => { res = v.id; [] }
        _ => { [] }
    };

    for c in children {
        let inner = maxDeclId(c);
        if (inner > res) { res = inner; }
    }

    res
}
