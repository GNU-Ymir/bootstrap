 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in byte;

use ymirc::lexing::word;
use ymirc::utils::format;
use ymirc::errors;
use ymirc::lint::serialize::errors;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          WRITE          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * A growable byte buffer used for serialization. Supports writing:
 *   - scalar values(u8, bool, u32, u64, i64),
 *   - byte arrays,
 *   - c8 strings.
 *
 * All multi-byte integers are written in little-endian order.
 */
pub class ByteStream {

    // The buffer in which the writting is done
    let dmut _content: [u8] = [];

    pub self () {}

    /**
     * Return a mutable view of the stream content.
     *
     * @returns:
     *   - dmut[u8]
     */
    pub fn opIndex(mut self)-> dmut[u8] {
        alias self._content
    }

    /**
     * Return the current content of the stream.
     *
     * @returns:
     *   - [u8]: immutable view of the buffer
     */
    pub fn opIndex(self)-> [u8] {
        self._content
    }

    /**
     * Write an 8-bit unsigned integer.
     *
     * @params:
     *   - j: value convertible to u8
     *
     * @returns:
     *   - &ByteStream: the stream itself
     */
    pub fn write {T of u8, J} (mut self, j: J)-> dmut &ByteStream {
        let b_0 = cast!u8(j);
        self._content ~= [b_0];

        alias self
    }

    /**
     * Write a boolean as a single byte(0 or 1).
     */
    pub fn write {T of bool, J} (mut self, j: J)-> dmut &ByteStream {
        let b_0 = cast!u8(j);
        self._content ~= [b_0];

        alias self
    }

    /**
     * Write a 32-bit unsigned integer in little-endian order.
     *
     * Layout:
     *   [b3, b2, b1, b0]
     */
    pub fn write {T of u32, J} (mut self, j: J)-> dmut &ByteStream {
        let t = cast!u32(j);
        let b_0 = cast!u8(t >> 24);
        let b_1 = cast!u8(t >> 16);
        let b_2 = cast!u8(t >> 8);
        let b_3 = cast!u8(t);

        self._content ~= [b_3, b_2, b_1, b_0];

        alias self
    }

    /**
     * Write a 64-bit unsigned integer in little-endian order.
     *
     * Layout:
     *   [b7, b6, b5, b4, b3, b2, b1, b0]
     */
    pub fn write {T of u64, J} (mut self, j: J)-> dmut &ByteStream {
        let t = cast!u64(j);
        let b_0 = cast!u8(t >> 56);
        let b_1 = cast!u8(t >> 48);
        let b_2 = cast!u8(t >> 40);
        let b_3 = cast!u8(t >> 32);

        let b_4 = cast!u8(t >> 24);
        let b_5 = cast!u8(t >> 16);
        let b_6 = cast!u8(t >> 8);
        let b_7 = cast!u8(t);

        self._content ~= [b_7, b_6, b_5, b_4, b_3, b_2, b_1, b_0];

        alias self
    }

    /**
     * Write a 64-bit signed integer by reinterpreting it as u64.
     */
    pub fn write {T of i64, J} (mut self, j: J)-> dmut &ByteStream {
        return self:.write!{u64} (cast!i64(j));
    }

    /**
     * Append a byte array to the stream.
     */
    pub fn write {T of [U], U of u8} (mut self, t: T)-> dmut &ByteStream {
        self._content ~= t;
        alias self
    }

    /**
     * Append a UTF-8 string(as raw bytes) to the stream.
     *
     * Each character is cast to u8.
     */
    pub fn write {T of [U], U of c8} (mut self, t: T)-> dmut &ByteStream {
        for c in t {
            self._content ~= [cast!{u8} (c)];
        }

        alias self
    }

    /**
     * Clear the stream buffer.
     *
     * Resets the internal content to an empty array.
     */
    pub fn clear(mut self) {
        self._content = [];
    }

}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          READ          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * A cursor-based reader over a byte buffer. Supports reading:
 *   - u8, bool, c8,
 *   - u32, u64, i64,
 *   - fixed-size arrays,
 *   - dynamic arrays of u8 or c8.
 *
 * Performs strict bounds checking and throws MALFORMED_BYTECODE on invalid reads.
 */
pub record ByteReader {

    let mut _content: [u8];
    let mut _cursor: usize = 0;

    pub self (content: [u8])
        with _content = content
    {}

    /**
     * Return the unread portion of the buffer.
     *
     * @returns:
     *   - [u8]: slice from cursor to end
     */
    pub fn opIndex(self)-> [u8] {
        self._content[self._cursor .. $]
    }

    /**
     * @returns:
     *   - usize: number of unread bytes
     */
    @field
    pub fn len(self)-> usize {
        self._content.len - self._cursor
    }

    /**
     * Advance the cursor by `len` bytes.
     *
     * Throws MALFORMED_BYTECODE if skipping past the end of the buffer.
     */
    pub fn ignore(mut self, len: usize)
        throws ErrorMsg
    {
        self._cursor += len;
        if self._cursor > self._content.len {
            throw copy ErrorMsg::fatal(EOF_WORD, format(SerializeYILErrorMessage::MALFORMED_BYTECODE));
        }
    }

    /**
     * Read a 64-bit unsigned integer in little-endian order.
     *
     * Throws MALFORMED_BYTECODE if fewer than 8 bytes remain.
     */
    pub fn read {T of u64} (mut self)-> u64
        throws ErrorMsg
    {
        let rest = self._content[self._cursor .. $];
        if rest.len < 8us {
            throw copy ErrorMsg::fatal(EOF_WORD, format(SerializeYILErrorMessage::MALFORMED_BYTECODE));
        }

        self._cursor += u64::size;

        let mut result = 0u64;
        result += cast!u64(rest[0]);
        result += cast!u64(rest[1]) << 8;
        result += cast!u64(rest[2]) << 16;
        result += cast!u64(rest[3]) << 24;

        result += cast!u64(rest[4]) << 32;
        result += cast!u64(rest[5]) << 40;
        result += cast!u64(rest[6]) << 48;
        result += cast!u64(rest[7]) << 56;

        return result;
    }

    /**
     * Read a 64-bit signed integer by reading a u64 and reinterpreting it.
     */
    pub fn read {T of i64} (mut self)-> i64
        throws ErrorMsg
    {
        return cast!i64(self:.read!{u64} ());
    }

    /**
     * Read a 32-bit unsigned integer in little-endian order.
     *
     * Throws MALFORMED_BYTECODE if fewer than 4 bytes remain.
     */
    pub fn read {T of u32} (mut self)-> u32
        throws ErrorMsg
    {
        let rest = self._content[self._cursor .. $];
        if rest.len < 4us {
            throw copy ErrorMsg::fatal(EOF_WORD, format(SerializeYILErrorMessage::MALFORMED_BYTECODE));
        }

        self._cursor += u32::size;

        let mut result = 0u32;
        result += cast!u32(rest[0]);
        result += cast!u32(rest[1]) << 8;
        result += cast!u32(rest[2]) << 16;
        result += cast!u32(rest[3]) << 24;

        return result;
    }

    /**
     * Read a single byte.
     *
     * Throws MALFORMED_BYTECODE if no bytes remain.
     */
    pub fn read {T of u8} (mut self)-> u8
        throws ErrorMsg
    {
        let rest = self._content[self._cursor .. $];
        if rest.len < 1us {
            throw copy ErrorMsg::fatal(EOF_WORD, format(SerializeYILErrorMessage::MALFORMED_BYTECODE));
        }

        self._cursor += u8::size;
        return rest[0];
    }

    /**
     * Read a single byte and reinterpret it as a c8 character.
     */
    pub fn read {T of c8} (mut self)-> c8
        throws ErrorMsg
    {
        let rest = self._content[self._cursor .. $];
        if rest.len < 1us {
            throw copy ErrorMsg::fatal(EOF_WORD, format(SerializeYILErrorMessage::MALFORMED_BYTECODE));
        }

        self._cursor += u8::size;
        return cast!c8(rest[0]);
    }

    /**
     * Read a boolean encoded as a single byte(0 = false, non-zero = true).
     */
    pub fn read {T of bool} (mut self)-> bool
        throws ErrorMsg
    {
        let rest = self._content[self._cursor .. $];
        if rest.len < 1us {
            throw copy ErrorMsg::fatal(EOF_WORD, format(SerializeYILErrorMessage::MALFORMED_BYTECODE));
        }

        self._cursor += u8::size;
        return if (rest[0] == 0) { false } else { true };
    }

    /**
     * Read a fixed-size array of N elements of type U.
     *
     * Each element is read using the appropriate scalar read() overload.
     *
     * Throws MALFORMED_BYTECODE if insufficient bytes remain.
     */
    pub fn read {T of [U ; N], U, N: usize} (mut self)-> T
        throws ErrorMsg
    {
        return [self:.read!{U} () for _ in 0 .. N];
    }

    /**
     * Read a fixed-size array of N elements of type c8.
     *
     * Each element is read using the appropriate scalar read() overload.
     *
     * Throws MALFORMED_BYTECODE if insufficient bytes remain.
     */
    pub fn read {T of [U ; N], U of c8, N: usize} (mut self)-> T
        throws ErrorMsg
    {
        let rest = self._content[self._cursor .. $];
        if rest.len < N {
            throw copy ErrorMsg::fatal(EOF_WORD, format(SerializeYILErrorMessage::MALFORMED_BYTECODE));
        }

        self._cursor += N;
        return [cast! {c8} (rest[i]) for i in 0 .. N];
    }

    /**
     * Read a dynamic array of `n` characters.
     *
     * Throws MALFORMED_BYTECODE if fewer than n bytes remain.
     */
    pub fn read {T of [U], U of c8} (mut self, n: usize)-> T
        throws ErrorMsg
    {
        let rest = self._content[self._cursor .. $];
        if rest.len < n {
            throw copy ErrorMsg::fatal(EOF_WORD, format(SerializeYILErrorMessage::MALFORMED_BYTECODE));
        }

        self._cursor += n;
        return copy [cast! {c8} (rest[i]) for i in 0 .. n];
    }

    /**
     * Read a dynamic array of `n` bytes.
     *
     * Throws MALFORMED_BYTECODE if fewer than n bytes remain.
     */
    pub fn read {T of [U], U of u8} (mut self, n: usize)-> T
        throws ErrorMsg
    {
        let rest = self._content[self._cursor .. $];
        if rest.len < n {
            throw copy ErrorMsg::fatal(EOF_WORD, format(SerializeYILErrorMessage::MALFORMED_BYTECODE));
        }

        rest[0 .. n]
    }
}
