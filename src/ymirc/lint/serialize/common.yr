 */

in common;

use ymirc::utils::format;
use ymirc::lint::node::type;

use std::{io, conv, stream};

/**
 * Identifiers for all YIL type categories used during serialization.
 * These values must remain stable across compiler versions.
 *
 * Includes:
 *   - primitive integer and float types,
 *   - pointer, array, tuple, void,
 *   - OFFSET(internal),
 *   - MAX variants for dynamic sizes.
 */
pub enum: u8
| FLOAT_32  = 1
| FLOAT_64  = 2
| FLOAT_80  = 3
| FLOAT_MAX = 4
| SINT_8    = 5
| SINT_16   = 6
| SINT_32   = 7
| SINT_64   = 8
| SINT_MAX  = 9
| UINT_8    = 10
| UINT_16   = 11
| UINT_32   = 12
| UINT_64   = 13
| UINT_MAX  = 14
| VOID      = 15
| ARRAY     = 16
| TUPLE     = 17
| POINTER   = 18
| OFFSET    = 19
 -> TypeID;

/**
 * Identifiers for serialized YIL symbols:
 *   - FRAME,
 *   - GLOBAL,
 *   - CONSTANT.
 *
 * Used by the bytecode loader to reconstruct symbol tables.
 */
pub enum: u8
| FRAME    = 1
| GLOBAL   = 2
| CONSTANT = 3
 -> SymbolID;

/**
 * Identifiers for all YIL value and instruction node kinds.
 *
 * Includes:
 *   - instructions(AFFECT, BLOCK, CALL, COND_JMP, …),
 *   - value nodes(INT_V, FLOAT_V, TUPLE_V, VAR_V, …),
 *   - structural nodes(LABEL, VAR_DECL, TRY_CATCH, TRY_FIN).
 *
 * These IDs define the binary encoding of YIL.
 */
pub enum: u32
| AFFECT         = 1
| BLOCK          = 2
| CALL           = 3
| COND_JMP       = 4
| GOTO           = 5
| LABEL          = 6
| RETURN         = 7
| TRY_CATCH      = 8
| TRY_FIN        = 9
| VAR_DECL       = 10
| ADDR_V         = 11
| ARRAY_ACCESS_V = 12
| ARRAY_LIT_V    = 13
| BEGIN_CATCH_V  = 14
| BINARY_V       = 15
| CAST_V         = 16
| FIELD_V        = 17
| FLOAT_V        = 18
| INT_V          = 19
| NAME_CALL_V    = 20
| PTR_CALL_V     = 21
| STRING_LIT_V   = 22
| TUPLE_V        = 23
| UNARY_V        = 24
| UNIT_V         = 25
| UNREF_V        = 26
| VAR_V          = 27
 -> ValueID;

/**
 * SpecialFloatValue
 *
 * Encodings for special floating‑point literals:
 *   - NAN,
 *   - +inf,
 *   - −inf,
 *   - HEX(hexadecimal float literal).
 */
pub enum: u8
| NAN  = 1
| INFP = 2
| INFN = 3
| HEX  = 4
 -> SpecialFloatValue;

/**
 * A temporary stand-in for a YILType whose structure is not yet known.
 * Used during deserialization when types reference each other recursively.
 *
 * Behavior:
 *   - stores only a UID,
 *   - size() and align() return 0,
 *   - equality compares only the UID,
 *   - printable as "<place-holder(uid)>",
 *   - hashable and streamable.
 */
pub class YILTypePlaceHolder over YILType {

    /**
     * Construct a placeholder type with the given UID.
     */
    pub self (uid: usize)
        with super (uid-> uid)
    {}

    @field
    pub over size(self)-> u32 {
        0
    }

    @field
    pub over align(self)-> u32 {
        0
    }

    /**
     * Compare two nodes
     * @returns: true, iif the two nodes are strictly identical
     */
    pub over opEquals(self, o: &YILNode)-> bool {
        match o {
            v: &YILTypePlaceHolder => {
                self.uid == v.uid
            }
            _ => { false }
        }
    }

    impl Hashable;
    impl Streamable;
    impl Formattable {
        pub over format(self, dmut stream: &Formatter) {
            stream:.write("<place-holder(", self.uid, ")>");
        }
    }
}
