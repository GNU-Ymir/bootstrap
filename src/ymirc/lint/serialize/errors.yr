/*
 * SerializeYILErrorMessage — error messages for YIL bytecode serialization.
 *
 * This enumeration defines all fatal and recoverable errors that may occur
 * during YIL bytecode serialization or deserialization. These messages are
 * used by the serializer, bytecode reader, and loader to report:
 *
 *   - file system errors(read/write/permission),
 *   - malformed or corrupted bytecode,
 *   - mismatched architecture parameters,
 *   - invalid type/string/symbol/location tables,
 *   - illegal attempts to import symbols from bytecode.
 *
 * Each entry is a format string supporting %(y) substitution.
 *
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::lint::serialize::errors
 * @File: ymirc/lint/serialize/errors.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-01-23
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in errors;

use ymirc::errors::code;

/// Local shorthand for the catalogue entry type, cf. `ymirc::errors::code`.
def Error: code::Error;

/// Local shorthand for the code of an uncoded context message.
def NO_CODE = code::NO_CODE;

/**
 * Error messages that can be raised while serializing or deserializing YIL.
 *
 * Codes are in the E5xxx range, cf. `ymirc::errors::code`.
 */
pub enum SerializeYILErrorMessage: Error
| FAILED_TO_CREATE_OUT_DIR          = Error (5001,    "failed to create YIL output directory %(y), permission denied")
| FAILED_TO_READ_BYTE_FILE          = Error (5002,    "failed to read YIL byte file %(y), file not found or permission denied")
| FAILED_TO_PARSE_BYTE_FILE         = Error (5003,    "failed to read YIL byte file %(y), file format error")
| FAILED_TO_WRITE_BYTE_FILE         = Error (5004,    "failed to write YIL byte file %(y), permission denied")
| MALFORMED_BYTECODE                = Error (5005,    "malformed bytecode")
| MALFORMED_BYTECODE_TYPE_TABLE     = Error (5006,    "malformed bytecode, type table invalid")
| MALFORMED_BYTECODE_STRING_TABLE   = Error (5007,    "malformed bytecode, string table invalid")
| MALFORMED_BYTECODE_SYMBOL_TABLE   = Error (5008,    "malformed bytecode, symbol table invalid")
| MALFORMED_BYTECODE_LOCATION_TABLE = Error (5009,    "malformed bytecode, location table invalid")
| MISMATCH_ARCH_POINTER_SIZE        = Error (5010,    "YIL byte file was created for a %(y) bits target, mismatch current target arch %(y) bits")
| IMPORTING_FRAME                   = Error (NO_CODE, "import frame symbol %(y)")
| IMPORTING_CONSTANT                = Error (NO_CODE, "import constant symbol %(y)")
| IMPORTING_GLOBAL_VAR              = Error (NO_CODE, "import global variable symbol %(y)");
