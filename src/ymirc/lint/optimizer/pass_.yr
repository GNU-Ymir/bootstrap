/*
 * Declares OptimizerPass, the base class of every YIL optimization pass.
 *
 * A pass is a self contained frame to frame transformation, identified by a
 * name and gated by a minimum optimization level. The Optimizer holds an
 * ordered list of them and applies them in order, which makes the pass pipeline
 * data rather than control flow: the same pass may legitimately appear twice in
 * the list(e.g. copy propagation, then dead code elimination, then copy
 * propagation again).
 *
 * Every pass accumulates named counters(statements removed, blocks merged,
 * calls devirtualized, ...) reported by `--fopt-stats`. Those counters are how
 * we decide whether a pass is worth its complexity.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::lint::optimizer::pass_
 * @File: ymirc/lint/optimizer/pass_.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-08-22
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in pass_;

use ymirc::global;
use ymirc::lint::node::{_, global::_};

/**
 * Abstract base class of every YIL optimization pass.
 *
 * A pass transforms a single frame at a time and returns the transformed frame.
 * It must be a pure function of its input as far as the rest of the compiler is
 * concerned: YIL nodes are immutable, so a pass rebuilds the parts it changes
 * and returns the original node when it changes nothing.
 *
 */
@abstract
pub class OptimizerPass {

    pub {
        // The name of the pass, as used by `-fenable-pass=` / `-fdisable-pass=`
        let name: [c8];

        // The lowest optimization level at which the pass runs by default
        let minLevel: u32;
    }

    // The named counters accumulated by the pass, reported by `--fopt-stats`
    let mut _stats: [[c8] => mut usize] = copy [];

    /**
     * @params:
     *    - name:     the name of the pass(`-fenable-pass=` / `-fdisable-pass=`)
     *    - minLevel: the lowest optimization level at which the pass runs by default
     * */
    pub self (name: [c8], minLevel: u32)
        with name = name
        , minLevel = minLevel
    {}

    /**
     * Apply the pass to a frame.
     *
     * @params:
     *    - frame: the frame to transform
     * @returns: the transformed frame, or `frame` itself if nothing changed
     * */
    pub fn apply(mut self, frame: &YILFrame)-> &YILFrame;

    /*!
     * ================================================================================
     * ================================================================================
     * =========================          ACTIVATION          =========================
     * ================================================================================
     * ================================================================================
     */

    /**
     * @params:
     *    - level: the optimization level of the current compilation
     * @returns: true iff the pass should be run at that level
     *
     * A pass runs when the optimization level reaches its minimum level, unless
     * the user disabled it explicitly. `-fenable-pass=` overrides the level so a
     * single pass can be run in isolation, but never overrides `-O0`: level 0
     * means the YIL is handed to the backend exactly as the expander built it.
     * */
    pub fn isEnabledAt(self, level: u32)-> bool {
        if (level == 0u32) return false;
        if (global::state::isPassForceDisabled(self.name)) return false;
        if (global::state::isPassForceEnabled(self.name)) return true;

        level >= self.minLevel
    }

    /*!
     * ================================================================================
     * ================================================================================
     * ==========================          STATISTICS          ========================
     * ================================================================================
     * ================================================================================
     */

    /**
     * Increment one of the named counters of the pass.
     *
     * @params:
     *    - key: the name of the counter(e.g. "statements removed")
     *    - nb:  the amount to add to it
     * */
    pub fn count(mut self, key: [c8], nb: usize = 1us) {
        if let Ok(old) = self._stats[key] {
            self._stats[key] = old + nb;
        } else {
            self._stats[key] = nb;
        }
    }

    /**
     * @returns: the named counters accumulated by the pass so far
     * */
    pub fn getStats(self)-> [[c8] => usize] {
        self._stats
    }

    /**
     * @returns: true iff the pass changed nothing at all so far
     * */
    pub fn isNoop(self)-> bool {
        for _, v in self._stats {
            if (v != 0us) return false;
        }

        true
    }

    /**
     * Reset the named counters of the pass.
     * */
    pub fn resetStats(mut self) {
        self._stats = copy [];
    }

}
