/*
 * Declares the error messages reported by the YIL verifier.
 *
 * A verifier error is a compiler bug, not a user error: it means a pass rewrote
 * the intermediate language into something the backend cannot be handed. The
 * messages are therefore written for whoever is debugging the pass, and always
 * name the frame and the pass the malformed node was found in.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::lint::optimizer::errors
 * @File: ymirc/lint/optimizer/errors.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-08-22
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in errors;

pub enum VerifierErrorMessage
| MALFORMED_YIL            = "malformed YIL in frame %(y), after the pass %(y)"
| MALFORMED_YIL_EXPANSION  = "malformed YIL in frame %(y), as produced by the expander"
| UNDECLARED_VAR           = "the variable %(y) (#%(y)) is used but never declared in the frame"
| NOT_DOMINATING_VAR       = "the variable %(y) (#%(y)) is used in BB%(y), which its declaration in BB%(y) does not dominate"
| DUPLICATED_VAR_DECL      = "the variable %(y) (#%(y)) is declared twice in the frame"
| UNKNOWN_LABEL            = "the jump targets the label %(y) (#%(y)), which the frame does not define"
| DUPLICATED_LABEL         = "the label %(y) (#%(y)) is defined twice in the frame"
| AFFECT_TYPE_MISMATCH     = "affecting a value of type %(y) to a left operand of type %(y)"
| CAST_TYPE_MISMATCH       = "casting a value of type %(y) to the incompatible type %(y)"
| FIELD_INDEX_OUT_OF_RANGE = "accessing the field _%(y) of a tuple that has %(y) of them"
| FIELD_UNKNOWN_NAME       = "accessing the field %(y), which the tuple type %(y) does not declare"
| ARRAY_ACCESS_ON_SCALAR   = "indexing a value of type %(y), which is neither an array nor a pointer"
| BEGIN_CATCH_OUTSIDE      = "the exception %(y) is caught outside of the catching part of a try/catch"
| MISSING_RETURN           = "the frame returns %(y) but the path leaving BB%(y) reaches its end without a return"
| DANGLING_REF             = "the frame calls %(y), which is not part of the symbols it declares depending on"
| DECLARED_HERE            = "declared here"
| FIRST_DEFINED_HERE       = "first defined here";
