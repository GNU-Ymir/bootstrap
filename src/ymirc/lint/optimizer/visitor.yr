/*
 * Declares the Optimizer, the pass manager of the YIL optimization stage.
 *
 * The Optimizer runs between the Expander and the YIL dump/export, so that what
 * is dumped, exported and handed to the backend is the optimized YIL. It owns
 * an ordered list of OptimizerPass, and applies them one after the other over
 * every frame of the module.
 *
 * The pipeline is data, not control flow: the order of the list is the order of
 * the passes, and the same pass may appear twice(copy propagation, then dead
 * code elimination, then copy propagation again). Each pass is gated by a
 * minimum `-O` level, and can be forced on or off individually with
 * `-fenable-pass=` / `-fdisable-pass=` to bisect a miscompilation down to a
 * single transformation.
 *
 * At `-O0` the Optimizer runs nothing at all and returns the expander output
 * untouched, so the YIL is byte identical to what the compiler produced before
 * this stage existed.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::lint::optimizer::visitor
 * @File: ymirc/lint/optimizer/visitor.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2025-01-04
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in visitor;

use std::{io, fs::{_, path}};

use ymirc::errors;
use ymirc::global;
use ymirc::utils::format;
use ymirc::lint::{node::{_, global::_, instr::_, type::_, value::_},
                  optimizer::{analysis, cfg, pass_, verifier}};

use ymirc::lexing::word;
use ymirc::lexing::keys;

/**
 * The optimizer class simplifies previously validated symbols
 */
pub class Optimizer {

    // The optimization level of the current compilation(0 means no pass is run)
    let _level: u32;

    // The passes to apply, in application order
    let mut _passes: [dmut &OptimizerPass] = [];

    // The path of the module being optimized, used as the base name of the dumps
    let mut _dumpPath: Path = Path("");

    /**
     * Create a new optimizer.
     *
     * @params:
     *    - level: the optimization level(`-O`), 0 disabling every pass
     * */
    pub self (level: u32 = 0u32)
        with _level = level
    {}

    /*!
     * ================================================================================
     * ================================================================================
     * ============================          PASSES          ==========================
     * ================================================================================
     * ================================================================================
     */

    /**
     * Append a pass at the end of the pipeline.
     *
     * The same pass instance must not be registered twice: register two
     * instances instead, so that their statistics stay distinguishable.
     *
     * @params:
     *    - pass: the pass to append
     * */
    pub fn addPass(mut self, dmut pass: &OptimizerPass) {
        self._passes ~= [alias pass];
    }

    /**
     * @returns: the passes of the pipeline, in application order
     * */
    pub fn getPasses(self)-> [&OptimizerPass] {
        self._passes
    }

    /*!
     * ================================================================================
     * ================================================================================
     * ===========================          OPTIMIZE          =========================
     * ================================================================================
     * ================================================================================
     */

    /**
     * Optimize a list of generators.
     *
     * @params:
     *    - generators: the YIL nodes produced by the expander
     *    - dumpPath:   the path of the module, used as the base name of the dumps
     * @returns: the optimized nodes, or `generators` untouched at `-O0`
     * @throws:
     *    - ErrorMsg: iif `--fverify-yil` is set and a frame is malformed
     * */
    pub fn optimize(mut self, generators: [&YILSymbol], dumpPath: Path = Path(""))-> [&YILSymbol]
        throws ErrorMsg
    {
        self._dumpPath = dumpPath;

        // the control flow graph is a debugging aid, not a transformation: it is
        // dumped whatever the optimization level, so that the graph of a frame
        // can be looked at on the very YIL the backend is handed at -O0
        if (global::state::isCfgDumpingActive()) {
            self.dumpCfgs(generators);
        }

        // so is the dataflow: reading the live in/live out of a frame is how a
        // pass that dropped a live store is caught, and that has to be possible
        // on the YIL the pass actually saw
        if (global::state::isDataflowDumpingActive()) {
            self.dumpDataflows(generators);
        }

        // the raw expander output is verified as well: a pass is only ever
        // blamed for a malformation it actually introduced
        self.verify(generators, "");

        if (self._level == 0u32) return generators;

        let mut current = generators;
        let mut nb = 0us;

        for i in 0us .. self._passes.len {
            let dmut pass = alias self._passes[i];
            if (!pass.isEnabledAt(self._level)) continue;

            current = self.applyPass(alias pass, current);
            self.verify(current, pass.name);
            nb += 1us;

            if (global::state::isYilOptDumpingEachActive()) {
                self.dumpNodes(current, format("ydump-yil.%.%", nb, pass.name));
            }
        }

        if (global::state::isYilOptDumpingActive()) {
            self.dumpNodes(current, "ydump-yil-opt");
        }

        if (global::state::isOptStatsActive()) {
            self.printStats();
        }

        current
    }

    /**
     * Apply a single pass over every frame of the module.
     *
     * @params:
     *    - pass:  the pass to apply
     *    - nodes: the nodes to transform
     * @returns: the transformed nodes
     * */
    fn applyPass(self, dmut pass: &OptimizerPass, nodes: [&YILSymbol])-> [&YILSymbol] {
        let mut res: [mut &YILSymbol] = [];
        for gen in nodes {
            match gen {
                frame: &YILFrame => {
                    res ~= [pass:.apply(frame)];
                }
                _ => {
                    res ~= [gen];
                }
            }
        }

        res
    }

    /*!
     * ================================================================================
     * ================================================================================
     * ==========================          VERIFY          ============================
     * ================================================================================
     * ================================================================================
     */

    /**
     * Verify the well formedness of every frame of the module(`--fverify-yil`).
     *
     * @params:
     *    - nodes: the nodes to verify
     *    - pass:  the name of the pass that produced them, empty for the expander output
     * @throws:
     *    - ErrorMsg: iif a frame is malformed
     * */
    fn verify(self, nodes: [&YILSymbol], pass: [c8])
        throws ErrorMsg
    {
        if (!global::state::isYilVerifyActive()) return;

        let dmut ver = copy verifier::Verifier(pass-> pass);
        for n in nodes {
            match n {
                frame: &YILFrame => { ver:.verify(frame); }
            }
        }
    }

    /*!
     * ================================================================================
     * ================================================================================
     * ==========================          DUMPING          ===========================
     * ================================================================================
     * ================================================================================
     */

    /**
     * Write the YIL nodes to `<module>.<ext>`.
     *
     * Failing to write a dump is never fatal: dumps are a debugging aid, and a
     * read only build directory must not break the compilation.
     *
     * @params:
     *    - nodes: the nodes to write
     *    - ext:   the extension of the dump file
     * */
    fn dumpNodes(self, nodes: [&YILSymbol], ext: [c8]) {
        if (self._dumpPath.toStr() == "") return;

        {
            let dmut f = File::create(self._dumpPath.addExtension(ext), write-> true);
            for n in nodes {
                f:.write(format("%\n", n, tags-> FormatTags(withVarIds-> true)));
            }
        } catch {
            err: &FsError => println(err);
        }
    }

    /**
     * Write the control flow graph of the selected frames, one `.dot` per frame.
     *
     * The name of the file is `<module>.<frame>.cfg.dot`, the frame being named
     * by its mangled name, which is what `--fdump-cfg=` selects on.
     *
     * @params:
     *    - nodes: the nodes of the module
     * */
    fn dumpCfgs(self, nodes: [&YILSymbol]) {
        for n in nodes {
            match n {
                frame: &YILFrame => {
                    if (!global::state::isCfgDumped(frame.name)) continue;

                    let dmut graph = copy CFG(frame);
                    let unreach = graph.unreachableBlocks();
                    if (unreach.len != 0us) {
                        println("cfg : ", frame.name, " : ", unreach.len, " unreachable block(s)");
                    }

                    if (self._dumpPath.toStr() == "") continue;

                    {
                        let dmut f = File::create(self._dumpPath.addExtension(frame.name ~ ".cfg.dot"), write-> true);
                        f:.write(graph.toDot());
                    } catch {
                        err: &FsError => println(err);
                    }
                }
            }
        }
    }

    /**
     * Write the dataflow of the selected frames, one text file per frame.
     *
     * The name of the file is `<module>.<frame>.dataflow.txt`, the frame being
     * named by its mangled name, which is what `--fdump-dataflow=` selects on.
     *
     * @params:
     *    - nodes: the nodes of the module
     * */
    fn dumpDataflows(self, nodes: [&YILSymbol]) {
        if (self._dumpPath.toStr() == "") return;

        for n in nodes {
            match n {
                frame: &YILFrame => {
                    if (!global::state::isDataflowDumped(frame.name)) continue;

                    let df = copy FrameDataflow(frame);
                    {
                        let dmut f = File::create(self._dumpPath.addExtension(frame.name ~ ".dataflow.txt"), write-> true);
                        f:.write(df.toDump());
                    } catch {
                        err: &FsError => println(err);
                    }
                }
            }
        }
    }

    /**
     * Print the per pass statistics table on the standard output(`--fopt-stats`).
     * */
    fn printStats(self) {
        println("YIL optimizer statistics (-O", self._level, ") : ", self._dumpPath.toStr());
        for i in 0us .. self._passes.len {
            let pass = self._passes[i];
            if (!pass.isEnabledAt(self._level)) continue;

            println("  ", pass.name, " :", if (pass.isNoop()) { " nothing" } else { "" });
            for k, v in pass.getStats() {
                if (v != 0us) println("    ", k, " : ", v);
            }
        }
    }

}
