in symbol;

use ymirc::lexing::word;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

mod ::base;
mod ::class_;
mod ::ctor;
mod ::def_;
mod ::dtor;
mod ::empty;
mod ::enum_;
mod ::error;
mod ::function;
mod ::global;
mod ::impl_;
mod ::lazy_module;
mod ::macro_;
mod ::module;
mod ::path;
mod ::sym_list;
mod ::table;
mod ::template_;
mod ::trait_;
mod ::unittest;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          LAZY          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub lazy dmut EMPTY_SYMBOL = copy EmptySymbol (loc-> EOF_WORD);

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          TYPES          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub def Symbol:           base::Symbol;

pub def ClassSymbol:      class_::ClassSymbol;
pub def CtorSymbol:       ctor::CtorSymbol;
pub def DefSymbol:        def_::DefSymbol;
pub def DtorSymbol:       dtor::DtorSymbol;
pub def EmptySymbol:      empty::EmptySymbol;
pub def EnumSymbol:       enum_::EnumSymbol;
pub def ErrorSymbol:      error::ErrorSymbol;
pub def FunctionSymbol:   function::FunctionSymbol;
pub def GlobalVarSymbol:  global::GlobalVarSymbol;
pub def ImplSymbol:       impl_::ImplSymbol;
pub def LazyModuleSymbol: lazy_module::LazyModuleSymbol;
pub def SymbolPath:       path::SymbolPath;
pub def SymbolList:       sym_list::SymbolList;
pub def ImutSymbolList:   sym_list::ImutSymbolList;
pub def Table:            table::Table;
pub def TemplateSymbol:   template_::TemplateSymbol;
pub def TraitSymbol:      trait_::TraitSymbol;
pub def UnitTestSymbol:   unittest::UnitTestSymbol;

pub def MacroCtorSymbol: macro_::ctor::MacroCtorSymbol;
pub def MacroRuleSymbol: macro_::rule::MacroRuleSymbol;
pub def MacroSymbol:     macro_::MacroSymbol;




