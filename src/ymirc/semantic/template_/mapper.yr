/*
 * Represents a mapping between template parameter names and the expressions
 * they are specialized with during template resolution.
 *
 * TemplateMapper is produced by the template specialization engine and is
 * used to:
 *
 *   - store associations between template parameter names and expressions,
 *   - track mutability and deep mutability of template parameters,
 *   - accumulate a specialization score(used for overload ranking),
 *   - preserve insertion order of template parameters,
 *   - merge multiple mappers during multi-stage template resolution,
 *   - compare mappers for strict equivalence,
 *   - format mappers for diagnostics.
 *
 * TemplateMapper is the core data structure used by the template validator and
 * template instantiation engine.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::value::operator::template_::mapper
 * @File: ymirc/semantic/validator/value/operator/template_/mapper.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-06-02
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in mapper;

use std::stream;
use ymirc::syntax::expression::_;
use ymirc::errors;
use ymirc::utils::format;

/**
 * The names declared by a list of template parameters, in declaration order.
 *
 * @info: the parameter kinds listed here are the ones that bind a name, and are the same the
 *  solver looks through when it searches a parameter by name.
 */
pub fn declaredTemplateNames(params: [&Expression])-> [[c8]] {
    let mut names: [mut[c8]] = [];
    for p in params {
        match p {
            v: &VarExpr                 => { names ~= [v.name.str]; }
            v: &TemplateOfVarExpr       => { names ~= [v.name.str]; }
            v: &TemplateAndExpr         => { names ~= [v.name.str]; }
            v: &TemplateVariadicVarExpr => { names ~= [v.name.str]; }
            v: &TemplateVarExpr         => { names ~= [v.name.str]; }
            v: &VarDeclExpr             => { names ~= [v.name.str]; }
            _ => {}
        }
    }

    names
}

/**
 * TemplateMapper
 *
 * Stores template parameter bindings and metadata for template specialization.
 *
 */
pub record TemplateMapper {

    prv {
        // specialization score accumulated during matching.
        let mut _score: u32 = 0u32;

        // map from template parameter name to specialized expression.
        let mut _mapping: [[c8] => mut &Expression] = copy [];

        // ordered list of parameter names, preserving insertion order.
        let mut _nameOrder: [mut[c8]] = [];

        // set of parameters marked as `mut`.
        let mut _mutable: [[c8] => mut()] = copy [];

        // set of parameters marked as `dmut`.
        let mut _deeplyMutable: [[c8] => mut()] = copy [];
    }

    /**
     * Construct an empty TemplateMapper with an optional initial score.
     *
     */
    pub self (score: u32 = 0u32)
        with _score = score
    {}

    /**
     * @returns: the score of the mapper
     */
    @field
    pub fn score(self)-> u32 {
        self._score
    }

    /**
     * @returns: the list of mapping association(name to syntax expression)
     */
    @field
    pub fn mapping(self)-> [[c8] => &Expression] {
        self._mapping
    }

    /**
     * @returns: the name order of the templates
     * */
    @field
    pub fn nameOrder(self)-> [[c8]] {
        self._nameOrder
    }

    /**
     * @returns: the list of mapper sorted by name order
     * */
    @field
    pub fn mappingSorted(self)-> [&Expression] {
        let mut vec: [mut &Expression] = [];
        for i in self._nameOrder match self._mapping[i] {
            Ok(x) => { vec ~= [x]; }
        }

        vec
    }

    /**
     * @returns: the set of mutable parameters.
     */
    @field
    pub fn mutables(self)-> [[c8] => ()] {
        self._mutable
    }

    /**
     * @returns: the set of deeply mutable parameters.
     */
    @field
    pub fn deeplyMutables(self)-> [[c8] => ()] {
        self._deeplyMutable
    }

    /**
     * @returns: true iff the mapper contains a binding for `name`.
     */
    pub fn opContains(self, name: [c8])-> bool {
        return name in self._mapping;
    }

    /**
     * @returns: the expression associated to a key if any
     */
    pub fn opIndex(self, name: [c8])-> (&Expression)? {
        return self._mapping[name];
    }

    /**
     * Insert a new template parameter binding.
     *
     * @params:
     *   - name       : template parameter name,
     *   - expr       : associated expression,
     *   - mutable    : whether the parameter is `mut`,
     *   - deeplyMut  : whether the parameter is `dmut`.
     */
    pub fn insert(mut self, name: [c8], expr: &Expression, mutable: bool = false, deeplyMut: bool = false) {
        self._nameOrder ~= [name];
        self._mapping[name] = expr;

        if (deeplyMut) {
            self._deeplyMutable[name] = ();
        } else if (mutable) {
            self._mutable[name] = ();
        }
    }

    /**
     * Remove a template parameter binding.
     *
     * Behavior:
     *   - remove from mapping,
     *   - remove from mutability sets,
     *   - remove from nameOrder.
     */
    pub fn remove(mut self, name: [c8]) {
        if name in self._mapping {
            self._mapping:.remove(name);
            self._mutable:.remove(name);
            self._deeplyMutable:.remove(name);

            let mut order: [mut[c8]] = [];
            for j in self._nameOrder if j != name {
                order ~= [j];
            }

            self._nameOrder = alias order;
        }
    }

    /**
     * Add a specialization score to the mapper.
     *
     * Used by the template resolution engine to rank specializations.
     *
     */
    pub fn addScore(mut self, score: u32) {
        self._score += score;
    }

    /**
     * Merge another TemplateMapper into this one.
     *
     * @returns:
     *   - self (after merging).
     */
    pub fn merge(mut self, other: TemplateMapper, replace: bool = false)-> TemplateMapper {
        for i in other._nameOrder {
            if let Ok(v) = other._mapping[i] && (replace || i !in self._mapping) {
                self._nameOrder ~= [i];
                self._mapping[i] = v;

                if (i in other._mutable) {
                    self._mutable[i] = ();
                } else if (i in other._deeplyMutable) {
                    self._deeplyMutable[i] = ();
                }
            }
        }

        self._score += other._score;
        return self;
    }

    /**
     * Create a mapper holding the same bindings as self, in a canonical order.
     *
     * The name order of a mapper is the order in which the solver bound the parameters, and two
     * resolutions of the same instantiation do not bind them in the same order - a call site
     * spelling every argument out does not bind them like one leaving some to be deduced. Such
     * mappers are equal(opEquals goes by name, never by order), so they share a single
     * instantiated symbol, but they mangle to two different names, and the one a call site emits
     * may then be defined nowhere. Ordering them the same way makes the mangled name a property
     * of the instantiation alone.
     *
     * The canonical order is the one the template was declared in - which the caller has to
     * remember, since a template taking several rounds to solve is rewritten, between rounds,
     * into a declaration holding only the parameters that remain.
     *
     * @params:
     *   - declared: the parameter names of the template declaration, in declaration order
     *   - params:   the template parameters at hand, used for the names `declared` does not cover
     *
     * @info: a name in neither - a parameter of an enclosing template - keeps its relative
     *  order, after the others.
     */
    pub fn orderedBy(self, declared: [[c8]], params: [&Expression])-> TemplateMapper {
        let dmut result = TemplateMapper(score-> self._score);

        for names in [declared, declaredTemplateNames(params), self._nameOrder] {
            for n in names {
                if let Ok(e) = self._mapping[n] && n !in result._mapping {
                    result:.insert(n, e, mutable-> n in self._mutable, deeplyMut-> n in self._deeplyMutable);
                }
            }
        }

        return result;
    }

    /**
     * Create a new TemplateMapper containing:
     *   - all bindings from self,
     *   - all bindings from other.
     *
     * Equivalent to:
     *     let r = TemplateMapper();
     *     r.merge(self);
     *     r.merge(other);
     */
    pub fn opBinary{"~"}(self, other: TemplateMapper)-> TemplateMapper {
        let mut result = TemplateMapper();
        result:.merge(self);
        result:.merge(other);

        return result;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          COMPARISON          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Compare two TemplateMapper instances for strict equivalence.
     *
     * Conditions:
     *   - same number of names,
     *   - same mapping size,
     *   - same name order,
     *   - each corresponding expression is equal.
     *
     * @returns:
     *   - true iff the two mappers are identical.
     */
    pub fn opEquals(self, other: TemplateMapper)-> bool {
        if (self._nameOrder.len != other._nameOrder.len) return false;
        if (self._mapping.len   != other._mapping.len) return false;

        for i in self._nameOrder {
            match (self._mapping[i], other._mapping[i]) {
                (Ok(x), Ok(y)) => {
                    if (x != y) return false;
                }
                _ => {
                    return false;
                }
            }
        }

        return true;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          FORMATTING          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Streamable;
    impl Formattable {

        /**
         * Format the mapper for diagnostics.
         *
         * Example:
         *     { mut T => i32, U => [c8] }
         *
         * Includes mutability flags and preserves name order.
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write('{');
            let mut z = 0us;
            for i in self._nameOrder {
                if let Ok(x) = self._mapping[i] {
                    if (z != 0) stream:.write(", ");
                    if (i in self._mutable) stream:.write("mut ");
                    else if (i in self._deeplyMutable) stream:.write("dmut ");

                    stream:.write(i, "=> ", x);
                    z += 1us;
                }
            }
            stream:.write('}');
        }
    }

    /**
     * Produce a simplified string representation of the mapper.
     *
     * Omits parameter names and prints only expressions, preserving order.
     *
     * Example:
     *     { i32, [c8] }
     */
    pub fn simpleFormat(self)-> [c8] {
        let dmut stream = copy Formatter();
        stream:.write('{');
        let mut z = 0us;
        for i in self._nameOrder {
            if let Ok(x) = self._mapping[i] {
                if (z != 0) stream:.write(", ");
                if (i in self._mutable) stream:.write("mut ");
                else if (i in self._deeplyMutable) stream:.write("dmut ");

                stream:.write(x);
                z += 1us;
            }
        }

        stream:.write('}');
        return stream[];
    }
}
