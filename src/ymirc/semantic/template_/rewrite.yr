/*
 * Root module for template-driven rewriting of Ymir AST nodes.
 *
 * TemplateRewriting provides the unified public interface for applying a
 * TemplateMapper to:
 *
 *   - declarations(via TemplateDeclarationRewriting),
 *   - expressions  (via TemplateExpressionRewriting),
 *   - template parameter lists(via rewriteTemplateParams).
 *
 * This module does not perform rewriting itself; instead, it delegates to
 * the specialized submodules:
 *
 *   - TemplateDeclarationRewriting  (rewrites Declaration nodes),
 *   - TemplateExpressionRewriting   (rewrites Expression nodes).
 *
 * Together, these modules implement the full template instantiation
 * pipeline, ensuring that every syntactic construct containing template
 * parameters is rewritten consistently and recursively.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::template_::rewrite
 * @File: ymirc/semantic/template_/rewrite.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2022-04-07
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in rewrite;

use ymirc::syntax::{_, declaration, expression::_};

use ymirc::utils::format;
use ymirc::lexing::word;

use ymirc::semantic::template_::rewrite::_;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

mod ::expr;
mod ::decl;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          ROOT          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * TemplateRewriting module
 *
 * Provides the public entry points for template-driven rewriting.
 *
 */
pub mod TemplateRewriting {

    /**
     * Rewrite a declaration node using the provided TemplateMapper.
     *
     * Behavior:
     *   - forwards directly to TemplateDeclarationRewriting::rewrite(),
     *   - returns a freshly constructed declaration node.
     */
    pub fn rewrite(ref mapper: TemplateMapper, d: &Declaration)-> &Declaration {
        return TemplateDeclarationRewriting::rewrite(mapper, d);
    }

    /**
     * Rewrite an expression node using the provided TemplateMapper.
     *
     * Behavior:
     *   - forwards directly to TemplateExpressionRewriting::rewrite(),
     *   - returns a freshly constructed expression node.
     */
    pub fn rewrite(ref mapper: TemplateMapper, e: &Expression)-> &Expression {
        return TemplateExpressionRewriting::rewrite(mapper, e);
    }

    /**
     * Rewrite a list of template parameters, filtering out parameters that are
     * already bound in the TemplateMapper.
     *
     * Purpose:
     *   - remove template parameters that have already been substituted,
     *   - preserve only those parameters that remain free after rewriting.
     *
     * @returns:
     *   - a filtered and partially rewritten list of template parameter expressions.
     *
     */
    fn rewriteTemplateParams(ref mapper: TemplateMapper, params: [&Expression])-> [&Expression] {
        let mut results: [&Expression] = [];
        for p in params match p {
            v: &VarExpr if v.name.str !in mapper => {
                results ~= [v];
            }
            v: &TemplateOfVarExpr if v.name.str !in mapper => {
                results ~= [v];
            }
            v: &TemplateAndExpr if v.name.str !in mapper => {
                results ~= [v];
            }
            v: &TemplateVariadicVarExpr if v.name.str !in mapper => {
                results ~= [v];
            }
            v: &TemplateVarExpr if v.name.str !in mapper => {
                results ~= [v];
            }
            v: &VarDeclExpr if v.name.str !in mapper => {
                results ~= [TemplateRewriting::rewrite(mapper, v)];
            }
            _ => {
                let name = format("%[%,%]", p.loc.str, p.loc.line, p.loc.col);
                if name !in mapper {
                    results ~= [p];
                }
            }
        }

        return results;
    }
}
