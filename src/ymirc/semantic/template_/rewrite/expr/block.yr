in block;

use ymirc::syntax::expression::_;

use ymirc::utils::format;
use ymirc::lexing::word;

use ymirc::semantic::template_::rewrite::_;

/**
 * TemplateBlockExprRewriting module
 *
 * Provides rewriting logic for block-level expression nodes.
 */
pub mod TemplateBlockExprRewriting {

    /**
     * Rewrite a BlockExpr.
     *
     */
    pub fn rewrite(ref mapper: TemplateMapper, c: &BlockExpr)-> &BlockExpr {
        let module = TemplateDeclarationRewriting::rewrite(mapper, c.declModule);
        let content = copy [TemplateExpressionRewriting::rewrite(mapper, i) for i in c.content];
        let guards = copy [TemplateBlockExprRewriting::rewriteScopeGuard(mapper, i) for i in c.guards];
        let catcher = TemplateExpressionRewriting::rewrite(mapper, c.catcher);

        return copy BlockExpr(c.loc, c.end, content,
                              module-> module,
                              catcher-> catcher,
                              guards-> guards);
    }

    /**
     * Rewrite a ScopeGuardExpr.
     *
     */
    pub fn rewriteScopeGuard(ref mapper: TemplateMapper, s: &ScopeGuardExpr)-> &ScopeGuardExpr {
        let content = TemplateExpressionRewriting::rewrite(mapper, s.content);

        return copy ScopeGuardExpr(s.loc, content, s.kind);
    }

    /**
     * Rewrite a SetExpr.
     *
     */
    pub fn rewriteSet(ref mapper: TemplateMapper, s: &SetExpr)-> &SetExpr {
        let content = copy [TemplateExpressionRewriting::rewrite(mapper, i) for i in s.content];

        return copy SetExpr(s.loc, content);
    }
}
