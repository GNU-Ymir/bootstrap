in operator;

use ymirc::syntax::expression::_;

use ymirc::utils::format;
use ymirc::lexing::word;

use ymirc::semantic::template_;

/**
 * TemplateOperatorExprRewriting module
 *
 * Provides rewriting logic for operator expression nodes.
 *
 */
pub mod TemplateOperatorExprRewriting {

    /**
     * Rewrite an operator expression
     *
     */
    pub fn rewrite(ref mapper: TemplateMapper, o: &OperatorExpr)-> &Expression {
        match o {
            b: &BinaryExpr => return TemplateOperatorExprRewriting::rewriteBinary(mapper, b);
            c: &CastExpr => return TemplateOperatorExprRewriting::rewriteCast(mapper, c);
            c: &CteExpr => return TemplateOperatorExprRewriting::rewriteCte(mapper, c);
            m: &MacroCallExpr => return TemplateOperatorExprRewriting::rewriteMacro(mapper, m);
            m: &MultOperatorExpr => return TemplateOperatorExprRewriting::rewriteMult(mapper, m);
            n: &NamedExpr => return TemplateOperatorExprRewriting::rewriteNamed(mapper, n);
            p: &PathExpr => return TemplateOperatorExprRewriting::rewritePath(mapper, p);
            p: &PragmaExpr => return TemplateOperatorExprRewriting::rewritePragma(mapper, p);
            t: &TemplateCallExpr => return TemplateOperatorExprRewriting::rewriteTemplateCall(mapper, t);
            t: &TemplateCheckerExpr => return TemplateOperatorExprRewriting::rewriteTemplateCheck(mapper, t);
            u: &UnaryExpr => return TemplateOperatorExprRewriting::rewriteUnary(mapper, u);
        }

        std::io::eprintln("internal error, invalid operator expression: ", o.__typeinfo.name);
        panic;
    }

    /**
     * Rewrite an binary operator expression
     *
     */
    fn rewriteBinary(ref mapper: TemplateMapper, b: &BinaryExpr)-> &BinaryExpr {
        let left = TemplateExpressionRewriting::rewrite(mapper, b.left);
        let right = TemplateExpressionRewriting::rewrite(mapper, b.right);

        return copy BinaryExpr(b.loc, left, right);
    }

    /**
     * Rewrite an cast operator expression
     *
     */
    fn rewriteCast(ref mapper: TemplateMapper, c: &CastExpr)-> &CastExpr {
        let type = TemplateExpressionRewriting::rewrite(mapper, c.type);
        let value = TemplateExpressionRewriting::rewrite(mapper, c.value);

        return copy CastExpr(c.loc, type, value);
    }

    /**
     * Rewrite an cte operator expression
     *
     */
    fn rewriteCte(ref mapper: TemplateMapper, c: &CteExpr)-> &CteExpr {
        let value = TemplateExpressionRewriting::rewrite(mapper, c.value);

        return copy CteExpr(c.loc, value);
    }

    /**
     * Rewrite an macro operator expression
     *
     */
    fn rewriteMacro(ref mapper: TemplateMapper, m: &MacroCallExpr)-> &MacroCallExpr {
        let who = TemplateExpressionRewriting::rewrite(mapper, m.who);

        return copy MacroCallExpr(m.loc, who, m.content, m.trim);
    }

    /**
     * Rewrite an mult operator expression
     *
     */
    fn rewriteMult(ref mapper: TemplateMapper, m: &MultOperatorExpr)-> &MultOperatorExpr {
        let left = TemplateExpressionRewriting::rewrite(mapper, m.left);
        let rights = copy [TemplateExpressionRewriting::rewrite(mapper, p) for p in m.rights];

        return copy MultOperatorExpr(m.loc, m.end, m.op, left, rights,
                                     canBeDotCall-> m.canBeDotCall);
    }

    /**
     * Rewrite an named operator expression
     *
     */
    fn rewriteNamed(ref mapper: TemplateMapper, n: &NamedExpr)-> &NamedExpr {
        let value = TemplateExpressionRewriting::rewrite(mapper, n.value);

        return copy NamedExpr(n.loc, n.name, value);
    }

    /**
     * Rewrite an path operator expression
     *
     */
    fn rewritePath(ref mapper: TemplateMapper, p: &PathExpr)-> &PathExpr {
        let left = TemplateExpressionRewriting::rewrite(mapper, p.left);
        let right = TemplateExpressionRewriting::rewrite(mapper, p.right);

        return copy PathExpr(p.loc, left, right, isRoot-> p.isRoot);
    }

    /**
     * Rewrite an pragma operator expression
     *
     */
    fn rewritePragma(ref mapper: TemplateMapper, p: &PragmaExpr)-> &PragmaExpr {
        let params = copy [TemplateExpressionRewriting::rewrite(mapper, a) for a in p.params];

        return copy PragmaExpr(p.loc, p.name, params);
    }

    /**
     * Rewrite an template call operator expression
     *
     */
    fn rewriteTemplateCall(ref mapper: TemplateMapper, t: &TemplateCallExpr)-> &Expression {
        if let v: &VarExpr = t.left {
            if let Ok(x) = mapper[v.name.str] {
                return x;
            }
        }

        let left = TemplateExpressionRewriting::rewrite(mapper, t.left);
        let rights = copy [TemplateExpressionRewriting::rewrite(mapper, p) for p in t.rights];

        return copy TemplateCallExpr(t.loc, left, rights);
    }

    /**
     * Rewrite an template check operator expression
     *
     */
    fn rewriteTemplateCheck(ref mapper: TemplateMapper, t: &TemplateCheckerExpr)-> &TemplateCheckerExpr {
        let params = copy [TemplateExpressionRewriting::rewrite(mapper, p) for p in t.params];
        let rules = copy [TemplateExpressionRewriting::rewrite(mapper, r) for r in t.rules];


        return copy TemplateCheckerExpr(t.loc, params, rules);
    }

    /**
     * Rewrite an unary operator expression
     *
     */
    fn rewriteUnary(ref mapper: TemplateMapper, u: &UnaryExpr)-> &UnaryExpr {
        let value = TemplateExpressionRewriting::rewrite(mapper, u.value);

        return copy UnaryExpr(u.loc, value);
    }
}
