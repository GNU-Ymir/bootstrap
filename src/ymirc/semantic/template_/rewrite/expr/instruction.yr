in instruction;

use ymirc::syntax::expression::_;

use ymirc::utils::format;
use ymirc::lexing::word;

use ymirc::semantic::template_;

/**
 * TemplateInstructionExprRewriting module
 *
 * Provides rewriting logic for instruction expression nodes.
 *
 */
pub mod TemplateInstructionExprRewriting {

    /**
     * Rewrite a instruction expression
     *
     */
    pub fn rewrite(ref mapper: TemplateMapper, i: &InstructionExpr)-> &InstructionExpr {
        match i {
            a: &AssertExpr => return TemplateInstructionExprRewriting::rewriteAssert(mapper, a);
            b: &BreakExpr => return TemplateInstructionExprRewriting::rewriteBreak(mapper, b);
            p: &PanicExpr => return TemplateInstructionExprRewriting::rewritePanic(mapper, p);
            p: &PatternVarDeclExpr => return TemplateInstructionExprRewriting::rewritePattern(mapper, p);
            r: &ReturnExpr => return TemplateInstructionExprRewriting::rewriteReturn(mapper, r);
            t: &ThrowExpr => return TemplateInstructionExprRewriting::rewriteThrow(mapper, t);
            v: &VarDeclExpr => return TemplateInstructionExprRewriting::rewriteVarDecl(mapper, v);
            y: &YieldExpr => return TemplateInstructionExprRewriting::rewriteYield(mapper, y);

            c: &ContinueExpr => return c;
        }

        std::io::eprintln("internal error, invalid instruction expression: ", i.__typeinfo.name);
        panic;
    }

    /**
     * Rewrite an assert expression
     *
     */
    fn rewriteAssert(ref mapper: TemplateMapper, a: &AssertExpr)-> &AssertExpr {
        let test = TemplateExpressionRewriting::rewrite(mapper, a.test);
        let msg = TemplateExpressionRewriting::rewrite(mapper, a.msg);

        return copy AssertExpr(a.loc, test, msg);
    }

    /**
     * Rewrite a break expression
     *
     */
    fn rewriteBreak(ref mapper: TemplateMapper, b: &BreakExpr)-> &BreakExpr {
        let value = TemplateExpressionRewriting::rewrite(mapper, b.value);

        return copy BreakExpr(b.loc, value);
    }

    /**
     * Rewrite a panic expression
     *
     */
    fn rewritePanic(ref mapper: TemplateMapper, p: &PanicExpr)-> &PanicExpr {
        let msg = TemplateExpressionRewriting::rewrite(mapper, p.msg);

        return copy PanicExpr(p.loc, msg);
    }

    /**
     * Rewrite a pattern expression
     *
     */
    fn rewritePattern(ref mapper: TemplateMapper, p: &PatternVarDeclExpr)-> &PatternVarDeclExpr {
        let pattern = TemplateExpressionRewriting::rewrite(mapper, p.pattern);
        let value = TemplateExpressionRewriting::rewrite(mapper, p.value);

        return copy PatternVarDeclExpr(p.loc, pattern, value);
    }

    /**
     * Rewrite a return expression
     *
     */
    fn rewriteReturn(ref mapper: TemplateMapper, r: &ReturnExpr)-> &ReturnExpr {
        let value = TemplateExpressionRewriting::rewrite(mapper, r.value);

        return copy ReturnExpr(r.loc, value);
    }

    /**
     * Rewrite a throw expression
     *
     */
    fn rewriteThrow(ref mapper: TemplateMapper, t: &ThrowExpr)-> &ThrowExpr {
        let value = TemplateExpressionRewriting::rewrite(mapper, t.value);

        return copy ThrowExpr(t.loc, value);
    }

    /**
     * Rewrite a vardecl expression
     *
     */
    pub fn rewriteVarDecl(ref mapper: TemplateMapper, v: &VarDeclExpr)-> &VarDeclExpr {
        let type = TemplateExpressionRewriting::rewrite(mapper, v.type);
        let value = TemplateExpressionRewriting::rewrite(mapper, v.value);

        return copy VarDeclExpr(v.loc, v.name, value, type, v.isMutOrDmut, v.isLazyOrRef);
    }

    /**
     * Rewrite a yield expression
     *
     */
    fn rewriteYield(ref mapper: TemplateMapper, y: &YieldExpr)-> &YieldExpr {
        let value = TemplateExpressionRewriting::rewrite(mapper, y.value);

        return copy YieldExpr(y.loc, value);
    }
}
