in match_;

use ymirc::syntax::expression::_;

use ymirc::utils::format;
use ymirc::lexing::word;

use ymirc::semantic::template_;

/**
 * TemplateMatchExprRewriting module
 *
 * Provides rewriting logic for match filter expression nodes.
 *
 */
pub mod TemplateMatchExprRewriting {

    /**
     * Rewrite a match filter expression.
     *
     */
    pub fn rewrite(ref mapper: TemplateMapper, f: &MatchFilterExpr)-> &MatchFilterExpr {
        match f {
            m: &MatchListFilterExpr => return TemplateMatchExprRewriting::rewriteList(mapper, m);
            m: &MatchOptionFilterExpr => return TemplateMatchExprRewriting::rewriteOption(mapper, m);
        }

        std::io::eprintln("internal error, invalid match filter expression: ", f.__typeinfo.name);
        panic;
    }

    /**
     * Rewrite a match filter list expression.
     *
     */
    fn rewriteList(ref mapper: TemplateMapper, l: &MatchListFilterExpr)-> &MatchListFilterExpr {
        let params = copy [TemplateExpressionRewriting::rewrite(mapper, p) for p in l.params];

        return copy MatchListFilterExpr(l.loc, l.end, params, l.isVariadic, l.isArray);
    }

    /**
     * Rewrite a match filter option expression.
     *
     */
    fn rewriteOption(ref mapper: TemplateMapper, o: &MatchOptionFilterExpr)-> &MatchOptionFilterExpr {
        let inner = TemplateExpressionRewriting::rewrite(mapper, o.inner);

        return copy MatchOptionFilterExpr(o.loc, o.kind, inner);
    }
}
