in literal;

use ymirc::syntax::expression::_;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::utils::format;
use ymirc::lexing::word;

use ymirc::semantic::template_;

/**
 * TemplateLiteralExprRewriting module
 *
 * Provides rewriting logic for literal expression nodes.
 *
 */
pub mod TemplateLiteralExprRewriting {

    /**
     * Rewrite a litral expression
     */
    pub fn rewrite(ref mapper: TemplateMapper, l: &LiteralExpr)-> &Expression {
        if let v: &VarExpr = l match mapper[v.name.str] {
            Ok(x: &ValueWrapperExpr) => return copy ValueWrapperExpr(v.loc, x.value);
            Ok(x: &TypeWrapperExpr) => return copy TypeWrapperExpr(v.loc, x.type, asIs-> x.asIs);
            Ok(x: &TypeListWrapperExpr) => return copy TypeListWrapperExpr(v.loc, x.types);
            Ok(x: &LambdaValueWrapperExpr) => return copy LambdaValueWrapperExpr(v.loc, x.name, x.expr, x.value);
            Ok(x: &Expression) => return x;
        }

        return l;
    }
}
