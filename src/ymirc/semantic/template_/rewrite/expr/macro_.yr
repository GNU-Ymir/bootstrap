in macro_;

use ymirc::syntax::expression::_;

use ymirc::utils::format;
use ymirc::lexing::word;

use ymirc::semantic::template_;

/**
 * TemplateMacroExprRewriting module
 *
 * Provides rewriting logic for macro rule expression nodes.
 *
 */
pub mod TemplateMacroExprRewriting {

    /**
     * Rewrite a macro rule expression.
     *
     */
    pub fn rewrite(ref mapper: TemplateMapper, r: &MacroRuleExpr)-> &MacroRuleExpr {
        match r {
            m: &MacroMultExpr => return TemplateMacroExprRewriting::rewriteMult(mapper, m);
            m: &MacroOrExpr => return TemplateMacroExprRewriting::rewriteOr(mapper, m);
            m: &MacroVarExpr => return TemplateMacroExprRewriting::rewriteVar(mapper, m);

            m: &MacroIdentExpr => return m;
            m: &MacroTokenExpr => return m;
        }

        std::io::eprintln("internal error, invalid macro rule expression: ", r.__typeinfo.name);
        panic;
    }

    /**
     * Rewrite a macro mult rule expression.
     *
     */
    pub fn rewriteMult(ref mapper: TemplateMapper, m: &MacroMultExpr)-> &MacroMultExpr {
        let content = copy [TemplateMacroExprRewriting::rewrite(mapper, c) for c in m.content];

        return copy MacroMultExpr(m.loc, m.end, content,
                                  mult-> m.mult);
    }

    /**
     * Rewrite a macro or rule expression.
     *
     */
    pub fn rewriteOr(ref mapper: TemplateMapper, m: &MacroOrExpr)-> &MacroOrExpr {
        let left = TemplateMacroExprRewriting::rewrite(mapper, m.left);
        let right = TemplateMacroExprRewriting::rewrite(mapper, m.right);

        return copy MacroOrExpr(m.loc, left, right);
    }

    /**
     * Rewrite a macro var rule expression.
     *
     */
    pub fn rewriteVar(ref mapper: TemplateMapper, m: &MacroVarExpr)-> &MacroVarExpr {
        let rule = TemplateMacroExprRewriting::rewrite(mapper, m.rule);

        return copy MacroVarExpr(m.loc, rule);
    }
}
