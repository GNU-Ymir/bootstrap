in memory;

use ymirc::syntax::expression::_;

use ymirc::utils::format;
use ymirc::lexing::word;

use ymirc::semantic::template_;

/**
 * TemplateMemoryExprRewriting module
 *
 * Provides rewriting logic for memory expression nodes.
 *
 */
pub mod TemplateMemoryExprRewriting {

    /**
     * Rewrite a memory expression
     *
     */
    pub fn rewrite(ref mapper: TemplateMapper, m: &MemoryExpr)-> &MemoryExpr {
        match m {
            a: &AliasExpr => return TemplateMemoryExprRewriting::rewriteAlias(mapper, a);
            c: &CopyExpr => return TemplateMemoryExprRewriting::rewriteCopy(mapper, c);
            e: &ExpandExpr => return TemplateMemoryExprRewriting::rewriteExpand(mapper, e);
            o: &MoveExpr => return TemplateMemoryExprRewriting::rewriteMove(mapper, o);
            r: &RefExpr => return TemplateMemoryExprRewriting::rewriteRef(mapper, r);
        }

        std::io::eprintln("internal error, invalid memory expression: ", m.__typeinfo.name);
        panic;
    }

    /**
     * Rewrite an alias expression
     *
     */
    fn rewriteAlias(ref mapper: TemplateMapper, a: &AliasExpr)-> &AliasExpr {
        let content = TemplateExpressionRewriting::rewrite(mapper, a.content);

        return copy AliasExpr(a.loc, content);
    }

    /**
     * Rewrite a copy expression
     *
     */
    fn rewriteCopy(ref mapper: TemplateMapper, c: &CopyExpr)-> &CopyExpr {
        let content = TemplateExpressionRewriting::rewrite(mapper, c.content);

        return copy CopyExpr(c.loc, content, c.isDeep);
    }

    /**
     * Rewrite a copy expression
     *
     */
    fn rewriteExpand(ref mapper: TemplateMapper, e: &ExpandExpr)-> &ExpandExpr {
        let content = TemplateExpressionRewriting::rewrite(mapper, e.content);

        return copy ExpandExpr(e.loc, content);
    }

    /**
     * Rewrite a move expression
     *
     */
    fn rewriteMove(ref mapper: TemplateMapper, m: &MoveExpr)-> &MoveExpr {
        let content = TemplateExpressionRewriting::rewrite(mapper, m.content);

        return copy MoveExpr(m.loc, content);
    }

    /**
     * Rewrite a ref expression
     *
     */
    fn rewriteRef(ref mapper: TemplateMapper, r: &RefExpr)-> &RefExpr {
        let content = TemplateExpressionRewriting::rewrite(mapper, r.content);

        return copy RefExpr(r.loc, content);
    }
}
