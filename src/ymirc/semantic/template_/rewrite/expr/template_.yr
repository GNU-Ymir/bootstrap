in template_;

use ymirc::syntax::expression::_;

use ymirc::utils::format;
use ymirc::lexing::word;

use ymirc::semantic::template_;

/**
 * TemplateOperatorExprRewriting module
 *
 * Provides rewriting logic for template expression nodes.
 *
 */
pub mod TemplateTemplateExprRewriting {

    /**
     * Rewrite a template expression
     *
     */
    pub fn rewrite(ref mapper: TemplateMapper, t: &TemplateExpr)-> &Expression {
        match t {
            e: &TemplateAndExpr => return TemplateTemplateExprRewriting::rewriteAnd(mapper, e);
            e: &TemplateOfVarExpr => return TemplateTemplateExprRewriting::rewriteOf(mapper, e);
            e: &TemplateVarExpr => return TemplateTemplateExprRewriting::rewriteVar(mapper, e);
            e: &TemplateVariadicVarExpr => return TemplateTemplateExprRewriting::rewriteVariadic(mapper, e);
        }

        std::io::eprintln("internal error, invalid template expression: ", t.__typeinfo.name);
        panic;
    }

    /**
     * Rewrite a template and expression
     *
     */
    fn rewriteAnd(ref mapper: TemplateMapper, t: &TemplateAndExpr)-> &TemplateAndExpr {
        let inners = copy [TemplateTemplateExprRewriting::rewriteOf(mapper, o) for o in t.inners];

        return copy TemplateAndExpr(t.loc, inners);
    }

    /**
     * Rewrite a template of expression
     *
     */
    fn rewriteOf(ref mapper: TemplateMapper, t: &TemplateOfVarExpr)-> &TemplateOfVarExpr {
        let spec = TemplateExpressionRewriting::rewrite(mapper, t.spec);

        return copy TemplateOfVarExpr(t.loc, t.kind, spec);
    }

    /**
     * Rewrite a template var expression
     *
     */
    fn rewriteVar(ref mapper: TemplateMapper, t: &TemplateVarExpr)-> &Expression {
        if let Ok(x) = mapper[t.name.str] {
            return x;
        }

        return t;
    }

    /**
     * Rewrite a template variadic var expression
     *
     */
    fn rewriteVariadic(ref mapper: TemplateMapper, t: &TemplateVariadicVarExpr)-> &Expression {
        if let Ok(x) = mapper[t.name.str] {
            return x;
        }

        return t;
    }
}
