in type;

use ymirc::syntax::expression::_;

use ymirc::utils::format;
use ymirc::lexing::word;

use ymirc::semantic::template_::rewrite::expr::_;

/**
 * TemplateTypeExprRewriting module
 *
 * Provides rewriting logic for type expression nodes.
 *
 */
pub mod TemplateTypeExprRewriting {

    /**
     * Rewrite a type expression
     *
     */
    pub fn rewrite(ref mapper: TemplateMapper, t: &TypeExpr)-> &TypeExpr {
        match t {
            a: &AsyncTypeExpr => return TemplateTypeExprRewriting::rewriteAsync(mapper, a);
            d: &DecoratedTypeExpr => return TemplateTypeExprRewriting::rewriteDeco(mapper, d);
            f: &FunctionPtrTypeExpr => return TemplateTypeExprRewriting::rewriteFptr(mapper, f);
            f: &FutureTypeExpr => return TemplateTypeExprRewriting::rewriteFuture(mapper, f);
            r: &RangeTypeExpr => return TemplateTypeExprRewriting::rewriteRange(mapper, r);
            y: &TypeOfExpr => return TemplateTypeExprRewriting::rewriteTypeof(mapper, y);
            y: &YieldTypeExpr => return TemplateTypeExprRewriting::rewriteYield(mapper, y);
        }

        std::io::eprintln("internal error, invalid type expression: ", t.__typeinfo.name);
        panic;
    }

    /**
     * Rewrite a async type expression
     *
     */
    fn rewriteAsync(ref mapper: TemplateMapper, a: &AsyncTypeExpr)-> &AsyncTypeExpr {
        let retType = TemplateExpressionRewriting::rewrite(mapper, a.retType);

        return copy AsyncTypeExpr(a.loc, retType);
    }

    /**
     * Rewrite a decorated type expression
     *
     */
    fn rewriteDeco(ref mapper: TemplateMapper, d: &DecoratedTypeExpr)-> &DecoratedTypeExpr {
        let content = TemplateExpressionRewriting::rewrite(mapper, d.content);

        return copy DecoratedTypeExpr(d.loc, d.kind, content);
    }

    /**
     * Rewrite a function pointer type expression
     *
     */
    pub fn rewriteFptr(ref mapper: TemplateMapper, f: &FunctionPtrTypeExpr)-> &FunctionPtrTypeExpr {
        let retType = TemplateExpressionRewriting::rewrite(mapper, f.retType);
        let params = copy [TemplateInstructionExprRewriting::rewriteVarDecl(mapper, v) for v in f.params];

        return copy FunctionPtrTypeExpr(f.loc, f.isDelegate, params, retType);
    }

    /**
     * Rewrite a future type expression
     *
     */
    fn rewriteFuture(ref mapper: TemplateMapper, f: &FutureTypeExpr)-> &FutureTypeExpr {
        let retType = TemplateExpressionRewriting::rewrite(mapper, f.retType);

        return copy FutureTypeExpr(f.loc, retType);
    }

    /**
     * Rewrite a range type expression
     *
     */
    fn rewriteRange(ref mapper: TemplateMapper, r: &RangeTypeExpr)-> &RangeTypeExpr {
        let inner = TemplateExpressionRewriting::rewrite(mapper, r.type);

        return copy RangeTypeExpr(r.loc, inner);
    }

    /**
     * Rewrite a typeof expression
     *
     */
    fn rewriteTypeof(ref mapper: TemplateMapper, t: &TypeOfExpr)-> &TypeOfExpr {
        let value = TemplateExpressionRewriting::rewrite(mapper, t.value);

        return copy TypeOfExpr(t.loc, value);
    }

    /**
     * Rewrite a yield type expression
     *
     */
    fn rewriteYield(ref mapper: TemplateMapper, y: &YieldTypeExpr)-> &YieldTypeExpr {
        let retType = TemplateExpressionRewriting::rewrite(mapper, y.retType);

        return copy YieldTypeExpr(y.loc, retType);
    }
}
