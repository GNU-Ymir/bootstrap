in compose;

use ymirc::syntax::expression::_;

use ymirc::utils::format;
use ymirc::lexing::word;

use ymirc::semantic::template_::rewrite::{decl, expr::_};

/**
 * TemplateComposeExprRewriting module
 *
 * Provides rewriting logic for compose expression nodes.
 *
 */
pub mod TemplateComposeExprRewriting {

    /**
     * Rewrite a compose expression
     *
     */
    pub fn rewrite(ref mapper: TemplateMapper, c: &ComposeExpr)-> &ComposeExpr {
        match c {
            l: &LambdaExpr => return TemplateComposeExprRewriting::rewriteLambda(mapper, l);
            l: &ListExpr => return TemplateComposeExprRewriting::rewriteList(mapper, l);
            l: &ListMapExpr => return TemplateComposeExprRewriting::rewriteListMap(mapper, l);
            s: &SliceAllocatorExpr => return TemplateComposeExprRewriting::rewriteSlice(mapper, s);
            m: &MapForAllocatorExpr => return TemplateComposeExprRewriting::rewriteMapFor(mapper, m);
            s: &SliceForAllocatorExpr => return TemplateComposeExprRewriting::rewriteSliceFor(mapper, s);
            t: &TryExpr => return TemplateComposeExprRewriting::rewriteTry(mapper, t);
        }

        std::io::eprintln("internal error, invalid compose expression: ", c.__typeinfo.name);
        panic;
    }

    /**
     * Rewrite a lambda expression
     *
     */
    fn rewriteLambda(ref mapper: TemplateMapper, l: &LambdaExpr)-> &LambdaExpr {
        let proto = TemplateDeclarationRewriting::rewriteProto(mapper, l.proto);
        let body = TemplateExpressionRewriting::rewrite(mapper, l.body);

        return copy LambdaExpr(l.loc, proto, body);
    }

    /**
     * Rewrite a list expression
     *
     */
    fn rewriteList(ref mapper: TemplateMapper, l: &ListExpr)-> &ListExpr {
        let params = copy [TemplateExpressionRewriting::rewrite(mapper, p) for p in l.params];

        return copy ListExpr(l.loc, l.end, params, l.isArray);
    }

    /**
     * Rewrite a map list expression
     *
     */
    fn rewriteListMap(ref mapper: TemplateMapper, l: &ListMapExpr)-> &ListMapExpr {
        let keys = copy [TemplateExpressionRewriting::rewrite(mapper, p) for p in l.keys];
        let values = copy [TemplateExpressionRewriting::rewrite(mapper, p) for p in l.values];

        return copy ListMapExpr(l.loc, l.end, keys, values);
    }

    /**
     * Rewrite a map list comprehension
     *
     */
    fn rewriteMapFor(ref mapper: TemplateMapper, m: &MapForAllocatorExpr)-> &MapForAllocatorExpr {
        let key = TemplateExpressionRewriting::rewrite(mapper, m.key);
        let value = TemplateExpressionRewriting::rewrite(mapper, m.value);
        let iter = TemplateExpressionRewriting::rewrite(mapper, m.iter);

        let decls = copy [TemplateExpressionRewriting::rewrite(mapper, d) for d in m.decls];

        return copy MapForAllocatorExpr(m.loc, m.forLoc, key, value, decls, iter);
    }

    /**
     * Rewrite a slice allocation
     *
     */
    fn rewriteSlice(ref mapper: TemplateMapper, s: &SliceAllocatorExpr)-> &SliceAllocatorExpr {
        let value = TemplateExpressionRewriting::rewrite(mapper, s.value);
        let size = TemplateExpressionRewriting::rewrite(mapper, s.size);

        return copy SliceAllocatorExpr(s.loc, value, size);
    }

    /**
     * Rewrite a slice list comprehension
     *
     */
    fn rewriteSliceFor(ref mapper: TemplateMapper, s: &SliceForAllocatorExpr)-> &SliceForAllocatorExpr {
        let value = TemplateExpressionRewriting::rewrite(mapper, s.value);
        let iter = TemplateExpressionRewriting::rewrite(mapper, s.iter);
        let vars = copy [TemplateInstructionExprRewriting::rewriteVarDecl(mapper, v) for v in s.vars];

        return copy SliceForAllocatorExpr(s.loc, s.forLoc, value, vars, iter, s.isArray);
    }

    /**
     * Rewrite a optional expression
     *
     */
    fn rewriteTry(ref mapper: TemplateMapper, t: &TryExpr)-> &TryExpr {
        let value = TemplateExpressionRewriting::rewrite(mapper, t.value);

        return copy TryExpr(t.loc, value);
    }
}
