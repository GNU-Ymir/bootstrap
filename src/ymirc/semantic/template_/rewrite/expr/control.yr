in control;

use ymirc::syntax::expression::_;

use ymirc::utils::format;
use ymirc::lexing::word;

use ymirc::semantic::template_::rewrite::{decl, expr::_};

/**
 * TemplateControlExprRewriting module
 *
 * Provides rewriting logic for control expression nodes.
 *
 */
pub mod TemplateControlExprRewriting {

    /**
     * Rewrite a control expression
     *
     */
    pub fn rewrite(ref mapper: TemplateMapper, c: &ControlExpr)-> &ControlExpr {
        match c {
            a: &AtomicExpr => return TemplateControlExprRewriting::rewriteAtomic(mapper, a);
            a: &AwaitExpr => return TemplateControlExprRewriting::rewriteAwait(mapper, a);
            o: &ConditionalExpr => return TemplateControlExprRewriting::rewriteCond(mapper, o);
            o: &ConditionalLetExpr => return TemplateControlExprRewriting::rewriteCondLet(mapper, o);
            f: &ForLoopExpr => return TemplateControlExprRewriting::rewriteFor(mapper, f);
            l: &LazyExpr => return TemplateControlExprRewriting::rewriteLazy(mapper, l);
            m: &MatcherExpr => return TemplateControlExprRewriting::rewriteMatch(mapper, m);
            s: &SpawnExpr => return TemplateControlExprRewriting::rewriteSpawn(mapper, s);
            u: &UnsafeExpr => return TemplateControlExprRewriting::rewriteUnsafe(mapper, u);
            w: &WhileLetLoopExpr => return TemplateControlExprRewriting::rewriteWhileLet(mapper, w);
            w: &WhileLoopExpr => return TemplateControlExprRewriting::rewriteWhile(mapper, w);
        }

        std::io::eprintln("internal error, invalid control expression: ", c.__typeinfo.name);
        panic;
    }

    /**
     * Rewrite a atomic expression
     *
     */
    fn rewriteAtomic(ref mapper: TemplateMapper, a: &AtomicExpr)-> &AtomicExpr {
        let monitor = TemplateExpressionRewriting::rewrite(mapper, a.monitor);
        let value = TemplateExpressionRewriting::rewrite(mapper, a.value);

        return copy AtomicExpr(a.loc, monitor, value);
    }

    /**
     * Rewrite a await expression
     *
     */
    fn rewriteAwait(ref mapper: TemplateMapper, a: &AwaitExpr)-> &AwaitExpr {
        let value = TemplateExpressionRewriting::rewrite(mapper, a.value);

        return copy AwaitExpr(a.loc, value);
    }

    /**
     * Rewrite a conditional expression
     *
     */
    fn rewriteCond(ref mapper: TemplateMapper, c: &ConditionalExpr)-> &ConditionalExpr {
        let test = TemplateExpressionRewriting::rewrite(mapper, c.test);
        let blk = TemplateExpressionRewriting::rewrite(mapper, c.block);
        let else_ = TemplateExpressionRewriting::rewrite(mapper, c.else_);

        return copy ConditionalExpr(c.loc, c.isCte, test, blk,
                                    else_-> else_);
    }

    /**
     * Rewrite a conditional let expression
     *
     */
    fn rewriteCondLet(ref mapper: TemplateMapper, c: &ConditionalLetExpr)-> &ConditionalLetExpr {
        let test = TemplateExpressionRewriting::rewrite(mapper, c.test);
        let guard = TemplateExpressionRewriting::rewrite(mapper, c.guard);
        let blk = TemplateExpressionRewriting::rewrite(mapper, c.block);
        let else_ = TemplateExpressionRewriting::rewrite(mapper, c.else_);

        return copy ConditionalLetExpr(c.loc, test, blk, guard,
                                       else_-> else_);
    }

    /**
     * Rewrite a for loop expression
     *
     */
    fn rewriteFor(ref mapper: TemplateMapper, f: &ForLoopExpr)-> &ForLoopExpr {
        let vars = copy [TemplateInstructionExprRewriting::rewriteVarDecl(mapper, v) for v in f.vars];
        let iter = TemplateExpressionRewriting::rewrite(mapper, f.iter);
        let block = TemplateExpressionRewriting::rewrite(mapper, f.block);

        return copy ForLoopExpr(f.loc, f.isCte, vars, iter, block);
    }

    /**
     * Rewrite a lazy expression
     *
     */
    fn rewriteLazy(ref mapper: TemplateMapper, l: &LazyExpr)-> &LazyExpr {
        let value = TemplateExpressionRewriting::rewrite(mapper, l.value);

        return copy LazyExpr(l.loc, value);
    }

    /**
     * Rewrite a matcher line in a matcher expression
     *
     */
    fn rewriteMatchLine(ref mapper: TemplateMapper, ref line: MatchLine)-> MatchLine {
        let filter = TemplateExpressionRewriting::rewrite(mapper, line.filter);
        let guard = TemplateExpressionRewriting::rewrite(mapper, line.guard);
        let value = TemplateExpressionRewriting::rewrite(mapper, line.value);

        return MatchLine(filter, guard, value);
    }

    /**
     * Rewrite a matcher expression
     *
     */
    fn rewriteMatch(ref mapper: TemplateMapper, m: &MatcherExpr)-> &MatcherExpr {
        let value = TemplateExpressionRewriting::rewrite(mapper, m.value);
        let matchers = copy [TemplateControlExprRewriting::rewriteMatchLine(mapper, l) for l in m.matchers];

        return copy MatcherExpr(m.loc, value, matchers, m.isCatcher);
    }

    /**
     * Rewrite a spawn expression
     *
     */
    fn rewriteSpawn(ref mapper: TemplateMapper, s: &SpawnExpr)-> &SpawnExpr {
        let value = TemplateExpressionRewriting::rewrite(mapper, s.value);

        return copy SpawnExpr(s.loc, value);
    }

    /**
     * Rewrite an unsafe expression
     *
     */
    fn rewriteUnsafe(ref mapper: TemplateMapper, u: &UnsafeExpr)-> &UnsafeExpr {
        let value = TemplateExpressionRewriting::rewrite(mapper, u.value);

        return copy UnsafeExpr(u.loc, value);
    }

    /**
     * Rewrite a while let expression
     *
     */
    fn rewriteWhileLet(ref mapper: TemplateMapper, w: &WhileLetLoopExpr)-> &WhileLetLoopExpr {
        let test = TemplateExpressionRewriting::rewrite(mapper, w.test);
        let guard = TemplateExpressionRewriting::rewrite(mapper, w.guard);
        let blk = TemplateExpressionRewriting::rewrite(mapper, w.block);

        return copy WhileLetLoopExpr(w.loc, test, guard, blk);
    }

    /**
     * Rewrite a while loop expression
     *
     */
    fn rewriteWhile(ref mapper: TemplateMapper, w: &WhileLoopExpr)-> &WhileLoopExpr {
        let test = TemplateExpressionRewriting::rewrite(mapper, w.test);
        let blk = TemplateExpressionRewriting::rewrite(mapper, w.block);

        return copy WhileLoopExpr(w.loc, test, blk);
    }
}
