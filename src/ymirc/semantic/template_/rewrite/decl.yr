/*
 * Implements template-driven rewriting of declaration nodes.
 *
 * TemplateDeclarationRewriting is responsible for applying a TemplateMapper
 * to every declaration in the Ymir AST. It performs a deep, structural
 * traversal of declaration nodes and rewrites:
 *
 *   - embedded expressions,
 *   - type annotations,
 *   - function prototypes,
 *   - constructor and destructor bodies,
 *   - enum fields and union types,
 *   - macro rules and macro bodies,
 *   - module blocks,
 *   - template declarations themselves.
 *
 * This module is the declaration-level counterpart to
 * TemplateExpressionRewriting. Together, they implement the full template
 * instantiation pipeline.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::template_::rewrite::decl
 * @File: ymirc/semantic/template_/rewrite/decl.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-06-03
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in decl;

use ymirc::lexing::word;
use ymirc::semantic::template_::rewrite::expr::_;
use ymirc::syntax::{_, declaration::_, expression};
use ymirc::utils::format;

use std::io;

/**
 * TemplateDeclarationRewriting module
 *
 * Provides rewriting logic for all declaration-level AST nodes.
 *
 */
pub mod TemplateDeclarationRewriting {

    /**
     * Rewrite a declaration node using the provided TemplateMapper.
     *
     * Behavior:
     *   - pattern-matches on the concrete declaration type,
     *   - dispatches to the corresponding rewrite function,
     *   - returns a freshly constructed declaration node.
     *
     * @throws:
     *   - internal error if an unknown declaration type is encountered.
     */
    pub fn rewrite(ref mapper: TemplateMapper, d: &Declaration)-> &Declaration {
        match d {
            c: &CondBlockDecl => return rewriteCondBlock(mapper, c);
            b: &BlockDecl => return rewriteBlock(mapper, b);
            e: &ExternBlockDecl => return rewriteExternBlock(mapper, e);

            e: &EnumDecl => return rewriteEnum(mapper, e);
            i: &ImplDecl => return rewriteImpl(mapper, i);
            t: &TraitDecl => return rewriteTrait(mapper, t);
            t: &TypeDecl => return rewriteType(mapper, t);
            u: &UnionDecl => return rewriteUnion(mapper, u);

            u: &UnitTestDecl => return rewriteUnit(mapper, u);
            f: &FunctionDecl => return rewriteFunction(mapper, f);

            m: &MacroDecl => return rewriteMacro(mapper, m);
            m: &MacroRuleDecl => return rewriteMacroRule(mapper, m);

            a: &AssertDecl => return rewriteAssert(mapper, a);
            e: &DefDecl => return rewriteDef(mapper, e);
            g: &GlobalVarDecl => return rewriteGlobal(mapper, g);
            m: &ModuleDecl => return rewriteModule(mapper, m);
            t: &TemplateDecl => return rewriteTemplate(mapper, t);
            u: &UseDecl => return rewriteUse(mapper, u);
            i: &ImportDecl => return i;
        }

        eprintln("internal error in template declaration rewriting, ", d.__typeinfo.name);
        panic;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          BLOCK          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Rewrite a conditional block:
     *     cte if test { decls } else { else_ }
     *
     */
    fn rewriteCondBlock(ref mapper: TemplateMapper, c: &CondBlockDecl)-> &CondBlockDecl {
        let test = TemplateExpressionRewriting::rewrite(mapper, c.test);
        let decls = copy [TemplateDeclarationRewriting::rewrite(mapper, d) for d in c.decls];
        let else_ = TemplateDeclarationRewriting::rewrite(mapper, c.else_);

        return copy CondBlockDecl(c.loc, c.comm, decls, test,
                                  else_-> else_);
    }

    /**
     * Rewrite a simple block `{ decls }`.
     */
    fn rewriteBlock(ref mapper: TemplateMapper, c: &BlockDecl)-> &BlockDecl {
        let decls = copy [TemplateDeclarationRewriting::rewrite(mapper, d) for d in c.decls];

        return copy BlockDecl(c.loc, c.comm, decls, c.protection, c.isSet);
    }

    /**
     * Rewrite an extern block, rewriting all nested declarations.
     */
    fn rewriteExternBlock(ref mapper: TemplateMapper, c: &ExternBlockDecl)-> &ExternBlockDecl {
        let decls = copy [TemplateDeclarationRewriting::rewrite(mapper, d) for d in c.decls];

        return copy ExternBlockDecl(c.loc, c.comm, c.lang, decls);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          CUSTOM          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Rewrite an enum declaration.
     *
     */
    fn rewriteEnum(ref mapper: TemplateMapper, e: &EnumDecl)-> &EnumDecl {
        let fields = copy [TemplateInstructionExprRewriting::rewriteVarDecl(mapper, f) for f in e.fields];
        let type = TemplateExpressionRewriting::rewrite(mapper, e.type);

        return copy EnumDecl(e.loc, e.comm, e.name, type, fields, e.fieldComms);
    }

    /**
     * Rewrite an impl block.
     *
     */
    fn rewriteImpl(ref mapper: TemplateMapper, i: &ImplDecl)-> &ImplDecl {
        let who = TemplateExpressionRewriting::rewrite(mapper, i.who);
        let decls = copy [TemplateDeclarationRewriting::rewrite(mapper, d) for d in i.decls];

        return copy ImplDecl(i.loc, i.comm, who, decls);
    }

    /**
     * Rewrite a trait declaration and its nested declarations.
     *
     */
    fn rewriteTrait(ref mapper: TemplateMapper, t: &TraitDecl)-> &TraitDecl {
        let decls = copy [TemplateDeclarationRewriting::rewrite(mapper, d) for d in t.decls];

        return copy TraitDecl(t.loc, t.comm, t.name, decls);
    }

    /**
     * Rewrite a type declaration.
     *
     */
    fn rewriteType(ref mapper: TemplateMapper, t: &TypeDecl)-> &TypeDecl {
        let ancestor = TemplateExpressionRewriting::rewrite(mapper, t.ancestor);
        let decls = copy [TemplateDeclarationRewriting::rewrite(mapper, d) for d in t.decls];

        return copy TypeDecl(t.loc, t.comm, t.name, decls, t.attrs, ancestor, t.kind);
    }

    /**
     * Rewrite a union declaration.
     *
     */
    fn rewriteUnion(ref mapper: TemplateMapper, u: &UnionDecl)-> &UnionDecl {
        let ancestor = TemplateExpressionRewriting::rewrite(mapper, u.ancestor);
        let types = copy [TemplateExpressionRewriting::rewrite(mapper, t) for t in u.types];

        return copy UnionDecl(u.loc, u.comm, u.name, ancestor, types, u.typeComms);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          FUNCTIONS          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Rewrite a function prototype.
     *
     */
    pub fn rewriteProto(ref mapper: TemplateMapper, ref proto: FunctionPrototype)-> FunctionPrototype {
        let params = copy [TemplateInstructionExprRewriting::rewriteVarDecl(mapper, v) for v in proto.params];
        let retType = TemplateExpressionRewriting::rewrite(mapper, proto.retType);

        return FunctionPrototype(params, retType, proto.isVariadic);
    }

    /**
     * Rewrite a function declaration.
     *
     */
    fn rewriteFunction(ref mapper: TemplateMapper, f: &FunctionDecl)-> &FunctionDecl {
        match f {
            c: &CtorDecl => return rewriteCtor(mapper, c);
            t: &DtorDecl => return rewriteDtor(mapper, t);
        }

        let proto = TemplateDeclarationRewriting::rewriteProto(mapper, f.proto);
        let body = TemplateExpressionRewriting::rewrite(mapper, f.body);
        let throwers = copy [TemplateExpressionRewriting::rewrite(mapper, t) for t in f.throwers];

        return copy FunctionDecl(f.loc, f.comm, f.name, proto, body, f.attrs, throwers, f.throwerLoc, f.isOver);
    }

    /**
     * Rewrite a field affectation in ctor declaration.
     *
     */
    fn rewriteFieldCtor(ref mapper: TemplateMapper, ref f: FieldCtor)-> FieldCtor {
        let value = TemplateExpressionRewriting::rewrite(mapper, f.value);

        return FieldCtor(f.loc, f.name, value);
    }

    /**
     * Rewrite a redirection ctor call in ctor declaration.
     *
     */
    fn rewriteRedirectCtor(ref mapper: TemplateMapper, ref r: RedirectCtor)-> RedirectCtor {
        let params = copy [TemplateExpressionRewriting::rewrite(mapper, p) for p in r.params];
        let templateParams = copy [TemplateExpressionRewriting::rewrite(mapper, p) for p in r.templateParams];

        return RedirectCtor(r.loc, r.name, params, templateParams);
    }

    /**
     * Rewrite a ctor declaration.
     *
     */
    fn rewriteCtor(ref mapper: TemplateMapper, c: &CtorDecl)-> &CtorDecl {
        let proto = TemplateDeclarationRewriting::rewriteProto(mapper, c.proto);
        let body = TemplateExpressionRewriting::rewrite(mapper, c.body);
        let throwers = copy [TemplateExpressionRewriting::rewrite(mapper, t) for t in c.throwers];
        let fields = copy [TemplateDeclarationRewriting::rewriteFieldCtor(mapper, f) for f in c.fields];

        let mut redirect: (RedirectCtor)? = none;
        if let Ok(r) = c.redirect {
            redirect = (TemplateDeclarationRewriting::rewriteRedirectCtor(mapper, r))?;
        }
        return copy CtorDecl(c.loc, c.comm, c.name, proto, redirect, fields, body, c.attrs, throwers, c.throwerLoc);
    }

    /**
     * Rewrite a dtor declaration.
     *
     */
    fn rewriteDtor(ref mapper: TemplateMapper, d: &DtorDecl)-> &DtorDecl {
        let proto = TemplateDeclarationRewriting::rewriteProto(mapper, d.proto);
        let body = TemplateExpressionRewriting::rewrite(mapper, d.body);

        return copy DtorDecl(d.loc, d.comm, proto, body);
    }

    /**
     * Rewrite a unit test declaration.
     *
     */
    fn rewriteUnit(ref mapper: TemplateMapper, u: &UnitTestDecl)-> &UnitTestDecl {
        let body = TemplateExpressionRewriting::rewrite(mapper, u.body);

        return copy UnitTestDecl(u.loc, u.name, u.comm, body);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          MACRO          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Rewrite a macro declaration.
     *
     */
    fn rewriteMacro(ref mapper: TemplateMapper, m: &MacroDecl)-> &MacroDecl {
        let decls = copy [TemplateDeclarationRewriting::rewrite(mapper, d) for d in m.decls];

        return copy MacroDecl(m.loc, m.comm, m.name, decls);
    }

    /**
     * Rewrite a macro rule declaration.
     *
     */
    fn rewriteMacroRule(ref mapper: TemplateMapper, m: &MacroRuleDecl)-> &MacroRuleDecl {
        let rule = TemplateMacroExprRewriting::rewriteMult(mapper, m.rule);

        return copy MacroRuleDecl(m.loc, m.comm, m.name, m.body, rule, m.skips, m.isCtor);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          MODULE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Rewrite a module level cte assertion.
     *
     */
    fn rewriteAssert(ref mapper: TemplateMapper, a: &AssertDecl)-> &AssertDecl {
        let test = TemplateExpressionRewriting::rewrite(mapper, a.test);
        let msg = TemplateExpressionRewriting::rewrite(mapper, a.msg);

        return copy AssertDecl(a.loc, a.comm, test, msg);
    }

    /**
     * Rewrite a def declaration.
     *
     */
    fn rewriteDef(ref mapper: TemplateMapper, d: &DefDecl)-> &DefDecl {
        let content = TemplateExpressionRewriting::rewrite(mapper, d.content);

        return copy DefDecl(d.loc, d.comm, d.name, d.tokDecl, content);
    }

    /**
     * Rewrite a global variable declaration.
     *
     */
    fn rewriteGlobal(ref mapper: TemplateMapper, g: &GlobalVarDecl)-> &GlobalVarDecl {
        let var = TemplateInstructionExprRewriting::rewriteVarDecl(mapper, g.var);

        return copy GlobalVarDecl(g.loc, g.comm, var, g.attrs, g.isField, g.isStatic);
    }

    /**
     * Rewrite a module declaration.
     *
     */
    fn rewriteModule(ref mapper: TemplateMapper, m: &ModuleDecl)-> &ModuleDecl {
        let blk = TemplateDeclarationRewriting::rewriteBlock(mapper, m.block);

        return copy ModuleDecl(m.loc, m.comm, m.name, blk, m.isGlobal);
    }

    /**
     * Rewrite a template declaration.
     *
     */
    fn rewriteTemplate(ref mapper: TemplateMapper, t: &TemplateDecl)-> &TemplateDecl {
        let guard = TemplateExpressionRewriting::rewrite(mapper, t.guard);
        let params = copy [TemplateExpressionRewriting::rewrite(mapper, p) for p in t.params];
        let decl = TemplateDeclarationRewriting::rewrite(mapper, t.decl);

        return copy TemplateDecl(t.loc, t.comm, params, guard, decl);
    }

    /**
     * Rewrite a use declaration.
     *
     */
    fn rewriteUse(ref mapper: TemplateMapper, u: &UseDecl)-> &UseDecl {
        let path = TemplateExpressionRewriting::rewrite(mapper, u.path);

        return copy UseDecl(u.loc, u.comm, path, u.isRoot);
    }
}
