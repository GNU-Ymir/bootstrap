in expr;

use ymirc::syntax::{_, expression, expression::_};
use ymirc::semantic::generator::{type::syntax, value::syntax};

use ymirc::utils::format;
use ymirc::lexing::word;

use ymirc::semantic::template_;
use ymirc::semantic::template_::rewrite::expr::_;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub mod ::block;
pub mod ::compose;
pub mod ::control;
pub mod ::instruction;
pub mod ::literal;
pub mod ::macro_;
pub mod ::match_;
pub mod ::memory;
pub mod ::operator;
pub mod ::template_;
pub mod ::type;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          ROOT          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * TemplateExpressionRewriting module
 *
 * Provides the top-level dispatcher for rewriting expression nodes using a
 * TemplateMapper.
 *
 * Unknown expression types cause an internal error.
 */
pub mod TemplateExpressionRewriting {

    /*
     * Rewrite an expression node using the provided TemplateMapper.
     *
     */
    pub fn rewrite(ref mapper: TemplateMapper, e: &Expression)-> &Expression {
        match e {
            b: &BlockExpr => return TemplateBlockExprRewriting::rewrite(mapper, b);
            s: &ScopeGuardExpr => return TemplateBlockExprRewriting::rewriteScopeGuard(mapper, s);
            s: &SetExpr => return TemplateBlockExprRewriting::rewriteSet(mapper, s);
            c: &ComposeExpr => return TemplateComposeExprRewriting::rewrite(mapper, c);
            c: &ControlExpr => return TemplateControlExprRewriting::rewrite(mapper, c);
            i: &InstructionExpr => return TemplateInstructionExprRewriting::rewrite(mapper, i);
            l: &LiteralExpr => return TemplateLiteralExprRewriting::rewrite(mapper, l);
            m: &MacroRuleExpr => return TemplateMacroExprRewriting::rewrite(mapper, m);
            m: &MatchFilterExpr => return TemplateMatchExprRewriting::rewrite(mapper, m);
            m: &MemoryExpr => return TemplateMemoryExprRewriting::rewrite(mapper, m);
            o: &OperatorExpr => return TemplateOperatorExprRewriting::rewrite(mapper, o);
            t: &TemplateExpr => return TemplateTemplateExprRewriting::rewrite(mapper, t);
            t: &TypeExpr => return TemplateTypeExprRewriting::rewrite(mapper, t);

            m: &EmptyExpr => return m;
            t: &TypeWrapperExpr => return t;
            t: &TypeListWrapperExpr => return t;
            v: &ValueWrapperExpr => return v;
        }

        std::io::eprintln("internal error, invalid expression: ", e.__typeinfo.name);
        panic;
    }
}
