 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in templateref;

use ymirc::semantic::symbol;

use ymirc::lexing::word;
use ymirc::utils::{format, comparison};
use std::stream;


/**
 * Temporary type representing a reference to a template symbol.
 *
 * A TemplateRefType:
 *   - stores the TemplateSymbol associated with a template declaration,
 *   - is used during validation before template instantiation,
 *   - does not describe a runtime type and cannot appear in YIL,
 *   - is replaced by a concrete type once the template is instantiated.
 *
 * This type exists solely to support semantic analysis of template references.
 */
@final
pub class TemplateRefType over TemporaryType {

    /*! Public fields */
    pub {    
        // The template symbol referenced by this placeholder.        
        let sym: &TemplateSymbol;
    }

    /**
     * Create a temporary reference to a template symbol.
     *
     * @params:
     *   - loc: source location of the reference
     *   - symbol: the template symbol being referenced
     */
    pub self (loc: &Word, sym: &TemplateSymbol)
        with super (loc)        
        , sym = sym
    {}

    /**
     * TemplateRefType is compatible only with another TemplateRefType
     * referencing the same template symbol.
     */
    pub over isCompatible (self, o: &Type)-> bool {
        self == o
    }

    impl Comparable!{&Generator};
    
    impl Streamable;
    impl Formattable {

        /**
         * Format the template reference using the template's path and parameter list.
         */
        pub over format (self, dmut stream: &Formatter) {
            let content = self.sym.decl;
            stream:.write (self.sym.path.toStr (), content.params);
        }        
    }
    
}



