in unionref;

use ymirc::lexing::word;
use ymirc::semantic::symbol;
use ymirc::semantic::generator::type::custom;
use ymirc::utils::{comparison, format};

use std::stream;


/**
 * Reference to a union declaration.
 *
 * UnionRefType is what the name of a union validates to. It is the union
 * itself, not a value of it: a union of classes is reached through `&U`, which
 * turns this reference into the UnionType instance holding it, exactly as `&A`
 * does for a class. Being a temporary type is what makes that `&` mandatory —
 * a bare `U` has no size and cannot be the type of a value.
 *
 * A union of records is a value type, so its name validates straight to an
 * instance and this reference only ever appears to reject the `&`.
 *
 * Mutability is carried by the instance, never by this reference.
 */
@final
pub class UnionRefType over TemporaryType {

    pub {
        // The symbol defining the union
        let sym: &UnionSymbol;

        // The types of the members, in declaration order
        let members: [&Type];

        // True iff the members are records, so that the union is a value type
        let isRecord: bool;
    }

    /**
     * Construct a reference to a union.
     *
     * @params:
     *   - loc:      source location of the union declaration
     *   - sym:      the union symbol
     *   - members:  the member types, in declaration order
     *   - isRecord: true iff the members are records
     */
    pub self (loc: &Word, sym: &UnionSymbol, members: [&Type], isRecord: bool)
        with super (loc)
        , sym = sym
        , members = members
        , isRecord = isRecord
    {}

    /**
     * Create a UnionType instance of this union.
     *
     * @params:
     *   - loc:            location of the instance type
     *   - isMutable:      mutability of the value itself
     *   - isInnerMutable: mutability of the union object referenced, for a
     *                     union of classes
     */
    pub fn createInstance(self,
                          loc: &Word = EOF_WORD,
                          isMutable: bool,
                          isInnerMutable: bool)-> &UnionType {

        let finLoc = if (loc.isEof) { self.loc } else { loc };
        copy UnionType(finLoc,
                       self.sym,
                       self.members,
                       isRecord-> self.isRecord,
                       isMutable-> isMutable,
                       isInnerMutable-> isInnerMutable)
    }

    /**
     * A union reference is only compatible with a reference to the same union.
     *
     * Mutability is handled by UnionType, not here.
     */
    pub over isCompatible(self, o: &Type)-> bool {
        self == o
    }

    impl Comparable!{&Generator} {

        /**
         * Two UnionRefType instances are equal iff they refer to the same union
         * symbol.
         */
        pub over opEquals(self, o: &Generator)-> bool {
            if let u: &UnionRefType = o {
                return self.sym is u.sym;
            }

            return false;
        }
    }

    impl Streamable;
    impl Formattable {
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(self.sym.path.toStr());
        }
    }

}
