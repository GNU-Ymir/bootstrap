/*
 * Declares the MapIteratorType class.
 *
 * A MapIteratorType is a temporary type representing the iterator produced
 * when iterating over a map. It is never meant to be transferred or stored:
 * it exists only during the validation of `for` loops and similar constructs.
 *
 * The semantic generator uses this type to describe the iterator variable
 * inside a loop. The actual iterator type is derived from the underlying
 * MapType, which defines the key/value pair structure.
 *
 * MapIteratorType is never emitted into YIL directly. It is a validation-only
 * placeholder used to model the iteration semantics of maps.
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::semantic::generator::type::temporary::mapiterator
 * @File: ymirc/semantic/generator/type/temporary/mapiterator.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2021-11-26
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in mapiterator;

use ymirc::semantic::generator::value;
use ymirc::semantic::generator::type::native;

use ymirc::lexing::{keys, word};
use ymirc::lexing::word;
use ymirc::utils::{format, comparison};

use std::stream;

/**
 * Temporary type representing the iterator of a map.
 *
 * A MapIteratorType:
 *   - is created when validating a `for (k, v) in map` loop,
 *   - exposes the key/value pair types of the underlying map,
 *   - is not a real runtime type and is never cloned or transferred,
 *   - is replaced by the appropriate concrete iterator type during codegen.
 *
 * This type exists solely to support semantic validation of map iteration.
 */
@final
pub class MapIteratorType over TemporaryType {

    pub {        
        // The map type being iterated over.
        // The iterator type is derived from this map's key/value structure.
        let who: &MapType;
    }

    /**
     * Create a temporary map iterator type.
     *
     * @params:
     *   - loc: source location of the iterator expression
     *   - map: the map type being iterated
     */
    pub self (loc: &Word, map: &MapType)
        with super (loc)
        , who = map
    {}

    /**
     * Map iterator types are compatible only with other MapIteratorType instances
     * referring to the same underlying map type.
     */
    pub over isCompatible (self, o: &Type)-> bool {
        self == o
    }

    impl Comparable!{&Type} {

        /**
         * Two MapIteratorType instances are equal iff they refer to the same
         * underlying MapType.
         */
        pub over opEquals (self, o: &Generator)-> bool {        
            if let p: &MapIteratorType = o {
                return self.who is p.who;
            }
            
            false
        }
    }
    
    impl Streamable;
    impl Formattable {

        /**
         * Format the iterator type using the syntax:
         *     #_iterator!{MapType}
         */
        pub over format (self, dmut stream: &Formatter) {
            stream:.write ("#_iterator!{", self.who, "}");
        }
    }


}
