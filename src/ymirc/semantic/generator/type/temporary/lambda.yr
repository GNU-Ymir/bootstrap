/*
 * Declares the LambdaType class.
 *
 * A LambdaType represents the temporary semantic type of a lambda expression
 * whose parameter types and/or return type may still be incomplete. During
 * validation, these types may initially contain `NoneType` placeholders and
 * are progressively resolved as the lambda body is analyzed.
 *
 * LambdaType is a temporary type: it is never emitted into YIL directly.
 * Once validation is complete, it is replaced by a concrete function or
 * delegate type.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::generator::type::temporary::lambda
 * @File: ymirc/semantic/generator/type/temporary/lambda.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2021-11-20
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in lambda;

use ymirc::semantic::generator::type::native;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};

use std::stream;

/**
 * Temporary type describing a lambda expression with possibly incomplete
 * parameter and return types.
 *
 * A LambdaType stores:
 *   - the list of parameter types (some may be `NoneType` until inferred),
 *   - the return type (also possibly `NoneType`),
 *   - the source location of the lambda.
 *
 * This type is used during semantic validation to track type inference
 * and ensure that the lambda’s signature becomes fully resolved before
 * generating the corresponding delegate or function type.
 */
@final
pub class LambdaType over TemporaryType {

    /*! Public fields */
    pub {
        // Types of the lambda parameters.
        // May contain NoneType entries for parameters whose types are not yet known.
        let params: [&Type];

        // Return type of the lambda.
        // May be NoneType if the return type has not yet been inferred.
        let retType: &Type;
    }


    /**
     * Create a lambda type with possibly incomplete parameter and return types.
     *
     * @params:
     *   - loc:     source location of the lambda expression
     *   - params:  list of parameter types (may include NoneType placeholders)
     *   - retType: return type (may be NoneType)
     */
    pub self (loc: &Word,
              params: [&Type],
              retType: &Type)

        with super (loc)
        , params = params
        , retType = retType
    {}

    /**
     * Lambda types are compatible only with other LambdaType instances
     * that have identical parameter and return types.
     */
    pub over isCompatible (self, o: &Type)-> bool {
        self == o
    }

    /*!
     * ================================================================================
     * ================================================================================
     * =========================        MISCELLANEOUS         =========================
     * ================================================================================
     * ================================================================================
     */


    impl Comparable!{&Generator} {

        /**
         * Two LambdaType instances are equal iff:
         *   - their return types are equal, and
         *   - their parameter type lists are equal.
         *
         * NoneType is treated as a valid placeholder during comparison.
         */
        pub over opEquals (self, o: &Generator)-> bool {
            if let l: &LambdaType = o {
                if (self._retType != l._retType) return false;
                if (self._params != l._params) return false;

                return true;
            }

            false
        }
    }

    impl Streamable;
    impl Formattable {

        /**
         * Format the lambda type using the syntax:
         *     λ (T1, T2, ...) -> R
         *
         * Missing types (NoneType) are displayed as "_".
         */
        pub over format (self, dmut stream: &Formatter) {
            if (self._isMutable) stream:.write (Decorators::MUT, ' ');
            stream:.write ("λ (");
            for i, j in self._params {
                if (i != 0us) stream:.write (", ");
                if (j !of NoneType) { stream:.write (j); }
                else stream:.write ("_");
            }
            stream:.write (")-> ");
            if (self._retType of NoneType) stream:.write ("_");
            else stream:.write (self._retType);
        }
    }

}
