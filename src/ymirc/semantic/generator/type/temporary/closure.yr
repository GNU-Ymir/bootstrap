/*
 * Declares the ClosureType class.
 *
 * A ClosureType is a temporary type used during the validation of lambda
 * expressions. It represents the set of variables captured by a closure,
 * along with how each variable is captured (by value or by reference).
 *
 * This type is progressively filled during closure analysis and is later used
 * to generate the record type that stores captured variables inside the
 * delegate value.
 *
 * ClosureType is never emitted into YIL directly. It exists solely to support
 * semantic validation and code generation of closures.
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::semantic::generator::type::temporary::closure
 * @File: ymirc/semantic/generator/type/temporary/closure.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2022-01-14
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */
    
in closure;

use ymirc::semantic::generator::type::native;
use ymirc::semantic::generator::value;
use ymirc::semantic::validator;

use ymirc::lexing::word;
use ymirc::utils::{format, list, comparison};
use std::stream;

/**
 * Temporary type describing the captured environment of a lambda expression.
 *
 * A ClosureType tracks:
 *   - the variables declared in the surrounding scope that may be captured,
 *   - which of those variables are actually used,
 *   - how each variable is captured (by value or by reference),
 *   - the types, names, and values of captured variables,
 *   - whether closure validation has been finalized.
 *
 * This type is mutable during validation and is replaced by a concrete record
 * type when generating the closure's runtime representation.
 */
@final
pub class ClosureType over TemporaryType {

    /*! Public fields */
    pub {
        // The uniq id of the variable creating the closure value (parameter)
        let refId: usize;

        // The symbols that are enclosed
        let vars: &ScopeList;

        // The list of used vars public mutable as it is not managed by the
        // class, just are reference to somthing managed by the Semantic visitor
        // context itself
        // 
        let dmut used: &UsedList;
    }
        
    prv {
        // The types of the variable being enclosed the closure
        let mut _innerTypes: [&Type] = [];

        // The names of the varaible being enclosed
        let mut _innerNames: [[c8]] = [];

        // The values of the variables being enclosed
        let mut _innerValues: [&Value] = [];

        // The list of variables enclosed by reference
        let mut _innerRefs: [bool] = [];

        // True when the enclosing is finished being validated
        let mut _finalized: bool = false;
    }


    /**
     * Create a closure type capturing a surrounding frame.
     *
     * @params:
     *   - loc:   source location of the closure
     *   - refId: identifier of the variable that will store the closure record
     *   - vars:  list of variables eligible for capture
     *   - used:  list of variables marked as used (updated when a variable is captured)
     *   
     */
    pub self (loc: &Word,
              refId: usize,
              vars: &ScopeList,
              dmut used: &UsedList)
        
        with super (loc)
        , refId = refId
        , vars = vars
        , used = alias used
    {}


    /**
     * Create an empty closure type (captures no variables).
     *
     * @params:
     *   - loc:   source location of the closure
     *   - refId: identifier of the variable that will store the closure record
     *   
     */
    pub self empty (loc: &Word, refId: usize)
        with super (loc, isMutable-> false)
        , refId = refId
        , vars = copy ScopeList ()
        , used = copy UsedList ()
    {}

    /**
     * Internal ctor for cloning and finalization
     * */
    prv self finalized (loc: &Word,
                        innerTypes: [&Type],
                        innerNames: [[c8]],
                        innerValues: [&Value],
                        innerRefs: [bool],
                        refId: usize,
                        vars: &ScopeList,
                        dmut used: &UsedList)
        
        with super (loc, isMutable-> false)
        , refId = refId
        , _innerTypes = innerTypes
        , _innerNames = innerNames
        , _innerValues = innerValues
        , _innerRefs = innerRefs
        , vars = vars
        , used = alias used
        , _finalized = true
    {}        

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the types of the enclosed variables
     */
    @field
    pub fn types (self)-> [&Type] {
        self._innerTypes
    }

    /**
     * @returns: the name of the enclosed variables
     */
    @field
    pub fn names (self)-> [[c8]] {
        self._innerNames
    }

    /**
     * @returns: true if the i-th variable is enclosed by reference
     * */
    pub fn isByRef (self, i: i32)-> bool {
        self._innerRefs [i]
    }
    
    /**
     * @returns: The values of the enclosed variables
     */
    @field
    pub fn values (self)-> [&Value] {
        self._innerValues
    }
    
    /**
     * Search for a captured variable by name.
     *
     * @params:
     *   - name: the variable name to search for
     *
     * @returns:
     *   - .0: the variable's type
     *   - .1: true iff captured by reference
     *   - .2: index of the variable
     *
     * Returns `none` if the variable is not captured.
     */
    pub fn find (self, name: [c8])-> ((&Type, bool, usize))? {
        for i, var in self._innerNames if name == var {
            return (self._innerTypes [i], self._innerRefs [i], i)?;
        }         

        none
    }

    /**
     * @returns: true if values are enclosed by reference
     * */
    @field
    pub fn isFinalized (self)-> bool {
        self._finalized
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          FINALIZATION          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: a finalized closure type
     * */
    pub fn cloneAsFinalized (mut self)-> dmut &ClosureType {
        return copy ClosureType::finalized (closureType.loc,
                                 innerTypes-> self._innerTypes,
                                 innerNames-> self._innerNames,
                                 innerValues-> self._innerValues,
                                 innerRefs-> self._innerRefs,
                                 refId-> self.refId,
                                 vars-> self.vars,
                                 used-> self.used);
    }


    /**
     * Add a captured variable to the closure.
     *
     * @params:
     *   - name:  variable name
     *   - type:  variable type
     *   - value: variable value
     *   - byRef: true iff captured by reference
     *
     * @warning
     *   This does *not* update the `used` list. The semantic visitor is responsible
     *   for marking variables as used.
     */
    pub fn insert (mut self, name: [c8], type: &Type, value: &Value, byRef: bool) {
        self._innerRefs ~= [byRef];
        self._innerTypes ~= [type];
        self._innerNames ~= [name];
        self._innerValues ~= [value];
    }
    
    /**
     * Closure types are never compatible with any other type.
     */
    pub over isCompatible (self, _: &Type)-> bool {
        false
    }
    
    impl Comparable!{&Generator} {
        /**
         * Closure types are never equal to any other type.
         */
        pub over opEquals (self, _: &Generator)-> bool {
            false
        }
    }
    
    impl Streamable;
    impl Formattable {

        pub over format (self, dmut stream: &Formatter) {
            stream:.write ('{');
            for i, j in self._innerTypes {
                if (i != 0us) stream:.write (", ");
                stream:.write (self._innerNames [i], ": ", j);
            }
            stream:.write ('}');
        }                
    }
    
}
