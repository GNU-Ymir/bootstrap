/*
 * Defines a temporary type used during class construction to track which
 * fields have already been assigned a value.
 *
 * A `ClassFieldAccType` represents a *partial view* of a class type: only the
 * fields that have been validated so far are accessible. This allows the
 * validator to enforce that:
 *   - fields are not read before being initialized,
 *   - only the subset of validated fields is visible at each point in the
 *     constructor body,
 *   - once all fields are validated, the type behaves like a fully-initialized
 *     class reference.
 *
 * This type is used exclusively during semantic validation and is never
 * emitted into YIL.
 *
 * @warning
 *   Instances of this type are *mutable in place*. They are updated directly
 *   as fields become validated, and are not meant to be cloned. This is a
 *   deliberate performance optimization: temporary types are short-lived and
 *   never escape the validation phase.
 *
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::generator::type::temporary::classfield
 * @File: ymirc/semantic/generator/type/temporary/classfield.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2025-09-22
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in classfield;

use ymirc::lexing::word;
use ymirc::semantic::generator::{value, type::_, value::_};

use ymirc::semantic::{symbol, template_};
use ymirc::lexing::keys;

use std::stream;
use ymirc::utils::{format, comparison};


/**
 * Temporary type representing the set of fields that have been initialized
 * during the construction of a class instance.
 *
 * This type models a *progressive* view of a class: at any point in the
 * constructor, only the fields that have been assigned a value are accessible.
 *
 * Properties:
 *   - `classRef` identifies the class being constructed.
 *   - The type is always immutable(`isMutable = false`), since it does not
 *     represent a runtime value.
 *
 * Once all fields are validated, this type becomes equivalent to the full
 * class reference for the purposes of field access.
 */
@final
pub class ClassFieldAccType over TemporaryType {

    /*! Public fields */
    pub {
        // The type being constructed, whom `self` is a subset of.
        let classRef: &ClassRefType;
    }

    prv {
        // Set of field names that have already been assigned a value.
        // A field is accessible only if it appears in this map.
        let dmut _validatedFields: [[c8] => ()] = copy [];
    }


    /**
     * Create a new class-field-access temporary type.
     *
     * @params:
     *   - loc:      location of the constructor in user code
     *   - classRef: the class being constructed
     *   - full:     if true, all fields are marked as validated from the start
     *
     * When `full` is true, this type behaves as if the entire class were already
     * initialized(useful for desugaring or synthetic constructors).
     */
    pub self (loc: &Word, classRef: &ClassRefType, full: bool = false)
        with super (loc)
        , classRef = classRef
    {
        if full {
            for i in classRef.getLocalFields() {
                self._validatedFields[i.getLoc().str] = ();
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns true iff the given field has already been validated and is
     *          therefore accessible.
     */
    pub fn isFieldValidated(self, name: [c8])-> bool {
        name in self._validatedFields
    }

    /**
     * Mark a field as validated.
     *
     * @param name  the name of the field that has just been assigned a value
     */
    pub fn insertValidated(mut self, name: [c8]) {
        self._validatedFields[name] = ();
    }

    /**
     * Temporary class-field-access types are only compatible with other
     * ClassFieldAccType instances referring to the same class.
     */
    pub over isCompatible(self, o: &Type)-> bool {
        self.opEquals(o)
    }


    impl Comparable!{&Generator} {

        /**
         * Two ClassFieldAccType instances are equal iff they refer to the same
         * underlying class. The set of validated fields is intentionally ignored:
         * equality is structural, not state-based.
         */
        pub over opEquals(self, o: &Generator)-> bool {
            if let cf: &ClassFieldAccType = o {
                return self.classRef == cf.classRef;
            }

            return false;
        }
    }

    impl Streamable;
    impl Formattable {
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(format("&(%)::fields", self._cref));
        }
    }

}
