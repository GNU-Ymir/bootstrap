 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in traitref;

use ymirc::semantic::validator;
use ymirc::semantic::{symbol, template_};

use ymirc::lexing::{keys, word};
use ymirc::utils::{format, comparison};

use std::stream;

/**
 * Temporary type representing a reference to a trait symbol.
 *
 * A TraitRefType:
 *   - stores the TraitSymbol associated with a trait declaration,
 *   - is used during validation when traits are referenced but not yet applied,
 *   - does not describe a runtime type and cannot appear in YIL,
 *   - is replaced by concrete type information once trait resolution completes.
 *
 * This type exists solely to support semantic analysis of trait references.
 */
@final
pub class TraitRefType over TemporaryType {

    /*! Public fields */
    pub {
        // The trait symbol referenced by this placeholder.
        let sym: &TraitSymbol;
    }

    /**
     * Create a temporary reference to a trait symbol.
     *
     * @params:
     *   - loc: source location of the trait reference
     *   - symbol: the trait symbol being referenced
     */
    pub self (loc: &Word, sym: &TraitSymbol)
        with super (loc)
        , sym = sym
    {}

    /**
     * @returns: the list of templates used to specialize the class
     * */
    @field
    pub fn templateMapper(self)-> (TemplateMapper)? {
        return self.sym.templateMapper;
    }

    /**
     * TraitRefType is compatible only with another TraitRefType
     * referencing the same trait symbol.
     */
    pub over isCompatible(self, o: &Type)-> bool {
        self == o
    }

    impl Comparable!{&Generator} {

        /**
         * Two TraitRefType instances are equal iff they refer to the same
         * underlying TraitSymbol.
         */
        pub over opEquals(self, o: &Generator)-> bool {
            if let p: &TraitRefType = o {
                return self.sym is p.sym
            }

            return false;
        }
    }

    impl Streamable;
    impl Formattable {

        /**
         * Format the trait reference using its fully qualified path.
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(self.sym.path.toStr());
        }
    }


}
