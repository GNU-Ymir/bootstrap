/*
 * Declares the ClassRefType class.
 *
 * A ClassRefType represents the semantic description of a user-defined
 * aggregate type introduced with the keywords `class`, `record`, or `entity`.
 * It stores all structural information required during validation:
 *   - local fields,
 *   - ancestor class,
 *   - implemented traits,
 *   - constructors and template constructors,
 *   - vtable layout and method protections,
 *   - destructor,
 *   - typeinfo,
 *   - template specializations.
 *
 * ClassRefType is a *temporary* type: it is structurally mutable and is
 * progressively filled in during class validation. It is never used directly
 * in YIL generation. Instead, it must be wrapped inside a ClassPtrType, which
 * represents the actual runtime type(including mutability semantics).
 *
 * This type exists solely to support semantic validation and is not a
 * first-class runtime type.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::generator::type::temporary::classref
 * @File: ymirc/semantic/generator/type/temporary/classref.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2021-11-26
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in classref;

use ymirc::lexing::word;

use ymirc::semantic::generator::value;
use ymirc::semantic::generator::{type, value, value::_, type::_};

use ymirc::semantic::{symbol, template_};
use ymirc::lexing::keys;

use std::stream;
use ymirc::utils::{format, comparison};

/**
 * Method protection levels inherited from the class hierarchy.
 *
 * These values encode the effective visibility of methods and constructors
 * after inheritance resolution.
 */
pub enum MethodProtection
| PRV_PARENT = 0u8   // private in parent, invisible to children
| PRV        = 1u8   // private in this class
| PROT       = 2u8   // protected
| PUB        = 3u8;   // public

/**
 * Semantic descriptor for a user-defined class, record, or entity.
 *
 * A ClassRefType is the *inner* type stored inside a ClassPtrType. It contains
 * all structural information about the aggregate type but does not itself
 * represent a runtime value.
 *
 * Properties:
 *   - Structurally mutable: the validator fills in fields, methods, traits,
 *     and vtable entries as they are discovered.
 *   - Temporary: must be wrapped in a ClassPtrType before being used as a
 *     concrete type.
 *   - Immutable at the type level(`isMutable = false`), since mutability is
 *     handled by ClassPtrType.
 *
 * ClassRefType instances are unique per class symbol and are updated in place
 * during validation.
 *
 */
@final
pub class ClassRefType over TemporaryType {

    /*! Public fields*/
    pub {
        // The symbol in the symbol table, referenced by `self`
        let sym: &ClassSymbol;
    }

    /*! Private mutable fields */
    prv {

        // The ancestor of the class
        let mut _ancestor: (&ClassRefType)? = none;

        // The list of fields of the class (only local fields declared in the class def, not in ancestor)
        let mut _localFields: [&VarDeclValue] = [];

        // True iif ctors have been validated(even with no value)
        let mut _hasCtors: bool = false;

        // True when vtable is set
        let mut _hasVtable: bool = false;

        // True when fields are set
        let mut _hasFields: bool = false;

        // The list of constructors of the class
        let mut _ctors: [&CtorPrototypeValue] = [];

        // The protection of the constructors
        let mut _ctorProts: [MethodProtection] = [];

        // The template constructors of the class
        let mut _templateCtors: [&TemplateRefCtorValue] = [];

        // The protection of the template ctors
        let mut _templateCtorProts: [MethodProtection] = [];

        // The list of traits implemented by the class
        let mut _impls: [&TraitRefType] = [];

        // local and ancestor trait implementations
        let mut _allImpls: [&TraitRefType] = [];

        // The list of prototypes of the vtable
        let mut _vtable: [&MethodPrototypeValue] = [];

        // The prototype of the destructor
        let mut _dtor: &Value = UNIT_VALUE;

        // The protection of the methods(@assert self._methodProts.len == self._vtable.len)
        let mut _methodProts: [MethodProtection] = [];

        // The typeinfo of the class
        let mut _typeinfo: &Value = UNIT_VALUE;

        // Whether the typeinfo was generated in fake mode, i.e. during a precary
        // validation whose fields are still ERROR_TYPE placeholders
        let mut _fakeTypeinfo: bool = false;

        // The list of template methods
        let mut _templateMeths: [&TemplateRefMethodValue] = [];

        // The list of protection of the template methods
        let mut _templateProts: [MethodProtection] = [];
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Create a new ClassRefType.
     *
     * @params:
     *   - loc: source location of the class definition
     *   - sym: the class symbol(validated or partially validated)
     *
     * The ClassRefType starts empty and is progressively filled in by the class
     * validator.
     */
    pub self (loc: &Word, sym: &ClassSymbol)
        with super (loc)
        , sym = sym
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub fn setAncestor(mut self, ancestor: &ClassRefType) {
        self._ancestor = ancestor?;
    }

    pub fn setTypeInfo(mut self, ti: &TypeInfoValue, fake: bool = false) {
        self._typeinfo = ti;
        self._fakeTypeinfo = fake;
    }

    pub fn setLocalFields(mut self, localFields: [&VarDeclValue]) {
        self._localFields = localFields;
        self._hasFields = true;
    }

    pub fn setImpls(mut self, impls: [&TraitRefType], allImpls: [&TraitRefType]) {
        self._impls = impls;
        self._allImpls = allImpls;
    }

    pub fn setVtable(mut self,
                      vtable: [&MethodPrototypeValue],
                      methodProtections: [MethodProtection],
                      impls: [&TraitRefType],
                      allImpls: [&TraitRefType],
                      templateMeths: [&TemplateRefMethodValue],
                      templateProts: [MethodProtection]) {

        self._vtable = vtable;
        self._methodProts = methodProtections;
        self._impls = impls;
        self._allImpls = allImpls;
        self._templateMeths = templateMeths;
        self._templateProts = templateProts;
        self._hasVtable = true;
    }

    pub fn setDtor(mut self, dtor: &Value) {
        self._dtor = dtor;
    }

    pub fn setCtors(mut self, ctors: [&CtorPrototypeValue], ctorProts: [MethodProtection]) {
        self._ctors = ctors;
        self._ctorProts = ctorProts;
        self._hasCtors = true;
    }

    pub fn setTemplateCtors(mut self, ctors: [&TemplateRefCtorValue], ctorProts: [MethodProtection]) {
        self._templateCtors = ctors;
        self._templateCtorProts = ctorProts;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          COMPARISON          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * ClassRefType is only compatible with another ClassRefType referring to the
     * same class symbol. Mutability is handled by ClassPtrType, not here.
     */
    pub over isCompatible(self, o: &Type)-> bool {
        self == o
    }


    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          CLONING          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Create a ClassPtrType instance wrapping this ClassRefType.
     *
     * @params:
     *   - loc:            location of the pointer type(defaults to class location)
     *   - isMutable:      mutability of the pointer itself
     *   - isInnerMutable: mutability of the referenced class instance
     *
     * @returns a new ClassPtrType describing a pointer to this class.
     *
     * @example:
     *   ```
     *   let x: &ClassRefType = ...;
     *   let y = x.createInstance(true, true);   // mut &(mut)
     *   let z = x.createInstance(true, false);  // mut &()
     *   let w = x.createInstance(false, true);  // &(), allowed but meaningless
     *   ```
     **/
    pub fn createInstance(self,
                           loc: &Word = EOF_WORD,
                           isMutable: bool,
                           isInnerMutable: bool)-> &ClassPtrType {

        copy ClassPtrType(if (loc.isEof) { self.loc } else { loc }
                          , self.sym
                          , isMutable-> isMutable
                          , isInnerMutable-> isInnerMutable)
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    @field
    pub fn ancestor(self)-> (&ClassRefType)? {
        self._ancestor
    }

    @field
    pub fn hasAncestor(self)-> bool {
        self._ancestor.hasValue
    }

    /**
     * @returns: the list of fields of the class type(validated fields)
     */
    @field
    pub fn fields(self)-> [&VarDeclValue] {
        if let Ok(cl) = self._ancestor {
            return cl.fields ~ self._localFields;
        }

        self._localFields
    }

    /**
     * @returns: the list of field that are declared by the class, not by an ancestor
     */
    @field
    pub fn localFields(self)-> [&VarDeclValue] {
        self._localFields
    }


    /**
     * @returns true iff the class validator has reached the field-validation phase.
     *
     * @note
     *   A return value of `false` does *not* mean the class has no fields.
     *   It only means that field validation has not been performed yet.
     *
     *   Conversely, this may return `true` even when `self.fields.len == 0`,
     *   for classes that simply declare no fields.
     */
    @field
    pub fn hasFields(self)-> bool {
        self._hasFields
    }

    /**
     * @returns: the method prototype of the destructor
     */
    @field
    pub fn dtor(self)-> &Value {
        self._dtor
    }

    /**
     * @returns: the list of constructor prototypes of the class
     */
    @field
    pub fn ctors(self)-> [&CtorPrototypeValue] {
        self._ctors
    }

    /**
     * @returns true iff constructor validation has been performed.
     *
     * @note
     *   A return value of `false` means the validator has not yet processed
     *   constructors — not that the class will never have constructors.
     *
     *   This may return `true` even when `self.ctors.len == 0`, for classes
     *   that do not declare any constructors.
     */
    @field
    pub fn hasCtors(self)-> bool {
        self._hasCtors
    }

    /**
     * @returns: the list of protection of the constructors of the class
     */
    @field
    pub fn ctorProtections(self)-> [MethodProtection] {
        self._ctorProts
    }

    /**
     * @returns: the list of template constructors
     * */
    @field
    pub fn templateCtors(self)-> [&TemplateRefCtorValue] {
        self._templateCtors
    }

    /**
     * @returns: the protections of the template ctors
     * */
    @field
    pub fn templateCtorProtections(self)-> [MethodProtection] {
        self._templateCtorProts
    }

    /**
     * @returns: the list of method prototype declared in the vtable
     */
    @field
    pub fn vtable(self)-> [&MethodPrototypeValue] {
        self._vtable
    }

    /**
     * @returns true iff the class validator has completed vtable construction.
     *
     * @note
     *   A return value of `false` means vtable validation has not yet occurred.
     *   It does *not* imply that the class will not have a vtable.
     *
     *   This may return `true` even when `self.vtable.len == 0`, for classes
     *   that do not declare virtual methods.
     */
    @field
    pub fn hasVtable(self)-> bool {
        self._hasVtable
    }

    /**
     * @returns: the list of protections of the methods declared in the vtable
     */
    @field
    pub fn vtableProtections(self)-> [MethodProtection] {
        self._methodProts
    }

    /**
     * @returns: the list of methods that are declared as templates(and therefore not in the vtable)
     * */
    @field
    pub fn templateMethods(self)-> [&TemplateRefMethodValue] {
        self._templateMeths
    }

    /**
     * @returns: the list of the protections of the methods that are declared as templates
     * */
    @field
    pub fn templateMethodProtections(self)-> [MethodProtection] {
        self._templateProts
    }

    /**
     * @returns: the list of traits implemented by the class directly(not by ancestors)
     */
    @field
    pub fn implementedTraits(self)-> [&TraitRefType] {
        self._impls
    }

    /**
     * @returns: the list of traits implemented by the class and by its ancestors
     */
    @field
    pub fn allImplementedTraits(self)-> [&TraitRefType] {
        self._allImpls
    }

    /**
     * @returns: the typeinfo of the class
     * */
    @field
    pub fn typeInfo(self)-> &Value {
        self._typeinfo
    }

    /**
     * @returns true iff the class has been assigned a typeinfo value.
     *
     * @note
     *   A return value of `false` means typeinfo has not yet been generated.
     *   It does not imply that the class will never have typeinfo.
     *
     *   Being set is enough to reference the class(that is what fake typeinfos
     *   are for), but not to consider it fully validated — cf. hasCompleteTypeInfo.
     */
    @field
    pub fn hasTypeInfo(self)-> bool {
        self._typeinfo !of UnitValue
    }

    /**
     * @returns true iff the class has been assigned a definitive typeinfo.
     *
     * @note
     *   A typeinfo generated in fake mode(precary validation) carries a size of 0
     *   and leaves the fields as ERROR_TYPE placeholders, so it does not mean the
     *   class is fully validated. Only this predicate does.
     */
    @field
    pub fn hasCompleteTypeInfo(self)-> bool {
        self._typeinfo !of UnitValue && !self._fakeTypeinfo
    }

    /**
     * @returns: the list of templates used to specialize the class
     * */
    @field
    pub fn templateMapper(self)-> (TemplateMapper)? {
        self.sym.templateMapper
    }

    impl Comparable!{&Generator} {

        /**
         * Two ClassRefType instances are equal iff they refer to the same class
         * symbol. Structural state(fields, vtable, etc.) is intentionally ignored.
         */
        pub over opEquals(self, o: &Generator)-> bool {
            if let cl: &ClassRefType = o {
                return self.sym is cl.sym;
            }
            
            return false;
        }        
    }

    impl Streamable;
    impl Formattable {
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(self.sym.path.toStr());
        }
    }


}
