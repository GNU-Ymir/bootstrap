in custom;

use ymirc::lexing::word;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

mod ::classptr;
mod ::enum_;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          TYPES          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub def ClassPtrType: classptr::ClassPtrType;
pub def EnumType: enum_::EnumType;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          ANCESTOR          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * Base class for all user-defined types.
 *
 * CustomType is the abstract ancestor of all types defined by user code,
 * including class pointers, enums, and any future custom constructs. It
 * extends the core Type class by providing a common foundation for types
 * whose structure and semantics originate from user declarations rather than
 * from the built-in type family.
 *
 * CustomType:
 *   - carries source-location and mutability information,
 *   - participates in the standard Type interface,
 *   - does not impose any structure of its own,
 *   - serves as a dispatch root for semantic rules specific to user-defined
 *     types (e.g., class mutability, enum proxy behavior).
 *
 * Concrete subclasses must implement all semantic behaviors such as
 * compatibility, mutability fitting, cloning, and formatting.
 */
@abstract
pub class CustomType over Type {

    /**
     * Construct a custom type.
     *
     * @params:
     *   - loc:       source location of the type expression
     *   - isMutable: true iff the custom type itself is mutable
     *
     * This constructor simply forwards the parameters to the base Type class.
     * Subclasses may extend or reinterpret mutability semantics as needed.
     */
    pub self (loc: &Word, isMutable: bool)
        with super (loc, isMutable-> isMutable)
    {}
}
