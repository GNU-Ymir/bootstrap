/*
 * Declares the TypeWrapperExpr class.
 *
 * A TypeWrapperExpr is a synthetic AST node used during template rewriting to
 * embed a semantic type directly inside the syntax tree. When the semantic
 * visitor encounters this node, it simply returns the wrapped type, optionally
 * preserving its mutability depending on the `asIs` flag.
 *
 * This mechanism allows template rewriting to temporarily replace or restructure
 * type expressions without losing the original semantic type information.
 * TypeWrapperExpr nodes never appear in user code and are removed during
 * semantic validation.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::generator::type::syntax::wrapper
 * @File: ymirc/semantic/generator/type/syntax/wrapper.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2021-11-20
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in wrapper;

use ymirc::syntax::expression;
use ymirc::lexing::{word, keys};

use ymirc::utils::{format, comparison};

use std::stream;


/**
 * Synthetic AST node wrapping a single semantic type.
 *
 * A TypeWrapperExpr:
 *   - stores a semantic type inside the syntax tree,
 *   - is used during template rewriting and macro expansion,
 *   - is returned as-is by the semantic visitor,
 *   - optionally preserves the mutability of the wrapped type(`asIs = true`),
 *
 * This class exists solely to preserve semantic type information across
 * syntactic transformations.
 */
@final
pub class TypeWrapperExpr over Expression {

    /*! Public fields */
    pub {
        // The semantic type wrapped by this expression.
        let type: &Type;

        // If true, the mutability of the wrapped type is preserved exactly
        // when validated. If false, a const type is created.
        let asIs: bool;
    }

    /**
     * Create a wrapper expression containing a semantic type.
     *
     * @params:
     *   - loc:    source location of the wrapper node
     *   - type:   the semantic type being wrapped
     *   - asIs:   if true, the type's mutability is left unchanged during validation(always const if asId = false)
     */
    pub self (loc: &Word, type: &Type, asIs: bool = false)
        with super (loc)
        , type = type
        , asIs = asIs
    {}

    impl Comparable!{&Expression} {

        /**
         * Two TypeWrapperExpr instances are equal iff they wrap the same semantic type.
         */
        pub over opEquals(self, o: &Expression)-> bool {

            if let t: &TypeWrapperExpr = o {
                return t.type == self.type;
            }

            return false;
        }
    }

    impl Streamable;
    impl Formattable {

        /**
         * Format the wrapped type directly.
         * The wrapper itself has no visible syntax.
         */
        pub over format(self, dmut stream: &Formatter) {
            self.type.format(alias stream);
        }
    }

}
