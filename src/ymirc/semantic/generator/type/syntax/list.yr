/*
 * Declares the TypeListWrapperExpr class.
 *
 * A TypeListWrapperExpr is a synthetic AST node used during template rewriting
 * and macro expansion to embed a list of semantic types directly inside the
 * syntax tree. When the semantic visitor encounters this node, it simply
 * returns the wrapped list of types.
 *
 * This mechanism ensures that template rewriting can restructure or replace
 * type expressions without losing the original semantic type information.
 * These wrapper nodes never appear in user code and are removed during
 * semantic validation.
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::semantic::generator::type::syntax::list
 * @File: ymirc/semantic/generator/type/syntax/list.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2021-11-20
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in list;

use ymirc::syntax::expression;
use ymirc::lexing::{word, tokens};

use ymirc::utils::{format, comparison};
use std::stream;

/**
 * Synthetic AST node wrapping a list of semantic types.
 *
 * A TypeListWrapperExpr:
 *   - stores a list of semantic types inside the syntax tree,
 *   - is used during template rewriting and macro expansion,
 *   - is returned directly by the semantic visitor,
 *   - is never emitted into YIL,
 *   - preserves type information across syntactic transformations.
 *
 * This class exists solely to support semantic analysis of type lists.
 */
@final
pub class TypeListWrapperExpr over Expression {

    pub {
        // The list of semantic types wrapped by this node.
        let types: [&Type];
    }

    /**
     * Create a wrapper expression containing a list of semantic types.
     *
     * @params:
     *   - loc:   source location of the wrapper node
     *   - types: the list of semantic types being wrapped
     */
    pub self (loc: &Word, types: [&Type])
        with super (loc)
        , types = types
    {}


    impl Comparable!{&Expression} {

        /**
         * Two TypeListWrapperExpr instances are equal iff they wrap identical
         * lists of semantic types.
         */
        pub over opEquals (self, o: &Expression)-> bool {            
            if let t: &TypeListWrapperExpr = o {
                return t.types == self.types;
            }

            return false;
        }
    }
    
    impl Streamable;
    impl Formattable {

        /**
         * Format the wrapped type list using tuple-like syntax:
         *     (T1, T2, ..., ...)
         *
         * A trailing comma is emitted for single-element lists to preserve
         * tuple semantics.
         */
        pub over format (self, dmut stream: &Formatter) {
            stream:.write (Tokens::LPAR);
            for i, j in self.types {
                if (i != 0us) stream:.write (", ");
                j.format (alias stream);
            }
            if (self.types.len == 1us) stream:.write (",");
            stream:.write (',', Tokens::TDOT, Tokens::RPAR);
        }        
    }
    
}
