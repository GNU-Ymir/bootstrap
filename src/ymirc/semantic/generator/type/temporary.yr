 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in temporary;

use ymirc::lexing::word;
use ymirc::utils::{format, comparison};

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

mod ::classref;
mod ::classfield;
mod ::closure;
mod ::lambda;
mod ::mapiterator;
mod ::templateref;
mod ::traitref;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          TYPES          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */


pub def ClassFieldAccType: classfield::ClassFieldAccType;
pub def ClassRefType: classref::ClassRefType;
pub def ClosureType: closure::ClosureType;
pub def LambdaType: lambda::LambdaType;
pub def MapIteratorType: mapiterator::MapIteratorType;
pub def TemplateRefType: templateref::TemplateRefType;
pub def TraitRefType: traitref::TraitRefType;
pub def MethodProtection: classref::MethodProtection;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          ANCESTOR          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */


/**
 * Base class for all temporary types.
 *
 * A temporary type is a semantic placeholder used during validation when the
 * structure of a type is known but not yet fully resolved. Examples include:
 *   - unresolved class references,
 *   - partially instantiated templates,
 *   - lambda or closure types awaiting inference,
 *   - iterator/map types awaiting element resolution.
 *
 * Temporary types:
 *   - are never addressable,
 *   - never borrow data,
 *   - may be mutable or immutable at their outermost layer,
 *   - participate in mutability comparisons only at the top level,
 *   - must eventually be replaced by a concrete, validated type.
 *   
 */
@abstract
pub class TemporaryType over Type {

    pub self (loc: &Word)
        with super (loc, isMutable-> false)
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * A temporary type is considered deeply mutable iff its outermost layer
     * is mutable. Since temporary types have no inner structure, this is
     * equivalent to `self.isMutable`.
     */
    @field
    pub over isDeeplyMutable (self)-> bool {
        self.isMutable
    }
    
    /**
     * Temporary types never require explicit aliasing, since they do not
     * represent borrowed data and cannot appear in addressable positions.
     */
    @field
    pub over needsExplicitAlias (self)-> bool {
        false
    }
    
    /**
     * Temporary types never borrow data. They are purely structural placeholders.
     */
    @field
    pub over borrowsData (self)-> bool {
        false
    }

    /**
     * Temporary types are never addressable, since they do not correspond to
     * runtime values or memory locations.
     */
    @field
    pub over isAddressable (self)-> bool {
        false
    }

    
    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          COMPARISON          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Temporary types participate in mutability fitting only at the outermost
     * level. Since they have no inner structure, the only constraint is:
     *
     *   - if we are inside a borrowed context (`borrowed == true`),
     *     then assigning a mutable temporary type into an immutable one
     *     is forbidden.
     *
     * Otherwise, temporary types are always considered compatible.
     * 
     */
    pub over mutabilityFit (self, o: &Type, borrowed: bool)-> bool {
        if (borrowed) {
            if (!self.isMutable && o.isMutable) return false;
        }

        true
    }

    /**
     * Compute the mutability distance between two temporary types.
     *
     * Since temporary types have no inner structure, the distance is:
     *   - 1 if a mutable borrowed component becomes const,
     *   - 0 otherwise.
     */
    pub over mutabilityDistance (self, o: &Type, borrowed: bool)-> u32 {
        if (borrowed) {
            if (self.isMutable && !o.isMutable) return 1u32;
        }

        0u32
    }

    /**
     * Maximum mutability distance for temporary types.
     *
     * Since they contain no inner borrowed components, the maximum distance is:
     *   - 1 if inside a borrowed context,
     *   - 0 otherwise.
     */
    prot over computeMaxMutabilityDistance (self, borrowed: bool)-> u32 {
        if (borrowed) {
            return 1;
        }

        return 0;
    }
    
    /**
     * @returns true iff both temporary types have the same outer mutability.
     */
    pub over sameMutability (self, o: &Type)-> bool {
        return (self.isMutable == o.isMutable);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          CLONING          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Cloning a TemporaryType is a no-op.          
     */
    @final
    pub over clone (self, _ : u32)-> &Type {
        self
    }
    
    /**
     * Cloning a TemporaryType is a no-op.               
     */
    @final
    pub over clone (self, o: &Type)-> &Type {        
        return self;
    }

    /**
     * Cloning a TemporaryType is a no-op.               
     */
    @final
    pub over toDeeplyMutable (self)-> &Type {        
        return self;        
    }

    /**
     * Cloning a TemporaryType is a no-op.                    
     */
    @final
    pub over cloneMutableUntilBorrow (self)-> &Type {
        return self.toDeeplyMutable (); // we don't borrow, so similar stuff        
    }

}
