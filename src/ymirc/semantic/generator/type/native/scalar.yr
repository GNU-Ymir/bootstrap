 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in scalar;

use ymirc::lexing::word;
use ymirc::utils::{format, comparison};
use std::stream;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ===================================          SUBMODULES          ===================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub mod ::async_;
pub mod ::bool_;
pub mod ::char;
pub mod ::delegate;
pub mod ::error;
pub mod ::float;
pub mod ::fptr;
pub mod ::future_;
pub mod ::int;
pub mod ::none_;
pub mod ::void_;
pub mod ::yield_;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          ANCESTOR          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * Base class for all scalar native types.
 *
 * A ScalarType represents any native type that is semantically indivisible:
 * it behaves as a single atomic value, even if its runtime representation
 * contains multiple fields. Scalar types cannot be decomposed into inner
 * components by the language and expose no structural subtyping.
 *
 * Examples include:
 *   - primitive values (integers, floats, booleans, characters),
 *   - control types (`void`, `none`, `error`),
 *   - callable types (`fn`, `dg`),
 *   - opaque runtime handles (`future`, `lazy`, etc.).
 *
 * Scalar types:
 *   - have no inner structure in the semantic model,
 *   - derive mutability solely from their outermost layer,
 *   - never borrow data and never require explicit aliasing,
 *   - are always addressable,
 *   - form the foundation of Ymir’s primitive and atomic type system.
 *
 * Concrete scalar types extend this class to implement their specific
 * semantics while inheriting the shared mutability and compatibility rules.
 */
@abstract
pub class ScalarType over NativeType {

    /**
     * Construct a scalar native type.
     *
     * @params:
     *   - loc:       source location of the type expression
     *   - isMutable: true iff the scalar type is mutable
     *
     * Scalar types have no inner structure; their mutability applies only to
     * the value as a whole.
     */
    pub self (loc: &Word, isMutable: bool = false)
        with super (loc, isMutable-> isMutable)
    {}

    /**
     * A scalar type is deeply mutable iff its outermost layer is mutable.
     * Scalars have no inner structure, so this is equivalent to `isMutable`.
     */
    @field
    pub over isDeeplyMutable (self)-> bool {
        self.isMutable
    }

    /**
     * Scalar types never require explicit aliasing, since they do not borrow
     * data and cannot contain borrowed components.
     */
    @field
    pub over needsExplicitAlias (self)-> bool {
        false
    }

    /**
     * Scalar types never borrow data.
     */
    @field
    pub over borrowsData (self)-> bool {
        false
    }

    /**
     * Determine whether this scalar type can fit into another type under the
     * given borrowing context.
     *
     * When borrowed:
     *   - assigning a mutable scalar into an immutable one is forbidden.
     */
    pub over mutabilityFit (self, o: &Type, borrowed: bool)-> bool {
        if (borrowed) {
            if (!self.isMutable && o.isMutable) return false;
        }

        true
    }

    /**
     * Compute the mutability distance between two scalar types.
     *
     * When borrowed:
     *   - converting a mutable scalar into an immutable one costs 1,
     *   - all other conversions cost 0.
     */
    pub over mutabilityDistance (self, o: &Type, borrowed: bool)-> u32 {
        if (borrowed) {
            if (self.isMutable && !o.isMutable) return 1u32;
        }

        0u32
    }

    /**
     * Maximum mutability distance for scalar types.
     *
     * Scalars have no inner structure, so the maximum distance is:
     *   - 1 when borrowed,
     *   - 0 otherwise.
     */
    prot over computeMaxMutabilityDistance (self, borrowed: bool)-> u32 {
        if (borrowed) {
            return 1u32;
        }

        0u32
    }

    /**
     * @returns true iff both scalar types have the same mutability.
     */
    pub over sameMutability (self, o: &Type)-> bool {
        return (self.isMutable == o.isMutable);
    }

    /**
     * Clone this scalar type to match the mutability of another type.
     *
     * Since scalar types have no inner structure, only the outer mutability
     * may differ. If mutability already matches, the same instance is returned.
     */
    pub over clone (self, o: &Type)-> &Type {
        if (o.isMutable && !self.isMutable) {
            self.clone (1u32)
        } else if (!o.isMutable && self.isMutable) {
            self.clone (0u32)
        } else {
            self
        }
    }

    /**
     * Produce a deeply mutable version of this scalar type.
     */
    pub over toDeeplyMutable (self)-> &Type {
        if (self.isMutable) { self }
        else {
            self.clone (1u32)
        }
    }

    /**
     * Clone the type, making it mutable until a borrow is encountered.
     *
     * Scalar types never borrow, so this always produces a mutable clone.
     */
    pub over cloneMutableUntilBorrow (self)-> &Type {
        self.clone (1u32)
    }

    /**
     * Scalar types are always addressable.
     */
    @field
    pub over isAddressable (self)-> bool {
        true
    }


    impl Streamable;
    impl Formattable;
}
