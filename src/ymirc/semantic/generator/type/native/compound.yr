 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in compound;


use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub mod ::array;
pub mod ::map;
pub mod ::option;
pub mod ::pointer;
pub mod ::range;
pub mod ::slice;
pub mod ::tuple;


/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          ANCESTOR          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * Base class for all compound native types.
 *
 * A CompoundType:
 *   - is a native type composed of one or more inner types,
 *   - derives its addressability and mutability from its inner components,
 *   - provides shared behavior for all built-in aggregate types,
 *   - is extended by concrete compound types such as ArrayType, MapType,
 *     TupleType, SliceType, etc.
 *
 * The `inners` field stores the semantic types of the components that make up
 * the compound structure.
 */
@abstract
pub class CompoundType over NativeType {

    pub {
        // The inner types that define the structure of this compound type.
        let inners: [&Type];
    }

    /**
     * Construct a compound native type.
     *
     * @params:
     *   - loc:       source location of the type expression
     *   - inners:    the list of inner types that define the structure of this compound type
     *   - isMutable: true iff the compound type itself is mutable
     *
     * The `inners` array describes the semantic components of the compound type
     * (e.g., element type for arrays, key/value types for maps, member types for
     * tuples). Concrete compound types interpret this list according to their own
     * structure.
     */
    pub self (loc: &Word, isMutable: bool)
        with super (loc, isMutable-> isMutable)
        , inners = inners
    {}

    /**
     * @returns true iff all inner types are addressable.
     *
     * A compound type is addressable only if each of its components is
     * addressable. This ensures that compound values behave consistently
     * with respect to memory access and borrowing rules.
     */
    @field
    pub over isAddressable(self)-> bool {
        for i in self.inners {
            if !i.isAddressable() return false;
        }

        true
    }

    impl Comparable!{&Generator};
    impl Streamable;
    impl Formattable;

}
