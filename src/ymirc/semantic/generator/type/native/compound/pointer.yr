/*
 * Declares the PointerType class.
 *
 * A PointerType represents a raw memory address pointing to a value of the
 * inner type. Pointers are low-level, unsafe constructs that allow direct
 * memory manipulation. They always borrow data, since dereferencing a pointer
 * accesses memory owned elsewhere.
 *
 * Pointer semantics in Ymir:
 *   - the inner type describes the pointed-to value,
 *   - mutability applies to the pointer itself (i.e., whether the pointer may
 *     be reassigned), not to the pointed-to value,
 *   - the mutability of the pointed-to value is encoded in the inner type,
 *   - `*(none)` is treated as a null pointer,
 *   - pointers always borrow data.
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::semantic::generator::type::native::compound::pointer
 * @File: ymirc/semantic/generator/type/native/compound/pointer.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2021-11-20
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in pointer;

use ymirc::semantic::generator::type::{native, custom};

use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::{format, comparison};

use std::stream;

/**
 * Native pointer type.
 *
 * A PointerType represents a raw pointer to a value of the inner type. The
 * pointer itself may be mutable or immutable, and the mutability of the
 * pointed-to value is encoded in the inner type.
 *
 * The `inners` array contains exactly one element:
 *   - inners[0] = pointed-to type T
 */
@final
pub class PointerType over CompoundType {

    /**
     * Construct a pointer type.
     *
     * @params:
     *   - loc:       source location of the type expression
     *   - inner:     the pointed-to type
     *   - isMutable: true iff the pointer itself is mutable
     *
     * Pointer types impose no restrictions on the inner type (unlike arrays or
     * maps), since pointers may reference any kind of value.
     */
    pub self (loc: &Word, inner: &Type, isMutable: bool)
        with super (loc, inners-> copy [inner], isMutable-> isMutable)
    {}

    /**
     * @returns: the type of the value being pointed
     * */
    @field
    pub fn pointed (self)-> &Type {
        self.inners [0]
    }
    
    /**
     * A pointer is deeply mutable iff:
     *   - the pointer itself is mutable, and
     *   - the pointed-to type is deeply mutable.
     */
    @field
    pub over isDeeplyMutable (self)-> bool {
        if (!self.isMutable) { false }
        else {
            self.inners [0us].isDeeplyMutable 
        }
    }

    /**
     * Pointers require explicit aliasing only when:
     *   - the pointer is mutable, and
     *   - the pointed-to type is mutable.
     *
     * A mutable pointer to a mutable value (`mut *(mut T)`) may change the
     * borrowed value, so aliasing rules apply.
     */
    @field
    pub over needsExplicitAlias (self)-> bool {
        if (!self.isMutable) { false } // *(T) does not mut on inner value
        else {
            self.inners [0us].isMutable // mut *(mut T), borrow can change
        }
    }

    /**
     * Pointers always borrow data.
     *
     * Dereferencing a pointer accesses memory owned elsewhere, so pointers are
     * inherently borrowing constructs.
     */
    @field
    pub over borrowsData (self)-> bool {
        true
    }

    /**
     * Pointers are compatible when their pointed-to types are compatible.
     */
    pub over isCompatible (self, o: &Type)-> bool {        
        if let s: &PointerType = o {
            return self.inners [0us].isCompatible (s.inners [0us]);
        }

        return false;        
    }

    /**
     * Mutability fitting for pointers.
     *
     * Rules:
     *   - immutable pointers fit into mutable ones only if borrowing rules allow it,
     *   - inner mutability must also fit,
     *   - null pointers (`*(none)`) fit any pointer type (i.e. the keyword `null` generates a *none),
     *   - pointers always borrow, so inner mutability is checked under
     *     `borrowed = true`.
     *
     * EnumType proxies are handled transparently.
     */
    pub over mutabilityFit (self, o: &Type, borrowed: bool)-> bool {
        match o {
            s: &PointerType => {
                if (!s.isMutable) return true;
                match (self.inners [0], s.inners [0]) { // null => anything, anything => null is always ok
                    (NoneType (), NoneType ()) => return true;
                }

                if (borrowed && !self.isMutable) return false;
                return self.inners [0us].mutabilityFit (s.inners [0us], borrowed-> true); // other is mut *(mut T), we need to check mutability of T
            }
            en: &EnumType => {
                return self.mutabilityFit (en.getLastLevelProxy (), borrowed-> borrowed);
            }
            _ => panic;
        }
    }

    /**
     * Compute the mutability distance between two pointers.
     *
     * Only the pointed-to type contributes to mutability distance. The outer
     * pointer layer contributes 1 when:
     *   - the pointer is borrowed, and
     *   - the target pointer is immutable.
     */
    pub over mutabilityDistance (self, o: &Type, borrowed: bool)-> u32 {
        match o {
            s: &PointerType => {
                if (!self.isMutable) return 0u32; // mut *T => anything = 0u32
                let mut inner = self.inners [0us].mutabilityDistance (s.inners [0us], borrowed-> true); // mut *(mut T) => need to have mut T => other.inner [0]

                if (borrowed && !s.isMutable) inner += 1u32;

                inner
            }
            en: &EnumType => {
                return self.mutabilityDistance (en.getLastLevelProxy (), borrowed-> borrowed);
            }
            _ => panic;
        }
    }


    /**
     * Compute the mutability distance for pointer types.
     *
     * Pointer distance reflects how many mutability layers must be discarded to
     * make this pointer fit the target. For pointers, this includes:
     *   - the outer pointer mutability (if lost), and
     *   - the mutability distance of the pointed-to type.
     *
     * Since pointers always borrow, the inner distance is evaluated with
     * `borrowed = true`.
     */
    prot over computeMaxMutabilityDistance (self, borrowed: bool)-> u32 {
        let inner = self.inners [0us].computeMaxMutabilityDistance (borrowed-> true);
        if (borrowed) {
            1u32 + inner
        } else {
            inner
        }
    }

    /**
     * Pointers have the same mutability iff:
     *   - their outer mutability matches, and
     *   - their pointed-to types have the same mutability.
     */
    pub over sameMutability (self, o: &Type)-> bool {
        match o {
            s: &PointerType => {
                if (self.isMutable != o.isMutable) return false;
                return self.inners [0].sameMutability (s.inners [0us]);
            }
            en: &EnumType => {
                return self.sameMutability (en.getLastLevelProxy ());
            }
        }

        panic;
    }

    /**
     * Clone the pointer, making it mutable until a borrow is encountered.
     *
     * Since pointers always borrow, this is equivalent to producing a mutable clone.
     */
    pub over cloneMutableUntilBorrow (self)-> &Type {
        self.clone (1u32)
    }

    /**
     * Clone the pointer type with a given mutability level.
     *
     * The pointed-to type receives one less mutability level.
     */
    pub over clone (self, mutLevel: u32)-> &Type {
        let innerLevel = if (mutLevel >= 1u32) { mutLevel - 1u32 } else { 0u32 };

        copy PointerType (self.loc, self.inners [0us].clone (innerLevel), isMutable-> (mutLevel != 0u32))
    }

    /**
     * Clone the pointer type to match the mutability pattern of another type.
     *
     * The pointed-to type is cloned according to the pattern’s pointed-to type.
     */
    pub over clone (self, pattern: &Type)-> &Type {
        match pattern {
            s: &PointerType => {
                let inner = self.inners [0us].clone (s.inners [0]);
                copy PointerType (self.loc, inner, isMutable-> s.isMutable)
            }
            _ => {
                let inner = self.inners [0us].clone (0);
                copy PointerType (self.loc, inner, isMutable-> pattern.isMutable)
            }
        }
    }

    /**
     * Produce a deeply mutable version of the pointer.
     *
     * The pointed-to type becomes deeply mutable.
     */
    pub over toDeeplyMutable (self)-> &Type {
        copy PointerType (self.loc, self.inners [0us].toDeeplyMutable (), isMutable-> true)
    }
    

    impl Comparable!{&Generator};
    impl Streamable;
    impl Formattable {

        /**
         * Format the pointer type using the syntax:
         *     *T
         * or:
         *     *(T)
         * when parentheses are required.
         *
         * Null pointers (`*(none)`) are printed as `*void`.
         * Mutability is printed as a prefix when present.
         */
        pub over format (self, dmut stream: &Formatter) {
            if (self.isMutable) stream:.write (Decorators::MUT, ' ');
            stream:.write (Tokens::STAR);
            if self.inners [0] of NoneType {
                stream:.write ("void"s8);
            }
            else if (self.inners [0] of NativeType && self.inners [0] !of CompoundType && !self.inners [0].isMutable) {
                self.inners [0us].format (alias stream);
            }
            else {
                stream:.write (Tokens::LPAR);
                self.inners [0us].format (alias stream);                
                stream:.write (Tokens::RPAR);
            }
        }                
    }
    
}
