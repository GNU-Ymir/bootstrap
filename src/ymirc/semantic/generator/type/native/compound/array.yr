in array;

use ymirc::semantic::generator::value::literal;
use ymirc::semantic::generator::type::custom;

use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::{format, comparison};

use ymirc::errors::message;
use ymirc::semantic::validator::errors;

use std::stream;

/**
 * Native fixed-size array type.
 *
 * An ArrayType represents a contiguous, compile-time-sized collection of
 * elements of a single inner type. Unlike slices, arrays have a statically
 * known length and their storage is embedded directly in the value itself.
 *
 * Arrays in Ymir:
 *   - have a size (`len`) known at compile time,
 *   - store their elements in a contiguous memory region, 
 *   - cannot contain movable types as elements,
 *   - derive mutability and borrowing behavior from their inner type.
 *
 * ArrayType is a native compound type and participates in the standard
 * mutability, compatibility, and cloning rules defined for compound types.
 */
@final
pub class ArrayType over CompoundType {

    /*! Public fields */
    pub {
        // The compile-time length of the array.
        let len: usize;
    }
    
    /**
     * Construct a fixed-size array type.
     *
     * @params:
     *   - loc:   source location of the type expression
     *   - inner: the element type of the array
     *   - len:   the compile-time constant length of the array
     *   - isMutable: true iff the array itself is mutable
     *
     * @throws ErrorMsg
     *   if the inner type is movable, since arrays cannot contain movable types.
     */
    pub self (loc: &Word, inner: &Type, len: usize, isMutable: bool)
        with super (loc, inners-> copy [inner], isMutable-> isMutable)
        , len = len

        throws ErrorMsg
    {
        if inner.isMovable {
            throw copy ErrorMsg::fatal (loc, end-> inner.loc, format (ValidateErrorMessage::CONTAIN_MOVABLE_TYPE, inner),
                                        notes-> copy [copy ErrorMsg::note (loc, format (ValidateErrorMessage::CONTAIN_MOVABLE_TYPE_NOTE), oneLine-> true)]);
        }
    }

    /**
     * @returns: the type of the contained values
     * */
    @field
    pub fn value (self)-> &Type {
        self.inners [0]
    }
    
    /**
     * Arrays are compatible only if:
     *   - they have the same length, and
     *   - their element types are compatible.
     */
    pub over isCompatible (self, o: &Type)-> bool {        
        if let s: &ArrayType = o {
            if (self.len != s.len) return false;
            if (!self.inners [0us].isCompatible (s.inners [0us])) return false;

            return true;
        }

        return false;
    }

    /**
     * Mutability fitting for arrays.
     *
     * Array mutability follows the general rules of CompoundType, with the
     * following array‑specific refinements:
     *
     *   - Assigning an immutable array into a mutable one is allowed only when
     *     borrowing rules permit it (i.e., a borrowed immutable array cannot
     *     satisfy a mutable target).
     *
     *   - Element mutability must also fit: the inner element type must satisfy
     *     the mutability constraints of the target array’s element type.
     *
     *   - Arrays do not borrow memory themselves, since assigning an array copies
     *     all of its elements. However, the *element type* may borrow data, and
     *     therefore the mutability rules of the inner type still apply.
     *
     */
    pub over mutabilityFit (self, o: &Type, borrowed: bool)-> bool {
        match o {
            a: &ArrayType => {
                if (!a.isMutable) return true;
                if (borrowed && !self.isMutable) return false;

                return self.inners [0us].mutabilityFit (a.inners [0us], borrowed-> borrowed);
            }
            en: &EnumType => {
                return self.mutabilityFit (en.getLastLevelProxy (), borrowed-> borrowed);
            }
            _ => panic;
        }
    } 

    /**
     * Compute the mutability distance between two arrays.
     * Includes:
     *   - outer mutability change,
     *   - inner element mutability distance.
     */
    pub over mutabilityDistance (self, o: &Type, borrowed: bool)-> u32 {
        match o {
            a: &ArrayType => {
                if (!self.isMutable) return 0u32;
                let inner = self.inners [0us].mutabilityDistance (a.inners [0us], borrowed-> borrowed);
                if (borrowed && !a.isMutable) {
                    1u32 + inner
                } else {
                    inner
                }
            }
            en: &EnumType => {
                return self.mutabilityDistance (en.getLastLevelProxy (), borrowed-> borrowed);
            }
            _ => {
                std::io::eprintln (o);
                panic;
            }
        }
    }

    /**
     * Maximum mutability distance for arrays:
     *   - 1 for the outer layer when borrowed,
     *   - plus the inner element's maximum distance.
     */    
    pub over computeMaxMutabilityDistance (self, borrowed: bool)-> u32 {
        let inner = self.inners [0us].computeMaxMutabilityDistance (borrowed);
        if (borrowed) {
            1u32 + inner
        } else {
            inner
        }
    }

    /**
     * An array is deeply mutable iff:
     *   - the array itself is mutable, and
     *   - its element type is deeply mutable.
     */
    @field
    pub over isDeeplyMutable (self)-> bool {
        if (!self.isMutable) {
            false
        } else {
            self.inners [0].isDeeplyMutable
        }
    }

    /**
     * Arrays require explicit aliasing only if:
     *   - they are mutable, and
     *   - their element type requires explicit aliasing.
     */
    @field
    pub over needsExplicitAlias (self)-> bool {
        if (!self.isMutable) {
            false
        } else {
            self.inners [0us].needExplicitAlias 
        }
    }
    
    /**
     * Arrays borrow data iff their element type does.
     */
    @field
    pub over borrowsData (self)-> bool {
        self.inners [0us].borrowsData
    }

    /**
     * Arrays have the same mutability iff:
     *   - their outer mutability matches, and
     *   - their element types have the same mutability.
     */
    pub over sameMutability (self, o: &Type)-> bool {
        match o {
            a: &ArrayType => {
                if (self.isMutable != o.isMutable) return false;
                return self.inners [0us].sameMutability (a.inners [0us]);
            }
            en: &EnumType => {
                return self.sameMutability (en.getLastLevelProxy ());
            }
        }

        panic;
    }

    /**
     * Clone the array type with a given mutability level.
     * The inner element type receives one less level of mutability.
     */
    pub over clone (self, mutLevel: u32)-> &Type {
        let innerLevel = if (mutLevel >= 1u32) { mutLevel - 1u32 } else { 0u32 };
        {
            copy ArrayType (self.loc, self.inners [0us].clone (innerLevel), self.len, isMutable-> (mutLevel != 0u32))
        } catch {
            _ => panic;
        }
    }

    /**
     * Clone the array type to match the mutability pattern of another type.
     */
    pub over clone (self, pattern: &Type)-> &Type {        
        if let a: &ArrayType = pattern {
            let inner = self.inners [0us].clone (a.inners [0us]);
            {
                copy ArrayType (self.loc, inner, self.len, isMutable-> a.isMutable)
            } catch {
                _ => panic;
            }
        }
        
        let inner = self.inners [0us].clone (0);
        {
            copy ArrayType (self.loc, inner, self.len, isMutable-> pattern.isMutable)
        } catch {
            _ => panic;
        }    
    }

    /**
     * Produce a deeply mutable version of the array.
     */
    pub over toDeeplyMutable (self)-> &Type {
        {
            copy ArrayType (self.loc, self.inners [0us].toDeeplyMutable (), self.len, isMutable-> true)
        } catch {
            _ => panic;
        }
    }

    /**
     * Clone the array, making it mutable until a borrow is encountered.
     */
    pub over cloneMutableUntilBorrow (self)-> &Type {
        let inner = self.inners [0].cloneMutableUntilBorrow ();
        {
            copy ArrayType (self.loc, inner, self.len, isMutable-> true)
        } catch {
            _ => panic;
        }
    }


    impl Comparable!{&Type};    
    impl Streamable;
    impl Formattable {

        /**
         * Format the array type using the syntax:
         *     [ T ; N ]
         */
        pub over format (self, dmut stream: &Formatter) {
            if (self.isMutable) stream:.write (Decorators::MUT, ' ');
            stream:.write (Tokens::LCRO);
            stream:.entabing ();
            self.inners [0us].format (alias stream);
            stream:.write (" ; "s8);
            stream:.write (self.len, "us"s8);
            stream:.detabing ();
            stream:.write (Tokens::RCRO);
        }                
    }
    
}
