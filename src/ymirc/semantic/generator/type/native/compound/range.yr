 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in range;

use ymirc::semantic::generator::type::{native, custom};
use ymirc::semantic::generator::value::literal;

use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::{format, comparison};

use std::stream;

use ymirc::errors::message;
use ymirc::semantic::validator;

/**
 * Native range type.
 *
 * A RangeType describes a numeric range defined by a starting integer and a
 * step integer. Both components are stored as inner types and are cloned with
 * the appropriate mutability level when the range is constructed.
 *
 * The `inners` array contains:
 *   - inners[0] = start value type (IntType)
 *   - inners[1] = step value type (IntType)
 */
@final
pub class RangeType over CompoundType {

    /**
     * Construct a range type.
     *
     * @params:
     *   - loc:       source location of the type expression
     *   - inner:     the integer type of the range's start value     
     *   - isMutable: true iff the range itself is mutable
     *
     * Both inner types are cloned with one fewer mutability level than the range,
     * ensuring that mutability flows from the range to its components.
     *
     */
    pub self (loc: &Word, inner: &IntType, isMutable: bool)
        with super (loc, inners-> copy [inner.clone (mutLevel-> (if (isMutable) { 1u32 } else { 0u32 })),
                                        inner.cloneAsSigned ().clone (mutLevel-> (if (isMutable) { 1u32 } else { 0u32 }))],
                    isMutable-> isMutable)        
    {}

    /**
     * @returns the integer type used for the start/end values of the range
     */
    @field
    pub fn start (self)-> &IntType {
        if let i: &IntType = self.inners[0]
            return i;

        panic;
    }

    /**
     * @returns the integer type used for the step value of the range
     */
    @field
    pub fn step (self)-> &IntType {
        if let i: &IntType = self.inners[1]
            return i;

        panic;
    }

    /**
     * A range is deeply mutable iff:
     *   - the range itself is mutable, and
     *   - the start value type is mutable.
     *
     * The step type follows the same mutability as the start type.
     */
    @field
    pub over isDeeplyMutable (self)-> bool {
        self.isMutable && self.inners [0].isMutable
    }

    /**
     * Ranges never require explicit aliasing.
     *
     * They do not borrow data and do not expose mutable references to inner
     * components.
     */
    @field
    pub over needsExplicitAlias (self)-> bool {
        false
    }

    /**
     * Ranges never borrow data.
     *
     * They contain only integer values and do not reference external memory.
     */
    @field
    pub over borrowsData (self)-> bool {
        false
    }

    /**
     * Ranges are compatible when their start types are compatible.
     *
     * The step type is assumed to follow the same compatibility as the start type.
     */
    pub over isCompatible (self, o: &Type)-> bool {        
        if let s: &RangeType = o {
            return self.inners [0us].isCompatible (s.inners [0us]);
        }

        return false;        
    }

    /**
     * Mutability fitting for ranges.
     *
     * Only the outer mutability matters. When borrowed:
     *   - an immutable range cannot fit into a mutable one.
     *
     * Inner mutability is irrelevant because ranges do not borrow data.
     */
    pub over mutabilityFit (self, o: &Type, borrowed: bool)-> bool {
        if (borrowed) {
            if (!self.isMutable && o.isMutable) return false;
        }

        true
    }

    /**
     * Compute the mutability distance for ranges.
     *
     * Only the outer mutability contributes. When borrowed:
     *   - losing the outer mutability layer costs 1.
     *
     * Ranges do not propagate mutability distance to inner types.
     */
    pub over mutabilityDistance (self, o: &Type, borrowed: bool)-> u32 {
        if (borrowed) {
            if (self.isMutable && !o.isMutable) return 1u32;
        }

        0u32
    }

    /**
     * Maximum mutability distance for ranges:
     *   - 1 when borrowed,
     *   - 0 otherwise.
     */    
    prot over computeMaxMutabilityDistance (self, borrowed: bool)-> u32 {
        if (borrowed) {
            return 1u32;
        }

        0u32
    }

    /**
     * Ranges have the same mutability iff:
     *   - their outer mutability matches, and
     *   - their start types have the same mutability.
     */
    pub over sameMutability (self, o: &Type)-> bool {
        match o {
            s: &RangeType => {
                if (self.isMutable != o.isMutable) return false;
                return self.inners [0us].sameMutability (s.inners [0us]);
            }
            en: &EnumType => {
                return self.sameMutability (en.getLastLevelProxy ());
            }
        }

        panic;
    }


    /**
     * Clone the range type with a given mutability level.
     *
     * The start and step types receive one fewer mutability level than the range.
     */
    pub over clone (self, mutLevel: u32)-> &Type {
        let innerLevel = if (mutLevel >= 1u32) {
            mutLevel - 1u32
        } else { 0u32 };
        
        return copy RangeType (self.getLoc (), self.start, isMutable-> (mutLevel != 0u32));        
    }

    /**
     * Clone the range type to match the mutability pattern of another type.
     *
     * Both inner integer types are cloned according to the pattern’s inner types.
     */
    pub over clone (self, pattern: &Type)-> &Type {        
        return copy RangeType (self.loc, self.start, isMutable-> pattern.isMutable);                            
    }

    /**
     * Produce a mutable clone of the range until a borrow is encountered.
     *
     * Since ranges never borrow, this is equivalent to producing a deeply mutable
     * clone.
     */
    pub over cloneMutableUntilBorrow (self)-> &Type {
        self.toDeeplyMutable ()
    }

    /**
     * Produce a deeply mutable version of the range.
     *
     * Both inner integer types become deeply mutable.
     */
    pub over toDeeplyMutable (self)-> &Type {        
        copy RangeType (self.getLoc (), self.start, isMutable-> true)        
    }
    
    impl Comparable!{&Generator};
    impl Streamable;
    impl Formattable {

        /**
         * Format the range type using the syntax:
         *     (..T)
         *
         * Mutability is printed as a prefix when present.
         */
        pub over format (self, dmut stream: &Formatter) {
            if (self.isMutable) stream:.write (Decorators::MUT, ' ');
            stream:.write ("(.."s8);
            self.inners [0us].format (alias stream);
            stream:.write (")"s8);
        }                
    }
    
}
