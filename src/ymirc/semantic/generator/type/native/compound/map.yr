/*
 * Declares the MapType class.
 *
 * A MapType represents a native associative container mapping keys to values.
 * Both key and value types are part of the static type, and maps enforce
 * strict invariants: neither keys nor values may be movable types, and map
 * operations always borrow data from the container.
 *
 * Maps participate in the standard mutability and compatibility rules of
 * CompoundType, with additional semantics specific to associative containers.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::generator::type::native::compound::map
 * @File: ymirc/semantic/generator/type/native/compound/map.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2021-11-20
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in map;

use ymirc::semantic::generator::type::{custom, native};

use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::{format, comparison};

use std::stream;

use ymirc::errors::message;
use ymirc::semantic::validator;

/**
 * Native associative map type.
 *
 * A MapType stores key/value pairs, with both key and value types fixed at
 * compile time. Maps cannot contain movable types as keys or values. Their
 * mutability and borrowing behavior depend primarily on the value type.
 *
 * The `inners` array contains:
 *   - inners[0] = key type
 *   - inners[1] = value type
 *
 */
@final
pub class MapType over CompoundType {

    /**
     * Construct a map type.
     *
     * @params:
     *   - loc:       source location of the type expression
     *   - key:       the key type
     *   - value:     the value type
     *   - isMutable: true iff the map itself is mutable
     *
     * @throws ErrorMsg
     *   if either the key or value type is movable, since maps cannot store
     *   movable types.
     */
    pub self (loc: &Word, key: &Type, value: &Type, isMutable: bool)
        with super (loc, inners-> copy [key, value], isMutable-> isMutable)

        throws ErrorMsg
    {
        if key.isMovable {
            throw copy ErrorMsg::fatal (loc, end-> key.loc, format (ValidateErrorMessage::CONTAIN_MOVABLE_TYPE, key),
                                        notes-> copy [copy ErrorMsg::note (loc, format (ValidateErrorMessage::CONTAIN_MOVABLE_TYPE_NOTE), oneLine-> true)]);
        }

        if value.isMovable {
            throw copy ErrorMsg::fatal (loc, end-> value.loc, format (ValidateErrorMessage::CONTAIN_MOVABLE_TYPE, value),
                                        notes-> copy [copy ErrorMsg::note (loc, format (ValidateErrorMessage::CONTAIN_MOVABLE_TYPE_NOTE), oneLine-> true)]);
        }
    }

    /**
     * @returns: the type of the keys
     * */
    @field
    pub fn key (self)-> &Type {
        self.inners [0]
    }

    /**
     * @returns: the type of the values
     * */
    @field
    pub fn value (self)-> &Type {
        self.inners [1]
    }

    /**
     * A map is deeply mutable iff:
     *   - the map itself is mutable, and
     *   - the value type is deeply mutable.
     *
     * The key type does not affect deep mutability.
     */
    @field
    pub over isDeeplyMutable (self)-> bool {
        if (!self.isMutable) {
            false
        } else {
            self.inners [1].isDeeplyMutable
        }
    }

    /**
     * Maps require explicit aliasing only when:
     *   - the map is mutable, and
     *   - the value type is mutable.
     *
     * Mutating a map may mutate the value stored under a key, so aliasing rules
     * depend on the mutability of the value type.
     */
    @field
    pub over needsExplicitAlias (self)-> bool {
        if (!self.isMutable) {
            false // [K=> V] no change of borrow
        } else {
            self.inners [1].isMutable // if mut [K=> mut V], borrow can change, but if mut [K=> V] then it cannot
        }
    }

    /**
     * Maps always borrow data.
     *
     * Map values are always heap allocated.
     */
    @field
    pub over borrowsData (self)-> bool {
        true
    }

    /**
     * Maps are compatible only with other MapType instances with identical
     * key and value types.
     */
    pub over isCompatible (self, o: &Type)-> bool {
        self == o
    }

    /**
     * Mutability fitting for maps.
     *
     * Rules:
     *   - immutable maps fit into mutable ones only if borrowing rules allow it,
     *   - value mutability must also fit,
     *   - key mutability is irrelevant (keys are immutable by definition),
     *   - maps always borrow, so value mutability is checked under `borrowed = true`.
     */
    pub over mutabilityFit (self, o: &Type, borrowed: bool)-> bool {
        match o {
            s: &MapType => {
                if (!s.isMutable) return true;
                if (borrowed && !self.isMutable) return false;
                if (!self.inners [1].mutabilityFit (s.inners [1], borrowed-> true)) return false;

                return true;
            }
            en: &EnumType => {
                return self.mutabilityFit (en.getLastLevelProxy (), borrowed-> borrowed);
            }
            _ => panic;
        }
    }

    /**
     * Compute the mutability distance between two maps.
     *
     * Only the value type contributes to mutability distance. The outer map
     * layer contributes 1 when:
     *   - the map is borrowed, and
     *   - the target map is immutable.
     */
    pub over mutabilityDistance (self, o: &Type, borrowed: bool)-> u32 {
        match o {
            s: &MapType => {
                if (!self.isMutable) return 0u32; // there are not mut, so no change possible
                let value = self.inners [1].mutabilityDistance (s.inners[1], borrowed-> true);

                if (borrowed && !s.isMutable) { 1u32 + value } // self.inner is mut, but not in other so there is a change
                else { value } // other inner is also mut, so no change observed in this specific map, but maybe in inner T
            }
            en: &EnumType => {
                return self.mutabilityDistance (en.getLastLevelProxy (), borrowed-> borrowed);
            }
            _ => panic;
        }
    }

    /**
     * Maximum mutability distance for maps:
     *   - 1 for the outer layer when borrowed,
     *   - plus the value type’s maximum distance.
     */
    prot over computeMaxMutabilityDistance (self, borrowed: bool)-> u32 {
        let value = self.inners [1].computeMaxMutabilityDistance (borrowed-> true);
        if (borrowed) {
            1u32 + value
        } else {
            value
        }
    }

    /**
     * Maps have the same mutability iff:
     *   - their outer mutability matches, and
     *   - their value types have the same mutability.
     */
    pub over sameMutability (self, o: &Type)-> bool {
        match o {
            s: &MapType => {
                if (self.isMutable != o.isMutable) return false;
                if (!self.inners [1us].sameMutability (s.inners [1us])) return false;

                return true;
            }
            en: &EnumType => {
                return self.sameMutability (en.getLastLevelProxy ());
            }
        }

        panic;
    }

    /**
     * Clone the map type with a given mutability level.
     *
     * The key type is unchanged; the value type receives one less mutability level.
     */
    pub over clone (self, mutLevel: u32)-> &Type {
        let innerLevel = if (mutLevel >= 1u32) { mutLevel - 1u32 } else { 0u32 };

        {
            copy MapType (self.loc,
                          self.inners [0us],
                          self.inners [1us].clone (innerLevel),
                          isMutable-> (mutLevel != 0u32))
        } catch {
            _ => panic;
        }
    }

    /**
     * Clone the map type to match the mutability pattern of another type.
     *
     * The key type is preserved; the value type is cloned according to the pattern.
     */
    pub over clone (self, pattern: &Type)-> &Type {
        match pattern {
            s: &MapType => {
                let value = self.inners [1].clone (s.inners [1]);
                {
                    copy MapType (self.loc,
                                  self.inners [0],
                                  value,
                                  isMutable-> s.isMutable)
                } catch {
                    _ => panic;
                }
            }
            _ => {
                let value = self.inners [1].clone (0);
                {
                    copy MapType (self.loc,
                                  self.inners [0],
                                  value,
                                  isMutable-> pattern.isMutable)
                } catch {
                    _ => panic;
                }
            }
        }
    }

    /**
     * Produce a deeply mutable version of the map.
     *
     * The key type is unchanged; the value type becomes deeply mutable.
     */
    pub over toDeeplyMutable (self)-> &Type {
        {
            copy MapType (self.loc,
                          self.inners [0us],
                          self.inners [1us].toDeeplyMutable (),
                          isMutable-> true)
        } catch {
            _ => panic;
        }
    }

    /**
     * Clone the map, making it mutable until a borrow is encountered.
     *
     * Maps always borrow, so this is equivalent to producing a mutable clone.
     */
    pub over cloneMutableUntilBorrow (self)-> &Type {
        self.clone (1u32)
    }

    impl Comparable!{&Generator};
    impl Streamable;
    impl Formattable {

        /**
         * Format the map type using the syntax:
         *     [ K => V ]
         *
         * Mutability is printed as a prefix when present.
         */
        pub over format (self, dmut stream: &Formatter) {
            if (self.isMutable) stream:.write (Decorators::MUT, ' ');
            stream:.write (Tokens::LCRO);
            self.inners [0us].format (alias stream);
            stream:.write (' ', Tokens::DARROW, ' ');
            self.inners [1us].format (alias stream);
            stream:.write (Tokens::RCRO);
        }
    }

}
