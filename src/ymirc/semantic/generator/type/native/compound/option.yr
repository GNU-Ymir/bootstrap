 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in option;

use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::{format, comparison};

use std::stream;

use ymirc::errors::message;
use ymirc::semantic::validator::errors;

use ymirc::semantic::generator::type::{custom, native};

/**
 * Native option type.
 *
 * An OptionType wraps a single inner type and represents a value that may be
 * present or absent. When absent, the option may also carry an exception,
 * making it a lightweight mechanism for error propagation.
 *
 * The `inners` array contains exactly one element:
 *   - inners[0] = wrapped type T
 */
@final
pub class OptionType over CompoundType {


    /**
     * Construct an option type.
     *
     * @params:
     *   - loc:       source location of the type expression
     *   - inner:     the wrapped type
     *   - isMutable: true iff the option itself is mutable
     *
     * @throws ErrorMsg
     *   if the inner type is movable, since options cannot contain movable types.
     */
    pub self (loc: &Word, inner: &Type, isMutable: bool)
        with super (loc, inners-> copy [inner], isMutable-> isMutable)
        throws ErrorMsg
    {
        if inner.isMovable {
            throw copy ErrorMsg::fatal (loc, end-> inner.loc, format (ValidateErrorMessage::CONTAIN_MOVABLE_TYPE, inner),
                                        notes-> copy [copy ErrorMsg::note (loc, format (ValidateErrorMessage::CONTAIN_MOVABLE_TYPE_NOTE), oneLine-> true)]);
        }
    }

    /**
     * @returns: the type of the value being wrapped
     * */
    @field
    pub fn wrapped (self)-> &Type {
        self.inners [0]
    }

    /**
     * An option is deeply mutable iff:
     *   - the option itself is mutable, and
     *   - the wrapped type is deeply mutable.
     */
    @field
    pub over isDeeplyMutable (self)-> bool {
        if (!self.isMutable) {
            false
        } else {
            self.inners [0us].isDeeplyMutable 
        }
    }

    /**
     * Options require explicit aliasing only when:
     *   - the option is mutable, and
     *   - the wrapped type requires explicit aliasing.
     */
    @field
    pub over needsExplicitAlias (self)-> bool {
        if (!self.isMutable) {
            false
        } else {
            self.inners [0us].needExplicitAlias
        }
    }

    /**
     * Options borrow data iff their wrapped type borrows data.
     */
    @field
    pub over borrowsData (self)-> bool {
        self.inners [0us].borrowDatas
    }

    /**
     * Options are compatible when their wrapped types are compatible.
     */
    pub over isCompatible (self, o: &Type)-> bool {        
        if let s: &OptionType = o {
            return self.inners [0us].isCompatible (s.inners [0us]);
        }
        
        return false;
    }

    /**
     * Mutability fitting for options.
     *
     * Rules:
     *   - immutable options fit into mutable ones only if borrowing rules allow it,
     *   - inner mutability must also fit,
     *   - none? fits any T?, and T? fits none?,
     *     since the `none` keyword generates an option with no value of any type.
     *
     * EnumType proxies are handled transparently.
     */
    pub over mutabilityFit (self, o: &Type, borrowed: bool)-> bool {
        match o {
            s: &OptionType => {
                if (!s.isMutable) return true;
                match (s.inners [0], self.inners [0]) { // none => anything, anything => none is always ok
                    (_, NoneType ()) => { return true; }
                    (NoneType (), _) => { return true; }
                }

                if (borrowed && !self.isMutable) return false;
                return self.inners [0us].mutabilityFit (s.inners [0us], borrowed-> borrowed);
            }
            en: &EnumType => {
                return self.mutabilityFit (en.getLastLevelProxy (), borrowed-> borrowed);
            }
            _ => { panic; }
        }
    }

    /**
     * Compute the mutability distance between two options.
     *
     * Only the wrapped type contributes to mutability distance. The outer option layer contributes 1 when:     
     *   - the option is borrowed, and
     *   - the target option is immutable.
     */
    pub over mutabilityDistance (self, o: &Type, borrowed: bool)-> u32 {
        match o {
            a: &OptionType => {
                if (!self.isMutable) return 0u32;

                let inner = self.inners [0us].mutabilityDistance (a.inners [0us], borrowed-> borrowed);
                if (borrowed && !a.isMutable) {
                    1u32 + inner
                } else { inner }
            }
            en: &EnumType => {
                return self.mutabilityDistance (en.getLastLevelProxy (), borrowed-> borrowed);
            }
            _ => panic;
        }
    }

    /**
     * Maximum mutability distance for options:
     *   - 1 for the outer layer when borrowed,
     *   - plus the wrapped type’s maximum distance.
     */
    prot over computeMaxMutabilityDistance (self, borrowed: bool)-> u32 {
        let inner = self.inners [0us].computeMaxMutabilityDistance (borrowed-> borrowed);
        if (borrowed) {
            1u32 + inner
        } else {
            inner
        }
    }

    /**
     * Options have the same mutability iff:
     *   - their outer mutability matches, and
     *   - their wrapped types have the same mutability.
     */
    pub over sameMutability (self, o: &Type)-> bool {
        match o {
            p: &OptionType => {
                if (self.isMutable != p.isMutable) return false;
                return self.inners [0].sameMutability (p.inners [0us]);
            }
            en: &EnumType => {
                return self.sameMutability (en.getLastLevelProxy ());
            }
        }

        panic;
    }

    /**
     * Clone the option type with a given mutability level.
     *
     * The wrapped type receives one less mutability level.
     */
    pub over clone (self, mutLevel: u32)-> &Type {
        let innerLevel = if (mutLevel >= 1u32) {
            mutLevel - 1u32
        } else { 0u32 };

        {
            copy OptionType (self.loc, self.inners [0us].clone (innerLevel), isMutable-> (mutLevel != 0u32))
        } catch {
            _ => panic;
        }
    }

    /**
     * Clone the option type to match the mutability pattern of another type.
     *
     * The wrapped type is cloned according to the pattern’s wrapped type.
     */
    pub over clone (self, pattern: &Type)-> &Type {
        match pattern {
            a: &OptionType => {
                let inner = self.inners [0us].clone (a.inners [0us]);
                {
                    copy OptionType (self.loc, inner, isMutable-> pattern.isMutable)
                } catch {
                    _ => panic;
                }
            }
            _ => {
                let inner = self.inners [0us].clone (0);
                {
                    copy OptionType (self.loc, inner, isMutable-> pattern.isMutable)
                } catch {
                    _ => panic;
                }
            }
        }
    }

    /**
     * Clone the option, making it mutable until a borrow is encountered.
     *
     * The wrapped type is cloned using its own cloneMutableUntilBorrow rules.
     */
    pub over cloneMutableUntilBorrow (self)-> &Type {
        {
            let inner = self.inners [0].cloneMutableUntilBorrow ();
            copy OptionType (self.loc, inner, isMutable-> true)
        } catch {
            _ => panic;
        }
    }

    /**
     * Produce a deeply mutable version of the option.
     *
     * The wrapped type becomes deeply mutable.
     */
    pub over toDeeplyMutable (self)-> &Type {
        {
            copy OptionType (self.loc, self.inners [0us].toDeeplyMutable (), isMutable-> true)
        } catch {
            _ => panic;
        }
    }

    impl Comparable!{&Generator};    
    impl Streamable;
    impl Formattable {

        /**
         * Format the option type using the syntax:
         *     (T)?
         *
         * Mutability is printed as a prefix when present.
         */
        pub over format (self, dmut stream: &Formatter) {
            if (self.isMutable) stream:.write (Decorators::MUT, ' ');
            stream:.write (Tokens::LPAR);
            stream:.entabing ();
            self.inners [0us].format (alias stream);
            stream:.detabing ();
            stream:.write (Tokens::RPAR, Tokens::INTEG);
        }
    }

}
