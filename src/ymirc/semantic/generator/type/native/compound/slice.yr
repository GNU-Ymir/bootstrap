in slice;

use ymirc::semantic::generator::value::literal;
use ymirc::semantic::generator::type::{native, custom};

use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::{format, comparison};

use std::stream;

use ymirc::errors::message;
use ymirc::semantic::validator;


/**
 * Native slice type.
 *
 * A SliceType represents a view over a contiguous sequence of elements of a
 * single inner type. Unlike arrays, slices do not have a compile-time length:
 * their size is stored in the slice value itself and is known only at runtime.
 * Slices are lightweight, borrowing containers that reference memory owned
 * elsewhere.
 *
 * The `inners` array contains exactly one element:
 *   - inners[0] = element type T
 *
 * Slices:
 *   - always borrow data,
 *   - cannot contain movable types,
 *   - derive mutability from both the slice and its element type,
 *   - may optionally carry a compile time known size for constant evaluation,
 *     but this size does not affect compatibility or equality.
 *
 */
@final
pub class SliceType over CompoundType {

    /*! Public fields */
    pub {
        // Generally UNIT_VALUE, but can be set when computable - to perform
        // compute time code execution if possible
        //
        let size: &Value;
    }


    /**
     * Construct a slice type.
     *
     * @params:
     *   - loc:       source location of the type expression
     *   - inner:     the element type of the slice
     *   - isMutable: true iff the slice itself is mutable
     *   - withSize:  optional compile-time size(default: UNIT_VALUE)
     *
     * Slices cannot contain movable types. The optional size is used only for
     * compile-time evaluation and does not affect compatibility.
     */
    pub self (loc: &Word, inner: &Type, isMutable: bool, withSize: &Value = UNIT_VALUE)
        with super (loc, inners-> copy [inner], isMutable-> isMutable)
        , size = withSize

        throws ErrorMsg
    {
        if inner.isMovable {
            throw copy ErrorMsg::fatal(loc, end-> inner.loc, format(ValidateErrorMessage::CONTAIN_MOVABLE_TYPE, inner),
                                       notes-> copy [copy ErrorMsg::note(loc, format(ValidateErrorMessage::CONTAIN_MOVABLE_TYPE_NOTE), oneLine-> true)]);
        }
    }

    /**
     * @returns the type of the inner values component
     * */
    @field
    pub fn value(self)-> &Type {
        self.inners[0]
    }

    /**
     * A slice is deeply mutable iff:
     *   - the slice itself is mutable, and
     *   - the element type is deeply mutable.
     */
    @field
    pub over isDeeplyMutable(self)-> bool {
        if (!self.isMutable) {
            false
        } else {
            self.inners[0].isDeeplyMutable
        }
    }

    /**
     * Slices require explicit aliasing only when:
     *   - the slice is mutable, and
     *   - the element type is mutable.
     *
     * A mutable slice of mutable elements(`mut[mut T]`) may change the values being borrowed.
     */
    @field
    pub over needsExplicitAlias(self)-> bool {
        if (!self.isMutable) {
            false // [T] no change of borrow
        } else {
            self.inners[0].isMutable // if mut[mut T], borrow can change, but if mut[T] then it cannot
        }
    }

    /**
     * Slices always borrow data.
     *
     * A slice references memory owned elsewhere, so all slice operations borrow
     * from the underlying container.
     */
    @field
    pub over borrowsData(self)-> bool {
        true
    }

    /**
     * Slices are compatible when their element types are compatible.
     *
     * A slice of `void` is compatible with any slice type, since `void` represents
     * an untyped view.
     */
    pub over isCompatible(self, o: &Type)-> bool {
        if let s: &SliceType = o {
            match s.inners[0us] {
                VoidType() => { return true; }
                i: _ => {
                    return self.inners[0us].isCompatible(i);
                }
            }
        }

        return false;
    }

    /**
     * Mutability fitting for slices.
     *
     * Rules:
     *   - immutable slices fit into mutable ones only if borrowing rules allow it,
     *   - inner mutability must also fit,
     *   - slices of `void` fit any slice type,
     *   - slices always borrow, so inner mutability is checked under
     *     `borrowed = true`.
     *
     * EnumType proxies are handled transparently.
     */
    pub over mutabilityFit(self, o: &Type, borrowed: bool)-> bool {
        match o {
            s: &SliceType => {
                if (!s.isMutable) return true;
                match (self.inners[0], s.inners[0]) {  // [] => anything, anything => [] is always ok
                    (VoidType(), VoidType()) => return true;
                }

                if (borrowed && !self.isMutable) return false;
                return self.inners[0].mutabilityFit(s.inners[0], borrowed-> true);
            }
            en: &EnumType => {
                return self.mutabilityFit(en.getLastLevelProxy(), borrowed-> borrowed);
            }
            _ => {
                std::io::eprintln(format("internal error: % of %", o, o._typeinfo.name));
                panic;
            }
        }
    }

    /**
     * Compute the mutability distance for slices.
     *
     * Slice distance reflects how many mutability layers must be discarded to make
     * this slice fit the target. This includes:
     *   - the outer slice mutability(if lost), and
     *   - the mutability distance of the element type.
     *
     * Since slices always borrow, the inner distance is evaluated with
     * `borrowed = true`.
     */
    pub over mutabilityDistance(self, o: &Type, borrowed: bool)-> u32 {
        match o {
            s: &SliceType => {
                if (!self.isMutable) return 0u32; // there are not mut, so no change possible
                let inner = self.inners[0].mutabilityDistance(s.inners[0], borrowed-> true);

                if (borrowed && !s.isMutable) { 1u32 + inner } // self.inner is mut, but not in other so there is a change
                else { inner } // other inner is also mut, so no change observed in this specific slice, but maybe in inner T
            }
            en: &EnumType => {
                return self.mutabilityDistance(en.getLastLevelProxy(), borrowed-> borrowed);
            }
            _ => {
                std::io::eprintln(format("internal error: % of %", o, o._typeinfo.name));
                panic;
            }
        }
    }

    /**
     * Maximum mutability distance for slices:
     *   - 1 for the outer slice layer when borrowed,
     *   - plus the element type’s maximum distance.
     */
    prot over computeMaxMutabilityDistance(self, borrowed: bool)-> u32 {
        let inner = self.inners[0].computeMaxMutabilityDistance(borrowed-> true);
        if (borrowed) {
            1u32 + inner
        } else {
            inner
        }
    }

    /**
     * Slices have the same mutability iff:
     *   - their outer mutability matches, and
     *   - their element types have the same mutability.
     */
    pub over sameMutability(self, o: &Type)-> bool {
        match o {
            s: &SliceType => {
                if (self.isMutable != o.isMutable) return false;
                return self.inners[0us].sameMutability(s.inners[0us]);
            }
            en: &EnumType => {
                return self.sameMutability(en.getLastLevelProxy());
            }
        }

        std::io::eprintln(format("internal error: % of %", o, o._typeinfo.name));
        panic;
    }

    /**
     * Clone the slice type with a given mutability level.
     *
     * The element type receives one fewer mutability level than the slice.
     */
    pub over clone(self, mutLevel: u32)-> &Type {
        let innerLevel = if (mutLevel >= 1u32) { mutLevel - 1u32 } else { 0u32 };

        {
            copy SliceType(self.loc, self.inners[0us].clone(innerLevel), isMutable-> (mutLevel != 0u32))
        } catch {
            _ => panic;
        }
    }

    /**
     * Clone the slice type to match the mutability pattern of another type.
     *
     * The element type is cloned according to the pattern’s element type.
     */
    pub over clone(self, pattern: &Type)-> &Type {
        match pattern {
            s: &SliceType => {
                let inner = self.inners[0].clone(s.inners[0]);
                {
                    copy SliceType(self.loc, inner, isMutable-> s.isMutable)
                } catch {
                    _ => panic;
                }
            }
            _ => {
                let inner = self.inners[0].clone(0);
                {
                    copy SliceType(self.loc, inner, isMutable-> pattern.isMutable)
                } catch {
                    _ => panic;
                }
            }
        }
    }

    /**
     * Produce a deeply mutable version of the slice.
     *
     * The element type becomes deeply mutable.
     */
    pub over toDeeplyMutable(self)-> &Type {
        {
            copy SliceType(self.loc, self.inners[0us].toDeeplyMutable(), isMutable-> true)
        } catch {
            _ => panic;
        }
    }

    /**
     * Clone the slice, making it mutable until a borrow is encountered.
     *
     * Since slices always borrow, this is equivalent to producing a mutable clone.
     */
    pub over cloneMutableUntilBorrow(self)-> &Type {
        self.clone(1u32)
    }


    impl Comparable!{&Generator} {

        /**
         * Slices are equal iff their element types are equal.
         *
         * The stored size(if any) is ignored for equality.
         */
        pub over opEquals(self, o: &Generator)-> bool {
            if let s: &SliceType = o { // we ignore size field
                return self.inners[0us] == s.inners[0us];
            }

            return false;
        }
    }

    impl Streamable;
    impl Formattable {

        /**
         * Format the slice type using the syntax:
         *     [T]
         *
         * Mutability is printed as a prefix when present.
         */
        pub over format(self, dmut stream: &Formatter) {
            if (self.isMutable) stream:.write(Decorators::MUT, ' ');
            stream:.write(Tokens::LCRO);
            self.inners[0us].format(alias stream);
            stream:.write(Tokens::RCRO);
        }
    }

}
