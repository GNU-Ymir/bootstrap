in float;

use ymirc::lexing::word;
use ymirc::utils::format;
use ymirc::lexing::keys;

use std::stream;

/**
 * Native floating-point type.
 *
 * FloatType represents a built-in IEEE-style floating-point scalar value. The
 * size field indicates the number of bits used to store the value (typically
 * 32, 64, or 80 bits).
 */
@final
pub class FloatType over ScalarType {

    pub {
        // The size of the float in bits
        let size: u16;
    }
    
    /**
     * Construct a floating-point type.
     *
     * @params:
     *   - loc:       source location of the type expression
     *   - size:      number of bits used to store the float (default: 32)
     *   - isMutable: true iff the floating-point value itself is mutable
     *
     * Floating-point types have no inner structure and impose no additional
     * constraints.
     */
    pub self (loc: &Word, size: u16 = 32, isMutable: bool)
        with super (loc, isMutable-> isMutable)
        , size = size
    {}

    /**
     * Floating-point types are compatible only when they are equal.
     *
     * Two FloatType instances are compatible iff they have the same size.
     */
    pub over isCompatible (self, o: &Type)-> bool {
        self == o
    }

    /**
     * Clone the floating-point type with a given mutability level.
     *
     * If the requested mutability matches the current one, the instance is
     * returned unchanged. Otherwise, a new FloatType is created with the same
     * size and the requested mutability.
     */
    pub over clone (self, mutLevel: u32)-> &Type {
        if (self.isMutable && mutLevel != 0u32) || (!self.isMutable && mutLevel == 0) {        
            self
        } else {
            copy FloatType (self.loc, size-> self.size, isMutable-> (mutLevel != 0u32))
        }
    }
    

    impl Comparable!{&Type};
    impl Streamable;
    impl Formattable {

        /**
         * Format the floating-point type using the syntax:
         *     f32, f64, f80, or real
         *
         * Mutability is printed as a prefix when present.         
         */
        pub over format (self, dmut stream: &Formatter) {
            if (self.isMutable) stream:.write (Decorators::MUT, ' ');
            if self.size == 32u16 {
                stream:.write (NativeTypes::F32);
            } else if (self.size == 64u16) {
                stream:.write (NativeTypes::F64);
            } else if (self.size == 80u16) {
                stream:.write (NativeTypes::F80);
            } else {
                stream:.write (NativeTypes::REAL);
            }
        }                
    }
    
}
