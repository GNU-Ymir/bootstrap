in fptr;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};

use std::stream;

/**
 * Native function-pointer type.
 *
 * FuncPtrType represents a raw function pointer with no execution context.
 * Unlike delegates, function pointers do not capture an environment and are
 * invoked using the standard stack-based calling convention. They model
 * low-level, context-free callable values.
 *
 * A function pointer stores:
 *   - an ordered list of parameter types,
 *   - the return type,
 *   - per-parameter reference and lazy qualifiers.
 *
 * Function pointers:
 *   - do not borrow data,
 *   - derive mutability only from the pointer value itself,
 *   - participate in structural equality and compatibility,
 *   - are preferred over delegates during overload resolution when both match.
 *
 */
@final
pub class FuncPtrType over ScalarType {

    pub {
        // The parameters of the function pointer
        let params: [&Type];

        // The return type of the function pointer
        let retType: &Type;

        // The list of parameters that are references
        let references: [bool];

        // The list of parameters that are lazy
        let lazys: [bool];

    }


    /**
     * Construct a function-pointer type.
     *
     * @params:
     *   - loc:        source location of the type expression
     *   - references: per-parameter reference flags
     *   - lazys:      per-parameter lazy flags
     *   - params:     ordered list of parameter types
     *   - retType:    return type of the function pointer
     *   - isMutable:  true iff the function pointer value itself is mutable
     *
     */
    pub self (loc: &Word,
              references: [bool],
              lazys: [bool],
              params: [&Type],
              retType: &Type,
              isMutable: bool)

        with super (loc, isMutable-> isMutable)
        , references = references
        , lazys = lazys
        , params = params
        , retType = retType
    {}

    /**
     * Function-pointer types are compatible only when they are equal.
     *
     * Two FuncPtrType instances are compatible iff:
     *   - they have the same parameter list,
     *   - the same parameter type mutability,
     *   - the same return type,
     *   - the same return type mutability,
     *   - the same reference and lazy qualifiers,
     */
    pub over isCompatible(self, o: &Type)-> bool {
        self.opEquals(o)
    }

    /**
     * Clone the function-pointer type with a given mutability level.
     *
     * If the requested mutability matches the current one, the instance is
     * returned unchanged. Otherwise, a new FuncPtrType is created with identical
     * signature metadata and the requested mutability.
     */
    pub over clone(self, mutLevel: u32)-> &Type {
        if (self.isMutable && mutLevel != 0u32) || (!self.isMutable && mutLevel == 0) {
            return self;
        }

        return copy FuncPtrType(self.loc,
                                 self.references,
                                 self.lazys,
                                 self.params,
                                 self.retType,
                                 isMutable-> (mutLevel != 0u32));
    }

    /**
     * @returns true iff the i-th parameter is passed by reference.
     */
    pub fn isParamRef(self, i: usize)-> bool {
        self.references[i]
    }

    /**
     * @returns true iff the i-th parameter is lazy.
     */
    pub fn isParamLazy(self, i: usize)-> bool {
        self.lazys[i]
    }

    impl Comparable!{&Generator} {

        /**
         * Function-pointer types are equal when:
         *   - they have the same parameter types,
         *   - the same return type,
         *   - the same mutability for each parameter,
         *   - the same reference and lazy qualifiers,
         *   - and the same mutability for return type.
         *
         */
        pub over opEquals(self, o: &Generator)-> bool {
            if let p: &FuncPtrType = o {
                if (self.params.len != p.params.len) return false;

                if (self.retType != p.retType) return false;
                if (!self.retType.sameMutability(p.retType)) return false;

                for i in 0us .. self.params.len {
                    if self.references[i] != p.references[i] return false;
                    if self.lazys[i] != p.lazys[i] return false;

                    if (self.params[i] != p.params[i]) return false;
                    if (!self.params[i].sameMutability(p.params[i])) return false;
                }

                return true;
            }

            return false;
        }
    }


    impl Streamable;
    impl Formattable {

        /**
         * Format the function-pointer type using the syntax:
         *     fn (params...)-> T
         *
         * Reference parameters are prefixed with `ref`, lazy parameters with `lazy`.
         * Mutability is printed as a prefix when present.
         */
        pub over format(self, dmut stream: &Formatter) {
            if (self.isMutable) stream:.write(Decorators::MUT, ' ');
            stream:.write(NativeTypes::FN, " ("s8);
            for i, j in self.params {
                if (i != 0us) stream:.write(", "s8);
                if (self.references[i]) stream:.write(Keys::REF, ' ');
                else if (self.lazys[i]) stream:.write(Keys::LAZY, ' ');

                j.format(alias stream);
            }
            stream:.write(")-> "s8);
            self.retType.format(alias stream);
        }
    }

}
