 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in async_;

use ymirc::lexing::{keys, tokens, word};
use ymirc::semantic::generator::type::custom;
use ymirc::utils::{comparison, format};

use std::stream;


/**
 * Native async type.
 *
 * An AsyncType represents the result of an async function or async lambda.
 * Async values are non-blocking coroutines with no stack context: they
 * encapsulate suspended computation that can be resumed until completion.
 *
 * Async values:
 *   - wrap a single return type T,
 *   - borrow data iff their return type does,
 *   - derive mutability only from the async handle itself(the return type
 *     does not affect async mutability),
 *   - participate in compatibility and mutability rules as scalar types.
 *
 * AsyncType models only the static type of an asynchronous computation. It
 * does not encode runtime coroutine state, scheduling, or execution context.
 */
@final
pub class AsyncType over ScalarType {

    pub {
        // The type generated by the coroutine when it finishes execution
        let retType: &Type;
    }

    /**
     * Construct an async type.
     *
     * @params:
     *   - loc:       source location of the type expression
     *   - retType:   the return type of the async computation
     *   - isMutable: true iff the async value itself is mutable
     *
     */
    pub self (loc: &Word, retType: &Type, isMutable: bool)
        with super (loc, isMutable-> isMutable)
        , retType = retType
    {}

    /**
     * Async types are compatible only when they are equal.
     *
     * Two async types are compatible iff they have the same return type.
     */
    pub over isCompatible(self, o: &Type)-> bool {
        self.opEquals(o)
    }

    /**
     * An async type fits another iff its return type fits the other one's.
     */
    pub over mutabilityFit(self, o: &Type, borrowed: bool)-> bool {
        match o {
            a: &AsyncType => {
                return self.retType.mutabilityFit(a.retType, borrowed-> false);
            }
            en: &EnumType => {
                return self.mutabilityFit(en.getLastLevelProxy(), borrowed-> borrowed);
            }
            _ => {
                std::io::eprintln(format("internal error: % of %", o, o._typeinfo.name));
                panic;
            }
        }
    }

    /**
     * The mutability distance between two async types is the one of their return types.
     */
    pub over mutabilityDistance(self, o: &Type, borrowed: bool)-> u32 {
        match o {
            a: &AsyncType => {
                return self.retType.mutabilityDistance(a.retType, borrowed-> false);
            }
            en: &EnumType => {
                return self.mutabilityDistance(en.getLastLevelProxy(), borrowed-> borrowed);
            }
            _ => {
                std::io::eprintln(format("internal error: % of %", o, o._typeinfo.name));
                panic;
            }
        }
    }

    /**
     * The maximum mutability distance of an async type is the one of its return type.
     */
    prot over computeMaxMutabilityDistance(self, borrowed: bool)-> u32 {
        return self.retType.computeMaxMutabilityDistance(borrowed);
    }

    /**
     * An async handle needs an explicit alias iff its return type does.
     */
    @field
    pub over needsExplicitAlias(self)-> bool {
        return self.retType.needsExplicitAlias;
    }

    /**
     * An async handle borrows data iff its return type does.
     */
    @field
    pub over borrowsData(self)-> bool {
        self.retType.borrowsData
    }

    /**
     * Two async types have the same mutability iff their return types do.
     */
    pub over sameMutability(self, o: &Type)-> bool {
        match o {
            a: &AsyncType => {
                return self.retType.sameMutability(a.retType);
            }
            en: &EnumType => {
                return self.sameMutability(en.getLastLevelProxy());
            }
        }

        panic;
    }

    /**
     * Clone the async type with a given mutability level.
     *
     * The return type is mutable only if the async handle is, so an immutable clone
     * also gives up the mutability of the return type.
     */
    pub over clone(self, mutLevel: u32)-> &Type {
        if mutLevel == 0u32 {
            return copy AsyncType(self.loc, self.retType.clone(0u32), isMutable-> false);
        }

        if self.isMutable return self;
        return copy AsyncType(self.loc, self.retType, isMutable-> true);
    }

    impl Comparable!{&Generator} {

        /**
         * Two async types are equal when their return types are equal.
         */
        pub over opEquals(self, o: &Generator)-> bool {
            if let a: &AsyncType = o {
                if self.retType != a.retType return false;

                return true;
            }

            return false;
        }
    }

    impl Streamable;
    impl Formattable {

        /**
         * Format the async type using the syntax:
         *     (async-> T)
         *
         * Mutability is printed as a prefix when present.
         */
        pub over format(self, dmut stream: &Formatter) {
            if (self.isMutable) stream:.write(Decorators::MUT, ' ');
            stream:.write('(', Keys::ASYNC, Tokens::ARROW, ' ');
            stream:.entabing();
            self.retType.format(alias stream);
            stream:.detabing();
            stream:.write(')');
        }
    }
}
