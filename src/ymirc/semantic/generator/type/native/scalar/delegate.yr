in delegate;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, log, comparison};

use ymirc::semantic::generator::type::native;

use std::stream;

/**
 * Native delegate type.
 *
 * A DelegateType represents a function pointer paired with an execution
 * context. Delegates are callable values that capture an environment and
 * behave like closures with a fixed signature. They may originate from:
 *   - direct delegate literals,
 *   - method references,
 *   - casts from raw function pointers.
 *
 * A delegate stores:
 *   - an ordered list of parameter types,
 *   - the return type,
 *   - per-parameter metadata (reference and lazy qualifiers),
 *   - flags describing its origin (from function pointer) and nullability.
 *
 * Delegates:
 *   - do not borrow data,
 *   - derive mutability only from the delegate value itself,
 *   - participate in structural equality and compatibility,
 *   - introduce a synthetic mutability distance to prefer direct function
 *     overloads over delegate overloads.
 *
 * DelegateType models the static callable signature and metadata of a
 * delegate, not its runtime environment or captured state.
 */
@final
pub class DelegateType over ScalarType {

    pub {

        // The parameters of the function pointer
        let params: [&Type];

        // The return type of the function pointer
        let retType: &Type;

        // True if it was create from cast
        let isFromFPtr: bool;

        // True if we need to check null before calling
        let canBeNull: bool;

        // The list of parameters that are references
        let references: [bool];

        // The list of parameters that are lazys
        let lazys: [bool];
    }


    /**
     * Construct a delegate type.
     *
     * @params:
     *   - loc:        source location of the type expression
     *   - references: per-parameter reference flags
     *   - lazys:      per-parameter lazy flags
     *   - params:     ordered list of parameter types
     *   - retType:    return type of the delegate
     *   - isFromFptr: true iff the delegate originates from a function pointer cast
     *   - isMutable:  true iff the delegate value itself is mutable
     *   - canBeNull:  true iff the delegate may be null and must be checked before call
     *
     * Nullable delegates must return void, since nullability implies the absence
     * of a callable target.
     */
    pub self (loc:        &Word,
              references: [bool],
              lazys:      [bool],
              params:     [&Type],
              retType:    &Type,
              isMutable:  bool,
              isFromFptr: bool = false,
              canBeNull:  bool = false)

        with super (loc, isMutable-> isMutable)
        , params = params
        , retType = retType
        , references = references
        , lazys = lazys
        , isFromFPtr = fromFptr
        , canBeNull = canBeNull
    {
        __version DEBUG {
            if self._canBeNull && retType !of VoidType {
                logging::failure ("Nullable delegate must return void %", self);
                panic;
            }
        }
    }

    /**
     * Delegates are compatible only when they are equal.
     *
     * Two delegates are compatible iff:
     *   - they have the same parameter list,
     *   - the same parameter mutability,
     *   - the same return type,
     *   - the same return type mutability,
     *   - the same reference and lazy qualifiers,
     */
    pub over isCompatible (self, o: &Type)-> bool {
        self == o
    }

    /**
     * We increase synthetically the mutability distance because we want to
     * select function to function, in priority over function to delegate, even
     * if their mutability system is exactly similar.
     *
     * @example

     * */

    /**
     * Compute the mutability distance for delegates.
     *
     * Delegate distance reflects:
     *   - loss of outer mutability when borrowed, and
     *   - a synthetic penalty when the delegate originates from a function pointer.
     *
     * The synthetic penalty ensures that overload resolution prefers direct
     * function types over delegates when both are viable.
     *
     * @example
     * ```
     * fn bar ()-> i32;
     *
     * fn foo (f: dg ()-> i32);
     * fn foo (f: fn ()-> i32);
     *
     * let fptr = &bar;
     * foo (bar); // call f: fn()-> i32 in priority
     * ```
     */
    pub over mutabilityDistance (self, o: &Type, borrowed: bool)-> u32 {
        let frPtr = if (self.isFromFPtr) { 1u32 } else { 0u32 };
        if (borrowed) {
            if (self._isMutable && !o._isMutable) return 1u32 + frPtr;
        }

        0u32 + frPtr
    }

    /**
     * Maximum mutability distance for delegates:
     *   - 2 when borrowed (outer mutability + synthetic penalty),
     *   - 1 otherwise.
     */
    prot over computeMaxMutabilityDistance (self, borrowed: bool)-> u32 {
        if (borrowed) {
            return 2u32;
        }

        1u32
    }

    /**
     * Clone the delegate type with a given mutability level.
     *
     * If the requested mutability matches the current one, the instance is
     * returned unchanged. Otherwise, a new DelegateType is created with identical
     * signature metadata and the requested mutability.
     */
    pub over clone (self, mutLevel: u32)-> &Type {
        if (self.isMutable && mutLevel != 0u32) || (!self.isMutable && mutLevel == 0) {
            return self;
        }

        return copy DelegateType (self._loc,
                                  self.references,
                                  self.lazys,
                                  self.params,
                                  self.retType,
                                  isFromFptr-> self.isFromFPtr,
                                  isMutable-> (mutLevel != 0u32),
                                  canBeNull-> self.canBeNull);
    }

    /**
     * Clone the delegate to retreive only the function pointer component
     * */
    pub fn cloneAsFptr (self)-> &FuncPtrType {
        return copy FuncPtrType (self._loc,
                                 self.references,
                                 self.lazys,
                                 self.params,
                                 self.retType,
                                 isMutable-> (mutLevel != 0u32));
    }

    /**
     * @returns true iff the i-th parameter is passed by reference.
     */
    pub fn isParamRef (self, i: usize)-> bool {
        self.references [i]
    }

    /**
     * @returns true iff the i-th parameter is lazy.
     */
    pub fn isParamLazy (self, i: usize)-> bool {
        self.lazys [i]
    }


    impl Comparable!{&Generator} {

        /**
         * Delegates are equal when:
         *   - they have the same parameter types,
         *   - the same return type,
         *   - the same mutability for each parameter,
         *   - the same reference and lazy qualifiers,
         *   - and the same signature metadata.
         *
         */
        pub over opEquals (self, o: &Generator)-> bool {
            if let p: &DelegateType = o {
                if (self.params.len != p.params.len) return false;

                if (self.retType != p.retType) return false;
                if (!self.retType.sameMutability (p.retType)) return false;

                for i in 0us .. self.params.len {
                    if self.references [i] != p.references [i] return false;
                    if self.lazys [i] != p.lazys [i] return false;

                    if (self.params [i] != p.params [i]) return false;
                    if (!self.params [i].sameMutability (p.params [i])) return false;
                }

                return true;
            }

            return false;
        }
    }

    impl Streamable;
    impl Formattable {

        /**
         * Format the delegate type using the syntax:
         *     dg (params...) -> T
         *
         * Reference parameters are prefixed with `ref`, lazy parameters with `lazy`.
         * Mutability is printed as a prefix when present.
         *
         * Nullable delegates are printed as:
         *     (dg (...) -> void)[nullable]
         */
        pub over format (self, dmut stream: &Formatter) {
            if self.canBeNull {
                stream:.write ("(");
            }

            if (self.isMutable) stream:.write (Decorators::MUT, ' ');
            stream:.write (NativeTypes::DG, " ("s8);
            for i, j in self.params {
                if (i != 0us) stream:.write (", "s8);
                if (self.references [i]) stream:.write (Keys::REF, ' ');
                else if (self.lazys [i]) stream:.write (Keys::LAZY, ' ');
                j.format (alias stream);
            }
            stream:.write (")-> "s8);
            self.retType.format (alias stream);

            if self.canBeNull {
                stream:.write (")[nullable]");
            }
        }
    }

}
