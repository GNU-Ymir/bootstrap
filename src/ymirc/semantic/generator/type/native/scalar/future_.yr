in future_;

use ymirc::semantic::generator::type::{native, custom};

use ymirc::lexing::{word, tokens};
use ymirc::utils::{format, comparison};
use ymirc::lexing::keys;
use std::stream;

use ymirc::errors::message;
use ymirc::semantic::validator;

/**
 * Native future type.
 *
 * A FutureType represents a value produced asynchronously by a parallel
 * computation. A future holds the eventual result of a function executed in
 * another thread or task. Unlike async values, futures do not represent
 * resumable coroutines; they represent a handle to a computation that is
 * already running or scheduled.
 *
 * Futures:
 *   - wrap a single return type T,
 *   - do not borrow data,
 *   - derive mutability only from the future value itself,
 *   - do not inherit mutability from the return type,
 *   - participate in compatibility and mutability rules as scalar types.
 *
 * The mutability of the returned value is determined by the function that
 * produced the future, not by the mutability of the future handle.
 *
 */
@final
pub class FutureType over ScalarType {

    pub {
        // The type returned by the future when it's execution is finished
        let retType: &Type;
    }

    /**
     * Construct a future type.
     *
     * @params:
     *   - loc:       source location of the type expression
     *   - retType:   the return type of the future computation
     *   - isMutable: true iff the future handle itself is mutable
     *
     */
    pub self (loc: &Word, retType: &Type, isMutable: bool)
        with super (loc, isMutable-> isMutable)
        , retType = retType

    {}

    /**
     * Futures are compatible only when they are equal.
     *
     * Two FutureType instances are compatible iff they wrap the same return type.
     */
    pub over isCompatible(self, o: &Type)-> bool {
        self.opEquals(o)
    }

    /**
     * Clone the future type with a given mutability level.
     *
     * If the requested mutability matches the current one, the instance is
     * returned unchanged. Otherwise, a new FutureType is created with the same
     * return type and the requested mutability.
     *
     * The return type is preserved exactly and does not receive a mutability
     * adjustment.
     */
    pub over clone(self, mutLevel: u32)-> &Type {
        if (self.isMutable && mutLevel != 0u32) || (!self.isMutable && mutLevel == 0) {
            return self;
        }

        return copy FutureType(self._loc,
                                self.retType,
                                isMutable-> (mutLevel != 0u32));
    }

    impl Comparable!{&Generator} {

        /**
         * Two futures are equal when their return types are equal, and the
         * return types have the same mutability.
         *
         */
        pub over opEquals(self, o: &Generator)-> bool {
            if let f: &FutureType = o {
                if self.retType != f.retType return false;
                if !self.retType.sameMutability(f.retType) return false;

                return true;
            }

            return false;
        }
    }

    impl Streamable;
    impl Formattable {

        /**
         * Format the future type using the syntax:
         *     (future-> T)
         *
         * Mutability is printed as a prefix when present.
         */
        pub over format(self, dmut stream: &Formatter) {
            if (self._isMutable) stream:.write(Decorators::MUT, ' ');
            stream:.write('(', Keys::FUTURE, Tokens::ARROW, ' ');
            stream:.entabing();
            self._inners[0us].format(alias stream);
            stream:.detabing();
            stream:.write(')');
        }
    }
}
