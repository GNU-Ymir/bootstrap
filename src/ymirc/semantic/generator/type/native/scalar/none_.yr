in none_;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};

use std::stream;

/**
 * Native none type.
 *
 * NoneType represents the absence of a meaningful value. Unlike ErrorType,
 * which exists only to allow semantic analysis to continue after an error,
 * NoneType is allowed to appear in YIL generation and is used as a placeholder
 * in intermediate representations.
 *
 * NoneType:
 *   - is always immutable,
 *   - carries no runtime value,
 *   - is incompatible with all other types,
 *   - is equal only to itself,
 *   - is not addressable,
 *   - is used internally to mark values that should be ignored or discarded,
 *     such as placeholders in temporary types or incomplete constructs.
 *
 * NoneType models the semantic concept of “no value” without representing a
 * runtime null or optional type.
 */
@final
pub class NoneType over ScalarType {


    /**
     * Construct a none type.
     *
     * @params:
     *   - loc: source location of the type expression
     *
     * NoneType is always immutable and carries no additional metadata.
     */
    pub self (loc: &Word)
        with super (loc, isMutable-> false)
    {}

    /**
     * NoneType is compatible only with itself.     
     * */
    pub over isCompatible (self, o: &Type)-> bool {
        self.opEquals (o)
    }

    /**
     * Cloning a none type always returns the same instance.
     *
     * NoneType has no mutability and no structure, so cloning is a no-op.
     */
    pub over clone (self, _: u32)-> &Type {
        self
    }

    /**
     * NoneType is never addressable.
     *
     * It does not correspond to a real memory location and cannot be the target
     * of references or pointer operations.
     */
    @field
    pub over isAddressable (self)-> bool {
        false
    }

    impl Comparable!{&Type};
    impl Streamable;
    impl Formattable {

        /**
         * Format the none type using the syntax:
         *     none         
         */
        pub over format (self, dmut stream: &Formatter) {
            stream:.write (NativeTypes::NONE);
        }                
    }
    
}
