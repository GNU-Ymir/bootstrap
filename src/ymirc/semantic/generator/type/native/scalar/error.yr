in error;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};

use std::stream;

/**
 * Native error type.
 *
 * ErrorType is a placeholder type used internally by the compiler to allow
 * semantic analysis to continue after an error has been detected. It has no
 * runtime or YIL representation and should never appear in valid user code.
 * */
@final
pub class ErrorType over ScalarType {

    /**
     * Construct an error type.
     *
     * @params:
     *   - loc: source location where the error was detected
     *
     * ErrorType is always immutable and carries no additional metadata.
     * */
    pub self (loc: &Word)
        with super (loc, isMutable-> false)
    {}

    /**
     * ErrorType is never compatible with any type.
     *
     * This prevents erroneous expressions from silently matching valid overloads
     * or propagating into unrelated type checks.
     */
    pub over isCompatible (self, _: &Type)-> bool {
        false
    }

    /**
     * Cloning an error type always returns the same instance.
     *
     * ErrorType has no mutability and no structure, so cloning is a no-op.
     */
    pub over clone (self, _: u32)-> &Type {
        self
    }

    impl Comparable!{&Generator};
    impl Streamable;
    impl Formattable {

        /**
         * Format the error type using the syntax:
         *     error
         *
         * This representation is used only in diagnostics and debugging output.
         */
        pub over format (self, dmut stream: &Formatter) {
            stream:.write (NativeTypes::ERROR);
        }
    }

}
