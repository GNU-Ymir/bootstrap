in bool_;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};

use std::stream;

/**
 * Native boolean type.
 *
 * BoolType represents the built-in boolean scalar type of the language. It is
 * a simple, non-numeric, non-movable value type with two possible values:
 * `true` and `false`. Booleans do not borrow data and have no internal
 * structure. Mutability applies only to the boolean value itself.
 *
 */
@final
pub class BoolType over ScalarType {


    /**
     * Construct a boolean type.
     *
     * @params:
     *   - loc:       source location of the type expression
     *   - isMutable: true iff the boolean value itself is mutable
     *
     * Booleans have no inner structure and impose no additional constraints.
     */
    pub self (loc: &Word, isMutable: bool)
        with super (loc, isMutable-> isMutable)
    {}

    /**
     * Booleans are compatible only when they are equal.
     *
     * Two BoolType instances are compatible iff they have the same mutability.
     */
    pub over isCompatible (self, o: &Type)-> bool {
        self == o
    }

    /**
     * Clone the boolean type with a given mutability level.
     *
     * If the current instance mutability matches the mutLevel, the instance is
     * returned unchanged. Otherwise, a new BoolType is created with the
     * requested mutability.
     */
    pub over clone (self, mutLevel: u32)-> &Type {
        if (self.isMutable && mutLevel != 0u32) || (!self.isMutable && mutLevel == 0) {
            self
        } else {
            copy BoolType (self.loc, isMutable-> mutLevel != 0u32)
        }
    }

    impl Comparable!{&Generator};
    impl Streamable;
    impl Formattable {

        /**
         * Format the boolean type using the syntax:
         *     bool
         *
         * Mutability is printed as a prefix when present.
         */
        pub over format (self, dmut stream: &Formatter) {
            if (self.isMutable) stream:.write (Decorators::MUT, ' ');
            stream:.write (NativeTypes::BOOL);
        }
    }

}
