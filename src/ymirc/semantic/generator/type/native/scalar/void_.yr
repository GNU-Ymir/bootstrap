 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in void_;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};

use std::stream;

/**
 * Void type
 */
/**
 * Native void type.
 *
 * VoidType represents the absence of a return value from a function. Unlike
 * NoneType, which is used internally as a placeholder, void is a real type
 * that participates in the type system and may appear in YIL.
 *
 * VoidType:
 *   - represents “no value” in function return positions,
 *   - is *not* equivalent to an empty tuple,
 *   - is addressable, allowing pointers to void (e.g., `*void`),
 *   - carries mutability because void pointers may describe mutable or
 *     immutable unknown memory,
 *   - is incompatible with all other types except itself.
 *
 * VoidType models the semantic concept of “no return value” while still
 * supporting pointer operations and mutability propagation.
 */
@final
pub class VoidType over ScalarType {

    /**
     * Construct a void type.
     *
     * @params:
     *   - loc:       source location of the type expression
     *   - isMutable: true iff the void value is considered mutable
     *
     * VoidType is addressable, so mutability matters for pointer types such as
     * `dmut *void` vs `*void`.
     */
    pub self (loc : &Word, isMutable: bool = false)
        with super (loc, isMutable-> isMutable)
    {}

    /**
     * VoidType is compatible only with itself.
     *
     */
    pub over isCompatible (self, o: &Type)-> bool {
        self.opEquals (o)
    }

    /**
     * Clone the void type with a given mutability level.
     *
     * If the requested mutability matches the current one, the instance is
     * returned unchanged. Otherwise, a new VoidType is created with the requested
     * mutability.
     */
    pub over clone (self, mutLevel: u32)-> &Type {
        if (self.isMutable && mutLevel != 0u32) || (!self.isMutable && mutLevel == 0) {
            self
        } else {
            copy VoidType (self.loc, isMutable-> (mutLevel != 0u32))
        }
    }

    impl Comparable!{&Generator};
    impl Streamable;
    impl Formattable {

        /**
         * Format the void type using the syntax:
         *     void
         *
         */
        pub over format (self, dmut stream: &Formatter) {
            stream:.write (NativeTypes::VOID);
        }
    }

}
