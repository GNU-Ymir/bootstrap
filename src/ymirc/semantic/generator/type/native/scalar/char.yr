in char;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};

use std::stream;


/**
 * Native character type.
 *
 * CharType represents a fixed-width Unicode scalar value. Characters are
 * stored as unsigned integers of size 8, 16, or 32 bits, corresponding to
 * UTF-8 code units, UTF-16 code units, or full Unicode scalar values.
 *
 * CharType:
 *   - is a simple scalar type with no internal structure,
 *   - does not borrow data,
 *   - cannot contain movable types,
 *   - derives mutability only from the character value itself,
 *   - participates in compatibility and mutability rules as a scalar.
 *
 * The `size` field indicates the number of bits used to store the character.
 */
@final
pub class CharType over ScalarType {

    pub {
        // The size of the char in bits
        let size: u16;
    }

    /**
     * Construct a character type.
     *
     * @params:
     *   - loc:       source location of the type expression
     *   - size:      number of bits used to store the character(8, 16, or 32)
     *   - isMutable: true iff the character value itself is mutable
     *
     * Characters have no inner structure and impose no additional constraints.
     */
    pub self (loc: &Word, size: u16 = 8, isMutable: bool)
        with super (loc, isMutable-> isMutable)
        , size = size
    {}

    /**
     * Character types are compatible only when they are equal.
     *
     * Two CharType instances are compatible iff they have the same size.
     */
    pub over isCompatible(self, o: &Type)-> bool {
        self.opEquals(o)
    }

    /**
     * Clone the char type with a given mutability level.
     *
     * If the current instance mutability matches the mutLevel, the instance is
     * returned unchanged. Otherwise, a new CharType is created with the
     * requested mutability.
     */
    pub over clone(self, mutLevel: u32)-> &Type {
        if (self.isMutable && mutLevel != 0u32) || (!self.isMutable && mutLevel == 0) {
            self
        } else {
            copy CharType(self.loc, size-> self.size, isMutable-> (mutLevel != 0u32))
        }
    }

    impl Comparable!{&Generator};
    impl Streamable;
    impl Formattable {

        /**
         * Format the character type using the syntax:
         *     c8, c16, or c32
         *
         * Mutability is printed as a prefix when present.
         */
        pub over format(self, dmut stream: &Formatter) {
            if (self.isMutable) stream:.write(Decorators::MUT, ' ');
            if self.size == 8u16 {
                stream:.write(NativeTypes::C8);
            } else if (self.size == 16u16) {
                stream:.write(NativeTypes::C16);
            } else
                stream:.write(NativeTypes::C32);
        }
    }

}
