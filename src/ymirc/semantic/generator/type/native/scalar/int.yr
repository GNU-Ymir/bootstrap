in int;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;

/**
 * Native integer type.
 *
 * IntType represents a fixed-width integer scalar value. The `size` field
 * indicates the number of bits used to store the integer, and `isSigned`
 * specifies whether the integer uses two’s-complement signed representation.
 *
 * Integer types:
 *   - are simple scalar types with no internal structure,
 *   - do not borrow data, 
 *   - derive mutability only from the integer value itself,
 *   - participate in compatibility and mutability rules as scalar types.
 *
 *
 */
@final
pub class IntType over ScalarType {

    pub {
        // The size of the int in bits
        let size: u16;

        // True iif the int has a bit for sign
        let isSigned: bool;
    }
    
    /**
     * Construct an integer type.
     *
     * @params:
     *   - loc:       source location of the type expression
     *   - size:      number of bits used to store the integer (default: 32)
     *   - isSigned:  true iff the integer uses a sign bit (default: true)
     *   - isMutable: true iff the integer value itself is mutable
     *     
     */
    pub self (loc: &Word, size: u16 = 32, isSigned: bool = true, isMutable: bool)
        with super (loc, isMutable-> isMutable)
        , size = size
        , isSigned = isSigned
    {}

    /**
     * Integer types are compatible only when they are equal.
     *
     * Two IntType instances are compatible iff they have the same size, and the
     * same signedness.
     */
    pub over isCompatible (self, o: &Type)-> bool {
        self.opEquals (o)
    }

    /**
     * Clone the integer type with a given mutability level.
     *
     * If the requested mutability matches the current one, the instance is
     * returned unchanged. Otherwise, a new IntType is created with the same size,
     * the same signedness, and the requested mutability.
     */
    pub over clone (self, mutLevel: u32)-> &IntType {
        if (self.isMutable && mutLevel != 0u32) || (!self.isMutable && mutLevel == 0) {        
            self
        } else {
            copy IntType (self.loc, size-> self.size, signed-> self.isSigned, isMutable-> (mutLevel != 0u32))
        }
    }

    /**
     * Clone the integer type as a signed integer.
     *
     * If the current type is already signed, the instance is returned unchanged.
     * Otherwise, a new IntType is created with identical size and mutability but
     * with `isSigned = true`.
     */
    @final
    pub fn cloneAsSigned (self)-> &IntType {
        if (self.isSigned) {
            self
        } else {
            copy IntType (self.loc, size-> self.size, signed-> true, isMutable-> self.isMutable)
        }        
    }

    /**
     * Clone the integer type as an unsigned integer.
     *
     * If the current type is already unsigned, the instance is returned unchanged.
     * Otherwise, a new IntType is created with identical size and mutability but
     * with `isSigned = false`.
     */
    @final
    pub fn cloneAsUnsigned (self)-> &IntType {
        if (!self.isSigned) {
            self
        } else {
            copy IntType (self.loc, size-> self.size, signed-> false, isMutable-> self.isMutable)
        }        
    }
    
    impl Comparable!{&Generator};
    impl Streamable;
    impl Formattable {

        /**
         * Format the integer type using the syntax:
         *     i8, i16, i32, i64, isize
         * or:
         *     u8, u16, u32, u64, usize
         *
         * Mutability is printed as a prefix when present.
         */
        pub over format (self, dmut stream: &Formatter) {
            if (self.isMutable) stream:.write (Decorators::MUT, ' ');
            if self.isSigned {
                match self.size {
                    8u32 => stream:.write (NativeTypes::I8);
                    16u32 => stream:.write (NativeTypes::I16);
                    32u32 => stream:.write (NativeTypes::I32);
                    64u32 => stream:.write (NativeTypes::I64);
                    _ => stream:.write (NativeTypes::ISIZE);
                }
            } else {
                match self.size {
                    8u32 => stream:.write (NativeTypes::U8);
                    16u32 => stream:.write (NativeTypes::U16);
                    32u32 => stream:.write (NativeTypes::U32);
                    64u32 => stream:.write (NativeTypes::U64);
                    _ => stream:.write (NativeTypes::USIZE);
                }
            };
        }                
    }
    
}
