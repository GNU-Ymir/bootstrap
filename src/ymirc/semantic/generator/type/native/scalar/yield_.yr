in yield_;

use ymirc::lexing::{keys, tokens, word};
use ymirc::semantic::generator::type::custom;
use ymirc::utils::{comparison, format};

use std::stream;


/**
 * Native yield type.
 *
 * A YieldType represents the result of a `yield` function or `yield` lambda.
 * Yield values are resumable coroutines with their own execution context but
 * without a traditional stack frame. They are used to generate a sequence of
 * values over time, suspending and resuming execution between yields.
 *
 * Yield values:
 *   - wrap a single yielded type T,
 *   - borrow data iff their yielded type does,
 *   - derive mutability only from the yield handle itself,
 *   - do not inherit mutability from the yielded value,
 *   - participate in compatibility and mutability rules as scalar types.
 *
 */
@final
pub class YieldType over ScalarType {

    pub {
        let retType: &Type;
    }

    /**
     * Construct a yield type.
     *
     * @params:
     *   - loc:       source location of the type expression
     *   - retType:   the type yielded by the coroutine
     *   - isMutable: true iff the yield handle itself is mutable
     *
     * The yielded type is stored directly and is not affected by the mutability
     * of the yield value.
     */
    pub self (loc: &Word, retType: &Type, isMutable: bool)
        with super (loc, isMutable-> isMutable)
        , retType = retType
    {}

    /**
     * Yield types are compatible only when they are equal.
     *
     * Two YieldType instances are compatible iff they wrap the same yielded
     * type, and the yielded type mutability is similar.
     */
    pub over isCompatible(self, o: &Type)-> bool {
        self.opEquals(o)
    }

    /**
     * A yield type fits another iff its yielded type fits the other one's.
     */
    pub over mutabilityFit(self, o: &Type, borrowed: bool)-> bool {
        match o {
            y: &YieldType => {
                return self.retType.mutabilityFit(y.retType, borrowed-> false);
            }
            en: &EnumType => {
                return self.mutabilityFit(en.getLastLevelProxy(), borrowed-> borrowed);
            }
            _ => {
                std::io::eprintln(format("internal error: % of %", o, o._typeinfo.name));
                panic;
            }
        }
    }

    /**
     * The mutability distance between two yield types is the one of their yielded types.
     */
    pub over mutabilityDistance(self, o: &Type, borrowed: bool)-> u32 {
        match o {
            y: &YieldType => {
                return self.retType.mutabilityDistance(y.retType, borrowed-> false);
            }
            en: &EnumType => {
                return self.mutabilityDistance(en.getLastLevelProxy(), borrowed-> borrowed);
            }
            _ => {
                std::io::eprintln(format("internal error: % of %", o, o._typeinfo.name));
                panic;
            }
        }
    }

    /**
     * The maximum mutability distance of a yield type is the one of its yielded type.
     */
    prot over computeMaxMutabilityDistance(self, borrowed: bool)-> u32 {
        return self.retType.computeMaxMutabilityDistance(borrowed);
    }

    /**
     * A yield handle needs an explicit alias iff its yielded type does.
     */
    @field
    pub over needsExplicitAlias(self)-> bool {
        return self.retType.needsExplicitAlias;
    }

    /**
     * A yield handle borrows data iff its yielded type does.
     */
    @field
    pub over borrowsData(self)-> bool {
        self.retType.borrowsData
    }

    /**
     * Two yield types have the same mutability iff their yielded types do.
     */
    pub over sameMutability(self, o: &Type)-> bool {
        match o {
            y: &YieldType => {
                return self.retType.sameMutability(y.retType);
            }
            en: &EnumType => {
                return self.sameMutability(en.getLastLevelProxy());
            }
        }

        panic;
    }

    /**
     * Clone the yield type with a given mutability level.
     *
     * The yielded type is mutable only if the yield handle is, so an immutable clone
     * also gives up the mutability of the yielded type.
     */
    pub over clone(self, mutLevel: u32)-> &Type {
        if mutLevel == 0u32 {
            return copy YieldType(self.loc, self.retType.clone(0u32), isMutable-> false);
        }

        if self.isMutable return self;
        return copy YieldType(self.loc, self.retType, isMutable-> true);
    }

    impl Comparable!{&Generator} {

        /**
         * Two yielders are equal when their return types are equal, and the
         * return types have the same mutability.
         *
         */
        pub over opEquals(self, o: &Generator)-> bool {
            if let f: &YieldType = o {
                if self.retType != f.retType return false;

                return true;
            }

            return false;
        }
    }

    impl Streamable;
    impl Formattable {

        /**
         * Format the yield type using the syntax:
         *     (yield-> T)
         *
         * Mutability is printed as a prefix when present.
         */
        pub over format(self, dmut stream: &Formatter) {
            if (self.isMutable) stream:.write(Decorators::MUT, ' ');
            stream:.write('(', Keys::YIELD, Tokens::ARROW, ' ');
            stream:.entabing();
            self.retType.format(alias stream);
            stream:.detabing();
            stream:.write(')');
        }
    }
}
