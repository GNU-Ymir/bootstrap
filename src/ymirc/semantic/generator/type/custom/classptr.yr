in classptr;

use ymirc::semantic::symbol;

use ymirc::semantic::generator::{type::{temporary, custom},
                                 value::variable};

use ymirc::utils::{format, comparison};
use ymirc::lexing::{word, tokens, keys};

use ymirc::errors::message;

use std::stream;


/**
 * Native class-pointer type.
 *
 * ClassPtrType represents the type of a class, record, or entity instance.
 * It is the type produced by expressions such as `&A` when `A` is a class-like
 * symbol. Class pointers carry *two* layers of mutability:
 *
 *   - outer mutability: mutability of the pointer itself(`mut &T`)
 *   - inner mutability: mutability of the referenced object(`&(mut T)`)
 *
 * For records and entities(stack-allocated types), only the outer mutability
 * is meaningful. For heap-allocated classes, both layers participate in
 * compatibility, mutability fitting, and aliasing rules.
 *
 * ClassPtrType tracks:
 *   - the referenced class symbol,
 *   - whether the symbol represents a record or an entity,
 *   - whether the inner object is mutable,
 *   - whether the pointer itself is mutable.
 *
 * Class pointers participate in borrowing rules:
 *   - classes always borrow,
 *   - records borrow only if one of their fields borrows,
 *   - entities never borrow.
 *
 */
@final
pub class ClassPtrType over CustomType {

    pub {
        // The content of the class ptr
        let sym: &ClassSymbol;

        // The symbol is a record (so on the stack, no inheritence, etc.)
        let isRecord: bool;

        // The symbol is an entity (so on the stack, with uniq ownership and complete lifetime)
        let isEntity: bool;
    }

    prv {
        // True iff the inner part is also mutable
        let _isInnerMutable: bool;
    }

    /**
     * Construct a class-pointer type.
     *
     * @params:
     *   - loc:            source location of the type expression
     *   - sym:         the referenced class/record/entity symbol
     *   - isMutable:      true iff the pointer itself is mutable
     *   - isInnerMutable: true iff the referenced object is mutable
     *
     * Inner mutability is only meaningful for classes. For records and entities,
     * it is forced to match the outer mutability.
     */
    pub self (loc: &Word, sym: &ClassSymbol, isMutable: bool, isInnerMutable: bool)
        with super (loc, isMutable-> isMutable)
        , sym = sym
        , _isInnerMutable = ((isInnerMutable || sym.isStruct) && isMutable)
        , isRecord = type.isRecord()
        , isEntity = type.isEntity()
    {}

    /**
     * A class pointer is deeply mutable iff:
     *   - the pointer itself is mutable, and
     *   - the referenced object is mutable.
     */
    @field
    pub over isDeeplyMutable(self)-> bool {
        self.isMutable && self._isInnerMutable
    }

    /**
     * Determine whether the class pointer requires explicit aliasing.
     *
     * Rules:
     *   - classes always borrow; a mutable pointer to a mutable class requires
     *     aliasing,
     *   - records require aliasing only when:
     *       * the pointer is mutable, and
     *       * at least one field requires aliasing,
     *   - entities and const records never require aliasing.
     */
    @field
    pub over needsExplicitAlias(self)-> bool {
        if (!self.isStruct) {
            // class borrow data, so if inner is mutable it needs to be aliased
            return self.isMutable && self._isInnerMutable;
        }

        {
            if (self.isMutable && self.isRecord) { // records
                for i in self.inner.fields {
                    if let v: &VarDeclValue = i && v.declType.needsExplicitAlias {
                        return true;
                    }
                }
            }
        } catch { _ => {} } // error generator in the symbol, during self.inner

        // entities and const records don't need alias
        return false;
    }

    /**
     * Determine whether the class pointer borrows data.
     *
     * Rules:
     *   - classes always borrow,
     *   - records borrow if any field borrows,
     *   - entities never borrow.
     */
    @field
    pub over borrowsData(self)-> bool {
        if !self.isStruct {
            return true;
        }

        {
            if (self.isRecord) {
                for i in self.inner.fields {
                    if let v: &VarDeclValue = i && v.declType.borrowsData {
                        return true;
                    }
                }
            } catch { _ => {} } // error generator in the symbol
        }

        // Entities never borrow
        return false;
    }

    /**
     * Class pointers are compatible only when they are equal.
     *
     * Equality is structural and based on the referenced symbol.
     */
    pub over isCompatible(self, o: &Type)-> bool {
        self.opEquals(o)
    }

    /**
     * Check whether this class pointer can fit into another under mutability rules.
     *
     * Structs(records/entities):
     *   - const-> const and mut-> const, is always allowed,
     *   - const-> mut is allowed only if no borrowing occurs.
     *
     * Classes:
     *   - const &T-> mut &T is forbidden when borrowed,
     *   - &(const T)-> &(mut T) is forbidden,
     *   - outer mutability follows standard borrowed rules.
     *
     * EnumType proxies are handled transparently.
     */
    pub over mutabilityFit(self, o: &Type, borrowed: bool = false)-> bool {
        match o {
            p: &ClassPtrType => {
                if (self.isStruct()) {
                    if (!p.isMutable) return true; // any T-> const T, allowed
                    if (!self.isMutable) { // const T-> mut T, only if don't borrow
                        if (borrowed) return false; // any *(const T)-> mut(*mut T), forbidden
                        if (self.borrowsData) return false; // const T-> mut T, forbidden if T has borrowing fields
                    }

                    return true;
                } else {
                    if (!p.isMutable) return true; // any &T-> const &T, allowed
                    if (borrowed && !self.isMutable) return false; // mut *(const &T)-> mut *(dmut &T), forbidden
                    if (!self._isInnerMutable && p._isInnerMutable) return false; // mut(const T) => mut(mut T), forbidden

                    return true;
                }
            }
            en: &EnumType => {
                return self.mutabilityFit(en.getLastLevelProxy(), borrowed-> borrowed);
            }
            _ => panic;
        }
    }

    /**
     * Compute the mutability distance between two class pointers.
     *
     * Structs:
     *   - mut-> const costs 1 when borrowed or when the struct borrows data,
     *   - otherwise distance is 0.
     *
     * Classes:
     *   - losing inner mutability costs 1,
     *   - losing outer mutability while borrowed costs 1.
     */
    pub over mutabilityDistance(self, o: &Type, borrowed: bool = false)-> u32 {
        match o {
            p: &ClassPtrType => {
                if (self.isStruct()) {
                    if (!self.isMutable) return 0; // const-> const = 0 change
                    if (!p.isMutable && (borrowed || self.borrowsDatas)) return 1; // mut-> const, 1 if T borrows

                    return 0; // mut-> mut, = 0 change
                } else {
                    if (!self.isMutable) return 0; // const-> const, = 0
                    let inner = if (self._isInnerMutable && !p._isInnerMutable) { 1u32 } else { 0u32 }; // &(mut)-> &(const), = 1

                    if (borrowed && !p.isMutable)
                        return 1u32 + inner; // mut *(&T)-> const *(&T); = 1

                    return inner;
                }
            }
            en: &EnumType => {
                return self.mutabilityDistance(en.getLastLevelProxy(), borrowed-> borrowed);
            }
            _ => panic;
        }
    }

    /**
     * Compute the maximum mutability distance for this class pointer.
     *
     * Structs:
     *   - 1 when borrowed,
     *   - 1 when borrowing data,
     *   - 0 otherwise if the struct does not borrow.
     *
     * Classes:
     *   - 2 when borrowed(outer + inner),
     *   - 1 otherwise(inner mutability).
     */
    prot over computeMaxMutabilityDistance(self, borrowed: bool)-> u32 {
        if (borrowed) {
            if (self.isStruct)
                return 1u32; // (dmut *T)

            return 2u32; // dmut *(&T)
        }

        if (self.isStruct && !self.borrowsDatas) // T mutability has no impact on fitting
            return 0;

        return 1; // class inner mutability impact
    }

    /**
     * Class pointers have the same mutability iff:
     *   - their outer mutability matches, and
     *   - for classes, their inner mutability also matches.
     *
     * For structs, only outer mutability matters.
     */
    pub over sameMutability(self, o: &Type)-> bool {
        match o {
            p: &ClassPtrType => {
                if (self.isStruct)
                    return (self.isMutable == p.isMutable);


                return self.isMutable == p.isMutable && self._isInnerMutable == p._isInnerMutable;
            }

            en: &EnumType => {
                return self.sameMutability(en.getLastLevelProxy());
            }
        }

        panic;
    }

    /**
     * Clone the class pointer with a given mutability level.
     *
     * @params:
     *   - mutLevel: 0 = const, 1 = mut, 2 = deeply mutable
     *
     */
    pub over clone(self, mutLevel: u32)-> &Type {
        let innerMutable = if (mutLevel > 1) { true } else { false };
        let mutable = if (mutLevel != 0) { true } else { false };

        if self._isInnerMutable == innerMutable && self.isMutable == mutable {
            return self;
        }

        copy ClassPtrType(self.loc,
                           self.sym,
                           isMutable-> mutable,
                           isInnerMutable-> innerMutable)
    }

    /**
     * Clone the class pointer to match the mutability pattern of another type.
     *
     * If the pattern is a ClassPtrType, both outer and inner mutability are copied.
     * Otherwise, only outer mutability is copied and inner mutability is disabled.
     */
    pub over clone(self, pattern: &Type)-> &Type {
        match pattern {
            p: &ClassPtrType => {
                return copy ClassPtrType(self.loc,
                                          self.sym,
                                          isMutable-> p.isMutable,
                                          innerMutable-> p._isInnerMutable);
            }
            _ => {
                return copy ClassPtrType(self.loc,
                                          self.sym,
                                          isMutable-> pattern.isMutable,
                                          innerMutable-> false);
            }
        }
    }

    /**
     * Produce a deeply mutable version of the class pointer.
     *
     * Equivalent to clone(2).
     */
    pub over toDeeplyMutable(self)-> &Type {
        return self.clone(2);
    }

    /**
     * Clone the class pointer, making it mutable until a borrow boundary.
     *
     * Equivalent to clone(1).
     */
    pub over cloneMutableUntilBorrow(self)-> &Type {
        return self.clone(1);
    }

    /**
     * @returns the ClassRefType describing the referenced class.
     *
     * If the symbol represents an error generator, the associated error message
     * is thrown.
     */
    @field
    pub fn inner(self)-> &ClassRefType
        throws ErrorMsg
    {
        if let Ok(c) = self.sym.getClassRef() {
            return c;
        }

        if let Ok(err) = self.sym.getErrorGenerator() {
            throw err.getErrorMessage();
        }

        panic;
    }

    /**
     * @returns true iff the referenced type is a struct(record or entity).
     */
    @field
    pub fn isStruct(self)-> bool {
        self.isEntity || self.isRecord
    }

    /**
     * @returns true iff the referenced type is an entity.
     *
     * Entities have unique ownership and must be moved when copied.
     */
    @field
    pub over isMovable(self)-> bool {
        self.isEntity
    }

    /**
     * Class pointers are always addressable.
     */
    @field
    pub over isAddressable(self)-> bool {
        true
    }

    impl Comparable!{&Generator} {

        /**
         * Class pointers are equal when they reference the same class symbol.
         *
         * Mutability does not affect equality.
         */
        pub over opEquals(self, o: &Generator)-> bool {
            if let p: &ClassPtrType = o {
                return self.sym is p.sym;
            }

            return false;
        }
    }

    impl Streamable;
    impl Formattable {

        /**
         * Format the class pointer using the syntax:
         *   mut T
         *   T
         *   mut &(mut T)
         *   &(T)
         *
         * Structs print as their symbol name.
         * Classes print as &(T) with optional inner mutability.
         */
        pub over format(self, dmut stream: &Formatter) {
            if (self.isMutable) stream:.write(Decorators::MUT, ' ');

            if (self.isStruct) {
                stream:.write(self.sym.path.toStr());
            } else {
                stream:.write(Tokens::AND, '(');
                if (self._isInnerMutable) stream:.write(Decorators::MUT, ' ');
                stream:.write(self.sym.path.toStr());
                stream:.write(')');
            }
        }
    }


}
