 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in enum_;

use ymirc::semantic::symbol;
use ymirc::errors::message;
use ymirc::lexing::{keys, word};

use std::stream;
use ymirc::utils::{format, comparison};


/**
 * Native enumeration type.
 *
 * EnumType represents an enumeration defined in user code. An enum is a
 * restricted view over another type (the proxy type), limiting the set of
 * allowed values. The proxy type is always treated as const inside the enum:
 * mutability of the underlying type cannot be accessed through the enum
 * itself. To obtain a mutable version of the proxy, the value must be
 * explicitly extracted via a cast.
 *
 * EnumType:
 *   - wraps a proxy type that defines the underlying representation,
 *   - forbids movable proxy types (enumeration values must be trivially
 *     copyable),
 *   - never borrows data beyond what the proxy type borrows,
 *   - never requires explicit aliasing,
 *   - is equal only to another EnumType referencing the same symbol.
 *
 */

@final
pub class EnumType over CustomType {

    pub {
        // The symbol defining the enum
        let sym: &EnumSymbol;

        // The proxy type (type contained inside the enum)
        let proxy: &Type;
    }

    /**
     * Construct an enumeration type.
     *
     * @params:
     *   - loc:     source location of the type expression
     *   - symbol:  the enumeration symbol
     *   - proxy:   the underlying type used to represent enum values
     *   - isMutable: true iff the enum value itself is mutable
     *
     * The proxy type is cloned as const (`clone(0)`) to ensure that enumeration
     * values cannot expose mutable inner state. Movable proxy types are forbidden.
     */
    pub self (loc: &Word, sym: &EnumSymbol, proxy: &Type, isMutable: bool)
        with super (loc, isMutable-> isMutable)
        , sym = sym
        , proxy = proxy.clone (0u32)

        throws ErrorMsg
    {
        if proxy.isMovable {
            throw copy ErrorMsg::fatal (loc, end-> proxy.loc, format (ValidateErrorMessage::CONTAIN_MOVABLE_TYPE, proxy),
                                        notes-> copy [copy ErrorMsg::note (loc, format (ValidateErrorMessage::CONTAIN_MOVABLE_TYPE_NOTE), oneLine-> true)]);
        }
    }

    /**
     * @returns the innermost non-enum proxy type.
     *
     * Enums may wrap other enums; this method unwraps all layers until a
     * non-enum type is reached.
     */
    pub fn getLastLevelProxy (self)-> &Type {
        let mut curr: &Type = self._proxy;
        while let en: &EnumType = curr {
            curr = en;
        }

        curr
    }

    /**
     * An enum borrows data iff its proxy type borrows data.
     *
     * EnumType does not introduce additional borrowing behavior.
     */
    @field
    pub over borrowsData (self)-> bool {
        self.proxy.borrowsData
    }

    /**
     * Enums never require explicit aliasing.
     *
     * The proxy type is always const when accessed through the enum, so aliasing
     * rules do not apply.
     */
    @field
    pub over needsExplicitAlias (self)-> bool {
        false
    }

    /**
     * Enums are deeply mutable when mutable.
     *
     * The proxy type is always const inside the enum.
     */
    @field
    pub over isDeeplyMutable (self)-> bool {
        self.isMutable
    }

    /**
     * Enums are never movable.
     *
     * Movable proxy types are forbidden, and the enum wrapper itself is not
     * movable.
     */
    @field
    pub over isMovable (self)-> bool {
        false
    }

    /**
     * An enum is addressable iff its proxy type is addressable.
     */
    @field
    pub over isAddressable (self)-> bool {
        self.proxy.isAddressable
    }

    /**
     * Enums are compatible only when they are equal.
     *
     * Two EnumType instances are compatible iff they reference the same enum
     * symbol.
     */
    pub over isCompatible (self, o: &Type)-> bool {
        self.opEquals (o)
    }

    /**
     * Mutability fitting for enums.
     *
     * Since the proxy type is always const, only outer mutability matters.
     * Borrowing rules apply normally:
     *   - borrowed const -> mut is forbidden,
     *   - all other transitions are allowed.
     */
    pub over mutabilityFit (self, o: &Type, borrowed: bool)-> bool {
        if (borrowed) {
            if (!self.isMutable && o.isMutable) return false;
        }

        true
    }

    /**
     * Compute the mutability distance for enums.
     *
     * Distance is 1 only when:
     *   - the enum is mutable,
     *   - the target is const,
     *   - and the value is borrowed.
     *
     * Otherwise, the distance is 0.
     */
    pub over mutabilityDistance (self, o: &Type, borrowed: bool)-> u32 {
        if (borrowed) {
            if (self.isMutable && !o.isMutable) return 1u32;
        }

        0u32
    }

    /**
     * Maximum mutability distance for enums:
     *   - 1 when borrowed,
     *   - 0 otherwise.
     */
    prot over computeMaxMutabilityDistance (self, borrowed: bool)-> u32 {
        if (borrowed)
            return 1u32;

        0u32
    }

    /**
     * Enums have the same mutability iff their outer mutability matches.
     *
     * The proxy type is always const, so inner mutability does not participate.
     */
    pub over sameMutability (self, o: &Type)-> bool {
        return self.isMutable == o.isMutable;
    }

    /**
     * Clone the enum type with a given mutability level.
     *
     * If the requested mutability matches the current one, the instance is
     * returned unchanged. Otherwise, a new EnumType is created with the same
     * symbol and proxy but with the requested mutability.
     */
    pub over clone (self, mutLevel: u32)-> &Type {
        if (self.isMutable && mutLevel != 0u32) {
            return self;
        }

        return copy EnumType (self.loc,
                              self.sym,
                              self.proxy,
                              isMutable-> (mutLevel != 0u32));
    }

    /**
     * Clone the enum type to match the mutability pattern of another type.
     *
     * Only outer mutability is copied; the proxy type remains const.
     */
    pub over clone (self, o: &Type)-> &Type {
        let mutLevel = if o.isMutable { 1u32 } else { 0u32 };
        return self.clone (mutLevel);
    }

    /**
     * Produce a mutable version of the enum until a borrow boundary.
     *
     * Equivalent to clone(1).
     */
    pub over cloneMutableUntilBorrow (self)-> &Type {
        return self.clone (1);
    }

    /**
     * Produce a deeply mutable version of the enum.
     *
     * Since enums cannot be deeply mutable, this is equivalent to clone(1).
     */
    pub over toDeeplyMutable (self)-> &Type {
        return self.clone (1);
    }

    impl Comparable!{&Generator} {

        /**
         * Enums are equal when they reference the same enum symbol.
         *
         * Mutability and proxy type identity do not affect equality.
         */
        pub over opEquals (self, o: &Generator)-> bool {
            if let p: &EnumType = o {
                return self.sym is p.sym;
            }

            return false;
        }
    }

    impl Streamable;
    impl Formattable {

        /**
         * Format the enum type using its fully qualified symbol path.
         *
         * Mutability is printed as a prefix when present.
         */
        pub over format (self, dmut stream: &Formatter) {
            if (self._isMutable) stream:.write (Decorators::MUT, ' ');
            stream:.write (self.sym.path.toStr ());
        }
    }


}
