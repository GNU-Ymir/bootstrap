 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in native;

use ymirc::lexing::word;
use ymirc::utils::format;
use std::stream;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

mod ::compound;
mod ::scalar;


/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          LAZYS          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub lazy ERROR_TYPE = copy ErrorType(EOF_WORD);
pub lazy NONE_TYPE = copy NoneType(EOF_WORD);
pub lazy VOID_TYPE = copy VoidType(EOF_WORD);
pub lazy PTR_VOID_TYPE = copy PointerType(EOF_WORD, VOID_TYPE, isMutable-> false);

pub lazy NONE_OPTION_TYPE = {
    copy OptionType(EOF_WORD, NONE_TYPE, isMutable-> false)
} catch {
    _ => panic;
};

pub lazy UTF8_TYPE = {
    copy SliceType(EOF_WORD, C8_TYPE, isMutable-> false)
} catch {
    _ => panic;
};

pub lazy BOOL_TYPE  = copy BoolType(EOF_WORD, isMutable-> false);
pub lazy USIZE_TYPE = copy IntType(EOF_WORD, size-> 0, isSigned-> false, isMutable-> false);
pub lazy ISIZE_TYPE = copy IntType(EOF_WORD, size-> 0, isSigned-> true,  isMutable-> false);

pub lazy U32_TYPE = copy IntType(EOF_WORD, size-> 32, isSigned-> false, isMutable-> false);
pub lazy I32_TYPE = copy IntType(EOF_WORD, size-> 32, isSigned-> true,  isMutable-> false);

pub lazy C8_TYPE = copy CharType(EOF_WORD, size-> 8, isMutable-> false);
pub lazy C16_TYPE = copy CharType(EOF_WORD, size-> 16, isMutable-> false);
pub lazy C32_TYPE = copy CharType(EOF_WORD, size-> 32, isMutable-> false);

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          TYPES          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */


pub def ScalarType:   scalar::ScalarType;
pub def BoolType:     scalar::bool_::BoolType;
pub def CharType:     scalar::char::CharType;
pub def DelegateType: scalar::delegate::DelegateType;
pub def ErrorType:    scalar::error::ErrorType;
pub def FloatType:    scalar::float::FloatType;
pub def FuncPtrType:  scalar::fptr::FuncPtrType;
pub def FutureType:   scalar::future_::FutureType;
pub def AsyncType:    scalar::async_::AsyncType;
pub def YieldType:    scalar::yield_::YieldType;
pub def IntType:      scalar::int::IntType;
pub def NoneType:     scalar::none_::NoneType;
pub def VoidType:     scalar::void_::VoidType;

pub def CompoundType: compound::CompoundType;
pub def ArrayType:    compound::array::ArrayType;
pub def MapType:      compound::map::MapType;
pub def OptionType:   compound::option::OptionType;
pub def PointerType:  compound::pointer::PointerType;
pub def RangeType:    compound::range::RangeType;
pub def SliceType:    compound::slice::SliceType;
pub def TupleType:    compound::tuple::TupleType;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          ANCESTOR          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */


/**
 * Enumeration of all native type identifiers recognized by the language.
 *
 * Each entry corresponds to a built-in type name that can appear in user code.
 * These names map directly to concrete NativeType subclasses.
 */
pub enum
| BOOL  = "bool"
| C16   = "c16"
| C32   = "c32"
| C8    = "c8"
| DG    = "dg"
| ERROR = "error"
| F32   = "f32"
| F64   = "f64"
| F80   = "f80"
| FN    = "fn"
| I16   = "i16"
| I32   = "i32"
| I64   = "i64"
| I8    = "i8"
| ISIZE = "isize"
| NONE  = "none"
| REAL  = "fsize"
| U16   = "u16"
| U32   = "u32"
| U64   = "u64"
| U8    = "u8"
| USIZE = "usize"
| VOID  = "void"
-> NativeTypes;


/**
 * Base class for all native types.
 *
 * A NativeType represents a type defined directly by the language. These types:
 *   - are always available without imports,
 *   - have fixed semantics determined by the compiler,
 *   - may be mutable or immutable depending on their category,
 *   - serve as the foundation for all user-defined and compound types.
 *
 * Concrete native types(e.g., integers, floats, function types) extend this
 * class and implement their specific behavior.
 */
@abstract
pub class NativeType over Type {

    pub self (loc: &Word, isMutable: bool = false)
        with super (loc, isMutable-> isMutable)
    {}

    impl Streamable;
    impl Formattable;
}
