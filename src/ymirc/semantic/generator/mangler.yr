in mangler;

use ymirc::utils::format;
use ymirc::lexing::keys;

use ymirc::semantic::validator;

use ymirc::semantic::{symbol, generator::_, template_};
use ymirc::semantic::generator::{type, value, global, type::_, value::_};

use std::{io, stream, fs::path};
use std::algorithm::searching;

enum
| PREFIX         = "_Y"
| FUNCTION       = "F"
| CTOR           = "CT"
| DTOR           = "DT"
| METHOD         = "MT"
| TEST           = "T"
| FUNCTION_RET   = "Z"
| VAR            = "V"
| VTABLE         = "VT"
| MAPINFO        = "MI"
| TYPEINFO       = "TI"
| COVERAGE_TABLE = "__COV__"
| COVERAGE_INFO  = "__COI__"
-> YmirMangleCsts;

/**
 * Mangler is responsible for transforming Ymir semantic entities into unique,
 * stable, and reproducible symbol names.
 *
 * Mangling is required to:
 *   - encode type information,
 *   - encode mutability and reference semantics,
 *   - encode template specializations,
 *   - encode overload sets and prototype signatures,
 *   - avoid collisions between unrelated generators,
 *   - produce backend-safe identifiers for linking and code generation.
 *
 * The mangling scheme is intentionally compact but expressive. It encodes:
 *   - scalar and compound types,
 *   - template arguments(value, type, and type-list),
 *   - class/struct paths,
 *   - method prototypes(including mutability and virtuality),
 *   - global variables,
 *   - unit tests,
 *   - vtables and typeinfo,
 *   - coverage tables,
 *   - function frames(including ctors/dtors).
 *
 */
pub mod Mangler {

    /**
     * Mangle any generator into its unique symbol name.
     *
     * Dispatches based on the concrete generator type:
     *   - FrameGenerator-> mangleFrame
     *   - UnitTestGenerator-> mangleUnitTest
     *   - PrototypeValue-> manglePrototype
     *   - Type-> mangleType
     *
     * Used by the backend whenever a generator must be emitted as a symbol.
     */
    pub fn mangle(gen: &Generator)-> [c8] {
        match gen {
            f: &FrameGenerator => { Mangler::mangleFrame(f) }
            u: &UnitTestGenerator => { Mangler::mangleUnitTest(u) }
            p: &PrototypeValue => { Mangler::manglePrototype(p) }
            t: &Type => { Mangler::mangleType(t, fatherMut-> true) }
            _ => {
                panic;
            }
        }
    }

    /**
     * Mangle a compile-time value.
     *
     * Used primarily for template arguments. Each value kind has a dedicated
     * encoding:
     *   - integers, floats, chars → prefixed with type and length
     *   - strings-> UTF-8 encoded or hashed if too long
     *   - tuples-> concatenation of mangled elements
     *   - function pointers-> encoded through their prototype
     *
     * Unsupported values produce an internal compiler error.
     */
    fn mangleValue(value: &Value)-> [c8] {
        match value {
            i: &IntValue => {
                let v = format("%", i);
                format("i%_%", v.len, v)
            }
            f: &FloatValue => {
                let v = format("%", f);
                format("f%_%", v.len, v)
            }
            s: &StringValue => {
                Mangler::mangleString(s)
            }
            c: &CharValue => {
                let v = format("%", c);
                format("c%_%", v.len, v)
            }
            b: &BoolValue => {
                if (b.isTrue) {
                    "b1"
                } else {
                    "b0"
                }
            }
            t: &TupleValue => {
                let dmut stream = copy StringStream();
                for i in t.values {
                    let mgl = Mangler::mangleValue(i);
                    stream:.write(mgl.len, mgl);
                }

                format("t%%", stream[].len, stream[])
            }
            n: &ProtoFuncPtrValue => {
                let name = Mangler::manglePrototype(n.proto);
                format("TP%_%", name.len, name)
            }
            _ => {
                eprintln("internal mangling error: ", format("%", value), " ", value.__typeinfo__.name);
                panic;
            }
        }
    }

    /**
     * Mangle a string value
     * */
    fn mangleString(s: &StringValue)-> [c8] {
        let dmut stream = copy StringStream();
        let recoded = copy StringValue(s.loc, s, size-> 8);
        let utf8 = recoded.value.utf8;

        if (utf8.len <= 10us) {
            stream:.write(format("s%", utf8.len));
            for i in utf8 {
                stream:.write(i);
            }
            return stream[];
        }

        let h = string::md5(utf8);
        for i in 0us .. 5us {
            stream:.write(utf8[i]);
        }

        stream:.write(h);
        for i in utf8.len - 5us .. utf8.len {
            stream:.write(utf8[i]);
        }

        format("s%%", stream[].len, stream[])
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          TYPES          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Mangle a type
     * @params:
     *    - type: the type to mangle
     * */
    pub fn mangleType(type: &Type, fatherMut: bool)-> [c8] {
        let inner = match type {
            // Scalar
            b: &BoolType => { Mangler::mangleBoolT(b) }
            c: &CharType => { Mangler::mangleCharT(c) }
            f: &FloatType => { Mangler::mangleFloatT(f) }
            i: &IntType => { Mangler::mangleIntT(i) }
            v: &VoidType => { Mangler::mangleVoidT(v) }

            // Compound
            c: &ClassPtrType => { Mangler::mangleClassPtrT(c, fatherMut && type.isMutable) }
            a: &ArrayType => { Mangler::mangleArrayT(a, fatherMut && type.isMutable) }
            p: &PointerType => { Mangler::manglePointerT(p, fatherMut && type.isMutable) }
            r: &RangeType => { Mangler::mangleRangeT(r, fatherMut && type.isMutable) }
            s: &SliceType => { Mangler::mangleSliceT(s, fatherMut && type.isMutable) }
            t: &TupleType => { Mangler::mangleTupleT(t, fatherMut && type.isMutable) }
            o: &OptionType => { Mangler::mangleOptionT(o, fatherMut && type.isMutable) }
            m: &MapType => { Mangler::mangleMapT(m, fatherMut && type.isMutable) }
            f: &FutureType => { Mangler::mangleFutureT(f, fatherMut && type.isMutable) }

            // Custom
            e: &EnumType => { Mangler::mangleEnumT(e) }
            t: &TraitRefType => { Mangler::mangleTraitRefT(t) }
            d: &DelegateType => { Mangler::mangleDelegateT(d) }
            f: &FuncPtrType => { Mangler::mangleFuncPtrT(f) }
            _: &NoneType => { return ""; }
            z => {
                eprintln("internal mangling error: ", format("%", z), " ", z.__typeinfo.name);
                panic;
            }
        };

        if (fatherMut && type.isMutable) {
            format("x%", inner)
        } else {
            inner
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          CUSTOM TYPES          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Mangle an enumeration type
     * */
    fn mangleEnumT(en: &EnumType)-> [c8] {
        Mangler::manglePath(en.sym.path)
    }

    /**
     * Mangle a trait ref type
     * */
    fn mangleTraitRefT(tr: &TraitRefType)-> [c8] {
        Mangler::manglePath(tr.sym.path)
    }

    /**
     * Mangle a function pointer type
     * */
    fn mangleFuncPtrT(fptr: &FuncPtrType)-> [c8] {
        let dmut stream = copy StringStream();
        let mgl = Mangler::mangleType(fptr.retType, fatherMut-> true);
        stream:.write(mgl.len, mgl);

        for i, t in fptr.params {
            let mgl_ = if (fptr.isParamRef(i)) {
                format("R%", Mangler::mangleType(t, fatherMut-> true))
            } else if (fptr.isParamLazy(i)) {
                format("L%", Mangler::mangleType(t, fatherMut-> true))
            } else {
                Mangler::mangleType(t, fatherMut-> true)
            };

            stream:.write(mgl_.len, mgl_);
        }

        format("FP%%", stream[].len, stream[])
    }

    /**
     * Mangle a delegate type
     * */
    fn mangleDelegateT(dl: &DelegateType)-> [c8] {
        let dmut stream = copy StringStream();
        let mgl = Mangler::mangleType(dl.retType, fatherMut-> true);
        stream:.write(mgl.len, mgl);

        for i, t in dl.params {
            let mgl_ = if (dl.isParamRef(i)) {
                format("R%", Mangler::mangleType(t, fatherMut-> true))
            } else if (dl.isParamLazy(i)) {
                format("L%", Mangler::mangleType(t, fatherMut-> true))
            } else {
                Mangler::mangleType(t, fatherMut-> true)
            };

            stream:.write(mgl_.len, mgl_);
        }

        format("DG%%", stream[].len, stream[])
    }

    /**
     * Mangle a future type
     * */
    fn mangleFutureT(f: &FutureType, isMutable: bool)-> [c8] {
        let dmut stream = copy StringStream();
        let mgl = Mangler::mangleType(f.retType, fatherMut-> isMutable);
        stream:.write(mgl.len, mgl);

        format("FUT%%", stream[].len, stream[])
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          SCALAR TYPES          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Mangle a bool type
     * */
    fn mangleBoolT(_: &BoolType)-> [c8] {
        "b"
    }

    /**
     * Mangle a char type
     * */
    fn mangleCharT(c: &CharType)-> [c8] {
        format("c%", c.size)
    }

    /**
     * Mangle a float type
     * */
    fn mangleFloatT(f: &FloatType)-> [c8] {
        if (f.size == 0us) {
            return NativeTypes::REAL;
        }

        format("f%", f.size)
    }

    /**
     * Mangle an int type
     * */
    fn mangleIntT(i: &IntType)-> [c8] {
        if (i.size == 0) {
            if i.isSigned {
                "isize"
            } else {
                "usize"
            }
        } else {
            if i.isSigned {
                format("i%", i.size)
            } else {
                format("u%", i.size)
            }
        }
    }

    /**
     * Mangle a void type
     * */
    fn mangleVoidT(_: &VoidType)-> [c8] {
        "v"
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          COMPOUND TYPES          =================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Mangle an array type
     * */
    fn mangleArrayT(a: &ArrayType, isMutable: bool)-> [c8] {
        let inner = Mangler::mangleType(a.inners[0], fatherMut-> isMutable);
        format("A%_%%", a.len, inner.len, inner)
    }

    /**
     * Mangle a pointer type
     * */
    fn manglePointerT(p: &PointerType, isMutable: bool)-> [c8] {
        let inner = Mangler::mangleType(p.inners[0], fatherMut-> isMutable);
        format("P%%", inner.len, inner)
    }

    /**
     * Mangle a range type
     * */
    fn mangleRangeT(rng: &RangeType, isMutable: bool)-> [c8] {
        let inner = Mangler::mangleType(rng.inners[0], fatherMut-> isMutable);
        format("R%%", inner.len, inner)
    }


    /**
     * Mangle a class ptr type
     * */
    fn mangleClassPtrT(cptr: &ClassPtrType, isMutable: bool)-> [c8] {
        let path = Mangler::manglePath(cptr.sym.path);
        if (cptr.sym.isStruct) {
            format("%%", path.len, path)
        } else {
            let res = if (cptr.isDeeplyMutable && isMutable) { format("x%", path) } else { path };
            format("P%%", res.len, res)
        }
    }

    /**
     * Mangle a slice type
     * */
    fn mangleSliceT(slc: &SliceType, isMutable: bool)-> [c8] {
        let inner = Mangler::mangleType(slc.inners[0], fatherMut-> isMutable);
        format("S%%", inner.len, inner)
    }

    /**
     * Mangle an option type
     * */
    fn mangleOptionT(o: &OptionType, isMutable: bool)-> [c8] {
        let inner = Mangler::mangleType(o.inners[0], fatherMut-> isMutable);
        format("O%%", inner.len, inner)
    }

    /**
     * Mangle a tuple type
     * */
    fn mangleTupleT(tu: &TupleType, isMutable: bool)-> [c8] {
        let dmut stream = copy StringStream();
        for i in tu.inners {
            let mgl = Mangler::mangleType(i, fatherMut-> isMutable);
            stream:.write(mgl.len, mgl);
        }

        format("T%%", stream[].len, stream[])
    }

    /**
     * Mangle a map type
     * */
    fn mangleMapT(m: &MapType, isMutable: bool)-> [c8] {
        let inner = format("%_%", Mangler::mangleType(m.inners[0], fatherMut-> isMutable),
                            Mangler::mangleType(m.inners[1], fatherMut-> isMutable));

        format("MP%%", inner.len, inner)
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          VTABLE/TYINFO          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Mangle the name of the vtable of a class ref
     * */
    pub fn mangleVtable(cl: &ClassRefType)-> [c8] {
        format("%%%", YmirMangleCsts::PREFIX, Mangler::manglePath(cl.sym.path), YmirMangleCsts::VTABLE)
    }

    /**
     * Mangle the name of the map info of a map type
     * */
    pub fn mangleMapInfo(m: &MapType)-> [c8] {
        format("%%%",
                YmirMangleCsts::PREFIX,
                Mangler::mangleType(m, fatherMut-> false),
                YmirMangleCsts::MAPINFO)
    }

    /**
     * @returns: the mangled name of the typeinfo of a class
     * */
    pub fn mangleTypeInfo(cl: &ClassRefType)-> [c8] {
        format("%%%", YmirMangleCsts::PREFIX, Mangler::manglePath(cl.sym.path), YmirMangleCsts::TYPEINFO)
    }


    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          COVERAGE INFO          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Mangle the name of the code coverage table of a frame
     * */
    pub fn mangleCoverageLocTable(frame: &FrameGenerator)-> [c8] {
        let frName = Mangler::mangleFrame(frame);
        YmirMangleCsts::COVERAGE_TABLE ~ frName
    }

    /**
     * Mangle the name of the code coverage information of a frame
     * */
    pub fn mangleCoverageFrameInfo(frame: &FrameGenerator)-> [c8] {
        let frName = Mangler::mangleFrame(frame);
        YmirMangleCsts::COVERAGE_INFO ~ frName
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          PROTOTYPES          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Mangle a prototype value
     * */
    pub fn manglePrototype(proto: &PrototypeValue)-> [c8] {
        let fnName = match proto {
            m: &MethodPrototypeValue => {
                return Mangler::mangleMethodPrototype(m);
            }
            n: &NamePrototypeValue => {
                Mangler::manglePath(n.name)
            }
            _ => {
                let path = match proto.templateMapper {
                    Ok(tmps: _) => { proto.sym.path.withTemplates(tmps?) }
                    _ => { proto.sym.path }
                };

                Mangler::manglePath(path)
            }
        };

        if (proto.sym.externLang == Keys::CLANG) {
            return proto.sym.path.asStdPath().file();
        }

        let dmut stream = copy StringStream();
        stream:.write(YmirMangleCsts::PREFIX, fnName, YmirMangleCsts::FUNCTION);

        for pv in proto.params {
            let t = if (pv.isReference) {
                format("R%", Mangler::mangleType(pv.type, fatherMut-> true))
            } else if (pv.isLazy) {
                format("L%", Mangler::mangleType(pv.type, fatherMut-> true))
            } else {
                Mangler::mangleType(pv.type, fatherMut-> true)
            }
            stream:.write(t);
        }

        stream:.write(YmirMangleCsts::FUNCTION_RET, Mangler::mangleType(proto.retType, fatherMut-> true));
        stream[]
    }

    /**
     * Mangle a method prototype value
     * */
    fn mangleMethodPrototype(proto: &MethodPrototypeValue)-> [c8] {
        let dmut stream = copy StringStream();

        let prefix = match proto {
            CtorPrototypeValue() => { YmirMangleCsts::CTOR }
            DtorPrototypeValue() => { YmirMangleCsts::DTOR }
            _ => { YmirMangleCsts::METHOD }
        }

        let path = match proto.templateMapper {
            Ok(tmps: _) => { proto.sym.path.withTemplates(tmps?) }
            _ => { proto.sym.path }
        };

        let fnName = Mangler::manglePath(path);
        stream:.write(YmirMangleCsts::PREFIX,
                       fnName,
                       prefix);

        let clPath = Mangler::manglePath(proto.classRef.sym.path);
        if (proto.classRef.sym.isStruct) {
            if (proto.isMutable) {
                stream:.write(format("Rx%%", clPath.len, clPath));
            } else {
                stream:.write(format("R%%", clPath.len, clPath));
            }
        } else {
            if (proto.isMutable) {
                stream:.write(format("xP%x%", clPath.len + 1us, clPath));
            } else {
                stream:.write(format("P%%", clPath.len, clPath));
            };
        }

        for pv in proto.params {
            let t = if (pv.isReference) {
                format("R%", Mangler::mangleType(pv.type, fatherMut-> true))
            } else if (pv.isLazy) {
                format("L%", Mangler::mangleType(pv.type, fatherMut-> true))
            } else {
                Mangler::mangleType(pv.type, fatherMut-> true)
            }
            stream:.write(t);
        }

        stream:.write(YmirMangleCsts::FUNCTION_RET, Mangler::mangleType(proto.retType, fatherMut-> true));
        stream[]
    }

    /**
     * Mangle the name of a frame generator
     * */
    pub fn mangleFrame(frame: &FrameGenerator)-> [c8] {
        if (frame.externLang == Keys::CLANG) {
            return frame.name.asStdPath().file();
        }

        let prefix = match frame.kind {
            FrameKind::METHOD => { YmirMangleCsts::METHOD }
            FrameKind::CTOR => { YmirMangleCsts::CTOR }
            FrameKind::CTOR_CLASS => { YmirMangleCsts::CTOR }
            FrameKind::DTOR => { YmirMangleCsts::DTOR }
            _ => { YmirMangleCsts::FUNCTION }
        };

        let dmut stream = copy StringStream();
        stream:.write(YmirMangleCsts::PREFIX,
                       Mangler::manglePath(frame.name),
                       prefix);

        for i, pv in frame.params {
            // we don't mangle the last parameter for ctors(always the same type dg ()-> void)
            if (frame.kind != FrameKind::CTOR_CLASS) || i != (frame.params.len - 1) {
                let t = if (pv.isReference) {
                    format("R%", Mangler::mangleType(pv.type, fatherMut-> true))
                } else if (pv.isLazy) {
                    format("L%", Mangler::mangleType(pv.type, fatherMut-> true))
                } else {
                    Mangler::mangleType(pv.type, fatherMut-> true)
                };

                stream:.write(t);
            }
        }

        stream:.write(YmirMangleCsts::FUNCTION_RET, Mangler::mangleType(frame.retType, fatherMut-> true));
        stream[]
    }

    /**
     * Mangle the name of a unit test
     * @params:
     *    - u: the unit test to mangle
     * */
    pub fn mangleUnitTest(u: &UnitTestGenerator)-> [c8] {
        let dmut stream = copy StringStream();
        stream:.write(YmirMangleCsts::PREFIX,
                       Mangler::manglePath(u.name),
                       YmirMangleCsts::TEST);

        stream[]
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =============================          GLOBAL VARS AND CONSTS          =============================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Mangle the name of a global variable generator
     * @params:
     *     - gv: the global var to mangle
     * */
    pub fn mangleGlobalVar(gv: &GlobalVarGenerator)-> [c8] {
        if (gv.externLang == Keys::CLANG) {
            return gv.name.asStdPath().file();
        }

        let dmut stream = copy StringStream();
        stream:.write(YmirMangleCsts::PREFIX,
                       Mangler::manglePath(gv.name),
                       YmirMangleCsts::VAR);

        stream[]
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          PATH          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Mangle a path
     * */
    pub fn manglePath(path: &SymbolPath)-> [c8] {
        let dmut buf = copy StringStream();
        let templates = path.templates;
        for i, f in path.parts {
            buf:.write(f.len, f);
            match templates[i] {
                Ok(tmp: _) => {
                    buf:.write(Mangler::mangleTemplates(tmp));
                }
            }
        }

        buf[]
    }

    /**
     * Mangle a file path
     * */
    pub fn manglePath(path: Path)-> [c8] {
        let dmut buf = copy StringStream();
        for f in path.parts() {
            buf:.write(f.len);
            for i in f {
                if std::char::isPunctuation(i) {
                    buf:.write("_");
                } else {
                    buf:.write(i);
                }
            }
        }

        buf[]
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==============================          TEMPLATE PARAMETERS          ===============================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Mangle a template mapper
     * */
    fn mangleTemplates(templates: TemplateMapper)-> [c8] {
        let dmut stream = copy StringStream();
        let tmps = templates.mapping;
        for name in templates.nameOrder {
            match tmps[name] {
                Ok(expr: &ValueWrapperExpr) => {
                    stream:.write(format("N%", Mangler::mangleValue(expr.value)));
                }
                Ok(expr: &TypeWrapperExpr) => {
                    let mutability = if (name in templates.mutables) {
                        "m"
                    } else if (name in templates.deeplyMutables) {
                        "dm"
                    } else { "" };

                    stream:.write(format("N%%", mutability, Mangler::mangleType(expr.type, fatherMut-> true)));
                }
                Ok(exprs: &TypeListWrapperExpr) => {
                    let mutability = if (name in templates.mutables) {
                        "m"
                    } else if (name in templates.deeplyMutables) {
                        "dm"
                    } else { "" };

                    let dmut innerStream = copy StringStream();
                    for e in exprs.types {
                        innerStream:.write(format("N%", Mangler::mangleType(e, fatherMut-> true)));
                    }
                    stream:.write(format("L%N%%", innerStream[].len, mutability, innerStream[]));
                }
                x: _ => {
                    println(x);
                    panic;
                }
            }
        }

        stream[]
    }

}
