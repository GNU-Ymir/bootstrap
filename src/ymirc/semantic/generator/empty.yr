in empty;

use ymirc::utils::{format, comparison};
use ymirc::lexing::word;
use std::stream;


/**
 * Class usable as a placeholder for symbols that are not yet validated.
 * 
 * */
@final
pub class  EmptyGenerator over Generator {

    pub self ()
        with super (EOF_WORD)
    {}

    impl Streamable;
    
    impl Comparable!{&Generator} {
        pub over opEquals (self, o : &Generator)-> bool {
            return o of EmptyGenerator;            
        }    
    }    
    
    impl Formattable {
        pub over format (self, dmut stream : &Formatter) {
            stream:.write ("<empty-generator>");
        }
    }
}
