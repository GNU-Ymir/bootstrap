in type;

use ymirc::lexing::word;
use ymirc::utils::{format, comparison};
use std::stream;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub mod ::custom;
pub mod ::native;
pub mod ::syntax;
pub mod ::temporary;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          ANCESTOR          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * Base class for all semantic types produced during validation.
 *
 * A `Type` instance represents the fully-resolved semantic form of a type
 * appearing in user code. Concrete subclasses describe native types,
 * user-defined types, syntactic sugar expansions, and temporary types
 * introduced during inference.
 *
 * Every `Type` is responsible for:
 *   - describing its mutability and the mutability of its inner components,
 *   - expressing whether it borrows data and at which depth,
 *   - define the data structure that will generate the corresponding YIL nodes,
 *   - supporting compatibility checks and mutability preserving assignments,
 *   - providing cloning operations that adjust mutability patterns.
 *
 */
@abstract
pub class Type over Generator {

    /*! Public fields */
    pub {
        // True iif the type is mutable
        let isMutable: bool;
    }

    /**
     * @params:
     *    - loc:       the location of the type
     *    - isMutable: whether the outermost layer is mutable
     */
    pub self (loc: &Word, isMutable: bool)
        with super (loc)
        , isMutable = isMutable
    {}


    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ================================          MUTABILITY TESTS          ================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: true iff the type AND all of its inner components are mutable.
     *
     * This is a structural property: for composite types(slices, tuples,
     * functions, etc.), all nested types must also be mutable.
     */
    @field
    pub fn isDeeplyMutable(self)-> bool;

    /**
     * @returns: true iff this type requires an explicit alias when borrowed.
     *
     * A type needs an explicit alias when its semantics require the user to
     * acknowledge that a borrow occurs(i.e., mutable borrows).
     */
    @field
    pub fn needsExplicitAlias(self)-> bool;

    /**
     * @returns true iff this type contains any borrowed component.
     *
     * This predicate ignores mutability: it only reports whether the type
     * structurally borrows data from another value at any depth.
     *
     * In other words, `borrowsData()` is true exactly when making the type
     * deeply mutable would cause `needsExplicitAlias()` to become true.
     */
    @field
    pub fn borrowsData(self)-> bool;

    /**
     * @returns the maximum number of mutable borrowed components in this type.
     *
     * This is the upper bound used when computing mutability distances.
     */
    @{field, final}
    pub fn maxMutabilityDistance(self)-> u32 {
        return self.computeMaxMutabilityDistance(borrowed-> false);
    }

    /**
     * @returns: true iff values of this type must be moved when assigned.
     *
     * Default: false.
     *
     * Types that own resources or represent unique values(i.e. entities), must
     * override this method.
     */
    @field
    pub fn isMovable(self)-> bool {
        false
    }

    /**
     * @returns true iff this type can describe a concrete value stored in memory.
     *
     * Some types(e.g., `void`, type-level constructs, or pure borrow-only
     * descriptors, temporary types, etc.) cannot appear as standalone values.
     */
    @field
    pub fn isAddressable(self)-> bool;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          CLONING          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Clone the type while applying a mutability depth.
     *
     * @param
     *   - mutLevel: The maximum depth at which mutability is applied.
     *       Example for a slice:
     *         mutLevel = 2-> mut[mut i32]
     *         mutLevel = 1-> mut[i32]
     *
     * @returns a structurally identical type with adjusted mutability.
     */
    pub fn clone(self, mutLevel: u32)-> &Type;

    /**
     * Clone the type, applying the mutability pattern of 'pattern'
     * @example:
     * ```
     * // with `a` of  mut[mut[mut i32]]
     * // with `b` of [f32]
     * b.clone(pattern-> a); // mut[mut f32]
     * ```
     * */

    /**
     * Clone the type using the mutability pattern of another type.
     *
     * The structure of `self` is preserved; only mutability is copied.
     *
     * @example
     * ```
     *  // `a` : mut[mut[mut i32]]
     *  // `b` : [f32]
     *   b.clone(pattern-> a)  // → mut[mut f32]
     * ```
     **/
    pub fn clone(self, pattern: &Type)-> &Type;

    /**
     * Clone the type into a deeply mutable version.
     *
     * All inner types become mutable, except fields of custom types whose
     * mutability is fixed by their symbol definition. For example, immutable
     * fields declared in user-defined records remain immutable.
     */
    pub fn toDeeplyMutable(self)-> &Type;

    /**
     * Clone the type, making every component mutable *unless* doing so would
     * change the mutability of borrowed data.
     *
     * @returns a version of the type where all non-borrowed components are mutable.
     *
     * Borrowed components keep their original mutability. If a borrowed value was
     * already mutable, it remains mutable; otherwise it stays const.
     */
    pub fn cloneMutableUntilBorrow(self)-> &Type;


    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          COMPATIBILITY          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Check whether `other` is compatible with `self`.
     *
     * Compatibility means that a value of type `other` can be stored in a
     * location of type `self` without requiring a transformation.
     *
     * @returns true iff `other` is compatible with `self`.
     *
     * @warning
     *   This relation is NOT symmetric.
     *   Example:
     *     ([i32]).isCompatible([void])-> true
     *     ([void]).isCompatible([i32])-> false
     *
     * For symmetric comparison, use `opEquals`: equal types are always compatible,
     * but compatible types are not necessarily equal.
     */
    pub fn isCompatible(self, other: &Type)-> bool;

    /**
     * Check whether assigning a value of type `self` into a location of type
     * `other` preserves the mutability of borrowed data.
     *
     * @returns true iff the assignment does not make any currently-const borrowed
     *          data become mutable.
     *
     * @param
     *   - borrowed: Internal flag used when recursing through borrowed components.
     *
     * @example:
     * ````
     *   // a: mut[mut i32]
     *   // b: [i32]
     *   // c: mut[i32]
     *
     *   a.mutabilityFit(b)-> true
     *   a.mutabilityFit(c)-> true
     *
     *   b.mutabilityFit(c)-> true   // c does not borrow
     *   c.mutabilityFit(a)-> false  // would make borrowed data mutable
     * ```
     */
    pub fn mutabilityFit(self, other: &Type, borrowed: bool = false)-> bool;

    /**
     * Compute how many mutable borrowed components become const when fitting
     * `self` into `other`, assuming `other` borrows less than `self`.
     *
     * Used during type specialization: the smaller the distance, the fewer
     * mutability changes are required to adapt `self` to `other`.
     *
     * @returns the mutability distance between the two types.
     */
    pub fn mutabilityDistance(self, other: &Type, borrowed: bool = false)-> u32;

    /**
     * Internal method used to compute the value returned by `self.maxMutabilityDistance` field method.
     *
     * The borrowed flag indicates whether the current recursion is inside a borrowed component.
     */
    prot fn computeMaxMutabilityDistance(self, borrowed: bool)-> u32;

    /**
     * @returns true iff `self` and `other` have exactly the same mutability
     *          pattern at every depth.
     */
    pub fn sameMutability(self, other: &Type)-> bool;


    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable;

}
