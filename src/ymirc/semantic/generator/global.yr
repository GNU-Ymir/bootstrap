in global;

use ymirc::utils::comparison;
use ymirc::lexing::{word, keys};
use ymirc::semantic::symbol;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ===================================          SUBMODULES          ===================================
 * ====================================================================================================
 * ====================================================================================================
 */

mod ::frame;
mod ::globvar;
mod ::mapinfo;
mod ::unittest;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          TYPES          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub def FrameGenerator:     frame::FrameGenerator;
pub def FrameKind:          frame::FrameKind;
pub def GlobalVarGenerator: globvar::GlobalVarGenerator;
pub def MapInfoGenerator:   mapinfo::MapInfoGenerator;
pub def UnitTestGenerator:  unittest::UnitTestGenerator;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          ANCESTOR          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * Ancestor class of global generators
 * */
@abstract
pub class GlobalGen over Generator {

    /*! Public fields */
    pub {
        // The name of the global symbol
        let name: &SymbolPath;

        // The location where the symbol is really implemented Not defined, but
        // where the symbol was validated(e.g. for templates, it's different
        // than declaration location)
        //
        let implLoc: &Word;

        // The lang of the symbol(for mangling semantic)
        let externLang: [c8];

        // True if overwritten if another symbol with the same name of found
        // Used to solve collision on template symbols
        //
        let isWeak: bool;
    }

    /**
     * @params:
     *    - loc:        the location of the symbol that produced the generator
     *    - name:       the name of the generator
     *    - isWeak:     true if overwritten by symbols with the same mangled name
     *    - implLoc:    the location of the implementation that produced the generator(e.g. template call)
     *    - externLang: the lang of the generator(e.g. Keys: : C, Keys: : YMIR), empty means Ymir
     * */
    pub self (loc: &Word,
              name: &SymbolPath,
              isWeak: bool,
              implLoc: &Word = EOF_WORD,
              externLang: [c8] = Keys::YLANG)

        with super (loc)
        , name = name
        , isWeak = isWeak
        , implLoc = (if implLoc.isEof { loc } else { implLoc })
        , externLang = (if (externLang == "") { Keys::YLANG } else { externLang })
    {}

    impl Comparable!{&Generator};
}
