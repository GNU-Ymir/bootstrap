in mapinfo;

use ymirc::semantic::generator::{type, value, type::_, value::_};

use ymirc::utils::{format, comparison};
use ymirc::lexing::{word, tokens};
use std::{stream, fs::path};

/**
 * Generate a constant in YIL that holds information for Map Key/Value utils,
 * for the runtime to handle them.
 *
 */
@final
pub class MapInfoGenerator over GlobalGen {

    /*! Public fields */
    pub {
        // The map type of the map info
        let map: &MapType;

        // The comparison function
        let cmpFunc: &PrototypeValue;

        // The hash function
        let hashFunc: &PrototypeValue;
    }

    /**
     * @params:
     *    - loc:      the location of the map that needs information
     *    - map:      the type of the map that produces this generator
     *    - cmpFunc:  the function comparing keys
     *    - hashFunc: the function hashing keys
     * */
    pub self (loc: &Word,
              map: &MapType,
              cmpFunc: &PrototypeValue,
              hashFunc: &PrototypeValue)

        with super (loc, name-> copy SymbolPath (""), isWeak-> true)
        , map = map
        , cmpFunc = cmpFunc
        , hashFunc = hashFunc
    {}


    impl Comparable!{&GlobalGen};
    impl Streamable;
    impl Formattable {

        pub over format (self, dmut stream: &Formatter) {
            stream:.write ("map_info: ", self.map);
        }
    }




}
