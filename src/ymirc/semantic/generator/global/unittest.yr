in unittest;

use ymirc::semantic::generator::{type, value};
use ymirc::semantic::symbol;

use ymirc::utils::{format, comparison};
use ymirc::lexing::word;
use std::stream;


/**
 * Special frame used to executed a unittest
 *
 */
@final
pub class UnitTestGenerator over GlobalGen {

    /*! Public fields */
    pub {
        // The body of the unittest
        let value: &Value;
    }

    /**
     * @params:
     *    - loc:   the location of the unittest
     *    - name:  the name of the unittest
     *    - value: the value executed by the unittest
     * */
    pub self (loc:   &Word,
              name:  &SymbolPath,
              value: &Value)

        with super (loc, name, isWeak-> true)
        , value = value
    {}

    impl Comparable!{&GlobalGen};
    impl Streamable;
    impl Formattable {

        pub over format (self, dmut stream: &Formatter) {
            stream:.write ("unittest: ");
            stream:.write (' ', self._name.toStr (), ' ');
            self._value.format (alias stream);
        }
    }




}
