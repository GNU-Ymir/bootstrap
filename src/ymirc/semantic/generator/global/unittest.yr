in unittest;

use ymirc::semantic::generator::{type, value, value::_};
use ymirc::semantic::symbol;

use ymirc::utils::{format, comparison};
use ymirc::lexing::{tokens, word};
use std::stream;


/**
 * Special frame used to executed a unittest
 *
 */
@final
pub class UnitTestGenerator over GlobalGen {

    /*! Public fields */
    pub {
        // The body of the unittest
        let value: &Value;

        // The parameters the unittest is called with, empty if it takes none
        let params: [&ProtoVarDeclValue];

        // The value producing the parameter sets, UNIT_VALUE if the test takes none
        let provider: &Value;
    }

    /**
     * @params:
     *    - loc:      the location of the unittest
     *    - name:     the name of the unittest
     *    - value:    the value executed by the unittest
     *    - params:   the parameters the unittest is called with
     *    - provider: the value producing the parameter sets
     * */
    pub self (loc:      &Word,
              name:     &SymbolPath,
              value:    &Value,
              params:   [&ProtoVarDeclValue] = [],
              provider: &Value = UNIT_VALUE)

        with super (loc, name, isWeak-> true)
        , value = value
        , params = params
        , provider = provider
    {}

    /**
     * @returns: true iif the unittest is run once per parameter set
     * */
    @field
    pub fn isParameterized(self)-> bool {
        self.params.len != 0us
    }

    impl Comparable!{&GlobalGen};
    impl Streamable;
    impl Formattable {

        pub over format(self, dmut stream: &Formatter) {
            stream:.write("unittest: ");
            stream:.write(' ', self.name.toStr(), ' ');
            if (self.isParameterized) {
                stream:.write(Tokens::LPAR);
                for i, p in self.params {
                    if (i != 0us) stream:.write(Tokens::COMA, " ");
                    stream:.write(p.loc.str, " : ");
                    p.type.format(alias stream);
                }
                stream:.write(Tokens::RPAR, " in ");
                self.provider.format(alias stream);
                stream:.write(' ');
            }
            self.value.format(alias stream);
        }
    }




}
