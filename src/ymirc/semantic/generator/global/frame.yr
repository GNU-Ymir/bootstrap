in frame;

use ymirc::semantic::generator::{type, value, value::_};
use ymirc::semantic::{symbol, template_};

use ymirc::utils::{format, comparison};
use ymirc::lexing::{word, keys};
use std::stream;

pub enum FrameKind
| FUNC       = 1
| METHOD     = 2
| CTOR       = 3
| DTOR       = 4
| LMBD       = 5
| CTOR_CLASS = 6;

/**
 * A frame is a function that can be sent to the back end for final transformation and final code generation
 */
@final
pub class FrameGenerator over GlobalGen {

    /*! Public fields */
    pub {
        // The list of parameters
        let params: [&ProtoVarDeclValue];

        // The return type of the frame
        let retType: &Type;

        // The body of the frame
        let body: &Value;

        // The template mapper used to generate the frame if generated by
        // template specialization
        //
        let templateMapper: (TemplateMapper)?;

        // The kind of symbol that generated the frame
        let kind: FrameKind;
    }

    /**
     * @params:
     *    - loc:            the location of the declaration of the symbol that produced the frame
     *    - implLoc:        the location of the implementation of the symbol
     *    - name:           the name of the frame
     *    - params:         the parameters of the frame
     *    - retType:        the type returned by the frame
     *    - body:           the content of the frame
     *    - kind:           the kind of frame
     *    - externLang:     the langage of the frame(for the mangler)
     *    - isWeak:         true iif the frame can be overwritten by frames with the same name
     *    - templateMapper: the list of template parameters used to specialize the frame
     * */
    pub self (loc: &Word,
              implLoc: &Word,
              name: &SymbolPath,
              params: [&ProtoVarDeclValue],
              retType: &Type,
              body: &Value,
              kind: FrameKind,
              externLang: [c8] = "",
              isWeak: bool = false,
              templateMapper: TemplateMapper? = none)

        with super (loc, name, isWeak-> isWeak, implLoc-> implLoc, externLang-> externLang)
        , params = params
        , retType = retType
        , body = body
        , kind = kind
        , templateMapper = templateMapper
    {}


    /**
     * @returns: true iif the frame was generated with template specialization
     * */
    @field
    pub fn isTemplate(self)-> bool {
        self.templateMapper.hasValue
    }

    impl Comparable!{&GlobalGen};
    impl Streamable;
    impl Formattable {
        pub over format(self, dmut stream: &Formatter) {
            stream:.write("frame:");
            if (self.isWeak) { stream:.write(" [weak]"); }
            if (self.externLang != "" && self.externLang != Keys::YLANG) {
                stream:.write(" from[", self.externLang, "]");
            }

            stream:.write(' ', self.name.toStr(), ' ');
            stream:.write('(');
            stream:.entabing();
            for i, p in self.params {
                if (i != 0) stream:.write(", ");
                p.format(alias stream);
            }

            stream:.write(")-> ");
            self.retType.format(alias stream);

            stream:.write(' ');
            stream:.detabing();

            self.body.format(alias stream);
        }
    }
}
