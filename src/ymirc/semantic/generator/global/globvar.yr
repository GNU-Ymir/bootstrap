in globvar;

use ymirc::lexing::{keys, word};
use ymirc::utils::{format, comparison};

use ymirc::semantic::generator::{type, value, value::_};
use ymirc::semantic::{symbol, template_};
use std::stream;


/**
 * A var decl is a variable declared in a function
 */
@final
pub class GlobalVarGenerator over GlobalGen {

    /*! Public fields */
    pub {
        // The type of the variable declared(self.getType() always return Void)
        let type: &Type;

        // The value of the variable
        let value: &Value;

        // True if the variable is declared mutable
        let isMutable: bool;

        // True if the variable is lazy
        let isLazy: bool;

        // True if the variable is thread local
        let isThreadLocal: bool;
    }

    /**
     * @params:
     *    - loc:           the location of the symbol that produced the global variable
     *    - name:          the name of the variable
     *    - type:          the type of the variable
     *    - value:         the initial value of the global variable
     *    - isMutable:     true if the value of the variable can be changed at runtime
     *    - isLazy:        true if the variable is init lazyly
     *    - isThreadLocal: true if a new variable is spawned each time a POSIX thread is started
     *    - externLang:    the language of the variable(for mangling)
     *    - isWeak:        true if the variable can be overwritten by variables with the same name
     */
    pub self (loc:           &Word,
              name:          &SymbolPath,
              type:          &Type,
              value:         &Value,
              isMutable:     bool,
              isLazy:        bool,
              isThreadLocal: bool,
              externLang:    [c8] = "",
              isWeak:        bool = false)

        with super (loc, name, isWeak-> isWeak, implLoc-> loc, externLang-> externLang)
        , value = value
        , isMutable = isMutable
        , type = type
        , isLazy = isLazy
        , isThreadLocal = isThreadLocal
    {}

    impl Comparable!{&GlobalGen};
    impl Streamable;
    impl Formattable {

        pub over format(self, dmut stream: &Formatter) {
            stream:.write("var: ");
            if (self.isWeak)
                stream:.write("[weak]");

            if (self.externLang != "" && self.externLang != Keys::YMIR) {
                stream:.write("from[", self.externLang, "] ");
            }

            if (self.isLazy) stream:.write(Keys::LAZY, ' ');
            if (self.isMutable) stream:.write(Keys::MUTABLE, ' ');

            stream:.write(self.name.toStr());
            if (self.isThreadLocal) stream:.write("@tl");
            stream:.write(" ");

            stream:.entabing();
            stream:.write(": ", self.type);
            match self.value {
                UnitValue() => {}
                _ => {
                    stream:.write(" = ");
                    stream:.write(self.value);
                }
            }

            stream:.detabing();
        }
    }

}
