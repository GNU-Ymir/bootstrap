in tag;

use ymirc::lexing::{tokens, word};
use ymirc::semantic::symbol;
use ymirc::semantic::generator::value;
use ymirc::utils::{comparison, format};

use std::stream;

/**
 * The construction of a tag site, `#[name(args)]`: the call of the instance of
 * the `self` overload it selected, run once at program start along with the
 * other sites of its module
 */
@final
pub class TagCtorGenerator over GlobalGen {

    /*! Public fields */
    pub {
        // The tag the site names
        let tag: &SymbolPath;

        // The call of the instance of the `self` overload
        let call: &Value;
    }

    /**
     * @params:
     *    - loc:  the name of the tag, at the site
     *    - name: the tagged symbol
     *    - tag:  the tag the site names
     *    - call: the call of the instance of the `self` overload
     * */
    pub self (loc: &Word, name: &SymbolPath, tag: &SymbolPath, call: &Value)
        with super (loc, name, isWeak-> false)
        , tag = tag
        , call = call
    {}

    impl Comparable!{&GlobalGen};
    impl Streamable;
    impl Formattable {

        pub over format(self, dmut stream: &Formatter) {
            stream:.write("tag_ctor: ", self.name.toStr(), " #", Tokens::LCRO, self.tag.toStr(), Tokens::RCRO, ' ');
            self.call.format(alias stream);
        }
    }
}
