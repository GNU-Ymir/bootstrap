in delegate;

use ymirc::lexing::word;
use ymirc::utils::{format, comparison};
use ymirc::semantic::generator::type;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

mod ::cast_;
mod ::ctor;
mod ::ctortemplate;
mod ::fakemethod;
mod ::method;
mod ::methodtemplate;
mod ::name;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          TYPES          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub def CtorDelegateTemplateValue:   ctortemplate::CtorDelegateTemplateValue;
pub def CtorDelegateValue:           ctor::CtorDelegateValue;
pub def FakeMethodDelegateValue:     fakemethod::FakeMethodDelegateValue;
pub def FptrCastDelegateValue:       cast_::FptrCastDelegateValue;
pub def MethodDelegateTemplateValue: methodtemplate::MethodDelegateTemplateValue;
pub def MethodDelegateValue:         method::MethodDelegateValue;
pub def NameDelegateValue:           name::NameDelegateValue;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          ANCESTOR          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * The DelegateValue class is the abstract ancestor for all delegate
 * constructions. A delegate in Ymir is a pair consisting of:
 * 
 *   - a function pointer (the callable target),
 *   - a closure value (the environment or bound context).
 *
 * Different concrete subclasses implement the various ways a delegate may be
 * formed, including:
 * 
 *   - capturing closures,
 *   - method references,
 *   - class constructor delegates,
 *   - template-based delegate generation,
 *   - synthetic delegates created by the compiler.
 *
 * DelegateValue itself does not store the function pointer or closure; it
 * provides the common interface and semantic behavior shared by all delegate
 * constructions. It ensures:
 * 
 *   - delegates are never lvalues,
 *   - literal status is explicitly controlled by subclasses,
 *   - throwers are propagated from the underlying construction logic.
 *
 */

@abstract
pub class  DelegateValue over Value {

    /**
     * Initializes a DelegateValue.
     *
     * Parameters:
     *   - loc:       the source location of the delegate expression.
     *   - type:      the delegate type (Delegate[T] or similar).
     *   - isReduced: whether the delegate value has already been reduced.
     *   - throwers:  the list of throwers associated with the delegate
     *                construction.
     *
     * DelegateValue enforces that delegates are never lvalues. Concrete
     * subclasses are responsible for providing the correct thrower set.
     * 
     */
    pub self (loc:       &Word,
              type:      &Type,
              isReduced: bool,
              throwers:  [Thrower])
        
        with super (loc,
                    type,
                    isReduced-> isReduced,
                    isLvalue-> false,
                    throwers-> throwers)
        
    {}

    impl Comparable!{&Generator};
}
