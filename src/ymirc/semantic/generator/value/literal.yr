in literal;

use ymirc::lexing::word;
use ymirc::utils::{format, comparison};
use ymirc::semantic::generator::type;


/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

mod ::array;
mod ::arrayalloc;
mod ::bool_;
mod ::char;
mod ::fake;
mod ::float;
mod ::fptr;
mod ::int;
mod ::map;
mod ::none_;
mod ::null_;
mod ::option;
mod ::range;
mod ::slice;
mod ::string;
mod ::struct_;
mod ::template_;
mod ::tuple;
mod ::typeinfo;
mod ::unit;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          TYPES          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub def ArrayAllocValue:      arrayalloc::ArrayAllocValue;
pub def ArrayValue:           array::ArrayValue;
pub def BoolValue:            bool_::BoolValue;
pub def CharValue:            char::CharValue;
pub def CharValueContent:     char::CharValueContent;
pub def ErrOptionValue:       none_::ErrOptionValue;
pub def FakeValue:            fake::FakeValue;
pub def FloatValue:           float::FloatValue;
pub def IntValue:             int::IntValue;
pub def MapValue:             map::MapValue;
pub def NullValue:            null_::NullValue;
pub def OptionValue:          option::OptionValue;
pub def ProtoFuncPtrValue:    fptr::ProtoFuncPtrValue;
pub def RangeValue:           range::RangeValue;
pub def SliceCtorValue:       slice::SliceCtorValue;
pub def StringValue:          string::StringValue;
pub def StringValueContent:   string::StringValueContent;
pub def StructInitValue:      struct_::StructInitValue;
pub def TemplateDefaultValue: template_::TemplateDefaultValue;
pub def TupleValue:           tuple::TupleValue;
pub def TypeInfoValue:        typeinfo::TypeInfoValue;
pub def UnitValue:            unit::UnitValue;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          LAZY          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub lazy FALSE_BOOL_VALUE = copy BoolValue(EOF_WORD, false);
pub lazy NULL_VALUE       = copy NullValue(EOF_WORD);
pub lazy TRUE_BOOL_VALUE  = copy BoolValue(EOF_WORD, true);
pub lazy UNIT_VALUE       = copy UnitValue();


/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          ANCESTOR          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * Base class for all literal values.
 *
 * LiteralValue represents any compile-time constant value produced directly by
 * the syntax(integer literal, float literal, string literal, boolean literal,
 * null literal, tuple literal, array literal, etc.).
 *
 * LiteralValue provides the common semantic foundation for all literal
 * subclasses, ensuring consistent behavior across the entire literal hierarchy.
 */
@abstract
pub class LiteralValue over Value {

    /**
     * Creates a new literal value.
     *
     * Parameters:
     *   - loc:       the source location of the literal.
     *   - type:      the semantic type of the literal.
     *   - throwers:  the list of potential throwers associated with the literal.
     *   - isReduced: true if the literal is already reduced(always true for
     *                user-written literals, but may differ for generated ones).
     */
    pub self (loc:       &Word,
              type:      &Type,
              throwers:  [Thrower],
              isReduced: bool)

        with super (loc,
                    type,
                    isReduced-> isReduced,
                    throwers-> throwers,
                    isLvalue-> false)

    {}

    impl Comparable!{&Generator} {
        pub over opEquals(self, o: &Generator)-> bool {
            return self.super.opEquals(o);
        }
    }
}
