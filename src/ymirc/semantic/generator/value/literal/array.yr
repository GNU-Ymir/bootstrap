 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in array;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::type::native;

/**
 * Represents a literal array value.
 *
 * ArrayValue encapsulates:
 *   - the list of element values(`values`),
 *   - the array type(ArrayType),
 *   - the union of all element throwers,
 *   - literal-specific behavior such as full-literal detection.
 *
 * Array literals may contain heterogeneous literal values as long as the
 * resulting ArrayType is consistent. They participate in constant folding and
 * compile-time evaluation.
 */
@final
pub class ArrayValue over LiteralValue {

    pub {
        /**
         * The list of element values contained in the array literal.
         *
         * Each element is a Value, not necessarily a literal. The array literal
         * is considered a full literal only if all elements are full literals.
         */
        let values: [&Value];
    }

    /**
     * Creates a new ArrayValue.
     *
     * Parameters:
     *   - loc:       the source location of the array literal.
     *   - type:      the ArrayType of the literal.
     *   - values:    the list of element values.
     *   - isReduced: true if the literal has already been reduced.
     *
     * The constructor aggregates throwers from all element values and forwards
     * initialization to LiteralValue.
     */
    pub self (loc:       &Word,
              type:      &ArrayType,
              values:    [&Value],
              isReduced: bool = false)

        with super (loc,
                    type,
                    isReduced-> isReduced,
                    throwers-> {
                        let mut th: [Thrower] = [];
                        for i in values {
                            th ~= i.throwers;
                        }

                        th
                    })

        , values = values
    {}

    /**
     * Returns the number of elements in the array literal.
     */
    @field
    pub fn len(self)-> usize {
        self.values.len
    }


    /**
     * Indicates whether this array literal is a full literal.
     *
     * An ArrayValue is a full literal only if all its elements are full
     * literals. This allows nested literal structures to propagate literal
     * status correctly.
     */
    @field
    pub over isFullLiteral(self)-> bool {
        for i in self.values {
            if !i.isFullLiteral return false;
        }

        true
    }

    /**
     * Creates a deep clone of this ArrayValue. Cloning inner values recursively.
     */
    pub over clone(self)-> &Value {
        if let a: &ArrayType = self.type {
            let inners = copy [i.clone() for i in self.values];
            return copy ArrayValue(self.loc,
                                    a,
                                    inners,
                                    isReduced-> self.isReduced);
        }

        panic;
    }


    impl Comparable!{&Generator};
    impl Streamable;
    impl Formattable {

        /**
         * Formats the array literal for debugging or pretty-printing.
         *
         * The printed form is:
         *     [a, b, c]
         *
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write('[');
            stream:.entabing();
            for j, i in self.values {
                if (j != 0us) stream:.write(", ");
                i.format(alias stream);
            }
            stream:.detabing();
            stream:.write(']');
        }
    }
}
