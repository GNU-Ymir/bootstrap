/*
 * Declares the StructInitValue class.
 *
 * StructInitValue is an internal semantic construction representing the
 * initialization of struct fields *without* invoking a constructor. It has no
 * direct syntactic counterpart in the Ymir language: it is produced exclusively
 * during semantic lowering to model field-based initialization for internal
 * structures.
 *
 * A StructInitValue stores:
 *   - the list of field values,
 *   - the list of field names (which may be shorter than the value list),
 *   - the target struct type.
 *
 * It is used as an intermediate representation and is not expected to appear
 * in user-written code.

 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::generator::value::literal::struct_
 * @File: ymirc/semantic/generator/value/literal/struct_.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2026-03-05
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in struct_;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::type::custom;

/**
 * Represents a struct literal initialization.
 *
 * StructInitValue encapsulates:
 *
 *   - the list of field values (`values`),
 *   - the list of field names (`fields`),
 *   - the ClassPtrType describing the struct type,
 *   - aggregated throwers from all field values,
 *   - literal semantics depending on the inner values.
 *
 * Field names may be fewer than the number of values when positional
 * initialization is used.
 */
@final
pub class StructInitValue over LiteralValue {

    pub {
        /*
         * The list of values assigned to the struct fields.
         */
        let values: [&Value];

        /*
         * The list of field names corresponding to the values.
         *
         * The array may be shorter than `values` when positional initialization
         * is used.
         */
        let fields: [[c8]];
    }

    /**
     * Creates a new StructInitValue.
     *
     * Parameters:
     *   - loc:       the source location of the literal.
     *   - type:      the ClassPtrType of the struct being initialized.
     *   - values:    the list of field values.
     *   - fields:    the list of field names (may be shorter than values).
     *   - isReduced: true if the literal has already been reduced.
     *
     * The constructor aggregates throwers from all field values.
     */
    pub self (loc:       &Word,
              type:      &ClassPtrType,
              values:    [&Value],
              fields:    [[c8]],
              isReduced: bool = false)

        with super (loc,
                    type,
                    isReduced-> isReduced,
                    throwers-> {
                        let mut th: [Thrower] = [];
                        for i in values {
                            throwers ~= i.throwers;
                        }

                        th
                    })

        , values = values
        , fields = fields
    {}

    /**
     * @returns: the number of initialized fields
     */
    @field
    pub fn arity (self)-> usize {
        self.values.len
    }

    /**
     * A struct literal is a full literal only if all its field values are full
     * literals.
     */
    @field
    pub over isFullLiteral (self)-> bool {
        for i in self.values {
            if !i.isFullLiteral return false;
        }

        return true;
    }

    /**
     * Creates a deep clone of this StructInitValue.
     *
     */
    pub over clone (self)-> &Value {
        let mut inners: [mut &Value] = copy [i.clone () for i in self.values];

        if let t: &ClassPtrType = self.type {
            return copy StructInitValue (self.loc,
                                         t,
                                         inners,
                                         fieldNames-> self.fields,
                                         isReduced-> self.isReduced);
        }

        panic;
    }


    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /**
         * Formats the struct literal for debugging or pretty-printing.
         *
         * Printed as:
         *     (x -> 1, y -> 2)
         *
         * If only one value is present, a trailing comma is printed to preserve
         * tuple-like disambiguation.
         *
         */
        pub over format (self, dmut stream: &Formatter) {
            stream:.write ('(');
            stream:.entabing ();
            for j, i in self.values {
                if (j != 0us) stream:.write (", ");
                if (self.fields.len > j) {
                    stream:.write (self.fields [j], "-> ");
                }
                i.format (alias stream);
            }
            if (self.values.len == 1us) stream:.write (',');
            stream:.detabing ();
            stream:.write (')');
        }
    }
}
