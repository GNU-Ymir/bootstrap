 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in fake;

use ymirc::lexing::word;
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::type;

/**
 * Represents a placeholder literal of a given type.
 *
 * FakeValue is used internally by the semantic generator whenever a value
 * must exist structurally but has no meaningful runtime representation.
 * Examples include:
 *
 *   - placeholder values for type-only constructs,
 *   - intermediate nodes during lowering,
 *   - semantic artifacts that will be replaced before code generation.
 *
 * FakeValue is never a full literal and is always considered non-reduced.
 */
@final
pub class FakeValue over LiteralValue {

    /**
     * Creates a new FakeValue placeholder.
     *
     * Parameters:
     *   - loc:  the source location associated with the placeholder (defaults
     *           to EOF_WORD when no meaningful location exists).
     *   - type: the semantic type the placeholder pretends to represent.
     *
     * FakeValue carries no throwers and is never an l‑value.
     */
    pub self (loc: &Word = EOF_WORD, type: &Type)
        with super (loc, type, isReduced-> true, throwers-> [])
    {}


    /**
     * FakeValue is never a full literal.
     *
     * This ensures that literal-only optimizations or constant folding never
     * treat FakeValue as a concrete compile-time constant.
     */
    @field
    pub over isFullLiteral (self)-> bool {
        false
    }

    /**
     * Cloning a FakeValue returns the same instance.
     *
     * FakeValue has no internal state beyond its type and location, and is
     * immutable by design.
     */
    pub over clone (self)-> &Value {
        self
    }

    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /**
         * Formats the placeholder for debugging or pretty‑printing.
         *
         * Printed as:
         *     <fake-value:Type>
         */
        pub over format (self, dmut stream: &Formatter) {
            stream:.write ("<fake-value:"s8, self.type, ">"s8);
        }
    }

}
