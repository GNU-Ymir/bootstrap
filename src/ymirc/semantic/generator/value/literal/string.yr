/*
 * Declares the StringValue class.
 *
 * StringValue represents a sequence of characters encoded in UTF-8, UTF-16 or
 * UTF-32. Ymir has no dedicated “string” type: all strings are slices of chars.
 * Accordingly, StringValue always has a SliceType whose element type is a
 * CharType of the appropriate encoding size.
 *
 * StringValue is always a full literal, always reduced, immutable, and stored
 * in the constant section of the executable. It participates in compile-time
 * evaluation and supports recoding between UTF encodings.
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::semantic::generator::value::literal::string
 * @File: ymirc/semantic/generator/value/literal/string.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2021-11-20
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in string;

use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::value::literal;
use ymirc::semantic::generator::type::native;

/**
 * Represents the internal storage of a string literal.
 *
 * Only one of the three arrays is meaningful depending on the CharType
 * encoding size. The others remain empty for structural consistency.
 */
pub record StringValueContent {
    pub let utf8: [u8] = [];
    pub let utf16: [u16] = [];
    pub let utf32: [u32] = [];

    pub self (utf8: [u8]) with utf8 = utf8 {}
    pub self (utf16: [u16]) with utf16 = utf16 {}
    pub self (utf32: [u32]) with utf32 = utf32 {}

    pub fn opEquals (self, o: StringValueContent)-> bool {
        if self.utf8 != o.utf8 return false;
        if self.utf16 != o.utf16 return false;
        if self.utf32 != o.utf32 return false;

        return true;
    }
}

/**
 * Represents a string literal.
 *
 * StringValue encapsulates:
 *   - the encoded content (`value`),
 *   - a SliceType(CharType) describing the encoding,
 *   - full literal semantics (always reduced, always full literal),
 *   - formatting logic that prints the literal with the correct suffix,
 *   - utilities for recoding and conversion to ArrayValue.
 */
@final
pub class StringValue over LiteralValue {

    pub {
        /**
         * The encoded content of the string literal.
         *
         * Only one of utf8/utf16/utf32 is populated depending on the CharType
         * size. The others remain empty.
         */        
        let value: StringValueContent;
    }

    /**
     * Constructor for UTF-8.
     */
    pub self (loc: &Word, type: &SliceType, utf8: [u8])
        with super (loc, type, isReduced-> true, throwers-> [])
        , value = StringValueContent (utf8-> utf8)
    {}

    /**
     * Constructor for UTF-16.
     */
    pub self (loc: &Word, type: &SliceType, utf16: [u16])
        with super (loc, type, isReduced-> true, throwers-> [])
        , value = StringValueContent (utf16-> utf16)
    {}

    /**
     * Constructor for UTF-32.
     */
    pub self (loc: &Word, type: &SliceType, utf32: [u32])
        with super (loc, type, isReduced-> true, throwers-> [])
        , value = StringValueContent (utf32-> utf32)
    {}

    /**
     * Constructor for generic content.
     */
    pub self (loc: &Word, type: &SliceType, value: StringValueContent)
        with super (loc, type, isReduced-> true, throwers-> [])
        , value = value
    {}
    
    /**
     * Creates a UTF-8 string literal from a raw c8 array.
     */
    pub self (loc: &Word, value: [c8])
        with super (loc,
                    type-> ({
                        copy SliceType (loc, copy CharType (loc, size-> 8, isMutable-> false), isMutable-> true)
                    } catch { _ => panic; }),
                    isReduced-> true,
                    throwers-> [])
        
        , value = StringValueContent (utf8-> copy [cast!u8 (i) for i in value])        
    {}
    
    /**
     * Recodes an existing StringValue into a new encoding size. Utf conversion.
     */
    pub self (loc: &Word, value: &StringValue, size: u16 = 8)
        with super (loc,
                    type-> ({
                        copy SliceType (loc, copy CharType (loc, size-> size, isMutable-> false), isMutable-> true)
                    } catch { _ => panic; }),
                    isReduced-> true,
                    throwers-> [])
        
        , value = recode (value.value, value.encodingSize, size)
    {}  
    
    /**
     * Returns the encoding size (8, 16, or 32 bits).
     */    
    @field
    pub fn encodingSize (self)-> u16 {
        if let slc: &SliceType = self.type {
            if let c: &CharType = slc.value {
                return c.size;
            }
        }

        panic;
    }

    /**
     * Returns the number of characters in the string, without taking into
     * account char encoding codepoint length.
     * 
     */
    @field
    pub fn len (self)-> usize {
        match self.encodingSize {
            8u16  => { self.value.utf8.len }
            16u16 => { self.value.utf16.len }
            _     => { self.value.utf32.len }
        }
    }

    /**
     * Converts the string literal into an ArrayValue of CharValue.
     *
     * This is used when a string literal must be lowered into an explicit array
     * of characters.
     */
    pub fn toArray (self, loc: &Word = EOF_WORD, resultSize: u16 = 8)-> &ArrayValue {
        use ymirc::semantic::validator;        
        let decoded: [c8] = match self.encodingSize {
            8u16  => { Utf::decode (self.value.utf8) }
            16u16 => { Utf::decode (self.value.utf16) }
            _     => { Utf::decode (self.value.utf32) }
        };
        
        let mut res: [mut &Value] = [];
        match resultSize {
            8u16  => {
                let encode = Utf::encodeUtf8 (decoded);
                res = copy [copy CharValue (loc, cast!u32 (i), size-> 8u16) for i in encode];
            }
            16u16 => {
                let encode = Utf::encodeUtf16 (decoded);
                res = copy [copy CharValue (loc, cast!u32 (i), size-> 16u16) for i in encode];
            }
            _     => {
                let encode = Utf::encodeUtf32 (decoded);
                res = copy [copy CharValue (loc, cast!u32 (i), size-> 32u16) for i in encode];
            }
        }

        {
            let type = copy ArrayType (loc,
                                       copy CharType (loc, size-> resultSize, isMutable-> false),
                                       res.len,
                                       isMutable-> true);
            
            return copy ArrayValue (loc, type, res);
        } catch { // array type can throw if it contains movable types, but char isn't
            _ => panic; // so panic, unexpected throw
        }        
    }
    
    /**
     * String literals are always full literals.
     */
    @field
    pub over isFullLiteral (self)-> bool {
        true
    }

    /**
     * Cloning a StringValue returns the same instance.
     *
     * StringValue is immutable.
     */
    pub over clone (self)-> &Value {
        self
    }

    impl Comparable!{&Generator};
    
    impl Streamable;
    impl Formattable {

        /**
         * Formats the string literal for debugging or pretty‑printing.
         *
         * Printed as:
         *     "hello"u8
         *     "bonjour"u16
         *     "世界"u32
         *
         * The suffix depends on the CharType size.
         */
        pub over format (self, dmut stream: &Formatter) {
            stream:.write (Tokens::DQUOTE);
            
            use ymirc::semantic::validator;            
            match self.encodingSize {
                8u16 => {
                    stream:.write (Utf::unescape (Utf::decode (self.value.utf8), squote-> false),
                                   Tokens::DQUOTE,
                                   StringSuffixes::UTF8);
                }
                16u16 => {
                    stream:.write (Utf::unescape (Utf::decode (self.value.utf16), squote-> false),
                                   Tokens::DQUOTE,
                                   StringSuffixes::UTF16);
                }
                _ => {
                    stream:.write (Utf::unescape (Utf::decode (self.value.utf32), squote-> false),
                                   Tokens::DQUOTE,
                                   StringSuffixes::UTF32);
                }
            }
        }
    }        
}


/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          UTILS          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * Re-encodes a StringValueContent from one UTF encoding to another.
 */
fn recode (value: StringValueContent, src: u16, dst: u16)-> StringValueContent {
    use ymirc::semantic::validator;
    let decoded: [c8] = match src {
        8  => { Utf::decode (value.utf8) }
        16 => { Utf::decode (value.utf16) }
        _  => { Utf::decode (value.utf32) }
    };
    
    match dst {
        8  => { return StringValueContent (utf8->  Utf::encodeUtf8 (decoded)); }                            
        16 => { return StringValueContent (utf16-> Utf::encodeUtf16 (decoded)); }
        _  => { return StringValueContent (utf32-> Utf::encodeUtf32 (decoded)); }
    }                     
}
