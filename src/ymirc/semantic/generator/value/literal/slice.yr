/*
 * Declares the SliceCtorValue class.
 *
 * SliceCtorValue represents the construction of a slice literal from an
 * existing pointer, length, and optional block metadata. It is used during
 * semantic lowering for:
 *   - internal allocations,
 *   - array-to-slice conversions,
 *   - slice construction where the pointer is already known and no new
 *     allocation is required.
 *
 * This value models the low-level structure of a slice: a pointer, a length,
 * and an optional block descriptor used for append operations. It is a
 * structural literal whose literal status depends on its component values.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::generator::value::literal::slice
 * @File: ymirc/semantic/generator/value/literal/slice.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-03-06
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in slice;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::type;
use ymirc::semantic::generator::value::memory;


/**
 * The SliceCtorValue class models the construction of a slice literal from an
 * existing pointer, length, and optional block metadata.
 *
 * Unlike array literals or slice allocations, SliceCtorValue does not allocate
 * memory. Instead, it wraps an already-existing pointer and length into a
 * slice structure. This makes it suitable for:
 *   - array-to-slice conversions,
 *   - internal slice creation during lowering,
 *   - views over existing buffers,
 *   - implicit aliasing of memory regions.
 *
 * A SliceCtorValue contains three structural components:
 *   - `ptr`: a pointer to the underlying buffer,
 *   - `len`: the visible length of the slice,
 *   - `blk`: optional block metadata used for append operations.
 *
 * The slice may be marked as an implicit alias, indicating that it does not
 * need to be put inside an aliaser to be considered aliased.
 *
 * Literal status is derived from the literal status of its components. A slice
 * is a full literal only if its pointer, length, and block metadata are all
 * full literals.
 *
 */

@final
pub class SliceCtorValue over LiteralValue {

    pub {
        /**
         * The pointer to the slice’s underlying data.
         *
         * This value must already be a valid pointer expression. SliceCtorValue
         * does not allocate memory; it only wraps an existing pointer.
         */
        let ptr: &Value;

        /**
         * The length of the slice.
         *
         * This determines how many elements are visible through the slice.
         */
        let len: &Value;

        /**
         * The block metadata associated with the slice.
         *
         * This value contains allocation and capacity information used when
         * appending to the slice. It may be NullValue when no block metadata
         * exists(i.e., meaning the slice must be reallocated if appending data to it).
         */
        let blk: &Value;

        /**
         * Indicates whether the slice is an implicit alias.
         *
         * When true, the slice does not own its memory and is simply an alias
         * to an existing buffer.
         */
        let isImplicitAlias: bool;
    }

    /**
     * Creates a new SliceCtorValue.
     *
     * Parameters:
     *   - loc:             the source location of the slice literal.
     *   - type:            the slice type.
     *   - ptr:             the pointer to the slice’s data.
     *   - blk:             the block metadata(may be NullValue).
     *   - len:             the slice length.
     *   - isImplicitAlias: whether the slice is an implicit alias.
     *   - isReduced:       whether the slice literal has already been reduced.
     *
     * The constructor does not allocate memory. It simply wraps the provided
     * pointer, length, and block metadata. Throwers are aggregated from the
     * pointer and length expressions.
     */
    pub self (loc:             &Word,
              type:            &Type,
              ptr:             &Value,
              blk:             &Value,
              len:             &Value,
              isImplicitAlias: bool,
              isReduced:       bool = false)

        with super (loc,
                    type,
                    isReduced-> isReduced,
                    throwers-> (ptr.throwers ~ len.throwers ~ blk.throwers))

        , ptr = ptr
        , blk = blk
        , len = len
        , isImplicitAlias = isImplicitAlias
    {}

    /**
     * Indicates whether the slice literal is a full literal.
     *
     * A SliceCtorValue is a full literal only if:
     *   - the pointer,
     *   - the length,
     *   - the block metadata
     * are all full literals.
     */
    @field
    pub over isFullLiteral(self)-> bool {
        self.ptr.isFullLiteral && self.len.isFullLiteral && self.blk.isFullLiteral
    }


    /**
     * Creates a deep clone of this SliceCtorValue.
     *
     */
    pub over clone(self)-> &Value {
        return copy SliceCtorValue(self.loc,
                                    self.type,
                                    ptr-> self.ptr.clone(),
                                    len-> self.len.clone(),
                                    blk-> self.blk.clone(),
                                    isImplicitAlias-> self.isImplicitAlias,
                                    isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /**
         * Formats the slice literal for debugging or diagnostic output.
         *
         * Formatting behavior:
         *   - When formatting parameters, prints "_".
         *   - When debugging and blk is not NullValue, prints:
         *         {.len = L, .ptr = P, .blk = B}
         *   - When not debugging:
         *         []                    if len == 0
         *         <array literal>       if ptr points to an ArrayValue
         *         {.len = L, .ptr = P}  otherwise
         */
        pub over format(self, dmut stream: &Formatter) {
            if (stream.tags.forParams) {
                stream:.write("_");
            } else if (stream.tags.forDebug && self.blk !of NullValue) {
                stream:.write("{.len = ", self.len, ", .ptr = ", self.ptr, ", .blk = ", self.blk, "}");
            } else {
                if (!stream.tags.forDebug) {
                    match self.len {
                        i: &IntValue => {
                            if i.value == 0 {
                                stream:.write("[]");
                                return;
                            } else match self.ptr {
                                a: &AddressValue if a.value of ArrayValue => {
                                    stream:.write(a.value);
                                    return;
                                }
                            }
                        }
                    }
                }

                stream:.write("{.len = ", self.len, ", .ptr = ", self.ptr, "}");
            }
        }
    }
}
