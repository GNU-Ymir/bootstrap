/*
 * Declares the ErrOptionValue class.
 *
 * ErrOptionValue represents the literal form of an option value in its
 * “error / none” state. It is used by the semantic generator to encode:
 *
 *   - an unset option (`none`), represented by a NullValue,
 *   - or an error payload produced during option-aware evaluation.
 *
 * The value is a literal node participating in compile-time evaluation.
 * Its semantics mirror those of option types:
 *
 *   - If `err` is a NullValue, the literal prints as `none`.
 *   - Otherwise, it represents a failed option with an attached error value.
 *
 * ErrOptionValue is immutable except for the internal error payload, which
 * may itself be a reduced or unreduced literal depending on the context.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::generator::value::literal::none_
 * @File: ymirc/semantic/generator/value/literal/none_.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2021-11-20
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in none_;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::type;
use ymirc::semantic::generator::type::native;


/**
 * Represents a literal option value in its “none” or “error” form.
 *
 * ErrOptionValue encapsulates:
 *   - an OptionType describing the option’s static type,
 *   - an error payload (`err`), which is:
 *       * NullValue for the canonical `none` literal,
 *       * any other Value for an error-carrying option,
 *   - literal semantics compatible with compile-time evaluation.
 *
 * The literal is considered a full literal if and only if its internal
 * error payload is itself a full literal. This allows option-aware
 * propagation of literal-reduction guarantees.
 *
 * Formatting rules:
 *   - `none` is printed when the payload is a NullValue,
 *   - otherwise the literal prints as:
 *         {.ok = false, .error = <payload>}
 *
 */
@final
pub class ErrOptionValue over LiteralValue {

    pub {
        // The error value (for try catch, NullValue for none)
        let err: &Value;
    }

    /**
     * Creates an option literal in its none/error form.
     *
     * Parameters:
     *   - loc:       the source location of the literal.
     *   - type:      the OptionType of the value. Defaults to the canonical
     *                NONE_OPTION_TYPE when omitted.
     *   - err:       the error payload. Defaults to NULL_VALUE, representing
     *                the `none` literal.
     *   - isReduced: whether the literal is already reduced.
     *
     */
    pub self (loc:       &Word,
              type:      &OptionType = NONE_OPTION_TYPE,
              err:       &Value = NULL_VALUE,
              isReduced: bool = false)

        with super (loc, type, isReduced-> isReduced, throwers-> [])
        , err = err
    {}

    /**
     * Determines whether this option literal is a full literal.
     *
     * An ErrOptionValue is a full literal if and only if its internal error
     * payload is itself a full literal.
     */
    @field
    pub over isFullLiteral (self)-> bool {
        self.err.isFullLiteral
    }

    /**
     * Clones the option literal.
     *
     */
    pub over clone (self)-> &Value {
        if let o: &OptionType = self._type {
            return copy ErrOptionValue (self.loc,
                                        type-> o,
                                        errValue-> self.err.clone (),
                                        isReduced-> self.isReduced);
        }

        panic;
    }


    impl Comparable!{&Generator};
    impl Streamable;
    impl Formattable {

        /**
         * Formats the option literal for debugging or pretty‑printing.
         *
         * Formatting rules:
         *   - If the error payload is a NullValue, prints:
         *         none
         *
         *   - Otherwise prints a structured representation:
         *         {.ok = false, .error = <payload>}
         *
         * The formatting respects the active formatter tags.
         */
        pub over format (self, dmut stream: &Formatter) {
            if (self.err of NullValue) {
                stream:.write (Keys::NONE);
            } else {
                stream:.write (format ("{.ok = false, .error = %}", self.err, tags-> stream.tags));
            }
        }
    }
}
