/*
 * Declares the CharValue class.
 *
 * CharValue represents a literal Unicode codepoint, stored in one of three
 * encodings depending on the declared CharType:
 *   - UTF-8  (8-bit)
 *   - UTF-16(16-bit)
 *   - UTF-32(32-bit)
 *
 * The literal is always fully reduced and immutable. It participates in
 * constant folding and compile-time evaluation, and its internal representation
 * is normalized according to the chosen encoding size.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::generator::value::literal::char
 * @File: ymirc/semantic/generator/value/literal/char.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2021-11-20
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in char;

use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::{format, bigint, comparison};
use std::stream;

use ymirc::semantic::generator::type::native;

/**
 * Represents the internal storage of a character literal.
 *
 * CharValueContent stores the same codepoint in three possible encodings.
 * Only one of the fields is meaningful depending on the CharType size.
 *
 * Equality compares all three fields to ensure structural equivalence.
 */
pub record CharValueContent {
    pub let utf8: u8 = 0;
    pub let utf16: u16 = 0;
    pub let utf32: u32 = 0;

    pub self (utf8: u8)
        with utf8 = utf8 {}

    pub self (utf16: u16)
        with utf16 = utf16 {}

    pub self (utf32: u32)
        with utf32 = utf32 {}

    pub fn opEquals(self, o: CharValueContent)-> bool {
        if self.utf8 != o.utf8 return false;
        if self.utf16 != o.utf16 return false;
        if self.utf32 != o.utf32 return false;

        return true;
    }
}

/**
 * Represents a Unicode character literal.
 *
 * CharValue encapsulates:
 *   - the encoded codepoint(`value`),
 *   - the CharType specifying the encoding size,
 *   - full literal semantics(always reduced, never an lvalue),
 *   - formatting logic that prints the literal with the appropriate suffix.
 *
 * The literal is stored in a CharValueContent structure, which holds the
 * codepoint in UTF-8, UTF-16, and UTF-32 forms. Only the field matching the
 * CharType size is meaningful.
 */
@final
pub class CharValue over LiteralValue {

    pub {
        /**
         * The encoded character value.
         *
         * Only one of utf8/utf16/utf32 is meaningful depending on the CharType
         * size. The others remain zeroed for structural consistency.
         */
        let value: CharValueContent;
    }

    /**
     * Creates a CharValue from a raw codepoint and an encoding size.
     *
     * Parameters:
     *   - loc:  the source location of the literal.
     *   - code: the Unicode codepoint.
     *   - size: the encoding size(8, 16, or 32 bits).
     *
     * The constructor synthesizes a CharType and stores the codepoint in the
     * appropriate encoding field.
     */
    pub self (loc: &Word, code: u32, size: u16 = 0)
        with super (loc,
                    copy CharType(loc, size-> size, isMutable-> false),
                    isReduced-> true,
                    throwers-> [])
        , value = {
            match size {
                8 => { CharValueContent(utf8-> cast!u8(code)) }
                16 => { CharValueContent(utf16-> cast!u16(code)) }
                _ => { CharValueContent(utf32-> code) }
            }
        }
    {}

    /**
     * Creates a CharValue from a BigInt and an explicit CharType.
     *
     * Used when the literal originates from semantic transformations or when
     * the type is already known.
     */
    pub self (loc: &Word, type: &CharType, value: &BigInt)
        with super (loc, type, isReduced-> true, throwers-> [])
        , value = {
            match type.size {
                8 => { CharValueContent(utf8-> value.toT!{u8} ()) }
                16 => { CharValueContent(utf16-> value.toT!{u16} ()) }
                _ => { CharValueContent(utf32-> value.toT!{u32} ()) }
            }
        }

    {}

    /**
     * Creates a CharValue from an already‑constructed CharValueContent.
     */
    pub self (loc: &Word, type: &CharType, value: CharValueContent)
        with super (loc, type, isReduced-> true, throwers-> [])
        , value = value
    {}

    /**
     * Convenience constructor for direct u8 values.
     */
    pub self (loc: &Word, type: &CharType, value: u8)
        with super (loc, type, isReduced-> true, throwers-> [])
        , value = CharValueContent(utf8-> value)
    {}

    /**
     * Convenience constructor for direct u16 values.
     */
    pub self (loc: &Word, type: &CharType, value: u16)
        with super (loc, type, isReduced-> true, throwers-> [])
        , value = CharValueContent(utf16-> value)
    {}

    /**
     * Convenience constructor for direct u32 values.
     */
    pub self (loc: &Word, type: &CharType, value: u32)
        with super (loc, type, isReduced-> true, throwers-> [])
        , value = CharValueContent(utf32-> value)
    {}

    /**
     * Returns the character value as a BigInt.
     *
     * This is used for numeric operations, comparisons, and constant folding.
     */
    @field
    pub fn valueAsInt(self)-> &BigInt {
        match self.encodingSize {
            8 => { copy BigInt(cast!usize(self.value.utf8)) }
            16 => { copy BigInt(cast!usize(self.value.utf16)) }
            _ => { copy BigInt(cast!usize(self.value.utf32)) }
        }
    }

    /**
     * Returns the encoding size(8, 16, or 32 bits).
     */
    @field
    pub fn encodingSize(self)-> u16 {
        if let c: &CharType = self.type {
            return c.size;
        }

        panic;
    }

    /**
     * Character literals are always full literals.
     */
    @field
    pub over isFullLiteral(self)-> bool {
        true
    }

    /**
     * Cloning a CharValue returns the same instance.
     *
     * Character literals are immutable and carry no internal state beyond their
     * encoded value.
     */
    pub over clone(self)-> &Value {
        self
    }

    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /**
         * Formats the character literal for debugging or pretty‑printing.
         *
         * The printed form is:
         *     'x'c8
         *     'x'c16
         *     'x'c32
         *
         * The character is escaped using the UTF validator to ensure correct
         * representation of special characters.
         */
        pub over format(self, dmut stream: &Formatter) {
            use ymirc::semantic::validator;

            match self.encodingSize {
                8 => {
                    stream:.write(Tokens::SQUOTE, Utf::unescape(Utf::decode(copy [self.value.utf8])), Tokens::SQUOTE);
                    stream:.write(CharSuffixes::UTF8);
                }
                16 => {
                    stream:.write(Tokens::SQUOTE, Utf::unescape(Utf::decode(copy [self.value.utf16])), Tokens::SQUOTE);
                    stream:.write(CharSuffixes::UTF16);
                }
                _ => {
                    stream:.write(Tokens::SQUOTE, Utf::unescape(Utf::decode(copy [self.value.utf32])), Tokens::SQUOTE);
                    stream:.write(CharSuffixes::UTF32);
                }
            };
        }
    }
}
