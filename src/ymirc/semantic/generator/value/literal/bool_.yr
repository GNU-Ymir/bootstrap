 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in bool_;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::type::native;

/**
 * Represents a boolean literal value.
 *
 * BoolValue encapsulates:
 *   - the truth value (`isTrue`),
 *   - the boolean type (BoolType),
 *   - the fact that it is always a full literal and always reduced.
 *
 */
@final
pub class BoolValue over LiteralValue {

    pub {
        /** The truth value of the literal. */
        let isTrue: bool;
    }

    /**
     * Creates a BoolValue with an explicit BoolType.
     *
     * Parameters:
     *   - loc:    the source location of the literal.
     *   - b:      the BoolType instance.
     *   - isTrue: the truth value.
     *
     * This constructor is used when the type is already known or shared.
     */
    pub self (loc: &Word, b: &BoolType, isTrue: bool)
        with super (loc, b, isReduced-> true, throwers-> [])
        , isTrue = isTrue
    {}

    /**
     * Creates a BoolValue with an automatically constructed BoolType.
     *
     * Parameters:
     *   - loc:    the source location of the literal.
     *   - isTrue: the truth value.
     *
     * This constructor is used when the type must be synthesized.
     */
    pub self (loc: &Word, isTrue: bool)
        with super (loc, copy BoolType (loc), isReduced-> true, throwers-> [])
        , isTrue = isTrue
    {}

    /**
     * @returns true
     */
    @field
    pub over isFullLiteral (self)-> bool {
        true
    }

    /**
     * Cloning a BoolValue returns the same instance.
     *
     * Boolean literals are immutable and carry no internal state beyond their
     * truth value, so cloning does not produce a new object.
     */
    pub over clone (self)-> &Value {
        self
    }

    impl Comparable!{&Generator};
    impl Streamable;
    impl Formattable {

        /**
         * Formats the boolean literal for debugging or pretty-printing.
         *
         * Printed as:
         *   true
         * or
         *   false
         */
        pub over format (self, dmut stream: &Formatter) {
            if (self.isTrue)
                stream:.write (Keys::TRUE);
            else stream:.write (Keys::FALSE);
        }
    }
}
