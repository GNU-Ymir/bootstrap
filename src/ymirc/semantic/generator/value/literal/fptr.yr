in fptr;

use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::type::native;
use ymirc::semantic::generator::value::{variable, prototype};


/*
 * ProtoFuncPtrValue represents the creation of a function pointer literal from
 * a function prototype. It is used when a function prototype is referenced as a
 * first-class value, producing a FuncPtrType that captures the prototype’s
 * parameter types, reference flags, lazy flags, and return type.
 *
 * This value is a compile-time constant: it contains no runtime data and
 * represents a direct reference to a known function prototype. It is therefore
 * always considered a full literal.
 *
 * ProtoFuncPtrValue is an internal semantic construction used during lowering
 * of function pointer expressions and implicit conversions involving function
 * prototypes.
 *
 */
@final
pub class ProtoFuncPtrValue over LiteralValue {

    pub {
        /**
         * The function prototype being referenced.
         */
        let proto: &PrototypeValue;
    }

    /**
     * Creates a new ProtoFuncPtrValue.
     *
     * Parameters:
     *   - loc:        the source location of the function pointer literal.
     *   - proto:      the function prototype being referenced.
     *   - references: the reference flags for each parameter.
     *   - lazys:      the lazy evaluation flags for each parameter.
     *   - parameters: the list of parameter types.
     *   - retType:    the return type of the function.
     *
     * The constructor synthesizes a FuncPtrType from the prototype’s signature.
     * The value is considered fully reduced and inherits throwers from the
     * underlying prototype.
     */
    pub self (loc:        &Word,
              proto:      &PrototypeValue,
              references: [bool],
              lazys:      [bool],
              params:     [&Type],
              retType:    &Type)

        with super (loc,
                    copy FuncPtrType(loc, params, retType,
                                     references-> references,
                                     lazys-> lazys, isMutable-> false),
                    isReduced-> true,
                    throwers-> proto.throwers)

        , proto = proto
    {}

    /**
     * @returns true
     * */
    @field
    pub over isFullLiteral(self)-> bool {
        true
    }

    /**
     * Clones the function pointer literal.
     *
     * ProtoFuncPtrValue is immutable and contains no internal state beyond the
     * referenced prototype, so cloning returns the same instance.
     */
    pub over clone(self)-> &Value {
        self
    }

    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /**
         * Formats the function pointer literal for debugging or diagnostic
         * output.
         *
         * When formatting parameters(stream.tags.forParams == true),
         * the literal is printed as "_".
         *
         * Otherwise, it is printed as:
         *     fn <prototype>
         */
        pub over format(self, dmut stream: &Formatter) {
            if (stream.tags.forParams) {
                stream:.write("_");
            } else {
                stream:.write(Keys::FUNCTION, ' ', self.proto);
            }
        }

    }


}
