/*
 * Declares the FloatValue class.
 *
 * FloatValue represents a floating-point literal of type f32, f64, f80 or real.
 * It stores its numeric value in a BigFloat, ensuring consistent precision
 * across semantic evaluation, constant folding, and code generation.
 *
 * FloatValue is always a full literal, always reduced, and never an lvalue. It
 * participates in compile-time evaluation and supports formatting with the
 * appropriate float suffix depending on its FloatType.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::generator::value::literal::float
 * @File: ymirc/semantic/generator/value/literal/float.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2021-11-20
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in float;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, bigfloat, comparison};
use std::stream;

use ymirc::semantic::generator::type::native;

/**
 * Represents a floating-point literal.
 *
 * FloatValue encapsulates:
 *
 *   - the numeric value stored as a BigFloat (`value`),
 *   - the FloatType describing the precision (f32, f64, f80, real),
 *   - full literal semantics (always reduced, never an l-value),
 *   - formatting logic that prints the literal with the correct suffix.
 *
 * BigFloat ensures that floating-point literals retain their precision during
 * semantic evaluation and constant folding.
 */
@final
pub class FloatValue over LiteralValue {

    pub {
        /**
         * The floating-point value stored as a BigFloat.
         *
         * BigFloat provides arbitrary-precision semantics, ensuring that
         * literal evaluation is not affected by backend floating-point
         * rounding.
         */
        let value: &BigFloat;
    }

    /**
     * Creates a FloatValue from an f32 literal.
     *
     * Parameters:
     *   - loc:   the source location of the literal.
     *   - type:  the FloatType (must be f32).
     *   - value: the f32 value.
     */
    pub self (loc: &Word, type: &FloatType, value: f32)
        with super (loc, type, isReduced-> true, throwers-> [])
        , value = copy BigFloat (value)
    {}

    /**
     * Creates a FloatValue from an f64 literal.
     */
    pub self (loc: &Word, type: &FloatType, value: f64)
        with super (loc, type, isReduced-> true, throwers-> [])
        , value = copy BigFloat (value)
    {}

    /**
     * Creates a FloatValue from an f64 literal and synthesizes the FloatType.
     *
     * Parameters:
     *   - size: the float size (32, 64, 80, or 0 for real).
     */
    pub self (loc: &Word, value: f64, size: u16 = 0u16)
        with super (loc, copy FloatType (loc, size-> size), isReduced-> true, throwers-> [])
        , value = copy BigFloat (value)
    {}

    /**
     * Creates a FloatValue from an existing BigFloat.
     */
    pub self (loc: &Word, type: &FloatType, f: &BigFloat)
        with super (loc, type, isReduced-> true, throwers-> [])
        , value = f
    {}

    /**
     * @returns true
     */
    @field
    pub over isFullLiteral (self)-> bool {
        true
    }

    /**
     * Cloning a FloatValue returns the same instance.
     *
     * FloatValue is immutable and carries no internal state beyond its BigFloat.
     */
    pub over clone (self)-> &Value {
        self
    }

    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /**
         * Formats the floating-point literal for debugging or pretty-printing.
         *
         * Printed as:
         *     3.14f32
         *     2.718f64
         *     1.0f80
         *     0.5real
         *
         * The suffix depends on the FloatType size.
         */
        pub over format (self, dmut stream: &Formatter) {
            stream:.write (self.value);
            if let f: &FloatType = self.type {
                match f.size {
                    32 => { stream:.write (FloatSuffixes::F32); }
                    64 => { stream:.write (FloatSuffixes::F64); }
                    80 => { stream:.write (FloatSuffixes::F80); }
                    _  => { stream:.write (FloatSuffixes::REAL); }
                }
            } else panic;
        }
    }
}
