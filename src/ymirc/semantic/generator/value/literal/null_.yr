 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in null_;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::type::native;


/**
 * Represents the literal `null`.
 *
 * NullValue encapsulates:
 *   - an optional explicit PointerType,
 *   - full literal semantics(always reduced, always full literal),
 *   - formatting logic that prints the literal as `null`.
 *
 * Untyped nulls are represented using a synthesized PointerType(NoneType),
 * which allows implicit casting to any pointer type during semantic
 * analysis.
 */
@final
pub class NullValue over LiteralValue {

    /**
     * Creates a typed null literal.
     *
     * Parameters:
     *   - loc:  the source location of the literal.
     *   - type: the explicit PointerType of the null value.
     */
    pub self (loc: &Word, type: &PointerType)
        with super (loc, type, isReduced-> true, throwers-> [])
    {}

    /**
     * Creates an untyped null literal.
     *
     * Parameters:
     *   - loc: the source location of the literal.
     *
     * The constructor synthesizes a PointerType(NoneType) that is implicitly
     * castable to any pointer type.
     */
    pub self (loc: &Word)
        with super (loc,
                    copy PointerType(loc, copy NoneType(loc, isMutable-> true), isMutable-> true),
                    isReduced-> true,
                    throwers-> [])
    {}

    /**
     * Null is always a full literal.
     */
    @field
    pub over isFullLiteral(self)-> bool {
        true
    }

    /**
     * Cloning a NullValue returns the same instance.
     *
     * NullValue is immutable and carries no internal state beyond its type.
     */
    pub over clone(self)-> &Value {
        self
    }

    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /**
         * Formats the null literal for debugging or pretty-printing.
         *
         * Printed as:
         *     null
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(Keys::NULL);
        }
    }
}
