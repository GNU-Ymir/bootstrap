/*
 * Declares the ArrayAllocValue class.
 *
 * ArrayAllocValue represents the literal form `[v ; len]`, which allocates an
 * array whose elements are all initialized to the same value. Depending on the
 * resulting type, the allocation may be:
 *
 *   - static (fixed-size array, allocated inline), or
 *   - dynamic(slice allocation, typically heap-allocated when wrapped in a
 *     `copy` expression).

 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::generator::value::literal::arrayalloc
 * @File: ymirc/semantic/generator/value/literal/arrayalloc.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2021-11-20
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in arrayalloc;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::type::native;

/**
 * Represents a literal array allocation of the form `[value ; len]`.
 *
 * ArrayAllocValue encapsulates:
 *   - the element value(`value`),
 *   - the length expression(`len`),
 *   - whether the allocation is dynamic(`isDynamic`),
 *   - the resulting array or slice type.
 *
 * Static allocations produce fixed-size arrays. Dynamic allocations produce
 * slices and require heap allocation.
 *
 */
@final
pub class ArrayAllocValue over LiteralValue {

    pub {
        /**
         * The value assigned to each element of the allocated array.
         *
         * This value is cloned or copied as needed during code generation.
         */
        let value: &Value;

        /**
         * The length expression determining the number of elements.
         *
         * This may be a literal or any expression reducible to an integer.
         */
        let len: &Value;

        /**
         * True if the allocation is dynamic(slice allocation).
         *
         * Dynamic allocations typically occur when the type is a SliceType and
         * may require heap allocation when wrapped in a `copy`.
         */
        let isDynamic: bool;
    }

    /**
     * Creates a new dynamic array allocation.
     *
     * Parameters:
     *   - loc:       the source location of the literal.
     *   - type:      the resulting SliceType.
     *   - value:     the element value.
     *   - len:       the length expression.
     *   - isReduced: true if the literal has already been reduced.
     *
     * Dynamic allocations correspond to slice-typed `[v ; len]` expressions.
     */
    pub self dyn(loc:       &Word,
                  type:      &SliceType,
                  value:     &Value,
                  len:       &Value,
                  isReduced: bool = false)

        with super (loc,
                    type,
                    isReduced-> isReduced,
                    throwers-> (value.throwers ~ len.throwers))

        , value = value
        , len = len
        , isDynamic = true
    {}

    /**
     * Creates a new static array allocation.
     *
     * Parameters:
     *   - loc:       the source location of the literal.
     *   - type:      the resulting ArrayType.
     *   - value:     the element value.
     *   - len:       the length expression.
     *   - isReduced: true if the literal has already been reduced.
     *
     * Static allocations correspond to fixed-size array types.
     */
    pub self stat(loc:       &Word,
                   type:      &ArrayType,
                   value:     &Value,
                   len:       &Value,
                   isReduced: bool = false)

        with super (loc,
                    type,
                    isReduced-> isReduced,
                    throwers-> (value.throwers ~ len.throwers))

        , value = value
        , len = len
        , isDynamic = false
    {}

    /**
     * Internal constructor used for cloning.
     *
     * Parameters mirror all fields of ArrayAllocValue.
     */
    self full(loc:       &Word,
               type:      &Type,
               value:     &Value,
               len:       &Value,
               isDynamic: bool,
               isReduced: bool = false)

        with super (loc,
                    type,
                    isReduced-> isReduced,
                    throwers-> (value.throwers ~ len.throwers))

        , value = value
        , len = len
        , isDynamic = isDynamic
    {}

    /**
     * Indicates whether this literal is a full literal.
     *
     * Dynamic allocations are never full literals because they require runtime
     * allocation. Static allocations are full literals only if their element
     * value is a full literal.
     */
    @field
    pub over isFullLiteral(self)-> bool {
        if (self.isDynamic) {
            return false;
        }

        self.value.isFullLiteral
    }

    /**
     * Creates a deep clone of this ArrayAllocValue.
     */
    pub over clone(self)-> &Value {
        return copy ArrayAllocValue::full(self.loc,
                                           self.type,
                                           self.value.clone(),
                                           self.len.clone(),
                                           isDynamic-> self.isDynamic,
                                           isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /**
         * Formats the array allocation literal for debugging or pretty-printing.
         *
         * Dynamic allocations are printed with a leading `copy` keyword:
         *     copy [v ; len]
         *
         * Static allocations are printed as:
         *     [v ; len]
         */
        pub over format(self, dmut stream: &Formatter) {
            if (self.isDynamic) stream:.write(Keys::COPY, ' ');

            stream:.write('[');
            stream:.entabing();
            self.value.format(alias stream);
            stream:.write(" ; ");
            self.len.format(alias stream);
            stream:.detabing();
            stream:.write(']');
        }
    }
}
