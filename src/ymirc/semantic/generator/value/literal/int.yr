/*
 * Declares the IntValue class.
 *
 * IntValue represents an integer literal of any supported integer type (signed
 * or unsigned, fixed-width or platform-sized). Its numeric value is stored in a
 * BigInt to preserve full precision during semantic evaluation, constant
 * folding, and code generation.
 *
 * IntValue is always:
 *   - a full literal,
 *   - fully reduced,
 *   - immutable,
 *   - non-lvalue.
 *
 * It participates in compile-time evaluation and prints with the appropriate
 * integer suffix depending on the IntType (i8, u16, is, us, etc.).
 *
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::semantic::generator::value::literal::int
 * @File: ymirc/semantic/generator/value/literal/int.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2021-12-09
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in int;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, bigint, comparison};
use std::{stream, traits};

use ymirc::semantic::generator::type::native;


/**
 * Represents an integer literal.
 *
 * IntValue encapsulates:
 * 
 *   - the numeric value stored as a BigInt (`value`),
 *   - the IntType describing width and signedness,
 *   - literal semantics (always reduced, always full literal),
 *   - formatting logic that prints the literal with the correct suffix.
 *
 * BigInt ensures that integer literals retain their precision regardless of
 * backend integer width or platform constraints.
 */
@final
pub class IntValue over LiteralValue {

    pub {
        /**
         * The integer value stored as a BigInt.
         *
         * BigInt provides arbitrary-precision semantics, ensuring that literal
         * evaluation is not affected by overflow or platform integer limits.
         */        
        let value: &BigInt;
    }

    /**
     * Creates an IntValue from a usize literal.
     *
     * Parameters:
     *   - loc: the source location of the literal.
     *   - type: the IntType describing width and signedness.
     *   - val: the integer value as usize.
     */
    pub self (loc: &Word, type: &IntType, val: usize)
        with super (loc, type, isReduced-> true, throwers-> [])
        , value = copy BigInt (val)
    {}

    /**
     * Creates an IntValue from an existing BigInt.
     */
    pub self (loc: &Word, type: &IntType, val: &BigInt)
        with super (loc, type, isReduced-> true, throwers-> [])
        , value = val
    {}

    /**
     * Creates an IntValue from any integer type T satisfying isInteger!{T}.
     *
     * Parameters:
     *   - loc:    the source location (defaults to EOF_WORD).
     *   - value:  the integer literal.
     *   - size:   the bit-width of the integer type (0 for platform-sized).
     *   - signed: whether the integer type is signed.
     *
     * This constructor synthesizes the IntType automatically.
     */
    pub self if isInteger!{T} {T} (loc: &Word = EOF_WORD, value: T, size: u16 = 0, signed: bool = false)
        with super (loc, copy IntType (loc, size-> size, signed-> signed), isReduced-> true, throwers-> [])
        , value = copy BigInt (val)
    {}    

    
    /**
     * Creates an IntValue by re-typing an existing IntValue.
     *
     * Used during semantic transformations when the same numeric value must be
     * represented under a different IntType.
     */
    pub self (loc: &Word, nType: &IntType, old: &IntValue)
        with self (loc, nType, old.value)
    {}

    
    /**
     * Integer literals are always full literals.
     */
    @field
    pub over isFullLiteral (self)-> bool {
        true
    }

    /**
     * Cloning an IntValue returns the same instance.
     *
     * IntValue is immutable and carries no internal state beyond its BigInt.
     */
    pub over clone (self)-> &Value {
        self
    }

    impl Comparable!{&Generator};
    
    impl Streamable;
    impl Formattable {

        /**
         * Formats the integer literal for debugging or pretty-printing.
         *
         * Printed as:
         *     42i8
         *     100u16
         *     7is
         *     12us
         *
         * The suffix depends on the IntType width and signedness.
         */
        pub over format (self, dmut stream: &Formatter) {
            if let f: &IntType = self.type {
                match (f.isSigned, f.size) {
                    (true  , 8)  => { stream:.write (self.value, "i8"s8); }
                    (true  , 16) => { stream:.write (self.value, "i16"s8); }
                    (true  , 64) => { stream:.write (self.value, "i64"s8); }
                    (true  , 0)  => { stream:.write (self.value, "is"s8); }
                    (false , 8)  => { stream:.write (self.value, "u8"s8); }
                    (false , 16) => { stream:.write (self.value, "u16"s8); }
                    (false , 32) => { stream:.write (self.value, "u32"s8); }
                    (false , 64) => { stream:.write (self.value, "u64"s8); }
                    (false , 0)  => { stream:.write (self.value, "us"s8); }
                    _ => { stream:.write (self.value); }
                }
            } else panic;
        }
    }
}
