/*
 * Declares the MapValue class.
 *
 * A MapValue is a literal expression allocating a map from a list of key/value
 * pairs. It corresponds to syntax such as:
 *
 *     ```
 *     copy ["foo" => 0, "bar" => 1];
 *     ```
 *     
 * MapValue stores the literal keys and values, aggregates their throwers, and
 * produces a heap-allocated map at runtime. Because map literals always require
 * allocation, they are never considered full literals.
 * 
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::semantic::generator::value::literal::map
 * @File: ymirc/semantic/generator/value/literal/map.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2021-11-20
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in map;

use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::{format, comparison};

use std::stream;

use ymirc::semantic::generator::type::native;

/**
 * Represents a literal map allocation.
 *
 * MapValue encapsulates:
 * 
 *   - the list of literal keys (`keys`),
 *   - the list of literal values (`values`),
 *   - the MapType describing the key/value types,
 *   - aggregated throwers from all keys and values,
 *   - the fact that map literals always require allocation.
 *
 * Map literals are never full literals because they always produce a
 * runtime allocation, even when wrapped in `copy`.
 */
@final
pub class MapValue over LiteralValue {

    pub {
        /**
         * The list of key expressions in the map literal.
         */        
        let keys: [&Value];

        /**
         * The list of value expressions associated with each key.
         */        
        let values: [&Value];
    }

    /**
     * Creates a new MapValue literal.
     *
     * Parameters:
     *   - loc:       the source location of the literal.
     *   - type:      the MapType of the literal.
     *   - keys:      the list of key expressions.
     *   - values:    the list of value expressions.
     *   - isReduced: true if the literal has already been reduced.
     *
     * The constructor aggregates throwers from all keys and values and forwards
     * initialization to LiteralValue.
     */
    pub self (loc:       &Word,
              type:      &MapType,
              keys:      [&Value],
              values:    [&Value],
              isReduced: bool = false)
        
        with super (loc,
                    type,
                    isReduced-> isReduced,
                    throwers-> {
                        let mut th: [Thrower] = [];
                        for i in keys {
                            throwers ~= i.throwers;
                        }

                        for i in values {
                            throwers ~= i.throwers;
                        }
                        
                        th
                    })
        
        , keys = keys
        , values = values

    {}        

    /**
     * Map literals are never full literals.
     *
     * They always require allocation and therefore cannot be folded into a
     * compile-time constant.
     */
    @field
    pub over isFullLiteral (self)-> bool {
        false
    }

    /**
     * Creates a deep clone of this MapValue.     
     */
    pub over clone (self)-> &Value {
        let keys = copy [i.clone () for i in self.keys];
        let vals = copy [i.clone () for i in self.values];

        if let t: &MapType = self.type {
            return copy MapValue (self.loc,
                                  t,
                                  keys-> keys,
                                  values-> vals,
                                  isReduced-> self.isReduced);
            
        }

        panic;
    }


    impl Comparable!{&Generator};
    
    impl Streamable;
    impl Formattable {

        /**
         * Formats the map literal for debugging or pretty-printing.
         *
         * Printed as:
         *     ["foo" => 0, "bar" => 1]
         *
         * Keys and values are formatted recursively using their own Formattable
         * implementations.
         * 
         */
        pub over format (self, dmut stream: &Formatter) {
            stream:.write ('[');
            stream:.entabing ();
            for j, i in self.keys {
                if (j != 0) stream:.write (", ");
                i.format (alias stream);
                stream:.write (' ', Tokens::DARROW, ' ');
                self.values [j].format (alias stream);
            }
            
            stream:.detabing ();
            stream:.write (']');
        }
    }
}
