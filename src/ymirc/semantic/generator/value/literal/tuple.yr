in tuple;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::type::native;

/**
 * Declares the TupleValue class.
 *
 * TupleValue represents the construction of a tuple literal from a list of
 * element values. It is conceptually similar to StructInitValue, but produces a
 * TupleType rather than a ClassPtrType.
 *
 * TupleValue is an internal semantic construction used to represent tuple
 * literals after parsing. It stores the ordered list of element values and,
 * optionally, field names when the tuple is partially named.
 *
 * Field names may be fewer than the number of values when positional tuple
 * initialization is used.
 */
@final
pub class TupleValue over LiteralValue {

    pub {
        /**
         * The list of element values contained in the tuple.         
         */        
        let values: [&Value];
        
        /**
         * Optional field names associated with tuple elements.
         *
         * This array may be shorter than `values` when the tuple is partially
         * named or entirely positional.
         */        
        let fields: [[c8]];
    }
    
    /**
     * Creates a new TupleValue.
     *
     * Parameters:
     *   - loc:       the source location of the tuple literal.
     *   - type:      the TupleType describing the element types.
     *   - values:    the list of element values.
     *   - fields:    optional field names (may be fewer than values).
     *   - isReduced: true if the literal has already been reduced.
     *
     * The constructor aggregates throwers from all element values and forwards
     * initialization to LiteralValue.
     */
    pub self (loc:       &Word,
              type:      &TupleType,
              values:    [&Value],
              fields:    [[c8]] = [],
              isReduced: bool = false)
        
        with super (loc,
                    type,
                    isReduced-> isReduced,
                    throwers-> {
                        let mut th: [Thrower] = [];
                        for i in values {
                            throwers ~= i.throwers;
                        }

                        th                        
                    })
        
        , values = values
        , fields = fields

    {}        

    /**
     * Returns the number of elements in the tuple.
     */
    @field
    pub fn arity (self)-> usize {
        self.values.len
    }
    
    /**
     * Indicates whether the tuple is a full literal.
     *
     * A tuple is considered a full literal only if all of its element values
     * are themselves full literals.
     */
    @field
    pub over isFullLiteral (self)-> bool {
        for i in self.values {
            if !i.isFullLiteral return false;
        }

        return true;
    }
    
    /**
     * Creates a deep clone of this TupleValue.
     */
    pub over clone (self)-> &Value {
        let mut inners: [mut &Value] = copy [i.clone () for i in self.values];

        if let t: &TupleType = self._type {
            return copy TupleValue (self.loc,
                                    t,
                                    inners,
                                    fieldNames-> self.fields,
                                    isReduced-> self.isReduced);
        }

        panic;
    }

    impl Comparable!{&Generator};
    
    impl Streamable;
    impl Formattable {

        /**
         * Formats the tuple literal for debugging or pretty-printing.
         *
         * Printed as:
         *     (a -> 1, b -> 2)
         * or:
         *     (1, 2, 3)
         *
         * A trailing comma is printed for single-element tuples to preserve
         * syntactic disambiguation.
         */
        pub over format (self, dmut stream: &Formatter) {
            stream:.write ('(');
            stream:.entabing ();
            for j, i in self.values {
                if (j != 0us) stream:.write (", ");
                if (self.fields.len > j) {
                    stream:.write (self.fields [j], "-> ");
                }
                i.format (alias stream);
            }
            if (self.values.len == 1us) stream:.write (',');
            stream:.detabing ();
            stream:.write (')');
        }        
    }        
}
