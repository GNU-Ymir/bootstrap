in vtable;

use ymirc::lexing::{keys, word};
use ymirc::semantic::generator::type::{native, temporary};
use ymirc::utils::{comparison, format};

use std::stream;


/**
 * The address of the vtable of a class, typed `*void`.
 *
 * The vtable is the constant a class instance is allocated with, so the value
 * lets a library allocate an instance without calling a constructor. It is
 * only built for a class that has one: neither abstract nor a structure.
 *
 * The value refers to a symbol known at compile time, it is therefore always a
 * full literal.
 */
@final
pub class ClassVtableValue over LiteralValue {

    pub {
        /**
         * The class whose vtable is referenced.
         */
        let classRef: &ClassRefType;
    }

    /**
     * Creates a new ClassVtableValue.
     *
     * Parameters:
     *   - loc:      the source location of the pragma.
     *   - classRef: the class whose vtable is referenced.
     */
    pub self (loc: &Word, classRef: &ClassRefType)
        with super (loc,
                    copy PointerType(loc, VOID_TYPE, isMutable-> false),
                    isReduced-> true,
                    throwers-> [])
        , classRef = classRef
    {}

    /**
     * @returns true
     * */
    @field
    pub over isFullLiteral(self)-> bool {
        true
    }

    /**
     * ClassVtableValue is immutable, cloning returns the same instance.
     */
    pub over clone(self)-> &Value {
        self
    }

    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /**
         * Formats the vtable address for debugging or diagnostic output.
         *
         * When formatting parameters(stream.tags.forParams == true),
         * the literal is printed as "_".
         *
         * Otherwise, it is printed as:
         *     __pragma!vtable(<class>)
         */
        pub over format(self, dmut stream: &Formatter) {
            if (stream.tags.forParams) {
                stream:.write("_");
            } else {
                stream:.write(Keys::PRAGMA, '!', PragmaKeys::VTABLE, '(', self.classRef, ')');
            }
        }

    }


}
