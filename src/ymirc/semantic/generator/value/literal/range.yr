in range;

use ymirc::lexing::{word, keys};
use ymirc::utils:: {format, comparison};
use std::stream;

use ymirc::semantic::generator::type;
use ymirc::semantic::generator::type::native;

/**
 * RangeValue represents a literal range expression, consisting of a left bound,
 * a right bound, an optional step value, and a flag indicating whether the
 * right bound is inclusive. It is used during semantic lowering to represent
 * expressions of the form:
 *
 *     left .. right
 *     left ... right
 *     (left .. right).step_by(step)
 *
 * The range literal is a structural construction: it aggregates the literal
 * properties and throwers of its component values. A RangeValue is considered a
 * full literal only if all of its components are full literals.
 *
 */
@final
pub class RangeValue over LiteralValue {

    pub {
        /** The left bound of the range. */
        let left: &Value;

        /** The right bound of the range. */
        let right: &Value;

        /**
         * The step value of the range.
         *
         * Defaults to UNIT_VALUE, meaning no explicit step was provided.
         *  */
        let step: &Value;

        /**
         * Indicates whether the right bound is inclusive.
         *
         * This is represented as a boolean literal value rather than a raw,
         * since it can be defined at runtime.
         */
        let isFull: &Value;
    }

    /**
     * Creates a new RangeValue.
     *
     * Parameters:
     *   - loc:       the source location of the range literal.
     *   - type:      the RangeType describing the range’s element type.
     *   - left:      the left bound of the range.
     *   - right:     the right bound of the range.
     *   - step:      the step value(defaults to UNIT_VALUE).
     *   - isFull:    whether the right bound is inclusive(defaults to false).
     *   - isReduced: whether the range literal has already been reduced.
     *
     * The RangeValue aggregates throwers from all component values. It does not
     * introduce new throwers, as range construction is a structural operation.
     */
    pub self (loc:       &Word,
              type:      &RangeType,
              left:      &Value,
              right:     &Value,
              step:      &Value = UNIT_VALUE,
              isFull:    &Value = FALSE_BOOL_VALUE,
              isReduced: bool = false)

        with super (loc,
                    type,
                    isReduced-> isReduced,
                    throwers-> (left.throwers ~ right.throwers ~ step.throwers ~ isFull.throwers))

        , left = left
        , right = right
        , step = step
        , isFull = isFull
    {}

    /**
     * Indicates whether the range literal is a full literal.
     *
     * A RangeValue is a full literal only if all of its component values(left,
     * right, step, isFull) are themselves full literals.
     */
    @field
    pub over isFullLiteral(self)-> bool {
        if !self.left.isFullLiteral return false;
        if !self.right.isFullLiteral return false;
        if !self.step.isFullLiteral return false;
        if !self.isFull.isFullLiteral return false;

        return true;
    }

    /**
     * Creates a deep clone of this RangeValue.
     *
     */
    pub over clone(self)-> &Value {
        if let t: &RangeType = self.type {
            return copy RangeValue(self.loc,
                                   t,
                                   self.left.clone(),
                                   self.right.clone(),
                                   step-> self.step.clone(),
                                   isFull-> self.isFull.clone(),
                                   isReduced-> self.isReduced);
        }

        panic;
    }

    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /**
         * Formats the range literal for debugging or diagnostic output.
         *
         * Printed as:
         *     (left ..[full] right)
         *     (left ..[full] right).step_by(step)
         *
         * When formatting parameters(stream.tags.forParams == true),
         * the literal is printed as "_".
         */
        pub over format(self, dmut stream: &Formatter) {
            if (stream.tags.forParams) {
                stream:.write("_");
            } else {
                stream:.write('(');
                stream:.write(self.left);

                stream:.write(" ..[", self.isFull, "] ");

                stream:.write(self.right);
                stream:.write(')');
                match self.step {
                    UnitValue() => {}
                    _ => { stream:.write(".step_by(");
                           stream:.write(self.step);
                           stream:.write(')');
                    }
                }
            }
        }
    }

}
