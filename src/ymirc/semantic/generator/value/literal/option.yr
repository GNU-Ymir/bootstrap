in option;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;
use ymirc::semantic::generator::type;

/**
 * 
 * OptionValue represents the encapsulation of a value inside an option type. It
 * is used when lowering expressions of the form `value?`, or when the semantic
 * engine constructs an option literal from an existing value.
 *
 * OptionValue is a lightweight wrapper: it does not modify the underlying
 * value, and it does not introduce new throwers. Its literal status depends
 * entirely on the wrapped value.
 *
 * This class is an internal semantic construct used during lowering of option
 * expressions, pattern matching, and implicit conversions involving Option<T>.
 *
 */
@final
pub class OptionValue over LiteralValue {

    pub {
        /** The wrapped value contained inside the option. */                 
        let value: &Value;
    }

    /**
     * Creates a new OptionValue.
     *
     * Parameters:
     *   - loc:       the source location of the option literal.
     *   - type:      the Option!{T} type of the value.
     *   - value:     the wrapped value.
     *   - isReduced: whether the option literal has already been reduced.
     *
     * The OptionValue inherits all throwers from the wrapped value. It does not
     * introduce new throwers, since wrapping a value in an option is a purely
     * structural operation.
     */
    pub self (loc:       &Word,
              type:      &Type,
              value:     &Value,
              isReduced: bool = false)
        
        with super (loc,
                    type,
                    isReduced-> isReduced,
                    throwers-> value.throwers)
        
        , value = value
    {}

    /**
     * Indicates whether the option literal is a full literal.
     *
     * An OptionValue is a full literal only if the wrapped value is itself a
     * full literal.
     */
    @field
    pub over isFullLiteral (self)-> bool {
        self.value.isFullLiteral 
    }

    /**
     * Creates a deep clone of this OptionValue.
     */
    pub over clone (self)-> &Value {
        return copy OptionValue (self.loc,
                                 self.type,
                                 self.value.clone (),
                                 isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};
    
    impl Streamable;
    impl Formattable {

        /**
         * Formats the option literal for debugging or diagnostic output.
         *
         * Printed as:
         *     (value)?
         */
        pub over format (self, dmut stream: &Formatter) {
            stream:.writef ("(%)?", self.value);
        }
    }
}
