in unit;

use ymirc::lexing::word;
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::type::native;

/**
 * UnitValue represents the literal value of type `void`. It is an internal
 * semantic construction used to model the presence of a value in contexts where
 * the language requires an expression but the type system specifies `void`.
 *
 * UnitValue has no direct syntactic counterpart in Ymir. It is produced during
 * semantic lowering whenever an expression must exist but carries no data.
 *
 * UnitValue is always a full literal, always reduced, immutable, and cannot
 * throw. It is used to represent the canonical “unit” value of the language.
 *
 * */
@final
pub class UnitValue over LiteralValue {

    /**
     * Creates a UnitValue with an explicit source location.
     *
     * Parameters:
     *   - loc: the source location associated with the unit literal.
     *
     * The value is typed as VoidType and is considered fully reduced.
     */
    pub self withLoc (loc: &Word)
        with super (loc, copy VoidType (loc), isReduced-> true, throwers-> [])
    {}

    pub self ()
        with super (EOF_WORD, VOID_TYPE, isReduced-> true, throwers-> [])
    {}

    /**
     * @returns true
     */
    @field
    pub over isFullLiteral (self)-> bool {
        true
    }

    /**
     * Clones the UnitValue.
     *
     * UnitValue is immutable and stateless, so cloning simply returns the same
     * instance.
     */
    pub over clone (self)-> &Value {
        self
    }

    impl Comparable!{&Generator};
    
    impl Streamable;
    impl Formattable {
        
        /**
         * Formats the unit literal for debugging or diagnostic output.
         *
         * Printed as:
         *     <unit-value>
         */
        pub over format (self, dmut stream: &Formatter) {
            stream:.write ("<unit-value>");
        }        
    }        
}
