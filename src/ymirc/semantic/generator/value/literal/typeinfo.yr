/*
 * Declares the TypeInfoValue class.
 *
 * TypeInfoValue represents the construction of the runtime TypeInfo structure
 * from core metadata. It is used whenever the compiler needs to materialize
 * type information at runtime for reflection, dynamic dispatch, or debugging.
 *
 * A TypeInfoValue aggregates:
 *   - a unique type identifier,
 *   - the size of the type,
 *   - additional sub-type information (ancestors, inner types, etc.),
 *   - the human-readable type name.
 *
 * The value is reduced by construction and contains no throwers; its literal
 * status depends on the literal status of its components.
 *
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::semantic::generator::value::literal::typeinfo
 * @File: ymirc/semantic/generator/value/literal/typeinfo.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2026-03-06
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in typeinfo;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::type;

/**
 * The TypeInfoValue class models the construction of a runtime TypeInfo
 * structure. This value is produced during semantic lowering whenever the
 * compiler needs to embed or manipulate type metadata at runtime.
 *
 * A TypeInfoValue contains four components:
 *   - `id`:       a unique numeric identifier for the type,
 *   - `size`:     the size of the type in bytes,
 *   - `subInfos`: additional type-specific metadata (e.g., ancestor list for
 *                 classes, inner type for slices or pointers, etc.),
 *   - `name`:     the human-readable name of the type.
 *
 * TypeInfoValue is always a full literal when all of its components are full
 * literals. It is immutable, reduced by construction, and contains no throwers.
 *
 * This class is used by the runtime type system, reflection mechanisms, and any
 * feature requiring dynamic inspection of type properties.
 * 
 */
@final
pub class TypeInfoValue over LiteralValue {

    pub {
        /**
         * The unique identifier associated with this type.
         *
         * This is a compile-time constant used by the runtime type registry.
         */        
        let id: &IntValue;

        /**
         * The size of the type in bytes.
         *
         * This is used by the runtime for memory layout and allocation logic.
         */        
        let size: &IntValue;
        
        /**
         * Additional type-specific metadata.
         *
         * Examples:
         *   - ancestor list for classes,
         *   - inner type for slices,
         *   - inner type for pointers,
         *   - element type for arrays.
         */
        let subInfos: &Value;

        /**
         * The human-readable name of the type.
         *
         * This is typically the fully qualified type name.
         */        
        let name: &StringValue;
    }

    /**
     * Creates a TypeInfoValue from raw components.
     *
     * Parameters:
     *   - loc:   the source location of the TypeInfo literal.
     *   - type:  the TypeInfo type.
     *   - id:    the numeric identifier of the type.
     *   - size:  the size of the type in bytes.
     *   - inner: the sub‑information value.
     *   - name:  the type name as a UTF‑8 string.
     *
     * This constructor allocates IntValue and StringValue instances for the
     * fields and marks the TypeInfoValue as fully reduced.
     * 
     */
    pub self (loc:   &Word,
              type:  &Type,
              id:    usize,
              size:  usize,
              inner: &Value,
              name:  [c8])
        
        with super (loc, type, isReduced-> true, throwers-> [])
        , id = copy IntValue (loc, id, size-> 32u16, signed-> false)
        , size = copy IntValue (loc, size)
        , inner = inner
        , name = copy StringValue (loc, name)
    {}

    /**
     * Creates a TypeInfoValue from pre‑constructed literal components.
     *
     * This overload is used when the caller already has IntValue and
     * StringValue instances available.
     * 
     */
    self (loc:   &Word,
          type:  &Type,
          id:    &IntValue,
          size:  &IntValue,
          inner: &Value,
          name:  &StringValue)
        
        with super (loc, type, isReduced-> true, throwers-> [])
        , id = id
        , size = size
        , subInfos = subInfos
        , name = name
    {}

    /**
     * Indicates whether the TypeInfoValue is a full literal.
     *
     * A TypeInfoValue is a full literal only if all of its components
     * (id, size, subInfos, name) are full literals.
     */
    @field
    pub over isFullLiteral (self)-> bool {
        if !self.id.isFullLiteral return false;
        if !self.size.isFullLiteral return false;
        if !self.subInfos.isFullLiteral return false;
        if !self.name.isFullLiteral return false;

        return true;
    }

    /**
     * Creates a deep clone of this TypeInfoValue.
     * 
     */
    pub over clone (self)-> &Value {
        return copy TypeInfoValue (self.loc,
                                   self.type,
                                   self.id,
                                   self.size,
                                   self.subInfos.clone (),
                                   self.name);
    }

    impl Comparable!{&Generator};
    
    impl Streamable;
    impl Formattable {

        /**
         * Formats the TypeInfoValue for debugging or diagnostic output.
         *
         * Printed as:
         *     TI[id,size,subInfos,name]
         *
         * When formatting parameters (stream.tags.forParams == true),
         * the literal is printed as "_".
         * 
         */
        pub over format (self, dmut stream: &Formatter) {
            if (stream.tags.forParams) {
                stream:.write ("_");
            } else {
                stream:.write (format ("TI[%,%,%,%]", self.id, self.size, self.subInfos, self.name, tags-> stream.tags));
            }
        }
    }
}
