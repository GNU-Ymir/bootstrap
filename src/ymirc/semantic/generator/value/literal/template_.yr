 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in template_;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::type::native;

/**
 * Declares the TemplateDefaultValue class.
 *
 * TemplateDefaultValue is an internal semantic placeholder used during template
 * specialization. It represents a value that was explicitly provided by the
 * user(typically as a default argument in a template function or method) but
 * cannot yet be evaluated because template parameters are not fully resolved.
 *
 * This placeholder allows the semantic engine to:
 *   - record that a default value was declared,
 *   - distinguish between “no value provided” and “value provided but not yet
 *     evaluable”,
 *   - preserve user intent when resolving implicit calls that depend on the
 *     presence of a default argument.
 *
 * TemplateDefaultValue is therefore a purely internal artifact used to maintain
 * semantic correctness until template specialization is complete.
 */
@final
pub class TemplateDefaultValue over LiteralValue {

    /**
     * Creates a new TemplateDefaultValue placeholder.
     *
     * Parameters:
     *   - loc: the source location associated with the placeholder.
     *
     * The placeholder is typed as NoneType because the actual value is not yet
     * known. It is considered reduced and cannot throw.
     */
    pub self (loc: &Word)
        with super (loc, copy NoneType(loc), isReduced-> true, throwers-> [])
    {}

    /**
     * @returns true
     * */
    @field
    pub over isFullLiteral(self)-> bool {
        true
    }

    /**
     * Clones the placeholder.
     *
     * Since TemplateDefaultValue is immutable and contains no internal state,
     * cloning simply returns the same instance.
     */
    pub over clone(self)-> &Value {
        self
    }

    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /**
         * Formats the placeholder for debugging or diagnostic output.
         *
         * Printed as:
         *     <template-default-value>
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write("<template-default-value>"s8);
        }
    }
}
