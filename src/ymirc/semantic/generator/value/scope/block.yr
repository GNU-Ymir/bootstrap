 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in block;

use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::{format, comparison};

use std::stream;

use ymirc::semantic::generator::type;
use ymirc::semantic::generator::value::literal;


/**
 * Represents a lexical block of generator values.
 *
 * A BlockValue contains an ordered list of generator values evaluated
 * sequentially. The last value normally determines the block’s resulting value,
 * unless `noValue` is true, in which case the block behaves like a statement
 * block and yields `unit`.
 *
 * Blocks introduce a new lexical scope unless `isSet` is true. A “set block”
 * reuses the parent scope and is used for constructs such as chained
 * expressions or grouped statements that do not introduce new variable
 * lifetimes.
 *
 * BlockValue also:
 *   - propagates throwers from all contained values,
 *   - tracks break/return locations for control-flow analysis,
 *   - determines lvalue status based on the last value when `isSet` is true.
 */
@final
pub class BlockValue over ScopeValue {

    pub {        
        /**
         * The ordered list of generator values contained in the block.
         */
        let values: [&Value];
        
        /**
         * True iff the final value of the block is *not* the value of the block.
         *
         * When true, the block behaves like a statement block and yields `unit`.
         */
        let noValue: bool = false;
        
        /**
         * True iff the block does not introduce a new lexical scope.
         *
         * A set block reuses the parent scope and inherits its variable lifetimes.
         */
        let isSet: bool;
    }

    /**
     * Construct a block with explicit break/return locations and reduction state.
     *
     * @params:
     *   - loc:       source location of the block
     *   - type:      resulting type of the block
     *   - values:    ordered list of generator values inside the block
     *   - breakLoc:  location of a break statement inside the block, if any
     *   - returnLoc: location of a return statement inside the block, if any
     *   - isSet:     true iff the block reuses the parent scope
     *   - noValue:   true iff the block does not yield its final value
     *   - isReduced: true iff the block is already reduced
     *
     * The block’s lvalue status is inherited from its last value when `isSet`
     * is true and the block is non-empty.
     */
    pub self (loc:       &Word,
              type:      &Type,
              values:    [&Value],
              breakLoc:  &Word,
              returnLoc: &Word,
              isSet:     bool = false,
              noValue:   bool = false,
              isReduced: bool = false)
        
        with super (loc,
                    type,
                    isReduced-> isReduced,
                    isLvalue-> if (isSet && values.len != 0) { values [$ - 1].isLvalue } else { false }
                    breakLoc-> breakLoc,
                    returnLoc-> returnLoc)
        
        , values = values
        , isSet = isSet
        , noValue = noValue
    {
        
        let mut th: [Thrower] = [];
        for i in values {
            th ~= i.throwers;
        }

        self._throwers = th;        
    }

    /**
     * Construct a block without explicit break/return locations.
     *
     * This variant is used before control-flow analysis. Break and return
     * information is inferred from the contained values.
     *
     * @params:
     *   - loc:     source location of the block
     *   - type:    resulting type of the block
     *   - values:  ordered list of generator values
     *   - isSet:   true iff the block reuses the parent scope
     *   - noValue: true iff the block does not yield its final value
     */
    pub self (loc:     &Word,
              type:    &Type,
              values:  [&Value],
              isSet:   bool = false,
              noValue: bool = false)
        
        with super (loc,
                    type,
                    isReduced-> false,
                    isLvalue-> if (isSet && values.len != 0) { values [$ - 1].isLvalue } else { false })
        
        , values = values
        , isSet = isSet
        , noValue = noValue
    {

        let mut th: [Thrower] = [];
        for i in values {
            th ~= i.throwers;
            if (i.isReturner) self._returnLoc = i.returnLoc;
            if (i.isBreaker) self._breakLoc = i.breakLoc;
        }

        self._throwers = th;        
    }

    /**
     * @returns true iff all values contained in the block are full literals.
     *
     * A block is a full literal only when every contained value is a full literal.
     */
    @field
    pub over isFullLiteral (self)-> bool {
        for i in self.values {
            if (!i.isFullLiteral) return false;
        }

        true
    }

    /**
     * Create a deep copy of the block.
     *
     * All contained values are cloned, and a new BlockValue is constructed with
     * identical metadata (type, break/return locations, flags, and reduction state).
     */
    pub over clone (self)-> &BlockValue {
        let result = copy [i.clone () for i in self.values];

        return copy BlockValue (self.loc,
                                self.type,
                                result,
                                breakLoc-> self.breakLoc,
                                returnLoc-> self.returnLoc,
                                isSet-> self.isSet,
                                noValue-> self.noValue,
                                isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator} {

        /**
         * Structural equality for blocks.
         *
         * Two BlockValues are equal iff:
         *   - their base ScopeValue fields are equal, and
         *   - their contained values are pairwise equal.
         */
        pub over opEquals (self, o: &Generator)-> bool {                        
            if let p: &BlockValue = o {
                if (!self.super.opEquals (o)) return false;

                if self.values != p.values return false;
                
                return true;
            }
            
            return false;                            
        }
    }
    
    impl Streamable;
    impl Formattable {

        /**
         * Write the block to the formatter.
         *
         * The printed form depends on whether the block introduces a new scope:
         *   - normal block: `{ ... }`
         *   - set block:    `#{ ... #}`
         *
         * Values are printed sequentially, separated by semicolons. If `noValue` is
         * true, a trailing semicolon is printed after the last value. Empty blocks
         * print `unit`.
         *
         * When formatting for parameter contexts (`forParams`), the block is printed as
         * `_` to avoid expanding its contents.
         */
        pub over format (self, dmut stream: &Formatter) {
            if (stream.tags.forParams) {
                stream:.write ("_");
                return;                
            }
            
            if (!self.isSet) {
                stream:.write (Tokens::LACC, '\n');
            } else stream:.write ('#', Tokens::LACC, '\n');
            stream:.entabing ();

            for i, v in self.values {
                if (i != 0) stream:.write (Tokens::SEMI_COLON, '\n');
                v.format (alias stream);
            }

            if (self.noValue && self.values.len != 0) {
                stream:.write (Tokens::SEMI_COLON);
            }

            if (self.values.len == 0) {
                stream:.write (UNIT_VALUE);
            }

            stream:.detabing ();
            if (!self.isSet) {
                stream:.write ('\n', Tokens::RACC);
            } else { stream:.write ('\n', '#', Tokens::RACC); }            
        }        
    }
    
}



