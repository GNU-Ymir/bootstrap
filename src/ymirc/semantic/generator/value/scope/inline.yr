 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in inline;

use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::{format, comparison};

use std::stream;

use ymirc::semantic::generator::type;
use ymirc::semantic::generator::value::literal;


/**
 * Represents an inline block of generator values.
 *
 * Inline blocks behave like inline function bodies: a `return` inside the
 * block does not exit the current frame but jumps to the end of the block.
 * They do not introduce a lexical scope and are always marked as reduced.
 *
 * Characteristics:
 *   - values are evaluated sequentially,
 *   - no new scope is created,
 *   - break/return markers never escape the block,
 *   - throwers from contained values are aggregated,
 *   - formatting uses a compact `#INLINE { ... }` representation.
 *
 */
@final
pub class InlineBlockValue over ScopeValue {

    pub {
        /**
         * The ordered list of generator values contained in the block.
         */
        let values: [&Value];
    }

    /**
     * Constructs an inline block.
     *
     * @params:
     *   - loc:       source location of the block
     *   - type:      resulting type of the block
     *   - values:    ordered list of generator values inside the block
     *
     * Inline blocks:
     *   - are always reduced,
     *   - never produce lvalues,
     *   - do not propagate break/return locations outside the block,
     *   - aggregate throwers from all contained values.
     *
     */
    pub self (loc: &Word,
              type: &Type,
              values: [&Value])
        with super (loc,
                    type,
                    isReduced-> true,
                    isLvalue-> false,
                    breakLoc-> EOF_WORD,
                    returnLoc-> EOF_WORD)

        , values = values
    {
        let mut th: [Thrower] = [];
        for i in values {
            th ~= i.throwers;
        }

        self._throwers = th;
    }

    /**
     * @returns true iff all contained values are full literals.
     */
    @field
    pub over isFullLiteral(self)-> bool {
        for i in self.values {
            if !i.isFullLiteral return false;
        }

        true
    }

    /**
     * Creates a deep copy of the inline block, cloning all contained values.
     */
    pub over clone(self)-> &InlineBlockValue {
        let result = copy [i.clone() for i in self.values];

        return copy InlineBlockValue(self.loc,
                                      self.type,
                                      result);
    }


    impl Comparable!{&Generator};
    impl Streamable;
    impl Formattable {

        /**
         * Writes the inline block using the `#INLINE { ... }` syntax.
         *
         * When formatting for parameter contexts, prints `_` instead of expanding
         * the block contents.
         *
         */
        pub over format(self, dmut stream: &Formatter) {
            if (stream.tags.forParams) {
                stream:.write("_");
                return;
            }

            stream:.write("#INLINE", Tokens::LACC, '\n');
            stream:.entabing();

            for i, v in self.values {
                if (i != 0) stream:.write(Tokens::SEMI_COLON, '\n');
                v.format(alias stream);
            }

            if (self.values.len == 0) {
                stream:.write(UNIT_VALUE);
            }

            stream:.detabing();
            stream:.write('\n', Tokens::RACC);
        }
    }


}
