/*
 * Declares the LoopValue class.
 *
 * LoopValue represents the unified generator-level form of all looping
 * constructs. During validation, every top-level loop (`while`, `for`, `loop`,
 * and constant-foldable `for` loops) is desugared into this single structure.
 * This ensures that the generator IR has a consistent representation for all
 * looping semantics.
 *
 * The loop consists of:
 *   - a test expression, evaluated before each iteration(except for `loop`,
 *     where the test is `unit`),
 *   - a body expression executed when the test succeeds,
 *   - an optional flag indicating that the loop originated from a constant
 *     `for` loop that has already been unrolled.
 *
 * LoopValue also aggregates throwers and return locations from its components.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::generator::value::scope::loop_
 * @File: ymirc/semantic/generator/value/scope/loop_.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2021-12-06
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in loop_;

use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::{format, comparison};

use std::stream;

use ymirc::semantic::generator::type;
use ymirc::semantic::generator::value::literal;


/**
 * Represents a loop construct in the generator IR.
 *
 * LoopValue is the canonical representation of all looping constructs after
 * validation. A loop consists of a test expression and a body expression:
 *
 *   - If the test is `unit`, the loop behaves like a `loop` construct(infinite
 *     until broken).
 *   - Otherwise, the loop behaves like a `while` construct.
 *
 * The `isCteFor` flag marks loops originating from constant-foldable `for`
 * loops that have already been unrolled by the validator.
 *
 * LoopValue:
 *   - is always an rvalue,
 *   - aggregates throwers from the test and body,
 *   - propagates return locations when the body always returns and the test is
 *     `unit`,
 *   - never propagates break locations upward(inner breaks exit this loop).
 */
@final
pub class LoopValue over ScopeValue {

    pub {
        /**
         * The loop test expression.
         *
         * When equal to `unit`, the loop is unconditional(`loop { ... }` semantics).
         */
        let test: &Value;

        // The body of the loop, executed when the test succeeds.
        let value: &Value;

        /**
         * The iteration step, executed after the body and before the test.
         *
         * `for` loops desugar into a test/body pair plus an iterator increment. The
         * increment cannot live at the end of the body: `continue` jumps out of the
         * body, so it would be skipped and the loop would never advance. It is kept
         * apart here, and the expander gives it its own label, which is what
         * `continue` targets.
         *
         * `unit` for every loop that has no such step(`loop`, `while`, `while let`).
         */
        let step: &Value;

        /**
         * True iff the loop originates from a constant-foldable `for` loop that has
         * already been unrolled.
         */
        let isCteFor: bool;
    }

    /**
     * Construct a loop expression.
     *
     * @params:
     *   - loc:       source location of the loop
     *   - type:      resulting type of the loop
     *   - test:      the loop test expression
     *   - value:     the loop body
     *   - step:      the iteration step, run after the body and on `continue`
     *   - isCteFor:  true iff the loop was produced by unrolling a constant `for`
     *   - isReduced: true iff the loop is already reduced
     *
     * Throwers are aggregated from the test, body and step. Return locations are
     * propagated when the body always returns and the test is `unit`. Break
     * locations are never propagated upward.
     */
    pub self (loc:       &Word,
              type:      &Type,
              test:      &Value,
              value:     &Value,
              step:      &Value = UNIT_VALUE,
              isCteFor:  bool = false,
              isReduced: bool = false)

        with super (loc, type, isReduced-> isReduced, isLvalue-> false)
        , test = test
        , value = value
        , step = step
        , isCteFor = isCteFor
    {
        self._throwers = self.test.throwers ~ self.value.throwers ~ self.step.throwers;

        if (value.isReturner && self.test of UnitValue) {
            self._returnLoc = value._returnLoc;
        }

        // we don't propagate breakLoc, since inner value breaks would break
        // this loop, not an upper one. And test cannot be a breaker, it is
        // ensured in validation
    }

    /**
     * Create a deep copy of the loop.
     *
     * The test, body and step are cloned, and a new LoopValue is constructed with
     * identical metadata(type, constant-for flag, and reduction state).
     */
    pub over clone(self)-> &Value {
        return copy LoopValue(self.loc,
                               self.type,
                               self.test.clone(),
                               self.value.clone(),
                               step-> self.step.clone(),
                               isCteFor-> self.isCteFor,
                               isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};
    impl Streamable;
    impl Formattable {

        /**
         * Write the loop to the formatter.
         *
         * The printed form depends on the loop kind:
         *
         *   - `loop <body>` when the test is `unit`,
         *   - `while <test> <body>` for normal loops,
         *   - `cte for <body>` for constant-unrolled `for` loops.
         *
         * A loop carrying an iteration step prints it after the body, as
         * `<body> step <step>`.
         *
         * When formatting for parameter contexts(`forParams`), the loop is printed as
         * `_` to avoid expanding its contents.
         */
        pub over format(self, dmut stream: &Formatter) {
            if (stream.tags.forParams) {
                stream:.write("_");
                return;
            }

            if (!self.isCteFor) {
                match self.test {
                    UnitValue() => {
                        stream:.write("loop ");
                    }
                    _ => {
                        stream:.write("while ", self.test, ' ');
                    }
                }
            } else { stream:.write("cte for "); }

            self.value.format(alias stream);

            if (self.step !of UnitValue) {
                stream:.write(" step ");
                self.step.format(alias stream);
            }
        }
    }

}
