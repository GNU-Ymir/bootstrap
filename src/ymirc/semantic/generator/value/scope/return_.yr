/*
 * Declares the ReturnValue class.
 *
 * ReturnValue represents a `return` instruction in the generator IR. A return
 * terminates the current function frame immediately and yields the provided
 * value as the function’s result. Because execution cannot continue past a
 * return, it is treated as a terminal control-flow construct.
 *
 * Return instructions propagate the throwers of their returned value and mark
 * their own source location as a return location for control-flow analysis.
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::semantic::generator::value::scope::return_
 * @File: ymirc/semantic/generator/value/scope/return_.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2021-11-20
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in return_;

use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::{format, comparison};

use std::stream;

use ymirc::semantic::generator::type::native;
use ymirc::semantic::generator::value::literal;


/**
 * Represents a `return` instruction in the generator IR.
 *
 * A ReturnValue exits the current function frame and yields the provided value
 * as the function’s result. It is always a terminal instruction: control flow
 * does not continue after a return. The returned value may be `unit` for
 * functions returning `void`.
 *
 * ReturnValue:
 *   - is always an rvalue,
 *   - always has type `void` (the function’s actual return type is contained in the value),
 *   - propagates the throwers of its returned value,
 *   - marks its own location as a return location,
 *   - is never an lvalue.
 */

@final
pub class ReturnValue over Value {

    pub {        
        /**
         * The value returned by the return instruction.
         *
         * This value becomes the result of the current function frame. When
         * equal to `unit`, the return has no explicit value.
         */
        let value: &Value;
    }
    
    /**
     * Construct a return instruction.
     *
     * @params:
     *   - loc:       the source location of the return
     *   - value:     the value returned by the return
     *   - isReduced: true iff the return is already reduced
     *
     * The return has type `void`, inherits the throwers of the returned value,
     * and marks its own location as a return location.
     */
    pub self (loc: &Word, value: &Value, isReduced: bool = false)
        with super (loc, VOID_TYPE,
                    throwers-> value.throwers,
                    returnLoc-> loc,
                    isReduced-> isReduced,
                    isLvalue-> false)
        
        , value = value
    {}   


    /**
     * Create an exact copy of the return instruction.
     *
     * The returned value is cloned, and a new ReturnValue is constructed with
     * the same source location and reduction state.
     */
    pub over clone (self)-> &Value {
        return copy ReturnValue (self.loc,
                                 self.value.clone (),
                                 isReduced-> self.isReduced);
    }
    
    impl Comparable!{&Generator};
    impl Streamable;
    impl Formattable {

        /**
         * Write the return instruction to the formatter.
         *
         * The printed form is:
         *
         *     return <value>
         *
         * When the returned value is `unit`, the formatter only prints `return`.
         */
        pub over format (self, dmut stream: &Formatter) {
            stream:.write (Keys::RETURN, " ");
            if self.value !of UnitValue {
                self.value.format (alias stream);                
            }
        }        

    }   
        
}

