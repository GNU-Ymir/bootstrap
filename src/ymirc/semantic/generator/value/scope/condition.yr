/*
 * Declares the ConditionalValue class.
 *
 * ConditionalValue represents an `if` / `else` construct in the generator IR.
 * It evaluates a test expression and selects one of two branches. The resulting
 * value of the conditional is the value of the chosen branch, unless the
 * conditional is incomplete or the branches yield `unit`.
 *
 * The class also propagates throwers, break locations, and return locations
 * from its branches, and can mark itself as “complete” when the test is known
 * to be a tautology during validation.
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::semantic::generator::value::scope::condition
 * @File: ymirc/semantic/generator/value/scope/condition.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2021-12-06
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in condition;

use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::{format, comparison};

use std::stream;

use ymirc::semantic::generator::type;
use ymirc::semantic::generator::value::literal;

/**
 * Represents an `if` / `else` conditional expression.
 *
 * A ConditionalValue evaluates a test expression and selects either the `then`
 * branch or the `else` branch. Its resulting type and value are determined by
 * the chosen branch. The conditional is considered “complete” when the test is
 * known to be a tautology or when both branches produce a value, which affects
 * return/break propagation.
 *
 * ConditionalValue:
 *   - is always an rvalue,
 *   - aggregates throwers from the test and both branches,
 *   - propagates return/break locations when both branches lead to them,
 *   - is a full literal only when all sub-expressions are full literals.
 */

@final
pub class ConditionalValue over ScopeValue {

    pub {                
        // The test expression controlling the conditional.         
        let test: &Value;

        // The branch evaluated when the test is true.
        let thenv: &Value;

        // The branch evaluated when the test is false.
        let elsev: &Value;
        
        /**
         * True iff the conditional is known to always produce a value.
         *
         * This is typically used when the test is a compile-time tautology or
         * when both branches produce a value, allowing return/break propagation
         * even if the `else` branch is syntactically absent.
         */
        let isComplete: bool;
    }

    /**
     * Construct a conditional expression.
     *
     * @params:
     *   - loc:        source location of the conditional
     *   - type:       resulting type of the conditional
     *   - test:       the test expression
     *   - thenv:      the branch taken when the test is true
     *   - elsev:      the branch taken when the test is false
     *   - isComplete: true iff the conditional always yields a value
     *   - isReduced:  true iff the conditional is already reduced
     *
     * Throwers, return locations, and break locations are aggregated from the
     * test and both branches. When both branches return or break, or when the
     * test is a tautology and the `else` branch is `unit`, the conditional
     * inherits the corresponding location.
     */
    pub self (loc:        &Word,
              type:       &Type,
              test:       &Value,
              thenv:      &Value,
              elsev:      &Value,
              isComplete: bool = false,
              isReduced:  bool = false)
        
        with super (loc, type, isReduced-> isReduced, isLvalue-> false)
        
        , test = test
        , thenv = thenv
        , elsev = elsev
        , isComplete = isComplete
        
    {
        self._throwers = self.test.throwers ~ self.thenv.throwers ~ self.elsev.throwers;
        
        if (thenv.isReturner && elsev.isReturner) {
            self._returnLoc = thenv.returnLoc;
        } else if (thenv.isReturner && elsev of UnitValue && isComplete) { // isComplete means the test is a tautology, so it does not matter if else exists
            self._returnLoc = thenv.returnLoc;
        }

        if (thenv.isBreaker && elsev.isBreaker) {
            self._breakLoc = thenv.breakLoc;
        } else if (thenv.isBreaker && elsev of UnitValue && isComplete) { // isComplete means the test is a tautology, so it does not matter if else exists
            self._breakLoc = thenv.breakLoc;
        }
    }

    /**
     * @returns true iff the test, then-branch, and else-branch are all full literals.
     */
    @field
    pub over isFullLiteral (self)-> bool {
        if (!self.test.isFullLiteral) return false;
        if (!self.thenv.isFullLiteral) return false;
        if (!self.elsev.isFullLiteral) return false;

        return true;
    }

    /**
     * Create a deep copy of the conditional.
     *
     * All sub-expressions are cloned, and a new ConditionalValue is constructed
     * with identical metadata (type, completeness, and reduction state).
     */
    pub over clone (self)-> &Value {
        return copy ConditionalValue (self.loc,
                                      self.type,
                                      self.test.clone (),
                                      self.thenv.clone (),
                                      self.elsev.clone (),
                                      isComplete-> self.isComplete,
                                      isReduced-> self.isReduced);
    }


    impl Comparable!{&Generator};
    
    impl Streamable;
    impl Formattable {

        /**
         * Write the conditional to the formatter.
         *
         * The printed form is:
         *
         *     if <test> <then-branch> else <else-branch>
         *
         * The `else` part is omitted when the else-branch is `unit`. When
         * formatting for parameter contexts (`forParams`), the conditional is
         * printed as `_` to avoid expanding its contents.
         */
        pub over format (self, dmut stream: &Formatter) {
            if (stream.tags.forParams) {
                stream:.write ("_");
                return;
            }
            
            stream:.write ("if ", self.test, ' ');
            self.thenv.format (alias stream);
            match self.elsev {
                UnitValue () => {}
                _ => {
                    stream:.write (" else ", self.elsev);
                }            
            }
        }        
    }
    
}



