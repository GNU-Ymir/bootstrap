/*
 * Declares the BreakValue class.
 *
 * BreakValue represents a `break` instruction in the generator IR. A break
 * exits the nearest enclosing loop construct. When used inside a `loop`
 * expression (as opposed to `while` or `for`), the value carried by the break
 * determines the resulting value of the loop.
 *
 * Although break statements participate in control-flow management, they are
 * not scope-introducing constructs. They are therefore grouped in the same
 * module as other scope-related generator values for organizational coherence. 
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::semantic::generator::value::scope::break_
 * @File: ymirc/semantic/generator/value/scope/break_.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2021-11-20
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in break_;

use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::{format, comparison};

use std::stream;

use ymirc::semantic::generator::type::native;
use ymirc::semantic::generator::value::literal;


/**
 * Represents a `break` instruction in the generator IR.
 *
 * A BreakValue exits the nearest enclosing loop. When used inside a `loop`
 * construct, the value carried by the break becomes the value of the loop
 * expression. In `while` and `for` constructs, the break value is always
 * `unit`.
 *
 * BreakValue:
 *   - is always an rvalue,
 *   - always has type `void`,
 *   - propagates the throwers of its carried value,
 *   - records its own break location for control-flow analysis.
 */
@final
pub class BreakValue over Value {

    pub {
        /**
         * The value carried by the break.
         *
         * In `loop` expressions, this value becomes the result of the loop.
         */
        let value: &Value;
    }

    /**
     * Construct a break instruction carrying a value.
     *
     * @params:
     *   - loc:       the source location of the break
     *   - value:     the value returned by the break
     *   - isReduced: true iff the break is already reduced
     *
     * The break has type `void`, is never an lvalue, and inherits the throwers
     * of the carried value. Its break location is recorded for control-flow
     * analysis.
     */
    pub self (loc: &Word, value: &Value, isReduced: bool = false)
        with super (loc,
                    VOID_TYPE,
                    throwers-> value.throwers,
                    breakLoc-> loc,
                    isReduced-> isReduced,
                    isLvalue-> false)
        
        , value = value
    {}                
    

    /**
     * Create an exact copy of this break instruction.
     *
     * The carried value is cloned, and a new BreakValue is constructed with the
     * same reduction state and source location.
     */
    pub over clone (self)-> &Value {
        copy BreakValue (self.loc, self.value.clone (), isReduced-> self.isReduced)
    }

    impl Comparable!{&Generator};
    
    impl Streamable;
    impl Formattable {

        /**
         * Write the break instruction to the formatter.
         *
         * The printed form is:
         *
         *     break <value>
         *
         * If the carried value is `unit`, only `break` is printed. Otherwise,
         * the value is printed on the next indentation level.
         */
        pub over format (self, dmut stream: &Formatter) {
            stream:.write (Keys::BREAK, " ");
            if self.value !of UnitValue {                                
                stream:.entabing ();
                self.value.format (alias stream);
                stream:.detabing ();                
            }
        }        

    }   
    
    
}

