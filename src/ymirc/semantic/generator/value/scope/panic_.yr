/*
 * Declares the PanicValue class.
 *
 * PanicValue represents a `panic` instruction in the generator IR. A panic
 * unconditionally aborts execution when evaluated. It may optionally carry a
 * message value, which is used by the runtime to describe the cause of the
 * crash.
 *
 * Panic instructions behave similarly to `return` or `throw` in that they
 * terminate control flow immediately. For analysis purposes, a panic is treated
 * as a terminal instruction: it always returns from the current function and
 * never produces a runtime value.
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::semantic::generator::value::scope::panic_
 * @File: ymirc/semantic/generator/value/scope/panic_.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2021-11-20
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in panic_;

use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::{format, comparison};

use std::stream;

use ymirc::semantic::generator::type::native;
use ymirc::semantic::generator::value::literal;


/**
 * Represents a `panic` instruction in the generator IR.
 *
 * A PanicValue aborts execution unconditionally. It may optionally carry a
 * message value, which is typically a string literal or expression describing
 * the reason for the panic. If no message is provided, `unit` is used.
 *
 * PanicValue:
 *   - is always an rvalue,
 *   - always has type `void`,
 *   - is always reduced,
 *   - is never an lvalue,
 *   - marks its own location as a return location (panic terminates execution),
 *   - does not propagate break locations.
 */
@final
pub class PanicValue over Value {

    pub {
        /**
         * The message associated with the panic.
         *
         * This value is printed or logged by the runtime when the panic occurs.
         * When equal to `unit`, the panic has no explicit message.
         */
        let msg: &Value;
    }

    /**
     * Construct a panic instruction.
     *
     * @params:
     *   - loc: the source location of the panic
     *   - msg: the message value associated with the panic (defaults to `unit`)
     *
     * The panic has type `void`, is always reduced, and marks its own location
     * as a return location since execution cannot continue past a panic.
     */
    pub self (loc: &Word, msg: &Value = UNIT_VALUE)
        with super (loc, VOID_TYPE,
                    returnLoc-> loc,
                    isReduced-> true,
                    isLvalue-> false)
        , msg = msg
    {}            

    
    /**
     * Create an exact copy of the panic instruction.
     *
     * The message value is cloned, and a new PanicValue is constructed with the
     * same source location and reduction state.
     */
    pub over clone (self)-> &Value {
        return copy PanicValue (self.loc, msg-> self.msg.clone ()); 
    }

    
    impl Comparable!{&Generator};
    
    impl Streamable;
    impl Formattable {

        /**
         * Write the panic instruction to the formatter.
         *
         * The printed form is:
         *
         *     panic <message>
         *
         * If the message is `unit`, only `panic` is printed.
         */
        pub over format (self, dmut stream: &Formatter) {            
            stream:.write (Keys::PANIC);
            if self.value !of UnitValue {
                stream:.write (" ", self.value);
            }
        }
    }


}
