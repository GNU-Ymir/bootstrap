in yield_;

use ymirc::lexing::{keys, word};
use ymirc::semantic::generator::type::native;
use ymirc::utils::{comparison, format};

use std::stream;

/**
 * Represents a `yield` instruction in the generator IR.
 *
 * YieldValue:
 *   - is always an rvalue of type `void`,
 *   - propagates the throwers of the yielded value,
 *   - is not a returner, the body resumes right after it.
 */
@final
pub class YieldValue over Value {

    pub {
        /**
         * The value handed to the consumer, already inferred to the yielded type.
         */
        let value: &Value;
    }

    /**
     * @params:
     *   - loc:       the source location of the yield
     *   - value:     the yielded value
     *   - isReduced: true iff the yield is already reduced
     */
    pub self (loc: &Word, value: &Value, isReduced: bool = false)
        with super (loc, VOID_TYPE,
                    throwers-> value.throwers,
                    isReduced-> isReduced,
                    isLvalue-> false)
        , value = value
    {}

    pub over clone(self)-> &Value {
        return copy YieldValue(self.loc, self.value.clone(), isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};
    impl Streamable;
    impl Formattable {

        /**
         * The printed form is `yield <value>`.
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(Keys::YIELD, " ");
            self.value.format(alias stream);
        }
    }
}
