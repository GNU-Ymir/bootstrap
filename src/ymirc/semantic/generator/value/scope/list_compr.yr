 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in list_compr;

use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::{format, comparison};

use std::stream;

use ymirc::semantic::generator::type;
use ymirc::semantic::generator::value::literal;

/**
 * Represents a list comprehension in the generator IR.
 *
 * A ListComprValue wraps the implicit block produced when the validator
 * desugars a list comprehension. This block contains the iteration logic,
 * element construction, and any filtering conditions. Keeping the block intact
 * allows later phases to:
 *
 *   - inspect how the comprehension was constructed,
 *   - apply implicit conversions to the element type,
 *   - perform template specialization on the synthesized structure,
 *   - propagate throwers, returners, and breakers from the underlying block.
 *
 * ListComprValue is always an rvalue and delegates most semantic behavior to
 * its underlying block.
 */
@final
pub class ListComprValue over ScopeValue {

    pub {
        /**
         * The synthesized block representing the desugared list comprehension.
         *
         * This block contains the full control-flow and element-construction
         * logic generated by the validator.
         */
        let block: &BlockValue;
    }

    /**
     * Construct a ListComprValue wrapping a synthesized comprehension block.
     *
     * @params:
     *   - loc:       the source location of the list comprehension
     *   - type:      the resulting type of the comprehension (typically an array)
     *   - block:     the synthesized block representing the comprehension
     *   - isReduced: true iff the comprehension is already reduced
     *
     * Throwers, return locations, and break locations are inherited from the
     * underlying block. The comprehension is never an lvalue.
     * 
     */
    pub self (loc: &Word, type: &Type, block: &BlockValue, isReduced: bool = false)
        with super (loc, type,
                    throwers-> block.throwers,
                    returnLoc-> block.returnLoc,
                    breakLoc-> block.breakLoc,
                    isReduced-> isReduced,
                    isLvalue-> false)
        
        , block = block
    {}            

    /**
     * @returns true iff the underlying block is a full literal.
     *
     * A list comprehension is a full literal only when its synthesized block is.
     */
    @field
    pub over isFullLiteral (self)-> bool {
        self.block.isFullLiteral
    }
    
    /**
     * Create a deep copy of the list comprehension.
     *
     * The underlying block is cloned, and a new ListComprValue is constructed
     * with identical metadata (type and reduction state).
     */
    pub over clone (self)-> &Value {        
        return copy ListComprValue (self.loc,
                                    self.type,
                                    self.block.clone (),
                                    isReduced-> self.isReduced);    
    }

    impl Comparable!{&Generator};
    impl Streamable;
    impl Formattable {
        
        /**
         * Write the list comprehension to the formatter.
         *
         * The printed form is the formatted representation of the underlying
         * block. This ensures that diagnostics and debugging output reflect the
         * desugared structure used by the generator.
         */
        pub over format (self, dmut stream: &Formatter) {
            self.block.format (alias stream);
        }
    }

}
