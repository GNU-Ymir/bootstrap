in await_;

use ymirc::lexing::{keys, word};
use ymirc::semantic::generator::type::native;
use ymirc::semantic::generator::value::literal;
use ymirc::utils::{comparison, format};

use std::stream;

/**
 * Represents an `await` in the generator IR.
 *
 * AwaitValue:
 *   - is an rvalue typed as the value the awaited async completes with, `void` for
 *     an `await;` giving control back,
 *   - propagates the throwers of the awaited value,
 *   - is not a returner, the body resumes right after it.
 */
@final
pub class AwaitValue over Value {

    pub {
        /**
         * The async handle awaited, `unit` for an `await;` giving control back.
         */
        let handle: &Value;
    }

    /**
     * @params:
     *   - loc:       the source location of the await
     *   - type:      the type of the value the async completes with
     *   - handle:    the async handle, unit for an `await;`
     *   - isReduced: true iff the await is already reduced
     */
    pub self (loc: &Word, type: &Type, handle: &Value, isReduced: bool = false)
        with super (loc, type,
                    throwers-> handle.throwers,
                    isReduced-> isReduced,
                    isLvalue-> false)
        , handle = handle
    {}

    pub over clone(self)-> &Value {
        return copy AwaitValue(self.loc, self.type, self.handle.clone(), isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};
    impl Streamable;
    impl Formattable {

        /**
         * The printed form is `await <handle>`, or `await` when it gives control back.
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(Keys::AWAIT);
            if self.handle !of UnitValue {
                stream:.write(" ");
                self.handle.format(alias stream);
            }
        }
    }
}
