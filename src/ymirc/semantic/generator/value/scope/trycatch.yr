/*
 * Declares the TryCatchValue class.
 *
 * TryCatchValue represents a `try` / `catch` control-flow construct in the
 * generator IR. The `try` block is evaluated first; if it throws an exception,
 * control is transferred to the `catch` block, where the caught exception is
 * bound to a user-defined variable.
 *
 * Because the `try` block may not complete normally(it may throw before
 * reaching its end), its return/break characteristics are ignored unless the
 * `catch` block also returns or breaks. All exceptions raised in the `try`
 * block are intercepted by the `catch` block and rethrown explicitly if needed,
 * so the throwers of the `try` block are not propagated.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::generator::value::scope::trycatch
 * @File: ymirc/semantic/generator/value/scope/trycatch.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2021-12-06
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in trycatch;

use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::{format, comparison};

use std::stream;

use ymirc::semantic::generator::type;
use ymirc::semantic::generator::value::literal;

/**
 * Represents a `try` / `catch` construct in the generator IR.
 *
 * A TryCatchValue evaluates the `try` block and catches any exception thrown
 * within it. The caught exception is bound to `catchVar` and the `catch` block
 * is executed. Because the `catch` block handles all exceptions, the throwers
 * of the `try` block are intentionally ignored.
 *
 * Return and break propagation follow strict rules:
 *   - A return location is propagated only if *both* the try-block and
 *     catch-block are returners.
 *   - A break location is propagated only if *both* blocks are breakers.
 *
 * TryCatchValue:
 *   - is always an rvalue,
 *   - delegates thrower propagation to the catch-block,
 *   - never propagates throwers from the try-block,
 *   - is never an lvalue.
 *
 */
@final
pub class TryCatchValue over ScopeValue {

    pub {
        // The block executed inside the `try` section.
        let tryBlock: &Value;

        // The block executed when an exception is thrown in the try-block.
        let catchBlock: &Value;

        /**
         * The variable declaration that receives the caught exception.
         *
         * This variable is visible only inside the catch-block.
         */
        let catchVar: &Value;
    }

    /**
     * Construct a try/catch expression.
     *
     * @params:
     *   - loc:        source location of the construct
     *   - type:       resulting type of the try/catch expression
     *   - tryBlock:   the block executed inside the `try`
     *   - catchBlock: the block executed when an exception is thrown
     *   - catchVar:   the variable that binds the caught exception
     *   - isReduced:  true iff the construct is already reduced
     *
     * Throwers are inherited exclusively from the catch-block. Return and break
     * locations are propagated only when both try- and catch-blocks exhibit the
     * corresponding control-flow behavior.
     */
    pub self (loc:        &Word,
              type:       &Type,
              tryBlock:   &Value,
              catchBlock: &Value,
              catchVar:   &Value,
              isReduced:  bool = false)

        with super (loc, type,
                    throwers-> catchBlock.throwers,
                    isReduced-> isReduced,
                    isLvalue-> false)

        , catchVar = catchVar
        , tryBlock = tryBlock
        , catchBlock = catchBlock
    {

        // return iff try and catch are returner
        if (tryBlock.isReturner && catchBlock.isReturner) {
            self._returnLoc = tryBlock._returnLoc;
        }

        // break iff try and catch are breaker
        if (tryBlock.isBreaker && catchBlock.isBreaker) {
            self._breakLoc = tryBlock._breakLoc ;
        }

    }

    /**
     * Create a deep copy of the try/catch construct.
     *
     * All sub-expressions(try-block, catch-block, and catch variable) are cloned,
     * and a new TryCatchValue is constructed with identical metadata.
     */
    pub over clone(self)-> &Value {
        return copy TryCatchValue(self.loc,
                                   self.type,
                                   self.tryBlock.clone(),
                                   self.catchBlock.clone(),
                                   self.catchVar.clone(),
                                   isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /**
         * Write the try/catch construct to the formatter.
         *
         * The printed form is:
         *
         *     try {
         *         <try-block>
         *     } catch {
         *         <catchVar>
         *         <catch-block>
         *     }
         *
         * When formatting for parameter contexts(`forParams`), the construct is
         * printed as `_` to avoid expanding its contents.
         */
        pub over format(self, dmut stream: &Formatter) {
            if (stream.tags.forParams) {
                stream:.write("_");
                return;
            }

            stream:.write("try {\n");
            stream:.entabing();
            self.tryBlock.format(alias stream);
            stream:.detabing();

            stream:.write("\n} catch {\n");
            stream:.entabing();
            self.catchVar.format(alias stream);
            stream:.write("\n");
            self.catchBlock.format(alias stream);
            stream:.detabing();
            stream:.write("\n}");
        }
    }


}
