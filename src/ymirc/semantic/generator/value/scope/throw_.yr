/*
 * Declares the ThrowValue class.
 *
 * ThrowValue represents a `throw` instruction in the generator IR. A throw
 * aborts the current control flow and transfers execution to the nearest
 * enclosing `try`/`catch` handler. Unlike `return`, a throw does not produce a
 * function result; instead, it propagates an exception value outward.
 *
 * The thrown value determines the type of exception being raised. ThrowValue
 * records its own location as a return location (since execution does not
 * continue past a throw) and registers a single thrower corresponding to the
 * thrown value.
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::semantic::generator::value::scope::throw_
 * @File: ymirc/semantic/generator/value/scope/throw_.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2021-11-20
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in throw_;

use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::{format, comparison};

use std::stream;

use ymirc::semantic::generator::type::native;
use ymirc::semantic::generator::value::literal;


/**
 * Represents a `throw` instruction in the generator IR.
 *
 * A ThrowValue raises an exception and aborts the current execution path. The
 * thrown value determines the exception type and is used by the runtime or
 * catch handlers to match and process the error.
 *
 * ThrowValue:
 *   - is always an rvalue,
 *   - always has type `void`,
 *   - registers a single thrower describing the thrown exception,
 *   - marks its own location as a return location (execution cannot continue),
 *   - is never an lvalue.
 *   
 */
@final
pub class ThrowValue over Value {

    pub {
        /**
         * The value being thrown as an exception.
         *
         * This value determines the exception type and is propagated outward to
         * the nearest enclosing `try`/`catch` construct.
         */
        let value: &Value;
    }

    /**
     * Construct a throw instruction.
     *
     * @params:
     *   - loc:       the source location of the throw
     *   - value:     the value being thrown
     *   - isReduced: true iff the throw is already reduced
     *
     * The throw has type `void`, registers a single thrower describing the
     * thrown exception, and marks its own location as a return location.
     */
    pub self (loc: &Word, value: &Value, isReduced: bool = false)
        with super (loc, VOID_TYPE,
                    throwers-> copy [Thrower (loc, value.type)],
                    returnLoc-> loc,
                    isReduced-> isReduced)
        
        , value = value
    {}   

    /**
     * Create an exact copy of the throw instruction.
     *
     * The thrown value is cloned, and a new ThrowValue is constructed with the
     * same source location and reduction state.
     */
    pub over clone (self)-> &Value {
        return copy ThrowValue (self.loc,
                                self.value.clone (),
                                isReduced-> self._isReduced);
    }


    impl Comparable!{&Generator};
    
    impl Streamable;
    impl Formattable {

        /**
         * Write the throw instruction to the formatter.
         *
         * The printed form is:
         *
         *     throw <value>
         *
         * The thrown value is printed on an indented line.
         */
        pub over format (self, dmut stream: &Formatter) {
            stream:.write (Keys::THROW, " ");
            stream:.entabing ();
            self.value.format (alias stream);
            stream:.detabing ();                
        }        

    }   
    
    
}

