in yield_in;

use ymirc::lexing::{keys, word};
use ymirc::semantic::generator::type::native;
use ymirc::utils::{comparison, format};

use std::stream;

/**
 * Represents a `yield in` instruction in the generator IR.
 *
 * YieldInValue:
 *   - is always an rvalue of type `void`,
 *   - propagates the throwers of the generator,
 *   - is not a returner, the body resumes after it once the generator is over.
 */
@final
pub class YieldInValue over Value {

    pub {
        /**
         * The generator handle whose values are handed to the consumer.
         */
        let generator: &Value;
    }

    /**
     * @params:
     *   - loc:       the source location of the yield
     *   - generator: the generator handle
     *   - isReduced: true iff the yield is already reduced
     */
    pub self (loc: &Word, generator: &Value, isReduced: bool = false)
        with super (loc, VOID_TYPE,
                    throwers-> generator.throwers,
                    isReduced-> isReduced,
                    isLvalue-> false)
        , generator = generator
    {}

    pub over clone(self)-> &Value {
        return copy YieldInValue(self.loc, self.generator.clone(), isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};
    impl Streamable;
    impl Formattable {

        /**
         * The printed form is `yield in <generator>`.
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(Keys::YIELD, " ", Keys::IN, " ");
            self.generator.format(alias stream);
        }
    }
}
