 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in operator;

use ymirc::lexing::word;
use ymirc::utils::format;
use ymirc::semantic::generator::type;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

mod ::affect;
mod ::binary;
mod ::cast_;
mod ::call;
mod ::fields;
mod ::map;
mod ::slice;
mod ::unary;
mod ::superproxy;
mod ::named;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          TYPES          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub def UnaryOperatorValue: unary::UnaryOperatorValue;

pub def SliceOrArrayOperatorValue: slice::SliceOrArrayOperatorValue;
pub def SliceAppendValue:          slice::append::SliceAppendValue;
pub def ArrayAccessValue:          slice::arrayaccess::ArrayAccessValue;
pub def SliceConcatValue:          slice::concat::SliceConcatValue;
pub def SliceAccessValue:          slice::sliceaccess::SliceAccessValue;

pub def MapOperatorValue: map::MapOperatorValue;
pub def MapInsertValue:   map::insert::MapInsertValue;
pub def MapContainsValue: map::contain::MapContainsValue;
pub def MapAccessValue:   map::access::MapAccessValue;

pub def MapIteratorValue:            map::iteration::MapIteratorValue;
pub def MapIteratorBeginValue:       map::iteration::begin::MapIteratorBeginValue;
pub def MapIteratorEndValue:         map::iteration::end::MapIteratorEndValue;
pub def MapIteratorDelValue:         map::iteration::del::MapIteratorDelValue;
pub def MapIteratorValueAccessValue: map::iteration::value::MapIteratorValueAccessValue;
pub def MapIteratorKeyAccessValue:   map::iteration::key::MapIteratorKeyAccessValue;

pub def FieldOperatorValue:       fields::FieldOperatorValue;
pub def ClassFieldAccessValue:    fields::class_::ClassFieldAccessValue;
pub def ClosureFieldAccessValue:  fields::closure::ClosureFieldAccessValue;
pub def EnumFieldAccessValue:     fields::enum_::EnumFieldAccessValue;
pub def FutureFieldAccessValue:   fields::future_::FutureFieldAccessValue;
pub def MapLenAccessValue:        fields::map::MapLenAccessValue;
pub def OptionFieldAccessValue:   fields::option::OptionFieldAccessValue;
pub def StructFieldAccessValue:   fields::struct::StructFieldAccessValue;
pub def TupleFieldAccessValue:    fields::tuple::TupleFieldAccessValue;
pub def ClassTypeInfoAccessValue: fields::ticlass::ClassTypeInfoAccessValue;

pub def CallOperatorValue:  call::CallOperatorValue;
pub def PrototypeCallValue: call::proto::PrototypeCallValue;
pub def CtorCallValue:      call::ctor::CtorCallValue;
pub def FuncPtrCallValue:   call::fptr::FuncPtrCallValue;
pub def MethodCallValue:    call::method::MethodCallValue;

pub def BinaryOperatorValue:      binary::BinaryOperatorValue;
pub def RangeContainsValue:       binary::range::RangeContainsValue;
pub def CmpPointerOperatorValue:  binary::pointer::cmp::CmpPointerOperatorValue;
pub def MathPointerOperatorValue: binary::pointer::math::MathPointerOperatorValue;

pub def BitwiseIntOperatorValue:     binary::int_::bit::BitwiseIntOperatorValue;
pub def CmpIntOperatorValue:         binary::int_::cmp::CmpIntOperatorValue;
pub def MathIntOperatorValue:        binary::int_::math::MathIntOperatorValue;
pub def SpecialMathIntOperatorValue: binary::int_::special::SpecialMathIntOperatorValue;

pub def CmpFloatOperatorValue:         binary::float_::cmp::CmpFloatOperatorValue;
pub def MathFloatOperatorValue:        binary::float_::math::MathFloatOperatorValue;
pub def SpecialMathFloatOperatorValue: binary::float_::special::SpecialMathFloatOperatorValue;

pub def CmpCharOperatorValue:  binary::char_::cmp::CmpCharOperatorValue;
pub def MathCharOperatorValue: binary::char_::math::MathCharOperatorValue;

pub def CmpBoolOperatorValue:     binary::bool_::cmp::CmpBoolOperatorValue;
pub def LogicalBoolOperatorValue: binary::bool_::logic::LogicalBoolOperatorValue;

pub def CmpClassTypeOperatorValue: binary::class_::CmpClassTypeOperatorValue;

pub def SpecialArrayOperatorValue: binary::array::SpecialArrayOperatorValue;

pub def AffectValue: affect::AffectValue;
pub def CastValue: cast_::CastValue;
pub def SuperProxyValue: superproxy::SuperProxyValue;

pub def NamedValue: named::NamedValue;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          ANCESTOR          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * Abstract base class for all operator values.
 *
 * OperatorValue represents the result of applying an operator to one or more
 * operands. It does not prescribe any particular operator shape (unary, binary,
 * call, indexing, ...); those are defined by concrete subclasses in the
 * operator submodules.
 *
 * The `type`, `isReduced`, and `isLvalue` flags describe the semantic state of
 * the operator result:
 *   - `type` is the computed result type of the operator,
 *   
 *   - `isReduced` indicates whether the value has undergone compile-time
 *     reduction. Reduction simplifies the expression as far as possible,
 *     including constant folding, operator simplification, constant indexing
 *     and slicing, compile-time constructor evaluation, and inlining of
 *     functions marked `@inline`. A reduced value may still depend on runtime
 *     data or contain side effects. Only values reduced to full literals are
 *     considered compile-time constants.
 *     
 *   - `isLvalue` indicates whether the result can appear on the left-hand side
 *     of an assignment.
 */

@abstract
pub class OperatorValue over Value {

    /**
     * Construct an operator value.
     *
     * @params:
     *   - loc:       source location of the operator expression
     *   - type:      result type of the operator
     *   - isReduced: true iff the operator is fully reduced
     *   - isLvalue:  true iff the result is an lvalue
     *   
     */
    pub self (loc:       &Word,
              type:      &Type,
              isReduced: bool,
              isLvalue:  bool,
              throwers:  [Thrower])
        
        with super (loc, type, isReduced-> isReduced, isLvalue-> isLvalue, throwers-> throwers)
    {}
}
