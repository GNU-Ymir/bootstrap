/*
 * Declares the MoverValue class.
 *
 * MoverValue represents a move operation applied to a movable value (an
 * entity-typed value). Moving transfers ownership of the underlying memory
 * segment to a new location, leaving the original location in a reset state.
 *
 * This value is introduced by the `move` operator during semantic lowering. It
 * ensures that ownership semantics are preserved: once a value is moved, the
 * original memory location must no longer be used except through the provided
 * reset value.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::generator::value::memory::move_
 * @File: ymirc/semantic/generator/value/memory/move_.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2021-11-20
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in move_;

use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::type;

/**
 * Represents a move operation on a movable value.
 *
 * A MoverValue encapsulates:
 *   - the value being moved (`value`),
 *   - the reset value written back to the original memory location (`reset`),
 *   - the type and metadata inherited from MemoryValue.
 *
 * Moving transfers ownership of the underlying memory segment. After the
 * move, the original location is replaced with `reset`, ensuring that the
 * moved-from value cannot be reused.
 */
@final
pub class MoverValue over MemoryValue {

    pub {
        /**
         * The value being moved.
         *
         * This is the source of the ownership transfer. It must be an
         * entity-typed value (i.e., movable). The runtime or generated code
         * will transfer the underlying memory segment to the destination.
         */
        let value: &Value;

        /**
         * The reset value written to the original memory location.
         *
         * After a move, the original location must not retain the moved value.
         * This reset value ensures that the moved-from location is left in a
         * valid but inert state (e.g., null, empty, or a type-appropriate
         * default).
         */
        let reset: &Value;
    }

    /**
     * Creates a new MoverValue.
     *
     * Parameters:
     *   - loc:       the source location of the move expression.
     *   - type:      the resulting type of the moved value.
     *   - value:     the value being moved.
     *   - reset:     the value written back to the original location.
     *   - isReduced: true if the value has already been reduced.
     *
     */
    pub self (loc: &Word,
              type: &Type,
              value: &Value,
              reset: &Value,
              isReduced: bool = false)

        with super (loc,
                    type,
                    isReduced-> isReduced,
                    isLvalue-> false,
                    throwers-> value.throwers)

        , value = value
        , reset = reset
    {}

    /**
     * Creates a deep clone of this MoverValue.
     */
    pub over clone (self)-> &Value {
        return copy MoverValue (self.loc,
                                self.type,
                                self.value.clone (),
                                self.reset.clone (),
                                isReduced-> self.isReduced);
    }


    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /*
         * Formats the move expression for debugging or pretty-printing.
         *
         * The printed form is:
         *     move(<value>)
         */
        pub over format (self, dmut stream: &Formatter) {
            stream:.write (Keys::MOVE, ' ', Tokens::LPAR);
            stream:.entabing ();
            self.value.format (alias stream);
            stream:.detabing ();
            stream:.write (Tokens::RPAR);
        }
    }

}
