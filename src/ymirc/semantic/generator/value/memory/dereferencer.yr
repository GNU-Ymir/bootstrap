/*
 * Declares the DereferencerValue class.
 *
 * DereferencerValue represents the unary dereference operator `*` applied to a
 * pointer or reference-like value. It may be introduced explicitly by the user
 * (e.g., `*ptr`) or implicitly by the compiler during semantic validation, for
 * example when accessing the value stored inside a reference variable.
 *
 * Dereferencing produces an lvalue, since the result refers to the memory
 * location pointed to by the operand. The dereferencer does not introduce new
 * runtime behavior beyond that of the underlying pointer access; throwers are
 * inherited from the operand.
 *
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::semantic::generator::value::memory::dereferencer
 * @File: ymirc/semantic/generator/value/memory/dereferencer.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2021-11-20
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in dereferencer;

use ymirc::lexing::{word, tokens};
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::type;

/**
 * DereferencerValue models the unary dereference operator `*` applied to a
 * pointer-like value.
 *
 * The class wraps a single operand (`value`), which must represent a pointer,
 * reference, or any type that semantically supports dereferencing. The
 * dereference may originate from explicit user code (`*ptr`) or be introduced
 * implicitly by the compiler when lowering reference variables or other
 * memory-indirection constructs.
 *
 * Typical uses:
 *   - explicit dereference in user code (`*ptr`)
 *   - implicit dereference of reference variables
 *   - lowering of memory-indirection operations
 *   - enabling lvalue semantics on referenced memory
 */
@final
pub class DereferencerValue over MemoryValue {

    pub {
        /** The operand being dereferenced. */        
        let value: &Value;
    }

    /**
     * Construct a DereferencerValue.
     *
     * @params:
     *   - loc:       source location of the dereference operation
     *   - type:      resulting type of the dereferenced value
     *   - inner:     the pointer or reference value being dereferenced
     *   - isReduced: true iff the dereference has already been semantically reduced
     *
     * Dereferencing always produces an lvalue, since it refers to the memory
     * location pointed to by the operand. Throwers are inherited from the
     * operand, as the dereference itself does not introduce new exceptions.
     */
    pub self (loc:       &Word,
              type:      &Type,
              inner:     &Value,
              isReduced: bool = false)
        
        with super (loc, type,
                    isReduced-> isReduced,
                    isLvalue-> true,
                    throwers-> value.throwers)
        
        , value = value
    {}

    /**
     * Create a deep clone of this DereferencerValue.
     *
     * The operand is recursively cloned, and the resulting DereferencerValue
     * preserves the same type and reduction state. This ensures that pointer
     * dereferencing semantics remain consistent across duplicated semantic
     * trees.
     */
    pub over clone (self)-> &Value {
        return copy DereferencerValue (self.loc,
                                       self.type,
                                       self.value.clone (),
                                       isReduced-> self.isReduced);
    }


    impl Comparable!{&Generator};
    
    impl Streamable;
    impl Formattable {

        /**
         * Format the dereference operation for diagnostic or debugging output.
         *
         * The printed form is:
         *
         *     *(value)
         *
         * This representation is intended for semantic debugging and error
         * reporting, not for code generation.
         */
        pub over format (self, dmut stream: &Formatter) {
            stream:.write ("*(");
            stream:.write (self.value);
            stream:.write (')');
        }
    }

}
