in map_aliaser;

use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::{type, type::native};

/**
 * Represents an aliaser applied to a map value.
 *
 * A MapAliaserValue borrows the underlying memory of a map without copying it.
 * This is used to implement alias semantics for map operations, allowing
 * efficient access and mutation while preserving the borrowing guarantees of
 * the language.
 *
 * The type of the aliaser must be a MapType, and the operand must be a
 * value representing a map. The aliaser behaves like a borrowed reference to
 * the map’s storage.
 */
@final
pub class MapAliaserValue over AliaserValue {

    /**
     * Creates a new MapAliaserValue.
     *
     * Parameters:
     *   - loc:       the source location of the alias expression.
     *   - type:      the map type of the aliaser.
     *   - value:     the operand being aliased(must evaluate to a map).
     *   - isReduced: true if the value has already been reduced.
     *
     */
    pub self (loc:       &Word,
              type:      &MapType,
              value:     &Value,
              isReduced: bool = false)

        with super (loc,
                    type,
                    value,
                    isReduced-> isReduced)

    {}

    /**
     * Creates a deep clone of this MapAliaserValue.
     */
    pub over clone(self)-> &Value {
        if let t: &MapType = self.type {
            return copy MapAliaserValue(self.loc,
                                         t,
                                         self.value.clone(),
                                         isReduced-> self.isReduced);
        }

        panic;
    }

    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /**
         * Formats the aliaser for debugging or pretty‑printing.
         *
         * The printed form is:
         *     <value>:
         *
         * The trailing colon indicates that the value is an aliaser.
         */
        pub over format(self, dmut stream: &Formatter) {
            self.value.format(alias stream);
            stream:.write(Tokens::COLON);
        }
    }

}
