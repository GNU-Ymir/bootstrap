/*
 * Declares the ExpandValue class.
 *
 * ExpandValue represents the result of the `expand` operator applied to a tuple
 * value. The operator expands a tuple into a list of independent values, which
 * can then be used as individual arguments in a function call or any construct
 * expecting multiple parameters.
 *
 * Expansion is a compile-time operation: it does not generate runtime code but
 * rewrites the semantic tree by flattening the tuple structure. Because this
 * transformation manipulates structured memory values, it belongs to the
 * memory-semantic subsystem.
 *
 * Example:
 * ```
 * fn foo (a: i32, b: i32)
 *
 * let t = (1, 2);
 * foo (expand t);   // expands to foo(1, 2)
 * ```
 * 
 * ExpandValue represents the result of the `expand` operator on a tuple value,
 * used to expand it into a list of parameters. It is a compile time operation
 * that have a memory semantic as it flatten out data that are described in a
 * tuple.
 *
 * @example:
 * ```
 * fn foo (a: i32, b: i32)
 *
 * let a = (1, 2);
 * foo (expand a);
 * ```
 * 
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::semantic::generator::value::memory::expand_
 * @File: ymirc/semantic/generator/value/memory/expand_.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *   - Emile Cadorel <emile.cadorel@davidson.fr>
 *
 * @Created (YYYY-MM-DD): 2021-12-06
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */




in expand_;

use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::{format, comparison};
use std::stream;


use ymirc::semantic::generator::{type,
                                 type::native,
                                 value::literal};

/**
 * ExpandValue models the result of the `expand` operator applied to a tuple.
 *
 * The class stores the flattened list of values (`values`) obtained by
 * expanding a tuple expression. Each element corresponds to one component of
 * the original tuple, in order. ExpandValue does not represent a runtime value:
 * it is a compile-time construct used to rewrite argument lists and other
 * multi-value contexts.
 *
 * Expansion is a purely semantic operation. It removes the tuple container and
 * exposes its elements as independent values, enabling constructs such as:
 *
 *     foo (expand t);   // where t is a tuple
 *
 * ExpandValue is always reduced and never an lvalue. Its type is `NONE_TYPE`,
 * since it does not correspond to a single value but to a list of values. The
 * throwers of the ExpandValue are the union of the throwers of each expanded
 * element, as expansion itself introduces no new exceptions.
 *
 * Typical uses:
 *   - flattening tuple arguments in function calls,
 *   - compile-time rewriting of parameter lists,
 *   - semantic propagation of literalness across tuple expansion,
 */
@final
pub class ExpandValue over MemoryValue {

    pub {
        /**
         * The list of values resulting from the expansion.
         *
         * Each element corresponds to one field of the original tuple. The
         * ExpandValue does not store the tuple itself, only the flattened list
         * of its components, ready to be inserted into a parameter list or
         * similar construct.
         */
        let values: [&Value];
    }
    
    /**
     * Construct an ExpandValue.
     *
     * @params:
     *   - loc:    source location of the expand operation
     *   - values: the list of values produced by expanding the tuple
     *
     * ExpandValue has no runtime type (`NONE_TYPE`), since it does not
     * represent a value in the usual sense but a compile-time transformation.
     * It is always considered reduced. Throwers are aggregated from the
     * expanded values, since expansion itself introduces no new exceptions.
     */
    pub self (loc: &Word, values: [&Value])
        with super (loc,
                    NONE_TYPE,
                    isReduced-> true
                    isLvalue-> false,
                    throwers-> {
                        let mut th: [Thrower] = [];
                        for i in values {
                            th ~= i.thrower;
                        }
                        
                        th
                    })
        
        , values = values
    {}                    

    /**
     * An ExpandValue is a full literal only if all expanded values are full
     * literals.
     */
    @field
    pub over isFullLiteral (self)-> bool {
        for i in self.values {
            if !i.isFullLiteral return false;
        }

        true
    }
    
    /**
     * Create a deep clone of this ExpandValue.
     *     
     * Each expanded value is recursively cloned.
     */
    pub over clone (self)-> &Value {
        let result = copy [i.clone () for i in self.values];
        return copy ExpandValue (self.loc, result);
    }


    impl Comparable!{&Generator};
    
    impl Streamable;
    impl Formattable {

        /**
         * Format the expand operation for diagnostic or debugging output.
         *
         * The printed form is:
         *
         *     expand (v1, v2, v3, ...)
         *
         * This representation is intended for semantic debugging and error
         * reporting, not for code generation.
         */
        pub over format (self, dmut stream: &Formatter) {
            stream:.write (Keys::EXPAND, ' ', Tokens::LPAR);
            stream:.entabing ();
            for i in 0us .. self.values.len {
                if (i != 0us) stream:.write (", "s8);
                self.values [i].format (alias stream);
            }
            
            stream:.detabing ();
            stream:.write (Tokens::RPAR);
        }        
    }
    
}



