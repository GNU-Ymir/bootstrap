/*
 * Declares the CopierValue class.
 *
 * CopierValue represents an explicit copy operation introduced by the `copy` or
 * `dcopy` operators. These operators request a semantic copy of a value, either
 * shallow (`copy`) or deep (`dcopy`). The copier itself does not perform the
 * copy at compile time; instead, it records the intention so that semantic
 * analysis, compile-time reduction, and implicit casting rules can take this
 * information into account.
 *
 * A CopierValue may also represent a copy performed by the value itself
 * (through a duplication function, class method, or core::duplication call). In
 * this case, the `isDone` flag indicates that the copy has already been handled
 * by the inner value, and the copier node exists only for semantic tracking.
 *
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::generator::value::memory::copier
 * @File: ymirc/semantic/generator/value/memory/copier.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2021-11-20
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in copier;

use ymirc::lexing::{word, tokens};
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::type;

@final
pub class CopierValue over MemoryValue {

    pub {
        /** The value being copied */
        let value: &Value;

        /** Indicates whether the copy is deep. */
        let isDeep: bool = false;

        /**
         * Indicates whether the copy has already been performed by the value.
         *
         * When true, the copier node exists only to record that a copy
         * occurred. During expansion, the compiler does not need to generate
         * additional copy logic; it only expands the inner value. This
         * information is useful for implicit casting, reduction, and other
         * semantic passes.
         */
        let isDone: bool;
    }

    /**
     * Construct a CopierValue.
     *
     * @params:
     *   - loc:       source location of the copy operation
     *   - type:      resulting type of the copy
     *   - value:     the value being copied
     *   - isDeep:    true iff the copy is a deep copy (`dcopy`)
     *   - isDone:    true iff the copy has already been performed by the value
     *   - isReduced: true iff the copier has already been semantically reduced
     *
     * CopierValue does not produce an lvalue. Throwers are inherited from the
     * operand.
     */
    pub self (loc:       &Word,
              type:      &Type,
              value:     &Value,
              isDeep:    bool = false,
              isDone:    bool = false,
              isReduced: bool = false)

        with super (loc,
                    type,
                    isReduced-> isReduced,
                    isLvalue-> false,
                    throwers-> value.throwers)

        , value = value
        , isDeep = isDeep
        , isDone = isDone
    {}

    /**
     * Create a deep clone of this CopierValue.
     *
     * The operand is recursively cloned, and the resulting CopierValue
     * preserves the deep-copy flag, the completion flag, and the reduction
     * state. This ensures that copy semantics remain consistent across
     * duplicated semantic trees.
     * */
    pub over clone (self)-> &Value {
        return copy CopierValue (self.loc,
                                 self.type,
                                 self.value.clone (),
                                 isDeep-> self.isDeep,
                                 isDone-> self.isDone,
                                 isReduced-> self.isReduced);
    }


    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /**
         * Format the copy operation for diagnostic or debugging output.
         *
         * If the copy has already been performed (`isDone == true`), only the
         * inner value is printed, since the copier node is semantically inert.
         *
         * Otherwise, the printed form is:
         *
         *     copy (value)
         *
         * or, for deep copies:
         *
         *     dcopy (value)
         *
         * depending on the operator used. This representation is intended for
         * semantic debugging and error reporting, not for code generation.
         */
        pub over format (self, dmut stream: &Formatter) {
            if (self.isDone) {
                self.value.format (alias stream);
                return;
            }

            stream:.write (Keys::COPY, ' ', Tokens::LPAR);
            stream:.entabing ();
            self.value.format (alias stream);
            stream:.detabing ();
            stream:.write (Tokens::RPAR);
        }
    }

}
