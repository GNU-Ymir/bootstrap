/*
 * Declares the ClassAliaserValue class.
 *
 * ClassAliaserValue represents an aliasing operation specifically tied to the
 * class field-access operator `:.`. While `(alias x).foo()` and `x:.foo()` are
 * semantically equivalent in terms of aliasing intent, the former is not
 * syntactically valid. This class exists to distinguish explicit aliasing of
 * class instances from general aliasing(`alias x`), ensuring that the semantic
 * engine correctly interprets aliasing in the context of class member access.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::generator::value::memory::class_aliaser
 * @File: ymirc/semantic/generator/value/memory/class_aliaser.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2021-11-20
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in class_aliaser;

use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::type;
use ymirc::semantic::generator::type::{native, custom};


@final
pub class ClassAliaserValue over MemoryValue {

    pub {
        /**
         * The class value being aliased.
         *
         * This is the operand on which the `:.` aliasing semantics apply.
         * Unlike AliaserValue, this aliaser is tied to class pointer semantics
         * and is used exclusively in the context of class member access.
         */
        let value: &Value;

        /**
         * Indicates whether the aliased class type is a struct.
         *
         * This distinction matters because struct and class aliasing differ in
         * how references propagate and how field access interacts with memory
         * semantics.
         */
        let isStruct: bool;
    }

    /**
     * Construct a ClassAliaserValue.
     *
     * @params:
     *   - loc:       source location of the aliasing expression
     *   - type:      class pointer type associated with the alias
     *   - value:     the class value being aliased
     *   - isReduced: true iff the aliaser has already been semantically reduced
     *
     * The resulting value is not an lvalue. Throwers are inherited from the
     * aliased value, since aliasing itself introduces no runtime behavior.
     *
     * The `isStruct` flag is derived from the class pointer type and indicates
     * whether the alias applies to a struct instance.
     */
    pub self (loc:       &Word,
              type:      &ClassPtrType,
              value:     &Value,
              isReduced: bool = false)

        with super (loc,
                    type,
                    isReduced-> isReduced,
                    isLvalue-> false,
                    throwers-> value.throwers)

        , value = value
        , isStruct = type.isStruct
    {}

    /**
     * Create a deep clone of this ClassAliaserValue.
     *
     * The aliased value is recursively cloned. The class pointer type is reused
     * as-is, and the reduction state is preserved.
     */
    pub over clone(self)-> &Value {
        if let c: &ClassPtrType = self.type {
            return copy ClassAliaserValue(self.loc,
                                           c,
                                           self.value.clone(),
                                           isReduced-> self.isReduced);
        }

        panic;
    }

    impl Comparable!{&Generator};
    impl Streamable;
    impl Formattable {

        /**
         * Format the class aliasing expression for diagnostic or debugging output.
         *
         * The printed form is:
         *
         *     value:
         *
         * which corresponds to the prefix of the `:.` operator. This formatting is
         * intended for semantic debugging and error reporting, not for code
         * generation.
         */
        pub over format(self, dmut stream: &Formatter) {
            self.value.format(alias stream);
            stream:.write(Tokens::COLON);
        }
    }
}
