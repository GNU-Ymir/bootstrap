/*
 * Declares the FutureValue class.
 *
 * FutureValue represents a value computed asynchronously inside a POSIX thread.
 * A future is created when evaluating a `future` expression: the compiler
 * generates a lambda capturing the computation, and the runtime launches a
 * thread executing that lambda. The result is stored in the future once the
 * thread completes.
 *
 * FutureValue stores:
 *   - the semantic value representing the body of the future (the computation),
 *   - whether the result is returned by alias,
 *   - the lambda delegate passed to the thread launcher,
 *   - the type and metadata inherited from MemoryValue.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::generator::value::memory::future_
 * @File: ymirc/semantic/generator/value/memory/future_.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2021-11-20
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in future_;

use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::type;

/**
 * Represents a future value produced by a concurrent computation.
 *
 * A FutureValue encapsulates:
 *   - the computation to run in a separate thread(`value`),
 *   - the lambda delegate actually executed by the runtime(`lambda`),
 *   - whether the computation returns by alias(`isByAlias`).
 *
 * The future itself behaves like a memory value whose content becomes
 * available only once the spawned thread completes. The runtime is
 * responsible for storing the result into the future’s memory segment.
 */
@final
pub class FutureValue over MemoryValue {

    pub {
        /**
         * The semantic value representing the body of the future.
         *
         * This is the computation executed inside the spawned thread. It may be
         * a block, an expression, or any value node. The last expression of the
         * block determines the returned value.
         */
        let value: &Value;

        /**
         * True if the future returns its result by alias.
         *
         * This indicates that the computation returns a borrowed memory segment
         * (typically via an AliaserValue). Even if `value` is not itself an
         * AliaserValue(e.g., it is a block), the last expression may return by
         * alias.
         */
        let isByAlias: bool;

        /**
         * The lambda delegate passed to the thread launcher.
         *
         * The runtime invokes this lambda inside a new POSIX thread. The lambda
         * contains the lowered version of the future computation and is
         * responsible for writing the result into the future’s memory.
         */
        let lambda: &Value;
    }

    /**
     * Creates a new FutureValue.
     *
     * Parameters:
     *   - loc:       the source location of the `future` expression.
     *   - type:      the resulting type of the future.
     *   - value:     the semantic value representing the computation.
     *   - lambda:    the lambda delegate executed by the runtime.
     *   - isByAlias: true if the computation returns by alias.
     *   - isReduced: true if the value has already been reduced.
     *
     * The constructor forwards common initialization to MemoryValue and stores
     * the computation and lambda for later code generation.
     */
    pub self (loc:       &Word,
              type:      &Type,
              value:     &Value,
              lambda:    &Value,
              isByAlias: bool = false,
              isReduced: bool = false)

        with super (loc,
                    type,
                    isReduced-> isReduced,
                    isLvalue-> false,
                    throwers-> value.throwers)

        , value = value
        , isByAlias = isByAlias
        , lambda = lambda
    {}


    /**
     * Creates a deep clone of this FutureValue.
     *
     * The clone duplicates:
     *   - the location,
     *   - the type,
     *   - the computation value,
     *   - the lambda delegate,
     *   - the aliasing and reduction flags.
     *
     * Returns:
     *   A new FutureValue instance semantically equivalent to the original.
     */
    pub over clone(self)-> &Value {
        return copy FutureValue(self.loc,
                                 self.type,
                                 self.value.clone(),
                                 self.lambda.clone(),
                                 isByAlias-> self.isByAlias,
                                 isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator} {

        /**
         * Compares this FutureValue with another generator value.
         *
         * Two FutureValue instances are equal iff:
         *   - their MemoryValue base fields are equal,
         *   - their computation values are equal,
         *   - their aliasing flags match.
         *
         * The lambda is not compared directly, as it is derived from the
         * computation and may differ structurally while remaining equivalent.
         */
        pub over opEquals(self, o: &Generator)-> bool {
            if let p: &FutureValue = o {
                if (!self.super.opEquals(o)) return false;

                if (self.value != p.value) return false;
                if (self.isByAlias != p.isByAlias) return false;

                return true;
            }

            return false;
        }

    }

    impl Streamable;
    impl Formattable {

        /**
         * Formats the future expression for debugging or pretty-printing.
         *
         * The printed form is:
         *     spawn(<value>)
         *
         * If parameter formatting is suppressed(tags.forParams), the body is
         * replaced by "_".
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(Keys::SPAWN, ' ', Tokens::LPAR);
            if (stream.tags.forParams) {
                stream:.write("_");
            } else {
                stream:.entabing();
                self.value.format(alias stream);
                stream:.detabing();
            }
            stream:.write(Tokens::RPAR);
        }
    }

}
