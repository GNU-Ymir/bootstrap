/*
 * Declares the ReferencerValue class.
 *
 * ReferencerValue represents a reference value introduced either by the `ref`
 * keyword or by passing a value to an immutable reference variable. Unlike
 * AddressValue, ReferencerValue is *not* typed as a pointer, but it behaves
 * similarly in the generated code: it provides an address to an existing memory
 * location without transferring ownership.
 *
 * This value is used during semantic lowering to model reference semantics
 * distinct from pointer semantics, while still enabling efficient address-based
 * access in the generated backend code.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::generator::value::memory::referencer
 * @File: ymirc/semantic/generator/value/memory/referencer.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2021-11-20
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in referencer;

use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::type;

/**
 * Represents a reference to an existing memory location.
 *
 * A ReferencerValue encapsulates:
 *   - the referenced value(`value`),
 *   - whether the reference is mutable(`isMutable`),
 *   - the type and metadata inherited from MemoryValue.
 *
 * Reference semantics differ from pointer semantics in the type system, but
 * both ultimately lower to address-based access in the backend. This class
 * models the semantic distinction while preserving efficient code generation.
 */
@final
pub class ReferencerValue over MemoryValue {

    pub {
        /**
         * The value being referenced.
         *
         * This is the underlying memory location whose address is taken. The
         * reference does not transfer ownership and does not copy the value.
         */
        let value: &Value;

        /**
         * True if the reference is mutable.
         *
         * Mutable references allow modification of the referenced memory
         * location. Immutable references allow read-only access.
         */
        let isMutable: bool = false;
    }

    /**
     * Creates a new ReferencerValue.
     *
     * Parameters:
     *   - loc:        the source location of the `ref` expression.
     *   - type:       the resulting reference type.
     *   - value:      the value being referenced.
     *   - isMutable:  true if the reference is mutable.
     *   - isReduced:  true if the value has already been reduced.
     *
     */
    pub self (loc: &Word,
              type: &Type,
              value: &Value,
              isMutable: bool = false,
              isReduced: bool = false)

        with super (loc,
                    type,
                    isReduced-> isReduced,
                    isLvalue-> false,
                    throwers-> value.throwers)

        , isMutable = isMutable
        , value = value
    {}

    /**
     * Creates a deep clone of this ReferencerValue.
     */
    pub over clone(self)-> &Value {
        return copy ReferencerValue(self.loc,
                                     self.type,
                                     self.value.clone(),
                                     isMutable-> self.isMutable,
                                     isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /**
         * Formats the reference expression for debugging or pretty-printing.
         *
         * The printed form is:
         *     ref(<value>)
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(Keys::REF, ' ', Tokens::LPAR);
            stream:.entabing();
            self.value.format(alias stream);
            stream:.detabing();
            stream:.write(Tokens::RPAR);
        }
    }

}
