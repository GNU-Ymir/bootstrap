/*
 * Declares the LazyValue class.
 *
 * LazyValue represents a value whose computation is deferred until first use.
 * It is introduced by the `lazy` keyword and behaves similarly to a future,
 * except that:
 *   - the computation is not executed in a separate thread,
 *   - the computation is executed only when the value is first required,
 *   - subsequent accesses reuse the computed result.
 *
 * Example:
 * ```
 * let lazy x = lazy { heavyCompute () };
 * // nothing executed yet
 *
 * println (x); // heavyCompute executed here
 * println (x); // already computed, reused
 * ```

 *
 * @example
 * ```
 * let lazy x = lazy { heavyCompute () };
 * // nothing done yet
 *
 * println (x); // `x` required heavyCompute executed here
 * println (x); // `x` required but already known, just reused
 *
 * ```
 *
 * LazyValue stores:
 *   - the semantic value representing the deferred computation,
 *   - whether the computation returns by alias,
 *   - the lambda delegate used to evaluate the computation,
 *   - whether the value is already a lazy (internal optimization).
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::generator::value::memory::lazy_
 * @File: ymirc/semantic/generator/value/memory/lazy_.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2021-11-20
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in lazy_;

use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::type;

/**
 * Represents a lazily evaluated value.
 *
 * A LazyValue encapsulates:
 *   - the computation to evaluate on first use (`value`),
 *   - the lambda delegate used to perform the evaluation (`lambda`),
 *   - whether the computation returns by alias (`isByAlias`),
 *   - whether the value is already a lazy (`isDone`), used internally to
 *     avoid re-wrapping lazies generated during semantic lowering.
 *
 * Lazy evaluation ensures that the computation is performed at most once,
 * in the thread that first requires the value.
 */
@final
pub class LazyValue over MemoryValue {

    pub {
        /**
         * The semantic value representing the deferred computation.
         *
         * This is the body of the lazy block. It may be a block or any value
         * node. The last expression determines the returned value.
         */
        let value: &Value;

        /**
         * True if the lazy computation returns by alias.
         *
         * This indicates that the computation returns a borrowed memory segment
         * (typically via an AliaserValue). Even if `value` is not itself an
         * AliaserValue, the last expression may return by alias.
         */
        let isByAlias: bool;

        /**
         * The lambda delegate used to evaluate the lazy computation.
         *
         * This lambda is executed the first time the lazy value is required.
         * Its result is stored in the lazy’s memory segment and reused on
         * subsequent accesses.
         */
        let lambda: &Value;

        /**
         * True if the inner value is already a lazy and should not be wrapped.
         *
         * This occurs in generated semantic nodes, for example when laziness is
         * propagated through recursive calls or transformations. It prevents
         * double-lazy wrapping.
         */
        let isDone: bool;
    }

    /**
     * Creates a new LazyValue.
     *
     * Parameters:
     *   - loc:       the source location of the `lazy` expression.
     *   - type:      the resulting type of the lazy value.
     *   - value:     the semantic value representing the computation.
     *   - lambda:    the lambda delegate used to evaluate the computation.
     *   - isByAlias: true iff the computation returns by alias.
     *   - isDone:    true iff the value is already a lazy.
     *   - isReduced: true iff the value has already been reduced.
     *
     */
    pub self (loc:       &Word,
              type:      &Type,
              value:     &Value,
              lambda:      &Value,
              isByAlias: bool = false,
              isDone:    bool = false,
              isReduced: bool = false)

        with super (loc,
                    type,
                    isReduced-> isReduced,
                    isLvalue-> false,
                    throwers-> value.throwers)

        , value = value
        , isByAlias = byAlias
        , lambda = lmbd
        , isDone = isDone

    {}

    /**
     * Creates a deep clone of this LazyValue.
     */
    pub over clone (self)-> &Value {
        return copy LazyValue (self.loc,
                               self.type,
                               self.value.clone (),
                               self.lambda.clone (),
                               isByAlias-> self.isByAlias,
                               isDone-> self.isDone,
                               isReduced-> self.isReduced);
    }


    impl Comparable!{&Generator} {

        /**
         * Compares this LazyValue with another generator value.
         *
         * Lambda value is ignored in the comparison.
         */
        pub over opEquals (self, o: &Generator)-> bool {
            if let p: &LazyValue = o {
                if (!self.super.opEquals (o)) return false;

                if (self.value != p.value) return false;
                if (self.isByAlias != p.isByAlias) return false;
                if (self.isDone != p.isDone) return false;

                return true;
            }

            return false;
        }
    }

    impl Streamable;
    impl Formattable {

        /**
         * Formats the lazy expression for debugging or pretty-printing.
         *
         * The printed form is:
         *     lazy(<value>)
         *
         * If parameter formatting is suppressed (tags.forParams), the body is
         * replaced by "_".
         */
        pub over format (self, dmut stream: &Formatter) {
            stream:.write (Keys::LAZY, ' ', Tokens::LPAR);
            if (stream.tags.forParams) {
                stream:.write ("_");
            } else {
                stream:.entabing ();
                self.value.format (alias stream);
                stream:.detabing ();
            }

            stream:.write (Tokens::RPAR);
        }
    }

}
