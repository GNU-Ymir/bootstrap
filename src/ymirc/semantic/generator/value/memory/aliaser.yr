/*
 * Declares the AliaserValue class.
 *
 * AliaserValue represents an explicit aliasing operation. It does not modify
 * the underlying value, nor does it introduce any runtime behavior. Instead, it
 * encodes a semantic contract expressed by the programmer, indicating that the
 * referenced value may be modified indirectly(typically through a function
 * call or another aliasing mechanism).
 *
 * Example:
 *
 *     foo(alias a);
 *
 * This annotation informs the semantic engine that `a` may be mutated as a side
 * effect of the call, even if the mutation is not visible syntactically.
 *
 * AliaserValue is also extended by specialized aliasers(e.g., map aliasers)
 * that provide aliasing semantics for structured containers.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::generator::value::memory::aliaser
 * @File: ymirc/semantic/generator/value/memory/aliaser.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2021-11-20
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in aliaser;

use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::{format, comparison};

use std::stream;
use ymirc::semantic::generator::type;


/**
 * Class is extendable for map alias,
 * */
pub class AliaserValue over MemoryValue {

    pub {
        /** The value being aliased. */
        let value: &Value;

        /** Indicates whether the alias originates from an expansion construct. */
        let isFromExpansion: bool; // (alias expand x), where x is a tuple or an array
    }

    /**
     * Construct an AliaserValue.
     *
     * @params:
     *   - loc:             source location of the aliasing expression
     *   - type:            resulting type of the aliaser(usually identical to the operand)
     *   - value:           the value being aliased
     *   - isFromExpansion: true iff the alias originates from an expansion
     *   - isReduced:       true iff the aliaser has already been semantically reduced
     *
     * AliaserValue does not produce an lvalue. It inherits throwers from the
     * aliased value, since aliasing itself introduces no new runtime behavior.
     */
    pub self (loc:             &Word,
              type:            &Type,
              value:           &Value,
              isFromExpansion: bool = false,
              isReduced:       bool = false)

        with super (loc,
                    type,
                    isReduced-> isReduced,
                    isLvalue-> false,
                    throwers-> value.throwers)

        , value = value
        , isFromExpansion = isFromExpansion
    {}

    /**
     * Create a deep clone of this AliaserValue.
     *
     * The aliased value is recursively cloned, and the resulting AliaserValue
     * preserves the expansion flag and reduction state.
     */
    pub over clone(self)-> &Value {
        return copy AliaserValue(self.loc,
                                  self.type,
                                  self.value.clone(),
                                  isFromExpansion-> self.isFromExpansion,
                                  isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};
    impl Streamable;
    impl Formattable {

        /**
         * Format the aliasing expression for diagnostic or debugging output.
         *
         * The printed form is:
         *
         *     alias(value)
         *
         * This representation is intended for semantic debugging and error
         * reporting, not for code generation.
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(Keys::ALIAS, ' ', Tokens::LPAR);
            stream:.entabing();
            self.value.format(alias stream);
            stream:.detabing();
            stream:.write(Tokens::RPAR);
        }
    }

}
