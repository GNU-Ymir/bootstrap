 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in basic;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::syntax::expression;
use ymirc::syntax::declaration::attributes;

use ymirc::semantic::generator::value::variable;

use ymirc::semantic::generator::type;
use ymirc::semantic::generator::type::native;

use ymirc::semantic::symbol;
use ymirc::semantic::validator::template::{rewrite, mapper};


/**
 * Represents the prototype of a callable function.
 *
 * A PrototypeValue describes the signature of a function independently of any
 * call site. It stores:
 *   - the function symbol,
 *   - the list of parameter prototype values,
 *   - the return type,
 *   - the attributes applied to the function (unsafe, inline, ...),
 *   - the module location where the function is implemented,
 *   - optional template-rewriter information used during specialization.
 *
 * PrototypeValue is always reduced, never an lvalue, and has type `none`
 * because it does not represent a runtime value — only a callable signature.
 *
 * Template-rewriter metadata allows the generator to track how a prototype was
 * produced during template specialization and to retrieve its mapper and score
 * when needed.
 */
pub class PrototypeValue over Value {

    pub {                
        // The location of the module implementing the function.         
        let implLoc: &Word;
        
        // The symbol representing the function        
        let sym: &Symbol;    
        
        // The list of attributes applied to the function (e.g., `unsafe`, `inline`).
        let attrs: [AttributeWord];

        // The list of parameter prototype values describing the function’s parameters.
        let params: [&ProtoVarDeclValue];

        // The return type of the function.
        let retType: &Type;
    }

    prv {        
        /**
         * Optional template-rewriter used to generate this prototype.
         *
         * When present, it provides access to:
         *   - the template mapper used to rewrite the symbol path,
         *   - the template-rewriter score used for overload resolution.
         */
        let _templateRewriter: (TemplateRewriter)? = none;
    }

    /**
     * Construct a function prototype.
     *
     * @params:
     *   - loc:          source location of the prototype
     *   - implLoc:      location of the function’s implementation module
     *   - sym:          the function symbol
     *   - params:       the list of parameter prototype values
     *   - retType:      the return type of the function
     *   - throwers:     the list of throwers associated with the function
     *   - attrs:        the list of function attributes
     *   - fromTemplate: optional template-rewriter metadata
     *
     * The prototype is always reduced and never an lvalue. Its type is `none`
     * because it represents a signature, not a runtime value.
     */
    pub self (loc:          &Word,
              implLoc:      &Word,
              sym:          &Symbol,
              params:       [&ProtoVarDeclValue],
              retType:      &Type,
              throwers:     [Thrower],
              attrs:        [AttributeWord],
              fromTemplate: (TemplateRewriter)? = none)
        
        with super (loc, NONE_TYPE, isReduced-> true, isLvalue-> false, throwers-> throwers)
        , implLoc = (if (implLoc.isEof) { loc } else { implLoc })
        , sym = sym
        , params = params
        , retType = retType        
        , attrs = attrs
        , _templateRewriter = fromTemplate
    {}            

    
    /**
     * @returns true iff the prototype refers to a C-variadic function.
     */
    @field
    pub fn isCVariadic (self)-> bool {        
        if let f: &FunctionSymbol = self.sym {
            return f.isCVariadic; 
        }

        false
    }

    /**
     * @returns true iff the function is marked `unsafe`.
     */
    @field
    pub fn isUnsafe (self)-> bool {
        for i in self.attrs match i.attr {
            Attributes::UNSAFE => { return true; }
        }

        false
    }
    
    /**
     * @returns the location of the `unsafe` keyword, or EOF if absent.
     */
    @field
    pub fn unsafeLoc (self)-> &Word {
        for i in self.attrs match i.attr {
            Attributes::UNSAFE => { return i.loc; }
        }

        EOF_WORD
    }

    /**
     * @returns true iff the function is marked `inline`.
     */    
    @field
    pub fn isInline (self)-> bool {
        for i in self.attrs match i.attr {
            Attributes::INLINE => { return true; }
        }

        false
    }
    
    /**
     * @returns the location of the `inline` keyword, or EOF if absent.
     */
    @field
    pub fn inlineLoc (self)-> &Word {
        for i in self.attrs match i.attr {
            Attributes::INLINE => { return i.loc; }
        }

        EOF_WORD
    }

    /**
     * @returns the template mapper used to rewrite this prototype, or none.
     */
    @field
    pub fn templateMapper (self)-> TemplateMapper? {        
        if let Ok (t: _) = self._templateRewriter {
            return (t.templateMapper)?;
        }

        none
    }
    
    /**
     * @returns the score of the template rewriter, or 0 if none.
     */
    @field
    pub fn templateScore (self)-> u32 {        
        if let Ok (t: _) = self._templateRewriter {
            return t.score;
        }

        0
    }

    /**
     * A prototype is always considered a full literal.
     */
    @field
    pub over isFullLiteral (self)-> bool {
        true
    }

    /**
     * Create an exact copy of the prototype.
     *
     * PrototypeValue is immutable and cloning returns the same instance.
     */
    pub over clone (self)-> &Value {
        self
    }

    impl Comparable!{&Generator} {

        /**
         * Structural equality for prototypes.
         *
         * Two PrototypeValues are equal iff:
         *   - their base Value fields are equal,
         *   - their symbols are equal,
         *   - their attributes are equal,
         *   - their parameter lists are equal,
         *   - and their return types are equal.
         */
        pub over opEquals (self, o: &Generator)-> bool {
            if let p: &PrototypeValue = o {
                if (!self.super.opEquals (o)) return false;
                
                if self.sym != p.sym return false;                
                if self.attrs != p.attrs return false;
                if self.params != p.params return false;
                if self.retType != p.retType return false;
                
                return true;
            }

            return false;                
        }
    }
    
    impl Streamable;
    impl Formattable {

        /**
         * Write the prototype to the formatter.
         *
         * The printed form is the function’s path, optionally rewritten through
         * the template mapper. When parameter printing is enabled
         * (`withParams`), the full signature is printed:
         *
         *     <path> (<params>)-> <return-type>
         *
         * Parameters are printed in order, separated by commas.
         */
        pub over format (self, dmut stream: &Formatter) {
            let path = match self.templateMapper {
                Ok (x: _) => { self.sym.path.withTemplates (x?) }
                _ => { self.sym.getPath () }
            };

            stream:.write (path);
            if (stream.tags.withParams) {
                stream:.entabing ();
                stream:.write (" (");
                for i, j in self.params {
                    if (i != 0) stream:.write (", ");
                    j.format (alias stream);
                }
                stream:.write (")-> ");
                self.retType.format (alias stream);
                stream:.detabing ();
            }
        }        
    }
    
}



