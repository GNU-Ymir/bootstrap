in union_;

use ymirc::semantic::symbol;
use ymirc::utils::{comparison, format};

use std::stream;

/**
 * Represents a slot of the vtable of a union.
 *
 * A union declares no method of its own: a slot is the method every member
 * declares identically, collected from the first of them. It is named after
 * the union rather than after that member, since the implementation reached
 * through it is the one of the member held at runtime.
 *
 * Everything else is that of the collected method, the prototype being only
 * the signature the call is validated against -- the dispatch goes through the
 * slot, so this prototype never names a function to generate.
 */
@final
pub class UnionMethodPrototypeValue over MethodPrototypeValue {

    pub {
        // The path of the method in the union, '<union path>::<method name>'
        let name: &SymbolPath;
    }

    /**
     * Construct the slot of a union from the method it dispatches.
     *
     * @params:
     *   - name:  the path of the method in the union
     *   - proto: the method collected from the first member
     */
    pub self (name: &SymbolPath, proto: &MethodPrototypeValue)
        with super (proto.loc,
                    implLoc-> proto.implLoc,
                    sym-> proto.sym,
                    params-> proto.params,
                    retType-> proto.retType,
                    throwers-> proto.throwers,
                    attrs-> proto.attrs,
                    classRef-> proto.classRef,
                    traitSym-> proto.traitSym,
                    isMutable-> proto.isMutable,
                    isEmpty-> proto.isEmpty,
                    isOver-> proto.isOver,
                    isFinal-> proto.isFinal,
                    isYield-> proto.isYield,
                    fromTemplate-> proto.templateMapper)

        , name = name
    {}

    /**
     * Write the name of the method in the union, not that of the member it was
     * collected from.
     */
    prot over formatName(self, dmut stream: &Formatter) {
        stream:.write(self.name);
    }

    impl Comparable!{&Generator} {

        /**
         * Two slots are equal iff they are slots of the same name dispatching
         * equal methods.
         */
        pub over opEquals(self, o: &Generator)-> bool {
            if let p: &UnionMethodPrototypeValue = o {
                if (!self.super.opEquals(o)) return false;

                return self.name == p.name;
            }

            return false;
        }

    }

    impl Streamable;
}
