/*
 * Declares the CtorPrototypeValue class.
 *
 * CtorPrototypeValue represents the generator-level prototype of a constructor
 * for a class, record, or entity. A type may define multiple constructors, each
 * with its own user-visible name(e.g. `foo`, `bar`), and the `rename` field
 * stores exactly that name. This allows users to select a specific constructor
 * through syntax such as:
 *
 *     let a = A::foo(12);
 *     let b = A::bar(12);
 *
 * Constructors behave like methods attached to a type, but with constructor-
 * specific invariants:
 *   - they always return a freshly created instance of the type,
 *   - they are always mutable(initialization phase),
 *   - they never participate in overriding or virtual dispatch,
 *   - they always belong to the type referenced by `classRef`,
 *   - their user-visible name is given by `rename`.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::generator::value::prototypes::ctor
 * @File: ymirc/semantic/generator/value/prototypes/ctor.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2021-12-09
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in ctor;

use ymirc::syntax::declaration::attributes;
use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};

use ymirc::semantic::symbol;

use ymirc::semantic::generator::type;
use ymirc::semantic::generator::type::{native, temporary};

use ymirc::semantic::generator::value::variable;
use ymirc::semantic::template_;

use std::stream;

/**
 * Represents the prototype of a constructor for a class, record, or entity.
 *
 * A constructor is a callable that initializes a new instance of a type. A type
 * may define multiple constructors, with optional user-defined name. The
 * `rename` field stores this name and is used to select the constructor through
 * syntax like `A::foo(...)`.
 *
 * CtorPrototypeValue extends MethodPrototypeValue but enforces constructor
 * invariants:
 *   - the return type is always `void`,
 *   - the implicit `self` parameter is always mutable,
 *   - constructors are never overrides and never virtual,
 *   - constructors always belong to the type referenced by `classRef`,
 *   - the user-visible constructor name is stored in `name`.
 *
 * Constructors do not inherit from traits, do not participate in vtable
 * dispatch, and are always concrete.
 *
 * The return type is `void` because ctor initialize the instance that is given
 * as first parameter, by reference. And return `void`.
 */
@final
pub class CtorPrototypeValue over MethodPrototypeValue {

    pub {
        /**
         * The user-visible name of the constructor.
         *
         * This name is used to select the constructor when calling it:
         *
         *     A::foo(12)
         *
         * An empty string indicates the default constructor name.
         */
        let name: [c8] = "";
    }

    /**
     * Construct a constructor prototype.
     *
     * @params:
     *   - loc:          source location of the constructor reference
     *   - sym:          the constructor symbol
     *   - rename:       the user-visible name of the constructor
     *   - params:       the list of constructor parameters
     *   - throwers:     the list of throwers associated with the constructor
     *   - attrs:        the list of constructor attributes
     *   - classRef:     the class or type being constructed
     *   - fromTemplate: optional template-rewriter metadata
     *
     * The constructor is always:
     *   - mutable(`isMutable = true`),
     *   - non-virtual(`isFinal = true`, `isOver = false`),
     *   - non-empty(`isEmpty = false`),
     *   - associated with the type referenced by `classRef`.
     *
     */
    pub self (loc:          &Word,
              sym:          &Symbol,
              rename:       [c8] = "",
              params:       [&ProtoVarDeclValue],
              throwers:     [Thrower],
              attrs:        [AttributeWord],
              classRef:     &ClassRefType,
              fromTemplate: (TemplateRewriter)? = none)

        with super (loc,
                    implLoc-> classRef.sym.loc,
                    sym,
                    params,
                    retType-> copy VoidType(loc),
                    throwers,
                    classRef-> classRef,
                    traitSym-> EMPTY_SYMBOL,
                    isEmpty-> false,
                    isOver-> false,
                    isMutable-> true,
                    attrs-> attrs,
                    fromTemplate-> fromTemplate)

        , name = rename
    {}

    impl Comparable!{&Generator};
    impl Streamable;
    impl Formattable {

        /**
         * Write the constructor prototype to the formatter.
         *
         * The printed form is the constructor’s path(possibly rewritten through the
         * template mapper), followed by its parameter list and its return type:
         *
         *     <path> (<params>)-> mut &(mut <classRef>)
         *
         * Parameters are printed in order, separated by commas.
         */
        pub over format(self, dmut stream: &Formatter) {
            let path = match self.templateMapper {
                Ok(x: _) => { self.sym.path.withTemplates(x?) }
                _ => { self.sym.path }
            };

            stream:.write(path);
            if (stream.tags.withParams) {
                stream:.write(" (");

                stream:.entabing();
                for i, j in self.params {
                    if (i != 0) stream:.write(", ");
                    j.format(alias stream);
                }
                stream:.write(")-> mut &(mut ");
                self.classRef.format(alias stream);
                stream:.write(")");
                stream:.detabing();
            }
        }

    }

}
