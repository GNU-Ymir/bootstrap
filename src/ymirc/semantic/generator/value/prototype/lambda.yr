/*
 * Declares the LambdaValue class.
 *
 * LambdaValue represents a lambda expression in the generator IR. Unlike a
 * normal function prototype, a lambda does not necessarily have fully typed
 * parameters or a known return type at creation time. Its body is stored as an
 * AST expression and is evaluated only once all parameter types are known.
 *
 * Lambdas may capture variables from their enclosing scope, forming closures.
 * In that case, the lambda is associated with a closure index and may carry a
 * `copy` location when the lambda explicitly requests value-capture semantics.
 *
 * LambdaValue is callable, but not a prototype per se: it becomes a concrete
 * function prototype only after type inference and specialization.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::generator::value::prototypes::lambda
 * @File: ymirc/semantic/generator/value/prototypes/lambda.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *   - Emile Cadorel <emile.cadorel@davidson.fr>
 *
 * @Created(YYYY-MM-DD): 2021-12-09
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in lambda;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};

use std::stream;

use ymirc::syntax::expression;

use ymirc::semantic::generator::value::variable;

use ymirc::semantic::generator::type;
use ymirc::semantic::generator::type::native;

use ymirc::semantic::symbol;

/**
 * Represents a lambda expression in the generator IR.
 *
 * A LambdaValue is a callable value whose full prototype is not yet known.
 * Parameter types may be partially or completely untyped at creation time, and
 * the return type may be `NoneType` until the body is evaluated. The lambda
 * body is stored as an AST expression and is type-checked only when all
 * parameter types are available.
 *
 * Lambdas may form closures by capturing variables from their defining scope.
 * When `isClosure` is true, the lambda is associated with a closure index and
 * may carry a `copy` location indicating explicit value-capture semantics.
 *
 * LambdaValue:
 *   - is always reduced and never an lvalue,
 *   - becomes a concrete function prototype only after specialization,
 *   - may have an unspecified return type until the body is analyzed,
 *   - carries a compiler-internal name for diagnostics and code generation.
 *
 */
@final
pub class LambdaValue over Value {

    pub {
        /**
         * The list of parameter values of the lambda.
         *
         * These may be untyped or partially typed until specialization.
         */
        let params: [&Value];

        /**
         * The declared return type of the lambda.
         *
         * May be `NoneType` if the return type is not syntactically specified. When
         * specified, it must match the type inferred from the body.
         */
        let retType: &Type;

        /**
         * The AST expression representing the lambda body.
         *
         * This expression is evaluated only once all parameter types are known.
         */
        let body: &Expression;

        /**
         * The compiler-internal name of the lambda.
         *
         * Lambdas are anonymous at the language level; this name is used for internal
         * bookkeeping and code generation.
         */
        let name: &SymbolPath;

        /**
         * True iff the lambda captures variables from its enclosing scope.
         */
        let isClosure: bool;

        /**
         * The closure index associated with this lambda.
         *
         * Used by closure types and symbol-collection visitors.
         */
        let index: usize;

        /**
         * The location of the `copy` keyword, if present.
         *
         * Indicates explicit value-capture semantics for closures.
         */
        let copyLoc: &Word;
    }

    /**
     * Construct a lambda expression.
     *
     * @params:
     *   - loc:       source location of the lambda
     *   - type:      the lambda’s type(closure type or function type placeholder)
     *   - name:      compiler-internal name of the lambda
     *   - params:    the list of lambda parameters
     *   - retType:   the declared return type(or NoneType)
     *   - body:      the AST expression representing the lambda body
     *   - isClosure: true iff the lambda captures its environment
     *   - index:     closure index used for captured-variable bookkeeping
     *   - copyLoc:   location of the `copy` keyword, if present
     *
     * The lambda is always reduced and never an lvalue.
     */
    pub self (loc:       &Word,
              type:      &Type,
              name:      &SymbolPath,
              params:    [&Value],
              retType:   &Type,
              body:      &Expression,
              isClosure: bool,
              index:     usize,
              copyLoc:   &Word = EOF_WORD)

        with super (loc, type, isReduced-> true, isLvalue-> false)
        , params = params
        , name = name
        , retType = retType
        , isClosure = isClosure
        , index = index
        , body = body
        , copyLoc = copyLoc
    {}

    /**
     * Lambdas are immutable; cloning returns the same instance.
     */
    pub over clone(self)-> &Value {
        self
    }

    impl Comparable!{&Generator} {

        /**
         * Structural equality for lambda expressions.
         *
         * Two LambdaValues are equal iff:
         *   - their base Value fields are equal,
         *   - their closure indices match,
         *   - their closure flags match,
         *   - and their internal names match.
         */
        pub over opEquals(self, o: &Generator)-> bool {
            if let p: &LambdaValue = o {
                if (!self.super.opEquals(o)) return false;

                if (p.index != self.index) return false;
                if (p.isClosure != self.isClosure) return false;
                if (p.name != self.name) return false;

                return true;
            }

            return false;
        }
    }

    impl Streamable;
    impl Formattable {

        /**
         * Write the lambda to the formatter.
         *
         * The printed form is:
         *
         *     copy? |params|-> <retType or `_`>
         *
         * Parameters are printed in order. If the return type is `NoneType`, `_` is
         * printed to indicate that the return type is not yet known.
         */
        pub over format(self, dmut stream: &Formatter) {
            if (self.isClosure) stream:.write(Keys::COPY);

            stream:.write('|');
            stream:.entabing();
            for i, j in self.params {
                if (i != 0us) stream:.write(", ");
                j.format(alias stream);
            }
            stream:.write('|');

            match self.retType {
                NoneType() => {
                    stream:.write("-> _");
                }
                _ => {
                    stream:.write("-> ");
                    self.retType.format(alias stream);
                }
            }

            stream:.detabing();
        }
    }

}
