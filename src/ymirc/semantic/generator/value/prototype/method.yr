/*
 * Declares the MethodPrototypeValue class.
 *
 * MethodPrototypeValue represents the generator-level prototype of a method
 * attached to a user-defined type (class, record, or entity). It extends the
 * base PrototypeValue with information specific to instance methods:
 *   - the class on which the method is defined,
 *   - whether the implicit `self` parameter is mutable,
 *   - whether the method originates from a trait implementation,
 *   - whether it overrides an inherited method,
 *   - whether it is final or participates in virtual dispatch.
 *
 * MethodPrototypeValue is used during overload resolution, template
 * specialization, vtable construction, and code generation to determine how a
 * method should be called and whether dynamic dispatch is required.
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::semantic::generator::value::prototypes::method
 * @File: ymirc/semantic/generator/value/prototypes/method.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *   - Emile Cadorel <emile.cadorel@davidson.fr>
 *
 * @Created (YYYY-MM-DD): 2022-02-09
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in method;

use std::stream;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};

use ymirc::syntax::expression;
use ymirc::syntax::declaration::attributes;

use ymirc::semantic::symbol;

use ymirc::semantic::generator::type;
use ymirc::semantic::generator::type::{native, temporary};
use ymirc::semantic::generator::value::variable;

use ymirc::semantic::validator::template::rewrite;


/**
 * Represents the prototype of a method defined on a class, record, or entity.
 *
 * MethodPrototypeValue extends PrototypeValue with method-specific metadata:
 *
 *   - `classRef` identifies the class or type that defines the method.
 *   - `isMutable` indicates whether the implicit `self` parameter is mutable.
 *   - `traitSym` identifies the trait from which the method originates, if any.
 *   - `isEmpty` marks methods declared without a body (e.g., abstract).
 *   - `isOver` indicates whether the method overrides an inherited method.
 *   - `isFinal` indicates whether the method is final and cannot be overridden.
 *
 * These properties determine how the method participates in inheritance,
 * overriding, and virtual dispatch. Methods on records and entities never use
 * virtual dispatch.
 */
pub class MethodPrototypeValue over PrototypeValue {

    pub {        
        /**
         * True iff the implicit `self` parameter is mutable.
         *
         * Mutable methods may modify the instance; immutable methods cannot.
         */
        let isMutable: bool;

        /**
         * The class or type that defines this method.
         *
         * Used to determine dispatch rules, inheritance, and vtable placement.
         */
        let classRef: &ClassRefType;
        
        /**
         * The trait symbol from which this method originates.
         *
         * If equal to `EMPTY_SYMBOL`, the method does not come from a trait
         * implementation.
         */
        let traitSym: &Symbol;
        
        /**
         * True iff the method has no body.
         *
         * Used for abstract methods, trait declarations, or external declarations.
         */
        let isEmpty: bool;
        
        /**
         * True iff the method overrides an inherited method.
         */
        let isOver: bool;
        
        /**
         * True iff the method is final and cannot be overridden.
         *
         * Methods on records are implicitly final.
         */
        let isFinal: bool;
    }
    
    /**
     * Construct a method prototype.
     *
     * @params:
     *   - loc:          source location of the method reference
     *   - implLoc:      location of the method implementation (or EOF)
     *   - sym:          the method symbol
     *   - params:       the list of parameter prototype values
     *   - retType:      the return type of the method
     *   - throwers:     the list of throwers associated with the method
     *   - attrs:        the list of method attributes
     *   - classRef:     the class or type defining the method
     *   - traitSym:     the trait symbol if the method originates from a trait
     *   - isMutable:    true iff the implicit `self` parameter is mutable
     *   - isEmpty:      true iff the method has no body
     *   - isOver:       true iff the method overrides an inherited method
     *   - isFinal:      true iff the method is final
     *   - fromTemplate: optional template-rewriter metadata
     *
     * The implementation location defaults to the class location when unspecified.
     */    
    pub self (loc:          &Word,
              implLoc:      &Word = EOF_WORD,
              sym:          &Symbol,
              params:       [&ProtoVarDeclValue],
              retType:      &Type,
              throwers:     [Thrower],
              attrs:        [AttributeWord],
              classRef:     &ClassRefType,
              traitSym:     &Symbol = EMPTY_SYMBOL,
              isMutable:    bool,
              isEmpty:      bool = false,
              isOver:       bool = false,
              isFinal:      bool = false,
              fromTemplate: (TemplateRewriter)? = none)
        
        with super (loc,
                    implLoc-> (if implLoc.isEof { clRef.getSymbol ().getLoc () } else { implLoc }),
                    sym,
                    params,
                    retType,
                    throwers,
                    attrs,
                    fromTemplate-> fromTemplate)
        
        , classRef = classRef
        , traitSym = traitSym
        , isEmpty = isEmpty
        , isMutable = isMutable
        , isOver = isOver
        , isFinal = isFinal
    {}


    /**
     * @returns true iff the method participates in virtual dispatch.
     *
     * Methods on records and entities never use virtual dispatch. For classes,
     * a method is virtual unless it is final and not an override.
     */
    @field
    pub fn isVirtual (self)-> bool {
        // record and entity don't have virtual table
        if self.classRef.isStruct return false;
        
        !self._isFinal || self._isOver // is method is final, and is not an override it is not virtual
    }
    
    /**
     * @returns true iff the method is a field getter.
     *
     * A field method has no parameters and is marked with the FIELD attribute.
     */
    @field
    pub fn isField (self)-> bool {
        if self.params.len != 0 return false;
        
        for i in self.attrs match i.attr {
            Attributes::FIELD => { return true; }
        }

        return false;
    }
    
    /**
     * @returns true iff the method is a field setter.
     *
     * A field-assign method has exactly one parameter and is marked with FIELD.
     */
    @field
    pub fn isFieldAssign (self)-> bool {
        if self.params.len != 1 return false;
        
        for i in self.attrs match i.attr {
            Attributes::FIELD => { return true; }
        }

        return false;
    }
    
    /**
     * @returns the location of the FIELD attribute, or EOF if absent.
     */
    @field
    pub fn fieldLoc (self)-> &Word {
        for i in self.attrs match i.attr {
            Attributes::FIELD => { return i.loc; }
        }

        EOF_WORD
    }

    impl Comparable!{&Generator} {

        /**
         * Structural equality for method prototypes.
         *
         * Two MethodPrototypeValues are equal iff:
         *   - their base PrototypeValue fields are equal,
         *   - their class references are equal,
         *   - and their trait symbols are equal.
         */
        pub over opEquals (self, o: &Generator)-> bool {            
            if let p: &MethodPrototypeValue = o {
                if (!self.super.opEquals (o)) return false;
                
                if (self.classRef != p.classRef) return false;
                if (self.traitSym != p.traitSym) return false;

                return true;
            }

            return false;
        }

    }
    
    impl Streamable;
}
