/*
 * Declares the DtorPrototypeValue class.
 *
 * DtorPrototypeValue represents the generator-level prototype of a destructor
 * for a class or entity. Records do not have destructors. A destructor is a
 * special method invoked when an instance is about to be destroyed; it takes no
 * parameters other than the `self`, returns no value, and never participates in
 * overriding or virtual dispatch.
 *
 * Destructors are always:
 *   - associated with the type referenced by `classRef`,
 *   - mutable(they operate on the instance being torn down),
 *   - non-virtual and non-overridable,
 *   - non-throwing and attribute-free.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::generator::value::prototypes::dtor
 * @File: ymirc/semantic/generator/value/prototypes/dtor.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *   - Emile Cadorel <emile.cadorel@davidson.fr>
 *
 * @Created(YYYY-MM-DD): 2021-12-09
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */
in dtor;

use ymirc::lexing::{keys, word};
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::value::variable;

use ymirc::semantic::generator::type;
use ymirc::semantic::generator::type::{native, temporary};

use ymirc::semantic::symbol;

/**
 * Represents the prototype of a destructor for a class or entity.
 *
 * A destructor is a special method invoked when an instance is destroyed. It
 * has strict invariants:
 *
 *   - it takes no parameters(other than `self`),
 *   - it always returns `void`,
 *   - it is always mutable(`self` is being torn down),
 *   - it is never virtual and never an override,
 *   - it never throws and has no attributes,
 *   - it always belongs to the type referenced by `classRef`.
 *
 * Records do not define destructors; only classes and entities may have one.
 */
@final
pub class DtorPrototypeValue over MethodPrototypeValue {

    /**
     * Construct a destructor prototype.
     *
     * @params:
     *   - loc:      source location of the destructor reference
     *   - sym:      the destructor symbol
     *   - classRef: the class or entity whose destructor this represents
     *
     * The destructor prototype is created with:
     *   - no parameters,
     *   - a `void` return type,
     *   - no throwers,
     *   - no attributes,
     *   - `isMutable = true`,
     *   - `isOver = false`, `isFinal = true`,
     *   - `traitSym = EMPTY_SYMBOL`.
     *
     * Destructors are always concrete and never participate in inheritance or
     * virtual dispatch.
     */
    pub self (loc:      &Word,
              sym:      &Symbol,
              classRef: &ClassRefType)

        with super (loc,
                    implLoc-> (classRef.sym.loc),
                    sym,
                    params-> [],
                    retType-> copy VoidType(loc),
                    throwers-> [],
                    classRef-> classRef,
                    traitSym-> EMPTY_SYMBOL,
                    isEmpty-> false,
                    isOver-> false,
                    isMutable-> true,
                    attrs-> [])
    {}

    impl Comparable!{&Generator};
    impl Streamable;
    impl Formattable {

        /**
         * Write the destructor prototype to the formatter.
         *
         * The printed form is:
         *
         *     <path> __dtor(mut self)
         *
         * where `<path>` is the destructor’s symbol path.
         */

        pub over format(self, dmut stream: &Formatter) {
            stream:.write(self.sym.path.toStr());
            stream:.write(Keys::DTOR, " (", Keys::MUTABLE, " ", Keys::SELF, ")");
        }

    }

}
