/*
 * Declares the NamePrototypeValue class.
 *
 * NamePrototypeValue represents a callable prototype whose identity is given by
 * an explicit name rather than by a symbol table entry. This form is used for:
 *
 *   - runtime or internal functions that do not correspond to a declared
 *     symbol path,
 *   - lambda specializations, whose callable form is synthesized from an
 *     expression and may produce many distinct prototypes depending on the
 *     instantiated types.
 *
 * Named prototypes always refer to safe, non-throwing functions with no
 * attributes. Lambda-generated function pointers are safe by construction, and
 * runtime helpers are guaranteed not to throw.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::generator::value::prototypes::named
 * @File: ymirc/semantic/generator/value/prototypes/named.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2021-12-09
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in named;

use ymirc::lexing::{keys, word};
use ymirc::utils::{format, comparison};

use std::stream;

use ymirc::syntax::expression;
use ymirc::semantic::generator::value::variable;

use ymirc::semantic::generator::type;
use ymirc::semantic::generator::type::native;

use ymirc::semantic::symbol;

/**
 * Represents a function prototype identified by an explicit name.
 *
 * Unlike normal prototypes, which derive their identity from a semantic
 * function symbol, NamePrototypeValue uses a provided `SymbolPath` as its
 * callable name. This is required for:
 *
 *   - runtime functions and internal helpers that do not appear in the symbol
 *     table,
 *   - lambda specializations, whose callable identity is synthesized from the
 *     expression and instantiated types.
 *
 * Named prototypes are always:
 *   - safe,
 *   - non-throwing,
 *   - free of attributes.
 *
 * When `isLambda` is true, the name is omitted from formatted output, since
 * lambda callables do not have a user-visible identifier.
 */
@final
pub class NamePrototypeValue over PrototypeValue {

    pub {

        /**
         * The explicit name of the function, represented as a symbol path.
         *
         * This name is used directly during code generation.
         */
        let name: &SymbolPath;

        /**
         * True iff the prototype originates from a lambda specialization.
         *
         * Lambda prototypes omit their name when formatted.
         */
        let isLambda: bool;
    }

    /**
     * Construct a named function prototype.
     *
     * @params:
     *   - loc:       source location of the prototype
     *   - implLoc:   location of the implementation(runtime or synthesized)
     *   - name:      the explicit name of the function
     *   - params:    the list of parameter prototype values
     *   - retType:   the return type of the function
     *   - isLambda:  true iff the prototype comes from a lambda specialization
     *
     * Named prototypes always have:
     *   - no associated symbol(`EMPTY_SYMBOL`),
     *   - no attributes,
     *   - no throwers.
     */
    pub self (loc:      &Word,
              implLoc:  &Word,
              name:     &SymbolPath,
              params:   [&ProtoVarDeclValue],
              retType:  &Type,
              isLambda: bool = false)

        with super (loc, implLoc, EMPTY_SYMBOL, parameters, retType, throwers-> [], attrs-> [])
        , name = name
        , isLambda = isLambda
    {}


    impl Comparable!{&Generator} {

        /**
         * Structural equality for named prototypes.
         *
         * Two NamePrototypeValues are equal iff:
         *   - their base PrototypeValue fields are equal,
         *   - and their names are equal.
         */
        pub over opEquals(self, o: &Generator)-> bool {
            if let p: &NamePrototypeValue = o {
                if (!self.super.opEquals(o)) return false;

                if (self.name != p.name) return false;

                return true;
            }

            return false;
        }

    }

    impl Streamable;
    impl Formattable {

        /**
         * Write the named prototype to the formatter.
         *
         * For non-lambda prototypes, the function name is printed first. Lambda
         * prototypes omit the name. The printed form is:
         *
         *     <name> (<params>)-> <return-type>
         *
         * Parameters are printed in order, separated by commas.
         */
        pub over format(self, dmut stream: &Formatter) {
            if (!self.isLambda) {
                stream:.write(self.name.toStr(), " ");
            }

            stream:.write("(");

            stream:.entabing();
            for i, j in self.params {
                if (i != 0) stream:.write(", ");
                j.format(alias stream);
            }
            stream:.write(")-> ");
            stream:.write(self.retType);
            stream:.detabing();
        }

    }

}
