in narrow;

use ymirc::lexing::word;
use ymirc::semantic::generator::type;
use ymirc::utils::format;

use std::stream;

/**
 * Narrowing of a union to the member it holds.
 *
 * UnionNarrowValue is what a match arm binds: the member read out of the
 * overlay of the union object. It is only valid where the test of that member
 * succeeded, the overlay holding one member at a time.
 *
 * The member lives inside the union object rather than being built by the
 * narrowing, so the narrowing is an lvalue whenever the union it reads is one.
 */
@final
pub class UnionNarrowValue over CastValue {

    pub {
        // The index of the member in the declaration order
        let index: usize;
    }

    /**
     * Construct the narrowing of a union to one of its members.
     *
     * @params:
     *   - loc:   source location of the narrowing
     *   - type:  the type of the member, as the union lets it be accessed
     *   - value: the union value
     *   - index: the index of the member in the declaration order
     */
    pub self (loc: &Word, type: &Type, value: &Value, index: usize)
        with super (loc, type, value, isLvalue-> value.isLvalue, isReduced-> true)
        , index = index
    {}

    /**
     * A narrowing is never a full literal, the member it reads being known
     * only at runtime.
     */
    @field
    pub over isFullLiteral(self)-> bool {
        false
    }

    /**
     * Creates a clone of this UnionNarrowValue.
     */
    pub over clone(self)-> &Value {
        copy UnionNarrowValue(self.loc, self.type, self.value.clone(), self.index)
    }

    impl Streamable;
    impl Formattable {

        /**
         * Formats the narrowing for debugging or diagnostic output.
         *
         * Printed using the syntax:
         *     X#0(value)
         *
         * where the index is the member the union is read as.
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(self.type, '#', self.index, '(', self.value, ')');
        }
    }

}
