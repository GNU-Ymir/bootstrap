in test;

use ymirc::lexing::word;
use ymirc::semantic::generator::type::native;
use ymirc::utils::format;

use std::stream;

/**
 * Test of the member a union holds.
 *
 * UnionTestValue is the condition of a match arm naming a member: the union
 * object carries the index of the member it holds, so the test is the
 * comparison of that index with the one of the member the arm names.
 *
 * The index is what the widening wrote, so the test is exact on the member and
 * identical whether the union lists records or classes -- no runtime call, and
 * no ancestor walk.
 */
@final
pub class UnionTestValue over OperatorValue {

    pub {
        // The union value being tested
        let value: &Value;

        // The index of the member tested, in the declaration order
        let index: usize;
    }

    /**
     * Construct the test of the member a union holds.
     *
     * @params:
     *   - loc:   source location of the test
     *   - value: the union value
     *   - index: the index of the member tested, in the declaration order
     */
    pub self (loc: &Word, value: &Value, index: usize)
        with super (loc,
                    copy BoolType(loc, isMutable-> false),
                    isReduced-> true,
                    isLvalue-> false,
                    throwers-> value.throwers)

        , value = value
        , index = index
    {}

    /**
     * A test is never a full literal, the member held being known only at
     * runtime.
     */
    @field
    pub over isFullLiteral(self)-> bool {
        false
    }

    /**
     * Creates a clone of this UnionTestValue.
     */
    pub over clone(self)-> &Value {
        copy UnionTestValue(self.loc, self.value.clone(), self.index)
    }

    impl Streamable;
    impl Formattable {

        /**
         * Formats the test for debugging or diagnostic output.
         *
         * Printed using the syntax:
         *     (value is #0)
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write('(', self.value, " is #", self.index, ')');
        }
    }

}
