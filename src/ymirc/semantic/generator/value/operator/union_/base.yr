in base;

use ymirc::lexing::word;
use ymirc::semantic::generator::type;
use ymirc::utils::format;

use std::stream;

/**
 * Reading of a union as the base it declares.
 *
 * Every member of a union declaring a base descends from it, and the overlay
 * holds the member as a pointer, so the union reads as that base whichever
 * member it holds -- with no test, and without knowing which.
 *
 * What is read is the member pointer seen as a base pointer, not a slot
 * holding one, so the reading is never an lvalue: assigning through it would
 * leave the union holding a value its index no longer names.
 */
@final
pub class UnionBaseValue over CastValue {

    /**
     * Construct the reading of a union as the base it declares.
     *
     * @params:
     *   - loc:   source location of the reading
     *   - type:  the base, as the mutability of the union lets it be accessed
     *   - value: the union value
     */
    pub self (loc: &Word, type: &Type, value: &Value)
        with super (loc, type, value, isLvalue-> false, isReduced-> true)
    {}

    /**
     * A reading is never a full literal, the member it reads being known only
     * at runtime.
     */
    @field
    pub over isFullLiteral(self)-> bool {
        false
    }

    /**
     * Creates a clone of this UnionBaseValue.
     */
    pub over clone(self)-> &Value {
        copy UnionBaseValue(self.loc, self.type, self.value.clone())
    }

    impl Streamable;
    impl Formattable {

        /**
         * Formats the reading for debugging or diagnostic output.
         *
         * Printed using the syntax:
         *     &(Base)#base(value)
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(self.type, "#base(", self.value, ')');
        }
    }

}
