in binary;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;
use ymirc::semantic::generator::type;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub mod ::array;
pub mod ::class_;
pub mod ::range;
pub mod ::bool_;
pub mod ::char_;
pub mod ::float_;
pub mod ::int_;
pub mod ::pointer;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          ANCESTOR          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * Abstract base class for all binary operator values.
 *
 * BinaryOperatorValue models expressions of the form:
 *
 *     (left OP right)
 *
 * where `OP` is a binary operator and `left` and `right` are operand values.
 * The operator stores:
 *
 *   - `op`:    the binary operator being applied,
 *   - `left`:  the left operand,
 *   - `right`: the right operand.
 *
 * Binary operators never produce lvalues. A binary operator is a full literal
 * only when *both* operands are full literals, enabling compile‑time folding
 * when possible.
 */
@abstract
pub class BinaryOperatorValue over OperatorValue {

    pub {
        /** The binary operator being applied. */
        let op: BinaryOperators;

        /** The left operand of the binary operator. */
        let left: &Value;

        /** The right operand of the binary operator. */
        let right: &Value;
    }

    /**
     * Construct a binary operator value.
     *
     * @params:
     *   - loc:       source location of the operator
     *   - type:      result type of the binary operation
     *   - op:        the operator being applied
     *   - left:      left operand
     *   - right:     right operand
     *   - isReduced: true iff the operator has been reduced
     *
     * The operator never produces an lvalue. Throwers are inherited from both
     * operands.
     */
    pub self (loc:       &Word,
              type:      &Type,
              op:        BinaryOperators,
              left:      &Value,
              right:     &Value,
              isReduced: bool = false)

        with super (loc,
                    type,
                    isReduced-> isReduced,
                    isLvalue-> false,
                    throwers-> (left.throwers ~ right.throwers))

        , left = left
        , right = right
        , op = op
    {}

    /**
     * @returns true if `left` and `right` are full literals
     * */
    @field
    pub over isFullLiteral (self)-> bool {
        self.left.isFullLiteral && self.right.isFullLiteral
    }

    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /**
         * Format the binary operator as:
         *
         *     (left OP right)
         */
        pub over format (self, dmut stream: &Formatter) {
            stream:.write ('(', self.left);
            stream:.write (' ', self.op, ' ');
            stream:.write (self.right, ')');
        }
    }

}
