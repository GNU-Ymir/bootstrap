/*
 * Declares the FutureFieldAccessValue class.
 *
 * FutureFieldAccessValue represents a field-access operator applied to a Future
 * object. Futures expose a small set of special fields, each corresponding to a
 * specific semantic operation:
 *
 *   - `value`     — waits for the future to complete and returns its result;
 *   - `finished`  — checks whether the future has completed without blocking;
 *   - `tid`       — returns the POSIX thread identifier running the future.
 *
 * These accesses are not ordinary struct or class field accesses. Each field
 * name triggers a dedicated runtime behavior defined by the Future type. None
 * of these accesses produce an lvalue.

 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::generator::value::operator::fields::future_
 * @File: ymirc/semantic/generator/value/operator/fields/future_.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-03-02
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in future_;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use ymirc::semantic::generator::type;

use std::stream;

/**
 * Represents access to one of the special fields of a Future.
 *
 * FutureFieldAccessValue models expressions such as:
 *
 *     future.value
 *     future.finished
 *     future.tid
 *
 * Each field name corresponds to a specific semantic action:
 *
 *   - `value`     — blocking retrieval of the future’s result;
 *   - `finished`  — non-blocking completion test;
 *   - `tid`       — retrieval of the thread identifier running the future.
 *
 * These accesses never produce an lvalue. The `value` field is never considered
 * a full literal, since it depends on runtime state and may block. Other fields
 * inherit literal-ness from the underlying future object(which is unlikely).
 */
@final
pub class FutureFieldAccessValue over FieldOperatorValue {

    pub {
        /** Name of the future field being accessed(`value`, `finished`, `tid`). */
        let name: [c8];
    }

    /**
     * Construct a future-field access operator value.
     *
     * @params:
     *   - loc:       source location of the access
     *   - type:      result type of the accessed field
     *   - object:    the future operand
     *   - name:      the name of the accessed field
     *   - isReduced: true iff the operator has been reduced
     *
     * Future field accesses never produce lvalues.
     */
    pub self (loc:       &Word,
              type:      &Type,
              object:    &Value,
              name:      [c8],
              isReduced: bool = false)

        with super (loc,
                    type,
                    object,
                    isReduced-> isReduced,
                    isLvalue-> false)

        , name = name
    {}

    /**
     * @returns true iff the access is a full literal(extremely unlikely, if not impossible)
     * */
    @field
    pub over isFullLiteral(self)-> bool {
        if (self._name == FutureKeys::VALUE) {
            return false;
        }

        return self.__super__.isFullLiteral;
    }

    /**
     * Create an exact copy of the future-field access operator, recursively
     * cloning the future operand.
     *
     * */
    pub over clone(self)-> &Value {
        return copy FutureFieldAccessValue(self.loc,
                                            self.type,
                                            self.object.clone(),
                                            self.name,
                                            isReduced-> self.isReduced);
    }


    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /**
         * Format the future-field access as:
         *
         *     <future>.field
         *
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(self.object, ".", self.name);
        }
    }

}
