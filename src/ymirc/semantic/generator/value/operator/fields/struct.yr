/*
 * Declares the StructFieldAccessValue class.
 *
 * StructFieldAccessValue represents a field access on a record or entity value.
 * This operator applies to value-types(structs, records, entities) whose
 * fields are stored directly inside the object. Unlike class field access,
 * which always yields an lvalue, struct field access may or may not produce an
 * lvalue depending on whether the struct itself is an lvalue.
 *
 * The operator extracts a named field from the struct and preserves the
 * lvalue-ness of the underlying object. If the struct is an lvalue, the field
 * is an lvalue; if the struct is a temporary or rvalue, the field is not
 * assignable.

 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::generator::value::operator::fields::struct
 * @File: ymirc/semantic/generator/value/operator/fields/struct.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-03-02
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in struct;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};

use ymirc::semantic::generator::{type,
                                 value::memory};
use std::stream;

/**
 * Represents a field access on a struct, record, or entity value.
 *
 * StructFieldAccessValue models expressions such as:
 *
 *     record.field
 *
 * where the field is stored directly inside the value. The operator stores:
 *
 *   - `object`: the struct or record being accessed,
 *   - `name`:   the name of the field.
 *
 * The result is an lvalue only when the struct itself is an lvalue. This
 * mirrors the semantics of value-type field access: mutability and
 * assignability propagate from the container to the field.
 */
@final
pub class StructFieldAccessValue over FieldOperatorValue {


    pub {
        /** Name of the struct field being accessed. */
        let name: [c8];
    }

    /**
     * Construct a struct-field access operator value.
     *
     * @params:
     *   - loc:       source location of the field access
     *   - type:      result type of the accessed field
     *   - object:    the struct operand
     *   - name:      the name of the field
     *   - isReduced: true iff the operator has been reduced
     *
     * The lvalue-ness of the field is inherited from the struct operand.
     */
    pub self (loc: &Word, type: &Type, object: &Value, name: [c8], isReduced: bool = false)
        with super (loc,
                    type,
                    object,
                    isReduced-> isReduced,
                    isLvalue-> object.isLvalue)

        , name = name
    {}

    /**
     * Create an exact copy of the struct-field access operator, recursively
     * cloning the struct operand.
     */
    pub over clone(self)-> &Value {
        return copy StructFieldAccessValue(self.loc,
                                            self.type,
                                            self.object.clone(),
                                            self.name,
                                            isReduced-> self.isReduced);
    }


    impl Comparable!{&Generator};
    impl Streamable;
    impl Formattable {

        /**
         * Format the struct-field access.
         *
         * If the struct operand is a dereference expression, format as:
         *     `value`-> `field`
         *
         * Otherwise, format as:
         *     `value`.`field`
         */
        pub over format(self, dmut stream: &Formatter) {
            match self._elem {
                d: &DereferencerValue => {
                    stream:.write(d.value, "-> ", self.name);
                }
                _ => {
                    stream:.write(self.object, ".", self.name);
                }
            }
        }
    }

}
