in tiunion;

use ymirc::lexing::word;
use ymirc::semantic::generator::type;
use ymirc::utils::{comparison, format};

use std::stream;

/**
 * Represents access to the dynamic typeinfo of the member a union holds.
 *
 * The member held is only known at runtime, so the typeinfo is read out of
 * the union object:
 *   - a union of records reads the typeinfo of the member held, which the
 *     vtable of the union carries, a record having no subtype,
 *   - a union of classes reads it out of the object held, whichever member it
 *     is, so it is the one of its runtime class, not of the member the union
 *     was widened from -- as it is for a class.
 *
 * The result is never an lvalue.
 */
@final
pub class UnionTypeInfoAccessValue over FieldOperatorValue {

    /**
     * Construct the dynamic typeinfo access of a union.
     *
     * @params:
     *   - loc:       source location of the access
     *   - type:      the typeinfo type returned by the operation
     *   - object:    the union instance
     *   - isReduced: true iff the operator has been reduced
     */
    pub self (loc:       &Word,
              type:      &Type,
              object:    &Value,
              isReduced: bool = false)

        with super (loc,
                    type,
                    object,
                    isReduced-> isReduced,
                    isLvalue-> false)
    {}

    /**
     * The typeinfo is never a full literal, the object held being known only
     * at runtime.
     */
    @field
    pub over isFullLiteral(self)-> bool {
        false
    }

    /**
     * Create an exact copy of the typeinfo-access operator, recursively
     * cloning the union operand.
     */
    pub over clone(self)-> &Value {
        return copy UnionTypeInfoAccessValue(self.loc,
                                              self.type,
                                              self.object.clone(),
                                              isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};
    impl Streamable;
    impl Formattable {

        /**
         * Format the dynamic-typeinfo access as:
         *
         *     typeinfo(<object>)
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write("typeinfo(", self.object, ")");
        }
    }

}
