in enum_;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};

use ymirc::semantic::generator::{type, type::custom};
use ymirc::semantic::generator::value::literal;
use std::stream;

/**
 * Represents a compile-time access to an enum member.
 *
 * EnumFieldAccessValue models the operation:
 *
 *     EnumType::Field
 *
 * where the accessed value is unwrap at compile time and stored directly inside
 * the operator. The `object` inherited from FieldOperatorValue is always
 * `UNIT_VALUE`, since no runtime object is involved.
 *
 * The operator stores:
 *   - `value`: the value associated with the enum field,
 *   - `name`:  the name of the enum field.
 *
 * Enum field accesses are full literals when the embedded value is a full
 * literal.
 */
@final
pub class EnumFieldAccessValue over FieldOperatorValue {

    pub {
        /** The compile-time value associated with the enum field. */
        let value: &Value;
        
        /** The name of the enum field being accessed. */        
        let name: [c8];
    }

    /**
     * Construct an enum-field access operator value.
     *
     * @params:
     *   - loc:   source location of the access
     *   - type:  the enum type being accessed
     *   - value: the compile-time value of the enum field
     *   - name:  the name of the enum field
     *   - isReduced: true iff the operator has been reduced
     *
     * The operator always uses UNIT_VALUE as its object and never produces an
     * lvalue.
     */
    pub self (loc: &Word,
              type: &EnumType,
              value: &Value,
              name: [c8],
              isReduced: bool = false)
        
        with super (loc,
                    type,
                    UNIT_VALUE,
                    isReduced-> isReduced,
                    isLvalue-> false)
        
        , value = value
        , name = name
    {}            

    /**
     * @return true iff the inner `value` is a full literal
     * */
    @field
    pub over isFullLiteral (self)-> bool {
        self.value.isFullLiteral 
    }
    
    /**
     * Create an exact copy of the enum-field access operator, cloning the
     * embedded value.
     */
    pub over clone (self)-> &Value {
        if let en: &EnumType = self.type {
            return copy EnumFieldAccessValue (self.loc,
                                              en,
                                              value-> self.value.clone (),
                                              name-> self.name,
                                              isReduced-> self.isReduced)
        }

        panic;
    }

    impl Comparable!{&Generator};
    
    impl Streamable;
    impl Formattable {

        /**
         * Format the enum-field access.
         *
         * In debug mode:
         *     <EnumType>(<value>)
         *
         * Otherwise:
         *     <EnumType>::<FieldName>
         */
        pub over format (self, dmut stream: &Formatter) {
            if (stream.tags.forDebug) {
                stream:.write (self.type, '(', self.value, ')');
            } else {
                stream:.write (self.type, "::", self.name);
            }
        }
    }

}
