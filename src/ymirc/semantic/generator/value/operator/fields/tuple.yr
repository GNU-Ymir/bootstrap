 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in tuple;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};

use ymirc::semantic::generator::{type,
                                 value::memory};
use std::stream;

/**
 * Represents access to an element of a tuple.
 *
 * TupleFieldAccessValue models expressions such as:
 *
 *     tuple._0
 *     tuple._1
 *
 * where the element is selected by numeric index. Tuples store their elements
 * directly, so the operator extracts the indexed component from the tuple
 * value. The operator stores:
 *
 *   - `object`: the tuple being accessed,
 *   - `index`:  the numeric index of the element.
 *
 * The result is an lvalue only when the tuple itself is an lvalue.
 */
@final
pub class TupleFieldAccessValue over FieldOperatorValue {

    pub {
        /** Index of the tuple element being accessed. */        
        let index: usize;
    }

    /**
     * Construct a tuple-field access operator value.
     *
     * @params:
     *   - loc:       source location of the access
     *   - type:      result type of the accessed element
     *   - object:    the tuple operand
     *   - index:     index of the element to access
     *   - isReduced: true iff the operator has been reduced
     *
     * The lvalue-ness of the element is inherited from the tuple operand.
     */
    pub self (loc: &Word, type: &Type, str: &Value, index: usize, isReduced: bool = false)
        with super (loc,
                    type,
                    object,
                    isReduced-> isReduced,
                    isLvalue-> object.isLvalue)
        
        , index = index
    {}

    /**
     * Create an exact copy of the tuple-field access operator, recursively
     * cloning the tuple operand.
     */
    pub over clone (self)-> &Value {
        return copy TupleFieldAccessValue (self.loc,
                                           self.type,
                                           self.object.clone (),
                                           self.index,
                                           isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};
    
    impl Streamable;
    impl Formattable {

        /**
         * Format the tuple-field access.
         *
         * If the tuple operand is a dereference expression, format as:
         *     `value`-> `index`
         *
         * Otherwise, format as:
         *     `value`.`index`
         */
        pub over format (self, dmut stream: &Formatter) {
            match self._elem {
                d: &DereferencerValue => {
                    stream:.write (d.value, "-> ", self.index);
                }
                _ => {
                    stream:.write (self.object, ".", self.index);
                }
            }
        }
    }
    
}
