/*
 * Declares the ClassTypeInfoAccessValue class.
 *
 * ClassTypeInfoAccessValue represents access to the *dynamic* type information
 * of a class instance. Because classes are polymorphic, the runtime type of an
 * object may differ from the static type through which it is referenced. This
 * operator retrieves the typeinfo associated with the actual dynamic class of
 * the object.
 *
 * Example:
 *
 * ```
 * let a: &A = copy B();
 * assert(a.typeinfo == B::typeinfo);        // dynamic typeinfo
 * assert(typeof(a)::typeinfo != a.typeinfo); // static typeinfo differs
 * ```
 *
 * This operator never produces an lvalue and does not access a structural
 * field; it triggers a semantic operation defined by the class runtime.
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::semantic::generator::value::operator::fields::ticlass
 * @File: ymirc/semantic/generator/value/operator/fields/ticlass.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2021-11-20
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in ticlass;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use ymirc::semantic::generator::type;
use std::stream;

/**
 * Represents access to the dynamic typeinfo of a class instance.
 *
 * ClassTypeInfoAccessValue models expressions such as:
 *
 *     object.typeinfo
 *
 * where the returned typeinfo corresponds to the *actual* runtime class of the
 * object, not necessarily the static type through which it is referenced.
 *
 * The operator stores:
 *   - `object`: the class instance whose dynamic typeinfo is queried.
 *
 * The result is never an lvalue.
 */
@final
pub class ClassTypeInfoAccessValue over FieldOperatorValue {

    /**
     * Construct a dynamic-typeinfo access operator value.
     *
     * @params:
     *   - loc:       source location of the access
     *   - type:      the typeinfo type returned by the operation
     *   - object:    the class instance operand
     *   - isReduced: true iff the operator has been reduced
     *
     * The operator never produces an lvalue.
     */
    pub self (loc:       &Word,
              type:      &Type,
              object:    &Value,
              isReduced: bool = false)
        
        with super (loc,
                    type,
                    object,
                    isReduced-> isReduced,
                    isLvalue-> false)
    {}
    
    /**
     * Create an exact copy of the typeinfo-access operator, recursively
     * cloning the class operand.
     */
    pub over clone (self)-> &Value {
        return copy ClassTypeInfoAccessValue (self.loc,
                                              self.type,
                                              self.object.clone (),
                                              isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};
    impl Streamable;
    impl Formattable {
        
        /**
         * Format the dynamic-typeinfo access as:
         *
         *     typeinfo(<object>)
         */
        pub over format (self, dmut stream: &Formatter) {
            stream:.write ("typeinfo (", self.object, ")");
        }
    }

}
