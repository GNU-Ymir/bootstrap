 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in option;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use ymirc::semantic::generator::type;

use std::stream;

/**
 * Represents access to one of the semantic fields of an option.
 *
 * OptionFieldAccessValue models expressions such as:
 *
 *     opt.value
 *     opt.hasValue
 *
 * Each field name corresponds to a specific semantic operation:
 *
 *   - `value`     — retrieves the wrapped value and throws if the option is empty;
 *   - `hasValue`  — returns true when the option contains a value.
 *
 * These accesses never produce an lvalue. The operator stores:
 *   - `object`: the option being queried,
 *   - `name`:   the name of the accessed field.
 */
@final
pub class OptionFieldAccessValue over FieldOperatorValue {

    pub {
        /** Name of the option field being accessed(`value`, `hasValue`, `error`, etc.). */
        let name: [c8];
    }

    /**
     * Construct an option-field access operator value.
     *
     * @params:
     *   - loc:       source location of the access
     *   - type:      result type of the accessed field
     *   - object:    the option operand
     *   - name:      the name of the accessed field
     *   - isReduced: true iff the operator has been reduced
     *
     * Option field accesses never produce lvalues.
     */
    pub self (loc:       &Word,
              type:      &Type,
              object:    &Value,
              name:      [c8],
              isReduced: bool = false)

        with super (loc,
                    type,
                    object,
                    isReduced-> isReduced,
                    isLvalue-> false)
        , name = name
    {}

    /**
     * Create an exact copy of the option-field access operator, recursively
     * cloning the option operand.
     */
    pub over clone(self)-> &Value {
        return copy OptionFieldAccessValue(self.loc,
                                            self.type,
                                            self.object.clone(),
                                            self.name,
                                            isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /**
         * Format the option-field access as:
         *
         *     <option>.<field>
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(self.object, ".", self.name);
        }
    }

}
