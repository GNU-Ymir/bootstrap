 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in class_;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::type;

/**
 * Represents a field access on a class instance.
 *
 * ClassFieldAccessValue models the operation:
 *
 *     object.field
 *
 * where `object` is an instance of a class type and `field` is the name of one
 * of its members. The result is always an lvalue, as class fields are mutable
 * when the underlying instance is mutable.
 *
 * The operator stores:
 *   - `object`: the class instance being accessed,
 *   - `name`:   the name of the field.
 *
 * A class field access is a full literal only when the object itself is a full
 * literal.
 */
@final
pub class ClassFieldAccessValue over FieldOperatorValue {

    pub {
        /** The name of the field being accessed. */
        let name: [c8];
    }

    /**
     * Construct a class-field access operator value.
     *
     * @params:
     *   - loc:       source location of the field-access expression
     *   - type:      the type of the accessed field
     *   - object:    the class instance operand
     *   - name:      the field name
     *   - isReduced: true iff the operator has been reduced
     *
     * The operator always produces an lvalue and inherits throwers from the
     * object operand.
     */
    pub self (loc:       &Word,
              type:      &Type,
              object:    &Value,
              name:      [c8],
              isReduced: bool = false)

        with super (loc,
                    type,
                    str,
                    isReduced-> isReduced,
                    isLvalue-> true)

        , name = name
    {}

    /**
     * Create an exact copy of the class-field access operator, recursively
     * cloning the object operand.
     */
    pub over clone(self)-> &Value {
        return copy ClassFieldAccessValue(self.loc,
                                           self.type,
                                           self.object.clone(),
                                           self.name,
                                           isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};
    impl Streamable;
    impl Formattable {
        /**
         * Format the class-field access as:
         *
         *     <object>.<field>
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(self.object);
            stream:.write('.');
            stream:.write(self._name);
        }
    }

}
