/*
 * Declares the ClosureFieldAccessValue class.
 *
 * ClosureFieldAccessValue represents an internal field-access operator used
 * when a lambda captures variables from its surrounding scope. During closure
 * construction, the compiler generates a synthetic “closure struct” containing
 * all captured variables. This struct is passed as the first hidden argument to
 * the lambda, and every reference to a captured variable inside the lambda body
 * is rewritten as a closure-field access.
 *
 * Fields inside a closure are indexed rather than named. The index determines
 * the position of the captured variable in the generated closure struct. The
 * textual name is preserved only for debugging, diagnostics, and error
 * reporting.

 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::generator::value::operator::fields::closure
 * @File: ymirc/semantic/generator/value/operator/fields/closure.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-03-02
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in closure;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;
use ymirc::semantic::generator::type;

/**
 * Represents access to a captured variable inside a closure.
 *
 * ClosureFieldAccessValue models the operation that retrieves a captured
 * variable from the closure struct generated for a lambda. The access is
 * performed by index, not by name, since closure fields are stored in a fixed
 * positional layout. The `name` is retained only for debugging and error
 * messages.
 *
 * The operator stores:
 *   - `object`: the closure struct instance,
 *   - `field`:  the index of the captured variable,
 *   - `name`:   the original variable name(debug only),
 *   - `isByRef`: true when the captured variable is stored by reference.
 *
 * The result is an lvalue when the captured variable is stored by reference.
 */
@final
pub class ClosureFieldAccessValue over FieldOperatorValue {

    pub {
        /** Index of the captured variable inside the closure struct. */
        let field: usize;

        /** Original name of the captured variable(debugging only). */
        let name: [c8];

        /** True when the captured variable is stored and accessed by reference. */
        let isByRef: bool;
    }

    /**
     * Construct a closure-field access operator value.
     *
     * @params:
     *   - loc:       source location of the access
     *   - type:      result type of the captured variable
     *   - object:    the closure struct operand
     *   - field:     index of the captured variable
     *   - name:      original variable name(debug only)
     *   - isByRef:   true when the variable is captured by reference
     *   - isReduced: true iff the operator has been reduced
     *
     * The operator inherits throwers from the closure operand.
     */

    pub self (loc:       &Word,
              type:      &Type,
              object:    &Value,
              field:     usize,
              name:      [c8],
              isByRef:   bool,
              isReduced: bool = false)

        with super (loc,
                    type,
                    object,
                    isReduced-> isReduced,
                    isLvalue-> true)

        , field = field
        , name = name
        , isByRef = isByRef

    {}

    /**
     * Return the closure struct operand.
     */
    @field
    pub fn closure(self)-> &Value {
        self.object
    }

    /**
     * Create an exact copy of the closure-field access operator, recursively
     * cloning the closure operand.
     */
    pub over clone(self)-> &Value {
        return copy ClosureFieldAccessValue(self.loc,
                                             self.type,
                                             self.object.clone(),
                                             self.field,
                                             self.name,
                                             isByRef-> self.isByRef,
                                             isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {
        /**
         * Format the closure-field access.
         *
         * When the field is captured by reference, it is displayed as:
         *     *(<name>)
         *
         * Otherwise, it is displayed simply as:
         *     <name>
         */
        pub over format(self, dmut stream: &Formatter) {
            if self.isByRef {
                stream:.write("*(", self.name, ")");
            } else {
                stream:.write(self.name);
            }
        }
    }

}
