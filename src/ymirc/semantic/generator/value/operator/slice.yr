in slice;

use ymirc::lexing::{word, keys};

use ymirc::semantic::generator::type;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub mod ::append;
pub mod ::arrayaccess;
pub mod ::concat;
pub mod ::sliceaccess;
pub mod ::slicecompare;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          ANCESTOR          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * Abstract base class for all slice and array operator values.
 *
 * SliceOrArrayOperatorValue represents the result of applying an operator to a
 * slice or array. Concrete subclasses implement specific operations such as
 * concatenation, appending, comparison, slicing, and indexed access.
 * 
 */
@abstract
pub class SliceOrArrayOperatorValue over OperatorValue {

    /**
     * Construct a slice or array operator value.
     *
     * @params:
     *   - loc:       source location of the operator expression
     *   - type:      result type of the operator
     *   - isReduced: true iff the operator has been reduced
     *   - throwers:  the list of throwers associated with the operator
     *   - isLvalue:  true iff the operator can be used as a lvalue
     */
    pub self (loc:       &Word,
              type:      &Type,
              isReduced: bool,              
              throwers:  [Throwers],
              isLvalue:  bool = false)
        
        with super (loc, type,
                    isReduced-> isReduced,
                    isLvalue-> isLvalue,
                    throwers-> throwers)
    {}

    @field
    pub over isFullLiteral (self)-> bool {
        false
    }
}
