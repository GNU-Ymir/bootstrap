/*
 * Declares the SpecialMathFloatOperatorValue class.
 *
 * SpecialMathFloatOperatorValue represents floating-point arithmetic operations
 * that cannot be implemented as a single machine instruction and therefore
 * require a runtime function call. These include operators such as:
 *
 *   - `fmod` (floating-point remainder),
 *   - `pow` (exponentiation),
 *   - `exp`, `log`, `sqrt`, etc.,
 *   - any extended-precision or transcendental operation implemented through
 *     helper routines.
 *
 * Because the result depends on a runtime call, these operators are never
 * considered full literals.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::generator::value::operator::binary::float_::special
 * @File: ymirc/semantic/generator/value/operator/binary/float_/special.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2022-01-17
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in special;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;
use ymirc::semantic::generator::type;


/**
 * Represents a special floating-point arithmetic operator implemented via a
 * runtime call.
 *
 * SpecialMathFloatOperatorValue models expressions such as:
 *
 *     fmod(x, y)
 *     sqrt(x)
 *     exp(x)
 *
 * or any other floating-point operator whose semantics require a helper
 * function rather than direct arithmetic. The operator stores:
 *
 *   - `op`:    the operator symbol,
 *   - `left`:  the left floating-point operand,
 *   - `right`: the right floating-point operand,
 *   - `call`:  the runtime function implementing the operation.
 *
 * The operator is never a full literal because its result depends on runtime
 * evaluation.
 */
@final
pub class SpecialMathFloatOperatorValue over BinaryOperatorValue {

    pub {
        /** Runtime call implementing the special floating-point operation. */
        let call: &Value;
    }

    /**
     * Construct a special floating-point arithmetic operator value.
     *
     * @params:
     *   - loc:       source location of the operator
     *   - type:      result floating-point type
     *   - op:        the special arithmetic operator
     *   - left:      left floating-point operand
     *   - right:     right floating-point operand
     *   - call:      runtime call implementing the operator
     *   - isReduced: true iff the operator has been reduced
     *
     * Throwers are inherited from both operands and from the runtime call.
     */

    pub self (loc:       &Word,
              type:      &Type,
              op:        BinaryOperators,
              left:      &Value,
              right:     &Value,
              call:      &Value,
              isReduced: bool = false)

        with super (loc,
                    type,
                    op,
                    left,
                    right,
                    isReduced-> isReduced)

        , call = call

    {}

    /**
     * @returns false
     * */
    @field
    pub over isFullLiteral (self)-> bool {
        false
    }

    /**
     * Create an exact copy of the operator, recursively cloning both operands
     * and the runtime call.
     */
    pub over clone (self)-> &Value {
        return copy SpecialMathFloatOperatorValue (self.loc,
                                                   self.type,
                                                   self.op,
                                                   self.left.clone (),
                                                   self.right.clone (),
                                                   self.call.clone (),
                                                   isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator} {

        /**
         * Equality comparison for special floating-point operators.
         *
         * Two SpecialMathFloatOperatorValue instances are equal when they are
         * both of this type and their base BinaryOperatorValue fields match.
         */
        pub over opEquals (self, o: &Generator)-> bool {
            if let s: &SpecialMathFloatOperatorValue = o {
                return self.super.opEquals (o);
            }

            return false;
        }
    }

    impl Streamable;
    impl Formattable {

        /**
         * Format the underlying runtime call.
         */
        pub over format (self, dmut stream: &Formatter) {
            stream:.write (self.call);
        }
    }
}
