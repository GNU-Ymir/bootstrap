in math;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;
use ymirc::semantic::generator::type;


/**
 * Represents a binary arithmetic operator applied to two floating-point values.
 *
 * MathFloatOperatorValue models expressions such as:
 *
 *     x + y
 *     x - y
 *     x * y
 *     x / y
 *
 * The operator stores:
 *   - `op`:    the arithmetic operator,
 *   - `left`:  the left floating-point operand,
 *   - `right`: the right floating-point operand.
 *
 * The result type is the floating-point type provided at construction.
 */
@final
pub class MathFloatOperatorValue over BinaryOperatorValue {

    /**
     * Construct a floating‑point arithmetic operator value.
     *
     * @params:
     *   - loc:       source location of the operator
     *   - type:      result floating‑point type
     *   - op:        the arithmetic operator
     *   - left:      left floating‑point operand
     *   - right:     right floating‑point operand
     *   - isReduced: true iff the operator has been reduced
     *
     * Throwers are inherited from both operands.
     */
    pub self (loc:       &Word,
              type:      &Type,
              op:        BinaryOperators,
              left:      &Value,
              right:     &Value,
              isReduced: bool = false)
        
        with super (loc,
                    type,
                    op,
                    left,
                    right,
                    isReduced-> isReduced)
        
    {}

    /**
     * Create an exact copy of the operator, recursively cloning both operands.
     */
    pub over clone (self)-> &Value {
        return copy MathFloatOperatorValue (self.loc,
                                            self.type,
                                            self.op,
                                            self.left.clone (),
                                            self.right.clone (),
                                            isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};
    impl Streamable;
}
