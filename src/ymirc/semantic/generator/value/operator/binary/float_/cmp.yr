in cmp;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;
use ymirc::semantic::generator::type;


/**
 * Represents a comparison operator applied to two floating-point values.
 *
 * CmpFloatOperatorValue models expressions such as:
 *
 *     x == y
 *     x < y
 *     x >= y
 *
 * The operator stores:
 *   - `op`:    the comparison operator,
 *   - `left`:  the left floating-point operand,
 *   - `right`: the right floating-point operand.
 *
 * The result type is always boolean.  
 * Throwers are inherited from both operands.
 */
@final
pub class CmpFloatOperatorValue over BinaryOperatorValue {

    /**
     * Construct a floating‑point comparison operator value.
     *
     * @params:
     *   - loc:       source location of the comparison
     *   - op:        the comparison operator
     *   - left:      left floating‑point operand
     *   - right:     right floating‑point operand
     *   - isReduced: true iff the operator has been reduced
     *
     * The result type is always `bool`.
     */
    pub self (loc:       &Word,
              op:        BinaryOperators,
              left:      &Value,
              right:     &Value,
              isReduced: bool = false)
        
        with super (loc,
                    copy BoolType (loc),
                    op,
                    left,
                    right,
                    isReduced-> isReduced)
    {}

    /**
     * Create an exact copy of the operator, recursively cloning both operands.
     */
    pub over clone (self)-> &Value {
        return copy CmpFloatOperatorValue (self.loc,
                                           self.op,
                                           self.left.clone (),
                                           self.right.clone (),
                                           isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};
    impl Streamable;
}

