 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in class_;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::type;
use ymirc::semantic::generator::type::{temporary, native};

use ymirc::semantic::generator::value::literal;


/**
 * Represents a class-type comparison operator(`a of A`).
 *
 * CmpClassTypeOperatorValue models expressions where:
 *
 *   - `left` is a value of a class type,
 *   - `classRef` is a reference to a class type,
 *   - the operator checks whether the runtime type of `left` is compatible
 *     with `classRef`.
 *
 * The operator stores:
 *   - `op`:       the comparison operator(`of`),
 *   - `left`:     the class value being tested,
 *   - `classRef`: the class type reference.
 *
 * The result type is always boolean.
 */
pub class CmpClassTypeOperatorValue over BinaryOperatorValue {

    pub {
        /** Class type reference used for the comparison. */
        let classRef: &ClassRefType;
    }

    /**
     * Construct a class-type comparison operator value.
     *
     * @params:
     *   - loc:       source location of the operator
     *   - op:        the operator(`of`)
     *   - left:      class value being tested
     *   - classRef:  class type reference
     *   - isReduced: true iff the operator has been reduced
     *
     * The right operand of the underlying BinaryOperatorValue is `UNIT_VALUE`,
     * since the actual type operand is stored in `classRef`.
     */
    pub self (loc: &Word,
              op: BinaryOperators,
              left: &Value,
              classRef: &ClassRefType,
              isReduced: bool = false)

        with super (loc,
                    copy BoolType(loc, isMutable-> false),
                    op,
                    left,
                    UNIT_VALUE,
                    isReduced-> isReduced)

        , classRef = classRef
    {}

    /**
     * @returns false
     * */
    @field
    pub over isFullLiteral(self)-> bool {
        false
    }

    /**
     * Create an exact copy of the operator, recursively cloning the left operand.
     */
    pub over clone(self)-> &Value {
        return copy CmpClassTypeOperatorValue(self.loc,
                                              self.op,
                                              self.left.clone(),
                                              self.classRef,
                                              isReduced-> self.isReduced);

    }

    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /**
         * Format the operator as:
         *    `(left op classRef)`
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write('(', self.left);
            stream:.write(' ', self.op, ' ');
            stream:.write(self.classRef, ')');
        }
    }
}
