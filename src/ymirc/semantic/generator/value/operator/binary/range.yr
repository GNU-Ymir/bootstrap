 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in range;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::type::native;
use ymirc::semantic::generator::type;


/**
 * Represents the containment operator for ranges.
 *
 * RangeContainsValue models expressions such as:
 *
 *     x in r
 *
 * where `r` is a range and `x` is a value whose type is compatible with the
 * range’s element type. The operator stores:
 *
 *   - `left`:  the value being tested for membership,
 *   - `right`: the range being queried,
 *   - `call`:  the runtime function used to evaluate containment.
 *
 * The operator delegates the actual containment logic to the runtime call,
 * since range membership cannot be resolved statically in general.
 */
@final
pub class RangeContainsValue over BinaryOperatorValue {

    pub {
        /** Runtime call used to evaluate the containment test. */
        let call: &Value;
    }

    /**
     * Construct a range-containment operator value.
     *
     * @params:
     *   - loc:       source location of the operator
     *   - type:      result type of the containment test(typically `bool`)
     *   - op:        the binary operator(should be the containment operator)
     *   - left:      value being tested for membership
     *   - right:     range operand
     *   - call:      runtime call implementing the containment logic
     *   - isReduced: true iff the operator has been reduced
     *
     * The operator inherits throwers from both operands and from the runtime
     * call.
     */
    pub self (loc:       &Word,
              type:      &Type,
              op:        BinaryOperators,
              left:      &Value,
              right:     &Value,
              call:      &Value,
              isReduced: bool = false)

        with super (loc,
                    type,
                    op,
                    left,
                    right,
                    isReduced-> isReduced)

        , call = call
    {}

    /**
     * Create an exact copy of the containment operator, recursively cloning
     * both operands and the runtime call.
     */
    pub over clone(self)-> &Value {
        return copy RangeContainsValue(self.loc,
                                        self.type,
                                        self.op,
                                        self.left.clone(),
                                        self.right.clone(),
                                        self.call.clone(),
                                        isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator} {

        /**
         * Equality comparison for containment operators.
         *
         * Two RangeContainsValue instances are equal when they are both
         * RangeContainsValue and their base BinaryOperatorValue fields match.
         */
        pub over opEquals(self, o: &Generator)-> bool {
            if o of RangeContainsValue {
                return self.super.opEquals(o);
            }

            return false;
        }
    }

    impl Streamable;
}
