in cmp;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;
use ymirc::semantic::generator::type::_;


/**
 * Represents a comparison operator applied to two character values.
 *
 * CmpCharOperatorValue models expressions such as:
 *
 *     c1 == c2
 *     c1 <  c2
 *     c1 >= c2
 *
 * The operator stores:
 *   - `op`:    the comparison operator,
 *   - `left`:  the left character operand,
 *   - `right`: the right character operand.
 *
 * The result type is always boolean.
 * Throwers are inherited from both operands.
 */
@final
pub class CmpCharOperatorValue over BinaryOperatorValue {

    /**
     * Construct a character-comparison operator value.
     *
     * @params:
     *   - loc:       source location of the comparison
     *   - op:        the comparison operator
     *   - left:      left character operand
     *   - right:     right character operand
     *   - isReduced: true iff the operator has been reduced
     *
     * The result type is always `bool`.
     */
    pub self (loc:       &Word,
              op:        BinaryOperators,
              left:      &Value,
              right:     &Value,
              isReduced: bool = false)

        with super (loc,
                    copy BoolType(loc, isMutable-> false),
                    op,
                    left,
                    right,
                    isReduced-> isReduced)
    {}

    /**
     * Create an exact copy of the operator, recursively cloning both operands.
     */
    pub over clone(self)-> &Value {
        return copy CmpCharOperatorValue(self.loc,
                                          self.op,
                                          self.left.clone(),
                                          self.right.clone(),
                                          isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};
    impl Streamable;
}
