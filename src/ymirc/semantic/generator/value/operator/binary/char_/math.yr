in math;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;
use ymirc::semantic::generator::type;

/**
 * Represents a binary arithmetic-like operator applied to character values.
 *
 * MathCharOperatorValue models expressions such as:
 *
 *     c + n
 *     c - n
 *     c1 - c2
 *
 * depending on the operator and the result type. These operations treat
 * characters as code points and apply integer arithmetic rules to them.
 *
 * The operator stores:
 *   - `op`:    the arithmetic operator,
 *   - `left`:  the left character operand,
 *   - `right`: the right operand (character or integer),
 *   - `type`:  the resulting type (char or int).
 *
 * Throwers are inherited from both operands.
 */
@final
pub class MathCharOperatorValue over BinaryOperatorValue {

    /**
     * Construct a character-arithmetic operator value.
     *
     * @params:
     *   - loc:       source location of the operator
     *   - type:      result type of the operation
     *   - op:        the arithmetic operator
     *   - left:      left character operand
     *   - right:     right operand (char or int)
     *   - isReduced: true iff the operator has been reduced
     */
    pub self (loc:       &Word,
              type:      &Type,
              op:        BinaryOperators,
              left:      &Value,
              right:     &Value,
              isReduced: bool = false)

        with super (loc,
                    type,
                    op,
                    left,
                    right,
                    isReduced-> isReduced)
    {}

    /**
     * Create an exact copy of the operator, recursively cloning both operands.
     */
    pub over clone (self)-> &Value {
        return copy MathCharOperatorValue (self.loc,
                                           self.type,
                                           self.op,
                                           self.left.clone (),
                                           self.right.clone (),
                                           isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};
    impl Streamable;
}
