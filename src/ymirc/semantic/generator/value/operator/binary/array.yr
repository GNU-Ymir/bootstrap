 */


in array;

use ymirc::lexing::{word, keys};
use ymirc::utils::format;
use std::stream;

use ymirc::semantic::generator::type::native;
use ymirc::semantic::generator::type;

/**
 * Represents a binary array operator whose evaluation is performed through
 * a function call rather than direct operator semantics.
 *
 * SpecialArrayOperatorValue is used when:
 *   - at least one operand is an array,
 *   - the operator requires a user-defined or intrinsic function such as
 *     `opEquals`, `opCmp`, or other array-specific overloads, 
 *
 * The class stores:
 *   - the operator kind (`op`),
 *   - the left and right operands,
 *   - the resolved function call (`call`) that implements the operator,
 *   - the resulting static type.
 *
 * Semantic notes:
 *   - This value is never a full literal, as its evaluation depends on a
 *     function call.
 */
@final
pub class SpecialArrayOperatorValue over BinaryOperatorValue {

    pub {
        // the function call implementing the operator.
        let call: &Value;
    }
    
    /**
     * Creates a special array operator value.
     *
     * Parameters:
     *   - loc:       the source location of the operator.
     *   - type:      the resulting static type of the operator expression.
     *   - op:        the binary operator being applied.
     *   - left:      the left operand.
     *   - right:     the right operand.
     *   - call:      the function call implementing the operator.
     *   - isReduced: whether the operator value is already reduced.
     *
     * The constructor assumes that the operator has already been resolved to
     * a valid function call and does not perform additional semantic checks.
     */    
    pub self (loc:       &Word,
              type:      &Type,
              op:        BinaryOperators,
              left:      &Value,
              right:     &Value,
              call:      &Value,
              isReduced: bool = false)
        
        with super (loc, type, op, left, right, isReduced-> isReduced)
        , call = call
    {}

    /**
     * Special array operators are never full literals.
     *
     * Their evaluation always depends on a function call, which prevents them
     * from being considered compile-time literal values.
     */
    @field
    pub over isFullLiteral (self)-> bool {
        false
    }

    /**
     * Create an exact copy of the value with a different uniqId
     * */

    /**
     * Creates a deep clone of the operator value.
     *
     */
    pub over clone (self)-> &Value {
        return copy SpecialArrayOperatorValue (self.loc,
                                               self.type,
                                               self.op,
                                               self.left.clone (),
                                               self.right.clone (),
                                               self.call.clone (),
                                               isReduced-> self.isReduced);
    }

    impl Streamable;
    impl Formattable {

        /**
         * Formats the operator value for debugging or pretty-printing.
         *
         * The formatting delegates to the underlying `call`, which is
         * typically the function call implementing the operator. This ensures
         * that the printed representation reflects the actual evaluation path.
         */
        pub over format (self, dmut stream: &Formatter) {
            stream:.write (self.call);
        }
    }
}
