 */
 
    
in math;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;
use ymirc::semantic::generator::type::native;


/**
 * Represents a pointer-arithmetic binary operator.
 *
 * MathPointerOperatorValue models expressions such as:
 *
 *     ptr + offset
 *     ptr - offset
 *     ptrA - ptrB
 *
 * depending on the operator and operand types. The operator stores:
 *
 *   - `op`:    the arithmetic operator,
 *   - `left`:  the pointer operand,
 *   - `right`: the integer or pointer operand.
 *
 * The result type is determined by the semantic rules of pointer arithmetic.
 */
@final
pub class MathPointerOperatorValue over BinaryOperatorValue {

    /**
     * Construct a pointer-arithmetic operator value.
     *
     * @params:
     *   - loc:       source location of the operator
     *   - type:      result type of the pointer arithmetic
     *   - op:        the arithmetic operator
     *   - left:      pointer operand
     *   - right:     integer or pointer operand
     *   - isReduced: true iff the operator has been reduced
     *
     * The operator inherits throwers from both operands.
     */
    pub self (loc: &Word,
              type: &Type,
              op: BinaryOperators,
              left: &Value,
              right: &Value,
              isReduced: bool = false)
        
        with super (loc,
                    type,
                    op,
                    left,
                    right,
                    isReduced-> isReduced)        
    {}

    /**
     * Create an exact copy of the operator, recursively cloning both operands.
     */
    pub over clone (self)-> &Value {
        return copy BinaryMathPointerOperatorValue (self.loc,
                                                    self.type,
                                                    self.op,
                                                    self.left.clone (),
                                                    self.right.clone (),
                                                    isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};
    impl Streamable;
    
}
