in logic;

use ymirc::lexing::word;
use ymirc::utils::{format, comparison};
use std::stream;
use ymirc::semantic::generator::type::native;


/**
 * Represents a binary logical operator applied to two boolean values.
 *
 * LogicalBoolOperatorValue models expressions such as:
 *
 *     a && b
 *     a || b
 *
 * The operator stores:
 *   - `op`:    the logical operator,
 *   - `left`:  the left boolean operand,
 *   - `right`: the right boolean operand.
 *
 * The result type is always boolean.  
 * Throwers are inherited from both operands.
 */
@final
pub class LogicalBoolOperatorValue over BinaryOperatorValue {

    /**
     * Construct a boolean-logical operator value.
     *
     * @params:
     *   - loc:       source location of the operator
     *   - op:        the logical operator
     *   - left:      left boolean operand
     *   - right:     right boolean operand
     *   - isReduced: true iff the operator has been reduced
     *
     * The result type is always `bool`.
     */
    pub self (loc:       &Word,
              op:        BinaryOperators,
              left:      &Value,
              right:     &Value,
              isReduced: bool = false)
        
        with super (loc,
                    copy BoolType (loc),
                    op,
                    left,
                    right,
                    isReduced-> isReduced)
        
    {}

    /**
     * Create an exact copy of the operator, recursively cloning both operands.
     */    
    pub over clone (self)-> &Value {
        return copy LogicalBoolOperatorValue (self.loc,
                                              self.op,
                                              self.left.clone (),
                                              self.right.clone (),
                                              isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};
    impl Streamable;    
}
