in cmp;

use ymirc::lexing::word;
use ymirc::utils::{format, comparison};
use std::stream;
use ymirc::semantic::generator::type::native;

/**
 * Represents a comparison operator applied to two boolean values.
 *
 * CmpBoolOperatorValue models expressions such as:
 *
 *     a == b
 *     a != b
 *
 * The operator stores:
 *   - `op`:    the comparison operator,
 *   - `left`:  the left boolean operand,
 *   - `right`: the right boolean operand.
 *
 * The result type is always boolean.
 */
@final
pub class CmpBoolOperatorValue over BinaryOperatorValue {

    /**
     * Construct a boolean-comparison operator value.
     *
     * @params:
     *   - loc:       source location of the comparison
     *   - op:        the comparison operator
     *   - left:      left boolean operand
     *   - right:     right boolean operand
     *   - isReduced: true iff the operator has been reduced
     *
     * The result type is always `bool`.
     */
    pub self (loc:       &Word,
              op:        BinaryOperators,
              left:      &Value,
              right:     &Value,
              isReduced: bool = false)
        
        with super (loc,
                    copy BoolType (loc),
                    op,
                    left,
                    right,
                    isReduced-> isReduced)
        
    {}

    /**
     * Create an exact copy of the operator, recursively cloning both operands.
     */
    pub over clone (self)-> &Value {
        return copy CmpBoolOperatorValue (self.loc,
                                          self.op,
                                          self.left.clone (),
                                          self.right.clone (),
                                          isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};
    impl Streamable;    
}
