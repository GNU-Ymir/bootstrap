 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in special;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;
use ymirc::semantic::generator::type;

/**
 * Represents a special integer arithmetic operator implemented via a runtime call.
 *
 * SpecialMathIntOperatorValue models expressions such as:
 *
 *     a ^^ b
 *
 * or any other integer operator whose semantics require a helper function
 * rather than direct arithmetic. The operator stores:
 *
 *   - `op`:    the operator symbol,
 *   - `left`:  the left integer operand,
 *   - `right`: the right integer operand,
 *   - `call`:  the runtime function implementing the operation.
 *
 * The operator is never a full literal because its result depends on runtime
 * evaluation.
 */
@final
pub class SpecialMathIntOperatorValue over BinaryOperatorValue {

    pub {
        /** Runtime call implementing the special arithmetic operation. */
        let call: &Value;
    }

    /**
     * Construct a special integer‑arithmetic operator value.
     *
     * @params:
     *   - loc:       source location of the operator
     *   - type:      result integer type
     *   - op:        the special arithmetic operator
     *   - left:      left integer operand
     *   - right:     right integer operand
     *   - call:      runtime call implementing the operator
     *   - isReduced: true iff the operator has been reduced
     *
     * Throwers are inherited from both operands and from the runtime call.
     */
    pub self (loc:       &Word,
              type:      &Type,
              op:        BinaryOperators,
              left:      &Value,
              right:     &Value,
              call:      &Value,
              isReduced: bool = false)

        with super (loc,
                    type,
                    op,
                    left,
                    right,
                    isReduced-> isReduced)

        , call = call
    {}

    /**
     * @returns false
     * */
    @field
    pub over isFullLiteral (self)-> bool {
        false
    }

    /**
     * Create an exact copy of the operator, recursively cloning both operands
     * and the runtime call.
     */
    pub over clone (self)-> &Value {
        return copy SpecialMathIntOperatorValue (self._loc,
                                                 self.type,
                                                 self.op,
                                                 self.left.clone (),
                                                 self.right.clone (),
                                                 self.call.clone (),
                                                 isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator} {

        /**
         * Equality comparison for special integer operators.
         *
         * Two SpecialMathIntOperatorValue instances are equal when they are
         * both of this type and their base BinaryOperatorValue fields match.
         */
        pub over opEquals (self, o: &Generator)-> bool {
            if let s: &SpecialMathIntOperatorValue = o {
                return self.super.opEquals (o);
            }

            return false;
        }
    }

    impl Streamable;
}
