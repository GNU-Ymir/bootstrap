in cmp;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;
use ymirc::semantic::generator::type::_;

/**
 * Represents a comparison operator applied to two integer values.
 *
 * CmpIntOperatorValue models expressions such as:
 *
 *     a == b
 *     a < b
 *     a >= b
 *
 * The operator stores:
 *   - `op`:    the comparison operator,
 *   - `left`:  the left integer operand,
 *   - `right`: the right integer operand.
 *
 * The result type is always boolean.
 * Throwers are inherited from both operands.
 */
@final
pub class CmpIntOperatorValue over BinaryOperatorValue {

    /**
     * Construct an integer-comparison operator value.
     *
     * @params:
     *   - loc:       source location of the comparison
     *   - op:        the comparison operator
     *   - left:      left integer operand
     *   - right:     right integer operand
     *   - isReduced: true iff the operator has been reduced
     *
     * The result type is always `bool`.
     */
    pub self (loc: &Word,
              op: BinaryOperators,
              left: &Value,
              right: &Value,
              isReduced: bool = false)

        with super (loc,
                    copy BoolType(loc, isMutable-> false),
                    op,
                    left,
                    right,
                    isReduced-> isReduced)
    {}

    /**
     * Create an exact copy of the operator, recursively cloning both operands.
     */
    pub over clone(self)-> &Value {
        return copy CmpIntOperatorValue(self.loc,
                                         self.op,
                                         self.left.clone(),
                                         self.right.clone(),
                                         isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};
    impl Streamable;
}
