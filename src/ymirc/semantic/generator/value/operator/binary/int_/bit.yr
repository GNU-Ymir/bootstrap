 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in bit;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::type;

/**
 * Represents a binary bitwise operator applied to two integer values.
 *
 * BitwiseIntOperatorValue models expressions such as:
 *
 *     a & b
 *     a | b
 *     a ^ b
 *     a << b
 *     a >> b
 *
 * The operator stores:
 *   - `op`:    the bitwise operator,
 *   - `left`:  the left integer operand,
 *   - `right`: the right integer operand.
 *
 * The result type is the integer type provided at construction.
 */
@final
pub class BitwiseIntOperatorValue over BinaryOperatorValue {

    /**
     * Construct a bitwise-integer operator value.
     *
     * @params:
     *   - loc:       source location of the operator
     *   - type:      result integer type
     *   - op:        the bitwise operator
     *   - left:      left integer operand
     *   - right:     right integer operand
     *   - isReduced: true iff the operator has been reduced
     *
     * Throwers are inherited from both operands.
     */
    pub self (loc:       &Word,
              type:      &Type,
              op:        BinaryOperators,
              left:      &Value,
              right:     &Value,
              isReduced: bool = false)

        with super (loc,
                    type,
                    op,
                    left,
                    right,
                    isReduced-> isReduced)
    {}

    /**
     * Create an exact copy of the operator, recursively cloning both operands.
     */
    pub over clone(self)-> &Value {
        return copy BitwiseIntOperatorValue(self.loc,
                                             self.type,
                                             self.op,
                                             self.left.clone(),
                                             self.right.clone(),
                                             isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};
    impl Streamable;
}
