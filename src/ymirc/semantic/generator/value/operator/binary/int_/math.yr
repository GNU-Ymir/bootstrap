in math;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::type;

/**
 * Represents a binary arithmetic operator applied to two integer values.
 *
 * MathIntOperatorValue models expressions such as:
 *
 *     a + b
 *     a - b
 *     a * b
 *     a / b
 *     a % b
 *
 * The operator stores:
 *   - `op`:    the arithmetic operator,
 *   - `left`:  the left integer operand,
 *   - `right`: the right integer operand.
 *
 * The result type is the integer type provided at construction.
 */
@final
pub class MathIntOperatorValue over BinaryOperatorValue {

    /**
     * Construct an integer-arithmetic operator value.
     *
     * @params:
     *   - loc:       source location of the operator
     *   - type:      result integer type
     *   - operator:  the arithmetic operator
     *   - left:      left integer operand
     *   - right:     right integer operand
     *   - isReduced: true iff the operator has been reduced
     *
     * Throwers are inherited from both operands.
     */
    pub self (loc:       &Word,
              type:      &Type,
              operator:  BinaryOperators,
              left:      &Value,
              right:     &Value,
              isReduced: bool = false)
        
        with super (loc,
                    type,
                    op,
                    left,
                    right,
                    isReduced-> isReduced)
        
    {}

    /**
     * Create an exact copy of the operator, recursively cloning both operands.
     */
    pub over clone (self)-> &Value {
        return copy MathIntOperatorValue (self.loc,
                                          self.type,
                                          self.op,
                                          self.left.clone (),
                                          self.right.clone (),
                                          isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};
    impl Streamable;
}
