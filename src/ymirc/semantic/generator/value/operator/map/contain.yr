/*
 * Declares the MapContainsValue class.
 *
 * MapContainsValue represents a containment check on a map. It evaluates whether
 * a given key is present in a map, producing a boolean result. The operator
 * supports both forms:
 *
 *     key in map
 *     key !in map
 *
 * The semantics of containment follow the rules defined by the map type.
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::semantic::generator::value::operator::map::contain
 * @File: ymirc/semantic/generator/value/operator/map/contain.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2024-11-15
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in contain;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::type;


/**
 * Represents a containment check on a map value.
 *
 * MapContainsValue models the operations:
 *
 *     key in map
 *     key !in map
 *
 * where `key` is the lookup key and `map` is the map being queried. The result
 * is a boolean indicating whether the key is present. The `isNot` flag
 * distinguishes between the positive (`in`) and negative (`!in`) forms.
 *
 * The operator stores:
 *   - `map`:   the map operand being queried,
 *   - `key`:   the key being tested for presence,
 *   - `isNot`: true when the operator represents `!in`.
 *
 * A containment check is a full literal only when both operands are full
 * literals.
 */
@final
pub class MapContainsValue over MapOperatorValue {

    pub {
        /** The map being queried for key containment. */
        let map: &Value;

        /** The key being tested for presence in the map. */        
        let key: &Value;
        
        /** True when the operator represents `!in` instead of `in`. */        
        let isNot: bool;
    }

    /**
     * Construct a map containment operator value.
     *
     * @params:
     *   - loc:       source location of the containment expression
     *   - type:      result type of the operation (always `bool`)
     *   - map:       the map operand
     *   - key:       the key operand
     *   - isNot:     true for `!in`, false for `in`
     *   - isReduced: true iff the operator has been reduced
     *
     * The operator inherits throwers from both operands. The result is never an
     * lvalue.
     */
    pub self (loc:       &Word,
              type:      &Type,
              map:       &Value,
              key:       &Value,
              isNot:     bool,
              isReduced: bool = false)
        
        with super (loc, type, isReduced-> isReduced, isLvalue-> false, throwers-> (map.throwers ~ key.throwers))
        , map = map
        , key = key
        , isNot = isNot
    {}

    /**
     * A containment check is a full literal only when both the map and the key
     * are full literals.
     */
    @field
    pub over isFullLiteral (self)-> bool {
        if (!self.map.isFullLiteral) return false;
        if (!self.key.isFullLiteral) return false;

        true
    }

    /**
     * Create an exact copy of the containment operator, recursively cloning
     * both operands.
     */
    pub over clone (self)-> &Value {
        return copy MapContainsValue (self.loc,
                                     self.type,
                                     self.map.clone (),
                                     self.key.clone (),
                                     not-> self.not,
                                     isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};
    
    impl Streamable;
    impl Formattable {

        /**
         * Format the containment check as:
         *
         *     <key> in <map>
         * or:
         *     <key> !in <map>
         */
        pub over format (self, dmut stream: &Formatter) {
            stream:.write (self.key);
            if (self.isNot) {
                stream:.write (' ', BinaryOperators::NOT_IN, ' ');
            } else {
                stream:.write (' ', BinaryOperators::IN, ' ');
            }
            stream:.write (self.map);
        }
    }

}
