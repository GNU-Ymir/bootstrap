 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in key;

use ymirc::lexing::{word, keys};
use ymirc::utils::format;
use std::stream;

use ymirc::semantic::generator::type;

/**
 * Retrieves the key from the current position of a map iterator.
 *
 * MapIteratorKeyAccessValue models the operation:
 *
 *     #_key(iterator)
 *
 * which returns the key associated with the entry the iterator currently points
 * to. The operator does not modify the iterator or the map; it is a pure read
 * operation.
 *
 * The operator stores:
 *   - `iter`: the iterator from which the key is retrieved.
 *
 * Retrieving a key never qualifies as a full literal.
 */
@final
pub class MapIteratorKeyAccessValue over MapIteratorValue {

    pub {
        /** The iterator from which the key is retrieved. */
        let iter: &Value;
    }

    /**
     * Construct a key-retrieval operator value.
     *
     * @params:
     *   - loc:       source location of the key-retrieval expression
     *   - type:      the type of the key returned by the iterator
     *   - iter:      the iterator operand
     *   - isReduced: true iff the operator has been reduced
     *
     * The operator inherits throwers from the iterator operand.
     */
    pub self (loc:       &Word,
              type:      &Type,
              iter:      &Value,
              isReduced: bool = false)

        with super (loc,
                    type,
                    isReduced-> isReduced,
                    throwers-> iter.throwers)
        , iter = iter
    {}


    /**
     * Create an exact copy of the key-retrieval operator, recursively cloning
     * the iterator operand.
     */
    pub over clone(self)-> &Value {
        return copy MapIteratorKeyAccessValue(self.loc,
                                               self.type,
                                               self.iter.clone(),
                                               isReduced-> self.isReduced);
    }


    impl Streamable;
    impl Formattable {

        /**
         * Format the key-retrieval operation as:
         *
         *     #_key(<iter>)
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write("#_key(", self.iter, ")");
        }
    }

}
