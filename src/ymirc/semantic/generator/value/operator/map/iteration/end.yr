 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in end;

use ymirc::lexing::{word, keys};
use ymirc::utils::format;
use std::stream;

use ymirc::semantic::generator::{type, type::native};

/**
 * Represents an end-of-iteration test on a map iterator.
 *
 * MapIteratorEndValue models the operation:
 *
 *     #_is_end(iterator)
 *
 * which evaluates to a boolean indicating whether the iterator has reached the
 * end of the map. The operator does not modify the iterator or the map; it is a
 * pure query operation.
 *
 * The operator stores:
 *   - `iter`: the iterator being tested.
 *
 * End-of-iteration checks never qualify as full literals.
 */
@final
pub class MapIteratorEndValue over MapIteratorValue {

    pub {
        /** The iterator being tested for end-of-iteration. */
        let iter: &Value;
    }

    /**
     * Construct an end-of-iteration test operator value.
     *
     * @params:
     *   - loc:       source location of the test expression
     *   - iter:      the iterator operand
     *   - isReduced: true iff the operator has been reduced
     *
     * The operator always has type `bool` and inherits throwers from the
     * iterator operand.
     */
    pub self (loc:       &Word,
              iter:      &Value,
              isReduced: bool = false)

        with super (loc,
                    copy BoolType(loc, isMutable-> false),
                    throwers-> iter.throwers,
                    isReduced-> isReduced)

        , iter = iter
    {}


    /**
     * Create an exact copy of the end-of-iteration operator, recursively
     * cloning the iterator operand.
     */
    pub over clone(self)-> &Value {
        return copy MapIteratorEndValue(self.loc,
                                         self.iter.clone(),
                                         isReduced-> self.isReduced);
    }


    impl Streamable;
    impl Formattable {

        /**
         * Format the end-of-iteration test as:
         *
         *     #_not_end(<iter>)
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write("#_not_end(", self.iter, ")");
        }
    }

}
