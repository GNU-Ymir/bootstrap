/*
 * Declares the MapIteratorNextValue class.
 *
 * MapIteratorNextValue represents the operation that advances a map iterator to
 * the next entry. The iterator must refer to a valid entry; advancing past the
 * end position results in an iterator that compares equal to the end iterator.
 *
 * This operator is used internally by map iteration constructs to move through
 * the map’s contents. It mutates the iterator but does not modify the map
 * itself.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::generator::value::operator::map::iteration::next
 * @File: ymirc/semantic/generator/value/operator/map/iteration/next.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2024-11-15
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in next;

use ymirc::lexing::{word, keys};
use ymirc::utils::format;
use std::stream;

use ymirc::semantic::generator::{type, type::native};

/**
 * Advances a map iterator to the next entry.
 *
 * MapIteratorNextValue models the operation:
 *
 *     #_next(iterator)
 *
 * which moves the iterator forward by one position. The iterator is mutated in
 * place, but the map itself is not modified. The operation has type `void`.
 *
 * The operator stores:
 *   - `iter`: the iterator being advanced.
 *
 * Advancing an iterator never qualifies as a full literal.
 */
@final
pub class MapIteratorNextValue over MapIteratorValue {

    pub {
        /** The iterator being advanced. */
        let iter: &Value;
    }

    /**
     * Construct an iterator-advance operator value.
     *
     * @params:
     *   - loc:       source location of the advance expression
     *   - iter:      the iterator operand
     *   - isReduced: true iff the operator has been reduced
     *
     * The operator always has type `void` and inherits throwers from the
     * iterator operand.
     */
    pub self (loc:       &Word,
              iter:      &Value,
              isReduced: bool = false)

        with super (loc,
                    copy VoidType(loc),
                    isReduced-> isReduced,
                    throwers-> iter.throwers)
        , iter = iter
    {}


    /**
     * Create an exact copy of the iterator-advance operator, recursively
     * cloning the iterator operand.
     */
    pub over clone(self)-> &Value {
        return copy MapIteratorNextValue(self.loc,
                                          self.iter.clone(),
                                          isReduced-> self.isReduced);
    }

    impl Streamable;
    impl Formattable {

        /**
         * Format the iterator-advance operation as:
         *
         *     #_next(<iter>)
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write("#_next(", self.iter, ")");
        }
    }

}
