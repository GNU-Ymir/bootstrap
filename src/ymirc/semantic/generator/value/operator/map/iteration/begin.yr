in begin;

use ymirc::lexing::{word, keys};
use ymirc::utils::format;

use ymirc::semantic::generator::type::{native, temporary};
use ymirc::semantic::generator::type;
use std::stream;

/**
 * Represents the creation of a map iterator positioned at the beginning.
 *
 * MapIteratorBeginValue models the operation that produces an iterator pointing
 * to the first entry of a map. The iterator is dynamically allocated and
 * remains valid even if entries are inserted or removed during iteration.
 *
 * The operator stores:
 *   - `map`: the map being iterated.
 *
 * Iterator creation never qualifies as a full literal.
 */
@final
pub class MapIteratorBeginValue over MapIteratorValue {

    pub {
        /** The map value being iterated. */
        let map: &Value;
    }

    /**
     * Construct a map-begin iterator operator value.
     *
     * @params:
     *   - loc:       source location of the iterator creation
     *   - type:      the iterator type produced by this operation
     *   - map:       the map operand
     *   - isReduced: true iff the operator has been reduced
     *
     * The operator inherits throwers from the map operand.
     */
    pub self (loc:       &Word,
              type:      &MapIteratorType,
              map:       &Value,
              isReduced: bool = false)

        with super (loc,
                    type,
                    isReduced-> isReduced,
                    throwers-> map.throwers)

        , map = map
    {}

    /**
     * Create an exact copy of the iterator-begin operator, recursively cloning
     * the map operand.
     */
    pub over clone(self)-> &Value {
        if let t: &MapIteratorType = self.type {
            return copy MapIteratorBeginValue(self.loc,
                                               t,
                                               self.map.clone(),
                                               isReduced-> self.isReduced);
        } else panic;
    }

    impl Streamable;
    impl Formattable {

        /**
         * Format the iterator creation as:
         *
         *     #_begin(<map>)
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write("#_begin(", self.map, ")");
        }
    }
}
