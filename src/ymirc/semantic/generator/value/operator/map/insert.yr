 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */



in insert;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};

use ymirc::semantic::generator::type;
use std::stream;

/**
 * Represents an insertion into a map.
 *
 * MapInsertValue models the operation:
 *
 *     map[key] = value
 *
 * where `map` is the map being modified, `key` is the lookup key, and `value`
 * is the value to be inserted or updated. The operation mutates the map and
 * therefore always has side effects.
 *
 * The operator stores:
 *   - `map`:   the map being modified,
 *   - `key`:   the key under which the value is inserted,
 *   - `value`: the value being inserted.
 *
 * Map insertions never qualify as full literals.
 */

@final
pub class MapInsertValue over MapOperatorValue {

    pub {
        /** The map being modified. */
        let map: &Value;

        /** The key under which the value is inserted. */
        let key: &Value;

        /** The value being inserted into the map. */
        let value: &Value;
    }

    /**
     * Construct a map insertion operator value.
     *
     * @params:
     *   - loc:       source location of the insertion expression
     *   - type:      result type of the operation(typically the map’s value type)
     *   - map:       the map operand
     *   - key:       the key operand
     *   - value:     the value operand
     *   - isReduced: true iff the operator has been reduced
     *
     * The operator inherits throwers from all operands. The result is never an
     * lvalue, as the insertion operation itself does not produce an assignable
     * value.
     */
    pub self (loc: &Word,
              type: &Type,
              map: &Value,
              key: &Value,
              value: &Value,
              isReduced: bool = false)

        with super (loc,
                    type,
                    isReduced-> isReduced,
                    isLvalue-> false,
                    throwers-> (map.throwers ~ key.throwers ~ value.throwers))

        , map = map
        , key = key
        , value = value
    {}

    /**
     * Map insertions always have side effects and therefore never produce
     * full literals.
     */
    @field
    pub over isFullLiteral(self)-> bool {
        false
    }


    /**
     * Create an exact copy of the map insertion operator, recursively cloning
     * all operands.
     */
    pub over clone(self)-> &Value {
        return copy MapInsertValue(self.loc,
                                    self.type,
                                    self.map.clone(),
                                    self.key.clone(),
                                    self.value.clone(),
                                    isReduced-> self._isReduced);
    }

    impl Comparable!{&Generator};
    impl Streamable;
    impl Formattable {

        /**
         * Format the map insertion as:
         *
         *     <map> [<key>] = <value>
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(self.map);
            stream:.write(" [");
            stream:.write(self.key);
            stream:.write("] = ");
            stream:.write(self.value);
        }
    }

}
