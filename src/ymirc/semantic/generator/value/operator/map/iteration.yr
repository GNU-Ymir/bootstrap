in iteration;


use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use ymirc::semantic::generator::type;

use std::stream;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub mod ::begin;
pub mod ::del;
pub mod ::end;
pub mod ::key;
pub mod ::next;
pub mod ::value;


/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          ANCESTOR          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * Abstract base class for all map iterator operator values.
 *
 * MapIteratorValue represents an operation that participates in iterating over
 * a map. Iterator operations do not directly manipulate map entries; instead,
 * they provide the mechanisms needed to traverse the map’s internal structure
 * safely, even when the map is modified during iteration.
 *
 * Iterator operations never qualify as full literals.
 */

@abstract
pub class MapIteratorValue over MapOperatorValue {

    /**
     * Construct a map iterator operator value.
     *
     * @params:
     *   - loc:       source location of the iterator expression
     *   - type:      result type of the iterator operation
     *   - isReduced: true iff the operator has been reduced
     */
    pub self (loc:       &Word,
              type:      &Type,
              throwers:  [Thrower],
              isReduced: bool = false)

        with super (loc, type, throwers-> throwers, isReduced-> isReduced)
    {}

    /**
     * Iterator operations never produce full literals.
     */
    @field
    pub over isFullLiteral(self)-> bool {
        false
    }

    impl Comparable!{&Generator} {

        /**
         * Iterator values are never considered equal at the semantic level.
         * This method always returns false.
         */
        pub over opEquals(self, _: &Generator)-> bool {
            false
        }
    }

}
