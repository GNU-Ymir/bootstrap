 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in access;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};

use std::stream;

use ymirc::semantic::generator::type;

/**
 * Represents a key access on a map value.
 *
 * MapAccessValue models the operation:
 *
 *     map[key]
 *
 * where `map` is a map value and `key` is an expression producing the lookup
 * key. The operator retrieves the value associated with the given key. The
 * result is an lvalue when the map itself is an lvalue, allowing assignment
 * through the access when the map type supports mutable entries.
 *
 * The operator stores:
 *   - `map`: the map operand being accessed,
 *   - `key`: the key expression used for lookup.
 *
 * Map accesses never qualify as full literals.
 */
@final
pub class MapAccessValue over MapOperatorValue {

    pub {
        /** The map operand being accessed. */
        let map: &Value;

        /** The key used to perform the lookup. */
        let key: &Value;
    }

    /**
     * Construct a map access operator value.
     *
     * @params:
     *   - loc:       source location of the access expression
     *   - type:      result type of the access(the map’s value type generally wrapped in an option)
     *   - map:       the map operand
     *   - key:       the key operand
     *   - isReduced: true iff the operator has been reduced
     *
     * The operator inherits throwers from both operands. The result is an
     * lvalue when the map operand is an lvalue.
     */
    pub self (loc:       &Word,
              type:      &Type,
              map:       &Value,
              key:       &Value,
              isReduced: bool = false)

        with super (loc,
                    type,
                    isReduced-> isReduced,
                    isLvalue-> map.isLvalue,
                    throwers-> (map.throwers ~ key.throwers))

        , map = map
        , key = key
    {}

    /**
     * Map accesses never produce full literals.
     */
    @field
    pub over isFullLiteral(self)-> bool {
        false
    }


    /**
     * Create an exact copy of the map access operator, recursively cloning both
     * operands.
     */
    pub over clone(self)-> &Value {
        return copy MapAccessValue(self.loc,
                                    self.type,
                                    self.map.clone(),
                                    self.key.clone(),
                                    isReduced-> self.isReduced);
    }


    impl Comparable!{&Generator};
    impl Streamable;
    impl Formattable {

        /**
         * Format the map access as:
         *
         *     <map> [<key>]
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(self.map);
            stream:.write(" [");
            stream:.write(self.key);
            stream:.write(']');
        }
    }

}
