in map;

use ymirc::lexing::{word, keys};
use ymirc::utils::format;

use ymirc::semantic::generator::type;

pub mod ::access;
pub mod ::contain;
pub mod ::insert;
pub mod ::iteration;

/**
 * Abstract base class for all map operator values.
 *
 * MapOperatorValue represents the result of applying an operator to a map
 * value. Concrete subclasses implement specific operations such as key access,
 * containment checks, insertion, and iteration.
 *
 * The operator inherits its throwers from the operands provided by subclasses.
 * 
 */
@abstract
pub class  MapOperatorValue over OperatorValue {
    
    /**
     * Construct a map operator value.
     *
     * @params:
     *   - loc:       source location of the operator expression
     *   - type:      result type of the operator
     *   - isReduced: true iff the operator has been reduced
     *   - throwers:  the list of throwers associated with the operator
     *   - isLvalue:  true iff the operator result is an lvalue
     *   
     */
    pub self (loc:       &Word,
              type:      &Type,
              isReduced: bool,
              throwers:  [Thrower],
              isLvalue:  bool = false)
        
        with super (loc,
                    type,
                    isReduced-> isReduced,
                    isLvalue-> isLvalue,
                    throwers-> throwers)
    {}

}
