in fields;

use ymirc::lexing::word;
use ymirc::utils::{format, comparison};
use ymirc::semantic::generator::type;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub mod ::class_;
pub mod ::closure;
pub mod ::enum_;
pub mod ::future_;
pub mod ::option;
pub mod ::struct;
pub mod ::tuple;
pub mod ::ticlass;
pub mod ::map;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          ANCESTOR          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * Abstract base class for all field‑access operator values.
 *
 * FieldOperatorValue represents an operation that extracts a field or
 * sub-component from an object. The exact semantics—such as mutability,
 * lvalue-ness, and reduction rules—are defined by concrete subclasses
 * corresponding to the specific kind of field being accessed.
 *
 * The operator stores:
 *   - `object`: the value from which the field is accessed.
 *
 * The `isLvalue` flag indicates whether the accessed field is assignable.
 * The operator inherits throwers from the object operand.
 *
 * A field access is a full literal only when the object itself is a full
 * literal.
 */
@abstract
pub class FieldOperatorValue over OperatorValue {

    pub {
        /** The object from which the field is accessed. */
        let object: &Value;
    }

    /**
     * Construct a field‑access operator value.
     *
     * @params:
     *   - loc:       source location of the field‑access expression
     *   - type:      result type of the accessed field
     *   - object:    the object operand
     *   - isLvalue:  true iff the accessed field is assignable
     *   - isReduced: true iff the operator has been reduced
     *
     * The operator inherits throwers from the object operand.
     */
    pub self (loc:       &Word,
              type:      &Type,
              object:    &Value,
              isLvalue:  bool,
              isReduced: bool)

        with super (loc, type,
                    isReduced-> isReduced,
                    isLvalue-> isLvalue,
                    throwers-> object.throwers)

        , object = object
    {}

    /**
     * A field access is a full literal only when the object being accessed is
     * itself a full literal.
     */
    @field
    pub over isFullLiteral (self)-> bool {
        self.object.isFullLiteral
    }

    impl Comparable!{&Generator};
}
