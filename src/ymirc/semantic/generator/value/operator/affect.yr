/*
 * Declares the AffectValue class.
 *
 * AffectValue represents the assignment of a value into a memory location. This
 * operator models runtime mutation: evaluating the right operand and storing
 * its result into the location designated by the left operand.
 *
 * Assignments are never literals, never pure, and always evaluated for their
 * side effects. The result type is the type of the assigned value, and the
 * operator itself is not an lvalue.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::generator::value::operator::affect
 * @File: ymirc/semantic/generator/value/operator/affect.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2021-11-20
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in affect;

use ymirc::lexing::word;
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::type;

/**
 * Represents an assignment operation.
 *
 * AffectValue models expressions such as:
 *
 *     x = y
 *
 * The operator stores:
 *   - `left`:  the destination memory location,
 *   - `right`: the value to assign.
 *
 * The assignment inherits throwers from both operands and is always considered
 * a runtime effect, never a literal.
 */
@final
pub class AffectValue over OperatorValue {

    pub {
        /** The left operand(destination). */
        let left: &Value;

        /** The right operand(source). */
        let right: &Value;
    }

    /**
     * Construct an assignment operator value.
     *
     * @params:
     *   - loc:       source location of the assignment
     *   - type:      resulting type of the assignment expression
     *   - left:      destination memory location
     *   - right:     value to assign
     *   - isReduced: true iff the operator has been reduced
     *
     * The operator is not an lvalue and always carries the union of throwers
     * from both operands.
     */
    pub self (loc: &Word,
              type: &Type,
              left: &Value,
              right: &Value,
              isReduced: bool = false)

        with super (loc, type,
                    isReduced-> isReduced,
                    isLvalue-> false,
                    throwers-> (left.throwers ~ right.throwers))

        , left = left
        , right = right
    {}

    /**
     * @returns false
     * by construction assigment is a runtime mutation.
     * */
    @field
    pub over isFullLiteral(self)-> bool {
        false
    }

    /**
     * Create an exact copy of the assignment, recursively cloning both operands.
     */
    pub over clone(self)-> &Value {
        return copy AffectValue(self.loc,
                                 self.type,
                                 self.left.clone(),
                                 self.right.clone(),
                                 isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /**
         * Format the assignment.
         *
         * When formatting parameters(e.g., for debugging or metadata),
         * assignments are anonymized as "_". Otherwise, they print as:
         *
         *     left = right
         */
        pub over format(self, dmut stream: &Formatter) {
            if (stream.tags.forParams) {
                stream:.write("_");
            } else {
                stream:.write(self.left);
                stream:.write(" = ");
                stream:.write(self.right);
            }
        }
    }

}
