in superproxy;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;
use ymirc::semantic::generator::type;

/**
 * SuperProxyValue represents access to the parent portion of an object
 * (`self.super`) within a class hierarchy. It is used when a class needs to
 * reference its inherited fields or methods from within a private or protected
 * context.
 *
 * This value is also used during constructor lowering for classes, records, and
 * entities to represent implicit references to `self` and `super` when
 * initializing fields. It is therefore a semantic artifact with no direct
 * syntactic counterpart beyond the `self.super` access pattern.
 *
 * SuperProxyValue behaves like a casted view of the underlying object, exposing
 * the parent type while preserving the original value. It is always considered
 * non-literal and non-lvalue.
 *
 * */
@final
pub class SuperProxyValue over CastValue {

    pub {
        /**
         * Indicates whether this proxy refers to the implicit `self` variable
         * rather than the inherited `super` view.
         *
         * When true, the proxy represents `self` in contexts where the semantic
         * engine needs a uniform representation for both `self` and `super`
         * during constructor lowering.
         */
        let isSelf: bool;
    }

    /**
     * Creates a new SuperProxyValue.
     *
     * Parameters:
     *   - loc:    the source location of the proxy expression.
     *   - type:   the parent type being accessed.
     *   - value:  the underlying object from which the parent view is derived.
     *   - isSelf: whether this proxy refers to `self` instead of `super`.
     *
     * The proxy is always treated as a non-lvalue and is considered fully
     * reduced. It inherits throwers from the underlying value through
     * CastValue.
     */
    pub self (loc:    &Word,
              type:   &Type,
              value:  &Value,
              isSelf: bool = false)

        with super (loc,
                    type,
                    value,
                    isLvalue-> false,
                    isReduced-> true)

        , isSelf = isSelf
    {}

    /**
     * Indicates that SuperProxyValue is never a full literal.
     *
     * Accessing `self.super` or its internal proxy form always represents a
     * runtime object reference, not a compile-time constant.
     */
    @field
    pub over isFullLiteral(self)-> bool {
        false
    }

    /**
     * Creates a clone of this SuperProxyValue.
     *
     */
    pub over clone(self)-> &Value {
        copy SuperProxyValue(self.loc,
                              self.type,
                              self.value.clone())
    }

    impl Streamable;
    impl Formattable {

        /**
         * Formats the proxy for debugging or diagnostic output.
         *
         * Printed as:
         *     self of ParentType
         * or:
         *     super of ParentType
         *
         * depending on whether the proxy represents `self` or `super`.
         */
        pub over format(self, dmut stream: &Formatter) {
            if self.isSelf {
                stream:.write(Keys::SELF, " ", Keys::OF, " ", self.type);
            } else {
                stream:.write(Keys::SUPER, " ", Keys::OF, " ", self.type);
            }
        }
    }

}
