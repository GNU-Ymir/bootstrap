 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in concat;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};

use std::stream;

use ymirc::semantic::generator::type;

/**
 * Represents the concatenation of two slice values.
 *
 * SliceConcatValue models the operation:
 *
 *     left ~ right
 *
 * where both operands are slices. The operator produces a new slice containing
 * the elements of the left operand followed by those of the right operand.
 *
 * Unlike SliceAppendValue, this operator does not imply that the result will be
 * stored back into the left operand. It always produces a fresh slice value.
 *
 * The operator stores:
 *   - `left`:  the left slice operand,
 *   - `right`: the right slice operand.
 *
 * A slice concatenation qualifies as a full literal only when both operands are
 * full literals.
 */
@final
pub class SliceConcatValue over SliceOrArrayOperatorValue {

    pub {
        /** The left operand of the concatenation. */
        let left: &Value;

        /** The right operand of the concatenation. */
        let right: &Value;
    }

    /**
     * Construct a slice concatenation operator value.
     *
     * @params:
     *   - loc:       source location of the concatenation expression
     *   - type:      result type of the concatenation(a slice type)
     *   - left:      the left slice operand
     *   - right:     the right slice operand
     *   - isReduced: true iff the operator has been reduced
     *
     * The operator inherits throwers from both operands.
     */
    pub self (loc:       &Word,
              type:      &Type,
              left:      &Value,
              right:     &Value,
              isReduced: bool = false)

        with super (loc,
                    type,
                    isReduced-> isReduced,
                    throwers-> (left.throwers ~ right.throwers))

        , left = left
        , right = right
    {}

    /**
     * A slice concatenation is a full literal only when both operands are full
     * literals.
     */
    @field
    pub over isFullLiteral(self)-> bool {
        if (!self.left.isFullLiteral) return false;
        if (!self.right.isFullLiteral) return false;

        return true;
    }

    /**
     * Create an exact copy of the concatenation operator, recursively cloning
     * both operands.
     */
    pub over clone(self)-> &Value {
        return copy SliceConcatValue(self.loc,
                                      self.type,
                                      self.left.clone(),
                                      self.right.clone(),
                                      isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /**
         * Format the slice concatenation as:
         *
         *     <left> ~ <right>
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(self.left);
            stream:.write(" ~ ");
            stream:.write(self.right);
        }
    }

}
