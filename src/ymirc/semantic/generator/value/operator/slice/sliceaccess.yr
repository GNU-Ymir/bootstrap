in sliceaccess;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::type;

/**
 * Represents an indexed access on a slice value.
 *
 * SliceAccessValue models the operation:
 *
 *     slice[index]
 *
 * where `slice` is a slice value and `index` is an integer expression. The
 * operator retrieves the element at the given index. The result is an lvalue
 * when the slice operand is an lvalue, allowing assignment through the access
 * when permitted by the slice’s mutability rules.
 *
 * The operator stores:
 *   - `slice`: the slice operand being indexed,
 *   - `index`: the index expression.
 *
 * A slice access qualifies as a full literal only when both operands are full
 * literals.
 */
@final
pub class SliceAccessValue over SliceOrArrayOperatorValue {

    pub {
        /** The slice operand being indexed. */        
        let slice: &Value;

        /** The index expression applied to the slice. */        
        let index: &Value;
    }

    /**
     * Construct a slice access operator value.
     *
     * @params:
     *   - loc:       source location of the access expression
     *   - type:      result type of the access (the slice element type)
     *   - slice:     the slice operand
     *   - index:     the index operand
     *   - isReduced: true iff the operator has been reduced
     *
     * The operator inherits throwers from both operands. The result is an
     * lvalue when the slice operand is an lvalue.
     */
    pub self (loc: &Word,
              type: &Type,
              slice: &Value,
              index: &Value,
              isReduced: bool = false)
        
        with super (loc, type,
                    isReduced-> isReduced,
                    isLvalue-> slice.isLvalue,
                    throwers-> (slice.throwers ~ index.throwers))
        
        , slice = slice
        , index = index
    {}

    /**
     * A slice access is a full literal only when both the slice and the index
     * are full literals.
     */
    @field
    pub over isFullLiteral (self)-> bool {
        self.slice.isFullLiteral && self.index.isFullLiteral
    }

    /**
     * Clone the slice access operator, recursively cloning both operands.
     */
    pub over clone (self)-> &Value {
        return copy SliceAccessValue (self.loc,
                                      self.type,
                                      self.slice.clone (),
                                      self.index.clone (),
                                      isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};
    impl Streamable;
    impl Formattable {

        /**
         * Format the slice access as:
         *
         *     <slice> [<index>]
         */
        pub over format (self, dmut stream: &Formatter) {
            stream:.write (self.slice);
            stream:.write (" [");
            stream:.write (self.index);
            stream:.write (']');
        }
    }

}
