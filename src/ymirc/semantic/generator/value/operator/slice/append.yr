/*
 * Declares the SliceAppendValue class.
 *
 * SliceAppendValue represents an append operation on a slice. It is similar to
 * a slice concatenation, but differs in intent: the result of the append is
 * conceptually meant to be written back into the left operand. This enables
 * optimizations such as reusing pre-allocated capacity and reducing the number
 * of allocations at runtime. Ymir slices follow allocation semantics similar to
 * C++ vectors.
 *
 * The following expressions are equivalent:
 *
 *     a = a ~ b;
 *     a ~= b;
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::generator::value::operator::slice::append
 * @File: ymirc/semantic/generator/value/operator/slice/append.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2021-11-20
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in append;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};

use ymirc::semantic::generator::type;

use std::stream;

/**
 * Represents an append operation on a slice value.
 *
 * SliceAppendValue models the operation:
 *
 *     left ~= right
 *
 * which appends the elements of `right` to the slice `left`. Unlike
 * SliceConcatValue, this operator is intended to modify the left operand,
 * enabling allocation-aware optimizations when the left slice has spare
 * capacity.
 *
 * The operator stores:
 *   - `left`:  the slice being appended to,
 *   - `right`: the slice or element being appended.
 *
 * Slice append operations always have side effects and therefore never qualify
 * as full literals.
 */
@final
pub class SliceAppendValue over SliceOrArrayOperatorValue {

    pub {
        /** The slice being appended to. */
        let left: &Value;

        /** The value being appended to the slice. */
        let right: &Value;
    }

    /**
     * Construct a slice append operator value.
     *
     * @params:
     *   - loc:       source location of the append expression
     *   - type:      result type of the append(a slice type)
     *   - left:      the slice operand being appended to
     *   - right:     the value being appended
     *   - isReduced: true iff the operator has been reduced
     *
     * The operator inherits throwers from both operands. The result is never an
     * lvalue, as the append operation produces a new slice value.
     */
    pub self (loc:       &Word,
              type:      &Type,
              left:      &Value,
              right:     &Value,
              isReduced: bool = false)

        with super (loc,
                    type,
                    isReduced-> isReduced,
                    throwers-> (left.throwers ~ right.throwers),
                    isLvalue-> false)

        , left = left
        , right = right
    {}

    /**
     * Slice append operations always have side effects and therefore never
     * produce full literals.
     */
    @field
    pub over isFullLiteral(self)-> bool {
        false
    }

    /**
     * Create an exact copy of the append operator, recursively cloning both
     * operands.
     */
    pub over clone(self)-> &Value {
        return copy SliceAppendValue(self.loc,
                                      self.type,
                                      self.left.clone(),
                                      self.right.clone(),
                                      isReduced-> self.isReduced);
    }


    impl Streamable;
    impl Formattable {

        /**
         * Format the slice append as:
         *
         *     <left> ~= <right>
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(self.left);
            stream:.write(" ~= ");
            stream:.write(self.right);
        }
    }

}
