in arrayaccess;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};

use std::stream;

use ymirc::semantic::generator::type;

/**
 * Represents an indexed access on an array value.
 *
 * ArrayAccessValue models the operation:
 *
 *     array[index]
 *
 * where `array` is an array value and `index` is an integer expression. The
 * operator retrieves the element at the given index. The result is always an
 * lvalue, as array elements are assignable when the array itself is mutable.
 *
 * The operator stores:
 *   - `array`: the array operand being indexed,
 *   - `index`: the index expression.
 *
 * An array access qualifies as a full literal only when both operands are full
 * literals.
 */
@final
pub class ArrayAccessValue over SliceOrArrayOperatorValue {

    pub {
        /** The array operand being indexed. */        
        let array: &Value;

        /** The index expression applied to the array. */        
        let index: &Value;
    }

    /**
     * Construct an array access operator value.
     *
     * @params:
     *   - loc:       source location of the access expression
     *   - type:      result type of the access (the array element type)
     *   - array:     the array operand
     *   - index:     the index operand
     *   - isReduced: true iff the operator has been reduced
     *
     * The operator inherits throwers from both operands. The result is always
     * an lvalue, as array elements are assignable.
     */
    pub self (loc: &Word,
              type: &Type,
              array: &Value,
              index: &Value,
              isReduced: bool = false)
        
        with super (loc, type,
                    isReduced-> isReduced,
                    throwers-> (array.throwers ~ index.throwers),
                    isLvalue-> true)
        
        , array = array
        , index = index
    {}            

    /**
     * An array access is a full literal only when both the array and the index
     * are full literals.
     */
    @field
    pub over isFullLiteral (self)-> bool {
        self.array.isFullLiteral && self.index.isFullLiteral
    }

    /**
     * Create an exact copy of the array access operator, recursively cloning
     * both operands.
     */
    pub over clone (self)-> &Value {
        return copy ArrayAccessValue (self.loc,
                                      self.type,
                                      self.array.clone (),
                                      self.index.clone (),
                                      isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {
        
        /**
         * Format the array access as:
         *
         *     <array> [<index>]
         */
        pub over format (self, dmut stream: &Formatter) {
            stream:.write (self.array);
            stream:.write (" [");
            stream:.write (self.index);
            stream:.write (']');
        }
    }

}
