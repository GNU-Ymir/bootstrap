 */


in slicecompare;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};

use ymirc::semantic::generator::type;
use std::stream;

/**
 * Represents a comparison between two slice values.
 *
 * SliceCompareValue models a binary comparison operator applied to two slice
 * operands. The comparison is performed by a runtime function that receives the
 * left and right slices and returns the comparison result (typically a boolean
 * value).
 *
 * The operator stores:
 *   - `left`:  the left slice operand,
 *   - `right`: the right slice operand.
 *
 * Slice comparisons never produce lvalues. They may be reduced when both
 * operands are reducible, but they only qualify as full literals when both
 * operands are full literals.
 */
@final
pub class SliceCompareValue over SliceOrArrayOperatorValue {

    pub {
        /** The left operand of the slice comparison. */
        let left: &Value;

        /** The right operand of the slice comparison. */        
        let right: &Value;
    }

    /**
     * Construct a slice comparison operator value.
     *
     * @params:
     *   - loc:       source location of the comparison expression
     *   - type:      result type of the comparison (typically `bool`)
     *   - left:      the left slice operand
     *   - right:     the right slice operand
     *   - isReduced: true iff the comparison has been reduced
     *
     * The operator inherits throwers from both operands.
     */
    pub self (loc:       &Word,
              type:      &Type,
              left:      &Value,
              right:     &Value,
              isReduced: bool = false)
        
        with super (loc,
                    type,
                    isReduced-> isReduced,
                    throwers-> (left.throwers ~ right.throwers))
        
        , left = left
        , right = right
    {}            

    /**
     * A slice comparison is a full literal only when both operands are full
     * literals.
     */
    @field
    pub over isFullLiteral (self)-> bool {
        if (!self.left.isFullLiteral) return false;
        if (!self.right.isFullLiteral) return false;

        return true;
    }

    /**
     * Clone the slice comparison operator, recursively cloning both operands.
     */
    pub over clone (self)-> &Value {
        return copy SliceCompareValue (self.loc,
                                       self.type,
                                       self.left.clone (),
                                       self.right.clone (),
                                       isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};
    
    impl Streamable;
    impl Formattable {

        /**
         * Format the slice comparison as:
         *
         *     <left> == <right>
         *
         * The printed operator is always `==`, as slice comparisons are lowered
         * to a runtime equality function.
         */
        pub over format (self, dmut stream: &Formatter) {
            stream:.write (self.left);
            stream:.write (" == ");
            stream:.write (self.right);
        }
    }
    
}
