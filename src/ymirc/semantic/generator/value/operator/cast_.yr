in cast_;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;
use ymirc::semantic::generator::type;

/**
 * CastValue represents a low‑level cast operation applied to an existing value.
 * It models a type reinterpretation without performing any data conversion.
 * The cast is purely semantic and corresponds to a change of type metadata
 * rather than a transformation of the underlying bits.
 *
 * CastValue is an internal semantic construction used during lowering and
 * operator evaluation. It preserves the original value, its throwers, and its
 * literal properties, while exposing a new type to the rest of the semantic
 * pipeline.
 *
 * A CastValue is considered a full literal only if the underlying value is
 * itself a full literal.
 * 
 */
pub class CastValue over OperatorValue {

    pub {
        /** The value being cast. */
        let value: &Value;
    }

    /**
     * Creates a new CastValue.
     *
     * Parameters:
     *   - loc:       the source location of the cast expression.
     *   - type:      the target type after the cast.
     *   - value:     the underlying value being cast.
     *   - isLvalue:  whether the cast result should be treated as an l‑value.
     *   - isReduced: whether the cast has already been reduced.
     *
     * The cast inherits all throwers from the underlying value. Since casts do
     * not perform data conversion, they do not introduce new throwers.
     */
    pub self (loc:       &Word,
              type:      &Type,
              value:     &Value,
              isLvalue:  bool = false,
              isReduced: bool = false)
        
        with super (loc,
                    type,
                    isReduced-> isReduced,
                    isLvalue-> isLvalue,
                    throwers-> value.throwers)
        
        , value = value
    {}

    /**
     * Indicates whether the casted value is a full literal.
     *
     * A CastValue is a full literal only if the underlying value is a full
     * literal, since the cast itself introduces no runtime computation.
     */
    @field
    pub over isFullLiteral (self)-> bool {
        self.value.isFullLiteral 
    }
    
    /**
     * Creates a deep clone of this CastValue.
     */
    pub over clone (self)-> &Value {
        return copy CastValue (self.loc,
                               self.type,
                               self.value.clone (),
                               isLvalue-> self.isLvalue,
                               isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};
    
    impl Streamable;
    impl Formattable {
        
        /**
         * Formats the cast expression for debugging or diagnostic output.
         *
         * Printed using the syntax:
         *     cast!{TargetType}(value)
         */
        
        pub over format (self, dmut stream: &Formatter) {
            stream:.writef (Keys::CAST, "!{%}(%)", self.type, self.value);
        }
    }
    
}
