 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in named;

use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::{format, comparison};

use std::stream;

use ymirc::semantic::generator::type;

/**
 * Represents a named argument in a function call.
 *
 * NamedValue models the syntax:
 *
 *     name -> value
 *
 * used inside a call expression to bind a specific argument to a specific
 * parameter by name. Named arguments allow callers to override positional
 * ordering and improve clarity when calling functions with many parameters.
 *
 * The operator stores:
 *   - `name`:  the parameter name being bound,
 *   - `value`: the value assigned to that parameter.
 *
 * A named argument is a full literal when its value is a full literal.
 */
@final
pub class NamedValue over Value {

    pub {
        /** The parameter name being assigned. */
        let name: [c8];
        
        /** The value bound to the named parameter. */        
        let value: &Value;
    }
    
    /**
     * Construct a named argument value.
     *
     * @params:
     *   - loc:       source location of the named argument
     *   - name:      the parameter name being bound
     *   - value:     the value assigned to the parameter
     *   - isReduced: true iff the value has been reduced
     *
     * The named argument inherits type, throwers, and control-flow metadata
     * from its value. Named arguments are never lvalues.
     */
    pub self (loc:       &Word,
              name:      [c8],
              value:     &Value,
              isReduced: bool = false)
        
        with super (loc,
                    value.type,
                    isReduced-> isReduced,
                    isLvalue-> false,
                    throwers-> value.throwers,
                    breakLoc-> value.breakLoc,
                    returnLoc-> value.returnLoc)
        
        , name = name
        , value = value
    {}

    /**
     * A named argument is a full literal when its value is a full literal.
     */
    @field
    pub over isFullLiteral (self)-> bool {
        self.value.isFullLiteral 
    }

    /**
     * Create an exact copy of the named argument, recursively cloning its value.
     */
    pub over clone (self)-> &NamedValue {
        return copy NamedValue (self.loc,
                                self.name,
                                self.value.clone (),
                                isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};
    
    impl Streamable;
    impl Formattable {
        /**
         * Format the named argument as:
         *
         *     name -> value
         *
         * with indentation applied to the value for readability.
         */
        pub over format (self, dmut stream: &Formatter) {
            stream:.write (self.name, Tokens::ARROW, ' ');
            stream:.entabing ();
            self.value.format (alias stream);
            stream:.detabing ();
        }        
    }
    
}



