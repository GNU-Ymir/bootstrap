/*
 * Declares the MethodCallValue class.
 *
 * MethodCallValue represents a call to a method delegate. A method delegate is
 * created when a method is accessed from an instance of a class, record, or
 * entity. It encapsulates both the method’s prototype and the closure value
 * representing the receiver (the object on which the method is invoked).
 *
 * A method call therefore models expressions such as:
 *
 *     object.method(arg1, arg2, ...)
 *
 * The call never produces an lvalue and is never a full literal.
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::semantic::generator::value::operator::call::methodcall
 * @File: ymirc/semantic/generator/value/operator/call/methodcall.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com> 
 *
 * @Created (YYYY-MM-DD): 2021-12-15
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in method;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;
use ymirc::semantic::generator::type;
use ymirc::semantic::generator::value::delegate;

/**
 * Represents a call to a method delegate.
 *
 * MethodCallValue models expressions such as:
 *
 *     obj.method(arg1, arg2, ...)
 *
 * where the method has been resolved into a MethodDelegateValue. The operator
 * stores:
 *
 *   - `delegate`:  the method delegate being invoked,
 *   - `params`:    arguments matching the method’s signature,
 *   - `addParams`: extra arguments for C-variadic methods.
 *
 * The operator aggregates throwers from:
 *   - all parameters,
 *   - the method delegate,
 *   - the underlying method prototype.
 */
@final
pub class MethodCallValue over CallOperatorValue {

    pub {
        /** Parameters matching the method’s declared signature. */        
        let params: [&Value];

        /** The method delegate being invoked. */        
        let delegate: &MethodDelegateValue;

        /** Additional parameters for C-variadic methods. */        
        let addParams: [&Value];
    }

    /**
     * Construct a method-call operator value.
     *
     * @params:
     *   - loc:       source location of the call
     *   - type:      return type of the call
     *   - delegate:  the method delegate being invoked
     *   - params:    arguments matching the method’s signature
     *   - addParams: extra arguments for C-variadic methods
     *   - isReduced: true iff the operator has been reduced
     *
     * The operator collects throwers from all parameters, from the delegate,
     * and from the delegate’s prototype.
     */
    pub self (loc:       &Word,
              type:      &Type,
              delegate:  &MethodDelegateValue,
              params:    [&Value],
              addParams: [&Value] = [],
              isReduced: bool = false)
        
        with super (loc, type, isReduced-> isReduced)
        , params = params
        , delegate = delegate
        , addParams = addParams
    {
        let mut thrs: [Thrower] = [];
        for i in self.params {
            thrs ~= i.throwers;
        }
        
        for i in self.addParams {
            thrs ~= i.throwers;
        }

        thrs ~= copy [Thrower (loc, j.type) for j in self.delegate.throwers];
        thrs ~= copy [Thrower (loc, j.type) for j in self.delegate.proto.throwers];

        self._throwers = thrs;        
    }

    /**
     * Create an exact copy of the method-call operator, recursively cloning all
     * parameters and cloning the delegate.
     */
    pub over clone (self)-> &Value {
        let params = copy [i.clone () for i in self.params];
        let addParams = copy [i.clone () for i in self.addParams];

        if let m: &MethodDelegateValue = self.delegate.clone () {
            return copy MethodCallValue (self.loc,
                                         self.type,
                                         m,
                                         params,
                                         addParams-> addParams,
                                         isReduced-> self.isReduced);
        }

        panic;
    }

    impl Comparable!{&Generator};
    
    impl Streamable;
    impl Formattable {

        /**
         * Format the method call.
         *
         * When parameter formatting is disabled (`forParams`), the call is
         * printed as `_`. Otherwise, the call is printed as:
         *
         *     proto(closure, arg1, arg2, ...)
         *
         * where `closure` is the receiver object captured by the method
         * delegate.
         */
        pub over format (self, dmut stream: &Formatter) {
            if (stream.tags.forParams) {
                stream:.write ("_");
            } else {
                stream:.write (self.delegate.proto, '(', self.delegate.closure);
                stream:.entabing ();
                let mut i = 1us;
                for j in self.params {
                    if (i != 0) stream:.write (", ");
                    j.format (alias stream);
                    i += 1us;
                }

                for j in self.addParams {
                    if (i != 0) stream:.write (", ");
                    j.format (alias stream);
                    i += 1us;
                }

                stream:.detabing ();
                stream:.write (')');
            }
        }        
    }        
}

