/*
 * Declares the FuncPtrCallValue class.
 *
 * FuncPtrCallValue represents a call to a function pointer. Unlike calls to
 * statically known prototypes, the callee here is a runtime value whose type is
 * a function pointer. The call expression therefore uses the function pointer’s
 * signature to validate and evaluate the invocation.
 *
 * This operator models the invocation of a callable value obtained at runtime,
 * such as:
 *
 *     fptr(arg1, arg2, ...)
 *
 * The call never produces an lvalue and is never a full literal.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::generator::value::operator::call::fptrcall
 * @File: ymirc/semantic/generator/value/operator/call/fptrcall.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *   - Emile Cadorel <emile.cadorel@davidson.fr>
 *
 * @Created(YYYY-MM-DD): 2021-12-15
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in fptr;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};

use ymirc::semantic::generator::type;
use std::stream;

/**
 * Represents a call through a function pointer.
 *
 * FuncPtrCallValue models expressions such as:
 *
 *     (fptr)(arg1, arg2, ...)
 *
 * where `fptr` is a runtime value of function-pointer type. The operator stores:
 *
 *   - `fptr`:   the function pointer being invoked,
 *   - `params`: the arguments passed to the function pointer.
 *
 * The operator aggregates throwers from all parameters and from the function
 * pointer itself.
 */
@final
pub class FuncPtrCallValue over CallOperatorValue {

    pub {
        /** Arguments passed to the function pointer. */
        let params: [&Value];

        /** The function pointer being invoked. */
        let fptr: &Value;
    }

    /**
     * Construct a function-pointer call operator value.
     *
     * @params:
     *   - loc:       source location of the call
     *   - type:      return type of the call
     *   - fptr:      the function pointer operand
     *   - params:    arguments passed to the function pointer
     *   - isReduced: true iff the operator has been reduced
     *
     * The operator collects throwers from all parameters and from the function
     * pointer itself.
     */
    pub self (loc: &Word,
              type: &Type,
              fptr: &Value,
              params: [&Value],
              isReduced: bool = false)

        with super (loc,
                    type,
                    isReduced-> isReduced)
        , params = params
        , fptr = fptr
    {
        let mut thrs: [Thrower] = [];
        for i in self.params {
            thrs ~= i.throwers;
        }

        thrs ~= copy [Thrower(loc, j.type) for j in self.fptr.throwers];

        self._throwers = thrs;
    }

    /**
     * Create an exact copy of the function-pointer call operator, recursively
     * cloning all parameters and cloning the function pointer.
     */
    pub over clone(self)-> &Value {
        let params = copy [i.clone() for i in self.params];

        return copy FuncPtrCallValue(self.loc,
                                      self.type,
                                      self.fptr.clone(),
                                      params,
                                      isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /**
         * Format the function-pointer call.
         *
         * When parameter formatting is disabled(`forParams`), the call is
         * printed as `_`. Otherwise, it is printed as:
         *
         *     (fptr)(arg1, arg2, ...)
         */
        pub over format(self, dmut stream: &Formatter) {
            if (stream.tags.forParams) {
                stream:.write("_");
            } else {
                stream:.write('(', self.fptr, ')', '(');
                stream:.entabing();
                let mut i = 0us;
                for j in self.params {
                    if (i != 0us) stream:.write(", ");
                    j.format(alias stream);
                    i += 1us;
                }

                stream:.detabing();
                stream:.write(')');
            }
        }
    }
}
