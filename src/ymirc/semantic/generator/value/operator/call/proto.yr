/*
 * Declares the PrototypeCallValue class.
 *
 * PrototypeCallValue represents a direct call to a prototype value. A prototype is a
 * callable entity (function, intrinsic, built-in operator, etc.) with a fixed
 * parameter list and return type. This operator models the invocation of such a
 * prototype and produces the resulting value of the call.
 *
 * PrototypeCallValue handles both:
 *   - regular parameters defined by the prototype,
 *   - additional parameters supplied for C-variadic prototypes.
 *
 * The call never produces an lvalue and is never a full literal, since it
 * requires runtime evaluation.
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::semantic::generator::value::operator::call::call
 * @File: ymirc/semantic/generator/value/operator/call/call.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *   - Emile Cadorel <emile.cadorel@davidson.fr>
 *
 * @Created (YYYY-MM-DD): 2021-12-15
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in proto;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::type;
use ymirc::semantic::generator::type::native;

use ymirc::semantic::generator::value::prototype;

/**
 * Represents a call to a prototype value.
 *
 * PrototypeCallValue models expressions such as:
 *
 *     proto(arg1, arg2, ...)
 *
 * where `proto` is a PrototypeValue describing the callable entity. The
 * operator stores:
 *
 *   - `proto`:      the prototype being invoked,
 *   - `params`:     the arguments corresponding to the prototype’s signature,
 *   - `addParams`:  extra arguments for C-variadic prototypes.
 *
 * The operator aggregates throwers from all parameters and from the prototype
 * itself.
 */
@final
pub class PrototypeCallValue over CallOperatorValue {

    pub {
        /** Parameters matching the prototype’s declared signature. */        
        let params: [&Value];

        /** The prototype being invoked. */        
        let proto: &PrototypeValue;

        /** Additional parameters for C-variadic calls. */        
        let addParams: [&Value];
    }

    /**
     * Construct a call operator for a prototype.
     *
     * @params:
     *   - loc:       source location of the call
     *   - type:      return type of the call
     *   - proto:     the prototype being invoked
     *   - params:    arguments matching the prototype’s signature
     *   - addParams: extra arguments for C-variadic prototypes
     *   - isReduced: true iff the operator has been reduced
     *
     * The operator collects throwers from all arguments and from the prototype.
     */
    pub self (loc:       &Word,
              type:      &Type,
              proto:     &PrototypeValue,
              params:    [&Value],
              addParams: [&Value] = [],
              isReduced: bool = false)
        
        with super (loc,
                    type,
                    isReduced-> isReduced)
        
        , params = params
        , proto = proto
        , addParams = addParams
    {
        let mut thrs: [Thrower] = [];
        for i in self.params {
            thrs ~= i.throwers;
        }
        
        for i in self.addParams {
            thrs ~= i.throwers;
        }

        thrs ~= copy [Thrower (loc, j.type) for j in self.proto.throwers];

        self._throwers = thrs;        
    }

    /**
     * Create an exact copy of the call operator, recursively cloning all
     * parameters. The prototype itself is not cloned.
     */
    pub over clone (self)-> &Value {
        let params = copy [i.clone () for i in self.params];
        let addParams = copy [i.clone () for i in self.addParams];

        return copy PrototypeCallValue (self.loc,
                               self.type,
                               self.proto,
                               params-> params,
                               addParams-> addParams,
                               isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};
    
    impl Streamable;
    impl Formattable {

        /**
         * Format the call expression.
         *
         * When formatting parameters is disabled (`forParams`), the call is
         * printed as `_`. Otherwise, it is printed as:
         *
         *     proto(arg1, arg2, ...)
         */
        pub over format (self, dmut stream: &Formatter) {
            if (stream.tags.forParams) {
                stream:.write ("_");
            } else {
                stream:.write (self.proto, " (");
                stream:.entabing ();
                let mut i = 0us;
                for j in self.params {
                    if (i != 0) stream:.write (", ");
                    j.format (alias stream);
                    i += 1us;
                }

                for j in self.addParams {
                    if (i != 0) stream:.write (", ");
                    j.format (alias stream);
                    i += 1us;
                }

                stream:.detabing ();
                stream:.write (')');
            }
        }        
    }        
}

