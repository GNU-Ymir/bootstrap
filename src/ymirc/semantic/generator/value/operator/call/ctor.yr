/*
 * Declares the CtorCallValue class.
 *
 * CtorCallValue represents a call to a class constructor through a
 * CtorDelegateValue. A constructor delegate encapsulates both the constructor
 * prototype and the instance being constructed (or `unit` for static
 * construction). This operator models the invocation of that constructor,
 * producing a new class instance.
 *
 * CtorCallValue supports:
 *   - regular constructor parameters,
 *   - additional parameters for C-variadic constructors,
 *   - implicit parameters injected by the delegate (instance, next-constructor).
 *
 * The call never produces an lvalue and is never a full literal.
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::semantic::generator::value::operator::call::ctorcall
 * @File: ymirc/semantic/generator/value/operator/call/ctorcall.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *   - Emile Cadorel <emile.cadorel@davidson.fr>
 *
 * @Created (YYYY-MM-DD): 2021-12-15
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in ctor;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};

use std::stream;
use ymirc::semantic::generator::type;
use ymirc::semantic::generator::value::{literal, delegate};

/**
 * Represents a constructor call through a CtorDelegateValue.
 *
 * CtorCallValue models expressions such as:
 *
 *     ClassName(args...)
 *
 * where the constructor is represented by a CtorDelegateValue. The operator
 * stores:
 *
 *   - `delegate`:  the constructor delegate being invoked,
 *   - `params`:    arguments matching the constructor’s signature,
 *   - `addParams`: extra arguments for C-variadic constructors.
 *
 * The operator aggregates throwers from:
 *   - all parameters,
 *   - the delegate itself,
 *   - the underlying constructor prototype.
 */
@final
pub class CtorCallValue over CallOperatorValue {

    pub {
        /** Parameters matching the constructor’s declared signature. */        
        let params: [&Value];
        
        /** The constructor delegate being invoked. */
        let delegate: &CtorDelegateValue;
        
        /** Additional parameters for C-variadic constructors. */
        let addParams: [&Value];
    }
    
    /**
     * Construct a constructor-call operator value.
     *
     * @params:
     *   - loc:       source location of the call
     *   - type:      result type of the constructor call (the class type)
     *   - delegate:  the constructor delegate being invoked
     *   - params:    arguments matching the constructor’s signature
     *   - addParams: extra arguments for C-variadic constructors
     *   - isReduced: true iff the operator has been reduced
     *
     * The operator collects throwers from all parameters, from the delegate,
     * and from the delegate’s prototype.
     */
    pub self (loc:       &Word,
              type:      &Type,
              delegate:  &CtorDelegateValue,
              params:    [&Value],
              addParams: [&Value] = [],
              isReduced: bool = false)

        with super (loc, type, isReduced-> isReduced)
        , params = params
        , delegate = delegate
        , addParams = addParams
    {
        let mut thrs: [Thrower] = [];
        for i in self.params {
            thrs ~= i.throwers;
        }

        for i in self.addParams {
            thrs ~= i.throwers;
        }

        thrs ~= copy [Thrower (loc, j.type) for j in self.delegate.throwers];
        thrs ~= copy [Thrower (loc, j.type) for j in self.delegate.proto.throwers];

        self._throwers = thrs;        
    }
    
    /**
     * Create an exact copy of the constructor-call operator, recursively
     * cloning all parameters and cloning the delegate.
     */
    pub over clone (self)-> &Value {
        let params = copy [i.clone () for i in self.params];
        let addParams = copy [i.clone () for i in self.addParams];

        if let del: &CtorDelegateValue = self.delegate.clone () {
            return copy CtorCallValue (self.loc,
                                       self.type,
                                       delegate-> del,
                                       params-> params,
                                       addParams-> addParams,
                                       isReduced-> self.isReduced);
        }

        panic;
    }

    impl Comparable!{&Generator};
    
    impl Streamable;
    impl Formattable {

        /**
         * Format the constructor call.
         *
         * When parameter formatting is disabled (`forParams`), the call is
         * printed as `_`. Otherwise, the call is printed as:
         *
         *     ClassName(arg0, arg1, ..., nextCtor)
         *
         * Template parameters are resolved through the delegate’s template
         * mapper. The instance argument is printed first when present.
         */
        pub over format (self, dmut stream: &Formatter) {
            if (stream.tags.forParams) {
                stream:.write ("_");
            } else {
                let tmps = self.delegate.proto.templateMapper;
                let path = if (stream.tags.forDebug) {
                    self.delegate.proto.sym.path.withTemplates (tmps)
                } else {
                    let p = self.delegate.proto.sym.path;
                    if (p.file == Keys::SELF) {
                        p.parent.withTemplates (tmps)
                    } else {
                        p.withTemplates (tmps)
                    }
                };

                stream:.write (path);
                stream:.write ('(');
                stream:.entabing ();
                let mut i = 0us;
                match self.delegate.instance {
                    UnitValue () => {
                        if (stream.tags.forDebug) {
                            stream:.write (Keys::NEW);
                            i += 1us;
                        }
                    }
                    x: _ => {
                        stream:.write (x);
                        i += 1us;
                    }
                }

                for j in self.params {
                    if (i != 0us) stream:.write (", ");
                    j.format (alias stream);
                    i += 1us;
                }

                for j in self.addParams {
                    if (i != 0us) stream:.write (", ");
                    j.format (alias stream);
                    i += 1us;
                }

                if self.delegate.nextCtor !of UnitValue {
                    if i != 0 stream:.write (", ");
                    stream:.write (self.delegate.nextCtor);
                }

                stream:.detabing ();
                stream:.write (')');
            }
        }        
    }        
}

