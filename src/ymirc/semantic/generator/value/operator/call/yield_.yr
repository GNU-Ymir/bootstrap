in yield_;

use ymirc::lexing::word;
use ymirc::semantic::generator::type::native;
use ymirc::utils::{comparison, format};

use std::stream;

/**
 * Resumption of a generator.
 *
 * The call is typed `bool`: true iff the generator yielded a value, which is
 * then stored in `out`, false once the generator body is over.
 */
@final
pub class YieldNextValue over CallOperatorValue {

    pub {
        /** The generator handle, of type `(yield-> T)`. */
        let generator: &Value;

        /** The lvalue of type T receiving the yielded value. */
        let out: &Value;
    }

    /**
     * @params:
     *   - loc:       source location of the iteration
     *   - generator: the generator handle
     *   - out:       the lvalue receiving the yielded value
     *   - isReduced: true iff the operator has been reduced
     */
    pub self (loc: &Word, generator: &Value, out: &Value, isReduced: bool = false)
        with super (loc,
                    BOOL_TYPE,
                    isReduced-> isReduced,
                    throwers-> generator.throwers ~ out.throwers)
        , generator = generator
        , out = out
    {}

    pub over clone(self)-> &Value {
        return copy YieldNextValue(self.loc,
                                   self.generator.clone(),
                                   self.out.clone(),
                                   isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /**
         * The printed form is `(generator).next(out)`.
         */
        pub over format(self, dmut stream: &Formatter) {
            if (stream.tags.forParams) {
                stream:.write("_");
            } else {
                stream:.write('(', self.generator, ").next(", self.out, ')');
            }
        }
    }
}
