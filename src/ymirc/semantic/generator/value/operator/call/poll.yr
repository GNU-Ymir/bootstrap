in poll;

use ymirc::lexing::{keys, word};
use ymirc::semantic::generator::type;
use ymirc::utils::{comparison, format};

use std::stream;

/**
 * Poll of an async value, typed as the option of the value it completes with.
 *
 * The async is resumed once with the waker: the option is empty while it is pending,
 * the async calling the waker once it can make progress, and holds its value once
 * it completed.
 */
@final
pub class AsyncPollValue over CallOperatorValue {

    pub {
        /** The async handle, of type `(async-> T)`. */
        let handle: &Value;

        /** The waker, of type `dg ()-> void`. */
        let waker: &Value;
    }

    /**
     * @params:
     *   - loc:       source location of the call
     *   - type:      the option of the type the async completes with
     *   - handle:    the async handle
     *   - waker:     the waker the async calls once it can make progress
     *   - isReduced: true iff the operator has been reduced
     */
    pub self (loc: &Word, type: &Type, handle: &Value, waker: &Value, isReduced: bool = false)
        with super (loc,
                    type,
                    isReduced-> isReduced,
                    throwers-> handle.throwers ~ waker.throwers)
        , handle = handle
        , waker = waker
    {}

    pub over clone(self)-> &Value {
        return copy AsyncPollValue(self.loc,
                                   self.type,
                                   self.handle.clone(),
                                   self.waker.clone(),
                                   isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /**
         * The printed form is `(handle).poll(waker)`.
         */
        pub over format(self, dmut stream: &Formatter) {
            if (stream.tags.forParams) {
                stream:.write("_");
            } else {
                stream:.write('(', self.handle, ").", AsyncKeys::POLL, '(', self.waker, ')');
            }
        }
    }
}
