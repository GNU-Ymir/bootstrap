in init;

use ymirc::lexing::word;
use ymirc::utils::{comparison, format};

use std::stream;

/**
 * The call of a generator by a `for` loop or a `yield in`, that consumes the handle
 * without letting it escape. The frame of the generator can thus be reserved by the
 * consumer instead of being allocated by the generator.
 */
@final
pub class YieldInitValue over CallOperatorValue {

    pub {
        /** The call creating the generator. */
        let call: &PrototypeCallValue;
    }

    /**
     * @params:
     *   - loc:       source location of the call
     *   - call:      the call creating the generator
     *   - isReduced: true iff the operator has been reduced
     */
    pub self (loc: &Word, call: &PrototypeCallValue, isReduced: bool = false)
        with super (loc,
                    call.type,
                    isReduced-> isReduced,
                    throwers-> call.throwers)
        , call = call
    {}

    pub over clone(self)-> &Value {
        return copy YieldInitValue(self.loc,
                                   if let c: &PrototypeCallValue = self.call.clone() { c } else { panic; },
                                   isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /**
         * The printed form is `init proto (args...)`.
         */
        pub over format(self, dmut stream: &Formatter) {
            if (stream.tags.forParams) {
                stream:.write("_");
            } else {
                stream:.write("init ", self.call);
            }
        }
    }
}
