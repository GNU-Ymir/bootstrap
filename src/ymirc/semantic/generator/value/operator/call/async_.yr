in async_;

use ymirc::lexing::{keys, word};
use ymirc::semantic::generator::type;
use ymirc::utils::{comparison, format};

use std::stream;

/**
 * Run of an async value, typed as the value it completes with.
 *
 * The async is resumed, the thread sleeping until it is woken whenever the async
 * is pending, until it completes.
 */
@final
pub class AsyncRunValue over CallOperatorValue {

    pub {
        /** The async handle, of type `(async-> T)`. */
        let handle: &Value;
    }

    /**
     * @params:
     *   - loc:       source location of the call
     *   - type:      the type the async completes with
     *   - handle:    the async handle
     *   - isReduced: true iff the operator has been reduced
     */
    pub self (loc: &Word, type: &Type, handle: &Value, isReduced: bool = false)
        with super (loc,
                    type,
                    isReduced-> isReduced,
                    throwers-> handle.throwers)
        , handle = handle
    {}

    pub over clone(self)-> &Value {
        return copy AsyncRunValue(self.loc,
                                  self.type,
                                  self.handle.clone(),
                                  isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /**
         * The printed form is `(handle).run()`.
         */
        pub over format(self, dmut stream: &Formatter) {
            if (stream.tags.forParams) {
                stream:.write("_");
            } else {
                stream:.write('(', self.handle, ").", AsyncKeys::RUN, "()");
            }
        }
    }
}
