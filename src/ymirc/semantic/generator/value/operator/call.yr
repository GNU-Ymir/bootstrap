in call;

pub mod ::proto;
pub mod ::ctor;
pub mod ::fptr;
pub mod ::method;


use ymirc::lexing::{word, keys};
use ymirc::utils::format;
use ymirc::semantic::generator::type;

/**
 * Abstract base class for all call-related operator values.
 *
 * CallOperatorValue models the common behavior of all operators that represent
 * the invocation of a callable entity. Subclasses implement the specific
 * semantics of:
 *
 *   - calling a function,
 *   - invoking a constructor,
 *   - calling through a function pointer,
 *   - invoking a method on an object.
 *
 * Calls never produce lvalues, and they are never full literals, since they
 * always require runtime execution.
 */
@abstract
pub class CallOperatorValue over OperatorValue {

    /**
     * Construct a call-operator value.
     *
     * @params:
     *   - loc:       source location of the call expression
     *   - type:      return type of the call
     *   - isReduced: true iff the operator has been reduced
     *
     * Call operators never produce lvalues.
     */
    pub self (loc:       &Word,
              type:      &Type,
              throwers:  [Thrower],
              isReduced: bool = false)

        with super (loc,
                    type,
                    throwers-> throwers,
                    isReduced-> isReduced,
                    isLvalue-> false)
    {}

    /**
     * Calling a frame is by construction involving operations.
     * */
    @field
    pub over isFullLiteral(self)-> bool {
        false
    }
}
