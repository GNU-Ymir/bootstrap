in union_;

use ymirc::lexing::word;
use ymirc::semantic::generator::type::custom;
use ymirc::utils::format;

use std::stream;

/**
 * Widening of a member value into the union listing it.
 *
 * UnionWidenValue is what a value of a member type becomes wherever a union
 * is expected. It carries the index of the member in the declaration order,
 * which is the tag the union object holds and the one a match arm tests, so
 * the widening is what decides at compile time what the union holds.
 *
 * The widened value is never an lvalue: the union object is built by the
 * widening, and a union of classes has one allocated for it.
 */
@final
pub class UnionWidenValue over CastValue {

    pub {
        // The union the member is widened into
        let unionType: &UnionType;

        // The index of the member in the declaration order
        let index: usize;
    }

    /**
     * Construct the widening of a member into a union.
     *
     * @params:
     *   - loc:       source location of the widening
     *   - unionType: the union the member is widened into
     *   - value:     the member value
     *   - index:     the index of the member in the declaration order
     */
    pub self (loc: &Word, unionType: &UnionType, value: &Value, index: usize)
        with super (loc, unionType, value, isLvalue-> false, isReduced-> true)
        , unionType = unionType
        , index = index
    {}

    /**
     * A widening is never a full literal, it builds a union object.
     */
    @field
    pub over isFullLiteral(self)-> bool {
        false
    }

    /**
     * Creates a clone of this UnionWidenValue.
     */
    pub over clone(self)-> &Value {
        copy UnionWidenValue(self.loc, self.unionType, self.value.clone(), self.index)
    }

    impl Streamable;
    impl Formattable {

        /**
         * Formats the widening for debugging or diagnostic output.
         *
         * Printed using the syntax:
         *     U#0(value)
         *
         * where the index is the member the union is made to hold.
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(self.type, '#', self.index, '(', self.value, ')');
        }
    }

}
