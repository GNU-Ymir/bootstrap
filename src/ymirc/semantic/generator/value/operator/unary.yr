in unary;

use ymirc::lexing::{word, keys};

use ymirc::utils::{format, comparison};
use ymirc::semantic::generator::type;

use std::stream;

/**
 * Abstract base class for all unary operator values.
 *
 * A UnaryOperatorValue represents the application of a unary operator to a
 * single operand. Concrete subclasses implement the semantics of specific unary
 * operators(numeric negation, logical not, bitwise not, etc.).
 *
 * The operator stores:
 *   - `op`:    the unary operator being applied,
 *   - `value`: the operand to which the operator is applied.
 *
 * The unary operator inherits the throwers of its operand.
 *
 */
@final
pub class UnaryOperatorValue over OperatorValue {

    pub {
        // The operator
        let op: UnaryOperators;

        // The inner operand of the unary
        let value: &Value;
    }

    /**
     * Construct a unary operator value.
     *
     * @params:
     *   - loc:       source location of the operator expression
     *   - type:      result type of the unary operator
     *   - op:        the unary operator being applied
     *   - value:     the operand
     *   - isReduced: true iff the operator has been reduced
     */
    pub self (loc:       &Word,
              type:      &Type,
              op:        UnaryOperators,
              value:     &Value,
              isReduced: bool = false)

        with super (loc,
                    type,
                    isReduced-> isReduced,
                    isLvalue-> false,
                    throwers-> value.throwers)

        , value = value
        , op = op
    {}

    /**
     * A unary operator is a full literal iff its operand is a full literal.
     */
    @field
    pub over isFullLiteral(self)-> bool {
        self.value.isFullLiteral
    }

    /**
     * Creates a clone of this UnaryOperatorValue.
     *
     * */
    pub over clone(self)-> &Value {
        return copy UnaryOperatorValue(self.loc,
                                       self.type,
                                       self.op,
                                       self.value.clone(),
                                       isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /**
         * Format the unary operator as:
         *
         *     <op><value>
         *
         * without inserting additional spacing.
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(self.op);
            stream:.write(self.value);
        }
    }

}
