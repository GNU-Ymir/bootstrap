/*
 * Declares the TemplateRefValue class.
 *
 * TemplateRefValue represents a reference to a template declaration in the
 * generator IR. It plays a role similar to ModuleRefValue, but instead of
 * referring to a module, it refers to a template symbol and its associated
 * declaration. Template references appear during name resolution whenever an
 * identifier denotes a template rather than a value, type, or module.
 *
 * TemplateRefValue is the base class for more specialized template reference
 * nodes, such as TemplateRefMethodValue and TemplateRefCtorValue, which refine
 * the semantics for method and constructor templates.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::generator::value::template::base
 * @File: ymirc/semantic/generator/value/template/base.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2021-11-20
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in base;


use ymirc::semantic::symbol;
use ymirc::semantic::generator::type::native;

use ymirc::syntax::declaration::function;
use ymirc::syntax::expression::{instruction, empty};

use ymirc::utils::{format, comparison};
use ymirc::lexing::word;
use std::stream;


/**
 * Base class for references to template declarations.
 *
 * A TemplateRefValue represents a reference to a template symbol in the
 * generator IR. It is used during name resolution and overload selection when
 * an identifier refers to a template rather than a concrete value. The class
 * stores the template symbol and provides access to its declaration location.
 *
 * TemplateRefValue:
 *   - is always an rvalue,
 *   - always has type `None`,
 *   - is always considered reduced,
 *   - is always a full literal(it contains no runtime data),
 *   - is not final, and is extended by TemplateRefMethodValue and
 *     TemplateRefCtorValue for method and constructor templates.
 *
 */
pub class TemplateRefValue over Value {

    pub {
        /**
         * The symbol of the referenced template.
         */
        let sym: &TemplateSymbol;
    }

    /**
     * Construct a TemplateRefValue referencing a template symbol.
     *
     * @params:
     *   - loc: the source location of the reference
     *   - sym: the template symbol being referenced
     *
     * The value has type `None`, is always reduced, and is never an lvalue.
     *
     */
    pub self (loc: &Word, sym: &TemplateSymbol)
        with super (loc, NONE_TYPE, isReduced-> true, isLvalue-> false)
        , sym = sym
    {}

    /**
     * @returns the source location of the referenced template’s declaration.
     */
    @{field, final}
    pub fn declLoc(self)-> &Word {
        self.sym.loc
    }

    /**
     * @returns true.
     *
     * Template references are always considered full literals because they contain
     * no runtime data and require no evaluation.
     */
    @field
    pub over isFullLiteral(self)-> bool {
        true
    }

    /**
     * Create an exact copy of this TemplateRefValue.
     *
     * TemplateRefValue is immutable with respect to its identity, so cloning
     * returns the same instance.
     */
    pub over clone(self)-> &Value {
        self
    }

    /**
     * Structural equality for template references.
     *
     * Two TemplateRefValues are equal iff:
     *   - their base Value fields are equal, and
     *   - they reference the same template symbol.
     */
    impl Comparable!{&Generator};


    impl Streamable;
    impl Formattable {

        /**
         * Write the template reference to the formatter.
         *
         * If the formatter has the `withParams` tag enabled, the printed form includes:
         *   - the template’s full path,
         *   - its parameter list,
         *   - and, when applicable, the function prototype(parameter list and return
         *     type) for function templates.
         *
         * Otherwise, only the template path and its parameter list are printed.
         *
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(self.sym.path.toStr(), " {");
            for i, z in self.sym.decl.params {
                if i != 0us stream:.write(", ");
                stream:.write(z);
            }
            stream:.write("}");

            if (stream.tags.withParams) {
                if let f: &FunctionDecl = self.sym.decl.decl {
                    stream:.write("(");
                    for i, p in f.proto.params {
                        if i != 0us stream:.write(", ");
                        stream:.write(p);
                    }
                    stream:.write(")");
                    if f.proto.retType !of EmptyExpr {                        
                        stream:.write("-> ", f.proto.retType);                        
                    }
                }

            }
        }
    }

}
