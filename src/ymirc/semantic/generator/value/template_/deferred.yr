 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in deferred;

use ymirc::lexing::{keys, word};
use ymirc::semantic::template_;
use ymirc::semantic::generator::type::{native, temporary};
use ymirc::syntax::expression;
use ymirc::utils::{comparison, format};

use std::stream;

/**
 * The construction of a template class whose template parameters are not all
 * inferred from the arguments of its constructor.
 *
 * It keeps the arguments of the construction, already validated, to validate
 * it once the template parameters left are inferred.
 */
@final
pub class DeferredCtorValue over Value {

    pub {
        // The class template being constructed.
        let left: &TemplateRefValue;

        // The arguments of the construction, the named ones first.
        let rights: [&Value];

        // The number of named arguments in `rights`.
        let nbNamed: usize;

        // True iff the construction occurs inside a copy expression.
        let inCopy: bool;

        // The template arguments inferred by each constructor accepting the arguments.
        let mappers: [TemplateMapper];
    }

    /**
     * @params:
     *   - loc:        location of the construction
     *   - left:       the class template
     *   - rights:     the arguments of the construction, the named ones first
     *   - nbNamed:    the number of named arguments
     *   - inCopy:     true iff the construction occurs inside a copy expression
     *   - mappers:    the template arguments inferred by each constructor accepting the arguments
     *   - unresolved: the template parameters the constructors leave unresolved
     */
    pub self (loc:        &Word,
              left:       &TemplateRefValue,
              rights:     [&Value],
              nbNamed:    usize,
              inCopy:     bool,
              mappers:    [TemplateMapper],
              unresolved: [&Expression])
        with super (loc, copy DeferredClassType(loc, left.sym, unresolved), isReduced-> true, isLvalue-> false)
        , left = left
        , rights = rights
        , nbNamed = nbNamed
        , inCopy = inCopy
        , mappers = mappers
    {}

    pub over clone(self)-> &Value {
        self
    }

    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /**
         * Format the construction as `path {T} (args)`.
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(self.left, " (");
            for i, r in self.rights {
                if i != 0us stream:.write(", ");
                stream:.write(r);
            }
            stream:.write(")");
        }
    }

}

/**
 * A method accessed on a value whose type is a DeferredClassType, solved with
 * the arguments of its call.
 */
@final
pub class DeferredMethodValue over Value {

    pub {
        // The deferred construction, or a variable it initializes.
        let object: &Value;

        // The name of the method.
        let field: &Expression;

        // The field operator, DOT or DOT_AND.
        let op: BinaryOperators;
    }

    /**
     * @params:
     *   - loc:    location of the field operator
     *   - object: the deferred construction, or a variable it initializes
     *   - field:  the name of the method
     *   - op:     the field operator
     */
    pub self (loc: &Word, object: &Value, field: &Expression, op: BinaryOperators)
        with super (loc, NONE_TYPE, isReduced-> true, isLvalue-> false)
        , object = object
        , field = field
        , op = op
    {}

    pub over clone(self)-> &Value {
        self
    }

    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        pub over format(self, dmut stream: &Formatter) {
            stream:.write(self.object, self.op, self.field);
        }
    }

}
