 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in method;

use ymirc::semantic::generator::type;
use ymirc::semantic::generator::type::native;

use ymirc::semantic::symbol;

use ymirc::syntax::declaration::function;
use ymirc::syntax::expression::{instruction, empty};

use ymirc::lexing::{keys, word};
use ymirc::utils::{format, comparison};

use std::stream;

/**
 * Represents a reference to a method template.
 *
 * TemplateRefMethodValue is a specialization of TemplateRefValue for method
 * templates. It stores the class symbol associated with the method and provides
 * access to the method’s syntax declaration. Method references are used during
 * template instantiation.
 *
 * A TemplateRefMethodValue:
 *   - is always an rvalue,
 *   - always has type `None`,
 *   - is always considered reduced,
 *   - is a full literal(contains no runtime data),
 *   - is final and not intended for further subclassing.
 *
 */
@final
pub class TemplateRefMethodValue over TemplateRefValue {

    pub {
        /**
         * The class symbol associated with the method template.
         */
        let classSym: &ClassSymbol;
    }

    /**
     * Construct a TemplateRefMethodValue referencing a method template.
     *
     * @params:
     *   - loc:  the source location of the reference
     *   - cl:   the class symbol to which the method belongs
     *   - tmpl: the template symbol representing the method
     *
     * The value inherits TemplateRefValue’s semantics: type `None`, always reduced,
     * and never an lvalue.
     *
     */
    pub self (loc: &Word, cl: &ClassSymbol, tmpl: &TemplateSymbol)
        with super (loc, tmpl)
        , classSym = cl
    {}

    /**
     * @returns the method’s name as it appears in the syntax.
     *
     * Panics if the underlying template declaration is not a function.
     */
    @field
    pub fn name(self)-> [c8] {
        if let f: &FunctionDecl = self.sym.decl.decl {
            return f.name.str;
        }

        panic;
    }

    /**
     * @returns the syntax declaration of the method.
     *
     * This provides access to the method’s prototype, parameters, and return type.
     * Used during overload resolution and diagnostic formatting.
     *
     * Panics if the underlying template declaration is not a function.
     */
    @field
    pub fn function(self)-> &FunctionDecl {
        if let f: &FunctionDecl = self.sym.decl.decl {
            return f;
        }

        panic;
    }

    /**
     * @returns true iff the method declares `self` as mutable.
     *
     * This is determined by inspecting the first parameter of the method’s
     * prototype, which represents the implicit `self` parameter. A method is
     * considered mutable if `self` is declared mutable or deeply mutable.
     */
    @field
    pub fn isMutable(self)-> bool {
        let v = self.function.proto.params[0];
        return (v.isMutable || v.isDeeplyMutable);
    }

    /**
     * Structural equality for method template references.
     *
     * Two TemplateRefMethodValues are equal iff:
     *   - their base TemplateRefValue fields are equal, and
     *   - they reference the same class symbol.
     */
    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /**
         * Write the method template reference to the formatter.
         *
         * The printed form includes:
         *   - the method’s full path,
         *   - its template parameter list,
         *   - and, when the formatter has the `withParams` tag enabled, the method
         *     prototype(parameter list excluding the implicit `self` parameter, and
         *     the return type if present).
         *
         * This is used for diagnostics, debugging, and error messages.
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(self.sym.path.toStr(), " {");
            for i, z in self.sym.decl.params {
                if i != 0us stream:.write(", ");
                stream:.write(z);
            }
            stream:.write("}");

            if (stream.tags.withParams) {
                if let f: &FunctionDecl = self.sym.decl.decl {
                    stream:.write("(");
                    for i, p in f.proto.params[1us .. $] {
                        if i != 0us stream:.write(", ");
                        stream:.write(p);
                    }
                    stream:.write(")");
                    if f.proto.retType !of EmptyExpr {
                        stream:.write("-> ", f.proto.retType);                        
                    }
                }
            }
        }
    }

}
