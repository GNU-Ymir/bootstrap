/*
 * Declares the TemplateRefCtorValue class.

 * TemplateRefCtorValue represents a reference to a constructor template in the
 * generator IR. It specializes TemplateRefValue for the case where the template
 * denotes a class constructor rather than a free function or method. These
 * references appear during name resolution when an identifier refers to a
 * constructor template.
 *
 * The class stores both the template symbol and the class symbol to which the
 * constructor belongs. It provides access to the constructor’s syntax
 * declaration and its name, and supports formatted output for debugging and
 * diagnostics.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::generator::value::template::ctor
 * @File: ymirc/semantic/generator/value/template/ctor.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2021-11-20
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in ctor;

use ymirc::semantic::symbol;

use ymirc::syntax::declaration::function;
use ymirc::syntax::expression::{instruction, empty};

use ymirc::utils::{format, comparison};

use ymirc::lexing::{word, keys};
use std::stream;

/**
 * Represents a reference to a constructor template.
 *
 * TemplateRefCtorValue is a specialization of TemplateRefValue for constructor
 * templates. It stores the class symbol associated with the constructor and
 * provides access to the constructor’s syntax declaration. Constructor
 * references are used during overload resolution, template instantiation, and
 * diagnostic formatting.
 *
 * A TemplateRefCtorValue:
 *   - is always an rvalue,
 *   - always has type `None`,
 *   - is always considered reduced,
 *   - is a full literal(contains no runtime data),
 *   - is final and not intended for further subclassing.
 */
@final
pub class TemplateRefCtorValue over TemplateRefValue {

    pub {
        /**
         * The class symbol associated with the constructor template.
         */
        let classSym: &ClassSymbol;
    }

    /**
     * Construct a TemplateRefCtorValue referencing a constructor template.
     *
     * @params:
     *   - loc: the source location of the reference
     *   - cl:  the class symbol to which the constructor belongs
     *   - tmpl: the template symbol representing the constructor
     *
     * The value inherits TemplateRefValue’s semantics: type `None`, always reduced,
     * and never an lvalue.
     */
    pub self (loc: &Word, cl: &ClassSymbol, tmpl: &TemplateSymbol)
        with super (loc, tmpl)
        , classSym = cl
    {}

    /**
     * @returns the constructor’s name as it appears in the syntax.
     *
     * If the constructor is explicitly named(i.e., not `self`), its name is
     * returned. Otherwise, an empty string is returned to reflect the implicit
     * constructor naming convention.
     *
     * Panics if the underlying template declaration is not a constructor.
     */
    @field
    pub fn name(self)-> [c8] {
        if let c: &CtorDecl = self.sym.decl.decl {
            if c.name.str != Keys::SELF {
                return c.name.str;
            }

            return "";
        }

        panic;
    }

    /**
     * @returns the syntax declaration of the constructor.
     *
     * This provides access to the constructor’s prototype, parameters, and
     * return type(if any). Used during overload resolution and diagnostic
     * formatting.
     *
     * Panics if the underlying template declaration is not a constructor.
     */
    @field
    pub fn ctor(self)-> &CtorDecl {
        if let c: &CtorDecl = self.sym.decl.decl {
            return c;
        }

        panic;
    }

    /**
     * Structural equality for constructor template references.
     *
     * Two TemplateRefCtorValues are equal iff:
     *   - their base TemplateRefValue fields are equal, and
     *   - they reference the same class symbol.
     */
    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /**
         * Write the constructor template reference to the formatter.
         *
         * The printed form includes:
         *   - the constructor’s full path,
         *   - its template parameter list,
         *   - and, when the formatter has the `withParams` tag enabled, the constructor
         *     prototype(parameter list).
         *
         * This is used for diagnostics, debugging, and error messages.
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(self.classSym.path.toStr());
            let ctor = self.ctor;
            if ctor.name.str != "" && ctor.name.str != Keys::SELF {
                stream:.write("::", ctor.name.str);
            }
            stream:.write(" {");
            for i, z in self.sym.decl.params {
                if i != 0us stream:.write(", ");
                stream:.write(z);
            }
            stream:.write("}");

            if (stream.tags.withParams) {
                if let c: &CtorDecl = self.sym.decl.decl {
                    stream:.write("(");
                    for i, p in c.proto.params {
                        if i != 0us stream:.write(", ");
                        stream:.write(p);
                    }
                    stream:.write(")");
                }
            }
        }
    }

}
