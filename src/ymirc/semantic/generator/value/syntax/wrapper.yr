/*
 * Declares the ValueWrapperExpr class.
 *
 * ValueWrapperExpr represents a *synthetic* AST node used during template
 * rewriting. It embeds a semantic generator value inside an expression node so
 * that the template rewriting engine can manipulate values and syntax
 * uniformly.
 *
 * These wrappers allow the template system to:
 *   - insert semantic values directly into the rewritten AST,
 *   - preserve specialization results without losing information,
 *   - pass generator values through the validation pipeline unchanged,
 *   - treat values as expressions when rewriting or substituting template code.
 *
 * When the rewritten template AST is later validated, the value visitor simply
 * returns the wrapped value without performing any transformation.
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::semantic::generator::value::syntax::wrapper
 * @File: ymirc/semantic/generator/value/syntax/wrapper.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *   - Emile Cadorel <emile.cadorel@davidson.fr>
 *
 * @Created (YYYY-MM-DD): 2021-11-20
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in wrapper;

use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::{format, comparison};

use std::stream;

use ymirc::syntax::expression;

/**
 * Synthetic AST node that wraps a generator value.
 *
 * ValueWrapperExpr is used exclusively during template rewriting. It allows the
 * rewriting engine to embed generator values directly into the AST, ensuring
 * that semantic information produced during specialization is preserved
 * verbatim.
 *
 * The wrapper behaves like a normal expression node, but when the validator
 * encounters it, it simply extracts and returns the wrapped value. This makes
 * ValueWrapperExpr a transparent bridge between the syntactic rewriting phase
 * and the semantic generator phase.
 *
 * ValueWrapperExpr:
 *   - is final,
 *   - stores a single generator value,
 *   - prints as the wrapped value,
 *   - participates in structural equality through Comparable.
 *   
 */
@final
pub class ValueWrapperExpr over Expression {

    pub {        
        /**
         * The generator value wrapped by this synthetic expression node.
         */
        let value: &Value;
    }

    /**
     * Construct a wrapper expression containing a generator value.
     *
     * @params:
     *   - loc:   the source location associated with the synthetic node
     *   - value: the generator value being wrapped
     *
     */
    pub self (loc: &Word, value: &Value)
        with super (loc)
        , value = value
    {}

    impl Comparable!{&Expression};
    impl Streamable;
    impl Formattable {

        /**
         * Write the wrapped value to the formatter.
         *
         * The wrapper itself is not printed; instead, the wrapped value is
         * formatted exactly as it would appear on its own. This ensures that
         * synthetic wrapper nodes remain invisible in diagnostics and debugging
         * output.
         */
        pub over format (self, dmut stream : &Formatter) {
            self.value.format (alias stream);
        }
    }

}
