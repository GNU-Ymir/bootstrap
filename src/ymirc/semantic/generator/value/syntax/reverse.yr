/*
 * Declares the ExprWrapperValue class.
 *
 * ExprWrapperValue is a *reverse* wrapper used during template specialization
 * when some template symbols cannot yet be fully resolved. It embeds an
 * expression inside a generator value so that partially-resolved constructs
 * (such as lambda bodies or deferred template arguments) can be carried forward
 * until enough information is available to complete specialization.
 *
 * These wrappers are transient: they are not intended to escape the template
 * solving context. Once specialization has enough information, the wrapped
 * expression is revisited and transformed into a proper generator value.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::generator::value::syntax::reverse
 * @File: ymirc/semantic/generator/value/syntax/reverse.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-02-27
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in reverse;


use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::{format, comparison};

use std::stream;

use ymirc::syntax::expression;

/**
 * Represents a generator value that wraps an unresolved expression.
 *
 * ExprWrapperValue is used during template specialization when an expression
 * cannot yet be lowered to a concrete generator value. This commonly occurs in
 * lambda specialization, deferred template arguments, or partially-resolved
 * template constructs.
 *
 * The wrapper:
 *   - stores the original expression,
 *   - behaves like a generator value for the duration of template solving,
 *   - prints as the underlying expression,
 *   - is always an rvalue,
 *   - always has type `None`,
 *   - is always considered reduced,
 *   - is not intended to survive beyond template resolution.
 *
 * Once specialization completes, the rewriting engine replaces these wrappers
 * with proper generator values.
 */
@final
pub class ExprWrapperValue over Value {

    pub {
        /**
         * The unresolved expression wrapped by this value.
         *
         * This expression will be revisited later in the template
         * specialization pipeline once enough information is available to lower
         * it to a generator value.
         */
        let expr: &Expression;
    }

    /**
     * Construct an ExprWrapperValue wrapping an unresolved expression.
     *
     * @params:
     *   - loc:  the source location associated with the wrapper
     *   - expr: the expression being wrapped
     *
     * The wrapper is given type `None` because it does not represent a concrete
     * runtime value. It is always reduced and never an lvalue.
     */
    pub self (loc: &Word, expr: &Expression)
        with super (loc, copy NoneType(loc), isReduced-> true, isLvalue-> false)
        , expr = expr
    {}

    /**
     * @returns false.
     *
     * ExprWrapperValue is never considered a full literal because it represents an
     * unresolved expression rather than a concrete value.
     */
    @field
    pub over isFullLiteral(self)-> bool {
        false
    }

    /**
     * Create an exact copy of this wrapper value.
     *
     * ExprWrapperValue is immutable with respect to its identity, so cloning
     * returns the same instance.
     */
    pub over clone(self)-> &Value {
        self
    }

    impl Comparable!{&Generator};
    impl Streamable;
    impl Formattable {

        /**
         * Write the wrapped expression to the formatter.
         *
         * The wrapper itself is not printed; instead, the underlying expression is
         * formatted exactly as it would appear on its own. This ensures that reverse
         * wrappers remain invisible in diagnostics and debugging output.
         */
        pub over format(self, dmut stream: &Formatter) {
            self.expr.format(alias stream);
        }
    }
}
