in lambda;

use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::{format, comparison};

use std::stream;

use ymirc::semantic::generator::type;
use ymirc::semantic::generator::value::literal;

use ymirc::syntax::{expression, expression::type};

@final
pub class LambdaValueWrapperExpr over Expression {

    pub {
        // The name of the temlate value in the rewriter
        let name: [c8];

        // The type of the value to finalize, before transforming
        let expr: &FunctionPtrTypeExpr;

        // The content of the wrapper
        let value: &Value;
    }

    pub self (loc:     &Word,
              name:    [c8],
              expr:    &FunctionPtrTypeExpr,
              value: &Value)

        with super (loc)
        , name    = name
        , value   = value
        , expr    = expr
    {}

    impl Comparable!{&Expression} {

        pub over opEquals(self, o: &Expression)-> bool {
            if let v: &LambdaValueWrapperExpr = o {
                // ignore the name on purpose
                if (v.value != self.value) return false;
                if (v.expr != self.expr) return false;

                return true;
            }

            return false;
        }

    }

    impl Streamable;
    impl Formattable {
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(self.expr, " = (");
            stream:.entabing();
            self.value.format(alias stream);
            stream:.detabing();
            stream:.write(")");
        }
    }
}
