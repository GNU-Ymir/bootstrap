 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in scope;


use ymirc::lexing::word;
use ymirc::utils::format;
use ymirc::semantic::generator::type;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

mod ::block;
mod ::break_;
mod ::condition;
mod ::inline;
mod ::list_compr;
mod ::loop_;
mod ::panic_;
mod ::return_;
mod ::throw_;
mod ::trycatch;
mod ::tryfin;
mod ::continue_;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          TYPES          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub def BlockValue:       block::BlockValue;
pub def BreakValue:       break_::BreakValue;
pub def ConditionalValue: condition::ConditionalValue;
pub def ContinueValue:    continue_::ContinueValue;
pub def InlineBlockValue: inline::InlineBlockValue;
pub def ListComprValue:   list_compr::ListComprValue;
pub def LoopValue:        loop_::LoopValue;
pub def PanicValue:       panic_::PanicValue;
pub def ReturnValue:      return_::ReturnValue;
pub def ThrowValue:       throw_::ThrowValue;
pub def TryCatchValue:    trycatch::TryCatchValue;
pub def TryFinallyValue:  tryfin::TryFinallyValue;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          ANCESTOR          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */

/*!
 * Abstract ancestor for all scope-introducing generator values.
 *
 * ScopeValue defines the common semantic properties shared by all control-flow
 * constructs in the generator IR. These constructs:
 *   - introduce a new lexical or control-flow scope,
 *   - may contain nested generator values,
 *   - are never full literals,
 *   - and may or may not be lvalues depending on the specific construct.
 *
 * Concrete subclasses include blocks, loops, conditionals, exception handlers,
 * and other structured control-flow constructs.
 */
@abstract
pub class ScopeValue over Value {

    /**
     * Construct a scope-introducing generator value.
     *
     * @params:
     *   - loc:       the source location of the construct
     *   - type:      the resulting type of the construct
     *   - isReduced: whether the construct is already reduced
     *   - isLvalue:  whether the construct behaves as an lvalue
     *
     */
    pub self (loc:  &Word,
              type: &Type,
              isReduced: bool,
              isLvalue: bool,
              breakLoc: &Word = EOF_WORD,
              returnLoc: &Word = EOF_WORD,
              throwers: [Thrower] = [])

        with super (loc,
                    type,
                    isLvalue-> isLvalue,
                    returnLoc-> returnLoc,
                    breakLoc-> breakLoc,
                    throwers-> throwers,
                    isReduced-> isReduced)
    {}

    /**
     * @returns false.
     *
     * Scope-introducing constructs are never considered full literals because
     * they represent control-flow structure executing instructions, rather than
     * concrete runtime values.
     */
    @field
    pub over isFullLiteral(self)-> bool {
        false
    }

}
