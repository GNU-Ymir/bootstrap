 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in macro_;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::type::native;
use ymirc::semantic::symbol;

use ymirc::syntax::declaration::function;

/**
 * Represents a compile-time reference to a macro symbol.
 *
 * A MacroRefValue encapsulates:
 *   - the referenced macro symbol(`sym`),
 *   - the location of the reference,
 *   - the fact that it is a full literal and always reduced.
 *
 * This value is used by the macro system to propagate symbolic references
 * through expressions and declarations without triggering macro expansion.
 */
@final
pub class MacroRefValue over Value {

    pub {
        /** The referenced macro symbol. */
        let sym: &MacroSymbol;
    }

    /**
     * Creates a new MacroRefValue.
     *
     * Parameters:
     *   - loc: the source location of the reference.
     *   - sym: the referenced macro symbol.
     *
     * Macro references are always:
     *   - of type NONE_TYPE,
     *   - reduced,
     *   - non-lvalues.
     */
    pub self (loc: &Word, sym: &MacroSymbol)
        with super (loc,
                    NONE_TYPE,
                    isReduced-> true,
                    isLvalue-> false)

        , sym = sym
    {}

    /**
     * Returns the source location of the referenced macro declaration.
     *
     * This is useful for diagnostics and error reporting.
     */
    @field
    pub fn declLoc(self)-> &Word {
        self.sym.loc
    }

    /**
     * Indicates that this value is a full literal.
     *
     * Macro references are compile-time constants and therefore always literal.
     */
    @field
    pub over isFullLiteral(self)-> bool {
        true
    }


    /**
     * Cloning a MacroRefValue returns the same instance.
     *
     * Macro references are immutable and unique, so cloning does not produce
     * a new object.
     */
    pub over clone(self)-> &Value {
        self
    }

    impl Comparable!{&Generator};
    impl Streamable;
    impl Formattable {

        /**
         * Formats the macro reference for debugging or pretty-printing.
         *
         * The printed form is the fully-qualified path of the macro symbol.
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(self.sym.path.toStr());
        }
    }
}
