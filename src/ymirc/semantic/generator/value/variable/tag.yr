in tag;

use ymirc::lexing::word;
use ymirc::semantic::symbol;
use ymirc::semantic::generator::type::native;
use ymirc::utils::{comparison, format};

use std::stream;

/**
 * A compile-time reference to a tag symbol
 */
@final
pub class TagRefValue over Value {

    pub {
        // The referenced tag symbol
        let sym: &TagSymbol;
    }

    /**
     * @params:
     *   - loc: the source location of the reference
     *   - sym: the referenced tag symbol
     */
    pub self (loc: &Word, sym: &TagSymbol)
        with super (loc,
                    NONE_TYPE,
                    isReduced-> true,
                    isLvalue-> false)

        , sym = sym
    {}

    /**
     * @returns: the location of the declaration of the tag
     */
    @field
    pub fn declLoc(self)-> &Word {
        self.sym.loc
    }

    /**
     * @returns: true, a tag reference is a compile-time constant
     */
    @field
    pub over isFullLiteral(self)-> bool {
        true
    }

    /**
     * @returns: the same instance, a tag reference being immutable
     */
    pub over clone(self)-> &Value {
        self
    }

    impl Comparable!{&Generator};
    impl Streamable;
    impl Formattable {

        /**
         * Format the reference as the path of the tag
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(self.sym.path.toStr());
        }
    }
}
