/*
 * Declares the VarRefValue class.
 *
 * VarRefValue represents a reference to a variable declared in the generator
 * layer. It is used for all variable-like entities, including:
 *
 *   - VarDeclValue(local variables),
 *   - ProtoVarValue(function parameters),
 *   - iterator parameters,
 *   - the implicit `self` parameter,
 *   - any future variable declaration constructs.
 *
 * A VarRefValue does not own the variable; it is a symbolic reference to the
 * declaration site, enriched with semantic flags describing how the variable
 * behaves(parameter, iterator, lazy, reference type, etc.).
 *
 * VarRefValue is a core component of the generator IR. It is used during:
 *   - name resolution,
 *   - type checking,
 *   - constant folding,
 *   - code generation,
 *   - formatting and diagnostics.
 *
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::generator::value::variable::ref_
 * @File: ymirc/semantic/generator/value/variable/ref_.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-02-26
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in ref_;

use ymirc::lexing::word;
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::type;
use ymirc::semantic::generator::value::literal;

/**
 * Represents a reference to a variable declaration in the generator IR.
 *
 * A VarRefValue refers to a variable introduced by a VarDeclValue, a
 * ProtoVarDeclValue, or any other declaration construct. It stores:
 *
 *   - the declaration location,
 *   - the unique reference ID of the declaration,
 *   - semantic flags describing the variable(parameter, iterator, lazy, etc.),
 *   - whether the variable can be known at compile time,
 *   - the compile-time value, if applicable.
 *
 * VarRefValue is always an lvalue and inherits its type from the referenced
 * declaration. It is used throughout the generator pipeline to track variable
 * identity and semantics.
 */
@final
pub class VarRefValue over Value {

    pub {
        // The value of the variable, only applicable for cte var
        let value: &Value;

        // True iff the variable was declared in a context that allows it be compile time known
        let canCte: bool;

        // True if it is a function parameter
        let isParam: bool;

        // True if it is an iterator parameter
        let isIterator: bool;

        // True if the variable is the self variable;
        let isSelf: bool;

        // True if the variable is a reference type
        let isReference: bool;

        // True if the variable is lazy
        let isLazy: bool;

        // The reference of the generator declaration
        let refId: usize;

        // The location of the declaration
        let declLoc: &Word;
    }

    /**
     * Construct a VarRefValue referencing a variable declaration.
     *
     * @params:
     *   - loc:         the source location of the reference
     *   - declLoc:     the source location of the declaration
     *   - type:        the type of the referenced variable
     *   - refId:       the unique ID of the declaration in the generator
     *   - value:       the compile-time value(UNIT_VALUE if not constant)
     *   - isSelf:      true if this is the implicit `self` variable
     *   - isParam:     true if this variable is a function parameter
     *   - isIterator:  true if this variable is an iterator parameter
     *   - isLazy:      true if this variable is lazily evaluated
     *   - isReference: true if the variable is of reference type
     *   - canCte:      true if the variable can be known at compile time
     *   - isReduced:   true if the value has already been reduced
     *
     * The VarRefValue is always an lvalue. The reduced flag is automatically
     * adjusted so that variables which cannot be compile-time known(or `self`)
     * are always considered reduced.
     */
    pub self (loc:         &Word,
              declLoc:     &Word,
              type:        &Type,
              refId:       usize,
              value:       &Value = UNIT_VALUE,
              isSelf:      bool = false,
              isParam:     bool = false,
              isIterator:  bool = false,
              isLazy:      bool = false,
              isReference: bool = false,
              canCte:      bool = true,
              isReduced:   bool = false)

        with super (loc, type, isReduced-> (isReduced || !canCte || isSelf), isLvalue-> true)
        , declLoc = declLoc
        , value = value
        , isSelf = isSelf
        , isParam = isParam
        , isReference = isReference
        , refId = refId
        , canCte = canCte
        , isLazy = isLazy
        , isIterator = isIterator
    {}

    /**
     * @returns: the name of the var
     */
    @field
    pub fn name(self)-> [c8] {
        self.declLoc.str
    }

    /**
     * @returns true iff the variable can be treated as a full literal.
     *
     * A variable is a full literal only if:
     *   - it is not an iterator parameter,
     *   - it is not lazy.
     *
     * This is used during constant folding and literal propagation.
     */
    @field
    pub over isFullLiteral(self)-> bool {
        if (self.isIterator) return false;
        if (self.isLazy) return false;

        true
    }

    /**
     * Create an exact copy of this VarRefValue.
     *
     * VarRefValue is immutable with respect to its identity, so cloning returns
     * the same instance.
     */
    pub over clone(self)-> &Value {
        self
    }

    impl Comparable!{&Generator} {

        /**
         * Compare two VarRefValue instances structurally.
         *
         * Two VarRefValues are equal iff:
         *   - their base Value fields are equal,
         *   - they reference the same declaration(same refId),
         *   - they share the same semantic flags(self, param, reference, lazy, iterator),
         *   - they originate from the same source location.
         */
        pub over opEquals(self, o: &Generator)-> bool {
            if let p: &VarRefValue = o {
                if (!self.super.opEquals(o)) return false;

                if (self.refId != p.refId) return false;
                if (self.isSelf != p.isSelf) return false;
                if (self.isParam != p.isParam) return false;
                if (self.isReference != p.isReference) return false;
                if (self.isLazy != p.isLazy) return false;
                if (self.isIterator != p.isIterator) return false;
                if (self.loc.str != p.loc.str) return false;

                return true;
            }

            return false;
        }

    }

    impl Streamable;
    impl Formattable {

        /**
         * Write the variable reference to the formatter.
         *
         * The printed form is the variable name. If the formatter has the
         * `withVarIds` tag enabled, the unique reference ID is appended as:
         *
         *     name(#id)
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(self.loc.str);
            if (stream.tags.withVarIds) {
                stream:.write("(#", std::conv::to!{[c8], 36} (self.refId), ')');
            }
        }
    }

}
