 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in module;

use ymirc::lexing::word;
use ymirc::utils::{format, comparison};

use std::stream;

use ymirc::semantic::symbol;
use ymirc::semantic::generator::type::native;


/**
 * Represents a reference to a module symbol.
 *
 * A ModuleRefValue is produced during name resolution when an identifier refers
 * to a module rather than a local variable, global variable, or field. It
 * carries the module symbol and provides access to its declaration location.
 *
 * Module references:
 *   - are always rvalues,
 *   - always have type `None`,
 *   - are always considered reduced,
 *   - are always full literals (they contain no runtime data).
 *
 */
@final
pub class ModuleRefValue over Value {

    pub {                
        /**
         * The symbol of the referenced module.
         */
        let sym: &ModuleSymbol;
    }

    /**
     * Construct a ModuleRefValue referencing a module.
     *
     * @params:
     *   - loc: the source location of the reference
     *   - sym: the module symbol being referenced
     *
     * The value has type `None`, is always reduced, and is never an lvalue.
     * 
     */
    pub self (loc: &Word, sym: &ModuleSymbol)
        with super (loc, NONE_TYPE, isReduced-> true, isLvalue-> false)        
        , sym = sym
    {}

    
    /**
     * @returns the source location of the referenced module’s declaration.
     */
    @field
    pub fn declLoc (self)-> &Word {
        self.sym.loc
    }

    /**
     * @returns true.
     *
     * Module references are always considered full literals because they contain
     * no runtime data and require no evaluation.
     */
    @field
    pub over isFullLiteral (self)-> bool {
        true
    }
    
    /**
     * Create an exact copy of this ModuleRefValue.
     *
     * ModuleRefValue is immutable with respect to its identity, so cloning
     * returns the same instance.
     */
    pub over clone (self)-> &Value {
        self
    }


    /**
     * Structural equality for module references.
     *
     * Two ModuleRefValues are equal iff:
     *   - their base Value fields are equal, and
     *   - they reference the same module symbol.
     */
    impl Comparable!{&Generator};

    
    impl Streamable;
    impl Formattable {

        /**
         * Write the module reference to the formatter.
         *
         * The printed form is the module’s full path.
         */
        pub over format (self, dmut stream: &Formatter) {
            stream:.write (self.sym.path.toStr ());
        }        
    }
    
}



