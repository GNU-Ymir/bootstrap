/*
 * Declares the ProtoVarDeclValue class.
 *
 * ProtoVarDeclValue represents the declaration of a variable inside a function
 * prototype. It is similar to VarDeclValue but carries additional information
 * specific to prototype contexts, such as `nbConsume`, which indicates how many
 * arguments this variable consumes when expanding variadic template parameters.
 *
 * Unlike VarDeclValue, prototype variables are lvalues only when declared
 * mutable. Immutable prototype variables behave as rvalues.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::generator::value::variable::proto
 * @File: ymirc/semantic/generator/value/variable/proto.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-02-27
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in proto;

use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::type;
use ymirc::semantic::generator::type::native;

use ymirc::semantic::generator::value::literal;

/**
 * Represents the declaration of a variable inside a function prototype.
 *
 * Prototype variables differ from normal local variables in several ways:
 *
 *   - They may consume multiple arguments(`nbConsume`) when used in variadic
 *     template signatures. The consumed arguments are implicitly grouped into a
 *     tuple.
 *
 *   - They are lvalues only if declared mutable. Immutable prototype variables
 *     behave as rvalues.
 *
 *   - They may carry additional semantic flags such as `isSelf`, `isReference`,
 *     and `isLazy`, mirroring the semantics of VarDeclValue but adapted to
 *     prototype contexts.
 *
 */
@final
pub class ProtoVarDeclValue over Value {

    pub {
        /**
         * The initializer expression of the variable.
         */
        let value: &Value;

        // True iff the variable is declared mutable
        let isMutable: bool;

        // True iff the variable is the self variable;
        let isSelf: bool;

        // True iff the variable is reference
        let isReference: bool;

        // True iff the variable is lazy
        let isLazy: bool;

        /**
         * Number of arguments consumed by this variable in variadic template contexts.
         *
         * A value greater than 1 indicates that the variable implicitly groups several
         * caller arguments into a tuple.
         */
        let nbConsume: u32;

    }

    /**
     * Construct a prototype variable with no initializer.
     *
     * @params:
     *   - loc:    the source location of the variable
     *   - type:   the declared type of the variable
     *   - uniqId: the unique identifier of the variable in the generator
     *
     * The variable is immutable, non-lazy, non-reference, consumes one
     * argument, and is not `self`. The initializer is UNIT_VALUE.
     */
    pub self (loc:   &Word,
              type:  &Type,
              uniqId: usize)

        with super (loc, type, [], EOF_WORD, EOF_WORD,
                    isReduced-> true,
                    uniqId-> uniqId,
                    isLvalue-> false)
        
        , value       = UNIT_VALUE
        , isMutable   = false
        , isSelf      = false
        , nbConsume   = 1u32
        , isReference = false
        , isLazy      = false
    {}

    /**
     * Construct a fully-specified prototype variable declaration.
     *
     * @params:
     *   - loc:         the source location of the variable
     *   - type:        the declared type of the variable
     *   - value:       the initializer expression
     *   - isMutable:   true iff the variable is declared mutable
     *   - isReference: true iff the variable is a reference binding
     *   - isLazy:      true iff the variable is lazily evaluated
     *   - isSelf:      true iff the variable represents the `self` parameter
     *   - nbConsume:   number of arguments consumed by this variable in variadic
     *                  template contexts
     *
     * The variable is an lvalue only if `isMutable` is true.
     */
    pub self (loc:         &Word,
              type:        &Type,
              value:       &Value,
              isMutable:   bool,
              isReference: bool,
              isLazy:      bool,
              isSelf:      bool,
              nbConsume:   u32)

        with super (loc, type, isReduced-> true, isLvalue-> isMutable)
        , value       = value
        , isMutable   = isMutable
        , isSelf      = isSelf
        , nbConsume   = nbConsume
        , isReference = isReference
        , isLazy      = isLazy
    {}


    /**
     * @returns the name of the variable as it appears in the source.
     */
    @field
    pub fn name(self)-> [c8] {
        self.loc.str
    }

    /**
     * Create an exact copy of this ProtoVarDeclValue.
     *
     * Prototype variable declarations are immutable with respect to their
     * identity, so cloning returns the same instance.
     */
    pub over clone(self)-> &Value {
        self
    }

    impl Comparable!{&Generator} {

        /**
         * Structural equality for prototype variable declarations.
         *
         * Two ProtoVarDeclValues are equal iff:
         *   - their base Value fields are equal,
         *   - they have the same name,
         *   - they share the same semantic flags(mutable, self, reference, lazy),
         *   - they consume the same number of arguments.
         */
        pub over opEquals(self, o: &Generator)-> bool {
            if let p: &ProtoVarDeclValue = o {
                if (!self.super.opEquals(o)) return false;

                if (self.loc.str != p.loc.str) return false;
                if (self.isMutable != p.isMutable) return false;
                if (self.isSelf != p.isSelf) return false;
                if (self.isReference != p.isReference) return false;
                if (self.isLazy != p.isLazy) return false;
                if (self.nbConsume != p.nbConsume) return false;

                return true;
            }

            return false;
        }
    }

    impl Streamable;
    impl Formattable {

        /**
         * Write the prototype variable declaration to the formatter.
         *
         * The printed form includes:
         *   - mutability(`mut`),
         *   - reference binding(`ref`),
         *   - laziness(`lazy`),
         *   - the variable name(with unique ID if enabled),
         *   - the declared type(unless `None`),
         *   - the initializer(unless UNIT_VALUE).
         */
        pub over format(self, dmut stream: &Formatter) {
            if (self.isMutable) stream:.write(Keys::MUTABLE, ' ');
            if (self.isReference) stream:.write(Keys::REF, ' ');
            if (self.isLazy) stream:.write(Keys::LAZY, ' ');

            stream:.write(self.loc.str);
            if (stream.tags.withVarIds) {
                stream:.write("(#", std::conv::to!{[c8], 36} (self.uniqId), ')');
            }
            match self.type {
                NoneType() => {}
                _ => {
                    stream:.write(Tokens::COLON, ' ');
                    self.type.format(alias stream);
                }
            }

            match self.value {
                UnitValue() => {}
                _ => {
                    stream:.write(' ', Tokens::EQUAL, ' ');
                    self.value.format(alias stream);
                }
            }
        }
    }

}
