 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in global;

use ymirc::lexing::word;
use ymirc::utils::{format, comparison};

use std::{stream, conv};

use ymirc::semantic::symbol;
use ymirc::semantic::generator::global;

/**
 * Represents a reference to a global variable declared at module scope.
 *
 * A GlobalVarRefValue links:
 *   - the symbol of the global variable (`sym`), and
 *   - the validated generator representation of the variable (`var`).
 *
 * The type of the value is the type of the referenced global variable. Global
 * variables are always considered reduced.
 *
 * GlobalVarRefValue is always an lvalue.
 */
@final
pub class GlobalVarRefValue over Value {

    pub {        
        /**
         * The symbol of the referenced global variable.
         */        
        let sym: &GlobalVarSymbol;
        
        /**
         * The validated generator representation of the global variable.
         */
        let var: &GlobalVarGenerator;
    }

    /**
     * Construct a GlobalVarRefValue referencing a global variable.
     *
     * @params:
     *   - loc: the source location of the reference
     *   - sym: the symbol of the referenced global variable
     *   - var: the validated generator representation of the global variable
     *
     * The type of the value is taken from the global variable’s generator. Global
     * variable references are always considered reduced. The value is marked as an
     * lvalue.
     * 
     */
    pub self (loc: &Word,
              sym: &GlobalSymbol,
              var: &GlobalVarGenerator)
        
        with super (loc, var.type, isReduced-> true, isLvalue-> true)
        , var = var
        , sym = sym
    {}            

    /**
     * @returns false.
     *
     * Global variable references are never considered full literals.
     */
    @field
    pub over isFullLiteral (self)-> bool {
        false
    }
    
    /**
     * @returns true iff the referenced global variable is declared lazy.
     */
    @field
    pub fn isLazy (self)-> bool {
        self.var.isLazy ()
    }
    
    /**
     * Create an exact copy of this GlobalVarRefValue.
     *
     * GlobalVarRefValue is immutable with respect to its identity, so cloning
     * returns the same instance.
     */
    pub over clone (self)-> &Value {
        self
    }

    /**
     * Structural equality for global variable references.
     *
     * Two GlobalVarRefValues are equal iff:
     *   - their base Value fields are equal, and
     *   - they reference the same global variable symbol.
     */
    impl Comparable!{&Generator};
    
    impl Streamable;
    impl Formattable {

        /**
         * Write the global variable reference to the formatter.
         *
         * The printed form is the name of the referenced global variable.
         */
        pub over format (self, dmut stream: &Formatter) {
            stream:.write (self.var.name.toStr ());
        }
    }

}
