in waker;

use ymirc::lexing::{keys, word};
use ymirc::semantic::generator::type::native;
use ymirc::utils::{comparison, format};

use std::stream;

/**
 * Represents the waker of the current async in the generator IR.
 *
 * AsyncWakerValue:
 *   - is an rvalue typed `dg ()-> void`, always reduced, never known at compile time,
 *   - is only valid in the body of an async, whose resume function takes it.
 */
@final
pub class AsyncWakerValue over Value {

    /**
     * @params:
     *   - loc: the source location of the await passing the waker
     */
    pub self (loc: &Word)
        with super (loc, copy DelegateType(loc, [], [], [], VOID_TYPE, isMutable-> false),
                    throwers-> [],
                    isReduced-> true,
                    isLvalue-> false)
    {}

    pub over clone(self)-> &Value {
        self
    }

    impl Comparable!{&Generator};
    impl Streamable;
    impl Formattable {

        /**
         * The printed form is `#_waker`.
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(GeneratorKeys::WAKER);
        }
    }
}
