/*
 * Declares the VarDeclValue class.
 *
 * VarDeclValue represents the declaration of a variable inside a function body.
 * It captures the semantic properties of the declared variable(mutability,
 * laziness, reference semantics, iterator status, compile-time eligibility) and
 * stores the initial value expression.
 *
 * VarDeclValue is part of the generator IR and is used during:
 *   - name binding,
 *   - type checking,
 *   - constant folding,
 *   - control-flow analysis,
 *   - code generation.
 *
 * A VarDeclValue does not represent the *use* of a variable(that is handled
 * by VarRefValue). Instead, it represents the *introduction* of a variable
 * into the local environment.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::generator::value::variable::decl
 * @File: ymirc/semantic/generator/value/variable/decl.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-02-26
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in decl;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};

use std::stream;

use ymirc::semantic::generator::{type,
                                 value::literal,
                                 type::native};

/**
 * Represents the declaration of a variable inside a function body.
 *
 * A VarDeclValue introduces a new variable into the local environment. It
 * stores:
 *
 *   - the declared type of the variable(`varType`),
 *   - the initial value expression(`value`),
 *   - semantic flags describing the variable(mutable, reference, lazy,
 *     iterator, compile-time eligible),
 *   - the source location of the declaration.
 *
 * The type of the VarDeclValue node itself is always `Void`, since the
 * declaration is a statement, not an expression. The declared variable’s type
 * is stored separately in `varType`.
 *
 * VarDeclValue participates in control-flow analysis by propagating the
 * throwers, breakers, and returners of its initializer expression.
 */
@final
pub class VarDeclValue over Value {

    pub {
        /**
         * The declared type of the variable.
         *
         * Note: `self.type` is always `Void` because the declaration is a statement.
         * The variable’s actual type is stored here.
         */
        let varType: &Type;

        // The initializer expression of the variable.
        let value: &Value;

        // True iff the variable is declared mutable
        let isMutable: bool;

        // True iff the variable is a reference(only used inside pattern matching)
        let isReference: bool;

        // True iff the variable is lazy
        let isLazy: bool;

        // True iff it can create cte var references
        let isCte: bool;

        // True iif it is an iterator var decl
        let isIterator: bool;
    }

    /**
     * Construct a VarDeclValue representing a variable declaration.
     *
     * @params:
     *   - loc:         the source location of the variable name
     *   - type:        the declared type of the variable
     *   - value:       the initializer expression
     *   - isMutable:   true iff the variable is declared mutable
     *   - isCte:       true iff the variable may be referenced as a compile-time
     *                  constant(default: true)
     *   - isReference: true iff the variable is a reference binding
     *   - isLazy:      true iff the variable is lazily evaluated
     *   - isIterator:  true iff the variable is an iterator binding
     *   - isReduced:   true iff the initializer has already been reduced
     *
     * The VarDeclValue is always an rvalue and always has type `Void`. The
     * declared variable’s type is stored in `varType`.
     *
     * The initializer’s control-flow metadata(throwers, breakers, returners) is
     * propagated to the declaration node.
     *
     * Declaring a variable that is both reference-bound and lazy is forbidden,
     * and checked.
     */
    pub self (loc:         &Word,
              type:        &Type,
              value:       &Value,
              isMutable:   bool,
              isCte:       bool = true,
              isReference: bool = false,
              isLazy:      bool = false,
              isIterator:  bool = false,
              isReduced:   bool = false)

        with super (loc, copy VoidType(loc), isReduced-> isReduced, isLvalue-> false)
        , value = value
        , isMutable = isMutable
        , isReference = isReference
        , varType = type
        , isCte = isCte
        , isLazy = isLazy
        , isIterator = isIterator
    {
        if (isReference && isLazy) panic;

        self._throwers = self.value.throwers;
        self._breakLoc = self.value.breakLoc;
        self._returnLoc = self.value.returnLoc;
    }


    /**
     * Construct a VarDeclValue representing a variable declaration, setting it's uniq ID(useful in function inlining).
     *
     */
    pub self (loc:         &Word,
              type:        &Type,
              value:       &Value,
              isMutable:   bool,
              isReference: bool,
              isLazy:      bool,
              isIterator:  bool,
              uniqId:      usize)

        with super (loc,
                    copy VoidType(loc),
                    isReduced-> true,
                    isLvalue-> false,
                    throwers-> value.throwers,
                    breakLoc-> EOF_WORD,
                    returnLoc-> EOF_WORD,
                    uniqId-> uniqId)

        , value = value
        , isMutable = isMutable
        , isReference = isReference
        , varType = type
        , isCte = false
        , isLazy = isLazy
        , isIterator = isIterator
    {
        if (isReference && isLazy) panic;

        self._throwers = self.value.throwers;
        self._breakLoc = self.value.breakLoc;
        self._returnLoc = self.value.returnLoc;
    }

    /**
     * @returns: the name of the var
     */
    @field
    pub fn name(self)-> [c8] {
        self.loc.str
    }

    /**
     * @returns true iff the declaration can be treated as a full literal.
     *
     * A variable declaration is a full literal only when:
     *   - the variable name is `_` (ignored binding), and
     *   - the initializer is itself a full literal.
     *
     * This is used during constant folding and literal propagation.
     */
    @field
    pub over isFullLiteral(self)-> bool {
        if (self.loc.str == Keys::UNDER) {
            return self.value.isFullLiteral;
        }

        false
    }

    /**
     * Create an exact copy of this VarDeclValue.
     *
     * VarDeclValue is immutable with respect to its identity, so cloning returns
     * the same instance.
     */
    pub over clone(self)-> &Value {
        self
    }

    impl Comparable!{&Generator} {

        /**
         * Compare two VarDeclValue instances structurally.
         *
         * Two VarDeclValues are equal iff:
         *   - their base Value fields are equal,
         *   - they originate from the same source location,
         *   - they declare the same type,
         *   - they share the same semantic flags(reference, lazy, mutable, cte, iterator).
         */
        pub over opEquals(self, o: &Generator)-> bool {
            if let p: &VarDeclValue = o {
                if (!self.super.opEquals(o)) return false;

                if (!self.loc.isSameLoc(p.loc)) return false;
                if (self.varType != p.varType) return false;
                if (self.isReference != p.isReference) return false;
                if (self.isLazy != p.isLazy) return false;
                if (self.isMutable != p.isMutable) return false;
                if (self.isCte != p.isCte) return false;
                if (self.isIterator != p.isIterator) return false;

                return true;
            }

            return false;
        }
    }


    impl Streamable;
    impl Formattable {

        /**
         * Write the variable declaration to the formatter.
         *
         * The printed form is:
         *
         *     let [ref] [lazy] [mut] name(: type) [= value]
         *
         * If the formatter has the `withVarIds` tag enabled, the unique ID of the
         * declaration is appended as:
         *
         *     name(#id)
         */
        pub over format(self, dmut stream: &Formatter) {
            if (self.isReference) stream:.write(Keys::REF, ' ');
            if (self.isLazy) stream:.write(Keys::LAZY, ' ');
            if (self.isMutable) stream:.write(Keys::MUTABLE, ' ');

            stream:.write(self.loc.str);
            if (stream.tags.withVarIds) {
                stream:.write("(#", std::conv::to!{[c8], 36} (self.uniqId), ')');
            }

            stream:.entabing();
            stream:.write(": ", self.varType);
            match self.value {
                UnitValue() => {}
                _ => {
                    stream:.write(" = ");
                    stream:.write(self.value);
                }
            }

            stream:.detabing();
        }
    }

}
