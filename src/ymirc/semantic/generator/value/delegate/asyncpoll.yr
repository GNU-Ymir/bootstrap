in asyncpoll;

use ymirc::lexing::{keys, word};
use ymirc::semantic::generator::type::native;
use ymirc::utils::{comparison, format};

use std::stream;


/**
 * AsyncPollDelegateValue models the fake method `.poll` of an async value.
 *
 * The call is rewritten into an AsyncPollValue resuming the async once,
 * the delegate is only a placeholder carrying the handle from the field access to
 * the call operator, and cannot be used as a value of its own.
 */
@final
pub class AsyncPollDelegateValue over DelegateValue {

    pub {
        /** The async handle resumed by the call. */
        let handle: &Value;
    }

    /**
     * @params:
     *   - loc:    source location of the field access
     *   - handle: the async handle, of type `(async-> T)`
     */
    pub self (loc: &Word, handle: &Value)
        with super (loc, NONE_TYPE, isReduced-> true, throwers-> handle.throwers)
        , handle = handle
    {}

    pub over clone(self)-> &Value {
        return copy AsyncPollDelegateValue(self.loc, self.handle.clone());
    }

    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /**
         * The printed form is `(handle).poll`.
         */
        pub over format(self, dmut stream: &Formatter) {
            if (stream.tags.forParams) {
                stream:.write("_");
            } else {
                stream:.write('(', self.handle, ").", AsyncKeys::POLL);
            }
        }
    }
}
