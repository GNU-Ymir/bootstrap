in fakemethod;

use ymirc::lexing::word;
use ymirc::utils::{format, comparison};

use std::stream;

use ymirc::semantic::generator::type::native;
use ymirc::semantic::generator::value::{prototype, variable, memory};

use ymirc::lexing::keys;

/**
 * FakeMethodDelegateValue models a “fake method call”: a method-syntax call
 * applied to a value that is *not* a class or struct instance.
 *
 * Ymir allows method syntax on certain built-in or composite types such as:
 *   - ranges (e.g., `r.step_by(2)`),
 *   - maps (e.g., `m:.remove(key)`),
 *   - other container-like values.
 *
 * These types do not define methods in the class sense. Instead, the compiler
 * rewrites such calls into static function calls where the left-hand side of
 * the dot expression is passed as the first parameter (by reference when
 * appropriate), mimicking struct-method semantics.
 *
 * FakeMethodDelegateValue therefore behaves like any delegate value, but its
 * invocation is rewritten at compile time into a static call when possible.
 *
 * The delegate captures:
 *   - the function prototype (`proto`),
 *   - the closure value (`closure`) passed as the first argument,
 *   - an optional pretty-print rename (`rename`) used for formatting.
 *
 * It participates in structural comparison, cloning, and formatted output. It
 * is never an lvalue. Throwers are inherited from the closure.
 */

@final
pub class FakeMethodDelegateValue over DelegateValue {

    pub {
        
        /**
         * The prototype of the function being invoked.
         *
         * This is the static function that implements the fake method. The
         * first parameter of this prototype corresponds to the closure value
         * (the left-hand side of the dot call).
         */        
        let proto: &PrototypeValue;

        /**
         * The closure value passed as the first parameter of the call.
         *
         * This is the left-hand side of the dot expression. It is passed by
         * reference when required by the prototype.
         */        
        let closure: &Value;

        /**
         * A pretty-print rename for the method name.
         *
         * This is used only for formatting. If empty, a name is derived from
         * the prototype.
         */        
        let rename: [c8];
    }

    /**
     * Construct a FakeMethodDelegateValue.
     *
     * @params:
     *   - loc:     source location of the fake method expression
     *   - proto:   the function prototype implementing the fake method
     *   - closure: the value passed as the first parameter
     *   - rename:  optional pretty-print override for the method name
     *
     * Fake method delegates are always considered reduced. Throwers are
     * inherited from the closure value.
     */
    pub self (loc:     &Word,
              proto:   &PrototypeValue,
              closure: &Value,
              rename:  [c8] = ""s8)
        
        with super (loc, NONE_TYPE, isReduced-> true, throwers-> closure.throwers)
        , proto = proto
        , closure = closure
        , rename = delegate::fakemethod::getProtoSimpleName (proto, rename)
        
    {}

    /**
     * A fake method delegate is a full literal only when the closure is a full
     * literal. The prototype and rename do not affect literalness.
     */
    @field
    pub over isFullLiteral (self)-> bool {
        self.closure.isFullLiteral 
    }

    /**
     * Create a deep clone of this FakeMethodDelegateValue.
     *     
     */
    pub over clone (self)-> &Value {
        return copy FakeMethodDelegateValue (self.loc,
                                             self.proto,
                                             self.closure.clone (),
                                             protoName-> self.rename);
    }

    
    impl Comparable!{&Generator};
    
    impl Streamable;
    impl Formattable {

        /**
         * Format the fake method delegate for debugging or diagnostic output.
         *
         * When formatting parameters (`forParams` tag), the delegate is printed
         * as "_".
         *
         * When formatting with parameters (`withParams` tag), the printed form
         * resembles a method signature:
         *
         *     closure.rename(param1, param2, ...) -> returnType
         *
         * The first parameter of the prototype (the closure) is omitted from
         * the printed parameter list to match the appearance of real method
         * delegates.
         *
         * Otherwise, the printed form is:
         *
         *     {closure; proto}
         *
         * This representation is intended for semantic debugging and error
         * reporting, not for code generation.
         */
        pub over format (self, dmut stream: &Formatter) {
            if (stream.tags.forParams) {
                stream:.write ("_");
            } else {
                if (stream.tags.withParams) {
                    match self.closure {
                        r: &ReferencerValue => { stream:.write (r.value); }
                        _ => {
                            stream:.write (self.closure);
                        }
                    }

                    stream:.write (".", self.rename, " (");
                    stream:.entabing ();
                    for i, j in self.proto.params [1us .. $] { // fst param is the closure, and shouldn't be printed in the delegate to match other delegate prototypes
                        if (i != 0us) stream:.write (", ");
                        j.format (alias stream);
                    }
                    stream:.write (")-> ");
                    self.proto.retType.format (alias stream);
                    stream:.detabing ();
                } else {
                    stream:.write ('{', self.closure, ';', self.proto, '}');
                }
            }
        }

    }

}

/**
 * Compute the pretty-print name of a fake method.
 *
 * If a rename was explicitly provided, it is returned. Otherwise, the name is
 * derived from the prototype:
 *
 *   - For NamePrototypeValue, the file-level name is used.
 *   - For other prototype types, the symbol path’s file name is used.
 *
 * This ensures that fake methods have readable names in formatted output.
 */
fn getProtoSimpleName (proto: &PrototypeValue, protoRename: [c8])-> [c8] {
    if (protoRename != "") return protoRename;

    match proto {
        n: &NamePrototypeValue => {
            n.name.file 
        }
        p: _ => {
            p.sym.path.file
        }
    }
}
