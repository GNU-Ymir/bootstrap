 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in name;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::type::native;
use ymirc::semantic::generator::value::prototype;


/**
 * NameDelegateValue models a delegate created from a NamePrototypeValue.
 *
 * NamePrototypeValue represents functions that:
 *   - originate from lambda expressions,
 *   - refer to runtime or foreign functions,
 *   - or do not follow the naming conventions of Ymir modules.
 *
 * Such functions may require renaming to ensure uniqueness or to indicate that
 * they originate outside a Ymir package. NameDelegateValue wraps these
 * prototypes into a proper delegate value, capturing:
 *
 *   - the function prototype(`proto`),
 *   - the closure value(`closure`), which is UNIT_VALUE for non-capturing
 *     functions and a real value for lambdas,
 *   - the fully constructed delegate type(built from refs/lazys/params/retType),
 *   - whether the delegate originates from a function pointer(`fromFptr`).
 *
 * NameDelegateValue participates in structural comparison, cloning, and
 * formatted output. It is never an lvalue. Throwers are inherited from the
 * closure.
 */
@final
pub class NameDelegateValue over DelegateValue {

    pub {
        /**
         * The prototype of the function referenced by this delegate.
         *
         * NamePrototypeValue identifies functions that may not follow Ymir’s
         * module naming conventions, including lambdas and external functions.
         */
        let proto: &NamePrototypeValue;

        /**
         * The closure value captured by the delegate.
         *
         * For lambdas, this is the captured environment. For external or
         * non-capturing functions, this is typically UNIT_VALUE.
         */
        let closure: &Value;
    }

    /**
     * Construct a NameDelegateValue.
     *
     * @params:
     *   - loc:      source location of the delegate expression
     *   - proto:    the name-based function prototype
     *   - closure:  the captured closure value(UNIT_VALUE if none)
     *   - refs:     reference flags for each parameter
     *   - lazys:    laziness flags for each parameter
     *   - params:   the parameter types of the delegate
     *   - retType:  the return type of the delegate
     *   - fromFptr: true iff the delegate originates from a function pointer
     *
     * The delegate type is constructed from the provided parameter metadata.
     * Name delegates are always considered reduced. Throwers are inherited from
     * the closure.
     */
    pub self (loc:      &Word,
              proto:    &NamePrototypeValue,
              closure:  &Value,
              refs:     [bool],
              lazys:    [bool],
              params:   [&Type],
              retType:  &Type,
              isFromFptr: bool = false)

        with super (loc,
                    copy DelegateType(loc, refs, lazys, params, retType,
                                      isFromFptr-> isFromFptr,
                                      isMutable-> false),
                    isReduced-> true,
                    throwers-> closure.throwers)

        , proto = proto
        , closure = closure
    {}


    /**
     * Internal constructor used exclusively for cloning.
     *
     * Reuses the existing delegate type instead of reconstructing it from
     * prototype metadata.
     */
    prv self (loc:     &Word,
              proto:   &NamePrototypeValue,
              closure: &Value,
              type:    &Type)

        with super (loc, type, isReduced-> true, throwers-> closure.throwers)
        , proto = proto
        , closure = closure

    {}

    /**
     * A name delegate is a full literal only when the closure is a full
     * literal. The prototype and delegate type do not affect literalness.
     */
    @field
    pub over isFullLiteral(self)-> bool {
        self.closure.isFullLiteral
    }

    /**
     * Create a deep clone of this NameDelegateValue.
     *
     * The closure is recursively cloned. The prototype and delegate type are
     * reused, as they are immutable semantic descriptors.
     */
    pub over clone(self)-> &Value {
        return copy NameDelegateValue(self.loc,
                                      self.proto,
                                      self.closure.clone(),
                                      self.type);
    }

    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /**
         * Format the name delegate for debugging or diagnostic output.
         *
         * When formatting parameters(`forParams` tag), the delegate is printed
         * as "_".
         *
         * When formatting with parameters(`withParams` tag), the printed form
         * is simply the delegate type.
         *
         * Otherwise, the printed form is:
         *
         *     {closure; proto}
         *
         * This representation is intended for semantic debugging and error
         * reporting, not for code generation.
         */
        pub over format(self, dmut stream: &Formatter) {
            if (stream.tags.forParams) {
                stream:.write("_");
            } else {
                if (stream.tags.withParams) {
                    stream:.write(self.type);
                } else {
                    stream:.write('{', self.closure, ';', self.proto, '}');
                }
            }
        }

    }

}
