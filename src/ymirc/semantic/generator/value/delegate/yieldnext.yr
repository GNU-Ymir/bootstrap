in yieldnext;

use ymirc::lexing::{keys, word};
use ymirc::semantic::generator::type::native;
use ymirc::utils::{comparison, format};

use std::stream;


/**
 * YieldNextDelegateValue models the fake method `.next` of a generator.
 *
 * Unlike other fake methods, `next` is not implemented by a core function: the
 * call is rewritten into a resumption of the generator, whose result is wrapped
 * into an option. The delegate is therefore only a placeholder carrying the
 * generator from the field access to the call operator, and cannot be used as a
 * value of its own.
 */
@final
pub class YieldNextDelegateValue over DelegateValue {

    pub {
        /** The generator handle resumed by the call. */
        let generator: &Value;

        /** True iff the generator was aliased, its values being borrowed mutably. */
        let byAlias: bool;
    }

    /**
     * @params:
     *   - loc:       source location of the field access
     *   - generator: the generator handle, of type `(yield-> T)`
     *   - byAlias:   true iff the generator was aliased
     */
    pub self (loc: &Word, generator: &Value, byAlias: bool = false)
        with super (loc, NONE_TYPE, isReduced-> true, throwers-> generator.throwers)
        , generator = generator
        , byAlias = byAlias
    {}

    pub over clone(self)-> &Value {
        return copy YieldNextDelegateValue(self.loc, self.generator.clone(), byAlias-> self.byAlias);
    }

    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /**
         * The printed form is `(generator).next`.
         */
        pub over format(self, dmut stream: &Formatter) {
            if (stream.tags.forParams) {
                stream:.write("_");
            } else {
                stream:.write('(', self.generator, ").", GeneratorKeys::NEXT);
            }
        }
    }
}
