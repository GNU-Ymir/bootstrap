in ctor;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::value::{literal, prototype};
use ymirc::semantic::generator::type::native;

/**
 * The CtorDelegateValue class represents a delegate bound to a constructor
 * prototype. In Ymir, constructors are not directly callable without an
 * instance; instead, a delegate is used to associate:
 *
 *   - the constructor prototype,
 *   - the instance being constructed(or UNIT_VALUE if the instance must be
 *     allocated at runtime),
 *   - an optional "nextCtor" delegate used for child‑class field initialization.
 *
 * This delegate is central to Ymir’s constructor‑chaining model. When a class
 * has children, the parent constructor must run *after* the child’s field
 * initialization logic. This is achieved by passing a delegate(`nextCtor`)
 * that performs child‑field initialization before invoking the parent
 * constructor body.
 *
 * CtorDelegateValue therefore models:
 *   - direct constructor calls,
 *   - chained constructor calls in inheritance hierarchies,
 *   - implicit instance allocation when needed,
 *   - propagation of throwers from the instance and nextCtor values.
 *
 * Literal status is true only when:
 *   - the instance is a full literal, and
 *   - nextCtor is UNIT_VALUE(i.e., no child‑field constructor is involved).
 *
 * This class participates in structural comparison, cloning, and formatted
 * output for debugging and diagnostic purposes.
 *
 */
@final
pub class CtorDelegateValue over DelegateValue {

    pub {

        /**
         * The instance on which the constructor will be invoked.
         *
         * If this is UNIT_VALUE, the instance is allocated at runtime before
         * the constructor call. Otherwise, it must be a ClassPtrType value.
         */
        let instance: &Value;

        /**
         * The constructor prototype to invoke.
         *
         * This defines the parameter list, the class being constructed, and the
         * constructor’s semantic behavior.
         */
        let proto: &CtorPrototypeValue;

        /**
         * The type produced by invoking this constructor.
         *
         * This is typically the class type associated with the prototype.
         */
        let retType: &Type;

        /**
         * The delegate responsible for constructing child‑class fields before
         * the current constructor executes.
         *
         * In Ymir’s constructor model, a class constructor must run only after
         * all fields of *derived* classes have been initialized. This ensures
         * that if the constructor body calls an overridden method, the child’s
         * fields are already valid.
         *
         * To achieve this, constructors receive an additional delegate
         * parameter — `nextCtor` — which represents the “child field
         * constructor”. The execution model is:
         *     ```
         *     ParentCtor(instance, params, nextCtor) {
         *         // Initialize parent fields
         *         nextCtor();            // Initialize child fields
         *         // Execute parent ctor body
         *     }
         *
         *     ChildCtor(instance, params, nextCtor) {
         *         // Build a delegate that initializes child fields, then calls nextCtor
         *         let childFieldDelegate = ChildFieldCtorDelegate(nextCtor);
         *
         *         // Call parent constructor with the child field delegate
         *         ParentCtor(instance, parentParams, childFieldDelegate);
         *
         *         // Execute child ctor body
         *     }
         *
         *     ChildFieldCtorDelegate(next) {
         *         // Initialize child fields
         *         next();                // Continue the chain
         *     }
         *     ```
         *
         * The `nextCtor` chain therefore encodes the entire inheritance
         * initialization sequence. Each constructor is responsible for:
         *   - initializing its own fields,
         *   - invoking `nextCtor` to initialize the next level of the hierarchy,
         *   - then executing its constructor body.
         *
         * When `nextCtor` is UNIT_VALUE, it means:
         *   - this constructor is the most derived one,
         *   - there are no child fields to initialize,
         *   - the constructor can proceed without chaining.
         *
         * This mechanism ensures correct initialization order and safe use of
         * overridden methods during construction.
         */
        let nextCtor: &Value;
    }

    /**
     * Creates a constructor delegate.
     *
     * Parameters:
     *   - loc:       the source location of the delegate expression.
     *   - type:      the return type of the constructor(the class type).
     *   - proto:     the constructor prototype to invoke.
     *   - instance:  the instance to construct(UNIT_VALUE for runtime allocation).
     *   - nextCtor:  the child‑field constructor delegate(UNIT_VALUE if none).
     *   - isReduced: whether the delegate has already been reduced.
     *
     * Throwers are aggregated from the instance and nextCtor values. The
     * delegate itself is never an lvalue.
     */
    pub self (loc:       &Word,
              type:      &Type,
              proto:     &CtorPrototypeValue,
              instance:  &Value = UNIT_VALUE,
              nextCtor:  &Value = UNIT_VALUE,
              isReduced: bool = false)

        with super (loc,
                    NONE_TYPE,
                    isReduced-> isReduced,
                    throwers-> (instance.throwers ~ nextCtor.throwers))

        , instance = instance
        , proto = proto
        , retType = type
        , nextCtor = nextCtor
    {}

    /**
     * Indicates whether the constructor delegate is a full literal.
     *
     * A CtorDelegateValue is a full literal only when:
     *   - the instance is a full literal, and
     *   - nextCtor is UNIT_VALUE(i.e., no child‑field constructor is needed).
     */
    @field
    pub over isFullLiteral(self)-> bool {
        self.instance.isFullLiteral && self.nextCtor of UnitValue
    }

    /**
     * Creates a deep clone of this CtorDelegateValue.
     *
     */
    pub over clone(self)-> &Value {
        return copy CtorDelegateValue(self.loc,
                                       self.retType,
                                       self.proto,
                                       instance-> self.instance.clone(),
                                       nextCtor-> self.nextCtor.clone(),
                                       isReduced-> self.isReduced);
    }

    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /**
         * Formats the constructor delegate for debugging or diagnostic output.
         *
         * Printed as:
         *     CtorProto(instance, nextCtor)
         *
         * When formatting parameters(stream.tags.forParams == true),
         * the literal is printed as "_".
         */
        pub over format(self, dmut stream: &Formatter) {
            if (stream.tags.forParams) {
                stream:.write("_");
            } else {
                stream:.write(self.proto);
                stream:.entabing();
                if self.instance !of UnitValue {
                    stream:.write('(');
                    stream:.write(self.instance);
                    if self.nextCtor !of UnitValue {
                        stream:.write(", ");
                        stream:.write(self.nextCtor);
                    }
                    stream:.write(')');
                }

                stream:.detabing();
            }
        }
    }
}
