in methodtemplate;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::type::native;
use ymirc::semantic::generator::value::template_;

/**
 * MethodDelegateTemplateValue models a reference to a *templated method* that
 * has not yet been fully specialized.
 *
 * Unlike MethodDelegateValue, which refers to a concrete method prototype,
 * MethodDelegateTemplateValue refers to a TemplateRefMethodValue whose template
 * parameters are still unresolved. Such a delegate:
 *
 *   - cannot be addressed with the unary '&' operator,
 *   - cannot be stored as a first-class delegate value,
 *   - must first be specialized through a template call, or
 *   - may be implicitly specialized through a standard method call.
 *
 * Template methods are never virtual. Their specializations are not part of
 * the class vtable, and the number of possible instantiations may be unbounded,
 * making pre-emptive vtable population impossible.
 *
 * This value therefore represents a *pending* method reference that will be
 * transformed into a MethodDelegateValue once template arguments are known.
 *
 * MethodDelegateTemplateValue participates in structural comparison, cloning,
 * and formatted output. It is never an lvalue. Throwers are inherited from the
 * closure.
 */

@final
pub class MethodDelegateTemplateValue over DelegateValue {

    pub {
        /**
         * The template method reference.
         *
         * This identifies the method template that will be specialized once
         * template arguments are provided explicitly or implicitly.
         */
        let proto: &TemplateRefMethodValue;

        /**
         * The closure value on which the method will eventually be invoked.
         *
         * For class methods, this is the class instance. For struct methods,
         * the struct value is passed by reference.
         */
        let closure: &Value;

        /**
         * True iff the delegate is bound to a struct method.
         *
         * Struct methods always receive their closure by reference. This flag
         * influences call lowering once the template is specialized.
         */
        let isStruct: bool;
    }

    /**
     * Construct a MethodDelegateTemplateValue.
     *
     * @params:
     *   - loc:      source location of the method reference
     *   - proto:    the template method reference
     *   - closure:  the instance or struct value on which the method is invoked
     *   - isStruct: true iff the closure is a struct
     *
     * Template method delegates are always considered reduced. Throwers are
     * inherited from the closure value.
     */
    pub self (loc:      &Word,
              proto:    &TemplateRefMethodValue,
              closure:  &Value,
              isStruct: bool)

        with super (loc, NONE_TYPE, isReduced-> true, throwers-> closure.throwers)
        , proto = proto
        , closure = closure
        , isStruct = isStruct
    {}

    /**
     * A templated method delegate is a full literal only when the closure is a
     * full literal. Template status does not affect literalness.
     */
    @field
    pub over isFullLiteral(self)-> bool {
        self.closure.isFullLiteral()
    }

    /**
     * Create a deep clone of this MethodDelegateTemplateValue.
     *
     */
    pub over clone(self)-> &Value {
        return copy MethodDelegateTemplateValue(self.loc,
                                                 self.proto,
                                                 self.closure.clone(),
                                                 isStruct-> self.isStruct);
    }

    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /**
         * Format the templated method delegate for debugging or diagnostic
         * output.
         *
         * When formatting parameters(`forParams` tag), the delegate is printed
         * as "_".
         *
         * When formatting with parameters(`withParams` tag), the printed form
         * is:
         *
         *     closure.proto
         *
         * Otherwise, the printed form is:
         *
         *     {.func = proto, .closure = closure}
         *
         * This representation is intended for semantic debugging and error
         * reporting, not for code generation.
         */
        pub over format(self, dmut stream: &Formatter) {
            if (stream.tags.forParams) {
                stream:.write("_");
            } else {
                if (stream.tags.withParams) {
                    stream:.write(self.closure, ".", self.proto);
                } else {
                    stream:.write("{.func = ", self.proto, ", .closure = ", self.closure, "}");
                }
            }
        }

    }

}
