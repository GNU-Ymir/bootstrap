in rangereverse;

use ymirc::lexing::{keys, word};
use ymirc::semantic::generator::type::native;
use ymirc::utils::{comparison, format};

use std::stream;


/**
 * RangeReverseDelegateValue models the fake method `.reverse` of a range.
 *
 * The call is rewritten into a new range literal holding the same elements in the
 * opposite order, so the delegate is only a placeholder carrying the range from the
 * field access to the call operator, and cannot be used as a value of its own.
 */
@final
pub class RangeReverseDelegateValue over DelegateValue {

    pub {
        /** The range being reversed. */
        let range: &Value;
    }

    /**
     * @params:
     *   - loc:   source location of the field access
     *   - range: the range, of type `..T`
     */
    pub self (loc: &Word, range: &Value)
        with super (loc, NONE_TYPE, isReduced-> true, throwers-> range.throwers)
        , range = range
    {}

    pub over clone(self)-> &Value {
        return copy RangeReverseDelegateValue(self.loc, self.range.clone());
    }

    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /**
         * The printed form is `(range).reverse`.
         */
        pub over format(self, dmut stream: &Formatter) {
            if (stream.tags.forParams) {
                stream:.write("_");
            } else {
                stream:.write('(', self.range, ").", RangeKeys::REVERSE);
            }
        }
    }
}
