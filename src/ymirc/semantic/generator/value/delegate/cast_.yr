in cast_;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::type::native;
use ymirc::semantic::generator::value::{memory, variable, prototype};

/**
 * The FptrCastDelegateValue class represents the construction of a delegate
 * from a plain function pointer. This occurs when a function pointer is cast to
 * a delegate type, requiring the compiler to synthesize a delegate wrapper.
 *
 * In this construction, the delegate’s closure is implicitly `null`, and the
 * generated delegate forwards all calls to the underlying function pointer.
 * This allows function pointers to be used in contexts expecting a delegate,
 * while preserving the delegate call semantics.
 *
 * FptrCastDelegateValue:
 *   - wraps the original function pointer,
 *   - produces a delegate type with a null closure,
 *   - is always reduced by construction,
 *   - inherits literal status from the wrapped function pointer.
 *
 */
@final
pub class FptrCastDelegateValue over DelegateValue {

    pub {
        /**
         * The underlying function pointer being cast to a delegate.
         *
         */
        let value: &Value;
    }

    /**
     * Creates a delegate from a function pointer.
     *
     * Parameters:
     *   - loc:   the source location of the cast expression.
     *   - type:  the resulting delegate type.
     *   - value: the function pointer being cast.
     *
     * The delegate is always considered reduced. The closure is implicitly null
     * and is not stored explicitly; concrete delegate invocation logic handles
     * this case.
     */
    pub self (loc: &Word, type: &DelegateType, value: &Value)
        with super (loc,
                    type,
                    isReduced-> true,
                    throwers-> value.throwers)

        , value = value
    {}

    /**
     * Indicates whether the delegate literal is a full literal.
     *
     * A FptrCastDelegateValue is a full literal only if the underlying function
     * pointer is itself a full literal.
     */
    @field
    pub over isFullLiteral (self)-> bool {
        self.value.isFullLiteral
    }

    /**
     * Creates a deep clone of this FptrCastDelegateValue.
     *
     */
    pub over clone (self)-> &Value {
        if let d: &DelegateType = self.type {
            return copy FptrCastDelegateValue (self.loc,
                                               d,
                                               self.value.clone ());

        }

        panic;
    }

    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {
        pub over format (self, dmut stream: &Formatter) {

            /**
             * Formats the delegate cast for debugging or diagnostic output.
             *
             * Printed as:
             *     cast(delegate(fptr))
             *
             * When formatting parameters (stream.tags.forParams == true),
             * the literal is printed as "_".
             */
            if (stream.tags.forParams) {
                stream:.write ("_");
            } else {
                stream:.write (Keys::CAST, '(', Keys::DELEGATE, "(", self.value, ")");
            }
        }
    }
}
