 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in ctortemplate;

use ymirc::lexing::{word, keys};
use ymirc::utils::{format, comparison};
use std::stream;

use ymirc::semantic::generator::type::native;
use ymirc::semantic::generator::value::{literal, template_};

/**
 * CtorDelegateTemplateValue models a delegate bound to a *templated*
 * constructor prototype.
 *
 * In Ymir, constructor templates behave like normal constructors except that
 * they are not fully specialized until:
 *   - a template call provides explicit template arguments, or
 *   - a standard constructor call implicitly triggers specialization.
 *
 * This value therefore represents a constructor delegate whose prototype
 * (`proto`) still contains template parameters. Once specialization occurs,
 * this node is replaced by a concrete CtorDelegateValue.
 *
 * The delegate captures:
 *   - the template constructor reference (`proto`),
 *   - the instance being constructed (`instance`), or UNIT_VALUE if the
 *     instance must be allocated at runtime,
 *   - the child-field constructor delegate (`nextCtor`), which encodes the
 *     inheritance-level initialization chain,
 *   - the resulting type (`retType`) once the constructor is fully resolved.
 *
 */
@final
pub class CtorDelegateTemplateValue over DelegateValue {

    pub {
        /**
         * The template constructor reference.
         *
         * This identifies the constructor template that will be specialized
         * once template arguments are known. It contains the template parameter
         * list and the unspecialized constructor body.
         */
        let proto: &TemplateRefCtorValue;

        /**
         * The instance on which the constructor will eventually be invoked.
         *
         * If UNIT_VALUE, the instance is allocated at runtime before the
         * constructor call. Otherwise, it must be a ClassPtrType value.
         */
        let instance: &Value;

        /**
         * The type produced by invoking the constructor once specialization is
         * complete.
         *
         * This is typically the class type associated with the constructor
         * template after template arguments have been resolved.
         */
        let retType: &Type;

        /**
         * The delegate responsible for constructing child-class fields before
         * the current constructor executes.
         *
         * This is identical in purpose to the `nextCtor` field of
         * CtorDelegateValue. When UNIT_VALUE, no child-field initialization is
         * required.
         */
        let nextCtor: &Value;
    }

    /**
     * Construct a CtorDelegateTemplateValue.
     *
     * @params:
     *   - loc:       source location of the constructor delegate expression
     *   - type:      the resulting type of the constructor (after specialization)
     *   - proto:     the template constructor reference
     *   - instance:  the instance to construct (UNIT_VALUE for runtime allocation)
     *   - nextCtor:  the child-field constructor delegate (UNIT_VALUE if none)
     *
     * This value is always considered reduced. Throwers are aggregated from the
     * instance and nextCtor values.
     */
    pub self (loc:      &Word,
              type:     &Type,
              proto:    &TemplateRefCtorValue,
              instance: &Value = UNIT_VALUE,
              nextCtor: &Value = UNIT_VALUE)
        with super (loc,
                    NONE_TYPE,
                    isReduced-> true,
                    throwers-> (instance.throwers ~ nextCtor.throwers))

        , proto = proto
        , instance = instance
        , retType = type
        , nextCtor = nextCtor
    {}

    /**
     * A templated constructor delegate is a full literal only when:
     *   - the instance is a full literal, and
     *   - nextCtor is UNIT_VALUE (i.e., no child‑field constructor is needed).
     *
     * This mirrors the literal rules of CtorDelegateValue.
     */
    @field
    pub over isFullLiteral (self)-> bool {
        self.instance.isFullLiteral && self.nextCtor of UnitValue
    }

    /**
     * Create a deep clone of this CtorDelegateTemplateValue.
     *
     */
    pub over clone (self)-> &Value {
        return copy CtorDelegateTemplateValue (self.loc,
                                               self.retType,
                                               self.proto,
                                               instance-> self.instance.clone (),
                                               nextCtor-> self.nextCtor.clone ());
    }

    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /**
         * Format the templated constructor delegate for debugging or diagnostic
         * output.
         *
         * When formatting parameters (`forParams` tag), the delegate is printed
         * as "_".
         *
         * Otherwise, the printed form is:
         *
         *     TemplateCtor(instance, nextCtor)
         *
         * The instance and nextCtor are omitted when they are UNIT_VALUE.
         *
         * This representation is intended for semantic debugging and error
         * reporting, not for code generation.
         */
        pub over format (self, dmut stream: &Formatter) {
            if (stream.tags.forParams) {
                stream:.write ("_");
            } else {
                stream:.write (self.proto);
                if self.instance !of UnitValue {
                    stream:.write ('(');
                    stream:.write (self.instance);
                    if self.nextCtor !of UnitValue {
                        stream:.write (", ");
                        stream:.write (self.nextCtor);
                    }
                    stream:.write (')');
                }
            }
        }
    }
}
