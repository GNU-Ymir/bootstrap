in enumvalueof;

use ymirc::lexing::{keys, word};
use ymirc::semantic::generator::type::{custom, native};
use ymirc::utils::{comparison, format};

use std::stream;


/**
 * EnumValueOfDelegateValue models the fake method `E::__valueOf__` of an enum type.
 *
 * The call is rewritten into the field of the enum named by its argument, wrapped
 * in an option, so the delegate is only a placeholder carrying the enum from the
 * path access to the call operator, and cannot be used as a value of its own.
 */
@final
pub class EnumValueOfDelegateValue over DelegateValue {

    pub {
        /** The enum whose fields are looked up. */
        let en: &EnumType;
    }

    /**
     * @params:
     *   - loc: source location of the path access
     *   - en:  the enum type
     */
    pub self (loc: &Word, en: &EnumType)
        with super (loc, NONE_TYPE, isReduced-> true, throwers-> [])
        , en = en
    {}

    pub over clone(self)-> &Value {
        return copy EnumValueOfDelegateValue(self.loc, self.en);
    }

    impl Comparable!{&Generator};

    impl Streamable;
    impl Formattable {

        /**
         * The printed form is `E::valueOf`.
         */
        pub over format(self, dmut stream: &Formatter) {
            if (stream.tags.forParams) {
                stream:.write("_");
            } else {
                stream:.write(self.en, "::", EnumKeys::VALUE_OF);
            }
        }
    }
}
