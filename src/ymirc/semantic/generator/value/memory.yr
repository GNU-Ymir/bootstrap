in memory;

use ymirc::lexing::word;
use ymirc::utils::{format, comparison};
use ymirc::semantic::generator::type;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

mod ::address;
mod ::aliaser;
mod ::class_aliaser;
mod ::copier;
mod ::dereferencer;
mod ::expand_;
mod ::future_;
mod ::lazy_;
mod ::map_aliaser;
mod ::move_;
mod ::referencer;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          TYPES          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub def AddressValue:      address::AddressValue;
pub def AliaserValue:      aliaser::AliaserValue;
pub def ClassAliaserValue: class_aliaser::ClassAliaserValue;
pub def CopierValue:       copier::CopierValue;
pub def DereferencerValue: dereferencer::DereferencerValue;
pub def ExpandValue:       expand_::ExpandValue;
pub def FutureValue:       future_::FutureValue;
pub def LazyValue:         lazy_::LazyValue;
pub def MapAliaserValue:   map_aliaser::MapAliaserValue;
pub def MoverValue:        move_::MoverValue;
pub def ReferencerValue:   referencer::ReferencerValue;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          ANCESTOR          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */


/**
 * Abstract ancestor of all memory-movement and memory-manipulation values.
 *
 * MemoryValue represents any generator value that performs a memory-related
 * operation, such as taking an address, creating a reference, dereferencing,
 * copying, aliasing, or moving a value. It centralizes the semantic properties
 * shared by all such operations.
 *
 * MemoryValue is never a full literal, since memory operations always imply
 * runtime behavior or side effects.
 */
@abstract
pub class MemoryValue over Value {

    /**
     * Construct a MemoryValue.
     *
     * @params:
     *   - loc:       source location of the memory operation
     *   - type:      resulting type of the memory operation
     *   - throwers:  list of throwers inherited or introduced by the operation
     *   - isReduced: true iff the operation has already been semantically reduced
     *   - isLvalue:  true iff the result of the operation is an lvalue
     *
     * This constructor forwards all semantic properties to the base Value class.
     * Concrete subclasses specify their own throwers and lvalue semantics.
     */
    pub self (loc:       &Word,
              type:      &Type,
              throwers:  [Thrower],
              isReduced: bool,
              isLvalue:  bool)
        
        with super (loc,
                    type,
                    throwers-> throwers,
                    isReduced-> isReduced,
                    isLvalue-> isLvalue)
        
    {}

    /**
     * @returns false
     * */
    @field
    pub over isFullLiteral (self)-> bool {
        false
    }

    impl Comparable!{&Generator};
}
