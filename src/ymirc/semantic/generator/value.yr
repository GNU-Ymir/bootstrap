in value;

use ymirc::lexing::word;
use ymirc::utils::{format, comparison};

use std::stream;
use ymirc::semantic::generator::type;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub mod ::delegate;
pub mod ::literal;
pub mod ::memory;
pub mod ::multsym;
pub mod ::operator;
pub mod ::prototype;
pub mod ::scope;
pub mod ::syntax;
pub mod ::template_;
pub mod ::variable;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          ANCESTOR          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */


// Global counter used to assign a unique identifier to each Value instance.
lazy dmut __ID__: [usize] = copy [0us];

/**
 * Generate a fresh unique identifier.
 *
 * @returns a unique integer such that no two values share the same ID.
 */
pub fn generateUniqID()-> usize {
    __ID__[0] += 1us;
    __ID__[0]
}

/**
 * Represents an exception that may be thrown by a value or one of its sub-values.
 *
 * This structure is used to track control-flow effects and ensure that thrown
 * exceptions are either handled or propagated correctly during validation.
 *
 */
pub record Thrower {
    pub let loc: &Word;   // Source location of the throw
    pub let type: &Type;  // Type of the thrown value

    pub self (loc: &Word, type: &Type)
        with loc = loc
        , type = type
    {}
}

/**
 *
 * Base class for all semantic values produced during validation.
 *
 * A `Value` represents the fully-resolved semantic form of an expression
 * appearing in user code. Concrete subclasses describe literals, variable
 * references, operators, memory accesses, control-flow constructs, and all
 * other expression forms.
 *
 * Each `Value` is responsible for:
 *   - describing its type and source location,
 *   - tracking exceptions it may throw during evaluation,
 *   - tracking control-flow effects(return, break),
 *   - indicating whether it is an lvalue,
 *   - exposing whether it has been reduced by the compile-time interpreter,
 *   - generating the corresponding YIL nodes.
 *
 */
@abstract
pub class Value over Generator {

    /*! Public fields */
    pub {

        // A uniq Id used to refere to the value in other values(example, variables).
        let uniqId: usize;

        // The type of the value
        let type: &Type;

        // True iff the value was produced by the compile-time interpreter and
        // is already in its minimal reduced form.
        let isReduced: bool = false;

        // True iff the value can appear on the left-hand side of an assignment.
        // This does not check mutability—only whether `self = X` is meaningful.
        let isLvalue: bool = false;
    }

    prot {
        // The list of types that can be thrown by the value
        let mut _throwers: [Thrower] = [];

        // Location of a return statement that forces evaluation to exit the
        // current function frame. EOF_WORD means “no return”.
        let mut _returnLoc: &Word = EOF_WORD;

        // Location of a break statement that forces evaluation to exit the
        // current loop. EOF_WORD means “no break”.
        let mut _breakLoc: &Word = EOF_WORD;

    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          CTORS          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Construct a new value.
     *
     * @params:
     *   - loc:       source location of the value
     *   - type:      semantic type of the value
     *   - throwers:  list of exceptions the value may throw
     *   - returnLoc: location of a return that forces evaluation to exit the frame
     *   - breakLoc:  location of a break that forces evaluation to exit a loop
     *   - isReduced: true iff produced by the compile-time interpreter
     *   - isLvalue:  true iff the value can appear on the left side of an assignment
     *
     */
    pub self (loc:       &Word,
              type:      &Type,
              throwers:  [Thrower] = [],
              returnLoc: &Word = EOF_WORD,
              breakLoc:  &Word = EOF_WORD,
              isReduced: bool,
              isLvalue: bool)

        with self (loc,
                   type,
                   throwers,
                   returnLoc,
                   breakLoc,
                   isReduced,
                   isLvalue,
                   uniqId-> generateUniqID())

    {}

    /**
     * Construct a new value.
     *
     * @params:
     *   - loc:       source location of the value
     *   - type:      semantic type of the value
     *   - throwers:  list of exceptions the value may throw
     *   - returnLoc: location of a return that forces evaluation to exit the frame
     *   - breakLoc:  location of a break that forces evaluation to exit a loop
     *   - isReduced: true iff produced by the compile-time interpreter
     *   - isLvalue:  true iff the value can appear on the left side of an assignment
     *   - uniqId:    force the uniq Id of the value
     */
    pub self (loc:       &Word,
              type:      &Type,
              throwers:  [Thrower],
              returnLoc: &Word,
              breakLoc:  &Word,
              isReduced: bool,
              isLvalue:  bool,
              uniqId:    usize)

        with super (loc)
        , type = type
        , throwers = throwers
        , returnLoc = returnLoc
        , breakLoc = breakLoc
        , isReduced = isReduced
        , isLvalue = isLvalue
        , uniqId = uniqId

    {}

    /**
     * @returns the list of exceptions that may be thrown by this value.
     */
    @{field, final}
    pub fn throwers(self)-> [Thrower] {
        self._throwers
    }

    /**
     * @returns true iff evaluation of this value always triggers a return.
     */
    @field
    pub fn isReturner(self)-> bool {
        !self._returnLoc.isEof
    }

    /**
     * @returns true iff evaluation of this value always triggers a break.
     */
    @field
    pub fn isBreaker(self)-> bool {
        !self._breakLoc.isEof
    }

    /**
     * @returns the location of the break statement inside this value.
     */
    @field
    pub fn breakLoc(self)-> &Word {
        self._breakLoc
    }

    /**
     * @returns the location of the return statement inside this value.
     */
    @field
    pub fn returnLoc(self)-> &Word {
        self._returnLoc
    }

    /**
     * @returns true iff the value can be constructed without calling functions
     *          or performing allocations.
     *
     * Subclasses override this to mark values that are fully literal.
     */
    @field
    pub fn isFullLiteral(self)-> bool {
        false
    }

    /**
     * Create an exact structural copy of this value with a fresh unique ID.
     *
     * Subclasses override this to duplicate their internal structure while
     * preserving semantic information.
     */
    pub fn clone(self)-> &Value;


    impl Comparable!{&Generator} {

        /**
         * Base equality check for generator values.
         *
         * Two values are considered equal at the Value level only if they have
         * the same semantic type. This establishes the minimal equality
         * invariant for all generator values.
         *
         * Subclasses must override this method to refine equality with their
         * own structural or identity checks. Implementations should always call
         * `super.opEquals` first to enforce the type-level equality barrier.
         */
        pub over opEquals(self, o: &Generator)-> bool {
            if let v: &Value = o {
                if self.type != v.type return false;

                return true;
            }

            return false;
        }
    }

    impl Streamable;
    impl Formattable;

}
