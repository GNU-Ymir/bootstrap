 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in scope;

use ymirc::lexing::word;
use ymirc::semantic::generator::value;

/**
 * DeclaredVars stores the set of variables declared within a lexical scope.
 *
 * It maps variable names to their corresponding VarRefValue (semantic value)
 * and is used to:
 *   - detect redeclarations within the same scope,
 *   - resolve variable references during expression validation,
 *   - support closure capture and scope-based symbol lookup.
 *
 * Each scope in the ValidationContext maintains its own DeclaredVars instance.
 */
@final
pub class DeclaredVars {

    /**
     * Used for symbol lookup, redeclaration checks, and closure capture.
     *
     * Mapping:
     *   name => &Value (VarRefValue)
     */    
    pub let mut content: [[c8] => mut &Value] = copy [];
    
    pub self () {}
}

/**
 * UsedVars stores the set of variables referenced within a lexical scope.
 *
 * It maps variable names to the location of their usage. This is used to:
 *   - detect unused variables,
 *   - support closure capture analysis,
 *   - validate scope guards and control-flow constructs,
 *   - and track symbol usage for diagnostics.
 *
 * Each scope in the ValidationContext maintains its own UsedVars instance.
 */
@final
pub class UsedVars {
    
    /**
     * Mapping of variable names used in the scope to the location of usage.
     * Used for unused-variable diagnostics, closure capture, and symbol tracking.
     *
     * Mapping:
     *   name => &Word (usage location)
     */
    pub let mut content: [[c8] => mut &Word] = copy [];
    
    pub self () {}

    /**
     * Checks whether a variable with the given name has been used in this scope.
     *
     * @params:
     *    - v:  The variable name.
     *    
     * @returns:
     *   - true if the variable appears in the usage table.
     */
    pub fn opContains (self, v: [c8])-> bool {
        v in self.content
    }
    
}
