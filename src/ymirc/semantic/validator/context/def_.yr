 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in def_;

use ymirc::semantic::symbol;

/**
 * DefContext tracks the recursion depth of `def` declarations during semantic
 * validation. It is used to detect cycles between definitions and to ensure
 * that dependent `def` symbols are validated in a correct and safe order.
 *
 * Each active `def` symbol is assigned a recursion level. When a definition
 * references another definition that is already being validated, the recursion
 * level determines whether validation must be deferred or whether a cycle
 * should be reported.
 *
 * This context is intentionally lightweight: it only tracks recursion levels
 * and exposes simple operations to query, insert, and remove entries.
 *
 */
@final
pub class DefContext {

    /**
     * Tracks recursion levels for `def` declarations currently being validated.
     * Used to detect cycles and prevent infinite recursion.
     *
     * Mapping:
     *   Symbol => recursion depth
     */
    let mut _validation: [&Symbol => mut u32] = copy [];

    /**
     * Creates a new empty DefContext.
     *
     */
    pub self () {}

    /**
     * Retrieves the recursion level of a `def` symbol.
     *
     * If the symbol is currently being validated, its recursion depth is
     * returned. Otherwise, the symbol is considered to be at recursion level 0,
     * meaning it is not part of an active recursive validation chain.
     *
     * @params:
     *   - sym  The `def` symbol being queried.
     *
     * @return:
     *    The recursion level, or 0 if the symbol is not active.
     */
    pub fn level(self, sym: &Symbol)-> u32 {
        if let Ok(lvl) = self._validation[sym] {
            return lvl;
        }

        return 0;
    }

    /**
     * Records the recursion level for a `def` symbol currently being validated.
     *
     * This is used when entering a `def` validation to mark the depth of the
     * recursion chain. Higher values indicate deeper nested validation.
     *
     * @params:
     *   - sym:  The `def` symbol.
     *   - l:    The recursion depth to assign.
     *
     */
    pub fn set(mut self, sym: &Symbol, l: u32) {
        self._validation[sym] = l;
    }

    /**
     * Removes a `def` symbol from the active validation table.
     *
     * Called when a `def` finishes validation, allowing dependent definitions
     * to resume or complete their own validation safely.
     *
     * @params:
     *   - sym:  The `def` symbol to remove.
     *
     */
    pub fn remove(mut self, sym: &Symbol) {
        self._validation:.remove(sym);
    }
}
