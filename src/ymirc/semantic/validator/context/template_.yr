 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in template_;

use ymirc::semantic::{symbol, validator, template_};
use ymirc::semantic::generator::value::_;
use ymirc::lexing::word;

/**
 * Represents a single template specialization performed during semantic
 * validation. A specialization classs:
 *   - the TemplateMapper used to rewrite the template,
 *   - the source location of the template reference,
 *   - the resulting instantiated symbol,
 *   - and the referent symbol used to match equivalent instantiations.
 *
 * TemplateSpecialization objects are stored inside TemplateContext to
 * support memoization and fast lookup of previously instantiated templates.
 */
record TemplateSpecialization {

    pub {
        /// The mapper used to instantiate the template.
        let mapper: TemplateMapper;

        /// Source location of the template reference.
        let loc: &Word;

        /// The resulting symbol produced by this specialization.
        let dmut sym: &Symbol;

        /// The referent symbol used to determine equivalence between template
        /// instantiations. Two instantiations match if they share the same referent.
        let referent: &Symbol;
    }

    /**
     * Creates a new TemplateSpecialization with the given metadata.
     *
     * @params:
     *    - mapper:  The TemplateMapper used for instantiation.
     *    - loc:       The source location of the template reference.
     *    - sym:       The resulting instantiated symbol.
     *    - referent:  The referent symbol used for matching.
     *
     */
    pub self (mapper: TemplateMapper, loc: &Word, dmut sym: &Symbol, referent: &Symbol)
        with mapper = mapper
        , loc = loc
        , sym = alias sym
        , referent = referent
    {}
}

/**
 * The parameters a template declaration takes, in declaration order.
 *
 * Kept by TemplateContext so that the mapper of an instantiation can be put back into that
 * order before it names a symbol - see TemplateMapper::orderedBy.
 */
record TemplateParams {

    pub {
        /// Source location of the template declaration.
        let loc: &Word;

        /// Its parameter names, in declaration order.
        let names: [[c8]];
    }

    /**
     * @params:
     *   - loc:   the location of the template declaration
     *   - names: its parameter names, in declaration order
     */
    pub self (loc: &Word, names: [[c8]])
        with loc = loc
        , names = names
    {}
}

/**
 * TemplateContext tracks all template instantiations performed during the
 * semantic pass. It provides memoization for template rewrites, ensuring that
 * identical template instantiations are not recomputed.
 *
 * Instantiations are indexed by the string representation of the template
 * reference location(`sym.loc.str`), and each entry stores a list of
 * TemplateSpecialization objects representing all instantiations performed
 * at that location.
 *
 * The context supports:
 *   - registering new template instantiations,
 *   - finding existing instantiations that match a given template reference,
 *   - and replacing previously recorded instantiations.
 */
@final
pub class TemplateContext {

    /**
     * Mapping from template reference location strings to the list of
     * template specializations instantiated at that location.
     *
     * Mapping:
     *   locString => [TemplateSpecialization]
     */
    let dmut _declaredKeys: [[c8] => [TemplateSpecialization]] = copy [];

    /**
     * Mapping from template declaration location strings to the names of the parameters that
     * declaration takes, in declaration order - the order the mapper of an instantiation must be
     * put back into before it names a symbol(see TemplateMapper::orderedBy).
     *
     * A template that takes several rounds to solve is rewritten, between rounds, into a
     * declaration holding only the parameters that remain, so only the first sighting of a
     * location carries the whole list, and it is the one kept.
     *
     * Mapping:
     *   locString => [TemplateParams]
     */
    let dmut _declaredParams: [[c8] => [TemplateParams]] = copy [];

    /**
     * Creates a new empty TemplateContext.
     *
     */
    pub self () {}

    /**
     * Records the parameters a template declaration takes, the first time that declaration is
     * seen; later sightings, which only carry the parameters left to solve, are ignored.
     *
     * @params:
     *   - loc:   the location of the template declaration
     *   - names: its parameter names, in declaration order
     */
    pub fn rememberParams(mut self, loc: &Word, names: [[c8]]) {
        if (self.rememberedParams(loc).len != 0us) return;

        if let Ok(lst) = self._declaredParams[loc.str] {
            self._declaredParams[loc.str] = lst ~ [TemplateParams(loc, names)];
        } else {
            self._declaredParams[loc.str] = copy [TemplateParams(loc, names)];
        }
    }

    /**
     * @returns: the parameter names remembered for a template declaration, in declaration order,
     *   or an empty list if that declaration was never seen.
     */
    pub fn rememberedParams(self, loc: &Word)-> [[c8]] {
        if let Ok(lst) = self._declaredParams[loc.str] {
            for entry in lst {
                if entry.loc.isSameLoc(loc) return entry.names;
            }
        }

        return [];
    }

    /**
     * Registers a new template instantiation.
     *
     * The instantiation is indexed by the string representation of the template
     * reference location(`sym.loc.str`). If previous instantiations exist at
     * that location, the new specialization is appended; otherwise, a new list
     * is created.
     *
     * @params:
     *   - mapper:  The TemplateMapper used for instantiation.
     *   - sym:       The template symbol being instantiated.
     *   - result:    The resulting instantiated symbol.
     *
     */
    pub fn register(mut self, mapper: TemplateMapper, sym: &Symbol, dmut result: &Symbol) {
        let referent = sym.referent;
        if let Ok(dmut lst) = alias self._declaredKeys[sym.loc.str] {
            let dmut r = lst ~ [TemplateSpecialization(mapper, sym.loc, alias result, referent)];
            self._declaredKeys[sym.loc.str] = alias r;
        } else {
            self._declaredKeys[sym.loc.str] = copy [TemplateSpecialization(mapper, sym.loc, alias result, referent)];
        }
    }

    /**
     * Attempts to find an existing template instantiation matching the given
     * TemplateRefValue and mapper.
     *
     * A specialization matches if:
     *   - it was instantiated at the same source location,
     *   - it uses the same referent symbol,
     *   - and it was instantiated with the same TemplateMapper.
     *
     * @params:
     *    - value:     The template reference value being resolved.
     *    - mapper:  The TemplateMapper used for instantiation.
     *
     * @returns:
     *   The previously instantiated symbol, or none if no match exists.
     *
     */
    pub fn find(mut self, value: &TemplateRefValue, mapper: TemplateMapper)-> dmut(&Symbol)? {
        let referent = value.sym.referent;
        if let Ok(dmut lst) = alias self._declaredKeys[value.sym.loc.str] {
            for dmut res in alias lst {
                if res.referent is referent && res.loc.isSameLoc(value.sym.loc) && res.mapper == mapper {
                    return (alias res.sym)?;
                }
            }
        }

        return none;
    }

    /**
     * Replaces the result symbol of an existing template instantiation.
     *
     * This is used when a template instantiation must be updated after
     * additional semantic information becomes available(e.g., during
     * multi-phase validation).
     *
     * A specialization is replaced if:
     *   - it was instantiated at the same source location,
     *   - it uses the same referent symbol,
     *   - and it was instantiated with the same TemplateMapper.
     *
     * @params:
     *   - mapper:  The TemplateMapper used for instantiation.
     *   - sym:       The template symbol being instantiated.
     *   - result:    The new instantiated symbol to store.
     *
     */
    pub fn replace(mut self, mapper: TemplateMapper, sym: &Symbol, dmut result: &Symbol) {
        let referent = sym.referent;
        if let Ok(dmut lst) = alias self._declaredKeys[sym.loc.str] {
            for i, res in lst {
                if res.referent is referent && res.loc.isSameLoc(sym.loc) && res.mapper == mapper {
                    lst[i].sym = (alias result);
                }
            }
        }
    }
}
