/*
 * Declares the RecursiveContext class, which tracks semantic-validation state
 * for constructs that may require recursive validation (functions, enums,
 * globals, sizeof/alignof, etc.).
 *
 * This context maintains a set of symbols currently being validated in a
 * recursive manner. It is used to detect cycles, prevent infinite recursion,
 * and determine whether a symbol may be safely validated or must be deferred
 * until the recursion unwinds.
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::semantic::validator::context::recursive
 * @File: ymirc/semantic/validator/context/recursive.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2026-03-18
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in recursive;

use ymirc::semantic::symbol;

/**
 * RecursiveContext tracks symbols that are currently undergoing recursive
 * validation. Many constructs in Ymir (functions, enums, global variables,
 * sizeof/alignof expressions, etc.) may reference each other in ways that
 * require layered or deferred validation.
 *
 * This context maintains a simple membership table indicating which symbols
 * are part of the active recursive chain. It is used to:
 *   - detect recursive dependencies,
 *   - prevent infinite recursion,
 *   - determine when validation must be deferred,
 *   - and ensure that recursive constructs are validated in a safe order.
 *
 * The context exposes minimal operations: membership testing, insertion,
 * and removal.
 */
@final
pub class RecursiveContext {

    /**
     * Set of symbols currently being validated recursively.
     * Used to detect cycles and prevent infinite recursion.
     *
     * Mapping:
     *   Symbol => ()
     */
    let mut _validation: [&Symbol => mut ()] = copy [];

    /**
     * Creates a new empty RecursiveContext.
     *
     * All recursion-tracking tables start empty. This context is reused during
     * semantic validation to track nested recursive constructs.
     * 
     */
    pub self () {}

    /**
     * Checks whether a symbol is currently part of the active recursive
     * validation chain.
     *
     * Used to detect recursive dependencies and determine whether validation
     * must be deferred or handled specially.
     *
     * @params:
     *   - sym:  The symbol being queried.
     *   
     * @returns:
     *   true if the symbol is currently being validated recursively.
     */
    pub fn opContains (self, sym: &Symbol)-> bool {
        return sym in self._validation;
    }

    /**
     * Marks a symbol as being part of the active recursive validation chain.
     *
     * Called when entering validation of a construct that may recursively
     * reference itself or other symbols.
     *
     * @params:
     *   - sym:  The symbol to insert into the recursion set.
     */
    pub fn insert (mut self, sym: &Symbol) {
        self._validation [sym] = ();
    }

    /**
     * Removes a symbol from the active recursive validation chain.
     *
     * Called when finishing validation of a recursive construct, allowing
     * dependent symbols to resume or complete their own validation safely.
     *
     * @params:
     *   - sym:  The symbol to remove.
     */
    pub fn remove (mut self, sym: &Symbol) {
        self._validation:.remove (sym);
    }
}
