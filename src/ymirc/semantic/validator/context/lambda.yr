 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in lambda;

use ymirc::semantic::symbol;

/**
 * LambdaContext tracks all synthetic lambdas generated during semantic
 * validation, specifically those created to cast a function pointer
 * `fn(...) -> T` into a delegate `dg(...) -> T`.
 *
 * These implicit lambdas must be recorded to:
 *   - avoid generating the same synthetic lambda multiple times,
 *   - ensure consistent symbol identity across the semantic pass,
 *   - support correct code generation for delegate captures.
 *
 * The context exposes simple membership, insertion, and removal operations.
 */
@final
pub class LambdaContext {
    
    /**
     * Set of names of synthetic lambdas generated to cast `fn(...) -> T`
     * into `dg(...) -> T`. Stored as a map for efficient membership testing.
     *
     * Mapping:
     *   lambdaName => ()
     */
    let mut _casted: [[c8] => mut ()] = copy [];

    /**
     * Creates a new empty LambdaContext.
     *
     * All tracking tables start empty. This context is reused during semantic
     * validation to avoid regenerating identical synthetic lambdas.
     */
    pub self () {}

    /**
     * Checks whether a synthetic lambda with the given name has already been
     * generated during validation.
     *
     * Used to avoid generating duplicate implicit lambdas when repeatedly
     * casting the same function pointer type to a delegate type.
     *
     * @params:
     *   - name:  The unique name of the synthetic lambda.
     *   
     * @returns:
     *    - true if the lambda has already been generated.
     */
    pub fn opContains (self, name: [c8])-> bool {
        return name in self._casted;
    }

    /**
     * Records that a synthetic lambda with the given name has been generated.
     *
     * Called when the validator creates an implicit lambda to cast a function
     * pointer `fn(...) -> T` into a delegate `dg(...) -> T`.
     *
     * @params:
     *   - name:  The unique name of the generated synthetic lambda.
     */
    pub fn insert (mut self, name: [c8]) {
        self._casted [name] = ();
    }

    /**
     * Removes a synthetic lambda from the tracking table.
     *
     * This is rarely used, but is available for cleanup or rollback scenarios
     * during complex validation flows.
     *
     * @params:
     *   - name  The unique name of the synthetic lambda to remove.
     *   
     */
    pub fn remove (mut self, name: [c8]) {
        self._casted:.remove (name);
    }
}
