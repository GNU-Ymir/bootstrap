in rewrite;

use std::stream;
use ymirc::syntax::expression::{template::_,
                                macro_::_,
                                literal::_,
                                operator::_};

use ymirc::syntax::{expression, declaration, expression::_, declaration::_};
use ymirc::errors::_;
use ymirc::utils::format;
use ymirc::lexing::word;

use ymirc::semantic::generator::type::syntax::_;
use ymirc::semantic::generator::value::syntax::_;
use ymirc::semantic::validator::template::mapper;

/**
 * This class is used to apply a template mapper to expressions, declarations, etc.
 */
pub record TemplateRewriter {

    // The mapper that will be applied to expressions
    let _mapper: TemplateMapper;

    /**
     * Create an template rewriter 
     * @params: 
     *    - mapper: the mapper that will be used to rewrite the template elements
     */
    pub self (mapper: TemplateMapper)
        with _mapper = mapper
    {}

    /*!
     * ================================================================================
     * ================================================================================
     * =========================           GETTERS            =========================
     * ================================================================================
     * ================================================================================
     */

    /**
     * @returns: the score of the template specialization
     */
    pub fn getScore (self)-> u32 {
        self._mapper.getScore ()
    }

    /**
     * @returns: the template mapper used by the rewriter
     * */
    pub fn getTemplateMapper (self)-> TemplateMapper {
        self._mapper
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          COMPARISON          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */
    
    /**
     * @returns: true if self and other can be used indistinguishably
     */
    pub fn opEquals (self, other: TemplateRewriter)-> bool {
        self._mapper == other._mapper
    }        

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          DECLARATIONS          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Rewrite a declaration using the template specialisation.
     * 
     * @params:
     *    - d: the declaration to rewrite
     *    
     * @returns: the rewritten declaration
     */
    pub fn rewrite (self, d: &Declaration)-> &Declaration {
        match d {
            // global
            x: &BlockDecl       => { self.rewriteBlockDecl (x) }
            x: &CondBlockDecl   => { self.rewriteCondBlockDecl (x) }
            x: &ExternBlockDecl => { self.rewriteExternBlockDecl (x) }

            // custom
            x: &EnumDecl        => { self.rewriteEnumDecl (x) }
            x: &ImplDecl        => { self.rewriteImplDecl (x) }
            x: &TraitDecl       => { self.rewriteTraitDecl (x) }
            x: &TypeDecl        => { self.rewriteTypeDecl (x) }
            x: &UnionDecl       => { self.rewriteUnionDecl (x) }

            // function
            x: &FunctionDecl    => { self.rewriteFunctionDecl (x) }
            x: &CtorDecl        => { self.rewriteCtorDecl (x) }
            x: &DtorDecl        => { self.rewriteDtorDecl (x) }
            x: &UnitTestDecl    => { self.rewriteUnitTestDecl (x)  }

            // module
            x: &AssertDecl      => { self.rewriteAssertDecl (x) }
            x: &DefDecl         => { self.rewriteDefDecl (x) }
            x: &GlobalVarDecl   => { self.rewriteGlobalDecl (x) }            
            x: &ImportDecl      => { self.rewriteImportDecl (x) }            
            x: &ModuleDecl      => { self.rewriteModuleDecl (x) }                        
            x: &TemplateDecl    => { self.rewriteTemplateDecl (x) }                                    
            x: &UseDecl         => { self.rewriteUseDecl (x) }

            // macro
            x: &MacroDecl       => { x } // macro are not templatable
            x: &MacroRuleDecl   => { x }
            
            // Errors
            todo: _                   => {
                std::io::eprintln ("internal template rewrite error: ", todo.__typeinfo__.name);
                panic;
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          BLOCKS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Rewrite a block decl
     */
    fn rewriteBlockDecl (self, b: &BlockDecl)-> &BlockDecl {
        let decls = copy [self.rewrite (i) for i in b.decls];
        return copy BlockDecl (loc-> b.loc,
                               comm-> b.comm,
                               decls-> decls,
                               protection-> b.protection,
                               isSet-> b.isSet);
    }

    /**
     * Rewrite a cond block decl
     */
    fn rewriteCondBlockDecl (self, c: &CondBlockDecl)-> &CondBlockDecl {
        let decls = copy [self.rewrite (i) for i in c.decls];
        let test = self.rewrite (c.test);
        let else_ = self.rewrite (c.else_);

        return copy CondBlockDecl (loc-> c.loc,
                                   comm-> c.comm,
                                   decls-> decls,
                                   test-> test,
                                   else_-> else_);
    }
    
    /**
     * Rewrite an extern block declaration
     */
    fn rewriteExternBlockDecl (self, e: &ExternBlockDecl)-> &ExternBlockDecl {
        let decls = copy [self.rewrite (d) for d in e.decls];
        
        return copy ExternBlockDecl (loc-> e.loc,
                                     comm-> e.comm,
                                     lang-> e.lang,
                                     decls-> decls);                              
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          TYPES          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */
    
    /**
     * Rewrite an enumeration decl
     */
    fn rewriteEnumDecl (self, e: &EnumDecl)-> &EnumDecl {
        let fields = copy [self.rewriteVarDecl (i) for i in e.fields];
        let type = self.rewrite (e.type);

        return copy EnumDecl (loc-> e.loc,
                              comm-> e.comm,
                              name-> e.name,
                              type-> type,
                              fiels-> fields,
                              fieldComms-> e.getFieldComms ());
    }

    /**
     * Rewrite a impl declaration
     */
    fn rewriteImplDecl (self, i: &ImplDecl)-> &ImplDecl {
        let content = copy [self.rewrite (d) for d in i.decls];
        let who = self.rewrite (i.who);
        
        return copy ImplDecl (i.loc,
                              i.comm,
                              who-> who,
                              decls-> content);
    }

    /**
     * Rewrite a trait declaration
     */
    fn rewriteTraitDecl (self, t: &TraitDecl)-> &TraitDecl {
        let decls = copy [self.rewrite (d) for d in t.decls];
        
        return copy TraitDecl (loc-> t.loc,
                               comm-> t.comm,
                               name-> t.name,
                               decls-> decls);
    }

    /**
     * Rewrite an Union declaration
     */
    fn rewriteUnionDecl (self, u: &UnionDecl)-> &UnionDecl {
        let types = copy [self.rewrite (d) for d in u.types];
        
        return copy TraitDecl (loc-> u.loc,
                               comm-> u.comm,
                               name-> u.name,
                               types-> types,
                               typeComms-> u.typeComms);
    }

    /**
     * Rewrite a type declaration          
     */
    fn rewriteTypeDecl (self, c: &TypeDecl)-> &TypeDecl {
        let ancestor = self.rewrite (c.ancestor);
        let decls = copy [self.rewrite (i) for i in c.decls];

        return copy TypeDecl (loc-> c.loc,
                              comm-> c.comm,
                              name-> c.name, 
                              decls-> decls,
                              attrs-> c.attrs,
                              ancestor-> ancestor,
                              kind-> c.kind);                        
    }


    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          FUNCTIONS          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Rewrite a function declaration
     */
    fn rewriteFunctionDecl (self, f: &FunctionDecl)-> &FunctionDecl {
        let params = copy [self.rewriteVarDeclExpr (p) for p in f.proto.params];
        let retType = self.rewrite (f.proto.retType);
        
        let body = self.rewrite (f.body);
        let throwers = copy [self.rewrite (i) for i in f.throwers];

        return copy FunctionDecl (loc-> f.loc,
                                  comm-> f.comm,
                                  name-> f.name,
                                  proto-> FunctionPrototype (params, retType, f.proto.isVariadic),
                                  body-> body,
                                  attrs-> f.attrs,
                                  throwers-> throwers,
                                  throwerLoc-> f.throwerLoc,
                                  isOver-> f.isOver);
    }
    
    /**
     * Rewrite a constructor declaration
     */
    fn rewriteCtorDecl (self, c: &CtorDecl)-> &CtorDecl {
        let params = copy [self.rewriteVarDeclExpr (p) for p in c.proto.params];
        let retType = self.rewrite (c.proto.retType);
        
        let mut redirect: (RedirectCtor)? = none;
        if let Ok (red) = c.redirect {
            let redParams = copy [self.rewrite (p) for p in red.params];
            let tempParams = copy [self.rewrite (p) for p in red.templateParams];

            redirect = RedirectCtor (red.loc, red.name, redParams, tempParams);
        }
        
        let fields = copy [FieldCtor (f.loc, f.name, self.rewrite (f.value)) for f in c.fields];
        let throwers = copy [self.rewrite (i) for i in c.throwers];

        return copy ConstructorDecl (loc-> c.loc,
                                     comm-> c.comm,
                                     rename-> c.name,
                                     proto-> FunctionPrototype (params, retType, false),
                                     redirect-> redirect,                                   
                                     fields-> fields,
                                     body-> self.rewrite (c.body),                              
                                     attrs-> c.attrs,
                                     throwerLoc-> c.throwerLoc,
                                     throwers-> throwers);
    }
    
    /**
     * Rewrite a destructor declaration
     */
    fn rewriteDtorDecl (self, d: &DtorDecl)-> &DtorDecl {        
        let body = self.rewrite (d.body);

        return copy DtorDecl (loc-> d.loc,
                                    comm-> d.comm,
                                    param-> d.proto.params [0],
                                    body-> body);
    }    

    /**
     * Rewrite a unit test declaration
     */
    fn rewriteUnitTestDecl (self, u: &UnitTestDecl)-> &UnitTestDecl {
        return copy UnitTestDecl (loc-> u.loc,
                                  comm-> u.comm,
                                  body-> self.rewrite (u.body));
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          GLOBAL          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */
    
    /**
     * Rewrite an assertion declaration     
     * */
    fn rewriteAssertDecl (self, a: &AssertDecl)-> &AssertDecl {
        let test = self.rewrite (a.test);
        let msg = self.rewrite (a.msg);

        return copy AssertDecl (a.loc, a.test, a.msg);
    }
    
    /**
     * Rewrite an def declaration
     */
    fn rewriteDefDecl (self, a: &DefDecl)-> &DefDecl {
        let content = self.rewrite (a.content);
        
        return copy DefDecl (a.loc,
                             comm-> a.comm,
                             name-> a.name,
                             tokDecl-> a.tokDecl,
                             content-> content);
    }

    /**
     * Rewrite a global var declaration
     */
    fn rewriteGlobalDecl (self, g: &GlobalVarDecl)-> &GlobalVarDecl {
        let var = self.rewrite (e.var);
        
        return copy GlobalVarDecl (loc-> e.loc,
                                   comm-> e.comm,
                                   var-> var,                                    
                                   attrs-> e.attrs,
                                   isField-> e.isField,
                                   isStatic-> e.isStatic);
    }

    /**
     * Rewrite an import declaration     
     */
    fn rewriteImportDecl (self, i: &ImportDecl)-> &ImportDecl {
        i
    }

    /**
     * Rewrite a module declaration
     */
    fn rewriteModuleDecl (self, m: &ModuleDecl)-> &ModuleDecl {
        let block = self.rewrite (m.block);
        
        return copy ModuleDecl (loc-> m.loc,
                                comm-> m.comm,
                                name-> m.name,
                                block-> block,                                
                                isGlobal-> m.isGlobal);
    }

    /**
     * Rewrite a template declaration 
     */
    fn rewriteTemplateDecl (self, t: &TemplateDecl)-> &TemplateDecl {
        let params = copy [self.rewrite (p) for p in t.params];
        let test = self.rewrite (t.test);
        let decl = self.rewrite (t.decl);
        
        return copy TemplateDecl (loc-< t.loc,
                                  comm-> t.comm,
                                  params-> params,
                                  test-> test,
                                  content-> decl);
    }

    /**
     * Rewrite a use declaration
     * */
    fn rewriteUseDecl (self, u: &UseDecl)-> &UseDecl {
        copy UseDecl (u.loc, u.getComments (), self.rewrite (u.getModulePath ()), u.isRoot ())
    }
    

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          EXPRESSIONS          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */
    
    /**
     * Rewrite the expression using the mapper of the rewriter
     * 
     */
    pub fn rewrite (self, expr: &Expression)-> &Expression {
        match expr {
            t: &TypeExpr        => { self.rewriteTypeExpr (t) }
            t: &TemplateExpr    => { self.rewriteTemplateExpr (t) }
            o: &OperatorExpr    => { self.rewriteOperatorExpr (o) }
            m: &MemoryExpr      => { self.rewriteMemoryExpr (m) }
            m: &MatchFilterExpr => { self.rewriteMatchFilterExpr (m) }            
            l: &LiteralExpr     => { self.rewriteLiteralExpr (l) }
            i: &InstructionExpr => { self.rewriteInstructionExpr (i) }            
            c: &ControlExpr     => { self.rewriteControlExpr (c) }
            c: &ComposeExpr     => { self.rewriteComposeExpr (c) }
            b: &BlockExpr       => { self.rewriteBlockExpr (e) }
            s: &ScopeGuardExpr  => { self.rewriteScopeGuardExpr (s) }
            s: &SetExpr         => { self.rewriteSetExpr (s) }

            // Not rewritable
            m: &MacroRuleExpr   => { m }
            e: &EmptyExpr       => { e }
            
            todo: _ => {
                std::io::eprintln ("internal template rewrite error: ", todo.__typeinfo__.name);
                panic;
            }
        }
    }


    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          TYPES          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Rewrite a type expression
     * */
    fn rewriteTypeExpr (self, t: &TypeExpr)-> &TypeExpr {
        match t {
            x: &AsyncTypeExpr       => { self.rewriteAsyncTypeExpr (x) }
            x: &DecoratedTypeExpr   => { self.rewriteDecoratedTypeExpr (x) }
            x: &FunctionPtrTypeExpr => { self.rewriteFunctionPtrTypeExpr (x) }
            x: &FutureTypeExpr      => { self.rewriteFutureTypeExpr (x) }
            x: &TypeOfTypeExpr      => { self.rewriteTypeOfTypeExpr (x) }
            x: &YieldTypeExpr       => { self.rewriteYieldTypeExpr (x) }
            x: &RangeTypeExpr       => { self.rewriteRangeType (x) }
            todo => {
                std::io::eprintln ("internal template rewrite error: ", todo.__typeinfo__.name);
                panic;
            }
        }
    }        

    /**
     * Rewrite an async type expression
     * */
    fn rewriteAsyncTypeExpr (self, x: &AsyncTypeExpr)-> &AsyncTypeExpr {
        return copy AsyncTypeExpr (x.loc, self.rewrite (x.retType));
    }

    /**
     * Rewrite an decorated type expression
     * */
    fn rewriteDecoratedTypeExpr (self, x: &DecoratedTypeExpr)-> &DecoratedTypeExpr {
        return copy DecoratedTypeExpr (x.loc, x.kind, self.rewrite (x.retType));
    }

    /**
     * Rewrite an function pointer type expression
     * */
    fn rewriteFunctionPtrTypeExpr (self, x: &FunctionPtrTypeExpr)-> &FunctionPtrTypeExpr {
        let params = copy [self.rewriteVarDeclExpr (p) for p in x.params];
        
        return copy FunctionPtrTypeExpr (x.loc, x.isDelegate, params, self.rewrite (x.retType));
    }

    /**
     * Rewrite an future type expression
     * */
    fn rewriteFutureTypeExpr (self, x: &FutureTypeExpr)-> &FutureTypeExpr {
        return copy FutureTypeExpr (x.loc, self.rewrite (x.retType));
    }
    
    /**
     * Rewrite a range type expression
     * */
    fn rewriteRangeType (self, x: &RangeTypeExpr)-> &RangeTypeExpr {
        return copy RangeTypeExpr (x.loc, self.rewrite (x.type));
    }

    /**
     * Rewrite a typeof type expression
     * */
    fn rewriteTypeOfExpr (self, x: &TypeOfExpr)-> &TypeOfExpr {
        return copy TypeOfExpr (x.loc, self.rewrite (x.value));
    }

    /**
     * Rewrite a yield type expression
     * */
    fn rewriteYieldTypeExpr (self, x: &YieldTypeExpr)-> &YieldTypeExpr {
        return copy YieldTypeExpr (x.loc, self.rewrite (x.retType));
    }
    
    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          TEMPLATES          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Rewrite a template filter expression
     * */
    fn rewriteTemplateExpr (self, t: &TemplateExpr)-> &Expression {
        match t {
            x: &TemplateAndExpr         => { self.rewriteTemplateAndExpr (x) }
            x: &TemplateOfVarExpr       => { self.rewriteTemplateOfVarExpr (x) }
            x: &TemplateVarExpr         => { self.rewriteTemplateVarExpr (x) }
            x: &TemplateVariadicVarExpr => { self.rewriteTemplateVariadicVarExpr (x) }
            todo => {
                std::io::eprintln ("internal template rewrite error: ", todo.__typeinfo__.name);
                panic;
            }            
        }
    }

    /**
     * Rewrite a template and filter
     * */
    fn rewriteTemplateAndExpr (self, x: &TemplateAndExpr)-> &TemplateAndExpr {
        let inners = copy [self.rewriteTemplateOfVarExpr (p) for p in x.inners];
        
        return copy TemplateAndExpr (x.loc, inners)
    }

    /**
     * Rewrite a template of var filter
     * */
    fn rewriteTemplateOfVarExpr (self, x: &TemplateOfVarExpr)-> &TemplateOfVarExpr {                
        return copy TemplateOfVarExpr (x.loc, x.kind, self.rewrite (x.spec))
    }
    
    /**
     * Rewrite a template var filter
     * */
    fn rewriteTemplateVarExpr (self, x: &TemplateVarExpr)-> &Expression {
        if let Ok (r) = self._mapper.getMapping ()[x.name.str] {
            return r;
        } 

        return x;
    }

    /**
     * Rewrite a template variadic var filter
     * */
    fn rewriteTemplateVariadicVarExpr (self, x: &TemplateVariadicVarExpr)-> &Expression {
        if let Ok (r) = self._mapper.getMapping ()[x.name.str] {
            return r;
        } 

        return x;
    }
    
    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          OPERATORS          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Rewrite an operator expression
     * */
    fn rewriteOperatorExpr (self, o: &OperatorExpr)-> &Expression {
        match o {                    
            x: &BinaryExpr          => { self.rewriteBinaryExpr (x) }
            x: &CastExpr            => { self.rewriteCastExpr (x) }
            x: &CteExpr             => { self.rewriteCteExpr (x) }
            x: &MacroCallExpr       => { self.rewriteMacroCallExpr (x) }
            x: &MultOperatorExpr    => { self.rewriteMultOperatorExpr (x) }
            x: &NamedExpr           => { self.rewriteNamedExpr (x) }
            x: &PathExpr            => { self.rewritePathExpr (x) }
            x: &PragmaExpr          => { self.rewritePragmaExpr (x) }
            x: &TemplateCallExpr    => { self.rewriteTemplateCallExpr (x) }
            x: &TemplateCheckerExpr => { self.rewriteTemplateCheckerExpr (x) }
            x: &UnaryExpr           => { self.rewriteUnaryExpr (x) } 
            
            todo => {
                std::io::eprintln ("internal template rewrite error: ", todo.__typeinfo__.name);
                panic;
            }
        } 
    }

    /**
     * Rewrite a binary expression
     * */
    fn rewriteBinaryExpr (self, x: &BinaryExpr)-> &BinaryExpr {
        return copy BinaryExpr (x.loc, self.rewrite (x.left), self.rewrite (x.right));
    }

    /**
     * Rewrite a cast expression
     * */
    fn rewriteCastExpr (self, x: &CastExpr)-> &CastExpr {
        return copy CastExpr (x.loc, self.rewrite (x.type), self.rewrite (x.value));
    }

    /**
     * Rewrite a cte expression
     * */
    fn rewriteCteExpr (self, x: &CteExpr)-> &CteExpr {
        return copy CteExpr (x.loc, self.rewrite (x.value));
    }

    /**
     * Rewrite a MacroCall expression
     * */
    fn rewriteMacroCallExpr (self, x: &MacroCallExpr)-> &MacroCallExpr {
        return copy MacroCallExpr (x.loc, self.rewrite (x.who), x.content);
    }

    /**
     * Rewrite a MultOperator expression
     * */
    fn rewriteMultOperatorExpr (self, x: &MultOperatorExpr)-> &MultOperatorExpr {
        let rights = copy [self.rewrite (p) for p in x.rights];
        return copy MultOperatorExpr (x.loc, x.end, x.op, self.rewrite (x.left), rights, canBeDotCall-> x.canBeDotCall);
    }
    
    /**
     * Rewrite a named expression
     * */
    fn rewriteNamedExpr (self, x: &NamedExpr)-> &NamedExpr {
        return copy NamedExpr (x.loc, x.name, self.rewrite (x.value));
    }

    /**
     * Rewrite a path expression
     * */
    fn rewritePathExpr (self, x: &PathExpr)-> &PathExpr {
        return copy PathExpr (x.loc, self.rewrite (x.left), self.rewrite (x.right));
    }

    /**
     * Rewrite a pragma expression
     * */
    fn rewritePragmaExpr (self, x: &PragmaExpr)-> &PragmaExpr {
        let params = copy [self.rewrite (p) for p in x.params];
        return copy PragmaExpr (x.loc, x.name, params);
    }

    /**
     * Rewrite a templateCall expression
     * */
    fn rewriteTemplateCallExpr (self, x: &TemplateCallExpr)-> &TemplateCallExpr {
        if let x: &VarExpr = x.left {
            if let Ok (x) = self._mapper.getMapping ()[v.name.str] {
                return x;
            } 
        }

        let left = self.rewrite (x.left);
        let mut rights: [&Expression] = [];
        for it in x.rights {
            let t = self.rewrite (it);
            if let list: &TypeListWrapperExpr = t {
                let inners = copy [copy TypeWrapperExpr (i.loc, i) for i in list.types];
                rights ~= inners;
            } else {
                rights ~= [t];
            }
        }
        
        return copy TemplateCallExpr (x.loc, left, rights);
    }

    /**
     * Rewrite a templateChecker expression
     * */
    fn rewriteTemplateCheckerExpr (self, x: &TemplateCheckerExpr)-> &TemplateCheckerExpr {
        let params = copy [self.rewrite (p) for p in x.params];
        
        let mut rules: [&Expression] = [];
        for it in x.rules {
            let t = self.rewrite (it);
            if let list: &TypeListWrapperExpr = t {
                let inners = copy [copy TypeWrapperExpr (i.loc, i) for i in list.types];
                rules ~= inners;
            } else {
                rules ~= [t];
            }
        }
        
        return copy TemplateCheckerExpr (x.loc, params, rules);
    }

    /**
     * Rewrite a unary expression
     * */
    fn rewriteUnaryExpr (self, x: &UnaryExpr)-> &UnaryExpr {        
        return copy UnaryExpr (x.loc, self.rewrite (x.value));
    }
    
    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          MEMORY          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Rewrite a memory expression
     * */
    fn rewriteMemory (self, m: &MemoryExpr)-> &MemoryExpr {
        match m {
            x: &AliasExpr  => { self.rewriteAliasExpr (x) }
            x: &CopyExpr   => { self.rewriteCopyExpr (x) }
            x: &ExpandExpr => { self.rewriteExpandExpr (x) }
            x: &MoveExpr   => { self.rewriteMoveExpr (x) }
            x: &RefExpr    => { self.rewriteRefExpr (x) }
            
            todo => {
                std::io::eprintln ("internal template rewrite error: ", todo.__typeinfo__.name);
                panic;
            }
        }
    }

    /**
     * Rewrite an alias expression
     * */
    fn rewriteAliasExpr (self, x: &AliasExpr)-> &AliasExpr {
        return copy AliasExpr (x.loc, self.rewrite (x.content))
    }

    /**
     * Rewrite an copy expression
     * */
    fn rewriteCopyExpr (self, x: &CopyExpr)-> &CopyExpr {
        return copy CopyExpr (x.loc, self.rewrite (x.content), x.isDeep)
    }
    
    /**
     * Rewrite an expand expression
     * */
    fn rewriteExpandExpr (self, x: &ExpandExpr)-> &ExpandExpr {
        return copy ExpandExpr (x.loc, self.rewrite (x.content))
    }

    /**
     * Rewrite an move expression
     * */
    fn rewriteMoveExpr (self, x: &MoveExpr)-> &MoveExpr {
        return copy MoveExpr (x.loc, self.rewrite (x.content))
    }

    /**
     * Rewrite an ref expression
     * */
    fn rewriteRefExpr (self, x: &RefExpr)-> &RefExpr {
        return copy RefExpr (x.loc, self.rewrite (x.content))
    }
    
    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          MATCH FILTERS          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Rewrite a match filter expression
     * */
    fn rewriteMatchFilterExpr (self, m: &MatchFilterExpr)-> &MatchFilterExpr {
        match m {
            x: &MatchListFilterExpr   => { self.rewriteMatchListFilterExpr (x) }
            x: &MatchOptionFilterExpr => { self.rewriteMatchOptionFilterExpr (x) }
            todo => {
                std::io::eprintln ("internal template rewrite error: ", todo.__typeinfo__.name);
                panic;
            }
        }
    }

    /**
     * Rewrite a match list filter
     * */
    fn rewriteMatchListFilterExpr (self, x: &MatchListFilterExpr)-> &MatchListFilterExpr {
        let params = copy [self.rewrite (p) for p in x.params];

        return copy MatchListFilterExpr (x.loc, x.end, params, x.isVariadic, x.isArray);
    }

    /**
     * Rewrite a match option filter
     * */
    fn rewriteMatchOptionFilterExpr (self, x: &MatchOptionFilterExpr)-> &MatchOptionFilterExpr {        
        return copy MatchOptionFilterExpr (x.loc, x.kind, self.rewrite (x.inner));
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          LITERALS          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Rewrite a literal expression
     * */
    fn rewriteLiteral (self, l: &LiteralExpr)-> &Expression {
        if let v: &VarExpr = l {
            match self._mapper.getMapping ()[v.name.str] {
                Ok (x: &ValueWrapperExpr)       =>
                    return copy ValueWrapperExpr (v.name, x.getValue ()); 
                Ok (x: &TypeWrapperExpr)        => 
                    return copy TypeWrapperExpr (v.name, x.getType (), asIs-> x.asIs ()); 
                Ok (x: &TypeListWrapperExpr)    => 
                    return copy TypeListWrapperExpr (v.name, x.getTypes ());                
                Ok (x: &LambdaValueWrapperExpr) => 
                    return copy LambdaValueWrapperExpr (v.name, x.getName (), x.getType (), x.getValue ());            
                Ok (x: &Expression)             =>
                    return x;                 
            }
        }

        return l;
    }
    
    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          INSTRUCTIONS          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          CONTROL          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          COMPOSE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          BLOCK          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    
    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          COMMON          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    
    /**
     * Create a new template parameter list from an old list and a pre template specialization
     * @params:
     *    - syntaxTemplate: the old template parameters
     *    - mapper: the template specialization
     * @returns: The transformed list
     */
    pub fn replaceSyntaxTempl (self, syntaxTemplate: [&Expression])-> [&Expression] {
        let mut results: [mut &Expression] = [];
        // THe idea is simple, we go through the list, and if the template was already validated, we reject it
        for it in syntaxTemplate match it {
            v: &VarExpr => {
                if !self._mapper.hasValidated (v.loc.str) results ~= [v];
            }
            v: &TemplateOfVarExpr => {
                if !self._mapper.hasValidated (v.loc.str) {
                    results ~= [self.rewriteTemplateOfVar (v)];
                }
            }
            v: &TemplateAndExpr => {
                if !self._mapper.hasValidated (v.loc.str) {
                    results ~= [self.rewriteTemplateAndVar (v)];
                }
            }
            v: &TemplateVariadicVarExpr => {
                if !self._mapper.hasValidated (v.loc.str) results ~= [v];
            }
            v: &TemplateVarExpr => { // different from VarExpr, as it has a value
                if !self._mapper.hasValidated (v.loc.str) results ~= [v];
            }
            v: &VarDeclExpr => {
                if !self._mapper.hasValidated (v.loc.str) {
                    results ~= [self.rewriteVarDecl (v)];
                }
            }
            _ => { // constant values are stored differently
                if !self._mapper.hasValidated (format ("%[%,%]", it.loc.str, it.loc.line, it.loc.col)) results ~= [it];
            }
        }

        results
    }

    /*!
     * ================================================================================
     * ================================================================================
     * =========================             MISC             =========================
     * ================================================================================
     * ================================================================================
     */

    impl Streamable;
    impl Formattable {
        pub over format (self, dmut stream: &Formatter) {
            stream:.write (self._mapper);
        }

    }

    /**
     * @returns: the rewriter into a string (with less information that with format)
     */
    pub fn simpleFormat (self)-> [c8] {
        self._mapper.simpleFormat ()
    }

}
