in typeinfo_;

use ymirc::semantic::{validator, declarator};

use ymirc::syntax::{_, declaration::_, expression::_};                    
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::semantic::symbol;
use ymirc::global::core_;

use ymirc::errors::_;

use ymirc::utils::{format, bigint};
use ymirc::lexing::{word, tokens, keys};

use std::{io, stream, conv};


pub mod TypeInfo {

    /**
     * Validate a typeinfo expression
     * @params:
     *    - context: the context of the validation
     *    - loc: the location of the typeinfo access
     *    - type: the type being accessed
     * @returns: the validated expression
     */
    pub fn validate (dmut context: &Validator, loc: &Word, type: &Type)-> &Value
        throws ErrorMsg
    {
        let ti = context:.validateTypeInfo (loc);
        TypeInfo::validate (alias context, loc, ti, type)
    }

    /**
     * Validate the field infos of a type
     * @params:
     *     - context: the context of the validation
     *     - loc: the location of the field info access
     *     - type: the type being accessed
     * @returns: the validated expression
     * */
    pub fn validateFieldInfos (dmut context: &Validator, loc: &Word, type: &Type)-> &Value
        throws ErrorMsg
    {
        let fi = context:.validateFieldInfo (loc);
        match type {
            c: &ClassRefType => {
                return TypeInfo::validateFieldInfoClass (alias context, loc, fi, c);
            }
            c: &ClassPtrType => {
                return TypeInfo::validateFieldInfoClass (alias context, loc, fi, c.getInner ());
            }
            t: &TupleType => {
                return TypeInfo::validateFieldInfoTuple (alias context, loc, fi, t);
            }
        }

        throw copy ErrorMsg::fatal (loc, format (ValidateErrorMessage::TYPE_HAS_NO_FIELDINFO, type));
    }


    /**
     * Validate a typeinfo expression
     * @params:
     *    - context: the context of the validation
     *    - loc: the location of the typeinfo access
     *    - ti: the typeinfo struct type for std core::typeinfo
     *    - type: the type being accessed
     * @returns: the validated expression
     */
    fn validate (dmut context: &Validator, loc: &Word, ti: &ClassPtrType, type: &Type)-> &Value
        throws ErrorMsg
    {
        match type {
            b: &BoolType => {
                return TypeInfo::validateScalarType (alias context, loc, ti, b, TypeInfoIDS::BOOL);
            }
            it: &IntType => {
                if (it.isSigned ()) {
                    return TypeInfo::validateScalarType (alias context, loc, ti, it, TypeInfoIDS::SIGNED_INT);
                } else {
                    return TypeInfo::validateScalarType (alias context, loc, ti, it, TypeInfoIDS::UNSIGNED_INT);
                }
            }
            c: &CharType => {
                return TypeInfo::validateScalarType (alias context, loc, ti, c, TypeInfoIDS::CHAR);
            }
            f: &FloatType => {
                return TypeInfo::validateScalarType (alias context, loc, ti, f, TypeInfoIDS::FLOAT);
            }
            v: &VoidType => {
                return TypeInfo::validateScalarType (alias context, loc, ti, v, TypeInfoIDS::VOID);
            }
            d: &DelegateType => {
                return TypeInfo::validateDelegateType (alias context, loc, ti, d);
            }
            f: &FuncPtrType => {
                return TypeInfo::validateFuncPtrType (alias context, loc, ti, f);
            }
            a: &ArrayType => {
                return TypeInfo::validateArrayType (alias context, loc, ti, a);
            }
            p: &PointerType => {
                return TypeInfo::validatePointerType (alias context, loc, ti, p);
            }
            r: &RangeType => {
                return TypeInfo::validateRangeType (alias context, loc, ti, r);
            }
            s: &SliceType => {
                return TypeInfo::validateSliceType (alias context, loc, ti, s);
            }
            tu: &TupleType => {
                return TypeInfo::validateTupleType (alias context, loc, ti, tu);
            }
            c: &ClassPtrType => {
                return TypeInfo::validateClassPtrType (alias context, loc, ti, c);
            }
            c: &ClassRefType => {
                return TypeInfo::validateClassRefType (alias context, loc, ti, c);
            }
            o: &OptionType => {
                return TypeInfo::validateOptionType (alias context, loc, ti, o);
            }
            m: &MapType => {
                return TypeInfo::validateMapType (alias context, loc, ti, m);
            }
            e: &EnumType => {
                return TypeInfo::validate (alias context, loc, e.getProxy ());
            }
        }

        throw copy ErrorMsg::fatal (loc, format (ValidateErrorMessage::TYPE_HAS_NO_TYPEINFO, type));
    }

    /**
     * Validate the typeinfo of a scalar
     * @params:
     *    - context: the context of the validation
     *    - loc: the location of the operation
     *    - ti: the typeinfo type
     *    - scal: the scalar type
     * @returns: a typeinfo value
     * */
    fn validateScalarType (dmut context: &Validator, loc: &Word, ti: &ClassPtrType, scal: &Type, code: [c8])-> &Value
        throws ErrorMsg
    {
        let mut params: [mut &Value] = copy [UNIT_VALUE ; 4us];
        params [0] = context:.validateTypeIDs (loc, code);
        params [1] = context:.getSizeofValidator ():.validate (alias context, loc, scal);

        params [2] = TypeInfo::createArrayFromTypeInfoValues (alias context, loc, ti, []);
        
        let name = format ("%", scal);
        params [3] = copy StringValue (loc, name);

        return copy StructInitValue (loc,
                                     type-> ti,
                                     values-> params,
                                     fields-> copy [TypeInfoKeys::ID, TypeInfoKeys::SIZE, TypeInfoKeys::INNER, TypeInfoKeys::NAME]);        
    }

    /**
     * Validate the typeinfo of a delegate type
     * @params:
     *    - context: the context of the validation
     *    - loc: the location of the operation
     *    - ti: the typeinfo type
     *    - d: the delegate type
     * @returns: a typeinfo value
     * */
    fn validateDelegateType (dmut context: &Validator, loc: &Word, ti: &ClassPtrType, d: &DelegateType)-> &Value
        throws ErrorMsg
    {
        let mut params: [mut &Value] = copy [UNIT_VALUE ; 4us];
        params [0] = context:.validateTypeIDs (loc, TypeInfoIDS::DELEGATE);
        params [1] = context:.getSizeofValidator ():.validate (alias context, loc, d);

        let name = format ("%", d);
        params [3] = copy StringValue (loc, name);

        let mut inners = copy [TypeInfo::validate (alias context, loc, ti, d.retType)];
        inners ~= copy [TypeInfo::validate (alias context, loc, ti, i) for i in d.params];

        params [2] = TypeInfo::createArrayFromTypeInfoValues (alias context, loc, ti, inners);

        return copy StructInitValue (loc,
                                     type-> ti,
                                     values-> params,
                                     fields-> copy [TypeInfoKeys::ID, TypeInfoKeys::SIZE, TypeInfoKeys::INNER, TypeInfoKeys::NAME]);        
    }

    /**
     * Validate the typeinfo of a function pointer type
     * @params:
     *    - context: the context of the validation
     *    - loc: the location of the operation
     *    - ti: the typeinfo type
     *    - f: the function pointer type
     * @returns: a typeinfo value
     * */
    fn validateFuncPtrType (dmut context: &Validator, loc: &Word, ti: &ClassPtrType, f: &FuncPtrType)-> &Value
        throws ErrorMsg
    {
        let mut params: [mut &Value] = copy [UNIT_VALUE ; 4us];
        params [0] = context:.validateTypeIDs (loc, TypeInfoIDS::FPTR);
        params [1] = context:.getSizeofValidator ():.validate (alias context, loc, f);

        let name = format ("%", f);
        params [3] = copy StringValue (loc, name);

        let mut inners = copy [TypeInfo::validate (alias context, loc, ti, f.retType)];
        inners ~= copy [TypeInfo::validate (alias context, loc, ti, i) for i in f.params];

        params [2] = TypeInfo::createArrayFromTypeInfoValues (alias context, loc, ti, inners);
        
        return copy StructInitValue (loc,
                                     type-> ti,
                                     values-> params,
                                     fields-> copy [TypeInfoKeys::ID, TypeInfoKeys::SIZE, TypeInfoKeys::INNER, TypeInfoKeys::NAME]);
    }

    /**
     * Validate the typeinfo of an array type
     * @params:
     *    - context: the context of the validation
     *    - loc: the location of the operation
     *    - ti: the typeinfo type
     *    - a: the array type
     * @returns: a typeinfo value
     * */
    fn validateArrayType (dmut context: &Validator, loc: &Word, ti: &ClassPtrType, a: &ArrayType)-> &Value
        throws ErrorMsg
    {
        let mut params: [mut &Value] = copy [UNIT_VALUE ; 4us];
        params [0] = context:.validateTypeIDs (loc, TypeInfoIDS::ARRAY);
        params [1] = context:.getSizeofValidator ():.validate (alias context, loc, a);

        let name = format ("%", a);
        params [3] = copy StringValue (loc, name);

        params [2] = TypeInfo::createArrayFromTypeInfoValues (alias context,
                                                              loc,
                                                              ti,
                                                              copy [TypeInfo::validate (alias context, loc, ti, a.value)]);

        return copy StructInitValue (loc,
                                     type-> ti,
                                     values-> params,
                                     fields-> copy [TypeInfoKeys::ID, TypeInfoKeys::SIZE, TypeInfoKeys::INNER, TypeInfoKeys::NAME]);                
    }

    /**
     * Validate the typeinfo of a pointer type
     * @params:
     *    - context: the context of the validation
     *    - loc: the location of the operation
     *    - ti: the typeinfo type
     *    - p: the pointer type
     * @returns: a typeinfo value
     * */
    fn validatePointerType (dmut context: &Validator, loc: &Word, ti: &ClassPtrType, p: &PointerType)-> &Value
        throws ErrorMsg
    {
        let mut params: [mut &Value] = copy [UNIT_VALUE ; 4us];
        params [0] = context:.validateTypeIDs (loc, TypeInfoIDS::POINTER);
        params [1] = context:.getSizeofValidator ():.validate (alias context, loc, p);

        let name = format ("%", p);
        params [3] = copy StringValue (loc, name);
        params [2] = TypeInfo::createArrayFromTypeInfoValues (alias context,
                                                              loc,
                                                              ti,
                                                              copy [TypeInfo::validate (alias context, loc, ti, p.pointed)]);

        return copy StructInitValue (loc,
                                     type-> ti,
                                     values-> params,
                                     fields-> copy [TypeInfoKeys::ID, TypeInfoKeys::SIZE, TypeInfoKeys::INNER, TypeInfoKeys::NAME]);
    }

    /**
     * Validate the typeinfo of a range type
     * @params:
     *    - context: the context of the validation
     *    - loc: the location of the operation
     *    - ti: the typeinfo type
     *    - r: the range type
     * @returns: a typeinfo value
     * */
    fn validateRangeType (dmut context: &Validator, loc: &Word, ti: &ClassPtrType, r: &RangeType)-> &Value
        throws ErrorMsg
    {
        let mut params: [mut &Value] = copy [UNIT_VALUE ; 4us];
        params [0] = context:.validateTypeIDs (loc, TypeInfoIDS::RANGE);
        params [1] = context:.getSizeofValidator ():.validate (alias context, loc, r);

        let name = format ("%", r);
        params [3] = copy StringValue (loc, name);

        params [2] = TypeInfo::createArrayFromTypeInfoValues (alias context,
                                                              loc,
                                                              ti,
                                                              copy [TypeInfo::validate (alias context, loc, ti, r.start)]);

        return copy StructInitValue (loc,
                                     type-> ti,
                                     values-> params,
                                     fields-> copy [TypeInfoKeys::ID, TypeInfoKeys::SIZE, TypeInfoKeys::INNER, TypeInfoKeys::NAME]);
    }

    /**
     * Validate the typeinfo of a slice type
     * @params:
     *    - context: the context of the validation
     *    - loc: the location of the operation
     *    - ti: the typeinfo type
     *    - s: the slice type
     * @returns: a typeinfo value
     * */
    fn validateSliceType (dmut context: &Validator, loc: &Word, ti: &ClassPtrType, s: &SliceType)-> &Value
        throws ErrorMsg
    {
        let mut params: [mut &Value] = copy [UNIT_VALUE ; 4us];
        params [0] = context:.validateTypeIDs (loc, TypeInfoIDS::SLICE);
        params [1] = context:.getSizeofValidator ():.validate (alias context, loc, s);

        let name = format ("%", s);
        params [3] = copy StringValue (loc, name);

        params [2] = TypeInfo::createArrayFromTypeInfoValues (alias context,
                                                              loc,
                                                              ti,
                                                              copy [TypeInfo::validate (alias context, loc, ti, s.value)]);

        return copy StructInitValue (loc,
                                     type-> ti,
                                     values-> params,
                                     fields-> copy [TypeInfoKeys::ID, TypeInfoKeys::SIZE, TypeInfoKeys::INNER, TypeInfoKeys::NAME]);        
    }

    /**
     * Validate the typeinfo of a map type
     * @params:
     *    - context: the context of the validation
     *    - loc: the location of the operation
     *    - ti: the typeinfo type
     *    - m: the map type
     * @returns: a typeinfo value
     * */
    fn validateMapType (dmut context: &Validator, loc: &Word, ti: &ClassPtrType, m: &MapType)-> &Value
        throws ErrorMsg
    {
        let mut params: [mut &Value] = copy [UNIT_VALUE ; 4us];
        params [0] = context:.validateTypeIDs (loc, TypeInfoIDS::MAP);
        params [1] = context:.getSizeofValidator ():.validate (alias context, loc, m);

        let name = format ("%", m);
        params [3] = copy StringValue (loc, name);

        let inners = copy [TypeInfo::validate (alias context, loc, ti, m.key),
                           TypeInfo::validate (alias context, loc, ti, m.value)];

        params [2] = TypeInfo::createArrayFromTypeInfoValues (alias context, loc, ti, inners);
        
        return copy StructInitValue (loc,
                                     type-> ti,
                                     values-> params,
                                     fields-> copy [TypeInfoKeys::ID, TypeInfoKeys::SIZE, TypeInfoKeys::INNER, TypeInfoKeys::NAME]);
    }

    /**
     * Validate the typeinfo of a tuple type
     * @params:
     *    - context: the context of the validation
     *    - loc: the location of the operation
     *    - ti: the typeinfo type
     *    - t: the tuple type
     * @returns: a typeinfo value
     * */
    fn validateTupleType (dmut context: &Validator, loc: &Word, ti: &ClassPtrType, t: &TupleType)-> &Value
        throws ErrorMsg
    {
        let mut params: [mut &Value] = copy [UNIT_VALUE ; 4us];
        params [0] = context:.validateTypeIDs (loc, TypeInfoIDS::TUPLE);
        params [1] = context:.getSizeofValidator ():.validate (alias context, loc, t);

        let name = format ("%", t);
        params [3] = copy StringValue (loc, name);
        let mut inners = copy [TypeInfo::validate (alias context, loc, ti, i) for i in t.inners];

        params [2] = TypeInfo::createArrayFromTypeInfoValues (alias context, loc, ti, inners);
        
        return copy StructInitValue (loc,
                                     type-> ti,
                                     values-> params,
                                     fields-> copy [TypeInfoKeys::ID, TypeInfoKeys::SIZE, TypeInfoKeys::INNER, TypeInfoKeys::NAME]);
    }

    /**
     * Validate the typeinfo of a class pointer type
     * @params:
     *    - context: the context of the validation
     *    - loc: the location of the operation
     *    - ti: the typeinfo type
     *    - c: the class pointer
     * @returns: a typeinfo value
     * */
    fn validateClassPtrType (dmut context: &Validator, loc: &Word, ti: &ClassPtrType, c: &ClassPtrType)-> &Value
        throws ErrorMsg
    {
        if (c.sym.isStruct)
            return TypeInfo::validateClassRefType (alias context, loc, ti, c.classRef);

        let mut params: [mut &Value] = copy [UNIT_VALUE ; 4us];
        params [0] = context:.validateTypeIDs (loc, TypeInfoIDS::POINTER);
        params [1] = context:.getSizeofValidator ():.validate (alias context, loc, c);

        let name = format ("%", c);
        params [3] = copy StringValue (loc, name);

        params [2] = TypeInfo::createArrayFromTypeInfoValues (alias context,
                                                              loc,
                                                              ti,
                                                              copy [TypeInfo::validate (alias context, loc, ti, c.classRef)]);
        
        return copy StructInitValue (loc,
                                     type-> ti,
                                     values-> params,
                                     fields-> copy [TypeInfoKeys::ID, TypeInfoKeys::SIZE, TypeInfoKeys::INNER, TypeInfoKeys::NAME]);
    }

    /**
     * Validate the typeinfo of a class ref type
     * @params:
     *    - context: the context of the validation
     *    - loc: the location of the operation
     *    - ti: the typeinfo type
     *    - c: the class ref type
     * @returns: a typeinfo value
     * */
    fn validateClassRefType (dmut _: &Validator, _: &Word, _: &ClassPtrType, c: &ClassRefType)-> &Value {
        c.getTypeInfo ()
    }

    /**
     * Validate the typeinfo of an option type
     * @params:
     *    - context: the context of the validation
     *    - loc: the location of the operation
     *    - ti: the typeinfo type
     *    - o: the option pointer
     * @returns: a typeinfo value
     * */
    fn validateOptionType (dmut context: &Validator, loc: &Word, ti: &ClassPtrType, o: &OptionType)-> &Value
        throws ErrorMsg
    {
        let mut params: [mut &Value] = copy [UNIT_VALUE ; 4us];
        params [0] = context:.validateTypeIDs (loc, TypeInfoIDS::OPTION);
        params [1] = context:.getSizeofValidator ():.validate (alias context, loc, o);

        let name = format ("%", o);
        params [3] = copy StringValue (loc, name);

        params [2] = TypeInfo::createArrayFromTypeInfoValues (alias context, loc, ti,
                                                              copy [TypeInfo::validate (alias context, loc, ti, o.wrapped)]);
        
        return copy StructInitValue (loc,
                                     type-> ti,
                                     values-> params,
                                     fields-> copy [TypeInfoKeys::ID, TypeInfoKeys::SIZE, TypeInfoKeys::INNER, TypeInfoKeys::NAME]);
    }


    /**
     * Create the slice type that contains the typeinfo values from a list of typeinfo values
     * */
    fn createArrayFromTypeInfoValues (dmut _: &Validator, loc: &Word, ti: &ClassPtrType, values: [&Value])-> &Value
        throws ErrorMsg
    {
        let arrType = copy ArrayType (loc, ti, values.len, isMutable-> false);
        let arrVal = copy ArrayValue (loc, arrType, values);

        let slcType = copy SliceType (loc, ti, isMutable-> false);
        let addr = copy AddressValue (loc,
                                      copy PointerType (loc, ti, isMutable-> false),
                                      arrVal);

        let ctor = copy SliceCtorValue (loc, slcType,
                                        addr,
                                        copy NullValue (loc), // no need for blk info, slice is copied
                                        copy IntType (loc, values.len, size-> 0, isSigned-> false),
                                        isImplicitAlias-> true);

        copy CopierValue (loc, slcType, ctor, isDeep-> false)
    }

    /*!
     * ================================================================================
     * ================================================================================
     * =======================            FIELD INFOS             =====================
     * ================================================================================
     * ================================================================================
     */

    /**
     * Validate the field informations value of a class type
     * @params:
     *    - context: the context of the validation
     *    - loc: the location of the access
     *    - fi: the struct core::typeinfo::FieldInfo
     *    - c: the class being accessed
     * @returns: an array value with field informations
     * @throws:
     *    - &ErrorMsg: if an error occurs during the validation
     * */
    fn validateFieldInfoClass (dmut context: &Validator, loc: &Word, fi: &ClassPtrType, c: &ClassRefType)-> &Value
        throws ErrorMsg
    {
        let (inPrv, inProt) = context.getCurrentClassContextProtections (c);
        let sizes = context:.getSizeofValidator ():.computeSizeAndAligns (loc, c);
        let offset = if (c.isStruct ()) { 0us } else {
            (c.fields.len - c.localFields.len) + 2us // vtable, monitor, and ancestor fields
        };

        let mut values: [mut &Value] = [];

        for i, f in c.getLocalFields () match f {
            field: &VarDeclValue => {
                let canAccess = if (c.sym.isFieldPrivate (field.loc.str)) { inPrv }
                else if (c.sym.isFieldProtected (field.loc.str)) { inProt || inPrv }
                else { true };

                if (canAccess) {
                    values ~= [copy StructInitValue (loc,
                                                     type-> fi,
                                                     values-> copy [copy StringValue (loc, field.getLoc ().str),
                                                                    copy IntValue (loc, sizes [i + offset].0, size-> 0, isSigned-> false),
                                                                    copy IntValue (loc, sizes [i + offset].1, size-> 0, isSigned-> false)],
                                                     fields-> copy [TypeInfoKeys::NAME, TypeInfoKeys::OFFSET, TypeInfoKeys::SIZE])];
                }
            }
        }

        let arrType = copy ArrayType (loc, fi, values.len, isMutable-> false);
        copy ArrayValue (loc, arrType, values)
    }

    /**
     * Validate the field informations value of a tuple type
     * @params:
     *    - context: the context of the validation
     *    - loc: the location of the access
     *    - fi: the struct core::typeinfo::FieldInfo
     *    - t: the type being accessed
     * @returns: an array value with field informations
     * @throws:
     *    - &ErrorMsg: if an error occurs during the validation
     * */
    fn validateFieldInfoTuple (dmut context: &Validator, loc: &Word, fi: &ClassPtrType, t: &TupleType)-> &Value
        throws ErrorMsg
    {
        let sizes = context:.getSizeofValidator ():.computeSizeAndAligns (loc, t);
        let mut values: [&Value] = [];
        for size in sizes {
            values ~= [copy StructInitValue (loc,
                                             type-> fi,
                                             values-> copy [copy StringValue (loc, ""),
                                                            copy IntValue (loc, size._0, size-> 0, isSigned-> false),
                                                            copy IntValue (loc, size._1, size-> 0, isSigned-> false)],
                                             fields-> copy [TypeInfoKeys::NAME, TypeInfoKeys::OFFSET, TypeInfoKeys::SIZE])];
        }

        let arrType = copy ArrayType (loc, fi, values.len, isMutable-> false);
        copy ArrayValue (loc, arrType, values)
    }


}
