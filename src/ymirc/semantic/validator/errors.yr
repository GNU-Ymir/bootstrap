in errors;

use ymirc::errors::code;

/// Local shorthand for the catalogue entry type, cf. `ymirc::errors::code`.
def Error: code::Error;

/// The code of a message that is a context note rather than a diagnostic.
def NO_CODE = code::NO_CODE;

/**
 * All the error messages that can occur in symbol validation
 */
pub enum ValidateErrorMessage: Error
| ABSTRACT_CLASS_CALL                  = Error (NO_CODE, "from an proxied instance of class %(y) that is abstract")
| AKA_CLASS_CTOR                       = Error (4001,    "a name alias cannot be created to alias class ctors")
| ALIAS_INDEX_AFFECT                   = Error (4002,    "class alias operator @(y=:[) is prohibited on the left operand of an affectation")
| ALIAS_INDEX_AFFECT_NOTE              = Error (NO_CODE, "the index assignment already aliases the value implicitly, use @(y=[) instead")
| ALREADY_CAUGHT                       = Error (4003,    "exception type %(y) is already caught by another catching pattern of type %(y)")
| ALREADY_INIT_BY_CTOR_REDIRECT        = Error (4004,    "field %(y) was already initialized by ctor redirection")
| ARRAY_OVERFLOW                       = Error (4005,    "slice access, index overflow %(y) (len) <= %(y) (index)")
| ARRAY_PATTERN_SIZE                   = Error (4006,    "array pattern match len %(y) never matches the value len %(y)")
| ATOMIC_NEEDS_MONITOR                 = Error (NO_CODE, "@(r=atomic) operation can only monitor object instances")
| BRANCHING_VALUE                      = Error (NO_CODE, "when validating conditional value")
| BREAK_NO_LOOP                        = Error (4007,    "break statement is not within a loop")
| BREAK_SCOPE_GUARD                    = Error (4008,    "cannot break loop inside a scope guard")
| CONTINUE_NO_LOOP                     = Error (4009,    "continue statement is not within a loop")
| CONTINUE_SCOPE_GUARD                 = Error (4010,    "cannot continue loop inside a scope guard")
| CALL_BEGIN_ONE_LINE                  = Error (NO_CODE, "rewritten into let @(r=dmut) @(y=#_iter) = %(y).begin()")
| CALL_GET_OP_ITERATOR                 = Error (NO_CODE, "calling the @(y=get) method for iterator %(y) with template parameters {%(y), %(y)}")
| CALL_GET_OP_ONE_LINE                 = Error (NO_CODE, "rewritten into %(y) = %(y).get!{%(y), %(y)} ()")
| CALL_LEN_ONE_LINE                    = Error (NO_CODE, "rewritten into let @(y=#_len) = %(y).len()")
| CALL_NEXT_OP_ITERATOR                = Error (NO_CODE, "calling the @(y=next) method for iterator %(y)")
| CALL_NEXT_OP_ONE_LINE                = Error (NO_CODE, "rewritten into %(y) = %(y).next()")
| CALL_PROTO                           = Error (NO_CODE, "calling %(y)")
| CANDIDATE_ARE                        = Error (NO_CODE, "candidate %(y)")
| CANNOT_CASTTO_BASE_CLASS             = Error (4011,    "cannot cast derived type %(y) to base class type %(y) in that context")
| CATCH_NOTHING                        = Error (4012,    "catching pattern of type %(y) catches no exception")
| CATCH_PATTERN_MULT_OR_VDECL          = Error (4013,    "the pattern of a catch scope guard must start with a variable declaration or a field deconstructor")
| CATCH_VALIDATION                     = Error (NO_CODE, "when validating catching pattern with type %(y)")
| CLASS_ALIAS_FIELD                    = Error (4014,    "class alias operator @(y=:.) is not usable to access fields")
| CLASS_ALIAS_FIELD_NO_CLASS           = Error (4015,    "alias operator @(y=:.) is only usable on class, record, entity or map types, not %(y)")
| CLASS_ALIAS_INDEX_NO_CLASS           = Error (4016,    "class alias operator @(y=:[) is only usable on class, record or entity types, not %(y)")
| CLASS_FIELD_NOT_INIT_YET             = Error (NO_CODE, "field %(y) has not yet been initialized")
| CLASS_FIELD_NOT_VALIDATED_YET        = Error (4017,    "field %(y) has not yet been validated")
| CLASS_NOT_IMPL                       = Error (4018,    "class type %(y) does not implement trait %(y)")
| CLASS_NO_FIELD                       = Error (4019,    "class %(y) has no field named %(y)")
| CLASS_NO_FIELD_ACCESS_METHOD         = Error (NO_CODE, "class %(y) has no field access method named %(y)")
| CLASS_NO_FIELD_ASSIGN_METHOD         = Error (NO_CODE, "class %(y) has no field assign method named %(y)")
| CLASS_NO_METHOD                      = Error (4020,    "class %(y) has no method named %(y)")
| CLASS_THROW_PTR                      = Error (4021,    "class type expected, not the class object instance type %(y) (i.e. the @(y=&) is useless)")
| CLOSURE_TEMPLATE_LAMBDA              = Error (4022,    "closure functions cannot be used as template values")
| COLLIDING_FUNCTION_DEFINITION        = Error (4023,    "colliding function definitions %(y) and %(y)")
| COLLIDING_METHOD_DEFINITION          = Error (4024,    "colliding method definitions %(y) and %(y)")
| CONFLIT_DECORATORS                   = Error (4025,    "conflicting decorators %(y) and %(y)")
| CONSTRUCT_ABSTRACT_CLASS             = Error (4026,    "cannot construct an instance of class %(y) that is abstract")
| CONST_METHOD                         = Error (4027,    "method %(y) is defined as constant")
| CONTAIN_ALIASABLE_TYPE               = Error (4028,    "type %(y) cannot be embedded within a union type")
| CONTAIN_ALIASABLE_TYPE_NOTE          = Error (NO_CODE, "union cannot contain aliasable types, with the exceptions of pointer types")
| CONTAIN_MOVABLE_TYPE                 = Error (4029,    "movable type %(y) cannot be embedded within another type")
| CONTAIN_MOVABLE_TYPE_NOTE            = Error (NO_CODE, "only an entity type can contain another entity type")
| CONTAIN_MOVABLE_TYPE_RECORD          = Error (NO_CODE, "the structure is defined as a record but must be an entity to store movable values")
| CTE_ASSERT_NO_MSG                    = Error (4030,    "cte assertion failed")
| CTE_ASSERT_WITH_MSG                  = Error (4031,    "cte assertion failed %(y)")
| CTE_IGNORED                          = Error (4032,    "%(y) values contained in a block scope are ignored during compile time execution")
| CTOR_CLASS_DCOPY                     = Error (4033,    "using a deep copy instead of a one level copy is prohibited when constructing class %(y)")
| CTOR_CLASS_STACK                     = Error (4034,    "creating an instance of class %(y) on the stack is prohibited")
| CTOR_INFINITE_REDIRECTION            = Error (4035,    "infinite constructor redirection calls when calling %(y)")
| CTOR_MAP_DCOPY                       = Error (4036,    "using a deep copy instead of a one level copy is prohibited when constructing a map %(y)")
| CTOR_MAP_STACK                       = Error (4037,    "creating an instance of map %(y) on the stack is prohibited")
| DECLARED_HERE                        = Error (NO_CODE, "declared here")
| DECLARED_NOT_USED                    = Error (4038,    "the symbol %(y) was declared but never used")
| DECLARE_VOID_VAR                     = Error (4039,    "cannot declare a variable of type %(y)")
| DECREASING_RANGE_ACCESS              = Error (4040,    "range index cannot be decreasing for type %(y), but goes from %(y) to %(y)")
| DEEPLY_INNER_TYPE                    = Error (4041,    "decorator is not applicable on inner types, already deeply mutable")
| DEFAULT_VAR_NO_NAME                  = Error (4042,    "parameter with a default value must have a referenceable name")
| DEFAULT_VAR_REF                      = Error (4043,    "parameter with a default value cannot be a reference")
| CLASS_FIELD_NO_NAME                  = Error (4044,    "field must have a referenceable name")
| DEFINED_HERE                         = Error (NO_CODE, "defined here")
| DISCARD_CONST                        = Error (4045,    "discarding the constant property is prohibited")
| DISCARD_CONST_LEVEL_TYPES            = Error (NO_CODE, "from %(y) to %(y)")
| DIVISION_BY_ZERO                     = Error (4046,    "division by 0")
| DOLLAR_OUTSIDE_CONTEXT               = Error (4047,    "'$' is usable only inside an index operation")
| DTOR_SELF_NOT_MUT                    = Error (4048,    "the @(y=self) parameter must be mutable in the destructor")
| EMPTY_ARRAY_INNER                    = Error (4049,    "array inner type cannot be %(y)")
| EMPTY_FORMAT_EMBED                   = Error (4050,    "empty interpolation, expected an expression between @(y=${) and @(y=})")
| EMPTY_METHOD_CALL                    = Error (4051,    "cannot perform a direct call of the method %(y) that is empty")
| EMPTY_METHOD_NO_ABSTRACT             = Error (NO_CODE, "%(y) is empty")
| ENCLOSE_COPY_CLASS_CTOR              = Error (NO_CODE, "did you mean to enclose the constructor call within a @(y=copy)?")
| ENCLOSE_COPY_LST                     = Error (NO_CODE, "did you mean to enclose it within a @(y=copy)?")
| ENCLOSE_INCOMPLETE_TYPE              = Error (4052,    "the type %(y) cannot be enclosed because it is not complete")
| ENCLOSE_MOVABLE_TYPE                 = Error (4053,    "movable type %(y) cannot be enclosed within a closure function")
| ERROR_PARAM                          = Error (NO_CODE, "value %(y) is of type %(y)")
| EXCEPTION_NOT_CAUGHT                 = Error (4054,    "scope guard does not catch exceptions of type %(y)")
| EXITING_SCOPE_HERE                   = Error (NO_CODE, "exiting scope here")
| EXIT_SCOPE_NO_THROW                  = Error (4055,    "%(y) guard cannot be used when guarding a scope that cannot throw")
| EXIT_SCOPE_VALUE_TYPE                = Error (4056,    "%(y) scope guard value must be of type @(y=void), not %(y)")
| EXTERN_GLOBAL_NO_TYPE                = Error (4057,    "external global variable must be declared with a type")
| EXTERN_GLOBAL_WITH_VALUE             = Error (4058,    "external global variable cannot be declared with a value")
| FIELD_MATCHER_NO_NAME                = Error (4059,    "expected a name expression")
| FIELD_METHOD_ACCESS_NOT_APPLICABLE   = Error (NO_CODE, "method %(y) is a field access, and therefore not applicable here")
| FIELD_METHOD_ACCESS_NO_RETURN        = Error (4060,    "field access method must return a value")
| FIELD_METHOD_ALIAS                   = Error (4061,    "method %(y) is a field method")
| FIELD_METHOD_ASSIGN_CONST            = Error (4062,    "field assign method must be mutable")
| FIELD_METHOD_ASSIGN_NOT_APPLICABLE   = Error (NO_CODE, "method %(y) is a field assign, and therefore not applicable here")
| FIELD_METHOD_ASSIGN_WITH_RETURN      = Error (4063,    "field assign method must not return a value")
| FIELD_METHOD_COLLISION               = Error (4064,    "field method %(y) cannot be overlapped by a method with the same name %(y)")
| FIELD_METHOD_MUTABLE_ALIAS           = Error (4065,    "field method %(y) is mutable")
| FIELD_METHOD_PARAMS                  = Error (4066,    "field method cannot have more than one parameter")
| FIRST_DEFINED                        = Error (NO_CODE, "defined here")
| FORBID_DECO_FOR_LOOP                 = Error (4067,    "decorators are forbidden for index iterator, on %(y) iteration")
| FORGET_AND_CLASS                     = Error (NO_CODE, "did you forget @(y=&)?")
| FORGET_AND_PROTO                     = Error (NO_CODE, "or did you forget @(y=&)?")
| FORGET_PAR_PROTO_CALL                = Error (NO_CODE, "did you forget %(y)?")
| FORWARD_REFERENCE_AKA                = Error (4068,    "the name alias %(y) cannot be validated due to forward reference")
| FORWARD_REFERENCE_TYPE               = Error (4069,    "the type cannot be validated due to forward reference")
| FORWARD_REFERENCE_VALUE              = Error (4070,    "the value cannot be computed, as it depends on a forward reference")
| FORWARD_REFERENCE_VAR                = Error (4071,    "the type cannot be inferred, as it depends on a forward reference")
| FOR_FIELD                            = Error (NO_CODE, "for the field %(y)")
| FOR_LOOP_CPTR                        = Error (4072,    "overriding the for loop operation on a class type %(y)")
| FOR_PATTERN_FIELD                    = Error (NO_CODE, "for pattern field access %(y) on type %(y)")
| FOR_TYPE                             = Error (NO_CODE, "within type %(y)")
| FUNCTION_TO_FPTR_ENTITY              = Error (4073,    "cannot create a function pointer, entities are not copiable")
| FUNCTION_TO_FPTR_RECORD              = Error (4074,    "cannot create a function pointer, it would enclose the record by reference")
| FUNCTION_TO_FPTR_RECORD_DCOPY        = Error (4075,    "using a deep copy instead of a one level copy is prohibited when enclosing a record")
| FUNCTION_TO_FPTR_THROWING            = Error (4076,    "cannot create a function pointer from the throwing function %(y)")
| FUNCTION_TO_FPTR_UNSAFE              = Error (4077,    "cannot create a function pointer from the unsafe function %(y)")
| FUNCTION_TO_OPTION_NO_THROW          = Error (4078,    "cannot create an option delegate from the non throwing function %(y)")
| GEN_CTOR_HIDDEN_FIELD_NO_VALUE       = Error (4079,    "the field %(y) is not public, and has no initial value to be constructed from")
| GLOBAL_NO_VALUE                      = Error (4080,    "local global variable must be declared with a value")
| HERE                                 = Error (NO_CODE, "here")
| IF_COND_NOT_COMPLETE                 = Error (4081,    "the if condition has no else value, so it must produce a @(y=void) value not a %(y)")
| IMMUTABLE_LVALUE                     = Error (4082,    "left operand of type %(y) is immutable")
| IMMUTABLE_PARENT                     = Error (4083,    "type must be immutable")
| IMPLICIT_ADDRESS_FUNCTION            = Error (4084,    "cannot create a function pointer from %(y) implicitly")
| IMPLICIT_ADDRESS_METHOD              = Error (4085,    "cannot create a delegate from the method %(y) implicitly")
| IMPLICIT_ALIAS                       = Error (NO_CODE, "implicit @(r=alias) of type %(y) is prohibited, it implicitly gives up on borrowings of mutable values")
| IMPLICIT_CONST_REFERENCE             = Error (4086,    "@(r=ref) of type %(y) must be const, but is mutable")
| IMPLICIT_LAZY                        = Error (4087,    "cannot construct a lazy value of type %(y) implicitly")
| IMPLICIT_MOVE                        = Error (4088,    "implicit @(r=move) of type %(y) is prohibited")
| IMPLICIT_MUT_REFERENCE               = Error (4089,    "@(r=ref) of type %(y) must be mutable, but is const")
| IMPLICIT_OVERRIDE                    = Error (4090,    "method %(y) implicitly overrides method %(y)")
| IMPLICIT_OVERRIDE_BY_TRAIT           = Error (4091,    "implicit override of method %(y) by trait @(y=impl)")
| IMPLICIT_REFERENCE                   = Error (4092,    "cannot pass value of type %(y) as @(r=ref)")
| IMPL_MULTIPLE_TIMES                  = Error (4093,    "trait %(y) is implemented multiple times by %(y)")
| IMPL_NO_TRAIT                        = Error (4094,    "@(r=impl) statement must be followed by a trait, not %(y)")
| INCOMPATIBLE_TYPE                    = Error (4095,    "incompatible types %(y) and %(y)")
| INCOMPATIBLE_VALUES                  = Error (4096,    "incompatible values %(y) and %(y)")
| INCOMPLETE_TYPE                      = Error (4097,    "the type %(y) is not complete")
| INCOMPLETE_TYPE_CLASS                = Error (4098,    "the type %(y) is not complete due to previous errors")
| INCOMPLETE_TYPE_CLREF                = Error (NO_CODE, "type %(y) is a class")
| INDEX_ASSIGN_NOT_MUTABLE             = Error (4099,    "index assignment of a value of type %(y) requires a mutable value")
| INDEX_ASSIGN_NOT_MUTABLE_NOTE        = Error (NO_CODE, "the index assignment calls the mutable method @(y=opIndexAssign), and thus implicitly aliases the value")
| INDEX_ASSIGN_REWRITE                 = Error (NO_CODE, "when rewriting as an index assign operator")
| INFINITE_LOOP                        = Error (4100,    "infinite loop with always @(y=true) test is not allowed, rather use a @(y=loop) construct")
| INHERIT_FINAL_CLASS                  = Error (4101,    "the base class %(y) is marked as final")
| INHERIT_NO_CLASS                     = Error (4102,    "the base of a class must be a class, not a %(y)")
| INLINE_VIRTUAL_METHOD                = Error (4103,    "method %(y) cannot be inline as it is virtual(overridable or inherited)")
| INVALID_SYMBOLS                      = Error (4104,    "symbol %(y) has errors")
| IN_FORMAT_EMBED                      = Error (NO_CODE, "in the interpolation of a format string")
| IN_MACRO_FINALIZATION                = Error (NO_CODE, "during finalization of macro content: \n%\n%\n%")
| IS_AN_ENTITY                         = Error (NO_CODE, "%(y) is an entity type")
| IS_A_METHOD                          = Error (4105,    "%(y) is a method and must be called from an instance")
| IS_A_RECORD                          = Error (NO_CODE, "%(y) is a record type")
| IS_NATIVE_TYPE                       = Error (4106,    "the identifier %(y) describes a native type but has no meaning within this context")
| IS_NOT_CALLABLE                      = Error (4107,    "call operator is not defined for value %(y)")
| LAZY_VALIDATION                      = Error (4108,    "validation of lazy closure function fails to generate value of type %(y)")
| LIST_COMPR_SIZE_CTE                  = Error (4109,    "the size of the list comprehension, constructed from type %(y), must be determinable at compile time")
| MACRO_CALL_VALIDATION_FAILED         = Error (4110,    "validation of macro call failed")
| MACRO_DOES_NOT_MATCH                 = Error (4111,    "macro call with \"%(y)\" does not match the rule \"%(y)\"")
| MACRO_IN_CTOR                        = Error (NO_CODE, "in validation of macro constructor")
| MACRO_IN_RULE                        = Error (NO_CODE, "in validation of macro rule %(y)")
| MACRO_REST                           = Error (4112,    "macro validation is not complete, some tokens remain unassociated \n%\n%\n%")
| MAIN_FUNCTION_ONE_ARG                = Error (4113,    "main function takes at most one argument")
| MAIN_INLINE                          = Error (4114,    "main function cannot be inline")
| MALFORMED_CHAR                       = Error (4115,    "malformed literal, number of %(y) is %(y)")
| MALFORMED_CORE                       = Error (4116,    "core module is malformed")
| MALFORMED_FLOAT_LITERAL              = Error (4117,    "malformed float literal %(y)")
| MALFORMED_INT_LITERAL                = Error (4118,    "malformed int literal %(y)")
| MALFORMED_PRAGMA                     = Error (4119,    "malformed __pragma %(y)")
| MAP_KEY_MUTABLE                      = Error (4120,    "the type %(y) that is used as a map key must always be immutable")
| MAP_KEY_NOT_COMPARABLE               = Error (4121,    "the type %(y) cannot be used as a key, it is not comparable")
| MAP_KEY_NOT_HASHABLE                 = Error (4122,    "the type %(y) cannot be used as a key, it is not hashable")
| MATCH_NOT_COMPLETE                   = Error (4123,    "the pattern matching has no default case, so each branch must produce a @(y=void) value not a %(y)")
| MATCH_VALIDATION                     = Error (NO_CODE, "when validating pattern matching with value %(y) of type %(y)")
| MAX_LOOP_ITERATIONS                  = Error (4124,    "reached the maximum number of cte iterations %(y) > %(y)")
| MAYBE_TYPE_AKA                       = Error (NO_CODE, "maybe a type name alias was meant (i.e. using the token @(y=:) instead of @(y==))")
| MISMATCH_ALIAS_EXPAND                = Error (4125,    "cannot alias an expand value, maybe @(y=alias) and @(y=expand) keywords are inverted? (@(y=expand alias) V)")
| MISMATCH_ALIAS_LAZY                  = Error (4126,    "cannot alias a lazy value, maybe @(y=alias) and @(y=lazy) keywords are inverted? (@(y=lazy alias) V)")
| MISMATCH_COPY_EXPAND                 = Error (4127,    "cannot copy an expand value, maybe @(y=copy) and @(y=expand) keywords are inverted? (@(y=expand copy) V)")
| MISMATCH_COPY_LAZY                   = Error (4128,    "cannot copy a lazy value, maybe @(y=copy) and @(y=lazy) keywords are inverted? (@(y=lazy copy) V)")
| MISMATCH_DCOPY_EXPAND                = Error (4129,    "cannot copy an expand value, maybe @(y=dcopy) and @(y=expand) keywords are inverted? (@(y=expand dcopy) V)")
| MISMATCH_DCOPY_LAZY                  = Error (4130,    "cannot copy a lazy value, maybe @(y=dcopy) and @(y=lazy) keywords are inverted? (@(y=lazy dcopy) V)")
| MISMATCH_TUPLE_ARITY                 = Error (4131,    "mismatch tuple arity %(y) and %(y)")
| MULTIPLE_DECORATORS                  = Error (4132,    "decorator %(y) is specified multiple times")
| MULTIPLE_FIELD_INIT                  = Error (4133,    "field %(y) is initialized multiple times")
| MULTIPLE_NAMED_PARAM                 = Error (4134,    "named parameter %(y) is set multiple times")
| MULTIPLE_SYMBOL_TYPES                = Error (4135,    "expression refers to multiple symbols that generate types")
| MULTIPLE_UNSAFE                      = Error (4136,    "context is already unsafe")
| MUTABLE_CONST_ITERATOR               = Error (4137,    "an iterator cannot be mutable, if it is not a reference or does not borrow mutable data")
| MUTABLE_CONST_PARAM                  = Error (4138,    "a parameter cannot be mutable, if it is not a reference or does not borrow mutable data")
| MUTABLE_LAMBDA_VAR                   = Error (4139,    "a lambda variable cannot be mutable")
| MUTABLE_LAZY_VAR                     = Error (4140,    "a lazy variable cannot be mutable, if it does not borrow mutable data")
| MUTABLE_METHOD                       = Error (4141,    "method %(y) is defined as mutable")
| NEGATIVE_INT_INDEX                   = Error (4142,    "index cannot be negative for type %(y), but is %(y)")
| NEVER_ENTERED_LOOP                   = Error (4143,    "loop test is always @(y=false), loop is never entered")
| NON_ABSTRACT_NOT_COMPLETE            = Error (4144,    "class %(y) is not abstract but has empty methods")
| NOTHING_TO_CATCH                     = Error (4145,    "nothing to catch")
| NOT_ALIASABLE                        = Error (4146,    "%(y) is not an aliasable type")
| NOT_ANCESTOR                         = Error (4147,    "%(y) is not an ancestor type of %(y)")
| NOT_AN_ARRAY                         = Error (4148,    "%(y) is not an array type")
| NOT_AN_EXCEPTION_CLASS               = Error (4149,    "class type %(y) does not inherit from exception type %(y)")
| NOT_A_CLASS                          = Error (4150,    "%(y) is not a class type")
| NOT_A_LVALUE                         = Error (4151,    "not a lvalue")
| NOT_A_LVALUE_CLOSURE                 = Error (4152,    "%(y) is enclosed, and cannot be used as a lvalue")
| NOT_A_LVALUE_ITERATOR                = Error (4153,    "%(y) is a value iterator, and cannot be used as a lvalue")
| NOT_A_LVALUE_LAZY                    = Error (4154,    "%(y) is a lazy variable, and cannot be used as a lvalue")
| NOT_A_LVALUE_MAP_ACCESS              = Error (4155,    "%(y) is a map access, and cannot be used as a lvalue")
| NOT_A_LVALUE_PARAM                   = Error (4156,    "%(y) is a value parameter, and cannot be used as a lvalue")
| NOT_A_LVALUE_TYPE                    = Error (4157,    "value of type %(y) is not a lvalue")
| NOT_A_MAP                            = Error (4158,    "%(y) is not a map type")
| NOT_A_RECORD                         = Error (4159,    "%(y) is not a record type")
| NOT_A_SLICE                          = Error (4160,    "%(y) is not a slice type")
| NOT_AN_ENTITY                        = Error (4161,    "%(y) is not an entity type")
| NOT_A_TRAIT                          = Error (4162,    "%(y) is not a trait")
| NOT_A_TUPLE                          = Error (4163,    "%(y) is not a tuple type")
| NOT_AN_UNION                         = Error (4164,    "%(y) is not a union type")
| NOT_CALLABLE                         = Error (NO_CODE, "call operator is not defined for type %(y)")
| NOT_MOVABLE                          = Error (4165,    "type %(y) is not a movable type")
| NOT_UNSAFE                           = Error (4166,    "an unsafe context is entered, but no unsafe operations are made")
| NO_ALIAS_PATTERN                     = Error (NO_CODE, "there is no pattern that requires the value to be passed by @(y=alias)")
| NO_COPY_EXIST                        = Error (4167,    "no copy exists for type %(y)")
| NO_CTOR_FOUND                        = Error (4168,    "no constructor found for class %(y)")
| NO_CTOR_FOUND_NAME                   = Error (4169,    "no constructor named %(y) found for class %(y)")
| NO_DEFAULT_CTOR_MOVE_STRUCT          = Error (4170,    "type %(y) is an entity, but has no default ctor @(r=self)()")
| NO_LAZY_PATTERN                      = Error (NO_CODE, "there is no pattern that requires the value to be lazy")
| NO_PARAMETER_NAMED                   = Error (4171,    "no parameter is named %(y)")
| NO_REFERENCE_PATTERN                 = Error (NO_CODE, "there is no pattern that requires the value to be passed by mutable reference")
