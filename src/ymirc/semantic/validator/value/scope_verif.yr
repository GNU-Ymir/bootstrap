in scope_verif;

use ymirc::semantic::validator;
use ymirc::errors::message;
use ymirc::semantic::generator::{value, value::_};

use ymirc::lexing::word;

prv {    
    lazy __NATIVE_TYPES__ = {
        let dmut lst: [[c8] => ()] = copy [];
        for i in NativeTypes::__members__ if t != NativeTypes::ERROR {
            lst [i] = ();
        }
    };
}

pub mod ScopeVerification {


    pub fn verifyUnsafeContext (dmut context: &ValidationContext, loc: &Word, msg: [c8] = ValidateErrorMessage::UNSAFE_OPERATION)
        throws ErrorMsg
    {
        if context.getUnsafeContextLoc ().isEof {
            throw copy ErrorMsg::fatal (loc, msg);
        }
                
        context:.setUnsafeContextUsed (loc);        
    }
    
    pub fn verifyShadow (context: &ValidationContext, loc: &Word, name: [c8] = "")
        throws ErrorMsg
    {
        let realName = if (name == "") {
            loc.str
        } else { name };

        // No shadow for ignore var
        if (realName == Keys::UNDER) return;

        // No shadow for internal variables
        if (realName.len > 0us && realName [0] == '#') return;

        ScopeValidation::verifyNotIsNativeType (loc, realName);
        if let Ok (gen) = context.getLocalNoUse (realName) {        
            throw copy ErrorMsg::fatal (loc, format (ValidateErrorMessage::SHADOWING_DECL, realName),
                                        notes-> copy [copy ErrorMsg::note (gen.getLoc (), ValidateErrorMessage::FIRST_DEFINED)]);        
        }
    }
    
    pub fn verifyNotIsNativeType (loc: &Word, name: [c8])
        throws ErrorMsg
    {
        if name in __NATIVE_TYPES__ {
            throw copy ErrorMsg::fatal (loc, format (ValidateErrorMessage::IS_NATIVE_TYPE, name));
        }
    }

    pub fn verifyNoBreaking (loc: &Word, value: &Value)
        throws ErrorMsg
    {
        if value.isBreaker {
            throw copy ErrorMsg::fatal (loc, format (ValidateErrorMessage::UNREACHBLE_STATEMENT),
                                        notes-> copy [copy ErrorMsg::note (value.breakerLoc, ValidateErrorMessage::EXITING_SCOPE_HERE)]);
        }

        if value.isReturner {
            throw copy ErrorMsg::fatal (loc, format (ValidateErrorMessage::UNREACHBLE_STATEMENT),
                                        notes-> copy [copy ErrorMsg::note (value.returnerLoc, ValidateErrorMessage::EXITING_SCOPE_HERE)]);
        }
    }        


    pub fn createGlobalVarError (contex:   &ValidationContext,
                                 loc:      &Word,
                                 name:     [c8],
                                 subError: [&ErrorMsg] = [])-> &ErrorMsg {
        let glb = context.declarator.createGlobalAccessError (loc, name, context.referent);
        {
            ScopeVerification::verifyNotIsNativeType (loc, name);
        } catch {
            err: &ErrorMsg => {
                return copy ErrorMsg::list (copy [glb, err] ~ subError);
            }
        }

        let sub = if context.isUninitFieldValidated (name) {
            subError ~ [copy ErrorMsg::note (loc, format (ValidateErrorMessage::CLASS_FIELD_NOT_INIT_YET, name))]
        } else { subError }

        glb.withNote (sub)
    }

    pub fn createLocalVarError (context:  &ValidationContext,
                                loc:      &Word,
                                module:   &ModuleRefValue,
                                name:     [c8],
                                subError: [&ErrorMsg] = [])-> [&ErrorMsg]
    {
        let glb = context.declarator.createLocalAccessError (loc, name, module.sym, context.referent);
        {
            ScopeVerification::verifyNotIsNativeType (loc, name);
        } catch {
            err: &ErrorMsg => {
                return (glb ~ [err]) ~ subError;
            }
        }

        glb ~ subError
    }
    
}
