in instruction;

use ymirc::syntax::expression::instruction;
use ymirc::semantic::validator;
use ymirc::semantic::generator::value;

use ymirc::errors::message;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub mod ::assert_;
pub mod ::break_;
pub mod ::panic_;
pub mod ::patterndecl;
pub mod ::return_;
pub mod ::throw_;
pub mod ::vardecl;
pub mod ::yield_;


/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          ROOT          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */


pub mod InstructionValidation {

    pub fn validate (dmut context: &ValidationContext, instr: &InstructionExpr)-> &Value
        throws ErrorMsg
    {
        match instr { 
            a: &AssertExpr         => return AssertValidation::validate (alias context, a);
            b: &BreakExpr          => return BreakValidation::validate (alias context, b);
            p: &PanicExpr          => return PanicValidation::validate (alias context, p);
            p: &PatternVarDeclExpr => return PatternVarDeclValidation (alias context, p);
            r: &ReturnExpr         => return ReturnValidation::validate (alias context, r);
            t: &ThrowExpr          => return ThrowValidation::validate (alias context, t);
            v: &VarDeclExpr        => return VarDeclValidation::validate (alias context, v);
            y: &YieldExpr          => return YieldValidation::validate (alias context, y);
            _ => {
                eprintln ("internal instruction validation; ", control.__typeinfo.name);
                panic;
            }
        }
    }
    
}

