in instruction;

use ymirc::syntax::expression::instruction;
use ymirc::semantic::validator;
use ymirc::semantic::generator::value;

use ymirc::errors;
use std::io;

use ymirc::semantic::validator::value::instruction::_;


/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub mod ::assert_;
pub mod ::vardecl;
pub mod ::patterndecl;

mod ::break_;
mod ::continue_;
mod ::panic_;
mod ::return_;
mod ::throw_;
mod ::yield_;


/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          ROOT          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * InstructionValidation module
 *
 * Provides the dispatch function for validating instruction expressions.
 *
 * Responsibilities:
 *   - inspect the dynamic variant of an InstructionExpr,
 *   - forward validation to the appropriate specialized module:
 *
 *        * AssertExpr            → AssertValidation
 *        * BreakExpr             → BreakValidation
 *        * ContinueExpr          → ContinueValidation
 *        * PanicExpr             → PanicValidation
 *        * PatternVarDeclExpr    → PatternVarDeclValidation
 *        * ReturnExpr            → ReturnValidation
 *        * ThrowExpr             → ThrowValidation
 *        * VarDeclExpr           → VarDeclValidation
 *        * YieldExpr             → YieldValidation
 *
 *   - report internal errors for unknown instruction types.
 *
 * This module ensures that all instruction expressions share a uniform
 * validation entry point.
 */
pub mod InstructionValidation {

    /**
     * Validate an instruction expression by dispatching to the correct validator.
     *
     * @params:
     *   - context: validation context
     *   - instr:   instruction expression to validate
     *
     * @returns:
     *   - the validated Value
     *
     * @throws:
     *   - ErrorMsg if the delegated validator throws
     */
    pub fn validate(dmut context: &ValidationContext, instr: &InstructionExpr)-> &Value
        throws ErrorMsg
    {
        match instr {
            a: &AssertExpr => return AssertValidation::validate(alias context, a);
            b: &BreakExpr => return BreakValidation::validate(alias context, b);
            c: &ContinueExpr => return ContinueValidation::validate(alias context, c);
            p: &PanicExpr => return PanicValidation::validate(alias context, p);
            p: &PatternVarDeclExpr => return PatternVarDeclValidation::validate(alias context, p);
            r: &ReturnExpr => return ReturnValidation::validate(alias context, r);
            t: &ThrowExpr => return ThrowValidation::validate(alias context, t);
            v: &VarDeclExpr => return VarDeclValidation::validate(alias context, v);
            y: &YieldExpr => return YieldValidation::validate(alias context, y);
            _ => {
                eprintln("internal instruction validation; ", instr.__typeinfo.name);
                panic;
            }
        }
    }
}
