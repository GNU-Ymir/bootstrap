in throw_;

use ymirc::syntax::expression::instruction;
use ymirc::semantic::validator;
use ymirc::semantic::generator::value::_;
use ymirc::errors;

use ymirc::utils::format;


/**
 * ThrowValidation module
 *
 * Provides validation for `throw` expressions.
 *
 * Semantics:
 *   - A `throw` must appear inside a function or lambda body.
 *   - A `throw` cannot cross a scope guard; doing so is illegal.
 *
 *   - The thrown expression must be an exception type. The expected
 *     exception type is created via createExceptionType and the thrown
 *     value must be an ancestor of that type.
 *
 *   - A `throw` expression itself has type `void`.
 *
 * The module enforces:
 *   - correct function-context usage
 *   - correct scope-guard restrictions
 *   - correct exception typing
 */
pub mod ThrowValidation {

    /**
     * Validate a `throw` expression.
     *
     * @returns:
     *   - ThrowValue
     *
     * @throws:
     *   - ErrorMsg if the throw is outside a function, crosses a scope
     *     guard, or the thrown value is not an exception type
     */
    pub fn validate(dmut context: &ValidationContext, t: &ThrowExpr)-> &Value
        throws ErrorMsg
    {
        if (!context.isInFunctionBody()) {
            throw copy ErrorMsg::fatal(t.loc, ValidateErrorMessage::THROW_NO_FUNCTION);
        }

        let inScope = context.getInScopeGuard();
        if (!inScope.isEof) {
            throw copy ErrorMsg::fatal(t.loc,
                                        end-> inScope,
                                        format(ValidateErrorMessage::THROW_SCOPE_GUARD));
        }

        let inner = ValueValidation::validate(alias context, t.value);

        let exceptionType = TypeCreation::createExceptionType(alias context, loc-> t.loc);
        TypeVerification::verifyAncestor(t.loc, exceptionType, inner.type);

        return copy ThrowValue(t.loc, inner);
    }

}
