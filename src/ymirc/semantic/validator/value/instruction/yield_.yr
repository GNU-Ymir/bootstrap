/*
 * Implements validation for `yield` expressions in Ymir.
 *
 * The `yield` keyword is reserved for future extensions(e.g., generator
 * functions, coroutines, or resumable computations). It is currently not
 * supported by the language and always produces a fatal error.
 *
 * Responsibilities:
 *   - detect any use of `yield`
 *   - emit a NOT_SUPPORTED_IN error referencing the current Ymir version
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::value::instruction::yield_
 * @File: ymirc/semantic/validator/value/instruction/yield_.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-03-27
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in yield_;

use ymirc::syntax::expression::instruction;
use ymirc::semantic::validator;
use ymirc::semantic::generator::value;
use ymirc::errors;

use ymirc::global::common;
use ymirc::utils::format;

/**
 * YieldValidation module
 *
 * Provides validation for `yield` expressions.
 *
 * Semantics:
 *   - `yield` is not yet part of the Ymir language.
 *   - Any occurrence of `yield` results in a fatal error.
 *
 */
pub mod YieldValidation {

    /**
     * Validate a `yield` expression.
     *
     * Since `yield` is not currently supported in Ymir, this function always
     * emits a NOT_SUPPORTED_IN fatal error.
     *
     * @returns:
     *   - never returns; always throws
     *
     * @throws:
     *   - ErrorMsg::fatal(NOT_SUPPORTED_IN)
     */
    pub fn validate(dmut context: &ValidationContext, y: &YieldExpr)-> &Value
        throws ErrorMsg
    {
        context;

        throw copy ErrorMsg::fatal(y.loc, format(ValidateErrorMessage::NOT_SUPPORTED_IN, __YMIR_VERSION__));
    }

}
