 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in yield_;

use ymirc::errors;
use ymirc::semantic::generator::type::native;
use ymirc::semantic::generator::value::_;
use ymirc::syntax::expression::_;
use ymirc::utils::format;

/**
 * YieldValidation module
 *
 * Semantics:
 *   - a `yield` must appear in the body of a generator, not in a lambda nested in it,
 *   - it must carry a value, compatible with the type the generator yields,
 *   - a `yield in` carries a generator, whose values are checked as the value of a yield,
 *   - it cannot appear inside a try block, a catch or a scope guard, as the body
 *     would be resumed inside a region the resumption cannot re-enter,
 *   - the instruction itself is typed `void`.
 */
pub mod YieldValidation {

    /**
     * Validate a `yield` instruction.
     *
     * @returns:
     *   - YieldValue, or YieldInValue for a `yield in`
     *
     * @throws:
     *   - ErrorMsg if the yield is outside a generator, has no value, is inside a
     *     protected region, or yields a value incompatible with the generator
     */
    pub fn validate(dmut context: &ValidationContext, y: &YieldExpr)-> &Value
        throws ErrorMsg
    {
        let yieldType = context.getYieldType();
        if yieldType of NoneType {
            throw copy ErrorMsg::fatal(y.loc, ValidateErrorMessage::YIELD_NO_GENERATOR);
        }

        if y.value of EmptyExpr {
            throw copy ErrorMsg::fatal(y.loc, format(ValidateErrorMessage::YIELD_NO_VALUE, yieldType));
        }

        let inScope = context.getInScopeGuard();
        if !inScope.isEof {
            throw copy ErrorMsg::fatal(y.loc, end-> inScope, ValidateErrorMessage::YIELD_PROTECTED_REGION);
        }

        let inRegion = context.getInProtectedRegion();
        if !inRegion.isEof {
            throw copy ErrorMsg::fatal(y.loc, end-> inRegion, ValidateErrorMessage::YIELD_PROTECTED_REGION);
        }

        if y.isIn {
            return YieldValidation::validateIn(alias context, y, yieldType);
        }

        let mut val = ValueValidation::validate(alias context, y.value);
        val = TypeInference::inferValueForType(alias context, yieldType.loc, val, type-> yieldType, byReference-> false);
        MemoryVerification::verifyMemoryOwner(yieldType.loc, yieldType, val, construct-> true, byReference-> false);

        return copy YieldValue(y.loc, val);
    }

    /**
     * Validate a `yield in`, whose generator can be aliased to borrow its values mutably.
     *
     * @params:
     *   - yieldType: the type yielded by the enclosing generator
     *
     * @throws:
     *   - ErrorMsg if the value is not a generator, or yields values the enclosing
     *     generator cannot yield
     */
    fn validateIn(dmut context: &ValidationContext, y: &YieldExpr, yieldType: &Type)-> &Value
        throws ErrorMsg
    {
        let mValue = ValueValidation::validate(alias context, y.value);
        let generator = if let a: &AliaserValue = mValue { a.value } else { mValue };

        ValueVerification::verifyNoBreaking(generator.loc, generator);
        let inner = match generator.type {
            g: &YieldType => { g }
            _ => {
                throw copy ErrorMsg::fatal(generator.loc, format(ValidateErrorMessage::YIELD_IN_NO_GENERATOR, generator.type));
            }
        };

        let yielded = copy VarRefValue(generator.loc, generator.loc, inner.retType, 0us, canCte-> false);
        let content: &Value = if (mValue of AliaserValue) {
            copy AliaserValue(mValue.loc, inner.retType, yielded)
        } else {
            yielded
        };

        TypeVerification::verifyCompatible(yieldType.loc, generator.loc, yieldType, inner.retType);
        MemoryVerification::verifyMemoryOwner(yieldType.loc, yieldType, content, construct-> true, byReference-> false);

        return copy YieldInValue(y.loc, generator);
    }

}
