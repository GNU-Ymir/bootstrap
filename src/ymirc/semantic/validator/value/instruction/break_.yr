 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in break_;

use ymirc::syntax::expression::_;
use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::_, type::_};
use ymirc::errors::message;

use ymirc::utils::format;

/**
 * BreakValidation module
 *
 * Provides validation for `break` expressions.
 *
 * Semantics:
 *   - A `break` must appear inside a loop; otherwise BREAK_NO_LOOP.
 *
 *   - A `break` cannot cross a scope guard(e.g., defer-like constructs);
 *     if a guard is active => BREAK_SCOPE_GUARD.
 *
 *   - A `break` may optionally carry a value:
 *        break x
 *     This is allowed only in value-producing loops(`loop`).
 *
 *   - All break values contribute to the loop’s resulting type. The
 *     type is inferred incrementally using inferValueForBranch.
 *
 *   - Mutability and ownership constraints are verified for the break
 *     payload before updating the loop type.
 *
 * The module enforces:
 *   - correct loop context
 *   - correct scope-guard restrictions
 *   - correct type inference for break branches
 *   - correct memory-ownership rules
 */
pub mod BreakValidation {

    /**
     * Validate a `break` expression.
     *
     * @returns:
     *   - BreakValue
     *
     * @throws:
     *   - ErrorMsg if the break is outside a loop, crosses a scope guard,
     *     or if the break value is invalid
     */
    pub fn validate(dmut context: &ValidationContext, b: &BreakExpr)-> &Value
        throws ErrorMsg
    {
        if (!context.isInLoop()) {
            throw copy ErrorMsg::fatal(b.loc, ValidateErrorMessage::BREAK_NO_LOOP);
        }

        let inScope = context.getInScopeGuard();
        if (!inScope.isEof) {
            throw copy ErrorMsg::fatal(b.loc,
                                        end-> inScope,
                                        format(ValidateErrorMessage::BREAK_SCOPE_GUARD));
        }

        // Break can have a value in 'loop' loops

        let mut val: &Value = UNIT_VALUE;
        if b.value !of EmptyExpr {
            val = ValueValidation::validate(alias context, b.value);
        }

        let loopType = context.getCurrentLoopType();

        // There may be multiple break in the loop, we need to verify that the type is compatible
        // It is a branching type(multiple branch with slightly different types)
        let (finLoopType, finLoopValue) = TypeInference::inferValueForBranch(alias context, b.loc, loopType, val);

        // We need to ensure that there is no mutability issue
        MemoryVerification::verifyMemoryOwner(b.loc, finLoopType, finLoopValue, byReference-> false);

        // Change the loop type for future break branches(and loop type)
        context:.setCurrentLoopType(finLoopType);

        return copy BreakValue(b.loc, finLoopValue);
    }

}
