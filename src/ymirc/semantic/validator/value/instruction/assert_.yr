in assert_;

use ymirc::syntax::expression::_;
use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::lexing::{word, tokens, keys};
use ymirc::errors;
use ymirc::global::core_;

use ymirc::utils::format;

/**
 * AssertValidation module
 *
 * Provides validation for `assert(test, msg)` expressions.
 *
 * Semantics:
 *   - The test expression must be boolean.
 *   - If the test is compile-time evaluable:
 *        - false => unconditional throw
 *        - true => useless assert(fatal)
 *
 *   - If the test is not compile-time evaluable:
 *        - the assert lowers to a conditional throw:
 *              if (!test) throw AssertError(msg);
 *
 *   - The message expression is optional; if omitted, an empty string
 *     is passed to the AssertError constructor.
 *
 */
pub mod AssertValidation {

    /**
     * Validate a runtime `assert` expression.
     *
     * @returns:
     *   - a BlockValue or ConditionalValue of type void
     *
     * @throws:
     *   - ErrorMsg if the test is not boolean, if the assert is useless,
     *     or if the message expression is invalid
     *
     */
    pub fn validate(dmut context: &ValidationContext, a: &AssertExpr)-> &Value
        throws ErrorMsg
    {
        let test = ValueValidation::validate(alias context, a.test);
        TypeVerification::verifyCompatible(a.loc, a.test.loc, test.type, BOOL_TYPE);

        let (isFalse, canCte) = { // if the test is false at compile time, we can assume its a return loc
            (!context.cteInterpret:.computeBool(test), true)
        } catch {
            _ => {
                (false, false) // not cte
            }
        };

        if canCte && !isFalse {
            throw copy ErrorMsg::fatal(a.loc, end-> test.loc, format(ValidateErrorMessage::USELESS_RUNTIME_ASSERT));
        }

        // if the expression has a message, it is passed to the abort function
        let message = match a.msg {
            EmptyExpr() => { copy StringValue(a.loc, "") }
            expr: _ => {
                ValueValidation::validate(alias context, expr)
            }
        };

        TypeVerification::verifyCompatible(message.loc, EOF_WORD, message.type, UTF8_TYPE);

        let assertType = TypeCreation::createExceptionFromName(alias context, ExceptionUtils::ASSERT_ERR);
        let assertInstanceCtor = ValueCreation::createObjectInstance(alias context, a.loc, assertType, copy [message]);
        let throwVal = copy ThrowValue(a.loc, assertInstanceCtor);

        if (isFalse) { // the test is always false, then it is a returner
            // assert(false, msg); is authorized, it's the same as throw copy AssertError(msg);
            return copy BlockValue(a.loc, VOID_TYPE, copy [throwVal], returnLoc-> a.loc, breakLoc-> EOF_WORD, isSet-> true);
        }

        // if !test { throw copy AssertError(msg); }
        let reverseTest = copy UnaryOperatorValue(a.loc, UnaryOperators::NOT, type-> BOOL_TYPE, value-> test);
        return copy ConditionalValue(a.loc,
                                      VOID_TYPE,
                                      test-> reverseTest,
                                      thenv-> throwVal,
                                      elsev-> UNIT_VALUE,
                                      isComplete-> false,
                                      isReduced-> true);
    }

    /**
     * Validate a compile-time `assert` expression.
     *
     * @returns:
     *   - UNIT_VALUE on success
     *
     * @throws:
     *   - ErrorMsg if the assertion fails at compile time
     */
    pub fn validateCte(dmut context: &ValidationContext, a: &AssertExpr)-> &Value
        throws ErrorMsg
    {
        let test = ValueValidation::validate(alias context, a.test);
        let value = context.cteInterpret:.computeBool(test);

        if (!value) {
            if a.msg of EmptyExpr {
                throw copy ErrorMsg::fatal(a.loc, ValidateErrorMessage::CTE_ASSERT_NO_MSG);
            }

            let m = ValueValidation::validate(alias context, a.msg);
            let r = context.cteInterpret:.reduce(m);
            throw copy ErrorMsg::fatal(a.loc, format(ValidateErrorMessage::CTE_ASSERT_WITH_MSG, r));
        }

        UNIT_VALUE
    }

}
