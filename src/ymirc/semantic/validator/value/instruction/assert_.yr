in assert_;

use ymirc::lexing::word;

use ymirc::syntax::expression::instruction;
use ymirc::semantic::validator;
use ymirc::semantic::generator::value;

use ymirc::errors::message;

pub mod AssertValidation {

    pub fn validate (dmut context: &ValidationContext, la: &AssertExpr)-> &Value
        throws ErrorMsg
    {        
        context;
        la;
        panic;
    }

    pub fn validateCte (dmut context: &ValidationContext, loc: &Word, a: &AssertExpr)-> &Value
        throws ErrorMsg
    {
        context;
        a;
        panic;
    }

}
