/*
 * Implements validation for variable declarations in Ymir.
 *
 * A variable declaration may specify:
 *   - a name
 *   - an optional type
 *   - an initializer
 *   - optional modifiers(lazy, ref, mut, dmut)
 *   - optional quoting(affects shadowing rules)
 *
 * The declaration is validated according to the following rules:
 *
 *   - The declaration is rewritten into a pattern declaration and
 *     validated by PatternVarDeclValidation.
 *
 *   - Shadowing is prohibited unless the identifier is quoted.
 *
 *   - Type validation errors produce an ErrorType but the variable is
 *     still inserted into the local scope to avoid cascading failures.
 *
 * Responsibilities:
 *   - validate type/initializer consistency
 *   - enforce shadowing rules(with quoted-identifier exceptions)
 *   - validate declared types
 *   - construct VarDeclValue
 *   - insert the variable into the local scope
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::value::instruction::vardecl
 * @File: ymirc/semantic/validator/value/instruction/vardecl.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-03-27
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in vardecl;

use ymirc::errors;
use ymirc::semantic::generator::value::_;
use ymirc::syntax::expression::_;

use std::io;

/**
 * VarDeclValidation module
 *
 * Provides validation for variable declarations.
 *
 * Semantics:
 *   - A declaration is rewritten into a pattern declaration and validated
 *     through PatternVarDeclValidation.
 *
 *   - Type validation failures produce ErrorType but still create a
 *     VarDeclValue so that the variable exists in scope.
 */
pub mod VarDeclValidation {

    /**
     * Validate a variable declaration.
     *
     * @returns:
     *   - VarDeclValue
     *
     * @throws:
     *   - ErrorMsg for invalid declarations
     */
    pub fn validate(dmut context: &ValidationContext, v: &VarDeclExpr)-> &Value
        throws ErrorMsg
    {
        let rewrite = copy VarDeclExpr(v.loc,
                                       v.name,
                                       value-> EMPTY_EXPR,
                                       type-> v.type,
                                       isLazyOrRef-> v.isLazyOrRef,
                                       isMutOrDmut-> v.isMutOrDmut);

        let fin = PatternVarDeclValidation::validate(alias context,
                                                     copy PatternVarDeclExpr(v.loc, rewrite, v.value));

        if let z: &VarDeclValue = fin {
            return z;
        }

        eprintln("internal var declaration error: ", fin.__typeinfo.name);
        panic;
    }

}
