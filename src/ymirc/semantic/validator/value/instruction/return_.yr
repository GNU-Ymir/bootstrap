 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in return_;

use ymirc::syntax::expression::_;
use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::_, type::_};
use ymirc::errors::message;

use ymirc::utils::format;


/**
 * ReturnValidation module
 *
 * Provides validation for `return` expressions.
 *
 * Semantics:
 *   - A `return` must appear inside a function or lambda body.
 *   - A `return` cannot cross a scope guard; doing so is illegal.
 *
 *   - The return type of a normal function is fixed at function entry.
 *
 *   - The return type of a lambda is inferred incrementally:
 *        - each return contributes to the lambda’s return type
 *        - inferValueForBranch merges the new return value with the
 *          current inferred type
 *
 *   - If the returned value is a lambda, its prototype may be inferred
 *     from the function’s declared return type.
 *
 *   - The returned value must be compatible with the declared return type and
 *     must satisfy ownership rules.
 *
 *   - A return expression itself always has type `void`.
 *
 */
pub mod ReturnValidation {

    /**
     * Validate a `return` expression.
     *
     * @returns:
     *   - ReturnValue(always typed as void)
     *
     * @throws:
     *   - ErrorMsg if the return is outside a function, crosses a scope
     *     guard, or the returned value is incompatible with the function’s
     *     return type
     */
    pub fn validate(dmut context: &ValidationContext, r: &ReturnExpr)-> &Value
        throws ErrorMsg
    {
        if (!context.isInFunctionBody()) {
            throw copy ErrorMsg::fatal(r.loc, ValidateErrorMessage::RETURN_NO_FUNCTION);
        }

        let inScope = context.getInScopeGuard();
        if (!inScope.isEof) {
            throw copy ErrorMsg::fatal(r.loc,
                                        end-> inScope,
                                        format(ValidateErrorMessage::RETURN_SCOPE_GUARD));
        }

        // The function type is set once at the beginning of a function validation, or by return statement in case of lambda validation
        let fnType = context.getFunctionReturn();

        let mut val: &Value = UNIT_VALUE;
        if r.value !of EmptyExpr {
            val = ValueValidation::validate(alias context, r.value);
            if val.type of LambdaType {
                // We have the possibility here - thanks to the return type of
                // the function - to know the types of the prototype of a lambda
                // function
                //
                if (fnType of FuncPtrType || fnType of DelegateType) {
                    val = TypeInference::inferLambdaValue(alias context, fnType, val);
                }
            }
        }


        if (context.isInLambdaBody()) { // The type can be changed by the return statement
            let (finFnType, fin) = TypeInference::inferValueForBranch(alias context, val.loc, fnType, val);
            context:.setFunctionReturn(finFnType);
            val = fin;
        } else {
            // Verify that the mutability of the returned values is respected
            val = TypeInference::inferValueForType(alias context, fnType.loc, val, type-> fnType, byReference-> false);
            MemoryVerification::verifyMemoryOwner(fnType.loc, fnType, val, construct-> true, byReference-> false);
        }

        // Returns are not really values(you cannot write 'a = return 12;'), they are always typed 'void'
        return copy ReturnValue(r.loc, val);
    }

}
