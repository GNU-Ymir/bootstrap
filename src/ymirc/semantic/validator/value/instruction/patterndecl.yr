/*
 * Implements validation for pattern-based variable declarations in Ymir.
 *
 * A pattern declaration has the form:
 *
 *     let pattern = value
 *
 * where `pattern` may bind multiple variables. The declaration is validated by
 * performing a structural match between the value and the pattern. This
 * produces:
 *
 *   - a list of declared variables
 *   - a test expression indicating whether the match succeeded
 *   - an optional error describing why the match is invalid
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::value::instruction::patterndecl
 * @File: ymirc/semantic/validator/value/instruction/patterndecl.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-03-27
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in patterndecl;

use ymirc::syntax::expression::_;
use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::utils::format;
use ymirc::errors::message;

/**
 * PatternVarDeclValidation module
 *
 * Provides validation for pattern-based variable declarations.
 *
 * Semantics:
 *   - The pattern is matched against the initializer value.
 *   - MatchValidation returns:
 *        - vars: list of (name, VarDeclValue)
 *        - test: boolean expression representing match success
 *        - error: optional error describing invalid patterns
 *
 *   - All declared variables are inserted into the local scope immediately,
 *     even if the pattern is invalid, to improve downstream diagnostics.
 *
 *   - If the matcher reports an error, it is thrown after variable
 *     insertion.
 *
 *   - The pattern must be irrefutable. If the match test is not
 *     statically known to be true, the declaration is rejected.
 *
 *   - The result of the declaration is:
 *        - the single VarDeclValue if exactly one variable is bound
 *        - a BlockValue containing all declared variables otherwise
 *
 */
pub mod PatternVarDeclValidation {

    /**
     * Validate a pattern-based variable declaration.
     *
     * @returns:
     *   - VarDeclValue or BlockValue
     *
     * @throws:
     *   - ErrorMsg if the pattern is invalid or refutable
     */
    pub fn validate(dmut context: &ValidationContext, p: &PatternVarDeclExpr)-> &Value
        throws ErrorMsg
    {
        let mut blk: [&Value] = [];
        let result = MatchValidation::validatePattern(alias context, p.value, p.pattern, canBeLazy-> true);
        for v in result.vars { // insert the declared variables
            context:.insertLocal(v.value.loc, v.name, v.value);
            blk ~= [v.value];
        }

        // error during the pattern matching, we throw it after inserting error
        // variables to have better error printing for next statements using
        // these variables
        //
        if let Ok(err) = result.error {
            throw err;
        }

        // the test has to be irrefutable to be usable outside a conditional
        let reducedCond = context.cteInterpret:.reduce(result.test);

        let refutable = match reducedCond {
            b: &BoolValue => { !b.isTrue }
            _ => { true }
        };

        // needs an if let construct instead
        if refutable {
            throw copy ErrorMsg::fatal(p.loc, format(ValidateErrorMessage::PATTERN_IS_REFUTABLE, p.pattern, result.value));
        }

        if (blk.len == 1us) {
            return blk[0];
        }

        return copy BlockValue(p.loc,
                                copy VoidType(p.loc),
                                blk,
                                isSet-> true);
    }

}
