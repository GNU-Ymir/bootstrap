in version_;

use ymirc::syntax::expression::_;
use ymirc::errors;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::lexing::keys;
use ymirc::global::state;


pub mod VersionLiteralValidation {

    /**
     * Validate a version literal expression.
     *
     * @params:
     *   - v: VersionExpr representing the version literal
     *
     * @returns:
     *   - &Value: BoolValue indicating whether the version is active
     *
     * @throws:
     *   - nothing(version literals never produce semantic errors)
     */
    pub fn validate(v: &VersionExpr)-> &Value {
        return copy BoolValue(v.loc, state::isVersionActive(v.version.str));
    }
}
