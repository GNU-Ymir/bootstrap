in root;

use ymirc::syntax::{_, declaration::_, expression::_};

use ymirc::semantic::{declarator, validator, template_, symbol};
use ymirc::semantic::generator::{value::_, type::_};
use ymirc::semantic::generator::_;

use ymirc::global::core_;
use ymirc::errors::_;
use ymirc::utils::format;

use ymirc::lexing::{word, tokens, keys};


pub mod LiteralValidation {

    pub fn validate (dmut context: &ValidationContext, lit: &Expression)-> &Value
        throws ErrorMsg
    {
        match lit {
            b: &BoolExpr               => return LiteralValidation::validateBool (b);
            n: &NullExpr               => return LiteralValidation::validateNull (n);
            n: &NoneExpr               => return LiteralValidation::validateNone (n);                        
            u: &EmptyExpression        => return LiteralValidation::validateUnit (u);
            d: &DollarExpr             => return LiteralValidation::validateDollar (alias context, d);
                        
            f: &FixedExpr              => return IntLiteralValidation::validate (f);
            f: &FloatExpr              => return FloatLiteralValidation::validate (f);        
            c: &CharExpr               => return CharLiteralValidation::validate (c);
                                    
            s: &StringExpr             => return StringLiteralValidation::validate (alias context, s);             
            
            l: &ListExpr if l.isArray  => return ArrayLiteralValidation::validateList (alias context, l);
            l: &ListExpr if !l.isArray => return TupleLiteralValidation::validateList (alias context, l);
                                    
            m: &ListMapExpr            => return MapLiteralValidation::validateListMap (alias context, m);
            s: &SliceAllocatorExpr     => return ArrayLiteralValidation::validateSliceAllocator (alias context, s);

            v: &VarExpr                => return VariableValidation::validate (alias context, v);
            _ => {
                throw copy ErrorMsg::fatal (lit.loc, format (ValidateErrorMessage::USE_AS_VALUE));
            }
        }   
    }

    /**
     * @params: 
     *   - _: the context of the validation
     *   - b: the bool expression to validate
     * @returns: a bool value
     */
    fn validateBool (b: &BoolExpr)-> &Value {
        return copy BoolValue (b.loc, isTrue-> (b.loc == Keys::TRUE));
    }


    /**
     * @params:
     *   - _: the context of the validation
     *   - n: the null expr to validate
     * @returns: a null value
     */
    fn validateNull (n: &NullExpr)-> &Value {
        return copy NullValue (n.loc);
    }

    /**
     * @params:
     *    - _: the context of the validation
     *    - n: the none expression to validate
     * */
    fn validateNone (n: &NoneExpr)-> &Value {
        return copy ErrOptionValue (n.loc);
    }

    /**
     * @params: 
     *   - _: the context of the validation
     *   - u: the unit expression to validate
     * @returns: a unit value
     */
    fn validateUnit (u: &EmptyExpression)-> &Value {
        return copy UnitValue (loc-> u.loc);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          DOLLAR          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Validate a dollar expression
     * @params:
     *   - context: the context of the validation
     *   - d: the dollar expression
     * @returns: a value
     * @throws: &ErrorMsg if we are not in a dollar context
     */
    fn validateDollar (dmut context: &ValidationContext, d: &DollarExpr)-> &Value
        throws ErrorMsg
    {
        
        if let Ok (val: &Value) = context.getCurrentDollarContext () {
            return LiteralValidation::validateDollarValue (alias context, d.loc, val);
        }

        throw copy ErrorMsg::fatal (d.loc, ValidateErrorMessage::DOLLAR_OUTSIDE_CONTEXT);        
    }

    /**
     * Validate a dollar operator on a value
     * @params:
     *    - context: the context of the validation
     *    - loc: the location of the dollar operator
     *    - val: the value that is opDollar accessed
     * @returns: the result of opDollar on the value
     * @throws:
     *    - &ErrorMsg: if the value cannot be opDollared
     */
    fn validateDollarValue (dmut context: &ValidationContext, loc: &Word, val: &Value)-> &Value
        throws ErrorMsg
    {
        match val.type {
            s: &SliceType => {
                if s.size !of UnitValue {
                    return s.size;
                }
                
                return copy StructFieldAccessValue (loc, USIZE_TYPE, val, SliceKeys::LEN);
            }
            a: &ArrayType => {
                return copy IntValue (loc, USIZE_TYPE, a.len)
            }
            t: &TupleType => {
                return copy IntValue (loc, USIZE_TYPE, t.inners.len);
            }
            c: &ClassPtrType => {
                return LiteralValidation::validateOpDollarClass (alias context, loc, c, val);
            }
        }
        
        throw copy ErrorMsg::fatal (loc, format (ValidateErrorMessage::UNDEFINED_DOLLAR_OP, val.getType ()));        
    }

    /**
     * Validate the dollar operator on a class value
     * @params:
     *    - context: the context of the validation
     *    - loc: the location of the opDollar
     *    - cptr: the class type
     *    - val: the value being accessed
     * @returns: the call to the opDollar method
     * @throws:
     *    - &ErrorMsg: if the call is not valid
     * */
    pub fn validateOpDollarClass (dmut context: &ValidationContext, loc: &Word, cptr: &ClassPtrType, val: &Value)-> &Value
        throws ErrorMsg
    {
        {
            let acc = ValueCreation::createObjectMethodAcc (loc, cptr, val, OpOverrideNames::DOLLAR);
            return CallValidation::validate (alias context, loc, acc, []);
        } catch {
            err: &ErrorMsg => {
                throw copy ErrorMsg::fatal (loc, format (ValidateErrorMessage::UNDEFINED_DOLLAR_OP, cptr),
                                            notes-> copy [err]);
            }
        }
    }

    
}
