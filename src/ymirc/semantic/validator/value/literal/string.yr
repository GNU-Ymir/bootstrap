in string;

mod ::format;

use ymirc::errors;
use ymirc::global::common;
use ymirc::lexing::{keys, word};
use ymirc::semantic::generator::{type::_, value::_};
use ymirc::semantic::validator::{_, value::validate::_};
use ymirc::syntax::expression::_;
use ymirc::utils::format;


/**
 * StringLiteralValidation module
 *
 * Provides validation and construction of string literal values. Supports
 * UTF-8, UTF-16, and UTF-32 encodings via suffixes, and applies escape
 * processing before encoding. Produces a slice of immutable characters wrapped
 * in a StringValue.
 *
 * Formatted strings(`f"..."`) are desugared into a concatenation, see
 * `validateFormat` below.
 *
 */
pub mod StringLiteralValidation {

    /**
     * Validate a string literal and construct its semantic value.
     *
     * Steps:
     *   1. If the literal is a format string, desugar it and delegate to
     *      `validateFormat` instead(see below).
     *   2. Apply escape-sequence processing to the raw sequence.
     *   3. Encode the resulting Unicode string as UTF-8, UTF-16, or UTF-32
     *      depending on the suffix.
     *   4. Construct a SliceType with the appropriate character width and length.
     *   5. Wrap the encoded data in a StringValue.
     *
     * @params:
     *   - context: validation context(string format needs a value resolution context)
     *   - s:       the StringExpr representing the literal
     *
     * @returns:
     *   - a StringValue containing the encoded characters and slice type
     *
     * @throws:
     *   - ErrorMsg if escape processing fails
     */
    pub fn validate(dmut context: &ValidationContext, s: &StringExpr)-> &Value
        throws ErrorMsg
    {
        if s.isFormat {
            return StringLiteralValidation::validateFormat(alias context, s);
        }

        let str = Utf::escape(s.loc, s.seq);
        return StringLiteralValidation::validate(s.loc, str, s.suffix.str);
    }


    /**
     * Validate a string sequence into a string value
     *
     * @params:
     *   - context: validation context
     *   - loc: the location of the string value
     *   - str: the sequence to validate
     *   - encoding: the encoding of the result value
     *
     */
    pub fn validate(loc: &Word, str: [c8], encoding: [c8])-> &StringValue
        throws ErrorMsg
    {
        if encoding == StringSuffixes::UTF32 {
            let encoded = Utf::encodeUtf32(str);
            let inner = copy CharType(loc, size-> 32u16, isMutable-> false);
            let slcType = copy SliceType(loc,
                                         inner,
                                         isMutable-> true,
                                         withSize-> copy IntValue(loc, USIZE_TYPE, encoded.len));

            return copy StringValue(loc, slcType, encoded);
        }

        if encoding == StringSuffixes::UTF16 {
            let encoded = Utf::encodeUtf16(str);
            let inner = copy CharType(loc, size-> 16u16, isMutable-> false);
            let slcType = copy SliceType(loc, inner, isMutable-> true,
                                         withSize-> copy IntValue(loc, USIZE_TYPE, encoded.len));

            return copy StringValue(loc, slcType, encoded);
        }

        let encoded = Utf::encodeUtf8(str);
        let inner = copy CharType(loc, size-> 8u16, isMutable-> false);
        let slcType = copy SliceType(loc,
                                     inner,
                                     isMutable-> true,
                                     withSize-> copy IntValue(loc, USIZE_TYPE, encoded.len));

        return copy StringValue(loc, slcType, encoded);
    }

    /**
     * Validate a formatted string literal.
     *
     * Desugars `f"...${expr}..."` into a slice concatenation of its literal
     * parts and a `std::conv::to!{[cX]}(expr)` conversion of each interpolated
     * part(same char width `cX` as the format string's own suffix), then
     * reparses and validates that composite expression like ordinary source
     * code. This is what lets constant format strings fold into a single
     * string constant, for free, via the normal constant-folding machinery.
     *
     * @params:
     *   - context: validation context
     *   - s:       the StringExpr representing the formatted string
     *
     * @returns:
     *   - the validated value of the resulting concatenation
     *
     * @throws:
     *   - ErrorMsg if an interpolation is empty or unterminated, or if any of the
     *     interpolated expressions fail to parse or validate
     */
    fn validateFormat(dmut context: &ValidationContext, s: &StringExpr)-> &Value
        throws ErrorMsg
    {
        let slcType: &SliceType = if s.suffix.str == StringSuffixes::UTF32 {
            let inner = copy CharType(s.loc, size-> 32u16, isMutable-> false);
            copy SliceType(s.loc, inner, isMutable-> true)
        }
        else if s.suffix.str == StringSuffixes::UTF16 {
            let inner = copy CharType(s.loc, size-> 16u16, isMutable-> false);
            copy SliceType(s.loc, inner, isMutable-> true)
        }
        else {
            let inner = copy CharType(s.loc, size-> 8u16, isMutable-> false);
            copy SliceType(s.loc, inner, isMutable-> true)
        };

        let parts = format::FormatStringParts::split(alias context, s, slcType);
        if (parts.len == 0) { // `f""`, no literal part and no interpolation
            return StringLiteralValidation::validate(s.loc, "", s.suffix.str);
        }

        let mut finalValue = parts[0];
        let mut i = 1us;
        while i < parts.len {
            finalValue = BinaryConcatValidation::validate(alias context, s.loc, BinaryOperators::TILDE,
                                                          finalValue,
                                                          parts[i]);
            i += 1;
        }

        return finalValue;
    }
}
