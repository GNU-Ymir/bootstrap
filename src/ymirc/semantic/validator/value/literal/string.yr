 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in string;

use ymirc::syntax::expression::_;
use ymirc::errors;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::utils::format;
use ymirc::lexing::keys;

use ymirc::global::common; // version


/**
 * StringLiteralValidation module
 *
 * Provides validation and construction of string literal values. Supports
 * UTF-8, UTF-16, and UTF-32 encodings via suffixes, and applies escape
 * processing before encoding. Produces a slice of immutable characters wrapped
 * in a StringValue.
 *
 * Formatted strings(`f"..."`) are detected but currently rejected.
 *
 */
pub mod StringLiteralValidation {

    /**
     * Validate a string literal and construct its semantic value.
     *
     * Steps:
     *   1. Reject formatted strings(not yet supported).
     *   2. Apply escape-sequence processing to the raw sequence.
     *   3. Encode the resulting Unicode string as UTF-8, UTF-16, or UTF-32
     *      depending on the suffix.
     *   4. Construct a SliceType with the appropriate character width and length.
     *   5. Wrap the encoded data in a StringValue.
     *
     * @params:
     *   - context: validation context(string format needs a value resolution context)
     *   - s:       the StringExpr representing the literal
     *
     * @returns:
     *   - a StringValue containing the encoded characters and slice type
     *
     * @throws:
     *   - ErrorMsg if escape processing fails or formatted strings are used
     */
    pub fn validate(dmut context: &ValidationContext, s: &StringExpr)-> &Value
        throws ErrorMsg
    {
        if s.isFormat {
            return StringLiteralValidation::validateFormat(alias context, s);
        }

        let str = Utf::escape(s.loc, s.seq);

        if s.suffix.str == StringSuffixes::UTF32 {
            let encoded = Utf::encodeUtf32(str);
            let inner = copy CharType(s.loc, size-> 32u16, isMutable-> false);
            let slcType = copy SliceType(s.loc,
                                          inner,
                                          isMutable-> true,
                                          withSize-> copy IntValue(s.loc, USIZE_TYPE, encoded.len));

            return copy StringValue(s.loc, slcType, encoded);
        }

        if s.suffix.str == StringSuffixes::UTF16 {
            let encoded = Utf::encodeUtf16(str);
            let inner = copy CharType(s.loc, size-> 16u16, isMutable-> false);
            let slcType = copy SliceType(s.loc, inner, isMutable-> true,
                                          withSize-> copy IntValue(s.loc, USIZE_TYPE, encoded.len));

            return copy StringValue(s.loc, slcType, encoded);
        }

        let encoded = Utf::encodeUtf8(str);
        let inner = copy CharType(s.loc, size-> 8u16, isMutable-> false);
        let slcType = copy SliceType(s.loc,
                                      inner,
                                      isMutable-> true,
                                      withSize-> copy IntValue(s.loc, USIZE_TYPE, encoded.len));

        return copy StringValue(s.loc, slcType, encoded);
    }

    /**
     * Validate a formatted string literal.
     *
     * Formatted strings are recognized syntactically but not yet implemented.
     * This function always reports an error.
     *
     * @params:
     *   - context: validation context
     *   - s:       the StringExpr representing the formatted string
     *
     * @returns:
     *   - never returns; always throws
     *
     * @throws:
     *   - ErrorMsg indicating that formatted strings are not supported
     */
    fn validateFormat(dmut context: &ValidationContext, s: &StringExpr)-> &Value
        throws ErrorMsg
    {
        context;
        s;

        throw copy ErrorMsg::fatal(s.loc, format(ValidateErrorMessage::NOT_SUPPORTED_IN, __YMIR_VERSION__));
    }

}
