 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in int;

use ymirc::syntax::expression::_;
use ymirc::errors;
use ymirc::semantic::generator::{value::_, type::_};
use ymirc::semantic::interpret;

use ymirc::utils::{format, bigint};
use ymirc::lexing::keys;

use std::{conv, stream};


/**
 * IntLiteralValidation module
 *
 * Provides validation and construction of integer literal values. Supports
 * multiple bases(10, 16, 2, 8), optional underscores, and suffix-based type
 * selection. After parsing the literal into a BigInt/usize, the resulting value
 * is checked for overflow against the chosen integer type.
 *
 * All functions assume the literal has passed syntactic validation.
 */
pub mod IntLiteralValidation {

    /**
     * Validate an integer literal and construct its semantic value.
     *
     * Steps:
     *   1. Remove underscores from the literal.
     *   2. Detect the base from the prefix(0x, 0b, 0o, or decimal).
     *   3. Parse the magnitude into a usize.
     *   4. Select the integer type from the suffix(default: i32).
     *   5. Verify that the parsed value fits in the chosen type.
     *
     * @params:
     *   - f: the FixedExpr representing the integer literal
     *
     * @returns:
     *   - an IntValue containing the parsed integer and its IntType
     *
     * @throws:
     *   - &ErrorMsg if the literal is malformed or does not fit in the target type
     */
    pub fn validate(f: &FixedExpr)-> &Value
        throws ErrorMsg
    {
        let dmut stream = copy StringStream();
        IntLiteralValidation::removeUnders(f.int.str, alias stream, default-> "0"s8);

        let type = match f.suffix.str {
            FixedSuffixes::U8 => { copy IntType(f.loc, size-> 8u16, isSigned-> false, isMutable-> false) }
            FixedSuffixes::U16 => { copy IntType(f.loc, size-> 16u16, isSigned-> false, isMutable-> false) }
            FixedSuffixes::U32 => { copy IntType(f.loc, size-> 32u16, isSigned-> false, isMutable-> false) }
            FixedSuffixes::U64 => { copy IntType(f.loc, size-> 64u16, isSigned-> false, isMutable-> false) }
            FixedSuffixes::USIZE => { copy IntType(f.loc, size-> 0u16, isSigned-> false, isMutable-> false) }

            FixedSuffixes::I8 => { copy IntType(f.loc, size-> 8u16, isSigned-> true, isMutable-> false) }
            FixedSuffixes::I16 => { copy IntType(f.loc, size-> 16u16, isSigned-> true, isMutable-> false) }
            FixedSuffixes::I64 => { copy IntType(f.loc, size-> 64u16, isSigned-> true, isMutable-> false) }
            FixedSuffixes::ISIZE => { copy IntType(f.loc, size-> 0u16, isSigned-> true, isMutable-> false) }

            _ => {
                copy IntType(f.loc, size-> 32u16, isSigned-> true, isMutable-> false)
            }
        };

        let value: usize = {
            if (stream[].len > 2us && stream[][0us .. 2us] == "0x") {
                to!{usize, "x"} (stream[])
            } else if (stream[].len > 2us && stream[][0us .. 2us] == "0b") {
                to!{usize, "b"} (stream[])
            } else if (stream[].len > 2us && stream[][0us .. 2us] == "0o") {
                to!{usize, "o"} (stream[])
            } else {
                to!{usize} (stream[])
            }
        } catch {
            _ => {
                throw copy ErrorMsg::fatal(f.loc, format(ValidateErrorMessage::MALFORMED_INT_LITERAL, stream[]));
            }
        };

        // verify that there is no overflow in the value literal
        IntInterpret::verifyOverflow(f.loc, type, value);

        return copy IntValue(f.loc, type, value);
    }

    /**
     * Write characters from `str` into `stream`, skipping underscores.
     *
     * If all characters in `str` are underscores, writes `default` instead.
     * Used to normalize numeric components such as:
     *     1_000_000 → "1000000"
     *
     * @params:
     *   - str:     the input byte slice
     *   - stream:  the output StringStream to write into
     *   - default: the fallback string if no non-underscore characters were found
     *
     * @returns:
     *   - nothing; `stream` is modified in place
     */
    pub fn removeUnders(str: [c8], dmut stream: &StringStream, default: [c8] = ""s8) {
        let mut wrote = false;
        for i in str {
            if (i != '_'c8) {
                wrote = true;
                stream:.write(i);
            }
        }

        if (!wrote) stream:.write(default);
    }


}
