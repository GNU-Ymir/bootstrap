/*
 * Implements validation and construction of floating-point literal values. This
 * module handles:
 *
 *   - decimal float literals,
 *   - hexadecimal float literals,
 *   - exponent parsing,
 *   - suffix-based type selection (f32, f64, f80, real),
 *   - underscore removal inside numeric components.
 *
 * These routines convert syntactic float expressions into semantic BigFloat
 * values wrapped in FloatValue nodes.
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::semantic::validator::value::literal::float
 * @File: ymirc/semantic/validator/value/literal/float.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2026-03-25
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in float;

use ymirc::syntax::expression::_;
use ymirc::errors::_;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::semantic::validator::value::literal::int; // for remove under

use ymirc::utils::{format, bigfloat, bigint};
use ymirc::lexing::keys;

use std::{conv, stream};


/**
 * FloatLiteralValidation module
 *
 * Provides validation and construction of floating-point literal values.
 * Supports both decimal and hexadecimal formats, exponent notation, and
 * suffix-based type selection. Underscores inside numeric components are
 * ignored.
 *
 * All functions assume the literal has passed syntactic validation.
 */
pub mod FloatLiteralValidation {

    /**
     * Validate a decimal or hexadecimal floating-point literal.
     *
     * Dispatches to `validateFloatHex` if the literal uses the `0x...p...`
     * hexadecimal syntax; otherwise parses a decimal literal with optional
     * exponent and suffix.
     *
     * @params:
     *   - f: the FloatExpr representing the literal
     *
     * @returns:
     *   - a FloatValue containing the parsed BigFloat and the appropriate
     *     FloatType (f32, f64, f80, or real)
     *
     * @throws:
     *   - ErrorMsg if the literal is malformed (invalid exponent, invalid digits)
     */
    pub fn validate (f: &FloatExpr)-> &Value
        throws ErrorMsg
    {
        if (f.isHex) {
            return FloatLiteralValidation::validateFloatHex (f);
        }

        let dmut stream = copy StringStream ();
        IntLiteralValidation::removeUnders (f.int.str, alias stream, default-> "0"s8);
        stream:.write ('.'c8);
        IntLiteralValidation::removeUnders (f.dec.str, alias stream, default-> "0"s8);

        let exp: &BigFloat = if (!f.exp.isEof) {
            {
                let dmut expStr = copy StringStream ();
                IntLiteralValidation::removeUnders (f.exp.str, alias expStr, default-> "0"s8);
                
                let exp = to!{i64} (expStr[]);
                if (f.expSign) {
                    copy BigFloat (10.0) ^^ exp
                } else {
                    copy BigFloat (10.0) ^^ -exp
                }
            } catch {
                _ => {                        
                    throw copy ErrorMsg::fatal (f.loc, format (ValidateErrorMessage::MALFORMED_FLOAT_LITERAL, f));
                }
            }
        } else {
            copy BigFloat (1.0)
        };

        let val = copy BigFloat (stream[]);
        match f.suffix.str {
            FloatSuffixes::F32 => {
                return copy FloatValue (f.loc, copy FloatType (f.loc, size-> 32, isMutable-> false), val * exp);
            }
            FloatSuffixes::F80 => {
                return copy FloatValue (f.loc, copy FloatType (f.loc, size-> 80, isMutable-> false), val * exp);                                
            }
            FloatSuffixes::REAL => {
                return copy FloatValue (f.loc, copy FloatType (f.loc, size-> 0, isMutable-> false), val * exp);                                
            }
            _ => {
                return copy FloatValue (f.loc, copy FloatType (f.loc, size-> 64, isMutable-> false), val * exp);
            }
        }                        
    }

    /**
     * Validate a hexadecimal floating-point literal (`0xA.BCp±E`).
     *
     * Parses:
     *   - the integer part (base 16),
     *   - the fractional part (base 16, scaled by 16^-n),
     *   - the exponent (base 2, using `p` notation),
     *   - and applies the suffix to determine the resulting FloatType.
     *
     * @params:
     *   - f: the FloatExpr representing the literal
     *
     * @returns:
     *   - a FloatValue containing the parsed BigFloat and the appropriate
     *     FloatType
     *
     * @throws:
     *   - &ErrorMsg if any component is malformed or cannot be parsed
     */
    fn validateFloatHex (f: &FloatExpr)-> &Value
        throws ErrorMsg
    {
        let dmut intPart = copy StringStream ();
        let dmut decPart = copy StringStream ();
        let dmut expPart = copy StringStream ();

        IntLiteralValidation::removeUnders (f.int.str [2us .. $], alias intPart, default-> "0"s8); // remove 0x
        IntLiteralValidation::removeUnders (f.dec.str, alias decPart, default-> "0"s8);
        IntLiteralValidation::removeUnders (f.exp.str, alias expPart, default-> "0"s8);

        let intPartV = copy BigFloat (copy BigInt (to!{usize, 16} (intPart[])));
        let decV = copy BigFloat (copy BigInt (to!{usize, 16} (decPart[]))) * (copy BigFloat (16.0) ^^ -cast!i64 (decPart[].len));
        let expV = to!{i64} (expPart[]);

        let exp2 = if (f.expSign) {
            copy BigInt (2) ^^ expV
        } else {
            copy BigInt (2) ^^ -expV
        }

        let val = intPartV + decV;
        let exp = copy BigFloat (exp2);
        match f.suffix.str {
            FloatSuffixes::F32 => {
                return copy FloatValue (f.loc, copy FloatType (f.loc, size-> 32, isMutable-> false), val * exp);
            }
            FloatSuffixes::F80 => {
                return copy FloatValue (f.loc, copy FloatType (f.loc, size-> 80, isMutable-> false), val * exp);                                
            }
            FloatSuffixes::REAL => {
                return copy FloatValue (f.loc, copy FloatType (f.loc, size-> 0, isMutable-> false), val * exp);                                
            }
            _ => {
                return copy FloatValue (f.loc, copy FloatType (f.loc, size-> 64, isMutable-> false), val * exp);
            }
        }                
    } catch {
        _ => throw copy ErrorMsg::fatal (f.loc, format (ValidateErrorMessage::MALFORMED_FLOAT_LITERAL, f));
    }

}
