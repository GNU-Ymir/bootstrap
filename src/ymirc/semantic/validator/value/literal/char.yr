in char;

use ymirc::syntax::expression::_;
use ymirc::errors::_;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::utils::format;
use ymirc::lexing::keys;

/**
 * CharLiteralValidation module
 *
 * Provides validation and construction of character literal values. Supports
 * UTF-8, UTF-16, and UTF-32 encodings via suffixes, and applies escape
 * processing before encoding. Ensures that the literal encodes exactly one
 * character in the selected width.
 *
 */
pub mod CharLiteralValidation {

    /**
     * Validate a character literal and construct its semantic value.
     *
     * Steps:
     *   1. Apply escape-sequence processing to the raw sequence.
     *   2. Encode the resulting Unicode scalar as UTF-8, UTF-16, or UTF-32
     *      depending on the suffix.
     *   3. Verify that the encoded result contains exactly one code unit.
     *   4. Wrap the code unit in a CharValue with the appropriate CharType.
     *
     * @params:
     *   - c: the CharExpr representing the literal
     *
     * @returns:
     *   - a CharValue containing the encoded character and its CharType
     *
     * @throws:
     *   - ErrorMsg if the literal does not encode exactly one character
     *     in the selected encoding(e.g., surrogate pairs in UTF-16)
     */
    pub fn validate(c: &CharExpr)-> &Value
        throws ErrorMsg
    {
        let str = Utf::escape(c.loc, c.seq);

        if c.suffix.str == CharSuffixes::UTF32 {
            let encoded = Utf::encodeUtf32(str);
            let inner = copy CharType(c.loc, size-> 32u16, isMutable-> false);

            if (encoded.len != 1us) {
                throw copy ErrorMsg::fatal(c.loc, format(ValidateErrorMessage::MALFORMED_CHAR, inner, encoded.len));
            }

            return copy CharValue(c.loc, inner, encoded[0]);
        }

        if c.suffix.str == CharSuffixes::UTF16 {
            let encoded = Utf::encodeUtf16(str);
            let inner = copy CharType(c.loc, size-> 16u16, isMutable-> false);

            if (encoded.len != 1us) {
                throw copy ErrorMsg::fatal(c.loc, format(ValidateErrorMessage::MALFORMED_CHAR, inner, encoded.len));
            }

            return copy CharValue(c.loc, inner, encoded[0]);
        }

        let encoded = Utf::encodeUtf8(str);
        let inner = copy CharType(c.loc, size-> 8u16, isMutable-> false);

        if (encoded.len != 1us) {
            throw copy ErrorMsg::fatal(c.loc, format(ValidateErrorMessage::MALFORMED_CHAR, inner, encoded.len));
        }

        return copy CharValue(c.loc, inner, encoded[0]);
    }

}
