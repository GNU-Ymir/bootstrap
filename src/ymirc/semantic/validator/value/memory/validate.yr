/*
 * Root validator for all memory-related expressions in Ymir.
 *
 * Memory expressions include:
 *   - aliasing      (`alias x`, `x:.field`, `x:[i]`)
 *   - copying       (`copy x`, `dcopy x`)
 *   - expansion     (`expand x`)
 *   - moving        (`move x`)
 *   - referencing   (`ref x`)
 *
 * This module provides the central dispatch that selects the correct
 * validation subsystem based on the concrete MemoryExpr variant.
 *
 * Responsibilities:
 *   - route each memory expression to its dedicated validator
 *   - propagate contextual flags such as `canBeRef`
 *   - ensure that unsupported memory expressions trigger an internal error
 *
 * All memory-related semantic rules originate from this dispatcher.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::value::memory::validate
 * @File: ymirc/semantic/validator/value/memory/validate.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-03-28
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in validate;

use ymirc::syntax::expression::memory;
use ymirc::semantic::validator;
use ymirc::semantic::generator::value;

use ymirc::errors::message;
use std::io;

/**
 * MemoryValidation module
 *
 * Provides the top-level entry point for validating memory expressions.
 *
 * Memory expressions form a closed family of operations that manipulate
 * storage, references, ownership, and destructuring. This module does not
 * perform validation itself; instead, it delegates to the appropriate
 * subsystem:
 *
 *   - AliasValidation => aliasing and class/map aliasing
 *   - CopyValidation => shallow and deep copying
 *   - ExpandValidation => tuple/array/slice/class expansion
 *   - MoveValidation => move semantics for movable class pointers
 *   - RefValidation => reference creation
 *
 * The `canBeRef` flag is propagated only to RefValidation, ensuring that
 * reference creation is context-controlled.
 */
pub mod MemoryValidation {

    /**
     * Validate a memory expression.
     *
     * Dispatches based on the concrete MemoryExpr variant:
     *
     *   - AliasExpr => AliasValidation::validate
     *   - CopyExpr => CopyValidation::validate
     *   - ExpandExpr => ExpandValidation::validate
     *   - MoveExpr => MoveValidation::validate
     *   - RefExpr => RefValidation::validate(with `canBeRef`)
     *
     * If an unexpected MemoryExpr variant is encountered, an internal compiler
     * error is raised.
     *
     * @params:
     *   - context:   validation context
     *   - mem:       memory expression to validate
     *   - canBeRef:  whether reference creation is permitted in this context
     *
     * @returns:
     *   - the validated Value produced by the corresponding subsystem
     *
     * @throws:
     *   - ErrorMsg if the underlying validator reports an error
     *
     */
    pub fn validate(dmut context: &ValidationContext, mem: &MemoryExpr, canBeRef: bool)-> &Value
        throws ErrorMsg
    {
        match mem {
            a: &AliasExpr => return AliasValidation::validate(alias context, a, isClass-> false, isField-> false);
            c: &CopyExpr => return CopyValidation::validate(alias context, c);
            e: &ExpandExpr => return ExpandValidation::validate(alias context, e);
            m: &MoveExpr => return MoveValidation::validate(alias context, m);
            r: &RefExpr => return RefValidation::validate(alias context, r, canBeRef-> canBeRef);
        }

        eprintln("internal memory validation error; ", mem.__typeinfo.name);
        panic;
    }

}
