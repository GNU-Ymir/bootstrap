in verif;

use ymirc::semantic::validator;
use ymirc::errors::message;
use ymirc::semantic::generator::{value, type, value::_, type::_};

use ymirc::lexing::word;
use ymirc::utils::format;

pub mod MemoryVerification {


    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          VERIF          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Verify that the value can be place in a position where its direct value can be modified
     * @example:
     * ===========
     * a = 1; // for a
     * foo(ref a); // for a
     * a[0] = 9; // for a[0]
     * &a // for a
     * ===========
     * @params:
     *    - loc: the location of the movement
     *    - value: the value that could be modified
     *    - allowImmutable: true if we allow the variable to be immutable(for memory address for example, or implicit ref)
     * @throws:
     *    - ErrorMsg: if it is not allowed
     * */
    pub fn verifyLeftOperandMove(loc: &Word, value: &Value, allowImmutable: bool = false, forMove: bool = false, allowSelf: bool = false)
        throws ErrorMsg
    {
        if (value of FakeValue) return;
        if (allowSelf && VariableVerification::isSelf(value)) {
            if (!allowImmutable && !value.type.isMutable) { // only mutable element can be used as left operand
                throw copy ErrorMsg::fatal(end-> loc, value.loc, format(ValidateErrorMessage::IMMUTABLE_LVALUE, value.type));
            }

            return;
        }

        if (!value.isLvalue) { // only lvalue can be used as left operand, and not self
            throw copy ErrorMsg::fatal(end-> loc, value.loc, format(ValidateErrorMessage::NOT_A_LVALUE, value));
        }

        if (VariableVerification::isLazy(value)) {
            throw copy ErrorMsg::fatal(end-> loc, value.loc, format(ValidateErrorMessage::NOT_A_LVALUE_LAZY, value));
        }

        if (value of MapAccessValue) {
            throw copy ErrorMsg::fatal(end-> loc, value.loc, format(ValidateErrorMessage::NOT_A_LVALUE_MAP_ACCESS, value));
        }

        if !allowImmutable {
            if (VariableVerification::isSelf(value)) {
                throw copy ErrorMsg::fatal(end-> loc, value.loc, format(ValidateErrorMessage::NOT_A_LVALUE, value));
            }

            if (!forMove && VariableVerification::isParameter(value) && !VariableVerification::isReference(value)) {
                throw copy ErrorMsg::fatal(end-> loc, value.loc, format(ValidateErrorMessage::NOT_A_LVALUE_PARAM, value));
            }

            if (!forMove && VariableVerification::isIterator(value) && !VariableVerification::isReference(value)) {
                throw copy ErrorMsg::fatal(end-> loc, value.loc, format(ValidateErrorMessage::NOT_A_LVALUE_ITERATOR, value));
            }

            if let v: &ClosureFieldAccessValue = value && !v.isByRef  {
                throw copy ErrorMsg::fatal(end-> loc, value.loc, format(ValidateErrorMessage::NOT_A_LVALUE_CLOSURE, value));
            }

            if (!value.type.isMutable) { // only mutable element can be used as left operand
                throw copy ErrorMsg::fatal(end-> loc, value.loc, format(ValidateErrorMessage::IMMUTABLE_LVALUE, value.type));
            }
        }

    }

    /**
     * @warning: Function that must be called at any affectation or memory movement in the code
     *
     * Verify that the movement of memory is permitted(no implicit alias, no const disqualifier, etc.)
     * @params:
     *   - loc: the location of the affectation
     *   - type: the type of the operation, to which the value is casted
     *   - value: the value that is moved
     *   - construct: true iif this is the construction of a new variable(this is the only time lambda are allowed)
     *   - checkTypes: if false does not call verifyCompatibleTypeWithValue, (this should be disable only if this was done beforehand)
     *   - byReference: if true the left type is a reference
     *   - byLazy: for matcher only? force the inner lazy matching
     *   - byMove: for matcher only? force the inner move matching(upper matching already verified that move was used)
     * @throws:
     *   - ErrorMsg: if the operation is not permitted
     */
    pub fn verifyMemoryOwner(loc:         &Word,
                              valueLoc:    &Word = EOF_WORD,
                              type:        &Type,
                              value:       &Value,
                              construct:   bool = false,
                              byReference: bool,
                              byLazy:      bool = false,
                              byMove:      bool = false)
        throws ErrorMsg
    {
        let endLoc = if valueLoc.isEof { value.loc } else { valueLoc };

        // Verify that the type can be used(if it is incomplete it cannot)
        TypeVerification::verifyCompleteWithValue(loc, valueLoc-> endLoc, type, value, construct);

        // Verify that the movement is not made implicitely
        MemoryVerification::verifyImplicitAlias(loc, valueLoc-> endLoc, type, value, byReference-> byReference);

        // Verify that the movement does not create a lazy value, without being explicitely defined
        MemoryVerification::verifyImplicitLazy(loc, valueLoc-> endLoc, type, value, byLazy);

        if (!byReference && !byMove) {
            // Verify that the memory segment is not a owned segment, that must be explicitely moved
            MemoryVerification::verifyImplicitMove(loc, valueLoc-> endLoc, type, value);
        }


        if let l: &LambdaType = type { // lambda type cannot be changed, they are not really values
            if (!construct || value !of LambdaValue) {
                throw copy ErrorMsg::fatal(endLoc,
                                            format(ValidateErrorMessage::USE_AS_VALUE_TYPE, l),
                                            notes-> copy [copy ErrorMsg::note(loc, "")]);
            }

            MemoryVerification::verifyMutabilityLevel(loc, endLoc, type, value.type, byReference);
            return;
        }

        if (type of OptionType) {
            if value !of ErrOptionValue {
                MemoryVerification::verifyMutabilityLevel(loc, endLoc, type, value.type, byReference);
            }

            return;
        }

        // all the other types must be checked in a deeper analyses
        MemoryVerification::verifyMutabilityLevel(loc, endLoc, type, value.type, byReference);
    }

    /**
     * Verification that the the type does not need alias, and otherwise that the value is an aliaser
     * @warning: does not fully check the mutability etc., cf. verifyMutabilityLevel
     * @params:
     *  - loc: the location of the movement
     *  - value: the value that is moved
     * @throws:
     *  - &ErrorMsg: if there is something not allowed here
     */
    fn verifyImplicitAlias(loc: &Word, valueLoc: &Word = EOF_WORD, type: &Type, value: &Value, byReference: bool)
        throws ErrorMsg
    {
        let endLoc = if valueLoc.isEof { value.loc } else { valueLoc };

        // Value to a value that needs ref, but without explicitely writing it
        // e.g. { let z = 12; let ref x = z; }
        if byReference && value !of ReferencerValue {
            throw copy ErrorMsg::fatal(loc, end-> endLoc, format(ValidateErrorMessage::IMPLICIT_REFERENCE, value.type));
        }

        // Value to a value that needs mutable ref, but only simple ref was used
        // e.g. { let mut z = 12; let mut ref x = ref z; } // mref has to be used not ref
        else if (byReference) {
            if let r: &ReferencerValue = value {
                if (type.isMutable && !r.isMutable) {
                    throw copy ErrorMsg::fatal(loc, end-> endLoc, format(ValidateErrorMessage::IMPLICIT_MUT_REFERENCE, value.type));
                } else if (!type.isMutable && r.isMutable) {
                    throw copy ErrorMsg::fatal(loc, end-> endLoc, format(ValidateErrorMessage::IMPLICIT_CONST_REFERENCE, value.type));
                }
            } else panic;
        }

        // Reference to a value that does not need ref
        // e.g. { let z = 12; let x = ref z; }
        else if (!byReference && value of ReferencerValue) {
            throw copy ErrorMsg::fatal(loc, end-> endLoc, ValidateErrorMessage::UNECESSARY_REFERENCE);
        }

        // Alias of borrowable data, but without explicitely writing it
        // e.g. { let z = [1, 2, 3]; let dmut a = z; }
        else if (!byReference && type.needsExplicitAlias && MemoryVerification::needsExplicitAlias(value)) {
            throw copy ErrorMsg::fatal(loc, ValidateErrorMessage::DISCARD_CONST,
                                        notes-> copy [copy ErrorMsg::note(endLoc, format(ValidateErrorMessage::IMPLICIT_ALIAS, value.type))]);
        }

        // Alias but on non borrowable data, or on a const borrowable data, so when it is not needed
        // e.g. { let dmut z = copy [12]; let x = alias z; }
        else if let a: &AliaserValue = value {
            if (!type.needsExplicitAlias && !a.isFromExpansion) {
                throw copy ErrorMsg::fatal(loc, end-> endLoc, format(ValidateErrorMessage::UNECESSARY_ALIAS, type));
            }
        }
    }

    /**
     * Verify that a value is not lazy unecessarily or that it is not passed to lazy implicitely
     * @params:
     *    - loc: the location of the movement
     *    - type: the type of the left operand
     *    - value: the value that is moved
     *    - byLazy: true if left require a lazy value
     * @throws: if there is something prohibited
     * */
    fn verifyImplicitLazy(loc: &Word, valueLoc: &Word = EOF_WORD, _: &Type, value: &Value, byLazy: bool)
        throws ErrorMsg
    {
        let endLoc = if valueLoc.isEof { value.loc } else { valueLoc };

        // Value to a variable that needs lazy
        // e.g. { let lazy a = lazy foo(); }
        if (byLazy) {
            let ok = match value {
                a: &AliaserValue => { a.value of LazyValue }
                _: &LazyValue => { true }
                _ => { false }
            };

            if (!ok) {
                throw copy ErrorMsg::fatal(loc, end-> endLoc, format(ValidateErrorMessage::IMPLICIT_LAZY, value.type));
            }
        }

        // e.g. { let x = lazy foo(); }
        else {
            let ok = match value {
                _: &LazyValue => { false }
                a: &AliaserValue => { a.value !of LazyValue }
                _ => { true }
            };


            if (!ok) {
                throw copy ErrorMsg::fatal(loc, end-> endLoc, format(ValidateErrorMessage::UNECESSARY_LAZY));
            }
        }
    }

    /**
     * Verify that the value of v is moved if the type 'c' is movable
     * @params:
     *    - loc: the location of the movement
     *    - c: the type being verified
     *    - v: the value being moved(or not)
     * @throws: if 'move' was not explicitely written
     **/
    fn verifyImplicitMove(loc: &Word, valueLoc: &Word = EOF_WORD, c: &Type, v: &Value)
        throws ErrorMsg
    {
        if (!c.isMovable) return;
        let endLoc = if (valueLoc.isEof) { v.loc } else { valueLoc };

        match v {
            b: &BlockValue => { if !b.isSet return;} // already verified moved at the end of the block
            MoverValue() => { return; } // explicit move
            CtorCallValue() => { return; } // no need to move a construction value
            ScopeValue() => { return; } // same as blocks
            CallOperatorValue() => { return; } // Function return are moved in the function body
        };

        if let (ct: &TupleType, vt: &TupleValue) = (c, v) {
            {
                // assume that if we are here, type validation has been done, and arity are equals
                for vi in 0us .. vt.arity {
                    MemoryVerification::verifyImplicitMove(loc, ct.inners[vi], vt.values[vi]);
                }
            } catch {
                err: &ErrorMsg => {
                    throw copy ErrorMsg::fatal(loc,
                                                end-> endLoc,
                                                format(ValidateErrorMessage::IMPLICIT_MOVE, c),
                                                notes-> copy [err]);
                }
            }

            return;
        }

        if let (ca: &ArrayType, va: &ArrayValue) = (c, v) {
            {
                for vi in 0us .. va.values.len {
                    MemoryVerification::verifyImplicitMove(loc, ca.value, va.values[vi]);
                }
            } catch {
                err: &ErrorMsg => {
                    throw copy ErrorMsg::fatal(loc,
                                                end-> endLoc,
                                                format(ValidateErrorMessage::IMPLICIT_MOVE, c),
                                                notes-> copy [err]);
                }
            }

            return;
        }

        throw copy ErrorMsg::fatal(loc, end-> endLoc, format(ValidateErrorMessage::IMPLICIT_MOVE, c));
    }

    /**
     * Verify that the mutability level of lType is higher or equal than those of rType, otherwise memory movement creates a discard of const
     * @example:
     * ```
     * let mut a = [1, 2, 3];
     * let dmut b = alias a; // no implicit alias, but a cannot give mutable access to inner values
     * b[0] = 9;
     * println(a); // [9, 2, 3]; we did not respected the contract of a
     * ```
     * @params:
     *   - lLoc: the location of the left operand in the movement operation
     *   - rLoc: the location of the right operation in the movement operation
     *   - lType: the type on the left of the operation(type of `b` in the example)
     *   - rType: the type on the right of the operation(type of `a` in the example)
     *   - byReference: true iif the types are a reference
     * @throws:
     *  - &ErrorMsg: if the movement is not allowed
     */
    fn verifyMutabilityLevel(lLoc: &Word, rLoc: &Word, lType: &Type, rType: &Type, byReference: bool)
        throws ErrorMsg
    {
        if lType of LambdaType {
            if (lType.isMutable) {
                throw copy ErrorMsg::fatal(rLoc, ValidateErrorMessage::DISCARD_CONST);
            }

            return;
        }

        if (byReference && !rType.isMutable && lType.isMutable) {
            let note = copy ErrorMsg::note(rLoc, format(ValidateErrorMessage::DISCARD_CONST_LEVEL_TYPES, rType, lType));
            throw copy ErrorMsg::fatal(lLoc, ValidateErrorMessage::DISCARD_CONST, notes-> copy [note]);
        }

        if (byReference || lType.borrowsData) && !rType.mutabilityFit(lType, borrowed-> byReference) {
            let note = copy ErrorMsg::note(rLoc, format(ValidateErrorMessage::DISCARD_CONST_LEVEL_TYPES, rType, lType));

            throw copy ErrorMsg::fatal(lLoc, ValidateErrorMessage::DISCARD_CONST, notes-> copy [note]);
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          NEEDS          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: true if the type is movable and need an explicit move
     * */
    pub fn needsExplicitMove(v: &Value)-> bool {
        if (!v.type.isMovable) return false;

        match v {
            b: &BlockValue => { if !b.isSet return false; }
            MoverValue() => { return false; }
            CtorCallValue() => { return false; }
            ScopeValue() => { return false; }
            CallOperatorValue() => { return false; }
        };

        if let vt: &TupleValue = v {
            for vi in 0us .. vt.arity {
                if (MemoryVerification::needsExplicitMove(vt.values[vi])) {
                    return true;
                }
            }

            return false;
        }

        if let va: &ArrayValue = v {
            for vi in 0us .. va.values.len {
                if (MemoryVerification::needsExplicitMove(va.values[vi])) {
                    return true;
                }
            }

            return false;
        }

        return true;
    }

    /**
     * Check if the value can be used without explicit alias over it
     * @params:
     *  - type: the type that will receive the data
     *  - value: the value that is moved
     */
    pub fn needsExplicitAlias(value: &Value)-> bool {
        if (!value.type.needsExplicitAlias) return false; // no data are borrowed
        match value {
            AddressValue() => return false;
            AliaserValue() => return false;
            CopierValue() => return false;
            LiteralValue() => return false;
            DelegateValue() => return false;
            ScopeValue() => return false;
            CallOperatorValue() => return false;
            SliceConcatValue() => return false;
            SliceAppendValue() => return false;
            TryFinallyValue() => return false;
            TryCatchValue() => return false;

            b: &BlockValue => { if (!b.isSet) return false; }
            l: &LazyValue => { if (l.isByAlias) return false; }
            f: &FutureValue => { if (f.isByAlias) return false; }
            s: &SliceCtorValue => { if (s.isImplicitAlias) return false; }
        }

        // value.type.needsExplicitAlias
        return true;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          CHECKS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Check if the value can be used as a left operand in a memory movement
     *      * @example:
     * ===========
     * a = 1; // for a
     * foo(ref a); // for a
     * a[0] = 9; // for a[0]
     * &a // for a
     * ===========
     * @params:
     *    - loc: the location of the movement
     *    - value: the value that could be modified
     *    - allowImmutable: true if we allow the variable to be immutable(for memory address for example, or implicit ref)
     *    - allowSelf: true if we allow the variable to be self (for memory address for example, or implicit ref)
     * @returns: true iif it can
     */
    pub fn checkLeftOperandMove(value: &Value, allowImmutable: bool = false, forMove: bool = false, allowSelf: bool = false)-> bool {
        if (value of FakeValue) return true;
        if (allowSelf && VariableVerification::isSelf(value)) {
            if (!allowImmutable && !value.type.isMutable) return false;
            return true;
        }

        if (!value.isLvalue) { // only lvalue can be used as left operand, and not self
            return false;
        }

        if (VariableVerification::isLazy(value)) {
            return false;
        }

        if !allowImmutable {
            if (VariableVerification::isSelf(value)) {
                return false
            }

            if (!forMove && VariableVerification::isParameter(value) && !VariableVerification::isReference(value)) {
                return false;
            }

            if (!forMove && VariableVerification::isIterator(value) && !VariableVerification::isReference(value)) {
                return false;
            }

            if (value of ClosureFieldAccessValue) {
                return false;
            }

            if (!value.type.isMutable) { // only mutable element can be used as left operand
                return false;
            }
        }

        return true;
    }
}
