/*
 * Implements validation for move expressions in Ymir.
 *
 * Moving transfers ownership of a value and optionally resets the original
 * storage. Only movable class pointers(struct instances) support move
 * semantics. Non-movable types produce a NOT_MOVABLE diagnostic.
 *
 * Responsibilities:
 *   - validate the moved expression
 *   - ensure the underlying type is a movable class pointer
 *   - verify left-operand move constraints(mutability, borrow rules)
 *   - invoke the reset constructor on the original storage when required
 *   - produce a MoverValue representing the move operation
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::value::memory::move_
 * @File: ymirc/semantic/validator/value/memory/move_.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-03-30
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in move_;

use ymirc::syntax::expression::memory;
use ymirc::semantic::validator;
use ymirc::semantic::generator::{value, value::_, type::custom};

use ymirc::errors;
use ymirc::lexing::word;

use ymirc::utils::format;

/**
 * MoveValidation module
 *
 * Provides validation for move expressions(`move x`).
 *
 * Move semantics apply only to class pointers whose underlying class is
 * marked as movable(typically struct-like classes). A move operation:
 *
 *   - transfers ownership of the value
 *   - optionally resets the original storage via a reset constructor
 *   - produces a MoverValue containing both the moved value and the reset
 *
 * The module enforces:
 *   - only movable class pointers may be moved
 *   - left-operand move rules(mutability, borrowability)
 *   - correct invocation of reset constructors when required
 */
pub mod MoveValidation {

    /**
     * Validate a move expression(`move x`).
     *
     * Steps:
     *   1. Validate the moved expression.
     *   2. Ensure the resulting type is a movable ClassPtrType.
     *   3. Delegate to validateMoveStruct for struct-like class pointers.
     *
     * If the value is not movable, a NOT_MOVABLE diagnostic is emitted.
     *
     * @params:
     *   - context: validation context
     *   - mem:     move expression
     *
     * @returns:
     *   - a MoverValue representing the move operation
     *
     * @throws:
     *   - ErrorMsg if the value is not movable
     */
    pub fn validate(dmut context: &ValidationContext, mem: &MoveExpr)-> &Value
        throws ErrorMsg
    {
        let ret = ValueValidation::validate(alias context, mem.content);

        if let c: &ClassPtrType = ret.type && c.isMovable {
            return MoveValidation::validateMoveStruct(alias context, mem, c, ret);
        }

        throw copy ErrorMsg::fatal(mem.loc, format(ValidateErrorMessage::NOT_MOVABLE, ret.type));
    }

    /**
     * Validate a move operation on a movable class pointer.
     *
     * @params:
     *   - context: validation context
     *   - mem:     move expression
     *   - c:       class pointer type of the moved value
     *   - ret:     validated value being moved
     *
     * @returns:
     *   - a MoverValue representing the move and optional reset
     *
     * @throws:
     *   - ErrorMsg if move constraints are violated
     *
     */
    fn validateMoveStruct(dmut context: &ValidationContext, mem: &MoveExpr, c: &ClassPtrType, ret: &Value)-> &Value
        throws ErrorMsg
    {
        let reset = if (MemoryVerification::needsExplicitMove(ret)) {
            // only mutable values that can be used as reference can be movable
            MemoryVerification::verifyLeftOperandMove(mem.loc, ret, forMove-> true);

            let instance = copy ReferencerValue(ret.loc, ret.type, ret);

            // Call the reset ctor on the moved instance
            let ctors = ClassStaticFieldValidation::validateCtors(alias context,
                                                                  mem.loc,
                                                                  c.inner,
                                                                  name-> "",
                                                                  selfParam-> instance);

            CallValidation::validate(alias context, mem.loc, ctors, [])
        } else {
            UNIT_VALUE
        };

        return copy MoverValue(mem.loc, ret.type, ret, reset-> reset);
    }

}
