/*
 * Implements validation for reference expressions in Ymir.
 *
 * The reference operator(`ref x`) produces a mutable reference to an existing
 * storage location. It is only valid when:
 *
 *   - the referenced value is a valid left operand for move/borrow rules
 *   - the surrounding context explicitly allows reference creation
 *
 * If the context does not permit reference creation, an UNECESSARY_REFERENCE
 * diagnostic is emitted.
 *
 * The validator ensures that the referenced value is a proper l-value and
 * constructs a ReferencerValue representing the reference.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::value::memory::ref_
 * @File: ymirc/semantic/validator/value/memory/ref_.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-03-30
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in ref_;

use ymirc::syntax::expression::memory;
use ymirc::semantic::validator;
use ymirc::semantic::generator::{value, value::_, type::_};

use ymirc::errors::message;
use ymirc::lexing::{word, keys};

use ymirc::utils::format;

/**
 * RefValidation module
 *
 * Provides validation for reference expressions(`ref x`).
 *
 * Reference semantics:
 *   - A reference is only allowed when the caller explicitly permits it
 *     (via the `canBeRef` flag).
 *   - The referenced value must satisfy left-operand move/borrow rules.
 *   - The resulting reference is always mutable.
 *
 * The module enforces:
 *   - correct l-value semantics for the referenced expression
 *   - correct contextual usage of the reference operator
 *   - construction of a ReferencerValue wrapping the target value
 */
pub mod RefValidation {

    /**
     * Validate a reference expression(`ref x`).
     *
     * @params:
     *   - context:  validation context
     *   - mem:      reference expression
     *   - canBeRef: whether the caller permits reference creation
     *
     * @returns:
     *   - a ReferencerValue wrapping the referenced value
     *
     * @throws:
     *   - ErrorMsg if reference creation is not permitted or the value is not
     *     a valid left operand
     *
     */
    pub fn validate(dmut context: &ValidationContext, mem: &RefExpr, canBeRef: bool)-> &Value
        throws ErrorMsg
    {
        let ret = ValueValidation::validate(alias context, mem.content);
        MemoryVerification::verifyLeftOperandMove(mem.loc, ret, allowSelf-> true);

        if (!canBeRef) {
            throw copy ErrorMsg::fatal(mem.loc,
                                        end-> ret.loc,
                                        format(ValidateErrorMessage::UNECESSARY_REFERENCE));
        }

        return copy ReferencerValue(mem.loc, ret.type, ret, isMutable-> true);
    }

}
