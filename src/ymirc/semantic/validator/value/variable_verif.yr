in variable_verif;

use ymirc::semantic::generator::value::variable;


/**
 * The VariableVerification module provides helper predicates used during
 * semantic validation to classify variable‑reference values. These checks are
 * used throughout the validator to enforce rules on `self`, parameters,
 * iterators, references, and lazy values.
 *
 * Each function performs a lightweight pattern match on a Value and returns
 * whether it corresponds to a specific kind of VarRefValue or
 * GlobalVarRefValue.
 * 
 */
pub mod VariableVerification {
    
    /**
     * Determines whether a value refers to the implicit `self` variable.
     *
     * @params:
     *    - value:  The value to inspect.
     * @returns: true iff the value is a VarRefValue referring to `self`.
     */
    pub fn isSelf (value: &Value)-> bool {
        match value {
            v: &VarRefValue => { v.isSelf }
            _ => { false }
        }
    }
    
    /**
     * Determines whether a value refers to a function parameter.
     *
     * @params:
     *    - value: The value to inspect.
     * @returns: true iff the value is a VarRefValue referring to a parameter.
     */
    pub fn isParameter (value: &Value)-> bool {
        match value {
            v: &VarRefValue => { v.isParam }
            _ => { false }
        }
    }
    
    /**
     * Determines whether a value refers to an iterator variable.
     *
     * @params:
     *    - value: The value to inspect.
     * @returns: true iff the value is a VarRefValue referring to an iterator.
     */
    pub fn isIterator (value: &Value)-> bool {
        match value {
            v: &VarRefValue => { v.isIterator }
            _ => { false }
        }
    }
    
    /**
     * Determines whether a value refers to a variable passed by reference.
     *
     * @params:
     *    - value: The value to inspect.
     * @returns: true iff the value is a VarRefValue referring to a ref parameter.
     */
    pub fn isReference (value: &Value)-> bool {
        match value {
            v: &VarRefValue => { v.isReference }
            _ => { false }
        }
    }

    /**
     * Determines whether a value refers to a lazy variable.
     *
     * Lazy variables may appear as:
     *   - VarRefValue (local lazy variables),
     *   - GlobalVarRefValue (lazy global variables).
     *
     * @params:
     *    - value: The value to inspect.
     * @returns: true iff the value refers to a lazy variable.
     */
    pub fn isLazy (value: &Value)-> bool {
        match value {
            v: &VarRefValue => { v.isLazy }
            gv: &GlobalVarRefValue => { gv.isLazy }
            _ => { false }
        }
    }
    
}
