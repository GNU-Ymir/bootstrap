in index;

use ymirc::syntax::expression::operator;
use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::errors::message;
use ymirc::lexing::word;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub mod ::array;
pub mod ::map;
pub mod ::class_;

mod ::slice;
mod ::pointer;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          ROOT          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub mod IndexValidation {

    pub fn validate (dmut context: &ValidationContext, mult: &MultOperatorExpr)-> &Value
        throws ErrorMsg
    {
        let mut left = ValueValidation::validate (alias context, mult.left);
        if (mult.isAlias) {
            left = AliasValidation::validate (alias context, mult.loc, left,
                                              isClass-> true,
                                              isField-> false);               
        } else {
            left = ValueCreation::createEnumUnwrap (left);
        }

        return IndexValidation::validate (alias context, mult.loc, left, mult.rights,
                                          inCopy-> context.isInCopy (mult));
    }    
    
    pub fn validate (dmut context: &ValidationContext,
                     loc:          &Word,
                     object:       &Value,
                     index:        &Value)-> &Value
        throws ErrorMsg
    {
        
        panic;
    }
    
    pub fn validate (dmut context: &ValidationContext,
                     loc:          &Word,
                     object:       &Value,
                     indices:      [&Expression],
                     inCopy:       bool)-> &Value
        throws ErrorMsg
    {

        let byAlias = match left {
            a: &ClassAliaserValue => {
                context:.enterDollar (a.value);
                true
            }
            v: _ => {
                context:.enterDollar (v);
                false
            }
        };

        let (ret, useAlias) = {
            let (rights, rTypes) = IndexValidation::validateRights (alias context, indices);
            match left.type {
                ArrayType () => {
                    (self.validateArray (alias context, loc, left, rights, rTypes, inCopy), false)
                }
                SliceType () => {
                    (self.validateSlice (alias context, loc, left, rights, rTypes), false)
                }
                PointerType () => {
                    (self.validatePointer (alias context, loc, left, rights, rTypes), false)
                }
                MapType () => {
                    (self.validateMap (alias context, loc, left, rights, rTypes), false)
                }
                c: &ClassPtrType => {
                    (self.validateClassIndex (alias context, loc, c, left, rights), true)
                }
                _ => {
                    throw copy ErrorMsg::fatal (loc, format (ValidateErrorMessage::UNDEFINED_INDEX_OP, left.getType (), rTypes));
                }
            }
        } exit {
            context:.exitDollar ();
        };

        if (byAlias && !useAlias) {
            throw copy ErrorMsg::fatal (left.getLoc (), format (ValidateErrorMessage::UNECESSARY_ALIAS, left.getType ()));
        }

        return ret                
    }
    
    fn validateRights (dmut context: &ValidationContext, indices: [&Expression])-> ([&Value], [&Type])
        throws ErrorMsg
    {
        let mut errors: [&ErrorMsg] = [];
        let mut rights: [&Value] = [];
        let mut types: [&Type] = [];
        
        for r in indices {
            {
                let v = ValueValidation::validate (alias context, r);
                match v {
                    e: &ExpandValue => {
                        for i_v in e.inners {
                            rights ~= [i_v];
                            types ~= [i_v.type];
                        }
                    }
                    _ => {
                        rights ~= [v];
                        types ~= [v.type];
                    }
                }            
            } catch {
                err => {
                    errors ~= [err];
                }
            }
        }

        if (errors.len != 0us) {
            throw copy ErrorMsg::list (errors);
        }

        return (rights, types);
    }


}

