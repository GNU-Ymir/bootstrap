 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in slice;

use ymirc::errors;
use ymirc::lexing::{keys, word};
use ymirc::semantic::interpret;
use ymirc::semantic::generator::{type::_, value::_};
use ymirc::utils::{bigint, format};


/**
 * SliceIndexValidation
 *
 * Provides semantic validation for indexing operations on slices:
 *
 *      slice[i]
 *      slice[a .. b]
 *
 *
 */
pub mod SliceIndexValidation {

    /**
     * Validate an indexing operation on a slice.
     *
     * @params:
     *   - context:      validation context
     *   - loc:          location of the index operator
     *   - slice:        the slice value being indexed
     *   - sliceType:    the static type of the slice
     *   - indices:      list of index expressions
     *   - indicesTypes: list of index types
     *
     * @returns:
     *   A &Value representing the result of the indexing operation.
     *
     * @throws:
     *   ErrorMsg if the index type is invalid or unsupported.
     */
    pub fn validate(dmut context: &ValidationContext,
                     loc:          &Word,
                     slice:        &Value,
                     sliceType:    &SliceType,
                     indices:      [&Value],
                     indicesTypes: [&Type])-> &Value
        throws ErrorMsg
    {
        if indicesTypes.len == 1 {
            if let i: &IntType = indicesTypes[0] {
                return SliceIndexValidation::validateInt(alias context, loc, slice, sliceType, indices[0], i);
            }

            if let r: &RangeType = indicesTypes[0] {
                return SliceIndexValidation::validateRange(alias context, loc, slice, sliceType, indices[0], r);
            }
        }

        throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::UNDEFINED_INDEX_OP, sliceType, indicesTypes));
    }

    /**
     * Validate integer indexing on a slice.
     *
     * @params:
     *   - context:    validation context
     *   - loc:        index operator location
     *   - slice:      slice value
     *   - sliceType:  slice type
     *   - indexValue: index expression
     *   - indexType:  integer type of the index
     *
     * @returns:
     *   A &Value representing the slice access.
     *
     * @throws:
     *   ErrorMsg if bounds are violated.
     */
    fn validateInt(dmut context: &ValidationContext,
                    loc:          &Word,
                    slice:        &Value,
                    sliceType:    &SliceType,
                    indexValue:   &Value,
                    indexType:    &IntType)-> &Value
        throws ErrorMsg
    {
        let innerType = sliceType.value;
        let len = context.cteInterpret:.reduceSliceLen(slice);
        let cteTest = ValueVerification::verifyIndexOverflow(alias context, loc, sliceType, indexValue, indexType,
                                                              maxLen-> len,
                                                              equalMax-> false);


        let index = CastValidation::validateExplicit(alias context, indexValue.loc, indexValue, USIZE_TYPE);
        let sliceAccess = copy SliceAccessValue(loc, innerType, slice, index);

        if (!context.getUnsafeContextLoc().isEof) {
            ValueVerification::verifyUnsafeContext(alias context, loc);
            return sliceAccess;
        }

        if cteTest {
            return sliceAccess;
        }

        let cmp = copy CmpIntOperatorValue(loc, BinaryOperators::INF_EQUAL, len, index);
        let cond = ValueCreation::createOutOfArrayTest(loc, cmp);
        return copy BlockValue(loc, innerType, copy [cond, sliceAccess], isSet-> true);
    }

    /**
     * Validate range indexing on a slice, producing a sub-slice.
     *
     * @params:
     *   - context:    validation context
     *   - loc:        index operator location
     *   - slice:      slice value
     *   - sliceType:  slice type
     *   - indexValue: range expression
     *   - indexType:  range type
     *
     * @returns:
     *   A &Value representing the resulting sub-slice.
     *
     * @throws:
     *   ErrorMsg if bounds are violated or the range is invalid.
     */
    pub fn validateRange(dmut context: &ValidationContext,
                          loc:          &Word,
                          slice:        &Value,
                          sliceType:    &SliceType,
                          indexValue:   &Value,
                          indexType:    &RangeType)-> &Value
        throws ErrorMsg
    {
        let startType = indexType.start;
        let innerType = sliceType.value;
        let ptrType = copy PointerType(loc, innerType, isMutable-> innerType.isMutable); // the pointer type of the slice value[ptr ; len]

        let (sliceLen, arrayAddr, blkInfo) = if let ctor: &SliceCtorValue = slice {
            (context.cteInterpret:.reduce(ctor.len), ctor.ptr, ctor.blk)
        } else {
            let sliceLen = context.cteInterpret:.reduceSliceLen(slice);
            let arrayAddr = copy StructFieldAccessValue(loc, ptrType, slice, SliceKeys::PTR);
            let blkInfo = copy StructFieldAccessValue(loc, PTR_VOID_TYPE, slice, SliceKeys::BLK_INFO);
            (sliceLen, arrayAddr, blkInfo)
        };

        let fstIndex = context.cteInterpret:.reduce(copy StructFieldAccessValue(loc, indexType, indexValue, RangeKeys::FST));
        let scdIndex = context.cteInterpret:.reduce(copy StructFieldAccessValue(loc, indexType, indexValue, RangeKeys::SCD));

        // Cte verification if possible, to check wether the range values are correctly bounded
        let cteFst = ValueVerification::verifyIndexOverflow(alias context, loc, sliceType, fstIndex, startType,
                                                             maxLen-> sliceLen,
                                                             equalMax-> true);

        let cteScd = ValueVerification::verifyIndexOverflow(alias context, loc, sliceType, scdIndex, startType,
                                                             maxLen-> sliceLen,
                                                             equalMax-> true);

        let cteOrder = ValueVerification::verifyIncreasingRangeIndex(alias context, loc, sliceType, fstIndex, scdIndex);

        let fstSizeIndex = CastValidation::validateExplicit(alias context, fstIndex.loc, fstIndex, USIZE_TYPE);
        let scdSizeIndex = CastValidation::validateExplicit(alias context, scdIndex.loc, scdIndex, USIZE_TYPE);

        let sizeValue = CastValidation::validateExplicit(alias context,
                                                         loc,
                                                         TypeSize::validate(alias context, loc, innerType),
                                                         USIZE_TYPE);

        let newLen = SliceIndexValidation::validatePartLength(alias context, loc, startType,
                                                              fstIndex, scdIndex,
                                                              fstSizeIndex, scdSizeIndex);


        let fstPaddIndex = copy MathIntOperatorValue(loc, USIZE_TYPE, BinaryOperators::STAR, fstSizeIndex, sizeValue);
        let newPtr = copy MathPointerOperatorValue(loc, ptrType, BinaryOperators::PLUS,
                                                   arrayAddr,
                                                   fstPaddIndex); // the new pointer is the address of the array + range.fst

        let finalSliceType = copy SliceType(loc, innerType, isMutable-> true);
        let finalSliceValue = copy SliceCtorValue(loc, finalSliceType,
                                                  ptr-> newPtr,
                                                  blk-> blkInfo,
                                                  len-> newLen,
                                                  isImplicitAlias-> false); // Construction of the slice from pointer and length

        if cteFst && cteScd && cteOrder { // all bound test are Cte
            let reduced = context.cteInterpret:.reduceInStructAccess(slice);
            if let Ok(folded) = SliceOrArrayInterpret::reduceStringRange(loc, finalSliceType, reduced, fstIndex, scdIndex) {
                return folded;
            }
        }

        if (!context.getUnsafeContextLoc().isEof) {
            ValueVerification::verifyUnsafeContext(alias context, loc);
            return finalSliceValue;
        }


        if cteFst && cteScd && cteOrder { // all bound test are Cte
            return finalSliceValue;
        }

        // The debug test is if (len < rng.scd || rng.scd < rng.fst) throw OutOfArray();
        let cmpLen = copy CmpIntOperatorValue(loc,
                                               BinaryOperators::INF,
                                               sliceLen,
                                               scdSizeIndex);

        let cmpRange = copy CmpIntOperatorValue(loc, BinaryOperators::INF, scdSizeIndex, fstSizeIndex);
        let cmp = copy LogicalBoolOperatorValue(loc, BinaryOperators::DPIPE, cmpLen, cmpRange);

        let cond = ValueCreation::createOutOfArrayTest(loc, cmp);

        return copy BlockValue(loc, finalSliceType, copy [cond, finalSliceValue], isSet-> true);
    }

    /**
     * Compute the length `scd - fst` of a part whose bounds are the same run-time value shifted by
     * constants (e.g. `x .. x + k`).
     *
     * @returns: the length when it is non negative and fits the type of the bounds, so that it is
     *           the actual length whenever the run-time bounds check passes; none otherwise
     */
    pub fn computePartLength(boundType: &Type, fst: &Value, scd: &Value)-> (&BigInt)? {
        if let t: &IntType = boundType {
            let (fstBase, fstOffset) = inner::splitOffset(fst);
            let (scdBase, scdOffset) = inner::splitOffset(scd);
            let len = scdOffset - fstOffset;
            if (len >= 0 && len <= IntInterpret::createIntMaxValue(t) && inner::isSameValue(fstBase, scdBase)) {
                return len?;
            }
        }

        none
    }

    /**
     * Validate the length `scd - fst` of the part of a slice, folded to a literal when
     * computePartLength knows it.
     */
    fn validatePartLength(dmut context: &ValidationContext,
                          loc:          &Word,
                          boundType:    &Type,
                          fst:          &Value,
                          scd:          &Value,
                          fstSize:      &Value,
                          scdSize:      &Value)-> &Value
        throws ErrorMsg
    {
        if let Ok(len) = SliceIndexValidation::computePartLength(boundType, fst, scd) {
            return copy IntValue(loc, USIZE_TYPE, len);
        }

        context.cteInterpret:.reduce(copy MathIntOperatorValue(loc, USIZE_TYPE, BinaryOperators::MINUS, scdSize, fstSize))
    }
}

mod inner {

    /**
     * Split an integer value into a base and a constant offset, `x + 2 - 1` giving `(x, 1)`.
     */
    pub fn splitOffset(value: &Value)-> (&Value, &BigInt) {
        if let m: &MathIntOperatorValue = value {
            if let i: &IntValue = m.right {
                if (m.op == BinaryOperators::PLUS) {
                    let (base, offset) = inner::splitOffset(m.left);
                    return (base, offset + i.value);
                }

                if (m.op == BinaryOperators::MINUS) {
                    let (base, offset) = inner::splitOffset(m.left);
                    return (base, offset - i.value);
                }
            }

            if let i: &IntValue = m.left && m.op == BinaryOperators::PLUS {
                let (base, offset) = inner::splitOffset(m.right);
                return (base, offset + i.value);
            }
        }

        (value, copy BigInt(0))
    }

    /**
     * @returns: true iff `a` and `b` are side-effect free and always evaluate to the same value.
     */
    pub fn isSameValue(a: &Value, b: &Value)-> bool {
        match (a, b) {
            (x: &VarRefValue, y: &VarRefValue) => {
                return x.refId == y.refId && !x.isLazy;
            }
            (x: &IntValue, y: &IntValue) => {
                return x.type == y.type && x.value == y.value;
            }
            (x: &MathIntOperatorValue, y: &MathIntOperatorValue) => {
                return x.op == y.op && inner::isSameValue(x.left, y.left) && inner::isSameValue(x.right, y.right);
            }
            (x: &StructFieldAccessValue, y: &StructFieldAccessValue) => {
                return x.name == y.name && inner::isSameValue(x.object, y.object);
            }
            (x: &TupleFieldAccessValue, y: &TupleFieldAccessValue) => {
                return x.index == y.index && inner::isSameValue(x.object, y.object);
            }
            (x: &ClassFieldAccessValue, y: &ClassFieldAccessValue) => {
                return x.name == y.name && inner::isSameValue(x.object, y.object);
            }
        }

        false
    }
}
