in class_;

use ymirc::lexing::{word, keys};
use ymirc::syntax::expression::operator;
use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::errors::message;
use ymirc::lexing::word;
use ymirc::global::_;

/**
 * ClassIndexValidation
 *
 * Provides semantic validation for indexing operations on custom defined types:
 *
 *      object[i]
 *      object[a .. b]
 *      object[i] = v
 *
 *
 */
pub mod ClassIndexValidation {


    /**
     * Validate an indexing operation on an object using method overloading.
     *
     * @params:
     *   - context:      validation context
     *   - loc:          location of the index operator
     *   - object:       the object being indexed
     *   - objectType:   the static type of the object
     *   - indices:      list of index expressions
     *
     * @returns:
     *   A &Value representing the result of the indexing operation.
     *
     * @throws:
     *   ErrorMsg if the index method cannot be found or the index types are invalid.
     */
    pub fn validate(dmut context: &ValidationContext,
                     loc:          &Word,
                     object:       &Value,
                     objectType:   &ClassPtrType,
                     indices:      [&Value])-> &Value
        throws ErrorMsg
    {
        let meth = ValueCreation::createObjectMethodAcc(alias context, loc, objectType, object, OpOverrideNames::INDEX);
        return CallValidation::validate(alias context, loc, meth, indices);
    }

    /**
     * Validate an assignment operation on an indexed object.
     *
     * @params:
     *   - context:      validation context
     *   - loc:          location of the assignment operator
     *   - object:       the object being assigned to
     *   - objectType:   the static type of the object
     *   - indices:      list of index expressions
     *   - assign:       value to be assigned
     *
     * @returns:
     *   A &Value representing the result of the assignment validation.
     *
     * @throws:
     *   ErrorMsg if the assignment operation is invalid or unsupported.
     */
    pub fn validateAssign(dmut context: &ValidationContext,
                           loc:          &Word,
                           object:       &Value,
                           objectType:   &ClassPtrType,
                           indices:      [&Value],
                           assign:       &Value)-> &Value
        throws ErrorMsg
    {
        let meth = ValueCreation::createObjectMethodAcc(alias context, loc, objectType, object, OpOverrideNames::INDEX_ASSIGN);
        return CallValidation::validate(alias context, loc, meth, indices ~ [assign]);
    }
}
