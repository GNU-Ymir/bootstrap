/*
 * Implements semantic validation for pointer indexing in Ymir.
 *
 * Responsibilities:
 *   - Validate integer indexing on raw pointers.
 *   - Enforce unsafe-context restrictions for pointer arithmetic.
 *   - Compute pointer offsets using element size.
 *   - Reject indexing on void pointers.
 *   - Construct DereferencerValue for the resulting pointer access.
 *
 * Pointer indexing is lower-level than array or slice indexing:
 *   - No bounds checking is performed.
 *   - Indexing is only allowed in unsafe contexts.
 *   - The result type depends on whether the pointer is an lvalue.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::value::operator::index::pointer
 * @File: ymirc/semantic/validator/value/operator/index/pointer.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-05-13
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in pointer;

use ymirc::syntax::expression::operator;
use ymirc::semantic::{validator, interpret};
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::errors;
use ymirc::lexing::{word, tokens, keys};

use ymirc::utils::{format, bigint};


/**
 * PointerIndexValidation
 *
 * Provides semantic validation for pointer indexing:
 *
 *      ptr[i]
 *
 * Pointer indexing is equivalent to:
 *
 *      *(ptr + i * sizeof(T))
 *
 * where T is the pointed type.
 *
 */
pub mod PointerIndexValidation {

    /**
     * Validate an indexing operation on a pointer.
     *
     * @params:
     *   - context:      validation context
     *   - loc:          location of the index operator
     *   - ptr:          the pointer value being indexed
     *   - ptrType:      the static pointer type
     *   - indices:      list of index expressions
     *   - indicesTypes: list of index types
     *
     * @returns:
     *   A &Value representing the dereferenced pointer access.
     *
     * @throws:
     *   ErrorMsg if the index type is invalid or unsupported.
     */
    pub fn validate(dmut context: &ValidationContext,
                     loc:          &Word,
                     ptr:          &Value,
                     ptrType:      &PointerType,
                     indices:      [&Value],
                     indicesTypes: [&Type])-> &Value
        throws ErrorMsg
    {
        if indicesTypes.len == 1 {
            if let i: &IntType = indicesTypes[0] {
                return PointerIndexValidation::validateInt(alias context, loc, ptr, ptrType, indices[0], i);
            }
        }

        throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::UNDEFINED_INDEX_OP, ptrType, indicesTypes));
    }

    /**
     * Validate integer indexing on a pointer.
     *
     * @params:
     *   - context:    validation context
     *   - loc:        index operator location
     *   - ptr:        pointer value
     *   - ptrType:    pointer type
     *   - indexValue: index expression
     *   - indexType:  integer type of the index
     *
     * @returns:
     *   A &Value representing the dereferenced pointer access.
     *
     * @throws:
     *   ErrorMsg if indexing is attempted on a void pointer.
     */
    fn validateInt(dmut context: &ValidationContext,
                    loc:              &Word,
                    ptr:              &Value,
                    ptrType:          &PointerType,
                    indexValue:       &Value,
                    indexType:        &IntType)-> &Value
        throws ErrorMsg
    {
        ValueVerification::verifyUnsafeContext(alias context, loc);

        let mut retType = ptrType.pointed;
        if !ptr.isLvalue {
            retType = retType.clone(0);
        }

        if (retType of VoidType) {
            throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::UNDEFINED_INDEX_OP, ptrType, indexType));
        }

        let sizeValue = CastValidation::validateExplicit(alias context,
                                                          TypeSize::validate(alias context, loc, retType),
                                                          USIZE_TYPE);

        let index = CastValidation::validateExplicit(alias context, indexValue, USIZE_TYPE);

        let shiftedIndex = copy MathPointerOperatorValue(loc,
                                                          USIZE_TYPE,
                                                          BinaryOperators::STAR,
                                                          index,
                                                          sizeValue);

        let pointerValue = copy MathPointerOperatorValue(loc,
                                                          ptrType,
                                                          BinaryOperators::PLUS,
                                                          ptr,
                                                          shiftedIndex);

        return copy DereferencerValue(loc, retType, pointerValue);
    }

}
