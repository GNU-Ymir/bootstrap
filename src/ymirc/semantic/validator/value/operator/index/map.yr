/*
 * The `MapIndexValidation` module is responsible for validating indexing and
 * index assignment operations on map data structures. It provides two primary
 * functions: `validate` and `validateAssign`.
 * 
 * The `validate` function ensures that an indexing operation adheres to the
 * expected type constraints, returning the appropriate value if the operation is
 * valid. It checks for the correct number of indices, validates the type of the
 * index against the map's key type, and infers the value type based on the map's
 * definition. If any condition fails, it throws an appropriate error message.
 * 
 * The `validateAssign` function focuses on validating assignment operations to map
 * indices. It verifies that the map allows such operations, checks that only a
 * single index is used, and ensures type compatibility between the assigned value
 * and the map's value type. It also performs memory verification to ensure that
 * the assignment adheres to ownership rules.
 *  
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: map
 * @File: map.yr
 * @Author(s):
 *   - fatal: not a git repository (or any of the parent directories): .git
 *
 * @Created (YYYY-MM-DD): fatal: not a git repository (or any of the parent directories): .git
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */
in map;

use ymirc::lexing::{word, keys};
use ymirc::syntax::expression::operator;
use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::errors::message;
use ymirc::lexing::word;

use ymirc::utils::format;

/**
 * MapIndexValidation
 *
 * Provides semantic validation for indexing operations on maps:
 *
 *      map[k]
 *      map[k] = v
 * 
 */
pub mod MapIndexValidation {

    /**
     * Validate an indexing operation on a map.
     *
     * @params:
     *   - context:      validation context
     *   - loc:          location of the index operator
     *   - map:          the map value being indexed
     *   - mapType:      the static type of the map
     *   - indices:      list of index values
     *   - indicesTypes: list of index types
     *
     * @returns:
     *   A &Value representing the result of the indexing operation.
     *
     * @throws:
     *   ErrorMsg if the index type is invalid, the number of indices is incorrect, or type inference fails.
     */
    pub fn validate (dmut context: &ValidationContext,
                     loc:          &Word,                                                                
                     map:          &Value,
                     mapType:      &MapType,
                     indices:      [&Value],
                     indicesTypes: [&Type])-> &Value
        throws ErrorMsg
    {
        if (indicesTypes.len != 1us) { 
            throw copy ErrorMsg::fatal (loc, format (ValidateErrorMessage::UNDEFINED_INDEX_OP, mapType, indicesTypes));
        }

        let keyType = mapType.key;            
        let key = {
            TypeInference::inferValueForType (alias context, loc, indices [0], keyType,
                                              byReference-> false)
        } catch {
            err => {
                throw copy ErrorMsg::fatal (loc, format (ValidateErrorMessage::UNDEFINED_INDEX_OP, mapType, indicesTypes),
                                            notes-> copy [err]);
            }
        };

        let valueType = mapType.value;
        let optType = copy OptionType (loc, valueType, isMutable-> true);
        return copy MapAccessValue (loc, optType, map, key);        
    }
    
    /**
     * Validate an index assignment operation in a map.
     *
     * @params:
     *   - context:      validation context
     *   - loc:          location of the assignment operation
     *   - map:          the map value being index assigned
     *   - mapType:      the static type of the map
     *   - indices:      list of index values for the map keys
     *   - indicesTypes: list of types of the index values
     *   - assign:       the value being assigned to the key index in the map
     *
     * @returns:
     *   A &Value representing the result of the assignment operation.
     *
     * @throws:
     *   ErrorMsg if the map type does not allow implicit dereferencing, if the index count is incorrect, 
     *   or if type inference on the key or value fails.
     */
    pub fn validateAssign (dmut context: &ValidationContext,
                           loc:          &Word,                           
                           map:          &Value,
                           mapType:      &MapType,
                           indices:      [&Value],
                           indicesTypes: [&Type], 
                           assign:       &Value)-> &Value
        throws ErrorMsg
    {
        if !mapType.needsExplicitAlias {
            throw copy ErrorMsg::fatal (map.loc, end-> loc, format (ValidateErrorMessage::NOT_A_LVALUE));
        }
        
        if indicesTypes.len != 1 {
            throw copy ErrorMsg::fatal (loc, format (ValidateErrorMessage::UNDEFINED_INDEX_OP, mapType, indicesTypes));
        }

        let keyType = mapType.key;            
        let key = {
            TypeInference::inferValueForType (alias context, loc, indices [0], keyType,
                                              byReference-> false)
        } catch {
            err => {
                throw copy ErrorMsg::fatal (loc, format (ValidateErrorMessage::UNDEFINED_INDEX_OP, mapType, indicesTypes),
                                            notes-> copy [err]);
            }
        };

        let valueType = mapType.value;
        let realAff = TypeInference::inferValueForType (alias context, loc, assign, valueType,
                                                        byReference-> false);

        MemoryVerification::verifyMemoryOwner (loc, valueType, realAff,
                                               construct-> false,
                                               byReference-> false);
        
        return copy MapInsertValue (loc, VOID_TYPE, map, key, realAff);        
    }

}
