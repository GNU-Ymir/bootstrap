in union_;

use ymirc::errors;
use ymirc::global::core_;
use ymirc::lexing::word;
use ymirc::semantic::generator::value;
use ymirc::semantic::generator::type::custom;
use ymirc::utils::format;

/**
 * UnionIndexValidation
 *
 * Provides semantic validation for indexing operations on a union:
 *
 *      object[i]
 *      object[i] = v
 *
 * The operator is the method every member declares under its name, dispatched
 * through the member held, as any other method of the union.
 */
pub mod UnionIndexValidation {

    /**
     * Validate an indexing operation on a union.
     *
     * @params:
     *   - context:   validation context
     *   - loc:       location of the index operator
     *   - object:    the union being indexed
     *   - u:         the type of the union
     *   - indices:   list of index values
     *
     * @returns:
     *   A &Value representing the call to the index method.
     *
     * @throws:
     *   ErrorMsg if the members do not all declare the index method, or if the
     *   index types are invalid.
     */
    pub fn validate(dmut context: &ValidationContext,
                     loc:          &Word,
                     object:       &Value,
                     u:            &UnionType,
                     indices:      [&Value])-> &Value
        throws ErrorMsg
    {
        let meth = ValueCreation::createUnionMethodAcc(alias context, loc, u, object, OpOverrideNames::INDEX);
        return CallValidation::validate(alias context, loc, meth, indices);
    }

    /**
     * Validate an index assignment on a union.
     *
     * @params:
     *   - context:   validation context
     *   - loc:       location of the assignment operator
     *   - object:    the union being assigned to
     *   - u:         the type of the union
     *   - indices:   list of index values
     *   - assign:    value to be assigned
     *
     * @returns:
     *   A &Value representing the call to the index assign method.
     *
     * @throws:
     *   ErrorMsg if the union is not mutable, or if the members do not all
     *   declare the index assign method.
     */
    pub fn validateAssign(dmut context: &ValidationContext,
                           loc:          &Word,
                           object:       &Value,
                           u:            &UnionType,
                           indices:      [&Value],
                           assign:       &Value)-> &Value
        throws ErrorMsg
    {
        // the affectation aliases the union implicitly to call the mutable
        // `opIndexAssign` method, so a constant union can never be index assigned
        if (!u.isRecord && !u.isDeeplyMutable) {
            let notes = copy [copy ErrorMsg::note(loc, format(ValidateErrorMessage::INDEX_ASSIGN_NOT_MUTABLE_NOTE), oneLine-> true)];
            throw copy ErrorMsg::fatal(loc,
                                        end-> object.loc,
                                        notes-> notes,
                                        format(ValidateErrorMessage::INDEX_ASSIGN_NOT_MUTABLE, u));
        }

        let aliasObj = AliasValidation::validate(alias context, loc, object,
                                                 isClass-> true,
                                                 isField-> false);

        let meth = ValueCreation::createUnionMethodAcc(alias context, loc, u, aliasObj, OpOverrideNames::INDEX_ASSIGN);
        return CallValidation::validate(alias context, loc, meth, indices ~ [assign]);
    }
}
