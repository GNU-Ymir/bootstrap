in slice;

use ymirc::syntax::{_, declaration::_, expression::_};

use ymirc::semantic::{declarator, validator, template_, interpret, symbol};
use ymirc::semantic::generator::{value::_, type::_};
use ymirc::semantic::generator::_;

use ymirc::global::core_;
use ymirc::errors;
use ymirc::utils::{format, string, bigint};

use ymirc::lexing::{word, tokens, keys};

use std::{io, stream, time::_};

/**
 * SliceFieldValidation
 *
 * Provides semantic validation for field access on slice values.
 *
 * Supported field names:
 *   - len — returns the slice length(usize)
 *   - ptr — returns a pointer to the slice’s first element
 *
 * This module defines the complete semantics of slice field access in Ymir.
 */
pub mod SliceFieldValidation {

    /**
     * Validate a field access on a slice value.
     *
     * Supported fields:
     *   - len — returns the number of elements in the slice(usize)
     *   - ptr — returns a pointer to the slice’s first element
     *
     * @params:
     *   - loc:       operator location
     *   - left:      validated slice value
     *   - leftType:  slice type of the left operand
     *   - right:     field expression
     *
     * @returns:
     *   A &Value representing the validated field access.
     *
     * @throws:
     *   ErrorMsg if the field is not a valid slice field.
     */
    pub fn validate(loc:      &Word,
                     left:     &Value,
                     leftType: &SliceType,
                     right:    &Expression)-> &Value
        throws ErrorMsg
    {
        if let field: &VarExpr = right {
            match field.name.str {
                SliceKeys::LEN => {
                    return copy StructFieldAccessValue(loc, USIZE_TYPE, left, field.name.str);
                }
                SliceKeys::PTR => {
                    let inner = leftType.value;
                    let ptr = copy PointerType(loc, inner, isMutable-> inner.isMutable);
                    return copy StructFieldAccessValue(loc, ptr, left, field.name.str);
                }
            }
        }

        throw copy ErrorMsg::fatal(right.loc,
                                    format(ValidateErrorMessage::TYPE_NO_FIELD, left.type, right));
    }

}
