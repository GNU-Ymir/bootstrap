in map;

use ymirc::syntax::{_, declaration::_, expression::_};

use ymirc::semantic::{declarator, validator, template_, interpret, symbol};
use ymirc::semantic::generator::{value::_, type::_};
use ymirc::semantic::generator::_;

use ymirc::global::core_;
use ymirc::errors::_;
use ymirc::utils::{format, string, bigint};

use ymirc::lexing::{word, tokens, keys};

use std::{io, stream, time::_};

/**
 * MapFieldValidation
 *
 * Provides semantic validation for field access on map values.
 *
 * Supported field names:
 *   - len    — returns the number of entries in the map
 *   - remove — returns a delegate allowing removal of a key
 *
 * This module defines the complete semantics of map field access in Ymir.
 */
pub mod MapFieldValidation {

    /**
     * Validate a field access on a map value.
     *
     * Supported fields:
     *   - len    — returns the number of entries in the map
     *   - remove — returns a delegate for key removal
     *
     * @params:
     *   - context:   validation context
     *   - loc:       operator location
     *   - left:      validated map value
     *   - leftType:  map type of the left operand
     *   - right:     field expression
     *
     * @returns:
     *   A &Value representing the validated field access.
     *
     * @throws:
     *   ErrorMsg if the field is invalid or aliasing rules are violated.
     */
    pub fn validate (dmut context: &ValidationContext,
                     loc:          &Word,
                     left:         &Value,
                     leftType:     &MapType,
                     right:        &Expression)-> &Value
        throws ErrorMsg
    {
        if let field: &VarExpr = right {
            match field.name.str {
                MapKeys::LEN => {
                    if (left of MapAliaserValue) {
                        throw copy ErrorMsg::fatal (loc,
                                                    end-> right.loc,
                                                    format (ValidateErrorMessage::CLASS_ALIAS_FIELD));
                    }
                    
                    return copy MapLenAccessValue (loc, USIZE_TYPE, left);
                }
                MapKeys::REMOVE => {                    
                    return MapFieldValidation::validateRemoveMap (alias context, loc, left, leftType, right);
                }
            }
        }

        if (left of MapAliaserValue) {
            let note = copy ErrorMsg::fatal (right.loc,
                                             format (ValidateErrorMessage::TYPE_NO_FIELD, left.type, right));
            
            throw copy ErrorMsg::fatal (loc,
                                        end-> right.loc,
                                        format (ValidateErrorMessage::CLASS_ALIAS_FIELD),
                                        notes-> copy [note]);
        }
        
        throw copy ErrorMsg::fatal (right.loc,
                                    format (ValidateErrorMessage::TYPE_NO_FIELD, left.type, right));
    }

    /**
     * Validate the `map:.remove` field.
     *
     * This is a mutable method and therefore requires the left operand to be
     * a MapAliaserValue. If not, a MUTABLE_METHOD error is produced with
     * appropriate notes.
     *     
     * @params:
     *   - context:  validation context
     *   - loc:      operator location
     *   - left:     validated map alias value
     *   - mapType:  map type of the left operand
     *   - right:    field expression
     *
     * @returns:
     *   A &Value representing a delegate to the remove method.
     *
     * @throws:
     *   ErrorMsg if aliasing rules are violated or the core function is malformed.
     */
    fn validateRemoveMap (dmut context: &ValidationContext,
                          loc: &Word,                          
                          left: &Value,
                          mapType: &MapType,
                          right: &Expression)-> &Value
        throws ErrorMsg
    {
        if (left !of MapAliaserValue) {
            let mut notes = copy [copy ErrorMsg::note (left.loc,
                                                       format (ValidateErrorMessage::IMPLICIT_ALIAS, mapType))];
            
            if (left of AliaserValue) {
                notes = notes ~ [copy ErrorMsg::note (left.loc,
                                                      format (ValidateErrorMessage::SIMPLE_ALIAS_NOT_CLASS),
                                                      oneLine-> true)];
            }
            
            throw copy ErrorMsg::fatal (loc, end-> right.loc,
                                        format (ValidateErrorMessage::MUTABLE_METHOD, MapKeys::REMOVE),
                                        notes-> notes);
        }
        
        let methExpr = VariableCreation::createSyntaxVarFromPath (loc, MapUtils::REMOVE_FUNC);
        let methFunc = TemplateValidation::validateCall (
            alias context,
            loc,
            ValueValidation::validate (alias context, methExpr),
            mapType.inners [0 .. 2]);
        
        if let n: &PrototypeValue = methFunc {
            let closure = copy ReferencerValue (loc, mapType, left, isMutable-> true);
            return copy FakeMethodDelegateValue (loc, n, closure, rename-> MapKeys::REMOVE);
        }
        
        throw copy ErrorMsg::fatal (loc, ValidateErrorMessage::MALFORMED_CORE);                                 
    }

}
