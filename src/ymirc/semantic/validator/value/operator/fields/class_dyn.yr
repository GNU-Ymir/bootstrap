in class_dyn;


use ymirc::syntax::{_, declaration::_, expression::_};
use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::errors::_;
use ymirc::lexing::word;


/**
 * Field validaiton on class, using the dynamic field access `.`
 * */
pub mod ClassDynamicFieldValidation {

    pub fn validateVtableAccess (dmut context: &ValidationContext,
                                 loc:          &Word,
                                 object:       &Value,
                                 field:        &Expression,
                                 cref:         &ClassRefType,
                                 isProxy :     bool,
                                 inProt :      bool,
                                 inPrv :       bool,
                                 allowImmut :  bool = false,
                                 assign :      bool = false,
                                 inCall :      bool = false,
                                 forceCall :   bool = true)-> &Value
        throws ErrorMsg
    {}
        
}
