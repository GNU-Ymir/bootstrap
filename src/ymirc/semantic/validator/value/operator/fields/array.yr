in array;

use ymirc::syntax::{_, declaration::_, expression::_};

use ymirc::semantic::{declarator, validator, template_, interpret, symbol};
use ymirc::semantic::generator::{value::_, type::_};
use ymirc::semantic::generator::_;

use ymirc::global::core_;
use ymirc::errors::_;
use ymirc::utils::{format, string, bigint};

use ymirc::lexing::{word, tokens, keys};

use std::{io, stream, time::_};

/**
 * ArrayFieldValidation
 *
 * Provides semantic validation for field access on array values.
 *
 * Supported field names:
 *   - len — returns the array length as a compile-time IntValue
 *   - ptr — returns a pointer to the array’s first element
 *
 * This module defines the complete semantics of array field access in Ymir.
 */
pub mod ArrayFieldValidation {

    /**
     * Validate a field access on an array value.
     *
     * Supported fields:
     *   - len — returns the array length as a compile-time IntValue(usize)
     *   - ptr — returns a pointer to the array’s first element
     *
     * @params:
     *   - loc:       operator location
     *   - left:      validated array value
     *   - leftType:  array type of the left operand
     *   - right:     field expression
     *
     * @returns:
     *   A &Value representing the validated field access.
     *
     * @throws:
     *   ErrorMsg if the field is not a valid array field.
     */
    pub fn validate (loc:      &Word,
                     left:     &Value,
                     leftType: &ArrayType,
                     right:    &Expression)-> &Value
        throws ErrorMsg
    {
        if let field: &VarExpr = right {
            match field.name.str {
                SliceKeys::LEN => {                    
                    return copy IntValue (loc, USIZE_TYPE, leftType.len); 
                }
                SliceKeys::PTR => {
                    let inner = leftType.value;
                    let ptr = copy PointerType (loc, inner, isMutable-> inner.isMutable);
                    return copy AddressValue (loc, ptr, left);
                }
            }
        }

        throw copy ErrorMsg::fatal (right.loc,
                                    format (ValidateErrorMessage::TYPE_NO_FIELD, left.type, right));
    }
    
}
