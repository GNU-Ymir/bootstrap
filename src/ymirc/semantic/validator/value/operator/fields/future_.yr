in future_;

use ymirc::syntax::{_, declaration::_, expression::_};

use ymirc::semantic::{declarator, validator, template_, interpret, symbol};
use ymirc::semantic::generator::{value::_, type::_};
use ymirc::semantic::generator::_;

use ymirc::global::core_;
use ymirc::errors::_;
use ymirc::utils::{format, string, bigint};

use ymirc::lexing::{word, tokens, keys};

use std::{io, stream, time::_};

/**
 * FutureFieldValidation
 *
 * Provides semantic validation for field access on future values.
 *
 * Supported field names:
 *   - value      — returns the result of the future
 *   - finished   — returns whether the future has completed
 *   - threadId   — returns the thread identifier running the future
 *
 * This module defines the complete semantics of future field access in Ymir.
 */
pub mod FutureFieldValidation {

    /**
     * Validate a field access on a future value.
     *
     * Supported fields:
     *   - value      — returns the future's result (leftType.retType)
     *   - finished   — returns a boolean indicating completion
     *   - threadId   — returns the thread identifier (usize)
     *     
     * @params:
     *   - loc:       operator location
     *   - left:      validated future value
     *   - leftType:  future type of the left operand
     *   - right:     field expression
     *
     * @returns:
     *   A &Value representing the validated field access.
     *
     * @throws:
     *   ErrorMsg if the field is not a valid future field.
     */
    pub fn validate (loc:          &Word,
                     left:         &Value,
                     leftType:     &FutureType,
                     right:        &Expression)-> &Value
        throws ErrorMsg
    {
        if let field: &VarExpr = right {
            match field.name.str {
                FutureKeys::VALUE => {
                    return copy FutureFieldAccessValue (loc, leftType.retType, left, FutureKeys::VALUE);
                }
                FutureKeys::FINISHED => {
                    return copy FutureFieldAccessValue (loc, BOOL_TYPE, left, FutureKeys::FINISHED);                    
                }
                FutureKeys::THREAD_ID => {
                    return copy FutureFieldAccessValue (loc, USIZE_TYPE, left, FutureKeys::THREAD_ID);                    
                }
            }            
        }
        
        throw copy ErrorMsg::fatal (right.loc,
                                    format (ValidateErrorMessage::TYPE_NO_FIELD, left.type, right));
    }
    
}
