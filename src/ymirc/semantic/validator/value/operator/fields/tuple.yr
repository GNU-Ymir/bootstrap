in tuple;

use ymirc::syntax::{_, declaration::_, expression::_};

use ymirc::semantic::{declarator, validator, template_, symbol};
use ymirc::semantic::generator::{value::_, type::_};
use ymirc::semantic::generator::_;

use ymirc::global::core_;
use ymirc::errors::_;
use ymirc::utils::{format, string};

use ymirc::lexing::{word, tokens, keys};

use std::{io, stream, time::_};

pub mod TupleStaticFieldValidation {
    
    pub fn validate (loc: &Word, type: &Type, value: &Value, index: usize, reduce: bool)-> &Value
        throws ErrorMsg
    {                
        if let tu: &TupleValue = value && reduce {
            return tu.values [index]
        }
        
        return copy TupleFieldAccessValue (loc, type, value, index);                    
    }
    
}
