 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in tuple;

use ymirc::syntax::{_, declaration::_, expression::_};

use ymirc::semantic::{declarator, validator, template_, interpret, symbol};
use ymirc::semantic::generator::{value::_, type::_};
use ymirc::semantic::generator::_;

use ymirc::global::core_;
use ymirc::errors;
use ymirc::utils::{format, string, bigint};

use ymirc::lexing::{word, tokens, keys};

use std::{io, stream, time::_};

/**
 * TupleFieldValidation
 *
 * Provides semantic validation for tuple field access expressions.
 *
 * This module defines the complete semantics of tuple field access in Ymir.
 */
pub mod TupleFieldValidation {

    /**
     * Validate a tuple field access of the form:
     *
     *      tupleExpr.indexExpr
     *
     * @params:
     *   - context:   validation context
     *   - loc:       operator location
     *   - left:      validated tuple value
     *   - leftType:  tuple type of the left operand
     *   - right:     index expression
     *
     * @returns:
     *   A &Value representing the validated tuple field access.
     *
     * @throws:
     *   ErrorMsg if the index is invalid or out of bounds.
     */
    pub fn validate(dmut context: &ValidationContext,
                     loc:          &Word,
                     left:         &Value,
                     leftType:     &TupleType,
                     right:        &Expression)-> &Value
        throws ErrorMsg
    {

        let index = TupleFieldValidation::validateIndex(alias context, loc, left, right);
        return TupleFieldValidation::validate(loc, left, leftType, index,
                                               reduce-> true);
    }

    /**
     * Validate a tuple field access once the index is known.
     *
     * @params:
     *   - loc:       operator location
     *   - value:     validated tuple value
     *   - valueType: tuple type of the left operand
     *   - index:     zero-based tuple index
     *   - reduce:    whether to reduce literal tuple accesses
     *
     * @returns:
     *   A &Value representing the tuple element.
     *
     * @throws:
     *   ErrorMsg if the index is out of bounds.
     */
    pub fn validate(loc:       &Word,
                    value:     &Value,
                    valueType: &TupleType,
                    index:     usize,
                    reduce:    bool)-> &Value
        throws ErrorMsg
    {
        TupleFieldValidation::verifyArity(loc, valueType, index);

        if let tu: &TupleValue = value && reduce {
            return tu.values[index]
        }

        return copy TupleFieldAccessValue(loc, valueType.inners[index], value, index);
    }

    /**
     * Validate and compute the tuple index expression.
     *
     * Steps:
     *   1. Enter $-context for tuple indexing(context.enterDollar()).
     *   2. Validate the index expression as a value.
     *   3. Evaluate it as a compile-time integer via cteInterpret.computeInt().
     *   4. Convert the result to usize.
     *   5. Exit $-context.
     *
     * Errors:
     *   - If the index is not a compile-time integer => fatal error.
     *   - If the integer overflows usize => fatal error.
     *
     * @params:
     *   - context: validation context
     *   - loc:     operator location
     *   - left:    tuple value(used for $ resolution)
     *   - right:   index expression
     *
     * @returns:
     *   The computed index as usize.
     *
     * @throws:
     *   ErrorMsg if the index is not a valid compile-time integer.
     */
    fn validateIndex(dmut context: &ValidationContext,
                      loc:          &Word,
                      left:         &Value,
                      right:        &Expression)-> usize
        throws ErrorMsg
    {
        let field = {
            context:.enterDollar(left);
            ValueValidation::validate(alias context, right)
        } exit {
            context:.exitDollar();
        }

        {
            return context.cteInterpret:.computeInt(field).to!{usize} ()
        } catch {
            BigIntError() => {
                throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::OVERFLOW_CAPACITY, field.type, field,
                                                         IntInterpret::createIntMaxValue(USIZE_TYPE)));
            }
            e: &ErrorMsg => throw e;
        };
    }

    /**
     * Ensure that the tuple index is within bounds.
     *
     * Behavior:
     *   - If index >= tuple.arity => fatal TUPLE_ARITY_OVERFLOW error.
     *
     * @params:
     *   - loc:    operator location
     *   - tuple:  tuple type
     *   - index:  zero-based index
     *
     * @throws:
     *   ErrorMsg if the index is out of bounds.
     */
    fn verifyArity(loc: &Word, tuple: &TupleType, index: usize)
        throws ErrorMsg
    {
        if index >= tuple.arity {
            throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::TUPLE_ARITY_OVERFLOW, index, tuple.arity));
        }
    }
}
