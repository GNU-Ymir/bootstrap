in yield_;

use ymirc::errors;
use ymirc::lexing::{keys, word};
use ymirc::semantic::generator::value::_;
use ymirc::syntax::expression::_;
use ymirc::utils::format;


/**
 * YieldFieldValidation
 *
 * Provides semantic validation for field access on generator values.
 *
 * Supported field names:
 *   - next — returns a delegate resuming the generator
 */
pub mod YieldFieldValidation {

    /**
     * Validate a field access on a generator value.
     *
     * The `next` field is a fake method, it is only valid as the left operand of
     * a call, YieldNextCallValidation rewriting the call into the resumption of
     * the generator.
     *
     * @params:
     *   - loc:       operator location
     *   - left:      validated generator value
     *   - right:     field expression
     *   - inCall:    whether this field access occurs inside a call expression
     *
     * @returns:
     *   A &Value representing the validated field access.
     *
     * @throws:
     *   ErrorMsg if the field is not a valid generator field, or is not called.
     */
    pub fn validate(loc:    &Word,
                    left:   &Value,
                    right:  &Expression,
                    inCall: bool)-> &Value
        throws ErrorMsg
    {
        if let field: &VarExpr = right {
            match field.name.str {
                GeneratorKeys::NEXT => {
                    if (!inCall) {
                        throw copy ErrorMsg::fatal(loc,
                                                   end-> right.loc,
                                                   format(ValidateErrorMessage::FAKE_METHOD_CALL, GeneratorKeys::NEXT));
                    }

                    return copy YieldNextDelegateValue(loc, left);
                }
            }
        }

        throw copy ErrorMsg::fatal(right.loc,
                                   format(ValidateErrorMessage::TYPE_NO_FIELD, left.type, right));
    }

}
