 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in async_;

use ymirc::errors;
use ymirc::lexing::{keys, word};
use ymirc::semantic::generator::value::_;
use ymirc::syntax::expression::_;
use ymirc::utils::format;


/**
 * AsyncFieldValidation
 *
 * Provides semantic validation for field access on async values.
 *
 * Supported field names:
 *   - run  — returns a delegate driving the async to completion
 *   - poll — returns a delegate resuming the async once
 */
pub mod AsyncFieldValidation {

    /**
     * Validate a field access on an async value.
     *
     * The `run` and `poll` fields are fake methods, only valid as the left operand of
     * a call, AsyncRunCallValidation and AsyncPollCallValidation rewriting the call.
     *
     * @params:
     *   - loc:       operator location
     *   - left:      validated async value
     *   - right:     field expression
     *   - inCall:    whether this field access occurs inside a call expression
     *
     * @returns:
     *   A &Value representing the validated field access.
     *
     * @throws:
     *   ErrorMsg if the field is not a valid async field, or is not called.
     */
    pub fn validate(loc:    &Word,
                    left:   &Value,
                    right:  &Expression,
                    inCall: bool)-> &Value
        throws ErrorMsg
    {
        if let field: &VarExpr = right {
            match field.name.str {
                AsyncKeys::RUN => {
                    if (!inCall) {
                        throw copy ErrorMsg::fatal(loc,
                                                   end-> right.loc,
                                                   format(ValidateErrorMessage::FAKE_METHOD_CALL, AsyncKeys::RUN));
                    }

                    return copy AsyncRunDelegateValue(loc, left);
                }
                AsyncKeys::POLL => {
                    if (!inCall) {
                        throw copy ErrorMsg::fatal(loc,
                                                   end-> right.loc,
                                                   format(ValidateErrorMessage::FAKE_METHOD_CALL, AsyncKeys::POLL));
                    }

                    return copy AsyncPollDelegateValue(loc, left);
                }
            }
        }

        throw copy ErrorMsg::fatal(right.loc,
                                   format(ValidateErrorMessage::TYPE_NO_FIELD, left.type, right));
    }

}
