in fields;

use ymirc::lexing::word;
use ymirc::semantic::validator;
use ymirc::semantic::generator::{value, type};
use ymirc::utils::format;
use ymirc::errors::message;


pub mod ::enum_;

pub mod ::class_stat;
pub mod ::class_dyn;
pub mod ::tuple;

pub mod FieldValidation {

    // '::'
    pub fn validateStaticAccess (dmut context: &ValidationContext, loc: &Word, object: &Value, field: [c8])-> &Value
        throws ErrorMsg
    {
        context;
        loc;
        object;
        field;
        panic;
    }

    // '.'
    pub fn validateDynamicAccess (dmut context: &ValidationContext, loc: &Word, object: &Value, field: [c8])-> &Value
        throws ErrorMsg
    {
        context;
        loc;
        object;
        field;
        panic;        
    }    
    
}
