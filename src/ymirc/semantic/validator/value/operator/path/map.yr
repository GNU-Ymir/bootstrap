in map;

use ymirc::lexing::{word, tokens, keys};
use ymirc::syntax::expression::_;

use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::global::core_;
use ymirc::errors;
use ymirc::utils::{format, string};

/**
 * MapStaticFieldValidation
 *
 * Provides semantic validation for static field access on map types.
 *
 * Static map fields are accessed using the path operator:
 *
 *      Map :: field
 *
 * Supported fields:
 *   - INIT — returns an empty map value
 *
 * The validator:
 *   - strips leading underscores from the field name
 *   - matches the field against known static attributes
 *   - constructs a MapValue with no keys and no values
 *
 * Any unknown field produces a fatal UNDEFINED_BIN_ACC_OP error.
 *
 * This module defines the complete semantics of static map attributes.
 */
pub mod MapStaticFieldValidation {

    /**
     * Validate static field access on a map type.
     *
     * @params:
     *   - loc:   operator location
     *   - m:     MapType on the left side of `::`
     *   - right: field expression on the right side of `::`
     *
     * @returns:
     *   A &Value representing an empty map initializer.
     *
     * @throws:
     *   ErrorMsg if the field is unknown or validation fails.
     */
    pub fn validate(loc: &Word, m: &MapType, right: &Expression)-> &Value
        throws ErrorMsg
    {
        if let var: &VarExpr = right {
            match string::stripUnders(var.name.str) {
                NativeTypeAttribute::INIT => {
                    return copy MapValue(loc,
                                         type-> m,
                                         keys-> [],
                                         values-> []);
                }
            }
        }

        throw copy ErrorMsg::fatal(loc,
                                   format(ValidateErrorMessage::UNDEFINED_BIN_ACC_OP, BinaryOperators::DCOLON, m, right));
    }

}
