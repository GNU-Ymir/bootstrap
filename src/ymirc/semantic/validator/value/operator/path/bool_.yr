in bool_;

use ymirc::lexing::{word, tokens, keys};
use ymirc::syntax::expression::_;

use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::global::core_;
use ymirc::errors::_;
use ymirc::utils::{format, string};

/**
 * BoolStaticFieldValidation
 *
 * Provides semantic validation for static field access on the boolean type.
 *
 * Static boolean fields are accessed using the path operator:
 *
 *      Bool :: field
 *
 * Supported fields:
 *   - INIT — returns the default boolean value (false)
 *
 * The validator:
 *   - strips leading underscores from the field name
 *   - matches the field against known static attributes
 *   - constructs a BoolValue for INIT
 *
 */
pub mod BoolStaticFieldValidation {

    /**
     * Validate static field access on the boolean type.
     *
     * Supported field:
     *
     *   INIT
     *     - Returns the default boolean initializer:
     *           BoolValue(loc, b, false)
     *     
     * @params:
     *   - loc:   operator location
     *   - b:     BoolType on the left side of `::`
     *   - right: field expression on the right side of `::`
     *
     * @returns:
     *   A &Value representing the validated static boolean attribute.
     *
     * @throws:
     *   ErrorMsg if the field is unknown or validation fails.
     */
    pub fn validate (loc: &Word, b: &BoolType, right: &Expression)-> &Value
        throws ErrorMsg
    {
        if let var: &VarExpr = right {
            match string::stripUnders (var.name.str) {
                NativeTypeAttribute::INIT => {
                    return copy BoolValue (loc, b, false);
                }            
            }
        }

        throw copy ErrorMsg::fatal (loc,
                                    format (ValidateErrorMessage::UNDEFINED_BIN_ACC_OP, BinaryOperators::DCOLON, b, right));
    }
    
}
