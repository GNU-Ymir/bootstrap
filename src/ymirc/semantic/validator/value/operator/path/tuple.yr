in tuple;

use ymirc::lexing::{word, tokens, keys};
use ymirc::syntax::expression::_;

use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::global::core_;
use ymirc::errors::_;
use ymirc::utils::{format, string};

use ymirc::semantic::validator::value::operator::path::_;

/**
 * TupleStaticFieldValidation
 *
 * Provides semantic validation for static field access on tuple types.
 *
 * Static tuple fields are accessed using the path operator:
 *
 *      Tuple :: field
 *
 * Supported fields:
 *   - INIT  — returns a tuple whose elements are initialized according
 *             to the default initializer of each component type
 *   - ARITY — returns the number of elements in the tuple
 *
 * The validator:
 *   - strips leading underscores from the field name
 *   - matches the field against known static attributes
 *   - constructs a TupleValue for INIT by:
 *       - invoking constructors for class elements
 *       - invoking PathTypeValidation for primitive or composite types
 *       - aggregating all element values into a TupleValue
 *   - enriches errors with a contextual note indicating the tuple type
 *
 */
pub mod TupleStaticFieldValidation {

    /**
     * Validate static field access on a tuple type.
     *
     * @params:
     *   - context: validation context
     *   - loc:     operator location
     *   - t:       TupleType on the left side of `::`
     *   - right:   field expression on the right side of `::`
     *
     * @returns:
     *   A &Value representing either a tuple initializer or the tuple arity.
     *
     * @throws:
     *   ErrorMsg if the field is unknown or validation fails.
     */
    pub fn validate(dmut context: &ValidationContext, loc: &Word, t: &TupleType, right: &Expression)-> &Value
        throws ErrorMsg
    {
        if let var: &VarExpr = right {
            match string::stripUnders(var.name.str) {
                NativeTypeAttribute::INIT => {
                    return TupleStaticFieldValidation::validateInit(alias context, loc, t, var);

                }
                NativeTypeAttribute::ARITY => {
                    return copy IntValue(loc, USIZE_TYPE, t.inners.len);
                }
            }
        }

        throw copy ErrorMsg::fatal(loc,
                                   format(ValidateErrorMessage::UNDEFINED_BIN_ACC_OP, BinaryOperators::DCOLON, t, right));
    }

    /**
     * Construct a default initializer for a tuple type.
     *
     * This corresponds to the static attribute:
     *
     *      Tuple :: INIT
     *
     * @params:
     *   - context: validation context
     *   - loc:     operator location
     *   - t:       TupleType being initialized
     *   - right:   original field expression(used for PathTypeValidation)
     *
     * @returns:
     *   A &Value representing a fully initialized TupleValue.
     *
     * @throws:
     *   ErrorMsg enriched with a contextual note if any element fails to initialize.
     */
    fn validateInit(dmut context: &ValidationContext, loc: &Word, t: &TupleType, right: &Expression)-> &Value
        throws ErrorMsg
    {
        let mut v: [&Value] = [];
        {
            for i in t.inners match i {
                c: &ClassRefType => {
                    let ctor = ClassStaticFieldValidation::validateCtors(alias context, loc, c);
                    v ~= [CallValidation::validate(alias context, loc, ctor, [])];
                }
                c: &ClassPtrType => {
                    let ctor = ClassStaticFieldValidation::validateCtors(alias context, loc, c.inner);
                    v ~= [CallValidation::validate(alias context, loc, ctor, [])];
                }
                _ => {
                    let val = PathTypeValidation::validate(alias context, loc, i, right);
                    v ~= [val];
                }
            }
        } catch {
            err: &ErrorMsg => {
                throw err.withNote(copy [copy ErrorMsg::note(loc, format(ValidateErrorMessage::FOR_TYPE, t))]);
            }
        }

        return copy TupleValue(loc, t, v);
    }
}
