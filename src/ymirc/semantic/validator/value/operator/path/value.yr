in value;

use ymirc::lexing::{word, keys};
use ymirc::semantic::{validator, symbol};

use ymirc::syntax::{_, declaration::_, expression::_};
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::errors::message;
use ymirc::utils::format;

/**
 * PathValueValidation
 *
 * Provides semantic validation for value-scoped path access:
 *
 *      Value :: field
 *
 * This module handles cases where the left operand is:
 *
 *   - a module reference (ModuleRefValue)
 *   - a multi-symbol value (MultSymValue)
 *
 */
pub mod PathValueValidation {

    /**
     * Multi-result variant of value-scoped path validation.
     *
     * @params:
     *   - context: validation context
     *   - loc:     operator location
     *   - left:    Value on the left side of `::`
     *   - right:   field expression
     *   - values:  output array of successful resolutions
     *   - errors:  output array of errors
     */
    pub fn validate (dmut context: &ValidationContext,
                     loc: &Word,
                     left: &Value,
                     right: &Expression,
                     ref mut values: [&Value],
                     ref mut errors: [&ErrorMsg])
    {
        {
            let inVal = PathValueValidation::validate (alias context, loc, left, right);
            if let m: &MultSymValue = inVal {
                for v in m.values {
                    values ~= [v];
                }
            } else {
                values ~= [inVal];
            }
        } catch {
            err => {
                errors ~= [err];
            }
        }
    }

    /**
     * Validate value-scoped path access for a single result.
     *
     * @params:
     *   - context: validation context
     *   - loc:     operator location
     *   - left:    Value on the left side of `::`
     *   - right:   field expression on the right side of `::`
     *
     * @returns:
     *   A &Value representing the resolved symbol.
     *
     * @throws:
     *   ErrorMsg if no valid resolution exists.
     */
    fn validate (dmut context: &ValidationContext,
                 loc: &Word,
                 left: &Value,
                 right: &Expression)-> &Value
        throws ErrorMsg
    {
        let mut errors: [&ErrorMsg] = [];
        if let v: &VarExpr = right match left {
            m: &ModuleRefValue => {
                if let Ok (r) = PathValueValidation::validateModule (alias context, loc, m, v, ref errors) {
                    return r;
                }
            }
            m: &MultSymValue => {                
                if let Ok (r) = PathValueValidation::validateMultSym (alias context, loc, m, v, ref errors) {
                    return r;
                }
            }
        }

        throw copy ErrorMsg::fatal (loc,
                                    format (ValidateErrorMessage::UNDEFINED_BIN_MOD_OP, BinaryOperators::DCOLON, left, right),
                                    notes-> errors);
    }

    /**
     * Attempt module-scoped symbol lookup:
     *
     *      ModuleRefValue :: name
     *
     * @params:
     *   - context: validation context
     *   - loc:     operator location
     *   - left:    ModuleRefValue being queried
     *   - right:   VarExpr containing the field name
     *   - errors:  accumulator for diagnostic notes
     *
     * @returns:
     *   Ok(&Value) on success, none on failure.
     */
    fn validateModule (dmut context: &ValidationContext,
                       loc: &Word,
                       left: &ModuleRefValue,
                       right: &VarExpr,
                       ref mut errors: [&ErrorMsg])-> (&Value)?
    {        
        let dmut res = context:.getLocalFromMod (left, right.name.str);
        if res.len != 0 {
            {
                let m = VariableValidation::validateMultSymbols (alias context, loc, alias res);
                return m?;
            } catch {
                err => {
                    errors ~= [err];
                    return none;
                }
            }
        }
        
        errors ~= VariableCreation::createLocalVarError (context, loc, left, right.name.str);
        return none;
    }

    /**
     * Attempt resolution across a multi-symbol value:
     *
     * @params:
     *   - context: validation context
     *   - loc:     operator location
     *   - left:    MultSymValue containing module candidates
     *   - right:   VarExpr containing the field name
     *   - errors:  accumulator for diagnostic notes
     *
     * @returns:
     *   Ok(&Value) on success, none on failure.
     */
    fn validateMultSym (dmut context: &ValidationContext,
                        loc: &Word,
                        left: &MultSymValue,
                        right: &VarExpr,
                        ref mut errors: [&ErrorMsg])-> (&Value)?
    {
        let mut innerErrors: [&ErrorMsg] = [];
        let dmut all: [&Symbol] = [];
        
        for v in left.values match v {
            m: &ModuleRefValue => {
                let dmut res = context:.getLocalFromMod (m, right.name.str);
                all ~= res;
                
                if res.len == 0 {
                    innerErrors ~= VariableCreation::createLocalVarError (context, loc, m, right.name.str);                    
                }
            }
        }

        if all.len != 0 {
            {
                let m = VariableValidation::validateMultSymbols (alias context, loc, alias all);
                return m?;
            } catch {
                err => {
                    errors ~= [err];
                    return none;
                }
            }
        }

        errors ~= innerErrors;
        return none;
    }
}
