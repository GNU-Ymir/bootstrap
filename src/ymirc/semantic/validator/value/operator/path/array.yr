in array;

use ymirc::lexing::{word, tokens, keys};
use ymirc::syntax::expression::_;

use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::global::core_;
use ymirc::errors::_;
use ymirc::utils::{format, string};

use ymirc::semantic::validator::value::operator::path::_;

/**
 * ArrayStaticFieldValidation
 *
 * Provides semantic validation for static field access on array types.
 *
 * Static array fields are accessed using the path operator:
 *
 *      ArrayType :: field
 *
 * Supported fields:
 *   - INIT — constructs a static array initializer
 *   - LEN  — returns the compile-time array length
 *
 * The validator:
 *   - strips leading underscores from the field name
 *   - matches the field against known static attributes
 *   - delegates INIT to PathTypeValidation for element initialization
 *   - constructs ArrayAllocValue for static allocation
 *   - returns IntValue for LEN
 *
 */
pub mod ArrayStaticFieldValidation {

    /**
     * Validate static field access on an array type.
     *
     * Supported fields:
     *
     *   1. INIT
     *        - Delegates to PathTypeValidation::validate() to validate the
     *          element initializer expression.
     *        - Produces an ArrayAllocValue::stat representing a statically
     *          allocated array with:
     *              - the array type
     *              - the validated initializer
     *              - the compile-time length as an IntValue
     *
     *   2. LEN
     *        - Returns the compile-time array length as:
     *              IntValue(loc, usize, a.len)
     *
     * Behavior:
     *   - Only VarExpr fields are supported.
     *   - Leading underscores are stripped before matching.
     *   - If the field name does not match a known static attribute,
     *     a fatal UNDEFINED_BIN_ACC_OP error is produced.
     *
     * @params:
     *   - context: validation context
     *   - loc:     operator location
     *   - a:       ArrayType on the left side of `::`
     *   - right:   field expression on the right side of `::`
     *
     * @returns:
     *   A &Value representing the validated static array attribute.
     *
     * @throws:
     *   ErrorMsg if the field is unknown or validation fails.
     */
    pub fn validate(dmut context: &ValidationContext, loc: &Word, a: &ArrayType, right: &Expression)-> &Value
        throws ErrorMsg
    {
        if let var: &VarExpr = right {
            match string::stripUnders(var.name.str) {
                NativeTypeAttribute::INIT => {
                    let val = PathTypeValidation::validate(alias context, loc, a.value, right);
                    return copy ArrayAllocValue::stat(loc, a, val, copy IntValue(loc, USIZE_TYPE, a.len));
                }
                SliceKeys::LEN => {
                    return copy IntValue(loc, USIZE_TYPE, a.len);
                }
            }
        }

        throw copy ErrorMsg::fatal(loc,
                                   format(ValidateErrorMessage::UNDEFINED_BIN_ACC_OP, BinaryOperators::DCOLON, a, right));
    }

}
