 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in float;

use ymirc::lexing::{word, tokens, keys};
use ymirc::syntax::expression::_;

use ymirc::semantic::{validator, interpret};
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::global::core_;
use ymirc::errors::_;
use ymirc::utils::{format, string, bigint};


/**
 * FloatStaticFieldValidation
 *
 * Provides semantic validation for static field access on floating-point types.
 *
 * Static float fields are accessed using the path operator:
 *
 *      Float :: field
 *
 * Supported fields correspond to IEEE-754 metadata and constants:
 *   - INIT       — default NaN initializer
 *   - MAX        — maximum finite value
 *   - MIN        — minimum finite value
 *   - NAN        — quiet NaN
 *   - INF        — positive infinity
 *   - DIG        — number of base-10 significant digits
 *   - MANT_DIG   — number of bits in the mantissa
 *   - MAX_10_EXP — maximum base-10 exponent
 *   - MIN_10_EXP — minimum base-10 exponent
 *   - MAX_EXP    — maximum base-2 exponent
 *   - MIN_EXP    — minimum base-2 exponent
 *   - EPSILON    — machine epsilon
 *
 * The validator:
 *   - strips leading underscores from the field name
 *   - matches the field against known static attributes
 *   - constructs FloatValue or IntValue using FloatInterpret helpers
 *
 */
pub mod FloatStaticFieldValidation {

    /**
     * Validate static field access on a floating-point type.
     *
     * @params:
     *   - loc:   operator location
     *   - f:     FloatType on the left side of `::`
     *   - right: field expression on the right side of `::`
     *
     * @returns:
     *   A &Value representing the validated static float attribute.
     *
     * @throws:
     *   ErrorMsg if the field is unknown or validation fails.
     */
    pub fn validate(loc: &Word, f: &FloatType, right: &Expression)-> &Value
        throws ErrorMsg
    {
        if let var: &VarExpr = right {
            match string::stripUnders(var.name.str) {
                NativeTypeAttribute::INIT => {
                    return copy FloatValue(loc, f, FloatInterpret::createFloatNanValue(f));
                }
                NativeTypeAttribute::MAX => {
                    return copy FloatValue(loc, f, FloatInterpret::createFloatMaxValue(f));
                }
                NativeTypeAttribute::MIN => {
                    return copy FloatValue(loc, f, FloatInterpret::createFloatMinValue(f));
                }
                NativeTypeAttribute::NAN => {
                    return copy FloatValue(loc, f, FloatInterpret::createFloatNanValue(f));
                }
                NativeTypeAttribute::INF => {
                    return copy FloatValue(loc, f, FloatInterpret::createFloatInfValue(f));
                }
                NativeTypeAttribute::DIG => {
                    return copy IntValue(loc, U32_TYPE, FloatInterpret::createFloatDigValue(f));
                }
                NativeTypeAttribute::MANT_DIG => {
                    return copy IntValue(loc, U32_TYPE, FloatInterpret::createFloatMantDigValue(f));
                }
                NativeTypeAttribute::MAX_10_EXP => {
                    return copy IntValue(loc, I32_TYPE, FloatInterpret::createFloatMax10ExpValue(f));
                }
                NativeTypeAttribute::MIN_10_EXP => {
                    return copy IntValue(loc, I32_TYPE, copy BigInt(FloatInterpret::createFloatMin10ExpValue(f)));
                }
                NativeTypeAttribute::MAX_EXP => {
                    return copy IntValue(loc, I32_TYPE, FloatInterpret::createFloatMax2ExpValue(f));
                }
                NativeTypeAttribute::MIN_EXP => {
                    return copy IntValue(loc, I32_TYPE, copy BigInt(FloatInterpret::createFloatMin2ExpValue(f)));
                }
                NativeTypeAttribute::EPSILON => {
                    return copy FloatValue(loc, f, FloatInterpret::createFloatEpsilonValue(f));
                }
            }
        }

        throw copy ErrorMsg::fatal(loc,
                                   format(ValidateErrorMessage::UNDEFINED_BIN_ACC_OP, BinaryOperators::DCOLON, f, right));
    }

}
