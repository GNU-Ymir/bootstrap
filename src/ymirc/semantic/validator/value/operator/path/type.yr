in type;

use ymirc::lexing::{word, keys};
use ymirc::semantic::{validator, symbol};

use ymirc::syntax::{_, declaration::_, expression::_};
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::errors::message;
use ymirc::utils::format;


use ymirc::semantic::validator::value::operator::path::_;

/**
 * PathTypeValidation
 *
 * Root dispatcher for type-scoped path access:
 *
 *      Type :: field
 *
 * This module determines which static attribute validator to invoke based
 * on the concrete type of the left operand. It supports:
 *
 *   - Primitive types (Int, Float, Bool, Char)
 *   - Composite types (Pointer, Slice, Option, Map, Tuple, Range, Array)
 *   - User-defined types (ClassRefType, ClassPtrType, EnumType)
 *
 * If a type-specific validator throws an error, the dispatcher attempts
 * fallback resolution for built-in meta-attributes:
 *
 *   - TYPEID     => string representation of the type
 *   - TYPEINFO   => reflection metadata for the type
 *   - FIELDINFO  => reflection metadata for fields
 *   - SIZEOF     => compile-time size of the type
 *
 * If fallback resolution also fails, the original error is rethrown with
 * additional diagnostic notes.
 *
 * This module defines the complete semantics of type-based path access.
 */

pub mod PathTypeValidation {

    /**
     * Multi-result variant of type-scoped path validation.         
     *
     * @params:
     *   - context: validation context
     *   - loc:     operator location
     *   - left:    Type on the left side of `::`
     *   - right:   field expression
     *   - values:  output array of successful resolutions
     *   - errors:  output array of errors
     *
     */
    pub fn validate (dmut context:   &ValidationContext,
                     loc:            &Word,
                     left:           &Type,
                     right:          &Expression,
                     ref mut values: [&Value],
                     ref mut errors: [&ErrorMsg])
    {
        {
            let inVal = PathTypeValidation::validate (alias context, loc, left, right);
            if let m: &MultSymValue = inVal {
                for v in m.values {
                    values ~= [v];
                }
            } else {
                values ~= [inVal];
            }
        } catch {
            err => {
                errors ~= [err];
            }
        }
    }

    /**
     * Validate type-scoped path access for a single result.
     *     
     * @params:
     *   - context: validation context
     *   - loc:     operator location
     *   - left:    Type on the left side of `::`
     *   - right:   field expression on the right side of `::`
     *
     * @returns:
     *   A &Value representing the resolved static attribute.
     *
     * @throws:
     *   ErrorMsg if no valid resolution exists.
     */
    pub fn validate (dmut context: &ValidationContext,
                     loc:          &Word,
                     left:         &Type,
                     right:        &Expression)-> &Value
        throws ErrorMsg
    {
        {
            match left {
                f: &FloatType => {
                    return FloatStaticFieldValidation::validate (loc, f, right);
                }
                i: &IntType => {
                    return IntStaticFieldValidation::validate (loc, i, right);
                }
                b: &BoolType => {
                    return BoolStaticFieldValidation::validate (loc, b, right);
                }
                c: &CharType => {
                    return CharStaticFieldValidation::validate (loc, c, right);
                }
                p: &PointerType => {
                    return PointerStaticFieldValidation::validate (loc, p, right);
                }
                s: &SliceType => {
                    return SliceStaticFieldValidation::validate (loc, s, right);
                }
                o: &OptionType => {
                    return OptionStaticFieldValidation::validate (loc, o, right);
                }
                m: &MapType => {
                    return MapStaticFieldValidation::validate (loc, m, right);
                }
                c: &ClassRefType => {
                    return ClassStaticFieldValidation::validate (alias context, loc, c, right);
                }
                c: &ClassPtrType => {
                    return ClassStaticFieldValidation::validate (alias context, loc, c, right);
                }
                e: &EnumType => {
                    return EnumStaticFieldValidation::validate (alias context, loc, e, right);
                }
                t: &TupleType => {
                    return TupleStaticFieldValidation::validate (alias context, loc, t, right);
                }
                r: &RangeType => {
                    return RangeStaticFieldValidation::validate (alias context, loc, r, right);
                }
                a: &ArrayType => {
                    return ArrayStaticFieldValidation::validate (alias context, loc, a, right);
                }                
                _ => {
                    throw copy ErrorMsg::fatal (loc, format (ValidateErrorMessage::UNDEFINED_BIN_ACC_OP, loc.str, left, right));
                }
            }
        } catch {
            err => {
                if let v: &VarExpr = right {
                    return PathTypeValidation::validateBasic (alias context, loc, left, v.name.str, err);
                }

                throw err;
            }
        }
    }

    /**
     * Fallback validator for built-in type meta-attributes.
     *
     * This function is invoked only when:
     *   - a type-specific static field validator fails, AND
     *   - the right operand is a VarExpr.
     *
     * Supported fallback attributes:
     *
     *   TYPEID
     *     - Returns a StringValue containing the formatted type name.
     *
     *   TYPEINFO
     *     - Returns reflection metadata for the type.
     *
     *   FIELDINFO
     *     - Returns reflection metadata for the type’s fields.
     *
     *   SIZEOF
     *     - Returns the compile-time size of the type.
     *
     * @params:
     *   - context: validation context
     *   - loc:     operator location
     *   - left:    Type being queried
     *   - right:   field name (string)
     *   - err:     original error from the type-specific validator
     *
     * @returns:
     *   A &Value representing the resolved meta-attribute.
     *
     * @throws:
     *   ErrorMsg enriched with fallback error notes.
     */
    fn validateBasic (dmut context: &ValidationContext,
                      loc:          &Word,
                      left:         &Type,
                      right:        [c8],
                      err:          &ErrorMsg)-> &Value
        throws ErrorMsg
    {
        {
            match string::stripUnders (right) {
                Keys::TYPEID => {
                    let content = format ("%", left);
                    return copy StringValue (loc, content);
                }
                Keys::TYPEINFO => {
                    return TypeInfo::validate (alias context, loc, left);
                }
                Keys::FIELDINFO => {
                    return TypeInfo::validateFieldInfos (alias context, loc, left);
                }
                Keys::SIZEOF => {
                    return TypeSize::validate (alias context, loc, left);
                }
            }
        } catch {
            innerErr => {
                throw err.withNote (notes-> copy [innerErr]);
            }
        }

        throw err;
    }    

    
}
