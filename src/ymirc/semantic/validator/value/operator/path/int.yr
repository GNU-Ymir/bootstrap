in int;

use ymirc::lexing::{word, tokens, keys};
use ymirc::syntax::expression::_;

use ymirc::semantic::{validator, interpret};
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::global::core_;
use ymirc::errors::_;
use ymirc::utils::{format, string};

/**
 * IntStaticFieldValidation
 *
 * Provides semantic validation for static field access on integer types.
 *
 * Static integer fields are accessed using the path operator:
 *
 *      Int :: field
 *
 * Supported fields:
 *   - INIT — returns the default integer value(0)
 *   - MAX  — returns the maximum representable value for the type
 *   - MIN  — returns the minimum representable value for the type
 *
 * The validator:
 *   - strips leading underscores from the field name
 *   - matches the field against known static attributes
 *   - constructs IntValue using IntInterpret helpers
 *
 */
pub mod IntStaticFieldValidation {

    /**
     * Validate static field access on an integer type.
     *
     * @params:
     *   - loc:   operator location
     *   - i:     IntType on the left side of `::`
     *   - right: field expression on the right side of `::`
     *
     * @returns:
     *   A &Value representing the validated static integer attribute.
     *
     * @throws:
     *   ErrorMsg if the field is unknown or validation fails.
     */
    pub fn validate(loc: &Word, i: &IntType, right: &Expression)-> &Value
        throws ErrorMsg
    {
        if let var: &VarExpr = right {
            match string::stripUnders(var.name.str) {
                NativeTypeAttribute::INIT => {
                    return copy IntValue(loc, i, 0us);
                }
                NativeTypeAttribute::MAX => {
                    return copy IntValue(loc, i, IntInterpret::createIntMaxValue(i));
                }
                NativeTypeAttribute::MIN => {
                    return copy IntValue(loc, i, IntInterpret::createIntMinValue(i));
                }
            }
        }

        throw copy ErrorMsg::fatal(loc,
                                   format(ValidateErrorMessage::UNDEFINED_BIN_ACC_OP, BinaryOperators::DCOLON, i, right));
    }

}
