in option;

use ymirc::lexing::{word, tokens, keys};
use ymirc::syntax::expression::_;

use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::global::core_;
use ymirc::errors::_;
use ymirc::utils::{format, string};


/**
 * OptionStaticFieldValidation
 *
 * Provides semantic validation for static field access on option types.
 *
 * Static option fields are accessed using the path operator:
 *
 *      Option :: field
 *
 * Supported fields:
 *   - INIT — returns an empty option(unset, no value)
 *
 * The validator:
 *   - strips leading underscores from the field name
 *   - matches the field against known static attributes
 *   - constructs an ErrOptionValue representing an empty option
 *
 */
pub mod OptionStaticFieldValidation {

    /**
     * Validate static field access on an option type.
     *
     * @params:
     *   - loc:   operator location
     *   - o:     OptionType on the left side of `::`
     *   - right: field expression on the right side of `::`
     *
     * @returns:
     *   A &Value representing an empty option initializer.
     *
     * @throws:
     *   ErrorMsg if the field is unknown or validation fails.
     */
    pub fn validate(loc: &Word, o: &OptionType, right: &Expression)-> &Value
        throws ErrorMsg
    {
        if let var: &VarExpr = right {
            match string::stripUnders(var.name.str) {
                NativeTypeAttribute::INIT => {
                    return copy ErrOptionValue(loc, type-> o);
                }
            }
        }

        throw copy ErrorMsg::fatal(loc,
                                   format(ValidateErrorMessage::UNDEFINED_BIN_ACC_OP, BinaryOperators::DCOLON, o, right));
    }

}
