 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in enum_;

use ymirc::lexing::{word, tokens, keys};
use ymirc::syntax::expression::_;

use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::global::core_;
use ymirc::errors;
use ymirc::utils::{format, string};

/**
 * EnumStaticFieldValidation
 *
 * Provides semantic validation for static field access on enum types.
 *
 * Static enum fields are accessed using the path operator:
 *
 *      Enum :: field
 *
 * Supported fields:
 *   - VariantName — returns the corresponding enum variant value
 *   - MEMBERS     — returns an array containing all enum variants
 *   - NAMES       — returns an array containing all enum variants names
 *
 * The validator:
 *   - first attempts to resolve the field as a variant name
 *   - if that fails, checks for the MEMBERS attribute
 *   - constructs EnumFieldAccessValue for variants
 *   - constructs an ArrayValue of all variants for MEMBERS
 *
 */
pub mod EnumStaticFieldValidation {

    /**
     * Validate static field access on an enum type.
     *
     * @params:
     *   - context: validation context
     *   - loc:     operator location
     *   - en:      EnumType on the left side of `::`
     *   - right:   field expression on the right side of `::`
     *
     * @returns:
     *   A &Value representing either a variant or the MEMBERS array.
     *
     * @throws:
     *   ErrorMsg if the field is neither a variant nor MEMBERS.
     */
    pub fn validate(dmut context: &ValidationContext, loc: &Word, en: &EnumType, right: &Expression)-> &Value
        throws ErrorMsg
    {
        if let var: &VarExpr = right {
            if let Ok(v) = EnumStaticFieldValidation::validate(loc, en, var.name.str) {
                return v;
            }

            let basic = string::stripUnders(var.name.str);
            match basic {
                EnumKeys::MEMBERS => {
                    return EnumStaticFieldValidation::validateMembers(alias context, loc, en);
                }
                EnumKeys::NAMES => {
                    return EnumStaticFieldValidation::validateNames(alias context, loc, en);
                }
            }
        }

        throw copy ErrorMsg::fatal(loc,
                                   format(ValidateErrorMessage::UNDEFINED_BIN_ACC_OP, BinaryOperators::DCOLON, en, right));
    }

    /**
     * Validate access to a specific enum variant by name.
     *
     * Example:
     *      Color :: Red
     *
     * @params:
     *   - loc:   operator location
     *   - en:    EnumType being accessed
     *   - field: variant name
     *
     * @returns:
     *   A &Value representing the enum variant.
     *
     */
    pub fn validate(loc: &Word, en: &EnumType, field: [c8])-> ((&Value)?)
    {
        if let val: &Value = en.sym.field(field) && val !of UnitValue {
            return (copy EnumFieldAccessValue(loc, en, value-> val.clone(), name-> field))?;
        }

        return none;
    }

    /**
     * Construct an array containing all enum variants.
     *
     * This corresponds to the static attribute:
     *
     *      Enum :: MEMBERS
     *
     * @params:
     *   - context: validation context
     *   - loc:     operator location
     *   - en:      EnumType whose variants are enumerated
     *
     * @returns:
     *   A &Value representing an array of all enum variants.
     *
     * @throws:
     *   ErrorMsg if array construction fails(should not occur in practice).
     */
    fn validateMembers(dmut context: &ValidationContext, loc: &Word, en: &EnumType)-> &Value
        throws ErrorMsg
    {
        let mut params: [&Value] = [];
        let mut inner: &Type = en;

        for f in en.sym.fields {
            let val = copy EnumFieldAccessValue(loc, en, value-> f._1.clone(), name-> f._0);
            inner = SliceComposeValidation::addArrayType(alias context, val, inner, ref params);
        }

        let arrType = copy ArrayType(loc, inner, params.len, isMutable-> true);
        return copy ArrayValue(loc, arrType, params);
    }

    /**
     * Construct an array containing all enum names.
     *
     * This corresponds to the static attribute:
     *
     *      Enum :: NAMES
     *
     * @params:
     *   - context: validation context
     *   - loc:     operator location
     *   - en:      EnumType whose variants are enumerated
     *
     * @returns:
     *   A &Value representing an array of all enum variants.
     *
     * @throws:
     *   ErrorMsg if array construction fails(should not occur in practice).
     */
    fn validateNames(dmut context: &ValidationContext, loc: &Word, en: &EnumType)-> &Value
        throws ErrorMsg
    {
        let mut params: [&Value] = [];
        let mut inner: &Type = UTF8_TYPE;

        for f in en.sym.fields {
            let val = copy StringValue(loc, f._0);
            inner = SliceComposeValidation::addArrayType(alias context, val, inner, ref params);
        }

        let arrType = copy ArrayType(loc, inner, params.len, isMutable-> true);
        return copy ArrayValue(loc, arrType, params);
    }

}
