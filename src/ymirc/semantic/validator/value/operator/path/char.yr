in char;

use ymirc::lexing::{word, tokens, keys};
use ymirc::syntax::expression::_;

use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::global::core_;
use ymirc::errors::_;
use ymirc::utils::{format, string};


/**
 * CharStaticFieldValidation
 *
 * Provides semantic validation for static field access on the character type.
 *
 * Static character fields are accessed using the path operator:
 *
 *      Char :: field
 *
 * Supported fields:
 *   - INIT — returns the default character value ('\0')
 *
 * The validator:
 *   - strips leading underscores from the field name
 *   - matches the field against known static attributes
 *   - constructs a CharValue for INIT
 * 
 */
pub mod CharStaticFieldValidation {

    /**
     * Validate static field access on the character type.
     *
     * Supported field:
     *
     *   INIT
     *     - Returns the default character initializer:
     *           CharValue(loc, c, 0u32)
     *       which corresponds to the null character ('\0').     
     *
     * @params:
     *   - loc:   operator location
     *   - c:     CharType on the left side of `::`
     *   - right: field expression on the right side of `::`
     *
     * @returns:
     *   A &Value representing the validated static character attribute.
     *
     * @throws:
     *   ErrorMsg if the field is unknown or validation fails.
     */
    pub fn validate (loc: &Word, c: &CharType, right: &Expression)-> &Value
        throws ErrorMsg
    {        
        if let var: &VarExpr = right {
            match string::stripUnders (var.name.str) {
                NativeTypeAttribute::INIT => {
                    return copy CharValue (loc, c, 0u32);
                }
            }
        }
        
        throw copy ErrorMsg::fatal (loc,
                                    format (ValidateErrorMessage::UNDEFINED_BIN_ACC_OP, BinaryOperators::DCOLON, c, right));
    }
    
}
