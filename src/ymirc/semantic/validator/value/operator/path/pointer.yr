in pointer;

use ymirc::lexing::{word, tokens, keys};
use ymirc::syntax::expression::_;

use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::global::core_;
use ymirc::errors;
use ymirc::utils::{format, string};


/**
 * PointerStaticFieldValidation
 *
 * Provides semantic validation for static field access on pointer types.
 *
 * Static pointer fields are accessed using the path operator:
 *
 *      Ptr :: field
 *
 * Supported fields:
 *   - INIT — returns a null pointer value
 *
 */
pub mod PointerStaticFieldValidation {

    /**
     * Validate static field access on a pointer type.
     *
     * Supported field:
     *
     *   INIT
     *
     * @params:
     *   - loc:   operator location
     *   - p:     PointerType on the left side of `::`
     *   - right: field expression on the right side of `::`
     *
     * @returns:
     *   A &Value representing a null pointer initializer.
     *
     * @throws:
     *   ErrorMsg if the field is unknown or validation fails.
     */
    pub fn validate(loc: &Word, p: &PointerType, right: &Expression)-> &Value
        throws ErrorMsg
    {
        if let var: &VarExpr = right {
            match string::stripUnders(var.name.str) {
                NativeTypeAttribute::INIT => { return copy NullValue(loc, p); }
            }
        }

        throw copy ErrorMsg::fatal(loc,
                                   format(ValidateErrorMessage::UNDEFINED_BIN_ACC_OP, BinaryOperators::DCOLON, p, right));
    }

}
