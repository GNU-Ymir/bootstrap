in slice;

use ymirc::lexing::{word, tokens, keys};
use ymirc::syntax::expression::_;

use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::global::core_;
use ymirc::errors::_;
use ymirc::utils::{format, string};

/**
 * SliceStaticFieldValidation
 *
 * Provides semantic validation for static field access on slice types.
 *
 * Static slice fields are accessed using the path operator:
 *
 *      Slice :: field 
 *
 * The validator:
 *   - strips leading underscores from the field name
 *   - matches the field against known static attributes
 *   - constructs a SliceCtorValue representing an empty slice
 */
pub mod SliceStaticFieldValidation {

    /**
     * Validate static field access on a slice type.    
     *
     * @params:
     *   - loc:   operator location
     *   - s:     SliceType on the left side of `::`
     *   - right: field expression on the right side of `::`
     *
     * @returns:
     *   A &Value representing an empty slice initializer.
     *
     * @throws:
     *   ErrorMsg if the field is unknown or validation fails.
     */
    pub fn validate (loc: &Word, s: &SliceType, right: &Expression)-> &Value
        throws ErrorMsg
    {
        if let var: &VarExpr = right {
            match string::stripUnders (var.name.str) {
                NativeTypeAttribute::INIT => {
                    let n = copy NullValue (loc);
                    return copy SliceCtorValue (loc,
                                                type-> s,
                                                ptr-> n,
                                                blk-> n,
                                                len-> copy IntValue (loc, USIZE_TYPE, 0),
                                                isImplicitAlias-> true,
                                                isReduced-> true);
                }
            }
        }        

        throw copy ErrorMsg::fatal (loc,
                                    format (ValidateErrorMessage::UNDEFINED_BIN_ACC_OP, BinaryOperators::DCOLON, s, right));
    }
    
}
