 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in range;

use ymirc::lexing::{word, tokens, keys};
use ymirc::syntax::expression::_;

use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::global::core_;
use ymirc::errors;
use ymirc::utils::{format, string};

use ymirc::semantic::validator::value::operator::path::_;

/**
 * RangeStaticFieldValidation
 *
 * Provides semantic validation for static field access on range types.
 *
 * Static range fields are accessed using the path operator:
 *
 *      Range :: field
 *
 * Supported fields:
 *   - INIT — returns a degenerate range whose start and end are equal
 *
 * The validator:
 *   - strips leading underscores from the field name
 *   - matches the field against known static attributes
 *   - validates the default initializer of the range’s start type
 *   - constructs a degenerate range using the `..` operator
 *
 */
pub mod RangeStaticFieldValidation {

    /**
     * Validate static field access on a range type.
     *
     * @params:
     *   - context: validation context
     *   - loc:     operator location
     *   - r:       RangeType on the left side of `::`
     *   - right:   field expression on the right side of `::`
     *
     * @returns:
     *   A &Value representing a degenerate range initializer.
     *
     * @throws:
     *   ErrorMsg if the field is unknown or validation fails.
     */
    pub fn validate(dmut context: &ValidationContext, loc: &Word, r: &RangeType, right: &Expression)-> &Value
        throws ErrorMsg
    {
        if let var: &VarExpr = right {
            match string::stripUnders(var.name.str) {
                NativeTypeAttribute::INIT => {
                    let val = PathTypeValidation::validate(alias context, loc, r.start, right);
                    return BinaryRangeValidation::validate(alias context, loc, BinaryOperators::DDOT, val, val);
                }
            }
        }

        throw copy ErrorMsg::fatal(loc,
                                   format(ValidateErrorMessage::UNDEFINED_BIN_ACC_OP, BinaryOperators::DCOLON, r, right));
    }

}
