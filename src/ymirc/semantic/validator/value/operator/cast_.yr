 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in cast_;

use ymirc::syntax::{_, declaration::_, expression::_};

use ymirc::semantic::{declarator, validator, template_, symbol};
use ymirc::semantic::generator::{value::_, type::_};
use ymirc::semantic::generator::_;

use ymirc::global::core_;
use ymirc::errors;
use ymirc::utils::format;

use ymirc::lexing::{word, tokens, keys};

use std::{io, stream, time::_};

use ymirc::semantic::validator::value::operator::cast_::_;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

mod ::implicit;
mod ::explicit;


/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          ROOT          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * CastValidation module
 *
 * Provides the unified entry points for validating cast expressions.
 *
 */
pub mod CastValidation {

    /**
     * Validate a cast expression(`CastExpr`).
     *
     * @params:
     *   - context: validation context used for expression and type validation
     *   - c:       CastExpr containing the value and target type
     *
     * @returns:
     *   - &Value: rewritten value after cast validation
     *
     * @throws:
     *   - any error produced by explicit or implicit cast validation
     */
    pub fn validate(dmut context: &ValidationContext, c: &CastExpr)-> &Value
        throws ErrorMsg
    {
        let value = ValueValidation::validate(alias context, c.value);
        let type = TypeValidation::validate(alias context, c.type);

        return CastValidation::validate(alias context, c.loc, value, type);
    }

    /**
     * Validate a cast from a value to a target type.
     *
     * @params:
     *   - context: validation context used for cast validation
     *   - loc:     source location of the cast
     *   - value:   value to cast
     *   - type:    target type
     *
     * @returns:
     *   - &Value: rewritten value after explicit or implicit cast
     *
     * @throws:
     *   - explicit-cast error if both explicit and implicit casts fail
     */
    pub fn validate(dmut context: &ValidationContext, loc: &Word, value: &Value, type: &Type)-> &Value
        throws ErrorMsg
    {

        let error = match CastValidation::validateExplicit(alias context, loc, value, type)? {
            Ok(val: &Value) => { return val; }
            Err(error: &ErrorMsg) => {
                error
            }
            _ => panic;
        };

        {
            return CastValidation::validateImplicit(alias context, loc, value, type);
        } catch {
            _ => {
                throw error;
            }
        }
    }

    /**
     * Validate an implicit cast from a value to a target type.
     *
     * @params:
     *   - context: validation context used for implicit cast validation
     *   - loc:     source location of the cast
     *   - value:   value to implicitly cast
     *   - type:    target type
     *
     * @returns:
     *   - &Value: rewritten value after implicit cast
     *
     * @throws:
     *   - any error produced by implicit cast validation
     */
    pub fn validateImplicit(dmut context: &ValidationContext, loc: &Word, value: &Value, type: &Type)-> &Value
        throws ErrorMsg
    {
        return CastImplicitValidation::validate(alias context, loc, value, type);
    }

    /**
     * Validate an explicit cast from a value to a target type.
     *
     * @params:
     *   - context: validation context used for explicit cast validation
     *   - loc:     source location of the cast
     *   - value:   value to explicitly cast
     *   - type:    target type
     *
     * @returns:
     *   - &Value: rewritten value after explicit cast
     *
     * @throws:
     *   - any error produced by explicit cast validation
     */
    pub fn validateExplicit(dmut context: &ValidationContext, loc: &Word, value: &Value, type: &Type)-> &Value
        throws ErrorMsg
    {
        return CastExplicitValidation::validate(alias context, loc, value, type);
    }
}
