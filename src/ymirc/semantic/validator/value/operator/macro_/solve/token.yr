/*
 * Implements semantic validation and matching logic for macro token
 * expressions(`MacroTokenExpr`).
 *
 * A macro token represents a literal string that must match the beginning
 * of the input stream during macro solving. This module:
 *
 *   - extracts the literal token string via compile-time evaluation,
 *   - decodes it as UTF-8,
 *   - checks that the input stream begins with this token,
 *   - computes accurate error locations for mismatches,
 *   - returns a MacroMapper representing the consumed token,
 *   - returns the remaining unmatched portion of the input.
 *
 * This is one of the fundamental building blocks of the macro-solving
 * engine, used by rule matching, skip-pattern matching, and macro
 * expansion.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::value::operator::macro_::solve::token
 * @File: ymirc/semantic/validator/value/operator/macro_/solve/token.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-06-01
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in token;

use ymirc::lexing::word;
use ymirc::syntax::expression::_;
use ymirc::semantic::validator;
use ymirc::semantic::generator::value::_;

use ymirc::utils::format;
use ymirc::errors;
use ymirc::semantic::validator::value::operator::macro_::{_, solve::_};


/**
 * MacroTokenSolving module
 *
 * Provides the logic for matching a `MacroTokenExpr` against the beginning
 * of an input string during macro solving.
 *
 */
pub mod MacroTokenSolving {

    /**
     * Attempt to match a `MacroTokenExpr` against the beginning of an input
     * string.
     *
     * @params:
     *   - context: validation context
     *   - loc     : location of the macro token in source
     *   - mtok    : the macro token expression
     *   - str     : the current input substring to match
     *   - full    : the full original input string(for location computation)
     *
     * @returns:
     *   - (MacroMapper, [c8]) where:
     *        * MacroMapper contains the consumed token,
     *        * [c8] is the remaining unmatched input.
     *
     * @throws:
     *   - ErrorMsg::fatal if the token does not match the input prefix
     */
    pub fn solve(dmut context: &ValidationContext,
                 loc:          &Word,
                 mtok:         &MacroTokenExpr,
                 str:          [c8],
                 full:         MacroContent)-> (MacroMapper, [c8])
        throws ErrorMsg
    {
        let (size, strV) = context.cteInterpret:.computeString(ValueValidation::validate(alias context, mtok.str));
        let strCont = Utf::decode(size, strV);

        if (strCont.len > str.len) {
            let eLoc = full.computeLoc(loc, str);
            throw copy ErrorMsg::fatal(eLoc, format(ValidateErrorMessage::MACRO_DOES_NOT_MATCH, MacroSolvingUtils::shorten(str), mtok),
                                       end-> mtok.loc);
        }

        for i in 0us .. strCont.len {
            if strCont[i] != str[i] {
                let eLoc = full.computeLoc(loc, str[i .. $]);
                throw copy ErrorMsg::fatal(eLoc, format(ValidateErrorMessage::MACRO_DOES_NOT_MATCH, MacroSolvingUtils::shorten(str[i .. $]), mtok),
                                           end-> mtok.loc);
            }
        }

        let rest = str[strCont.len .. $];
        return (MacroMapper(strCont), rest);
    }
}
