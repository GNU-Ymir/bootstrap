/*
 * Implements solving logic for `MacroVarExpr`, the macro variable binding
 * construct used inside macro rules.
 *
 * A `MacroVarExpr` associates a name with the result of solving a sub-rule. The
 * bound value is inserted into the resulting MacroMapper so that later
 * rewriting stages(MacroRewriting, MacroEvaluation) can reference it.
 *
 * MacroVarSolving supports:
 *
 *   - binding a single match,
 *   - binding repeated matches(`*`, `+`),
 *   - binding lists of matches,
 *   - concatenating matched values into a single output stream,
 *   - inserting the bound variable into the mapper.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::value::operator::macro_::solve::var
 * @File: ymirc/semantic/validator/value/operator/macro_/solve/var.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-06-01
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in var;

use ymirc::lexing::{word, tokens};
use ymirc::syntax::expression::_;
use ymirc::semantic::validator;
use ymirc::semantic::generator::value::_;

use ymirc::errors;
use ymirc::semantic::validator::value::operator::macro_::{_, solve::_};

use std::stream;

/**
 * MacroVarSolving module
 *
 * Provides solving logic for variable-binding expressions inside macro
 * rules(`MacroVarExpr`).
 *
 */
pub mod MacroVarSolving {

    /**
     * Solve a variable-binding expression(`MacroVarExpr`).
     *
     * @params:
     *   - context    : validation context,
     *   - loc        : location of the variable expression,
     *   - msym       : macro reference being solved,
     *   - mva        : variable expression node,
     *   - str        : current input substring,
     *   - skips      : skip-pattern expression,
     *   - full       : full original input(MacroContent),
     *   - ruleIndex  : index of the rule being solved.
     *
     * @returns:
     *   - (MacroMapper, [c8]) representing the bound variable and remaining input.
     *
     * @throws:
     *   - ErrorMsg if the underlying rule fails to match.
     */
    pub fn solve(dmut context: &ValidationContext,
                 loc:          &Word,
                 msym:         &MacroRefValue,
                 mva:          &MacroVarExpr,
                 str:          [c8],
                 skips:        &Expression,
                 full:         MacroContent,
                 ruleIndex:    usize)-> (MacroMapper, [c8])
        throws ErrorMsg
    {
        let mut vec: [MacroMapper] = [];
        let mut rest = "";
        if let mlt: &MacroMultExpr = mva.rule {
            if (mlt.mult.str == Tokens::STAR) {
                let (v, r) = MacroMultSolving::solveRepeat(alias context, loc, msym, mlt, str, skips, full, ruleIndex);
                vec = v;
                rest = r;
            }

            else if (mlt.mult.str == Tokens::PLUS) {
                let (v, r) = MacroMultSolving::solveOneOrMore(alias context, loc, msym, mlt, str, skips, full, ruleIndex);
                vec = v;
                rest = r;
            }

            else if (mlt.mult.str == Tokens::INTEG) {
                // the list is empty when the optional part is absent, so that
                // '::__len' and 'for' loops see no element at all
                let (v, r) = MacroMultSolving::solveOneOrNoneList(alias context, loc, msym, mlt, str, skips, full, ruleIndex);
                vec = v;
                rest = r;
            }
            else {
                let (localMap, r) = MacroMultSolving::solve(alias context, loc, msym, mlt, str, skips, full, ruleIndex);
                vec = copy [localMap];
                rest = r;
            }
        }

        else {
            let (localMapper, r) = MacroExprSolving::solve(alias context, loc, msym, mva.rule, str, skips, full, ruleIndex);
            vec = copy [localMapper];
            rest = r;
        }

        let dmut stream = copy StringStream();
        for i in vec {
            stream:.write(i.value);
        }

        let mut res = MacroMapper(stream[]);
        res:.insert(mva.loc.str, vec);

        return (res, rest);
    }
}
