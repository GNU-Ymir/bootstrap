/*
 * Implements semantic solving for `MacroOrExpr`, the macro-level logical OR
 * operator used in macro rule patterns.
 *
 * A `MacroOrExpr` represents a pattern of the form:
 *
 *       <left> | <right>
 *
 * During macro solving, the engine attempts to match the input stream against
 * the left branch first. If it fails, it attempts the right branch. If both
 * fail, a combined error is produced with precise location information and
 * aggregated notes.
 *
 * This module is a core part of the macro-rewriting engine, enabling
 * alternative patterns inside macro rules.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::value::operator::macro_::solve::or
 * @File: ymirc/semantic/validator/value/operator/macro_/solve/or.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-06-01
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in or;

use ymirc::lexing::word;
use ymirc::syntax::expression::_;
use ymirc::semantic::validator;
use ymirc::semantic::generator::value::_;

use ymirc::utils::format;
use ymirc::errors::message;
use ymirc::semantic::validator::value::operator::macro_::{_, solve::_};

/**
 * MacroOrSolving module
 *
 * Provides solving logic for `MacroOrExpr`, the macro OR operator.
 *
 */
pub mod MacroOrSolving {
    /**
     * Attempt to solve a `MacroOrExpr` against the input string.
     *
     * @params:
     *   - context    : validation context
     *   - loc        : location of the OR expression
     *   - msym       : the macro reference being solved
     *   - mor        : the OR expression node
     *   - str        : the current input substring to match
     *   - skips      : skip‑pattern expression
     *   - full       : the full original input string
     *   - ruleIndex  : index of the rule being solved
     *
     * @returns:
     *   - (MacroMapper, [c8]) where:
     *        * MacroMapper is the mapper returned by the successful branch,
     *        * [c8] is the remaining unmatched input.
     *
     * @throws:
     *   - ErrorMsg::fatal if both branches fail to match
     */
    pub fn solve(dmut context: &ValidationContext,
                 loc:          &Word,
                 msym:         &MacroRefValue,
                 mor:          &MacroOrExpr,
                 str:          [c8],
                 skips:        &Expression,
                 full:         MacroContent,
                 ruleIndex:    usize)-> (MacroMapper, [c8])
        throws ErrorMsg
    {
        let mut errors: [&ErrorMsg] = [];
        {
            return MacroExprSolving::solve(alias context, loc, msym, mor.left, str, skips, full, ruleIndex);
        } catch {
            err => {
                errors ~= [err];
            }
        }

        {
            return MacroExprSolving::solve(alias context, loc, msym, mor.right, str, skips, full, ruleIndex);
        } catch {
            err => {
                errors ~= [err];
            }
        }

        let eLoc = full.computeLoc(loc, str);
        throw copy ErrorMsg::fatal(eLoc, end-> mor.loc,
                                   format(ValidateErrorMessage::MACRO_DOES_NOT_MATCH, MacroSolvingUtils::shorten(str), mor),
                                   notes-> errors);
    }
}
