in model;

use ymirc::lexing::word;

/**
 * MacroContent
 *
 * Fields:
 *   - content: [c8]
 *        The raw macro-call content.
 *
 *   - trim: usize
 *        The indentation offset to apply after each newline when computing
 *        synthetic source locations.
 *
 */
pub record MacroContent {

    pub {
        // The content of the macro call
        let content: [c8];

        // The trimming of the string parameter of the macro call
        let trim: usize;
    }

    pub self(content: [c8], trim: usize)
        with content = content
        , trim = trim
    {}

    /**
     * Compute a synthetic source location for macro-generated content.
     *
     * Used when a macro expands into a string or token sequence that does not
     * directly correspond to a single source location. This function:
     *
     *   - starts from the base location `loc`,
     *   - simulates scanning through `content`,
     *   - updates line/column counters,
     *   - stops before the trailing `end` sequence,
     *   - returns a new Word with updated line, column, and lineSeek.
     *
     * @returns:
     *   - a new Word representing the computed location
     */
    pub fn computeLoc(self, loc: &Word, end: [c8])-> &Word {
        let mut line = loc.line;
        let mut col = loc.col + 2u64; // "#{, #[, #("
        let mut lineSeek = loc.lineSeek;
        for i in 0us .. (self.content.len - end.len) {
            if (self.content[i] == '\n') {
                line += 1u64;
                lineSeek += cast!usize(col);
                col = cast!u64(self.trim);
            } else {
                col += 1u64;
            }
        }

        return loc.locate(end,
                          line-> line,
                          col-> col,
                          lineSeek-> lineSeek);
    }
}
