/*
 * Implements solving logic for `MacroMultExpr`, the macro repetition operator
 * used in Ymir macro rules.
 *
 * A `MacroMultExpr` represents one of the following repetition patterns:
 *
 *     (rule)*      zero or more
 *     (rule)+      one or more
 *     (rule)?      zero or one
 *     (rule)       explicit list of sub-rules
 *
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::value::operator::macro_::solve::mult
 * @File: ymirc/semantic/validator/value/operator/macro_/solve/mult.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-06-01
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in mult;

use ymirc::lexing::{word, tokens, keys};
use ymirc::syntax::expression::_;
use ymirc::semantic::validator;
use ymirc::semantic::generator::value::_;

use ymirc::utils::format;
use ymirc::errors;
use ymirc::semantic::validator::value::operator::macro_::{_, solve::_};

use std::stream;

/**
 * MacroMultSolving module
 *
 * Provides solving logic for macro repetition constructs(`MacroMultExpr`).
 *
 */
pub mod MacroMultSolving {
    /**
     * Dispatch solving based on the repetition operator:
     *
     *   - `?` (Tokens::INTEG) → solveOneOrNone()
     *   - `*` (Tokens::STAR)  → solveRepeat()
     *   - `+` (Tokens::PLUS)  → solveOneOrMore()
     *   - otherwise           → solveList()
     *
     * For `*` and `+`, the results of each repetition are concatenated into a
     * single MacroMapper by writing their `.value` fields into a StringStream.
     *
     * @returns:
     *   - (MacroMapper, [c8]) where:
     *        * MacroMapper contains the concatenated consumed tokens,
     *        * [c8] is the remaining unmatched input.
     *
     * @throws:
     *   - ErrorMsg if the repetition semantics require at least one match
     */
    pub fn solve(dmut context: &ValidationContext,
                 loc:          &Word,
                 msym:         &MacroRefValue,
                 mult:         &MacroMultExpr,
                 str:          [c8],
                 skips:        &Expression,
                 full:         MacroContent,
                 ruleIndex:    usize)-> (MacroMapper, [c8])
        throws ErrorMsg
    {

        if mult.mult.str == Tokens::INTEG {
            return MacroMultSolving::solveOneOrNone(alias context, loc, msym, mult, str, skips, full, ruleIndex);
        }

        if mult.mult.str == Tokens::STAR {
            let (vecs, rest) = MacroMultSolving::solveRepeat(alias context, loc, msym, mult, str, skips, full, ruleIndex);
            let dmut result = copy StringStream();
            for i in vecs {
                result:.write(i.value);
            }

            return (MacroMapper(result[]), rest);
        }

        if  mult.mult.str == Tokens::PLUS {
            let (vecs, rest) = MacroMultSolving::solveOneOrMore(alias context, loc, msym, mult, str, skips, full, ruleIndex);
            let dmut result = copy StringStream();
            for i in vecs {
                result:.write(i.value);
            }

            return (MacroMapper(result[]), rest);
        }

        return MacroMultSolving::solveList(alias context, loc, msym, mult, str, skips, full, ruleIndex);
    }

    /**
     * Solve a list of sub-rules in order.
     *
     * @returns:
     *   - (MacroMapper, [c8]) representing the merged results and remaining input.
     *
     * @throws:
     *   - ErrorMsg if any rule in the list fails to match
     */
    pub fn solveList(dmut context: &ValidationContext,
                     loc:          &Word,
                     msym:         &MacroRefValue,
                     mult:         &MacroMultExpr,
                     str:          [c8],
                     skips:        &Expression,
                     full:         MacroContent,
                     ruleIndex:    usize)-> (MacroMapper, [c8])
        throws ErrorMsg
    {
        let mut retMapper = MacroMapper("");
        let mut rest = str;

        for rule in mult.content {
            if let sk: &MacroMultExpr = skips {
                let (_, postSkip) = MacroMultSolving::solveRepeat(alias context, loc, msym, sk, rest, EMPTY_EXPR, full, ruleIndex);
                rest = postSkip;
            }

            let (localMapper, postRule) = MacroExprSolving::solve(alias context, loc, msym, rule, rest, skips, full, ruleIndex);
            retMapper:.merge(localMapper);

            rest = postRule;
        }

        return (retMapper, rest);
    }

    /**
     * Solve zero or more repetitions of a rule list.
     *
     * @returns:
     *   - ([MacroMapper], [c8])
     *
     * @throws:
     *   - never(errors are swallowed)
     */
    pub fn solveRepeat(dmut context: &ValidationContext,
                       loc:          &Word,
                       msym:         &MacroRefValue,
                       mult:         &MacroMultExpr,
                       str:          [c8],
                       skips:        &Expression,
                       full:         MacroContent,
                       ruleIndex:    usize)-> ([MacroMapper], [c8])
    {
        let mut res: [MacroMapper] = [];
        let mut rest = str;
        loop {
            {
                let (localMap, postRead) = MacroMultSolving::solveList(alias context, loc, msym, mult, rest, skips, full, ruleIndex);
                res ~= [localMap];
                rest = postRead;
            } catch { // repeat is not necessary, thus an error is not a real problem
                _ => { break; }
            }
        }

        return (res, rest);
    }

    /**
     * Solve one or more repetitions of a rule list.
     *
     * @returns:
     *   - ([MacroMapper], [c8])
     *
     * @throws:
     *   - ErrorMsg::fatal if no repetition matches
     */
    pub fn solveOneOrMore(dmut context: &ValidationContext,
                          loc:          &Word,
                          msym:         &MacroRefValue,
                          mult:         &MacroMultExpr,
                          str:          [c8],
                          skips:        &Expression,
                          full:         MacroContent,
                          ruleIndex:    usize)-> ([MacroMapper], [c8])
        throws ErrorMsg
    {
        let mut res: [MacroMapper] = [];
        let mut rest = str;
        let mut error: (&ErrorMsg)? = none;
        loop {
            {
                let (localMap, postRead) = MacroMultSolving::solveList(alias context, loc, msym, mult, rest, skips, full, ruleIndex);
                res ~= [localMap];
                rest = postRead;
            } catch { // repeat is not necessary, thus an error is not a real problem
                err => {
                    error = (err)?;
                    break;
                }
            }
        }

        if (res.len == 0) {
            let eLoc = full.computeLoc(loc, rest);
            if let Ok(x) = error {
                throw copy ErrorMsg::fatal(eLoc,
                                           end-> mult.loc,
                                           format(ValidateErrorMessage::MACRO_DOES_NOT_MATCH, MacroSolvingUtils::shorten(rest), mult),
                                           notes-> copy [x]);
            }

            throw copy ErrorMsg::fatal(eLoc,
                                       end-> mult.loc,
                                       format(ValidateErrorMessage::MACRO_DOES_NOT_MATCH, MacroSolvingUtils::shorten(rest), mult));
        }


        return (res, rest);
    }

    /**
     * Solve zero or one repetition of a rule list.
     *
     * @returns:
     *   - (MacroMapper, [c8])
     *
     * @throws:
     *   - never(failure is allowed)
     */
    pub fn solveOneOrNone(dmut context: &ValidationContext,
                          loc:          &Word,
                          msym:         &MacroRefValue,
                          mult:         &MacroMultExpr,
                          str:          [c8],
                          skips:        &Expression,
                          full:         MacroContent,
                          ruleIndex:    usize)-> (MacroMapper, [c8]) {
        {
            return MacroMultSolving::solveList(alias context, loc, msym, mult, str, skips, full, ruleIndex);
        } catch { // One or none, thus no problem if fail
            _ => {}
        }

        return (MacroMapper(""), str);
    }
}
