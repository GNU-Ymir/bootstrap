/*
 * Central dispatcher for solving macro rule expressions.
 *
 * A `MacroRuleExpr` is the root type for all macro-pattern constructs in
 * Ymir’s macro system. It includes:
 *
 *   - MacroMultExpr   (repetition: *, +, ?, list)
 *   - MacroOrExpr     (alternation: A | B)
 *   - MacroVarExpr    (variable capture)
 *   - MacroTokenExpr  (literal token match)
 *   - MacroIdentExpr  (identifier-based match)
 *
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::value::operator::macro_::solve::expr
 * @File: ymirc/semantic/validator/value/operator/macro_/solve/expr.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-06-01
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in expr;

use ymirc::lexing::word;
use ymirc::syntax::expression::_;
use ymirc::semantic::validator;
use ymirc::semantic::generator::value::_;

use ymirc::errors;
use ymirc::semantic::validator::value::operator::macro_::{_, solve::_};

/**
 * MacroExprSolving module
 *
 * Provides the central dispatch function for solving macro rule expressions.
 *
 */
pub mod MacroExprSolving {

    /**
     * Solve a macro rule expression by dispatching to the correct solver.
     *
     * @params:
     *   - context    : validation context
     *   - loc        : location of the rule in source
     *   - msym       : macro reference being solved
     *   - expr       : macro rule expression
     *   - str        : current input substring to match
     *   - skips      : skip-pattern expression
     *   - full       : full original input string
     *   - ruleIndex  : index of the rule being solved(for diagnostics)
     *
     * @returns:
     *   - (MacroMapper, [c8]) representing the matched content and remaining input
     *
     * @throws:
     *   - ErrorMsg if the delegated solver throws
     */
    pub fn solve(dmut context: &ValidationContext,
                 loc:          &Word,
                 msym:         &MacroRefValue,
                 expr:         &MacroRuleExpr,
                 str:          [c8],
                 skips:        &Expression,
                 full:         MacroContent,
                 ruleIndex:    usize)-> (MacroMapper, [c8])
        throws ErrorMsg
    {
        match expr {
            mlt: &MacroMultExpr => {
                return MacroMultSolving::solve(alias context, loc, msym, mlt, str, skips, full, ruleIndex);
            }
            mor: &MacroOrExpr => {
                return MacroOrSolving::solve(alias context, loc, msym, mor, str, skips, full, ruleIndex);
            }
            mva: &MacroVarExpr => {
                return MacroVarSolving::solve(alias context, loc, msym, mva, str, skips, full, ruleIndex);
            }
            mto: &MacroTokenExpr => {
                return MacroTokenSolving::solve(alias context, loc, mto, str, full);
            }
            mid: &MacroIdentExpr => {
                return MacroIdentSolving::solve(alias context, loc, msym, mid, str, full, ruleIndex);
            }
            rule: _ => {
                std::io::eprintln("??", rule.__typeinfo__.name);
                panic;
            }
        }
    }
}
