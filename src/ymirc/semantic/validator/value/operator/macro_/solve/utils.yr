in utils;

use ymirc::lexing::{word, tokens};
use ymirc::syntax::expression::_;
use ymirc::semantic::validator;

use ymirc::errors;

use std::algorithm::comparison;

/**
 * MacroSolvingUtils module
 *
 * Provides helper functions used during macro solving and macro rule
 * construction.
 *
 */
pub mod MacroSolvingUtils {

    /**
     * Construct a skip-pattern expression from the list of string literals
     * declared in a `skips(...)` clause.
     *
     * The literals are turned into macro tokens, or'ed together, and wrapped
     * inside a `*` multiplier, so that the result can be solved by
     * `MacroMultSolving::solveRepeat` in between every rule of a macro.
     *
     * @returns:
     *   - an Expression representing the skip pattern (EMPTY_EXPR if there is nothing to skip)
     *
     * @throws:
     *   - ErrorMsg if a token expression is invalid
     */
    pub fn createSkips(dmut context: &ValidationContext, skips: [&StringExpr])-> &Expression
        throws ErrorMsg
    {
        let mut next: &Expression = EMPTY_EXPR;
        for it in skips {
            ValueValidation::validate(alias context, it); // ensure the literal is a valid string
            let tok: &MacroRuleExpr = copy MacroTokenExpr(it.loc, it);

            match next {
                n: &MacroRuleExpr => { next = copy MacroOrExpr(it.loc, n, tok); }
                _ => { next = tok; }
            }
        }

        if let n: &MacroRuleExpr = next {
            return copy MacroMultExpr(n.loc,
                                      end-> n.loc,
                                      copy [n],
                                      mult-> n.loc.locate(Tokens::STAR));
        }

        return next;
    }

    /**
     * Compute the length of a string, ignoring the skip tokens (spaces, tabulations,
     * new lines) that are at its end.
     *
     * @returns:
     *   - the length of `str`, without its trailing skip tokens
     */
    pub fn trimEndSkips(str: [c8])-> usize {
        let mut end = str.len;
        while end > 0us {
            let isSkip = match str[end - 1us] {
                ' 'c8 | '\t'c8 | '\n'c8 | '\r'c8 => { true }
                _ => { false }
            };

            if !isSkip { break; }
            end -= 1us;
        }

        return end;
    }

    /**
     * Produce a shortened version of a string for diagnostics.
     *
     * Behavior:
     *   - returns at most the first 10 characters,
     *   - stops early if a newline is encountered,
     *   - appends `" ..."` when truncated.
     *
     * Used by:
     *   - macro error messages,
     *   - debugging output,
     *   - template and macro diagnostics.
     *
     * @returns:
     *   - a shortened[c8] slice
     */
    pub fn shorten(str: [c8])-> [c8] {
        let maxLen = min(str.len, 10us);

        let mut curr = maxLen;
        for i in 0us .. maxLen {
            if str[i] == '\n' {
                curr = i;
                break;
            }
        }

        if (curr != str.len) {
            return str[0 .. curr] ~ " ...";
        }

        return str;
    }
}
