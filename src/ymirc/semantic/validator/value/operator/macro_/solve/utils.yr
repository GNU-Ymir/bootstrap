in utils;

use ymirc::lexing::{word, tokens};
use ymirc::syntax::expression::_;
use ymirc::semantic::validator;

use ymirc::errors::_;

use std::algorithm::comparison;

/**
 * MacroSolvingUtils module
 *
 * Provides helper functions used during macro solving and macro rule
 * construction.
 *
 */
pub mod MacroSolvingUtils {

    /**
     * Construct a skip-pattern expression from a list of macro expressions.
     *
     * @returns:
     *   - an Expression representing the skip pattern
     *
     * @throws:
     *   - ErrorMsg if a token expression is invalid
     *   - panic if the pattern structure is inconsistent
     */
    pub fn createSkips(dmut context: &ValidationContext, skips: [&Expression])-> &Expression
        throws ErrorMsg
    {
        let mut next: &Expression = EMPTY_EXPR;
        for i, it in skips {
            if i == 0 { next = it; }
            else {
                match (next, it) {
                    (n: &MacroRuleExpr, p: &MacroTokenExpr) => {
                        ValueValidation::validate(alias context, p.str);
                        next = copy MacroOrExpr(it.loc, n, p);
                    }
                    _ => panic;
                }
            }
        }

        if let n: &MacroRuleExpr = next {
            return copy MacroMultExpr(n.loc,
                                      end-> n.loc,
                                      copy [n],
                                      mult-> next.loc.locate(Tokens::STAR));
        }

        return next;
    }

    /**
     * Produce a shortened version of a string for diagnostics.
     *
     * Behavior:
     *   - returns at most the first 10 characters,
     *   - stops early if a newline is encountered,
     *   - appends `" ..."` when truncated.
     *
     * Used by:
     *   - macro error messages,
     *   - debugging output,
     *   - template and macro diagnostics.
     *
     * @returns:
     *   - a shortened[c8] slice
     */
    pub fn shorten(str: [c8])-> [c8] {
        let maxLen = min(str.len, 10us);

        let mut curr = maxLen;
        for i in 0us .. maxLen {
            if str[i] == '\n' {
                curr = i;
                break;
            }
        }

        if (curr != str.len) {
            return str[0 .. curr] ~ " ...";
        }

        return str;
    }
}
