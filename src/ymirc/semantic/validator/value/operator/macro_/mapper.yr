/*
 * Represents a recursive mapping structure used during macro expansion.
 *
 * A MacroMapper stores:
 *   - the sequence of consumed tokens(as a byte array),
 *   - a mapping from string keys to lists of nested MacroMapper nodes.
 *
 * It is used by the macro-rewriting subsystem to:
 *   - accumulate consumed tokens during parsing,
 *   - associate keys with one or more mapper branches,
 *   - merge mapper trees,
 *   - retrieve mapped branches,
 *   - pretty-print the mapper structure for debugging.
 *
 * MacroMapper is a lightweight, purely structural container. It does not
 * perform macro expansion itself; it is used by the macro solver and rewriter
 * to represent intermediate mapping states.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::value::operator::macro_::mapper
 * @File: ymirc/semantic/validator/value/operator/macro_/mapper.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2024-09-02
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in mapper;

use std::stream;
use ymirc::syntax::expression::_;
use ymirc::errors::_;
use ymirc::utils::format;

/**
 * MacroMapper
 *
 * A recursive mapping node used to represent macro-rewriting state.
 *
 */
pub record MacroMapper {
    prv {
        // The content of the mapper
        let mut _consumed: [c8];

        // The content of the mapper
        let mut _mapping: [[c8] => mut[MacroMapper]] = copy [];
    }

    /**
     * Construct a MacroMapper with an initial consumed token sequence.
     *
     * @params:
     *   - consumed: the initial list of consumed characters.
     *
     */
    pub self (consumed: [c8])
        with _consumed = consumed
    {}

    /**
     * Insert a single MacroMapper under the given key.
     *
     * Behavior:
     *   - if the key already exists → append to the existing list,
     *   - otherwise → create a new list containing the content.
     *
     */
    pub fn insert(mut self, key: [c8], content: MacroMapper) {
        if let Ok(x) = self._mapping[key] {
            let r = x ~ [content];
            self._mapping[key] = r;
        } else {
            self._mapping[key] = copy [content];
        }
    }

    /**
     * Insert multiple MacroMapper nodes under the given key.
     *
     * Behavior:
     *   - if the key already exists → append the list,
     *   - otherwise → store the list directly.
     *
     * Used when merging or expanding macro branches.
     */
    pub fn insert(mut self, key: [c8], content: [MacroMapper]) {
        if let Ok(x) = self._mapping[key] {
            let r = x ~ content;
            self._mapping[key] = r;
        } else {
            self._mapping[key] = content;
        }
    }

    /**
     * Retrieve the list of MacroMapper nodes associated with a key.
     *
     * @returns:
     *   - Some([MacroMapper]) if the key exists,
     *   - None otherwise.
     *
     * Used by:
     *   - macro solver to follow mapping branches.
     */
    pub fn find(self, key: [c8])-> ([MacroMapper])? {
        return self._mapping[key];
    }

    /**
     * Return the consumed token sequence stored in this mapper.
     *
     * @returns:
     *   - the[c8] array representing consumed tokens.
     */
    @field
    pub fn value(self)-> [c8] {
        return self._consumed;
    }

    /**
     * Merge another MacroMapper into this one.
     *
     * Behavior:
     *   - for each key in `other`:
     *        * if replace == true → overwrite existing entries,
     *        * else → only insert keys not already present.
     *
     *   - append other's consumed tokens to this mapper's consumed tokens.
     *
     */
    pub fn merge(mut self, other: MacroMapper, replace: bool = false) {
        for k, v in other._mapping {
            if replace || k !in self._mapping {
                self._mapping[k] = v;
            }
        }

        self._consumed ~= other._consumed;
    }

    impl Formattable {

        /**
         * Pretty-print the mapper for debugging.
         *
         * Output format:
         *   [consumed] as { key => <mapper> , key => <mapper> , ... }
         *
         * Behavior:
         *   - prints consumed tokens,
         *   - prints each key and recursively formats its associated mappers.
         *
         * Used by:
         *   - debugging tools,
         *   - error messages involving macro rewriting.
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write("[", self._consumed, "]", " as {");
            let mut index = 0us;
            for i, j in self._mapping {
                if index != 0 {
                    stream:.write(", ");
                }

                stream:.write(i,  " => ");
                for z in j {
                    z.format(alias stream);
                }

                index += 1us;
            }

            stream:.write("}");
        }
    }
}
