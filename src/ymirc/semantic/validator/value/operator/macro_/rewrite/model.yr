 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in model;

use ymirc::semantic::validator::value::operator::macro_::_;
use std::stream;

lazy dmut __ID__ = copy [0us];
fn generateUniqID()-> usize {
    __ID__[0] += 1us;
    __ID__[0]
}


/**
 * MacroRewriteContext
 *
 * Holds the state required during macro rewriting.
 *
 */
pub class MacroRewriteContext {
    pub {
        // The variable mapping used for substitutions.
        let mapper: MacroMapper;

        // A unique identifier for this rewriting instance. Used by
        // built‑in macro variables such as __uid.
        let uid: usize;

        // The index of the macro rule being rewritten. Used by __index.
        let ruleIndex: usize;
    }

    prv {
        // Accumulates the rewritten output.
        let dmut _stream: &StringStream = copy StringStream();
    }

    /**
     * Construct a MacroRewriteContext.
     *
     * @params:
     *   - mapper     : the MacroMapper used for variable substitution,
     *   - ruleIndex  : index of the macro rule being rewritten.
     *
     */
    pub self(mapper: MacroMapper, ruleIndex: usize)
        with mapper = mapper
        , ruleIndex = ruleIndex
        , uid = generateUniqID()
    {}

    /**
     * Append a byte sequence to the rewritten output.
     *
     */
    pub fn write(mut self, value: [c8]) {
        self._stream:.write(value);
    }

    /**
     * Return the accumulated rewritten content.
     *
     * @returns:
     *   - [c8] containing the full expanded macro output.
     *
     */
    pub fn opIndex(self)-> [c8] {
        return self._stream[];
    }
}
