/*
 * Utility functions for reading tokens during macro rewriting.
 *
 * MacroReadingUtils provides a small, specialized parsing layer on top of
 * MacroLexer. It is used by MacroRewriting and MacroEvaluation to read:
 *
 *   - identifiers,
 *   - numeric literals,
 *   - optional tokens(`readIf`),
 *   - required tokens(`readToken`),
 *   - closing delimiters for macro constructs,
 *   - array indexing and sub-mapping operators.
 *
 * These utilities form the low-level parsing API for the macro rewriting
 * engine. They are intentionally strict and produce precise syntax errors when
 * unexpected tokens are encountered.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::value::operator::macro_::rewrite::read
 * @File: ymirc/semantic/validator/value/operator/macro_/rewrite/read.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-06-01
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in read;

use ymirc::lexing::_;
use ymirc::syntax::errors;

use ymirc::errors;

use ymirc::utils::format;

/**
 * MacroReadingUtils module
 *
 * Provides helper functions for reading tokens from MacroLexer during macro
 * rewriting and evaluation.
 *
 */
pub mod MacroReadingUtils {

    /**
     * Consume the skip tokens (spaces, tabulations, new lines) pointed by the lexer.
     *
     * @info: the MacroLexer keeps the skip tokens, as they are part of the content
     * that is rewritten verbatim, they are only ignored when reading the structural
     * part of a macro evaluation (e.g. `#(for i in x)`)
     */
    pub fn skipTokens(dmut lexer: &MacroLexer) {
        loop {
            let isSkip = match lexer.peek().str {
                SkipTokens::SPACE | SkipTokens::TAB |
                SkipTokens::RETURN | SkipTokens::RRETURN | SkipTokens::RRETURN_CMP => { true }
                _ => { false }
            };

            if !isSkip { break; }
            lexer:.next();
        }
    }

    /**
     * Read an identifier.
     *
     * @returns:
     *   - &Word representing the identifier.
     *
     * @throws:
     *   - ErrorMsg::fatal if the token is not a valid identifier.
     */
    pub fn readIdentifier(dmut lexer: &MacroLexer)-> &Word
        throws ErrorMsg
    {
        MacroReadingUtils::skipTokens(alias lexer);
        let ident = lexer:.next();
        if ident.isName {
            return ident;
        }

        if let str: &StringWord = ident && str.open == Tokens::BACK_QUOTE {
            return ident;
        }

        throw copy ErrorMsg::fatal(ident, format(SyntaxErrorMessage::UNEXPECTED, ident.str));
    }

    /**
     * Read a numeric literal.
     *
     * Supports:
     *   - standard numeric literals(`42`),
     *   - reverse indexing syntax(`$-n`), that stands for the index `len - n`:
     *        * `$-1` → last element,
     *        * `$-2` → second-to-last element,
     *        * `$-0` → out of the list, thus always an overflow.
     *
     * @returns:
     *   - usize index.
     *
     * @throws:
     *   - ErrorMsg::fatal for malformed literals or out-of-range indices.
     */
    pub fn readNumeric(dmut lexer: &MacroLexer, len: usize)-> usize
        throws ErrorMsg
    {
        MacroReadingUtils::skipTokens(alias lexer);
        let x = lexer:.next();
        if (x.isEof) {
            throw copy ErrorMsg::fatal(x, format(SyntaxErrorMessage::UNEXPECTED, x.str));
        }

        let mut value = x;
        let mut withDollar = false;
        if (x.str == Tokens::DOLLAR) {
            MacroReadingUtils::readToken(alias lexer, Tokens::MINUS);
            let postX = lexer:.next();
            if (postX.isEof) {
                throw copy ErrorMsg::fatal(postX, format(SyntaxErrorMessage::UNEXPECTED, postX.str));
            }

            withDollar = true;
            value = postX;
        }

        if let num: &NumericWord = value {
            let postVal = {
                std::conv::to!{usize} (num.str)
            } catch {
                _ => {
                    throw copy ErrorMsg::fatal(x, format(ValidateErrorMessage::MALFORMED_INT_LITERAL, value));
                }
            };

            if (withDollar) {
                if (len < postVal) {
                    throw copy ErrorMsg::fatal(x, format(ValidateErrorMessage::ARRAY_OVERFLOW, len, postVal));
                }

                return len - postVal;
            }

            return postVal;
        }

        throw copy ErrorMsg::fatal(x, format(SyntaxErrorMessage::UNEXPECTED, x.str));
    }

    /**
     * Read a required token.
     *
     */
    pub fn readToken(dmut lexer: &MacroLexer, lst: [c8])-> &Word
        throws ErrorMsg
    {
        MacroReadingUtils::skipTokens(alias lexer);
        let x = lexer:.next();
        if (x.isEof || x.str == lst) return x;

        throw copy ErrorMsg::fatal(x, format(SyntaxErrorMessage::UNEXPECTED_BUT_LST, x.str, [lst]));
    }

    /**
     * Attempt to read one of several possible tokens.
     *
     */
    pub fn readIf {R...} (dmut lexer: &MacroLexer, f: [c8], lst: R)-> &Word {
        MacroReadingUtils::skipTokens(alias lexer);
        let x = lexer:.next();
        if (x.isEof || x.str == f) return x;

        cte if (R,)::arity > 1 {
            for z in lst if x.str == z {
                return x;
            }
        } else {
            // a single alternative: the comparison is a runtime one, so it must
            // not be part of the `cte if` chain (an `else if` would inherit the cte)
            if lst == x.str {
                return x;
            }
        }

        lexer:.rewind();
        return EOF_WORD;
    }

    /**
     * Attempt to read a single optional token.
     *
     */
    pub fn readIf(dmut lexer: &MacroLexer, lst: [c8])-> &Word {
        MacroReadingUtils::skipTokens(alias lexer);
        let x = lexer:.next();
        if (x.isEof || x.str == lst) return x;

        lexer:.rewind();
        return EOF_WORD;
    }

    /**
     * Read the closing delimiter corresponding to a macro opening token.
     *
     * Supported pairs:
     *   - MACRO_CRO → RCRO
     *   - MACRO_PAR → RPAR
     *   - MACRO_ACC → RACC
     *
     * @throws:
     *   - ErrorMsg::fatal if the closing token is missing or mismatched.
     */
    pub fn readClosing(dmut lexer: &MacroLexer, opening: [c8])
        throws ErrorMsg
    {
        match opening {
            MacroPatternTokens::MACRO_CRO => {
                MacroReadingUtils::readToken(alias lexer, MacroPatternTokens::RCRO);
            }
            MacroPatternTokens::MACRO_PAR => {
                MacroReadingUtils::readToken(alias lexer, MacroPatternTokens::RPAR);
            }
            MacroPatternTokens::MACRO_ACC => {
                MacroReadingUtils::readToken(alias lexer, MacroPatternTokens::RACC);
            }
            _ => {
                panic;
            }
        }
    }
}
