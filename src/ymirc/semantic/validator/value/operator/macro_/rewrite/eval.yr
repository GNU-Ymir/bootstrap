/*
 * Implements evaluation of embedded macro expressions inside macro
 * rewriting constructs.
 *
 * MacroEvaluation is responsible for interpreting expressions that appear
 * inside:
 *
 *   - #{ expr }
 *   - #{ for x in expr { ... } }
 *   - #[ expr ]
 *   - #( expr )
 *
 * These expressions operate on the current MacroMapper and allow:
 *
 *   - variable lookup,
 *   - array indexing(x[0], x[1], ...),
 *   - sub-mapping access(x::field),
 *   - built-in variables(__index, __uid),
 *   - chained access(x[0]::field[2]::sub).
 *
 * The result of evaluation is always a list of MacroMapper
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::value::operator::macro_::rewrite::eval
 * @File: ymirc/semantic/validator/value/operator/macro_/rewrite/eval.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-06-01
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in eval;

use ymirc::lexing::_;
use ymirc::syntax::errors;

use ymirc::errors::_;

use ymirc::utils::{format, string};


use ymirc::semantic::validator::value::operator::macro_::{_, rewrite::_};


/**
 * MacroEvaluation module
 *
 * Provides evaluation logic for embedded macro expressions during rewriting.
 *
 * Responsibilities:
 *   - read identifiers and resolve them in the current mapper,
 *   - support built-in macro variables(__index, __uid),
 *   - support array indexing via `[n]`,
 *   - support sub-mapping access via `::field`,
 *   - support chained access operations,
 *   - return lists of MacroMapper values.
 *
 */
pub mod MacroEvaluation {

    /**
     * Evaluate an embedded macro expression.
     *
     * @returns:
     *   - a list of MacroMapper values.
     *
     * @throws:
     *   - ErrorMsg::fatal if the variable is undefined or access is invalid.
     */
    pub fn evaluate(context: &MacroRewriteContext, dmut lexer: &MacroLexer)-> [MacroMapper]
        throws ErrorMsg
    {
        let ident = MacroReadingUtils::readIdentifier(alias lexer);
        let mut current = match context.mapper.find(ident.str) {
            Ok(vals) => { vals }
            _ => {
                let nUnder = stripUnders(ident.str);
                match nUnder {
                    MacroKeys::INDEX => { return copy [MacroMapper(format("%", context.ruleIndex))]; }
                    MacroKeys::UID => { return copy [MacroMapper(format("%", context.uid))]; }
                }

                throw copy ErrorMsg::fatal(ident, format(ValidateErrorMessage::UNDEF_VAR, ident.str));
            }
        };

        loop {
            let next = MacroReadingUtils::readIf(alias lexer, MacroPatternTokens::LCRO, MacroPatternTokens::DCOLON);
            if next == MacroPatternTokens::LCRO {
                current = MacroEvaluation::evaluateAccess(next, alias lexer, current);
            }
            else if next == MacroPatternTokens::DCOLON {
                current = MacroEvaluation::evaluateSub(alias lexer, current);
            }
            else {
                break;
            }
        }

        return current;
    }

    /**
     * Evaluate array indexing: `x[n]`.
     *
     * @params:
     *   - loc     : location of the '[' token,
     *   - current: list of MacroMapper values.
     *
     * @returns:
     *   - [MacroMapper] containing exactly one element.
     */
    pub fn evaluateAccess(loc: &Word, dmut lexer: &MacroLexer, current: [MacroMapper])-> [MacroMapper]
        throws ErrorMsg
    {
        let index = MacroReadingUtils::readNumeric(alias lexer, current.len);
        MacroReadingUtils::readToken(alias lexer, MacroPatternTokens::RCRO);
        if (current.len > index) {
            return current[index .. index + 1];
        } else {
            throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::ARRAY_OVERFLOW, current.len, index));
        }
    }

    /**
     * Evaluate sub-mapping access: `x::field`.
     *
     * @returns:
     *   - a list of MacroMapper values.
     */
    pub fn evaluateSub(dmut lexer: &MacroLexer, current: [MacroMapper])-> [MacroMapper]
        throws ErrorMsg
    {
        let nIdent = MacroReadingUtils::readIdentifier(alias lexer);
        if (current.len == 1us) {
            if let Ok(vals) = current[0].find(nIdent.str) {
                return vals;
            }
        }

        if (stripUnders(nIdent.str) == SliceKeys::LEN) {
            return copy [MacroMapper(format("%", current.len))];
        }

        throw copy ErrorMsg::fatal(nIdent, format(ValidateErrorMessage::UNDEF_VAR, nIdent.str));
    }

}
