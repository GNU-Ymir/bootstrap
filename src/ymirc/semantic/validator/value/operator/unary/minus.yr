/*
 * Implements semantic validation for the unary minus operator in Ymir.
 *
 * Responsibilities:
 *   - Validate unary minus on integers, floats, and class instances.
 *   - Enforce type rules for signed and unsigned integer negation.
 *   - Perform compile-time evaluation when possible.
 *   - Detect integer overflow during constant folding.
 *   - Dispatch class unary operator overloads.
 *
 * This module is invoked by the unary operator validator when the
 * operator is `-value`.
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: minus
 * @File: minus.yr
 * @Author(s):
 *   - fatal: not a git repository (or any of the parent directories): .git
 *
 * @Created (YYYY-MM-DD): fatal: not a git repository (or any of the parent directories): .git
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in minus;

use ymirc::lexing::{word, keys};
use ymirc::syntax::expression::operator;
use ymirc::semantic::{validator, interpret};
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::errors::message;
use ymirc::utils::format;

/**
 * UnaryMinusValidation
 *
 * Provides semantic validation for the unary minus operator:
 *
 *      -value
 *
 * Supports:
 *   - Integer negation (with overflow detection).
 *   - Floating-point negation.
 *   - Class operator overloading via UnaryValidation. 
 */
pub mod UnaryMinusValidation {

    /**
     * Validate a unary minus expression.
     *
     * @params:
     *   - context: validation context
     *   - op:      unary expression containing the operand
     *
     * @returns:
     *   A &Value representing the result of the unary minus operation.
     *
     * @throws:
     *   ErrorMsg if the operand type does not support unary minus.
     */
    pub fn validate (dmut context: &ValidationContext, op: &UnaryExpr)-> &Value
        throws ErrorMsg
    {
        let value = ValueCreation::createEnumUnwrap (ValueValidation::validate (alias context, op.value));
        return UnaryMinusValidation::validate (alias context, op.loc, value);
    }

    /**
     * Validate unary minus on a fully evaluated operand.
     *
     * @params:
     *   - context: validation context
     *   - loc:     location of the unary operator
     *   - value:   operand value
     *
     * @returns:
     *   A &Value representing the negated value.
     *
     * @throws:
     *   ErrorMsg if the operand type does not support unary minus.
     */
    pub fn validate (dmut context: &ValidationContext, loc: &Word, value: &Value)-> &Value
        throws ErrorMsg
    {
        match value.type {
            i: &IntType => {
                return UnaryMinusValidation::validateInt (alias context, loc, value, i);
            }
            f: &FloatType => {
                return copy UnaryOperatorValue (loc, f, UnaryOperators::MINUS, value);
            }
            c: &ClassPtrType => {
                {
                    return UnaryValidation::validateClass (alias context, loc, UnaryOperators::MINUS, value, c);
                } catch {
                    err => {
                        throw copy ErrorMsg::fatal (loc, format (ValidateErrorMessage::UNDEFINED_UN_OP, UnaryOperators::MINUS, value.type),
                                                    notes-> copy [err]);
                    }
                }
            }
        }

        throw copy ErrorMsg::fatal (loc, format (ValidateErrorMessage::UNDEFINED_UN_OP, UnaryOperators::MINUS, value.type));
    }

    /**
     * Validate unary minus on an integer value.
     *     
     * @params:
     *   - context: validation context
     *   - loc:     operator location
     *   - value:   operand value
     *   - i:       integer type of the operand
     *
     * @returns:
     *   A &Value representing the negated integer.
     *
     * @throws:
     *   ErrorMsg if applied to a signed integer or if overflow occurs.
     */
    fn validateInt (dmut context: &ValidationContext, loc: &Word, value: &Value, i: &IntType)-> &Value
        throws ErrorMsg
    {
        if i.isSigned {
            throw copy ErrorMsg::fatal (loc, format (ValidateErrorMessage::UNDEFINED_UN_OP, UnaryOperators::MINUS, i));
        }
        
        let ret = copy UnaryOperatorValue (loc, i, UnaryOperators::MINUS, value);
        let x = context.cteInterpret:.reduce (ret);
        if let v: &IntValue = x {
            IntInterpret::verifyOverflow (loc, i, v.value);
        }

        return x;
    }
    
}
