/*
 * Implements semantic validation for the unary NOT operator `!` in Ymir.
 *
 * Responsibilities:
 *   - Validate unary NOT on integers, booleans, and class instances.
 *   - Perform compile-time reduction when possible.
 *   - Detect integer overflow during constant folding.
 *   - Dispatch class unary operator overloads.
 *   - Wrap class overload errors into a unified UNDEFINED_UN_OP diagnostic.
 *
 * This module is invoked by the unary operator validator when the operator is `!value`.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::value::operator::unary::not
 * @File: ymirc/semantic/validator/value/operator/unary/not.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-05-13
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in not;

use ymirc::errors;
use ymirc::lexing::{keys, word};
use ymirc::semantic::{interpret, validator};
use ymirc::semantic::generator::{type::_, value::_};
use ymirc::syntax::expression::operator;
use ymirc::utils::format;

/**
 * UnaryNotValidation
 *
 * Provides semantic validation for the unary NOT operator:
 *
 *      !value
 *
 * Supports:
 *   - Integer bitwise NOT.
 *   - Boolean logical NOT.
 *   - Class operator overloading via UnaryValidation.
 *
 */
pub mod UnaryNotValidation {

    /**
     * Validate a unary NOT expression.
     *
     * @params:
     *   - context: validation context
     *   - op:      unary expression containing the operand
     *
     * @returns:
     *   A &Value representing the result of the unary NOT operation.
     *
     * @throws:
     *   ErrorMsg if the operand type does not support unary NOT.
     */
    pub fn validate(dmut context: &ValidationContext, op: &UnaryExpr)-> &Value
        throws ErrorMsg
    {
        let value = ValueCreation::createEnumUnwrap(ValueValidation::validate(alias context, op.value));
        return UnaryNotValidation::validate(alias context, op.loc, value);
    }

    /**
     * Validate unary NOT on a fully evaluated operand.
     *
     * If class overload resolution fails, the caught error is wrapped into a
     * fatal UNDEFINED_UN_OP diagnostic with the original error as a note.
     *
     * @params:
     *   - context: validation context
     *   - loc:     location of the unary operator
     *   - value:   operand value
     *
     * @returns:
     *   A &Value representing the negated value.
     *
     * @throws:
     *   ErrorMsg if the operand type does not support unary NOT.
     */
    pub fn validate(dmut context: &ValidationContext, loc: &Word, value: &Value)-> &Value
        throws ErrorMsg
    {
        match value.type {
            i: &IntType => {
                return UnaryNotValidation::validateInt(alias context, loc, value, i);
            }
            b: &BoolType => {
                return copy UnaryOperatorValue(loc, b, UnaryOperators::NOT, value);
            }
            c: &ClassPtrType => {
                {
                    return UnaryValidation::validateClass(alias context, loc, UnaryOperators::NOT, value, c);
                } catch {
                    err => {
                        throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::UNDEFINED_UN_OP, UnaryOperators::NOT, value.type),
                                                    notes-> copy [err]);
                    }
                }
            }
        }

        throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::UNDEFINED_UN_OP, UnaryOperators::NOT, value.type));
    }

    /**
     * Validate unary NOT on an integer value.
     *
     * @params:
     *   - context: validation context
     *   - loc:     operator location
     *   - value:   operand value
     *   - i:       integer type of the operand
     *
     * @returns:
     *   A &Value representing the bitwise-negated integer.
     *
     * @throws:
     *   ErrorMsg if overflow occurs during constant folding.
     */
    fn validateInt(dmut context: &ValidationContext, loc: &Word, value: &Value, i: &IntType)-> &Value
        throws ErrorMsg
    {
        let ret = copy UnaryOperatorValue(loc, i, UnaryOperators::NOT, value);
        let x = context.cteInterpret:.reduce(ret);
        if let v: &IntValue = x {
            IntInterpret::verifyOverflow(loc, i, v.value);
        }

        return x;
    }
}
