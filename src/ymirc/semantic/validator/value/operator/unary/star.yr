in star;

use ymirc::errors;
use ymirc::lexing::{keys, word};
use ymirc::semantic::validator;
use ymirc::semantic::generator::{type::_, value::_};
use ymirc::syntax::expression::operator;
use ymirc::utils::format;

/**
 * UnaryStarValidation
 *
 * Provides semantic validation for the unary dereference operator:
 *
 *      *value
 *
 * Supports:
 *   - Dereferencing raw pointers.
 *   - Operator overloading on class.
 *
 */
pub mod UnaryStarValidation {

    /**
     * Validate a unary dereference expression.
     *
     * @params:
     *   - context: validation context
     *   - op:      unary expression containing the operand
     *
     * @returns:
     *   A &Value representing the result of the dereference operation.
     *
     * @throws:
     *   ErrorMsg if the operand is not a pointer or class pointer.
     */
    pub fn validate(dmut context: &ValidationContext, op: &UnaryExpr)-> &Value
        throws ErrorMsg
    {
        let value = ValueCreation::createEnumUnwrap(ValueValidation::validate(alias context, op.value));
        return UnaryStarValidation::validate(alias context, op.loc, value);
    }

    /**
     * Validate dereferencing on a fully evaluated operand.
     *
     * @params:
     *   - context: validation context
     *   - loc:     location of the unary operator
     *   - value:   operand value
     *
     * @returns:
     *   A &Value representing the dereferenced value.
     *
     * @throws:
     *   ErrorMsg if the operand type does not support dereferencing.
     */
    pub fn validate(dmut context: &ValidationContext, loc: &Word, value: &Value)-> &Value
        throws ErrorMsg
    {
        match value.type {
            p: &PointerType => {
                return UnaryStarValidation::validatePointer(alias context, loc, value, p);
            }
            c: &ClassPtrType => {
                {
                    return UnaryValidation::validateClass(alias context, loc, UnaryOperators::STAR, value, c);
                } catch {
                    err => {
                        throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::UNDEFINED_UN_OP, UnaryOperators::STAR, value.type),
                                                    notes-> copy [err]);
                    }
                }
            }
        }

        throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::UNDEFINED_UN_OP, UnaryOperators::STAR, value.type));
    }

    /**
     * Validate dereferencing of a raw pointer value.
     *
     * Behavior:
     *   - Enforces unsafe-context rules(dereferencing is always unsafe).
     *   - Determines the resulting type:
     *       • If the pointer is an rvalue → clone the pointed type as immutable.
     *       • If the pointer is an lvalue → preserve the pointed type.
     *   - Rejects dereferencing of void pointers.
     *   - Constructs a DereferencerValue representing the dereferenced access.
     *
     * @params:
     *   - context: validation context
     *   - loc:     operator location
     *   - value:   pointer value
     *   - p:       pointer type
     *
     * @returns:
     *   A &Value representing the dereferenced pointer.
     *
     * @throws:
     *   ErrorMsg if dereferencing a void pointer or outside an unsafe context.
     */
    fn validatePointer(dmut context: &ValidationContext, loc: &Word, value: &Value, p: &PointerType)-> &Value
        throws ErrorMsg
    {
        ValueVerification::verifyUnsafeContext(alias context, loc);

        let retType = if (!value.isLvalue) {
            p.pointed.clone(0u32)
        } else {
            p.pointed
        };

        if (retType of VoidType) {
            throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::UNDEFINED_UN_OP, loc.str, p));
        }

        return copy DereferencerValue(value.loc, retType, value);
    }
}
