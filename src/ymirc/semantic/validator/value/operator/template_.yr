use ymirc::utils::format;


pub mod TemplateValidation {

    pub fn validateArgumentList (dmut context: &ValidationContext, lst: [&Expression])-> [&Generator]
        throws ErrorMsg
    {
        let mut results: [mut &Generator] = [];
        for i in lst {
            let mut typeButNotComplete = false;
            { // We first try a type
                let type = TypeValidation::validate (alias context, i);
                typeButNotComplete = true;

                TypeVerification::verifyComplete (i.loc, type, construct-> true);
                results ~= [type];
            } catch {
                err: &ErrorMsg => { // Apparently its not a type
                    // It is a type, but it is not a complete type (none, or temporary, classref, etc.)
                    if (typeButNotComplete) throw err;
                    
                    {
                        let val = ValueValidation::validate (alias context, i); // Maybe its a value
                        if (!context.cteInterpret.isCte (val)) { // but we need to know it a compile time
                            throw copy ErrorMsg::fatal (val.loc, format (ValidateErrorMessage::UNKNOWN_AT_COMPILE_TIME, val.type));
                        }
                        
                        results ~= [val];
                    } catch {
                        err2: &ErrorMsg => { // Another error, we print both errors (type and value) for better debugging
                            let valueError = copy ErrorMsg::note (i.loc, ValidateErrorMessage::TEMPLATE_VALUE_TRY, notes-> copy [err2]);
                            throw copy ErrorMsg::list (copy [err, valueError]);
                        }
                    }
                }
            };
        }

        return results; // Everything is ok
    }


        /**
     * Validate a template call expression
     * @params: 
     *   - context: the context of the validation
     *   - t: the template call to validate
     * @returns: the validated value
     */
    pub fn validateCall (dmut context: &ValidationContext, t: &TemplateCallExpr)-> &Value
        throws ErrorMsg
    {
        let left = ValueValidation::validate (alias context, t.left);
         // validate the list of argument of the template call
        let list = ValueTemplateValidation::validateArgumentList (t.rights);

        ValueTemplateValidation::validateCall (alias context, t.loc, left, list)
    }

    /**
     * Validate a template call
     * @params:
     *    - context: the context of the validation
     *    - t: the template call to validate
     * @returns: the validated value
     * */
    pub fn validateCall (dmut context: &ValidationContext, loc: &Word, left: &Value, rights: [&Generator])-> &Value
        throws ErrorMsg
    {
        let value: &MultSymValue = match left {
            m: &MultSymValue => { m }
            tmp: _ => { copy MultSymValue (left.getLoc (), copy [tmp], prettyStr-> format ("%", tmp, tags-> FormatTags (withParams-> true))) }
        };

        self.validateTemplateCallMultSym (alias context, loc, value, rights)
    }


    pub fn validateCheck (dmut context: &ValidationContext, t: &TemplateCheckerExpr)-> &Value
        throws ErrorMsg
    {
        context;
        t;

        panic;
    }
    
