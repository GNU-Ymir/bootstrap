in logical;

use ymirc::lexing::{word, tokens, keys};

use ymirc::syntax::expression::_;
use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::errors::message;
use ymirc::utils::format;

pub mod BinaryLogicalValidation {

    pub fn validate (dmut context: &ValidationContext, bin: &BinaryExpr, op: BinaryOperators)-> &Value
        throws ErrorMsg
    {
        return BinaryLogicalValidation::validate (alias context, bin.loc, op,
                                                  left-> ValueValidation::validate (alias context, bin.left),
                                                  right-> ValueValidation::validate (alias context, bin.right));                                                   
    }

    pub fn validate (dmut context: &ValidationContext,
                     loc:          &Word,
                     op:           BinaryOperators,
                     left:         &Value,
                     right:        &Value)-> &Value
        throws ErrorMsg
    {
        return BinaryLogicalValidation::validateImpl (alias context, loc, op,
                                                      left-> ValueCreation::createEnumUnwrap (left),
                                                      right-> ValueCreation::createEnumUnwrap (right));
    }

    fn validateImpl (dmut context: &ValidationContext,
                         loc:          &Word,
                         op:           BinaryOperators,
                         left:         &Value,
                         right:        &Value)-> &Value
        throws ErrorMsg
    {
        let mut errors: [&ErrorMsg] = [];
        {
            match left.type {
                BoolType () if right.type of BoolType => {
                    return copy LogicalBoolOperatorValue (loc, op, left, right);    
                }
                c: &ClassPtrType => {
                    return BinaryValidation::validateClassLeft (alias context, loc, op, c, left, right);
                }
            }
        } catch {
            err: &ErrorMsg => {
                errors ~= [err];
            }        
        }
        
        {
            match right.type { 
                c: &ClassPtrType => {
                    return BinaryValidation::validateClassRight (alias context, loc, op, c, left, right);
                }
            } 
        } catch {
            err: &ErrorMsg => {
                errors ~= [err];
            } 
        }

        // there is no valid math operation for left and right
        throw copy ErrorMsg::fatal (loc,
                                    format (ValidateErrorMessage::UNDEFINED_BIN_OP, op, left.type, right.type),
                                    notes-> errors);
        
    }

    
}
