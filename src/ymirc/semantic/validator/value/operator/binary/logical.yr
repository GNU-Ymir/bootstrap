 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in logical;

use ymirc::lexing::{word, tokens, keys};

use ymirc::syntax::expression::_;
use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::errors;
use ymirc::utils::format;

/**
 * BinaryLogicalValidation module
 *
 * Provides semantic validation for logical binary operators.
 *
 * Responsibilities:
 *   - validate operands,
 *   - unwrap enum operands,
 *   - validate built-in boolean logic,
 *   - dispatch to class-specific operator overloads,
 *   - aggregate and report errors when no overload matches.
 *
 */
pub mod BinaryLogicalValidation {

    /**
     * Validate a logical binary expression.
     *
     * @returns:
     *   - the validated Value
     *
     * @throws:
     *   - ErrorMsg if validation fails
     */
    pub fn validate(dmut context: &ValidationContext, bin: &BinaryExpr, op: BinaryOperators)-> &Value
        throws ErrorMsg
    {
        return BinaryLogicalValidation::validate(alias context, bin.loc, op,
                                                 left-> ValueValidation::validate(alias context, bin.left),
                                                 right-> ValueValidation::validate(alias context, bin.right));
    }

    /**
     * Validate a logical binary operation given validated operands.
     *
     * @returns:
     *   - the validated Value
     *
     * @throws:
     *   - ErrorMsg if validation fails
     */
    pub fn validate(dmut context: &ValidationContext,
                    loc:          &Word,
                    op:           BinaryOperators,
                    left:         &Value,
                    right:        &Value)-> &Value
        throws ErrorMsg
    {
        return BinaryLogicalValidation::validateImpl(alias context, loc, op,
                                                     left-> ValueCreation::createEnumUnwrap(left),
                                                     right-> ValueCreation::createEnumUnwrap(right));
    }

    /**
     * Core implementation of logical binary validation.
     *
     * @throws:
     *   - ErrorMsg if no valid logical operator exists for the operand types
     */
    fn validateImpl(dmut context: &ValidationContext,
                    loc:          &Word,
                    op:           BinaryOperators,
                    left:         &Value,
                    right:        &Value)-> &Value
        throws ErrorMsg
    {
        let mut errors: [&ErrorMsg] = [];
        {
            match left.type {
                BoolType() if right.type of BoolType => {
                    return copy LogicalBoolOperatorValue(loc, op, left, right);
                }
                c: &ClassPtrType => {
                    return BinaryValidation::validateClassLeft(alias context, loc, op, left, c, right);
                }
            }
        } catch {
            err: &ErrorMsg => {
                errors ~= [err];
            }
        }

        {
            match right.type {
                c: &ClassPtrType => {
                    return BinaryValidation::validateClassRight(alias context, loc, op, left, right, c);
                }
            }
        } catch {
            err: &ErrorMsg => {
                errors ~= [err];
            }
        }

        // there is no valid math operation for left and right
        throw copy ErrorMsg::fatal(loc,
                                   format(ValidateErrorMessage::UNDEFINED_BIN_OP, op, left.type, right.type),
                                   notes-> errors);
    }
}
