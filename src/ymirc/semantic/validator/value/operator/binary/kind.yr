/*
 * Defines operator-kind classification and affect-operator detection for Ymir’s
 * binary operator system.
 *
 * Responsibilities:
 *   - classify binary operators into semantic categories
 *   - normalize affect operators(+=, -=, etc.) into their base operator
 *   - provide a lookup table mapping each operator to its(baseOp, kind)
 *   - detect whether an operator is an affect operator
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::value::operator::binary::kind
 * @File: ymirc/semantic/validator/value/operator/binary/kind.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-04-10
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in kind;

use ymirc::lexing::{word, keys};
use ymirc::errors;
use ymirc::semantic::validator;
use ymirc::utils::format;

/**
 * OperatorType
 *
 * Classifies binary operators into semantic categories used by the validator
 * and type checker.
 *
 * Categories:
 *   - MATH        — arithmetic operators(+, -, *, /, %, etc.)
 *   - BITWISE     — bitwise operators(&, |, ^, <<, >>)
 *   - LOGICAL     — logical operators(&&, ||)
 *   - COMPARISON  — comparison operators(<, >, ==, !=, etc.)
 *   - RANGE       — range constructors(.., ...)
 *   - CLASS       — pointer identity operators(is, !is)
 *   - CONTAINS    — set membership operators(in, !in)
 *   - CONCAT      — set concatenation operators(~)
 *   - TYPE        — type-test operators(of, !of)
 *   - FIELD       — field access operators(. and:.)
 *   - MODULE      — module access(::)
 *   - NONE        — no semantic category(used for assignment)
 */
pub enum
| MATH       = 1u32
| BITWISE    = 2u32
| LOGICAL    = 3u32
| COMPARISON = 4u32
| RANGE      = 5u32
| CLASS      = 6u32
| CONTAINS   = 7u32
| CONCAT     = 8u32
| TYPE       = 9u32
| FIELD      = 10u32
| MODULE     = 11u32
| NONE       = 12u32
-> OperatorType;

/**
 * AffectOperators
 *
 * Enumerates assignment-with-operator forms:
 *
 *     x <op>= y
 *
 * Each affect operator maps to its corresponding base operator:
 *   - += => PLUS
 *   - -= => MINUS
 *   - *= => STAR
 *   - /= => DIV
 *   - %= => PERCENT
 *   - <<= => LEFTD
 *   - >>= => RIGHTD
 *   - ~= => TILDE
 *
 * These are used to normalize affect operators into their base operator for
 * semantic validation.
 *
 */
pub enum
| AFFECT  = BinaryOperators::EQUAL
| DIV     = BinaryOperators::DIV_AFF
| MINUS   = BinaryOperators::MINUS_AFF
| PLUS    = BinaryOperators::PLUS_AFF
| STAR    = BinaryOperators::STAR_AFF
| PERCENT = BinaryOperators::PERCENT_AFF
| LEFTD   = BinaryOperators::LEFTD_AFF
| RIGHTD  = BinaryOperators::RIGHTD_AFF
| TILDE   = BinaryOperators::TILDE_AFF
-> AffectOperators;

/**
 * Operator classification table
 *
 * Maps each BinaryOperator to:
 *   - its normalized base operator
 *   - its semantic OperatorType
 *
 * Examples:
 *   - += => (PLUS, MATH)
 *   - <<= => (LEFTD, BITWISE)
 *   - && => (DAND, LOGICAL)
 *   - .. => (TDOT, RANGE)
 *   - of => (OF, TYPE)
 *
 * This table is used by toOperator() to classify operators and by the
 * validator to enforce operator-specific rules.
 */
lazy __TABLE__: [BinaryOperators => (BinaryOperators, OperatorType)] = copy [
    BinaryOperators::EQUAL => (BinaryOperators::EQUAL, OperatorType::NONE),

    BinaryOperators::DIV_AFF => (BinaryOperators::DIV, OperatorType::MATH),
    BinaryOperators::MINUS_AFF => (BinaryOperators::MINUS, OperatorType::MATH),
    BinaryOperators::PLUS_AFF => (BinaryOperators::PLUS, OperatorType::MATH),
    BinaryOperators::STAR_AFF => (BinaryOperators::STAR, OperatorType::MATH),
    BinaryOperators::PERCENT_AFF => (BinaryOperators::PERCENT, OperatorType::MATH),

    BinaryOperators::LEFTD_AFF => (BinaryOperators::LEFTD, OperatorType::BITWISE),
    BinaryOperators::RIGHTD_AFF => (BinaryOperators::RIGHTD, OperatorType::BITWISE),
    BinaryOperators::LEFTD => (BinaryOperators::LEFTD, OperatorType::BITWISE),
    BinaryOperators::RIGHTD => (BinaryOperators::RIGHTD, OperatorType::BITWISE),
    BinaryOperators::PIPE => (BinaryOperators::PIPE, OperatorType::BITWISE),
    BinaryOperators::XOR => (BinaryOperators::XOR, OperatorType::BITWISE),
    BinaryOperators::AND => (BinaryOperators::AND, OperatorType::BITWISE),

    BinaryOperators::DPIPE => (BinaryOperators::DPIPE, OperatorType::LOGICAL),
    BinaryOperators::DAND => (BinaryOperators::DAND, OperatorType::LOGICAL),

    BinaryOperators::INF => (BinaryOperators::INF, OperatorType::COMPARISON),
    BinaryOperators::SUP => (BinaryOperators::SUP, OperatorType::COMPARISON),
    BinaryOperators::INF_EQUAL => (BinaryOperators::INF_EQUAL, OperatorType::COMPARISON),
    BinaryOperators::SUP_EQUAL => (BinaryOperators::SUP_EQUAL, OperatorType::COMPARISON),
    BinaryOperators::NOT_EQUAL => (BinaryOperators::NOT_EQUAL, OperatorType::COMPARISON),
    BinaryOperators::DEQUAL => (BinaryOperators::DEQUAL, OperatorType::COMPARISON),
    BinaryOperators::CONGRUENT => (BinaryOperators::CONGRUENT, OperatorType::COMPARISON),
    BinaryOperators::UNCONGRUENT => (BinaryOperators::UNCONGRUENT, OperatorType::COMPARISON),

    BinaryOperators::OF => (BinaryOperators::OF, OperatorType::TYPE),
    BinaryOperators::NOT_OF => (BinaryOperators::NOT_OF, OperatorType::TYPE),

    BinaryOperators::IS => (BinaryOperators::IS, OperatorType::POINTER),
    BinaryOperators::NOT_IS => (BinaryOperators::NOT_IS, OperatorType::POINTER),

    BinaryOperators::IN => (BinaryOperators::IN, OperatorType::CONTAINS),
    BinaryOperators::NOT_IN => (BinaryOperators::NOT_IN, OperatorType::CONTAINS),
    BinaryOperators::TILDE => (BinaryOperators::TILDE, OperatorType::CONCAT),
    BinaryOperators::TILDE_AFF => (BinaryOperators::TILDE, OperatorType::CONCAT),

    BinaryOperators::TDOT => (BinaryOperators::TDOT, OperatorType::RANGE),
    BinaryOperators::DDOT => (BinaryOperators::DDOT, OperatorType::RANGE),

    BinaryOperators::PLUS => (BinaryOperators::PLUS, OperatorType::MATH),
    BinaryOperators::MINUS => (BinaryOperators::MINUS, OperatorType::MATH),
    BinaryOperators::STAR => (BinaryOperators::STAR, OperatorType::MATH),
    BinaryOperators::PERCENT => (BinaryOperators::PERCENT, OperatorType::MATH),
    BinaryOperators::DIV => (BinaryOperators::DIV, OperatorType::MATH),
    BinaryOperators::DXOR => (BinaryOperators::DXOR, OperatorType::MATH),

    BinaryOperators::DOT => (BinaryOperators::DOT, OperatorType::FIELD),
    BinaryOperators::DOT_AND => (BinaryOperators::DOT_AND, OperatorType::FIELD),

    BinaryOperators::DCOLON => (BinaryOperators::DCOLON, OperatorType::MODULE)
];

/**
 * Normalize and classify a binary operator.
 *
 * Looks up the operator in the classification table and returns:
 *
 *     (baseOperator, operatorType)
 *
 * If the operator is not defined in the table, an error is raised.
 *
 * @params:
 *   - loc: location of the operator token
 *   - op:  the BinaryOperators enum value
 *
 * @returns:
 *   A tuple(BinaryOperators, OperatorType)
 *
 * @throws:
 *   ErrorMsg if the operator is not defined in the classification table.
 */
pub fn toOperator(loc: &Word, op: BinaryOperators)-> (BinaryOperators, OperatorType)
    throws ErrorMsg
{
    if let Ok(result) = __TABLE__[op] {
        return result;
    }

    throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::UNDEFINED_BIN_OP_TOK, op));
}

/**
 * Determine whether a binary operator is an affect operator.
 *
 * Affect operators are those of the form:
 *
 *     x <op>= y
 *
 * This function checks whether `op` belongs to AffectOperators.
 *
 * @params:
 *   - op: the operator to test
 *
 * @returns:
 *   true  if the operator is an affect operator
 *   false otherwise
 */
pub fn isAffect(op: BinaryOperators)-> bool {
    for a in AffectOperators::__members__ {
        if a == op return true;
    }

    return false;
}

/**
 * Return the inverse comparison operator for a given comparison operator.
 *
 * This utility is used when reversing the operand order in a comparison(e.g.,
 * when validating class comparisons where the class instance may appear on
 * either the left or the right side).
 *
 * Mapping rules:
 *   - < => >
 *   - > => <
 *   - <= => >=
 *   - >= => <=
 *   - == => ==     (symmetric)
 *   - != => !=     (symmetric)
 *
 * Unsupported operators trigger a panic, as only ordering and equality
 * operators have a meaningful inverse.
 *
 * @params:
 *   - op: the comparison operator to invert
 *
 * @returns:
 *   The inverted comparison operator.
 */
pub fn inverseCmp(op: BinaryOperators)-> BinaryOperators {
    match op {
        BinaryOperators::INF => { BinaryOperators::SUP }
        BinaryOperators::SUP => { BinaryOperators::INF }
        BinaryOperators::INF_EQUAL => { BinaryOperators::SUP_EQUAL }
        BinaryOperators::SUP_EQUAL => { BinaryOperators::INF_EQUAL }
        BinaryOperators::NOT_EQUAL => { BinaryOperators::NOT_EQUAL }
        BinaryOperators::DEQUAL => { BinaryOperators::DEQUAL }
        _ => {
            panic;
        }
    }
}
