in concat;

use ymirc::errors;
use ymirc::lexing::{keys, word};
use ymirc::semantic::generator::{type::_, value::_};
use ymirc::syntax::expression::operator;
use ymirc::utils::format;

/**
 * BinaryConcatValidation
 *
 * Provides semantic validation for the concatenation operator. The operator
 * supports:
 *
 *   - slice ~ slice
 *   - array ~ array
 *   - array ~ slice
 *   - slice ~ array
 *   - class ~ any(via operator overloading)
 *
 *
 * This module defines the complete semantics of concatenation in Ymir.
 */
pub mod BinaryConcatValidation {

    /**
     * Validate a concatenation expression.
     *
     * @params:
     *   - context: the validation context
     *   - bin:     the binary expression node
     *   - op:      the concatenation operator
     *
     * @returns:
     *   A &Value representing the validated concatenation.
     */
    pub fn validate(dmut context: &ValidationContext, bin: &BinaryExpr, op: BinaryOperators)-> &Value
        throws ErrorMsg
    {
        return BinaryConcatValidation::validate(alias context, bin.loc, op,
                                                 left-> ValueValidation::validate(alias context, bin.left),
                                                 right-> ValueValidation::validate(alias context, bin.right));
    }

    /**
     * Validate a concatenation after both operands have been validated.
     *
     * Enum values are unwrapped before concatenation so that the operator
     * applies to the underlying slice/array/class value.
     *
     * @params:
     *   - context: the validation context
     *   - loc:     operator location
     *   - op:      concatenation operator
     *   - left:    validated left operand
     *   - right:   validated right operand
     *
     * @returns:
     *   A &Value representing the validated concatenation.
     */
    pub fn validate(dmut context: &ValidationContext,
                     loc:          &Word,
                     op:           BinaryOperators,
                     left:         &Value,
                     right:        &Value)-> &Value
        throws ErrorMsg
    {
        let lvalue = ValueCreation::createEnumUnwrap(left);
        let rvalue = ValueCreation::createEnumUnwrap(right);

        return BinaryConcatValidation::validateConcat(alias context, loc, op,
                                                       left-> lvalue,
                                                       right-> rvalue);
    }

    /**
     * Core implementation of concatenation validation.
     *
     * Dispatch strategy:
     *   1. Try validating based on the left operand type:
     *        - SliceType => validateSliceOrArrayLeft()
     *        - ArrayType => validateArrayLeft()
     *        - ClassPtrType => class operator overload
     *
     *   2. If left-side validation fails, try class-specific overload on the right.
     *
     *   3. If both fail, emit a fatal UNDEFINED_BIN_OP error with aggregated notes.
     *
     * @params:
     *   - context: the validation context
     *   - loc:     operator location
     *   - op:      concatenation operator
     *   - left:    validated left operand
     *   - right:   validated right operand
     *
     * @returns:
     *   A &Value representing the validated concatenation.
     */
    fn validateConcat(dmut context: &ValidationContext,
                       loc:          &Word,
                       op:           BinaryOperators,
                       left:         &Value,
                       right:        &Value)-> &Value
        throws ErrorMsg
    {
        let mut errors: [&ErrorMsg] = [];
        {
            match left.type {
                _: &SliceType => {
                    return BinaryConcatValidation::validateSliceOrArrayLeft(alias context, loc, left, right);
                }
                a: &ArrayType => {
                    return BinaryConcatValidation::validateArrayLeft(alias context, loc, left, a, right);
                }
                c: &ClassPtrType => {
                    return BinaryValidation::validateClassLeft(alias context, loc, op, left, c, right);
                }
            }
        } catch {
            err => {
                errors ~= [err];
            }
        }

        {
            match right.type {
                c: &ClassPtrType => {
                    return BinaryValidation::validateClassRight(alias context, loc, op, left, right, c);
                }
            }
        } catch {
            err => {
                errors ~= [err];
            }
        }

        if let Ok(placeholder) = ValueCreation::createErrorPropagation(loc, left, right) { return placeholder; }
        throw copy ErrorMsg::fatal(loc,
                                    format(ValidateErrorMessage::UNDEFINED_BIN_OP, op, left.type, right.type),
                                    notes-> errors);
    }

    /**
     * Validate concatenation where the left operand is an array.
     *
     * Supported cases:
     *   - array ~ array
     *   - array ~ slice(delegated to validateSliceOrArrayLeft)
     *
     * Behavior:
     *   - Extract each element of both arrays via IndexValidation.
     *   - Accumulate them into a new parameter list.
     *   - Infer the resulting element type using SliceComposeValidation.
     *   - Construct a new ArrayType and ArrayValue.
     *
     * If both arrays are empty, the resulting element type is VOID_TYPE.
     *
     * @params:
     *   - context:   the validation context
     *   - loc:       operator location
     *   - left:      validated left array
     *   - leftType:  array type of the left operand
     *   - right:     validated right operand
     *
     * @returns:
     *   A new ArrayValue representing the concatenation.
     */
    fn validateArrayLeft(dmut context: &ValidationContext,
                          loc:          &Word,
                          left:         &Value,
                          leftType:     &ArrayType,
                          right:        &Value)-> &Value
        throws ErrorMsg
    {
        if right.type of SliceType {
            return BinaryConcatValidation::validateSliceOrArrayLeft(alias context, loc, left, right);
        }

        let rightType: &ArrayType = if let arr: &ArrayType = right.type {
            arr
        } else {
            throw copy ErrorMsg::list([]);
        };

        let mut inner: &Type = NONE_TYPE;
        let mut params: [&Value] = [];
        for i in 0 .. leftType.len {
            let val = IndexValidation::validate(alias context, loc, left, copy IntValue(loc, USIZE_TYPE, i));
            inner = SliceComposeValidation::addArrayType(alias context, val, inner, ref params);
        }

        for i in 0 .. rightType.len {
            let val = IndexValidation::validate(alias context, loc, right, copy IntValue(loc, USIZE_TYPE, i));
            inner = SliceComposeValidation::addArrayType(alias context, val, inner, ref params);
        }

        if params.len == 0 {
            inner = VOID_TYPE;
        }

        let resultType = copy ArrayType(loc, inner, params.len, isMutable-> true);
        return copy ArrayValue(loc, resultType, params);
    }

    /**
     * Validate concatenation where the left operand is a slice or array.
     *
     * Steps:
     *   1. Convert arrays to slice aliases.
     *   2. Convert right operand similarly.
     *   3. Use inferValuesForBranch() to reconcile the left and right values.
     *
     *   4. Type the result from the mutability of the operands(inferConcatType).
     *
     *   5. Produce a SliceConcatValue representing the concatenation.
     *
     * @params:
     *   - context: the validation context
     *   - loc:     operator location
     *   - left:    validated left slice or array
     *   - right:   validated right slice or array
     *
     * @returns:
     *   A SliceConcatValue representing the concatenation.
     */
    fn validateSliceOrArrayLeft(dmut context:  &ValidationContext,
                                 loc:           &Word,
                                 left:          &Value,
                                 right:         &Value)-> &Value
        throws ErrorMsg
    {
        let finLeft = match left.type {
            SliceType() => { left }
            a: &ArrayType => { ValueCreation::createSliceAliasFromArray(loc, a, left) }
            _ => {
                throw copy ErrorMsg::list([]);
            }
        };

        let finRight = match right.type {
            SliceType() => { right }
            a: &ArrayType => { ValueCreation::createSliceAliasFromArray(loc, a, right) }
            _ => {
                throw copy ErrorMsg::list([]);
            }
        };

        let (branchType, lvalue, rvalue) = TypeInference::inferValuesForBranch(alias context, loc, finLeft, finRight);
        let retType = BinaryConcatValidation::inferConcatType(loc, finLeft.type, finRight.type, fallback-> branchType);

        return copy SliceConcatValue(loc, retType, lvalue, rvalue);
    }

    /**
     * Infer the type of the concatenation of two slices, from the mutability of the operands.
     *
     * Branch inference degrades the mutability of the result(cf.
     * TypeInference::inferImplicitMutability), because a branch borrows its
     * operands. A concatenation allocates a new slice instead: the slice and its
     * element slots are always mutable, anything below a borrow is shared with
     * the operands and keeps their mutability.
     *
     * @params:
     *   - loc:      operator location
     *   - left:     type of the left slice
     *   - right:    type of the right slice
     *   - fallback: the type used when the operand types have no common type
     *
     * @returns:
     *   The type of the concatenated slice.
     */
    pub fn inferConcatType(loc: &Word, left: &Type, right: &Type, fallback: &Type)-> &Type
        throws ErrorMsg
    {
        let common = {
            TypeInference::inferBranching(loc, loc, left, right)
        } catch {
            _ => { fallback }
        };

        if let t: &SliceType = common {
            return copy SliceType(loc, BinaryConcatValidation::copiedMutability(t.value), isMutable-> true);
        }

        return common;
    }

    /**
     * @returns: the type of an element copied into a concatenation, every component down to a
     * borrow being mutable, and anything below it keeping its mutability
     */
    fn copiedMutability(type: &Type)-> &Type {
        if (!type.isMutable) return type.cloneMutableUntilBorrow();
        {
            match type {
                t: &TupleType => {
                    let inners = copy [BinaryConcatValidation::copiedMutability(i) for i in t.inners];
                    return copy TupleType(t.loc, inners, isMutable-> true);
                }
                a: &ArrayType => {
                    return copy ArrayType(a.loc, BinaryConcatValidation::copiedMutability(a.value), a.len, isMutable-> true);
                }
                o: &OptionType => {
                    return copy OptionType(o.loc, BinaryConcatValidation::copiedMutability(o.wrapped), isMutable-> true);
                }
            }
        } catch {
            _ => panic;
        }

        return type;
    }
}
