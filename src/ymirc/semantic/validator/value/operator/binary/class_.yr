/*
 * Implements validation for class-specific binary operators in Ymir.
 *
 * This module handles the subset of binary operators that apply to class
 * pointers(ClassPtrType). In practice, this is limited to:
 *
 *   - pointer identity operators:   a is b
 *   - pointer inequality operators: a !is b
 *
 * These operators compare object identity, not structural equality.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::value::operator::binary::class_
 * @File: ymirc/semantic/validator/value/operator/binary/class_.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-04-10
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in class_;

use ymirc::lexing::{word, tokens, keys};

use ymirc::syntax::expression::_;
use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::errors::message;
use ymirc::utils::format;


/**
 * BinaryClassValidation
 *
 * Provides semantic validation for pointer-identity operators applied to class
 * instances. These operators test whether two class references refer to the
 * same underlying object.
 *
 * Supported operators:
 *   - IS => rewritten to DEQUAL
 *   - NOT_IS => rewritten to NOT_EQUAL
 *
 */
pub mod BinaryClassValidation {

    /**
     * Validate a class-pointer binary expression.
     *
     *
     * @params:
     *   - context: validation context
     *   - bin:     binary expression
     *   - op:      pointer operator(IS or NOT_IS)
     *
     * @returns:
     *   A &Value representing the validated pointer comparison.
     */
    pub fn validate(dmut context: &ValidationContext, bin: &BinaryExpr, op: BinaryOperators)-> &Value
        throws ErrorMsg
    {
        return BinaryClassValidation::validate(alias context, bin.loc, op,
                                                left-> ValueValidation::validate(alias context, bin.left),
                                                right-> ValueValidation::validate(alias context, bin.right));
    }

    /**
     * Validate a pointer comparison after both operands have been validated.
     *
     * Enum values are unwrapped before validation so that pointer operators
     * operate on the underlying class pointer.
     *
     * @returns:
     *   A &Value representing the validated pointer comparison.
     */
    pub fn validate(dmut context: &ValidationContext,
                     loc:          &Word,
                     op:           BinaryOperators,
                     left:         &Value,
                     right:        &Value)-> &Value
        throws ErrorMsg
    {
        return BinaryClassValidation::validateImpl(alias context, loc, op,
                                                    left-> ValueCreation::createEnumUnwrap(left),
                                                    right-> ValueCreation::createEnumUnwrap(right));
    }


    /**
     * Core implementation of class-pointer operator validation.
     *
     * This function handles pointer-identity operators(`is`, `!is`) applied to
     * class references. Pointer comparison in Ymir is strictly about *object
     * identity*, not structural equality.
     *
     * @params:
     *   - context: validation context
     *   - loc:     operator location
     *   - op:      pointer operator(IS or NOT_IS)
     *   - left:    validated left operand
     *   - right:   validated right operand
     *
     * @returns:
     *   A CmpPointerOperatorValue representing the validated pointer
     *   comparison.
     *
     * @throws:
     *   ErrorMsg if:
     *     • either operand is not a class pointer
     *     • the class is a struct
     *     • no common comparable class type can be inferred
     */
    fn validateImpl(dmut context: &ValidationContext,
                     loc:          &Word,
                     op:           BinaryOperators,
                     left:         &Value,
                     right:        &Value)-> &Value
        throws ErrorMsg
    {
        let mut errors: [&ErrorMsg] = [];
        if let cptr: &ClassPtrType = left.type && right.type of ClassPtrType {
            if cptr.isStruct {
                throw copy ErrorMsg::fatal(left.loc, format(ValidateErrorMessage::NOT_A_CLASS, cptr));
            }

            let (_, lvalue, rvalue) = TypeInference::inferValuesForBranch(alias context, loc, left, right);
            let realOp = if op == BinaryOperators::IS {
                BinaryOperators::DEQUAL
            } else {
                BinaryOperators::NOT_EQUAL
            };

            return copy CmpPointerOperatorValue(loc, realOp, lvalue, rvalue);
        } catch {
            err => {
                errors ~= [err];
            }
        }

        throw copy ErrorMsg::fatal(loc,
                                    format(ValidateErrorMessage::UNDEFINED_BIN_OP, op, left.type, right.type),
                                    notes-> errors);
    }
}
