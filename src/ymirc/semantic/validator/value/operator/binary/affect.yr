/*
 * Implements validation for affect (assignment) operators in Ymir.
 *
 * This includes:
 *   - simple assignment:          a = b
 *   - affect operators:           a += b, a -= b, a *= b, ...
 *   - slice append:               a ~= b
 *   - index assignment:           a[i] = b, a[i] += b
 *   - field assignment:           a.x = b, a.x += b
 *   - class field setter methods: a.x = b  via setter call
 *   - class index assignment:     a[i] = b  via operator overload
 *
 * Responsibilities:
 *   - validate left-operand memory semantics
 *   - validate right-operand type inference and implicit casts
 *   - dispatch to specialized index/field/class assign logic
 *   - handle slice append and slice concatenation
 *   - handle move semantics and destructor invocation
 *
 * This module is the authoritative implementation of assignment
 * semantics in Ymir. 
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::semantic::validator::value::operator::binary::affect
 * @File: ymirc/semantic/validator/value/operator/binary/affect.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2026-04-10
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */



in affect;

use ymirc::lexing::{word, tokens, keys};

use ymirc::syntax::expression::_;
use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::errors::message;
use ymirc::utils::format;

/**
 * BinaryAffectValidation
 *
 * Provides validation for all assignment-related binary operators.
 *
 * Assignment in Ymir is not a single operation. Depending on the left operand,
 * it may:
 * 
 *   - assign to a variable
 *   - assign to an array/slice element
 *   - assign to a map entry
 *   - assign to a class field
 *   - call a class setter method
 *   - perform slice append (a ~= b)
 *   - perform move semantics with destructor invocation
 *
 * This module centralizes all of these behaviors and ensures that assignment is
 * type-safe, memory-safe, and consistent across the language.
 * 
 */
pub mod BinaryAffectValidation {

    /**
     * Validate an assignment expression.
     *
     * Dispatches based on the shape of the left operand:
     *
     *   - index assignment (a[i] = b)
     *   - field assignment (a.x = b)
     *   - simple variable assignment (a = b)
     *
     * Steps:
     *   1. Detect index assignment via MultOperatorExpr.
     *   2. Detect field assignment via BinaryExpr with FIELD operator.
     *   3. Otherwise, validate left value and forward to validate(loc, op, left, right).
     *
     * @params:
     *   - context: validation context
     *   - bin:     binary assignment expression
     *   - op:      assignment operator (=, +=, etc.)
     *
     * @returns:
     *   A &Value representing the validated assignment.
     *
     * @throws:
     *   ErrorMsg if validation fails.
     */
    pub fn validate (dmut context: &ValidationContext, bin: &BinaryExpr, op: BinaryOperators)-> &Value
        throws ErrorMsg
    {            
        // Affection can be an index assign operation (i.e. obj [index] = value)
        if let m: &MultOperatorExpr = bin.left && m.isIndex {
            return BinaryAffectValidation::validateIndexAssign (alias context, op, m, bin);
        } 

        // Or a field affect (obj.field = value)
        if let bL: &BinaryExpr = bin.left {
            let (_, type) = binary::kind::toOperator (bL.loc, bL.op);
            if type == binary::kind::OperatorType::FIELD {
                // we try the operation rewrite, applicable only on class instances
                return BinaryAffectValidation::validateFieldAssign (alias context, op, bL, bin);                
            }            
        }

        
        let left = ValueValidation::validate (alias context, bin.left, noReduce-> true);
        return BinaryAffectValidation::validate (alias context, bin.loc, op, left, bin.right);        
    }

    /**
     * Validate assignment when the left operand is already a validated value.
     *
     * Handles:
     *   - slice append (a ~= b)
     *   - affect operators (+=, -=, etc.)
     *   - simple assignment (a = b)
     *
     * Steps:
     *   1. Verify left operand is movable if needed.
     *   2. Handle slice append specially.
     *   3. Validate right operand via validateRight().
     *   4. Forward to validate(loc, left, rightValue).
     *
     * @returns:
     *   A &Value representing the assignment.
     */
    pub fn validate (dmut context: &ValidationContext, loc: &Word, op: BinaryOperators, left: &Value, right: &Expression)-> &Value
        throws ErrorMsg
    {
        MemoryVerification::verifyLeftOperandMove (loc, left);
        if let s: &SliceType = left.type && op == BinaryOperators::TILDE { // a ~= [1];
            let rightV = ValueValidation::validate (alias context, right);
            return BinaryAffectValidation::validateSliceAppend (alias context, loc, s, left, rightV);
        }

        let rightV = BinaryAffectValidation::validateRight (alias context, loc, op, left, right);
        return BinaryAffectValidation::validate (alias context, loc, left, rightV);
    }

    /**
     * Final stage of assignment validation.
     *
     * Handles:
     *   - slice concatenation rewrite (a = a ~ b)
     *   - memory-ownership verification
     *   - move semantics
     *   - plain assignment
     *
     * If the left type is movable and has a destructor, a destructor call is
     * inserted before the assignment.
     *
     * @returns:
     *   A &Value representing the final assignment.
     */
    fn validate (dmut context: &ValidationContext, loc: &Word, left: &Value, right: &Value)-> &Value
        throws ErrorMsg
    {
        // a = a ~ [1];
        if let (s: &SliceType, concat: &SliceConcatValue) = (left.type, right) && concat.left == left {  
            return BinaryAffectValidation::validateSliceAppend (alias context, loc, s, left, concat.right);
        }

        MemoryVerification::verifyMemoryOwner (loc, left.type, right, construct-> false, byReference-> false);
        if left.type.isMovable {
            return BinaryAffectValidation::validateMove (loc, left, right);
        }

        return copy AffectValue (loc, left.type, left, right);
    }

    /**
     * Validate the right operand of an assignment.
     *
     * For affect operators (+=, -=, etc.):
     *   - validate right operand
     *   - apply implicit cast for int/float types
     *   - compute (left <op> right)
     *   - cast result back to left.type
     *
     * For simple assignment (=):
     *   - validate right operand
     *   - cast to left.type if needed
     *
     * @returns:
     *   A &Value representing the validated right operand.
     */
    fn validateRight (dmut context: &ValidationContext,
                      loc:          &Word,
                      op:           BinaryOperators,
                      left:         &Value,
                      right:        &Expression)-> &Value
        throws ErrorMsg
    {
        // The right operand can be a math operation (e.g. a += 1, b /= 98)
        if (op != BinaryOperators::EQUAL) {
            let realRight = ValueValidation::validate (alias context, right);

            // we want to be able to validate: { let i: i8 = 1i8; i += 1; },
            // only valid for a few types, (float, int)
            // 
            let castedRight = if BinaryAffectValidation::canImplicitCast (left.type) {
                // so we need to take that into account immediately, because (i + 1) is of type i32, and not cte
                TypeInference::inferValueForType (alias context, loc, realRight, left.type, byReference-> false) 
            } else {
                realRight
            };
            
            let res = BinaryValidation::validate (alias context, loc, op, left, castedRight);
            return TypeInference::inferValueForType (alias context, loc, res, left.type, byReference-> false);
        }

        // else it is just a standard affectation, so right is directly right
        let rightV = ValueValidation::validate (alias context, right);

        // verify the type compatibility, and return the casted value if needed        
        return TypeInference::inferValueForType (alias context, loc, rightV, left.type, byReference-> false); 
    }

    /**
     * Validate an index assignment expression:
     *
     *     a[i] = v
     *     a[i] += v
     *
     * Dispatches based on the type of the indexed object:
     *
     *   - ClassPtrType => validateIndexClass()
     *   - MapType      => validateIndexMap()
     *   - Otherwise    => slice/array index assignment
     *
     * @params:
     *   - context:   validation context
     *   - op:        assignment operator (=, +=, etc.)
     *   - leftExpr:  the index expression (a[i])
     *   - bin:       the full binary assignment expression
     *
     * @returns:
     *   A &Value representing the validated index assignment.
     *
     * @throws:
     *   ErrorMsg if validation fails or aliasing rules are violated.
     */
    fn validateIndexAssign (dmut context: &ValidationContext,
                            op:           BinaryOperators,
                            leftExpr:     &MultOperatorExpr,
                            bin:          &BinaryExpr)-> &Value
        throws ErrorMsg
    {                
        let mut leftIndex = ValueCreation::createEnumUnwrap (ValueValidation::validate (alias context, leftExpr.left));
        if leftExpr.op == MultOperators::INDEX_AND {
            throw copy ErrorMsg::fatal (leftExpr.loc,
                                        end-> bin.loc,
                                        format (ValidateErrorMessage::UNECESSARY_ALIAS_FIELD_METHOD, leftIndex.type));
        }        
        
        // Index assign can be overriden for classes
        if leftIndex.type of ClassPtrType {
            return BinaryAffectValidation::validateIndexClass (alias context, op, leftIndex, leftExpr, bin);
        }                 

        // Needs a special treatment on maps
        if leftIndex.type of MapType {
            return BinaryAffectValidation::validateIndexMap (alias context, op, leftIndex, leftExpr, bin);            
        }

        // Otherwise it is just an affectation of a slice/array access
        let left = IndexValidation::validate (alias context,
                                              leftExpr.loc,
                                              object-> ValueCreation::createEnumUnwrap (leftIndex),
                                              indices-> leftExpr.rights,
                                              inCopy-> false);
        
        return BinaryAffectValidation::validate (alias context, bin.loc, op, left, bin.right);                    
    }

    /**
     * Validate index assignment on a class instance.
     *
     * Class types may override index access and assignment via
     * ClassIndexValidation. This function handles both:
     *
     *   - simple assignment:   a[i] = v
     *   - affect assignment:   a[i] += v    
     *
     * @params:
     *   - context:   validation context
     *   - op:        assignment operator
     *   - object:    validated left-hand object (class pointer)
     *   - leftExpr:  the index expression (a[i])
     *   - bin:       the full binary assignment expression
     *
     * @returns:
     *   A &Value representing the validated class index assignment.
     *
     * @throws:
     *   ErrorMsg if class index access or assignment fails.
     */
    fn validateIndexClass (dmut context: &ValidationContext,
                           op:           BinaryOperators,                           
                           object:       &Value,
                           leftExpr:     &MultOperatorExpr,
                           bin:          &BinaryExpr)-> &Value
        throws ErrorMsg
    {                
        let right = if op != BinaryOperators::EQUAL {
            let rightIndex = ClassIndexValidation::validate (alias context,
                                                             leftExpr.loc,                                                             
                                                             object-> object,
                                                             indices-> leftExpr.rights,
                                                             implicitAlias-> true);

            BinaryAffectValidation::validateRight (alias context, bin.loc, op, rightIndex, bin.right)
        } else {
            ValueValidation::validate (alias context, bin.right)
        };
        
        return ClassIndexValidation::validateAssign (alias context,
                                                     leftExpr.loc,                                                                                                                    
                                                     object-> object,
                                                     indices-> leftExpr.rights,
                                                     assign-> right);
    }

    /**
     * Validate index assignment on a map:
     *
     *     map[key] = value
     *     map[key] += value
     *
     * Map index assignment has its own semantics and is handled via
     * MapIndexValidation.     
     *
     * @params:
     *   - context:   validation context
     *   - op:        assignment operator
     *   - object:    validated left-hand object (map)
     *   - leftExpr:  the index expression (map[key])
     *   - bin:       the full binary assignment expression
     *
     * @returns:
     *   A &Value representing the validated map index assignment.
     *
     * @throws:
     *   ErrorMsg if map index access or assignment fails.
     *   
     */
    fn validateIndexMap (dmut context: &ValidationContext,
                         op:           BinaryOperators,                         
                         object:       &Value,
                         leftExpr:     &MultOperatorExpr,
                         bin:          &BinaryExpr)-> &Value
        throws ErrorMsg
    {            
        let right = if op != BinaryOperators::EQUAL {
            let rightIndex = MapIndexValidation::validate (alias context,
                                                           leftExpr.loc,                                                             
                                                           object-> ValueCreation::createEnumUnwrap (object),
                                                           indices-> leftExpr.rights);

            BinaryAffectValidation::validateRight (alias context, bin.loc, op, rightIndex, bin.right)
        } else {
            ValueValidation::validate (alias context, bin.right)
        };
        
        return MapIndexValidation::validateAssign (alias context,
                                                   leftExpr.loc,                                                                                                           
                                                   object-> object,
                                                   indices-> leftExpr.rights,
                                                   assign-> right);
    }
    
    /**
     * Validate field assignment:
     *
     *     a.x = b
     *     a.x += b
     *
     * Handles:
     *   - class setter methods (preferred)
     *   - direct field assignment (fallback)
     *
     * Steps:
     *   1. Validate the object (a).
     *   2. Attempt setter-method assignment via validateFieldSetter().
     *   3. If setter fails, attempt direct field assignment.
     *   4. If both fail, combine errors.
     *
     * @returns:
     *   A &Value representing the field assignment.
     */
    fn validateFieldAssign (dmut context: &ValidationContext,
                            op:           BinaryOperators,
                            leftExpr:     &BinaryExpr,
                            bin:          &BinaryExpr)-> &Value
        throws ErrorMsg
    {
        let leftIndex = ValueCreation::createEnumUnwrap (ValueValidation::validate (alias context, leftExpr.left));

        // Try to find vtable assign index elements
        if let cptr: &ClassPtrType =  leftIndex.type {
            let mut error: (&ErrorMsg)? = none;            
            if !cptr.inner.hasTypeInfo {
                let dmut sym = context:.getClassFromRef (cptr.inner.sym);
                ClassValidation::validateLayout (alias context, alias sym);                
            }
            
            // 1. try to using a class access/assign methods 
            {
                // Call a:.foo (a.foo () + value);
                return BinaryAffectValidation::validateFieldSetter (alias context, cptr, op, leftIndex, leftExpr, bin);                                         
            } catch {
                // failed to validate field method assign
                err: &ErrorMsg => {                    
                    if err.isNote () {
                        error = (err.asFatal ())?;
                    } else error = (err)?;
                }
            }

            // 2. try access basic field from class object
            {
                // a.foo = a.foo + value;
                return BinaryAffectValidation::validateFieldAffect (alias context, cptr, op, leftIndex, leftExpr, bin);                
            } catch {
                err: &ErrorMsg => {                    
                    if let Ok (prev) = error {
                        throw copy ErrorMsg::list (copy [prev, err]);
                    }

                    throw err;
                }
            }
        }
        
        let left = ValueValidation::validate (alias context, bin.left, noReduce-> true);
        return BinaryAffectValidation::validate (alias context, bin.loc, op, left, bin.right);        
    }


    /**
     * Validate assignment via class setter method.
     *
     * Example rewrite:
     *     a.x += v
     * becomes:
     *     a:.x(a.x() + v)
     *
     * Steps:
     *   1. Validate vtable access for setter.
     *   2. If op != '=', compute right side via affect operator.
     *   3. Call setter with computed value.
     *
     * @returns:
     *   A &Value representing the setter call.
     */
    fn validateFieldSetter (dmut context: &ValidationContext,
                            cptr:         &ClassPtrType,
                            op:           BinaryOperators,
                            leftIndex:    &Value,
                            leftExpr:     &BinaryExpr,
                            bin:          &BinaryExpr)-> &Value
        throws ErrorMsg
    {        
        let leftMeth = ClassVtableAccessValidation::validate (alias context,
                                                              loc-> leftExpr.loc,
                                                              object-> leftIndex,
                                                              cref-> cptr.inner,
                                                              method-> leftExpr.right,                                                              
                                                              isProxy-> TypeVerification::isSuperProxy (leftIndex),
                                                              assign-> true,
                                                              inCall-> false);
        
        let right = if op != BinaryOperators::EQUAL {
            let rightMeth = ClassVtableAccessValidation::validate (alias context,
                                                                   loc-> leftExpr.loc,
                                                                   object-> leftIndex,
                                                                   cref-> cptr.inner,
                                                                   method-> leftExpr.right,                                                                   
                                                                   isProxy-> TypeVerification::isSuperProxy (leftIndex),                                                                         
                                                                   assign-> false,
                                                                   inCall-> false);
            
            BinaryAffectValidation::validateRight (alias context, bin.loc, op, rightMeth, bin.right)
        } else {
            ValueValidation::validate (alias context, bin.right)
        };

        return CallValidation::validate (alias context, bin.loc, leftMeth, copy [right]);
    }

    /**
     * Validate direct field assignment when no setter method applies.
     *
     * Example:
     *     a.x = v
     *
     * Steps:
     *   1. Validate field access.
     *   2. Perform assignment via validate(loc, field, right).
     *
     * @returns:
     *   A &Value representing the field assignment.
     */
    fn validateFieldAffect (dmut context: &ValidationContext,
                            cptr:         &ClassPtrType,
                            op:           BinaryOperators,
                            leftIndex:    &Value,
                            leftExpr:     &BinaryExpr,
                            bin:          &BinaryExpr)-> &Value
        throws ErrorMsg
    {              
        let field = ClassDynamicFieldValidation::validateField (alias context,
                                                                loc-> leftExpr.loc,
                                                                object-> leftIndex,
                                                                cref-> cptr.inner,
                                                                field-> leftExpr.right);
        
        return BinaryAffectValidation::validate (alias context, bin.loc, op, field, bin.right);
    }

    /**
     * Validate slice append:
     *
     *     a ~= b
     *
     * Handles:
     *   - appending slices
     *   - appending arrays (converted to slice alias)
     *   - type inference and casting
     *   - memory-ownership verification
     *
     * Produces:
     *   - SliceAppendValue for the append operation
     *   - VOID-typed SliceAppendValue for the assignment result
     *
     * @returns:
     *   A &Value representing the append assignment.
     */
    pub fn validateSliceAppend (dmut context: &ValidationContext,
                                loc:          &Word,
                                stype:        &SliceType,
                                left:         &Value,
                                right:        &Value)-> &Value
        throws ErrorMsg
    {
        let finRight = {
            let finRight = match right.type {
                SliceType () => { right }
                a: &ArrayType => {
                    ValueCreation::createSliceAliasFromArray (loc, a, right)
                }
                _ => { throw copy ErrorMsg::list ([]); }
            };

            TypeInference::inferValueForType (alias context, loc, finRight, left.type, byReference-> false)
        } catch {
            err: &ErrorMsg => {
                throw copy ErrorMsg::fatal (loc,
                                            format (ValidateErrorMessage::UNDEFINED_BIN_OP, Tokens::TILDE, left.type, right.type),
                                            notes-> copy [err]);
            }
        };

        let slc = copy SliceAppendValue (loc, stype, left, finRight);
        MemoryVerification::verifyMemoryOwner (loc, stype, slc, construct-> false, byReference-> false);

        return copy SliceAppendValue (loc, VOID_TYPE, left, finRight);
    }
    
    /**
     * Validate move assignment for movable types.
     *
     * If the type has a destructor:
     *   - generate a conditional destructor call
     *   - then perform the assignment
     *
     * Otherwise:
     *   - perform a plain assignment
     *
     * @returns:
     *   A &Value representing the move assignment.
     */
    fn validateMove (loc: &Word, left: &Value, right: &Value)-> &Value
        throws ErrorMsg
    {        
        if let c: &ClassPtrType = left.type {            
            if let dtor: &DtorPrototypeValue = c.inner.dtor { 
                let methDg = copy MethodDelegateValue (loc,
                                                       dtor,
                                                       closure-> left,
                                                       direct-> true,
                                                       vtableIndex-> 0us,
                                                       isStruct-> true);
                
                let lSet = copy StructFieldAccessValue (loc, BOOL_TYPE, left, ClassKeys::SET);
                let call = copy MethodCallValue (loc, VOID_TYPE, methDg, []);
                // if field.#_set { __dtor (field); } .. no need to set #_set, since we reaffect the value just after

                let cond = copy ConditionalValue (loc, VOID_TYPE, lSet, call, UNIT_VALUE);
                // And we don't have to reset left #_set, since it is or a ctor or a mover

                let values = copy [cond, copy AffectValue (loc, VOID_TYPE, left, right)];
                return copy BlockValue (loc, VOID_TYPE, values);
            }
        }

        // No dtor found, thus we just return the affectation
        return copy AffectValue (loc, VOID_TYPE, left, right);
    }

    /**
     * Determine whether affect operators may implicitly cast the right
     * operand to match the left operand.
     *
     * Allowed for:
     *   - IntType
     *   - FloatType
     *
     * @returns:
     *   true if implicit cast is allowed, false otherwise.
     */
    fn canImplicitCast (type: &Type)-> bool {
        match type {
            IntType () => { true }
            FloatType () => { true }
            _ => { false }
        }
    }
    
}
