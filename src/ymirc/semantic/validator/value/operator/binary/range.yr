 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in range;

use ymirc::lexing::{word, tokens, keys};

use ymirc::syntax::expression::_;
use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::errors::message;
use ymirc::utils::{format, bigint};
use ymirc::global::core_;

/**
 * BinaryRangeValidation
 *
 * Provides semantic validation for range construction expressions:
 *
 *      a .. b
 *      a ... b
 *
 * This module defines the complete semantics of range construction in Ymir.
 */
pub mod BinaryRangeValidation {

    /**
     * Validate a range construction expression.
     *
     * @params:
     *   - context: the validation context
     *   - bin:     the binary expression node
     *   - op:      the range operator(TDOT or TDOT_EQUAL)
     *
     * @returns:
     *   A &Value representing the validated range expression.
     */
    pub fn validate(dmut context: &ValidationContext, bin: &BinaryExpr, op: BinaryOperators)-> &Value
        throws ErrorMsg
    {
        return BinaryRangeValidation::validate(alias context, bin.loc, op,
                                                left-> ValueValidation::validate(alias context, bin.left),
                                                right-> ValueValidation::validate(alias context, bin.right));
    }

    /**
     * Validate a range expression after both operands have been validated.
     *
     * Enum values are unwrapped before validation so that the operator applies
     * to the underlying integer or class value.
     *
     * @params:
     *   - context: the validation context
     *   - loc:     operator location
     *   - op:      range operator
     *   - left:    validated left operand
     *   - right:   validated right operand
     *
     * @returns:
     *   A &Value representing the validated range expression.
     */
    pub fn validate(dmut context: &ValidationContext,
                     loc:          &Word,
                     op:           BinaryOperators,
                     left:         &Value,
                     right:        &Value)-> &Value
        throws ErrorMsg
    {
        return BinaryRangeValidation::validateImpl(alias context, loc, op,
                                                    left-> ValueCreation::createEnumUnwrap(left),
                                                    right-> ValueCreation::createEnumUnwrap(right));
    }

    /**
     * Core implementation of range construction validation.
     *
     * Dispatch strategy:
     *   1. Try validating based on the left operand type:
     *        - IntType => validateIntLeft()
     *        - ClassPtrType => class operator overload
     *
     *   2. If left-side validation fails, try class-specific overload on the right.
     *
     *   3. If both fail, emit a fatal UNDEFINED_BIN_OP error with aggregated notes.
     *
     * @params:
     *   - context: the validation context
     *   - loc:     operator location
     *   - op:      range operator
     *   - left:    validated left operand
     *   - right:   validated right operand
     *
     * @returns:
     *   A &Value representing the validated range expression.
     */
    fn validateImpl(dmut context: &ValidationContext,
                     loc:          &Word,
                     op:           BinaryOperators,
                     left:         &Value,
                     right:        &Value)-> &Value
        throws ErrorMsg
    {
        let mut errors: [&ErrorMsg] = [];
        {
            match left.type {
                IntType() => {
                    return BinaryRangeValidation::validateIntLeft(alias context, loc, op, left, right);
                }
                c: &ClassPtrType => {
                    return BinaryRangeValidation::validateClassLeft(alias context, loc, op, left, c, right);
                }
            }
        } catch {
            err: &ErrorMsg => {
                errors ~= [err];
            }
        }

        {
            match right.type {
                c: &ClassPtrType => {
                    return BinaryRangeValidation::validateClassRight(alias context, loc, op, left, right, c);
                }
            }
        } catch {
            err: &ErrorMsg => {
                errors ~= [err];
            }
        }

        throw copy ErrorMsg::fatal(loc,
                                    format(ValidateErrorMessage::UNDEFINED_BIN_OP, op, left.type, right.type),
                                    notes-> errors);

    }

    /**
     * Validate range construction where the left operand is an integer.
     *
     * Behavior:
     *   - Infer a common integer type for both endpoints using
     *       inferValuesForBranch().
     *
     *   - Construct a RangeType using the inferred integer type.
     *
     *   - Determine whether the range is inclusive:
     *         op == TDOT => exclusive
     *         op == TDOT_EQUAL => inclusive
     *
     *   - Compute the step direction using a conditional:
     *         if left <= right => step = +1
     *         else => step = -1
     *
     *     This ensures that:
     *         1 .. 10   steps forward
     *         10 .. 1   steps backward
     *
     *   - Reduce the step expression via cteInterpret to fold constants.
     *
     *   - Construct a RangeValue containing:
     *         - start value
     *         - end value
     *         - computed step
     *         - inclusiveness flag
     *
     * @params:
     *   - context: the validation context
     *   - loc:     operator location
     *   - op:      range operator(TDOT or TDOT_EQUAL)
     *   - left:    validated left integer
     *   - right:   validated right operand
     *
     * @returns:
     *   A RangeValue representing the constructed range.
     */
    fn validateIntLeft(dmut context: &ValidationContext,
                        loc:          &Word,
                        op:           BinaryOperators,
                        left:         &Value,
                        right:        &Value)-> &Value
        throws ErrorMsg
    {
        // The type of the range takes the biggest of the two elements
        let (ty, lvalue, rvalue) = TypeInference::inferValuesForBranch(alias context, loc, left, right);
        if let ti: &IntType = ty {
            let rngType = copy RangeType(loc, ti, isMutable-> false);
            let include = copy BoolValue(loc, isTrue-> (op == BinaryOperators::TDOT));

            let cmp = copy CmpIntOperatorValue(loc, BinaryOperators::INF_EQUAL, lvalue, rvalue);
            let condStep = copy ConditionalValue(loc, rngType.step, cmp,
                                                  copy IntValue(loc, rngType.step, 1us),
                                                  copy IntValue(loc, rngType.step, copy BigInt(-1)));

            let step = context.cteInterpret:.reduce(condStep);
            return copy RangeValue(loc, rngType, lvalue, rvalue, step-> step, isFull-> include);
        }

        throw copy ErrorMsg::list([]);
    }

    /**
     * Validate range construction where the left operand is a class pointer.
     *
     * @params:
     *   - context: validation context
     *   - loc:     operator location
     *   - op:      range operator
     *   - left:    validated left operand(class instance)
     *   - cptr:    class pointer type of the left operand
     *   - right:   validated right operand
     *
     * @returns:
     *   A &Value representing the class-defined range expression.
     *
     * @throws:
     *   ErrorMsg if the RANGE override is malformed or validation fails.
     */
    pub fn validateClassLeft(dmut context: &ValidationContext,
                              loc:          &Word,
                              op:           BinaryOperators,
                              left:         &Value,
                              cptr:         &ClassPtrType,
                              right:        &Value)-> &Value
        throws ErrorMsg
    {
        let contains = copy BoolValue(loc, op == BinaryOperators::TDOT);
        let meth = ValueCreation::createObjectMethodAcc(alias context, loc, cptr, left, OpOverrideNames::RANGE);
        let templ = TemplateValidation::validateCall(alias context, loc, meth, copy [contains]);

        return CallValidation::validate(alias context, loc, templ, copy [right]);
    }

    /**
     * Validate range construction where the right operand is a class pointer.
     *
     * @params:
     *   - context: validation context
     *   - loc:     operator location
     *   - op:      range operator
     *   - left:    validated left operand
     *   - right:   validated right operand(class instance)
     *   - cptr:    class pointer type of the right operand
     *
     * @returns:
     *   A &Value representing the class-defined range expression.
     *
     * @throws:
     *   ErrorMsg if the RANGE_RIGHT override is malformed or validation fails.
     */
    pub fn validateClassRight(dmut context: &ValidationContext,
                               loc:          &Word,
                               op:           BinaryOperators,
                               left:         &Value,
                               right:        &Value,
                               cptr:         &ClassPtrType)-> &Value
        throws ErrorMsg
    {
        let contains = copy BoolValue(loc, op == BinaryOperators::TDOT);
        let meth = ValueCreation::createObjectMethodAcc(alias context, loc, cptr, right, OpOverrideNames::RANGE_RIGHT);
        let templ = TemplateValidation::validateCall(alias context, loc, meth, copy [contains]);

        return CallValidation::validate(alias context, loc, templ, copy [left]);
    }


}
