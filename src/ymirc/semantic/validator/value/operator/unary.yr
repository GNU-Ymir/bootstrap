in unary;

use ymirc::lexing::{word, keys};
use ymirc::syntax::expression::operator;
use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::global::_;

use ymirc::errors::message;
use ymirc::utils::format;

use ymirc::semantic::validator::value::operator::unary::_;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

mod ::minus;
mod ::star;
mod ::and;

pub mod ::not;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          ROOT          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * UnaryValidation
 *
 * Central dispatcher for all unary operators in Ymir:
 *
 *      -value
 *      &value
 *      *value
 *      !value
 *
 *
 */
pub mod UnaryValidation {

    /**
     * Validate a unary expression by dispatching to the appropriate operator validator.
     *
     * @params:
     *   - context: validation context
     *   - op:      unary expression to validate
     *
     * @returns:
     *   A &Value representing the result of the unary operation.
     *
     * @throws:
     *   ErrorMsg if the operator is unsupported or if the delegated validator fails.
     */
    pub fn validate(dmut context: &ValidationContext, op: &UnaryExpr)-> &Value
        throws ErrorMsg
    {
        match op.op {
            UnaryOperators::MINUS => {
                return UnaryMinusValidation::validate(alias context, op);
            }
            UnaryOperators::AND => {
                return UnaryAndValidation::validate(alias context, op);
            }
            UnaryOperators::STAR => {
                return UnaryStarValidation::validate(alias context, op);
            }
            UnaryOperators::NOT => {
                return UnaryNotValidation::validate(alias context, op);
            }
        }

        throw copy ErrorMsg::fatal(op.loc, format(ValidateErrorMessage::UNDEFINED_UN_OP_TOK, op.op));
    }

    /**
     * Validate a unary operator applied to a custom type value.
     * This implements class-specific unary operator overloading.
     *
     * @params:
     *   - context: validation context
     *   - loc:     operator location
     *   - op:      unary operator token
     *   - value:   class pointer value
     *   - cptr:    class pointer type
     *
     * @returns:
     *   A &Value representing the result of the overloaded unary operation.
     *
     * @throws:
     *   ErrorMsg if the operator override cannot be resolved or the call fails.
     */
    pub fn validateClass(dmut context: &ValidationContext, loc: &Word, op: UnaryOperators, value: &Value, cptr: &ClassPtrType)-> &Value
        throws ErrorMsg
    {
        let str = copy StringValue(loc, op);
        let meth = ValueCreation::createObjectMethodAcc(alias context, loc, cptr, value, OpOverrideNames::UNARY);
        let templ = TemplateValidation::validateCall(alias context, loc, meth, copy [str]);

        return CallValidation::validate(alias context, loc, templ, copy []);
    }

}
