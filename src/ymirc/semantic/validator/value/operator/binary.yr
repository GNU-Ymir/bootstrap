 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in binary;

use ymirc::lexing::{word, tokens, keys};

use ymirc::syntax::expression::operator;
use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::errors;
use ymirc::global::_;

use ymirc::semantic::validator::value::operator::binary::_;
use ymirc::utils::format;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub mod ::affect;
pub mod ::bitwise;
pub mod ::compare;
pub mod ::logical;
pub mod ::math;
pub mod ::class_;
pub mod ::range;
pub mod ::contains;
pub mod ::concat;
pub mod ::type;
pub mod ::option;

mod ::kind;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          ROOT          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * BinaryValidation
 *
 * Provides the global dispatcher for all binary operator validation.
 *
 * The validator:
 *   - resolves the real operator and its semantic category
 *   - detects affectation operators and forwards to BinaryAffectValidation
 *   - dispatches to the correct Binary*Validation module:
 *        - Math
 *        - Bitwise
 *        - Contains
 *        - Concat
 *        - Comparison
 *        - Logical
 *        - Range
 *        - Class
 *        - Type
 *        - Field
 *        - Module
 *        - Option
 *
 *   - supports class operator overloading via:
 *        - BIN      (left operand overload)
 *        - BIN_RIGHT(right operand overload)
 *
 * This module defines the top-level semantics of binary operators in Ymir.
 */
pub mod BinaryValidation {

    /**
     * Validate a binary expression by dispatching to the correct operator
     * validator based on its semantic category.
     *
     * @params:
     *   - context: validation context
     *   - bin:     binary expression to validate
     *
     * @returns:
     *   A &Value representing the validated binary expression.
     *
     * @throws:
     *   ErrorMsg if the operator is undefined or validation fails.
     */
    pub fn validate(dmut context: &ValidationContext, bin: &BinaryExpr)-> &Value
        throws ErrorMsg
    {
        let (real, type) = binary::kind::toOperator(bin.loc, bin.op);
        if binary::kind::isAffect(bin.op) {
            return BinaryAffectValidation::validate(alias context, bin, real);
        }

        match type {
            OperatorType::MATH => {
                return BinaryMathValidation::validate(alias context, bin, real);
            }
            OperatorType::BITWISE => {
                return BinaryBitwiseValidation::validate(alias context, bin, real);
            }
            OperatorType::CONTAINS => {
                return BinaryContainsValidation::validate(alias context, bin, real);
            }
            OperatorType::CONCAT => {
                return BinaryConcatValidation::validate(alias context, bin, real);
            }
            OperatorType::COMPARISON => {
                return BinaryComparisonValidation::validate(alias context, bin, real);
            }
            OperatorType::LOGICAL => {
                return BinaryLogicalValidation::validate(alias context, bin, real);
            }
            OperatorType::RANGE => {
                return BinaryRangeValidation::validate(alias context, bin, real);
            }
            OperatorType::CLASS => {
                return BinaryClassValidation::validate(alias context, bin, real);
            }
            OperatorType::TYPE => { // of and !of, cannot be an affectation
                return BinaryTypeValidation::validate(alias context, bin, real);
            }
            OperatorType::FIELD => {
                return FieldValidation::validate(alias context, bin, real);
            }
            OperatorType::MODULE => {
                return PathValidation::validate(alias context, bin);
            }
            OperatorType::OPTION => {
                return BinaryOptionValidation::validate(alias context, bin, real);
            }
            _ => {
                panic;
            }
        }
    }

    /**
     * Validate a binary expression given explicit operands and operator.
     *
     * This overload is used internally when the caller already has validated
     * left/right operands and wants to reuse the dispatch logic.
     *
     * @params:
     *   - context: validation context
     *   - loc:     operator location
     *   - op:      operator as written in the source
     *   - left:    validated left operand
     *   - right:   validated right operand
     *
     * @returns:
     *   A &Value representing the validated binary expression.
     *
     * @throws:
     *   ErrorMsg if the operator is undefined for value/value operands.
     */
    pub fn validate(dmut context: &ValidationContext, loc: &Word, op: BinaryOperators, left: &Value, right: &Value)-> &Value
        throws ErrorMsg
    {
        let (real, type) = binary::kind::toOperator(loc, op);
        if binary::kind::isAffect(op) {
            return BinaryAffectValidation::validate(alias context, loc, real, left, copy ValueWrapperExpr(right.loc, right));
        }

        match type {
            OperatorType::MATH => {
                return BinaryMathValidation::validate(alias context, loc, real, left, right);
            }
            OperatorType::BITWISE => {
                return BinaryBitwiseValidation::validate(alias context, loc, real, left, right);
            }
            OperatorType::CONTAINS => {
                return BinaryContainsValidation::validate(alias context, loc, real, left, right);
            }
            OperatorType::CONCAT => {
                return BinaryConcatValidation::validate(alias context, loc, real, left, right);
            }
            OperatorType::COMPARISON => {
                return BinaryComparisonValidation::validate(alias context, loc, real, left, right);
            }
            OperatorType::LOGICAL => {
                return BinaryLogicalValidation::validate(alias context, loc, real, left, right);
            }
            OperatorType::RANGE => {
                return BinaryRangeValidation::validate(alias context, loc, real, left, right);
            }
            OperatorType::CLASS => {
                return BinaryClassValidation::validate(alias context, loc, real, left, right);
            }
            OperatorType::OPTION => {
                return BinaryOptionValidation::validate(alias context, loc, real, left, right);
            }
            _ => {
                // Some operators are ignored, because they can't be made using two values(e.g. type check, or field access)
                throw copy ErrorMsg::fatal(loc,
                                            format(ValidateErrorMessage::UNDEFINED_BIN_OP, op, left.type, right.type));
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==============================          GLOBAL CLASS BINARY          ===============================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Validate a class-specific binary operator where the class instance
     * appears on the left side.
     *
     * The overload mechanism:
     *   - Convert the operator into a string literal.
     *   - Access the BIN overload method on the class instance.
     *   - Instantiate the template with the operator string.
     *   - Call the resulting method with the right operand.
     *
     * This corresponds to:
     *      left.opBinary!{op}(right)
     *
     * @params:
     *   - context: validation context
     *   - loc:     operator location
     *   - op:      operator being applied
     *   - left:    class instance on the left side
     *   - cptr:    class pointer type of the left operand
     *   - right:   validated right operand
     *
     * @returns:
     *   A &Value representing the overloaded operator call.
     */
    pub fn validateClassLeft(dmut context: &ValidationContext,
                              loc:          &Word,
                              op:           BinaryOperators,
                              left:         &Value,
                              cptr:         &ClassPtrType,
                              right:        &Value)-> &Value
        throws ErrorMsg
    {
        let str = copy StringValue(loc, op);
        let meth = ValueCreation::createObjectMethodAcc(alias context, loc, cptr, left, OpOverrideNames::BIN);
        let templ = TemplateValidation::validateCall(alias context, loc, meth, copy [str]);

        return CallValidation::validate(alias context, loc, templ, copy [right]);
    }

    /**
     * Validate a class-specific binary operator where the class instance
     * appears on the right side.
     *
     * The overload mechanism:
     *   - Convert the operator into a string literal.
     *   - Access the BIN_RIGHT overload method on the class instance.
     *   - Instantiate the template with the operator string.
     *   - Call the resulting method with the left operand.
     *
     * This corresponds to:
     *      right.opBinaryRight!{op}(left)
     *
     * @params:
     *   - context: validation context
     *   - loc:     operator location
     *   - op:      operator being applied
     *   - left:    validated left operand
     *   - right:   class instance on the right side
     *   - cptr:    class pointer type of the right operand
     *
     * @returns:
     *   A &Value representing the overloaded operator call.
     */
    pub fn validateClassRight(dmut context: &ValidationContext,
                               loc:          &Word,
                               op:           BinaryOperators,
                               left:         &Value,
                               right:        &Value,
                               cptr:         &ClassPtrType)-> &Value
        throws ErrorMsg
    {
        let str = copy StringValue(loc, op);
        let meth = ValueCreation::createObjectMethodAcc(alias context, loc, cptr, right, OpOverrideNames::BIN_RIGHT);
        let templ = TemplateValidation::validateCall(alias context, loc, meth, copy [str]);

        return CallValidation::validate(alias context, loc, templ, copy [left]);
    }


}
