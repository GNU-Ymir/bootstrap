/*
 * Implements semantic validation for the path operator `::` in Ymir.
 *
 * The path operator is used for:
 *   - namespace and module access
 *   - type-scoped lookup(e.g. Enum::Variant, Class::StaticField)
 *   - value-scoped lookup(e.g. object::member)
 *
 * The left operand of `::` may be:
 *   - a value
 *   - a type
 *   - both simultaneously(e.g. a class name that is also a module)
 *
 * This module attempts both interpretations independently and aggregates
 * all valid resolutions. If multiple symbols match, a MultSymValue is
 * produced to represent overload sets or ambiguous symbol groups.
 *
 * Submodules implement specialized lookup for each category of type/value:
 *   array, bool, char, class, enum, float, int, map, option, pointer,
 *   range, slice, tuple.
 *
 * This file defines the root dispatcher for the `::` operator.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::value::operator::path
 * @File: ymirc/semantic/validator/value/operator/path.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-03-27
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in path;

use ymirc::lexing::{word, keys};
use ymirc::semantic::{validator, symbol};

use ymirc::syntax::{_, declaration::_, expression::_};
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::errors::message;
use ymirc::utils::format;

use ymirc::semantic::validator::value::operator::path::_;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub mod ::class_;
pub mod ::enum_;

mod ::value;
mod ::type;

mod ::array;
mod ::bool_;
mod ::char;
mod ::float;
mod ::int;
mod ::map;
mod ::option;
mod ::pointer;
mod ::range;
mod ::slice;
mod ::tuple;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          ROOT          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * PathValidation
 *
 * Root validator for the path operator `::`.
 *
 * Responsibilities:
 *   - Attempt to interpret the left operand as a value.
 *   - Attempt to interpret the left operand as a type.
 *   - Dispatch to PathValueValidation or PathTypeValidation accordingly.
 *   - Aggregate all successful resolutions.
 *   - Aggregate all errors from failed interpretations.
 *   - Produce a MultSymValue when multiple symbols match.
 *
 * The validator supports cases where the left operand is both a value and a
 * type(e.g. a class name that is also a module). Both interpretations are
 * attempted independently.
 *
 */
pub mod PathValidation {

    /**
     * Validate a path expression represented as a PathExpr node.
     *
     * This overload extracts the operator location and operands from the
     * PathExpr and forwards them to the core validator.
     *
     * @params:
     *   - context: validation context
     *   - op:      PathExpr node containing left and right expressions
     *
     * @returns:
     *   A &Value representing the resolved path access.
     *
     * @throws:
     *   ErrorMsg if resolution fails.
     */
    pub fn validate(dmut context: &ValidationContext,
                     op:           &PathExpr)-> &Value
        throws ErrorMsg
    {
        return PathValidation::validate(alias context, op.loc, op.left, op.right);
    }

    /**
     * Validate a path expression represented as a BinaryExpr using the `::`
     * operator.
     *
     * The parser may represent `::` either as a dedicated PathExpr or as a
     * generic BinaryExpr. This overload normalizes the representation by
     * forwarding the operands to the core validator.
     *
     * @params:
     *   - context: validation context
     *   - op:      BinaryExpr node containing the `::` operator
     *
     * @returns:
     *   A &Value representing the resolved path access.
     *
     * @throws:
     *   ErrorMsg if resolution fails.
     */
    pub fn validate(dmut context: &ValidationContext,
                     op:          &BinaryExpr)-> &Value
        throws ErrorMsg
    {
        return PathValidation::validate(alias context, op.loc, op.left, op.right);
    }

    /**
     * Core implementation of path operator validation.
     *
     * @params:
     *   - context: validation context
     *   - loc:     operator location
     *   - left:    left operand expression
     *   - right:   right operand expression
     *
     * @returns:
     *   A &Value representing the resolved path access.
     *
     * @throws:
     *   ErrorMsg if no valid resolution exists.
     */
    fn validate(dmut context: &ValidationContext,
                 loc:          &Word,
                 left:         &Expression,
                 right:        &Expression)-> &Value
        throws ErrorMsg
    {
        let mut errorTypes: [&ErrorMsg] = [];
        let mut errorFoll: [&ErrorMsg] = [];
        let mut finalVals: [&Value] = [];

        let (asValue, okValue) = { // try to validate the left part as a value
            (ValueCreation::createEnumUnwrap(ValueValidation::validate(alias context, left)), true)
        } catch {
            err: &ErrorMsg => {
                errorTypes ~= [err];
                (UNIT_VALUE, false) // failed, maybe its a type
            }
        };

        let (asType, okType) = { // try to validate the left part as a type
            (TypeValidation::validate(alias context, left), true)
        } catch {
            err: &ErrorMsg => {
                errorTypes ~= [err];
                (NONE_TYPE, false) // failed maybe its a value
            }
        };

        // WARNING: actually it can be both a type and a value(for example, a
        // class and a module can have the same name)

        // it is neither a type nor a valeu
        if (!okValue && !okType) {
            throw copy ErrorMsg::list(errorTypes);
        }

        if (okValue) { // it is a value
            PathValueValidation::validate(alias context, loc, asValue, right,
                                           ref finalVals,
                                           ref errorFoll);
        }

        if (okType) { // it is a type
            PathTypeValidation::validate(alias context, loc, asType, right,
                                          ref finalVals,
                                          ref errorFoll);
        }

        if (finalVals.len == 0us) {
            throw copy ErrorMsg::list(errorFoll);
        }

        // only one result
        if (finalVals.len == 1us) {
            return finalVals[0us];
        }

        // multiple symbols
        return copy MultSymValue(loc, finalVals, prettyStr-> format("%", right));
    }


}
