/*
 * Implements semantic validation for calling delegate types in Ymir.
 *
 * Responsibilities:
 *   - Dispatch method delegates to MethodCallValidation.
 *   - Reject named parameters(delegates do not support them).
 *   - Validate argument count against the delegate signature.
 *   - Infer and validate argument types using CallParamListCreation.
 *   - Perform memory-ownership verification for arguments.
 *   - Compute overload-resolution scoring contributions.
 *   - Construct the appropriate call value:
 *       • PrototypeCallValue for NameDelegateValue
 *       • FuncPtrCallValue for internal delegates
 *   - Insert null-check conditional logic for nullable delegates.
 *
 * This module is invoked by CallMultSymValidation when the selected
 * callable is a delegate rather than a function, lambda, or function pointer.
 *
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::value::operator::call::delegate
 * @File: ymirc/semantic/validator/value/operator/call/delegate.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-04-25
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in delegate;

use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::errors::_;
use ymirc::utils::format;

use ymirc::lexing::{word, tokens, keys};
use ymirc::semantic::validator::value::operator::call::_;


/**
 * DelegateCallValidation
 *
 * Provides semantic validation for calls on delegate types:
 *
 *      delegateValue(arg1, arg2, ...)
 *
 * Delegates in Ymir consist of:
 *   - a closure value(the environment)
 *   - a function pointer(the callable)
 *
 */
pub mod DelegateCallValidation {

    /**
     * Validate a call to a delegate value.
     *
     * Candidate mode:
     *   If `candidate` is true, errors are wrapped into a diagnostic note
     *   instead of being thrown immediately. This is used during overload
     *   resolution to report why a candidate failed.
     *
     * @params:
     *   - context:   validation context
     *   - loc:       location of the call operator
     *   - type:      the delegate type being invoked
     *   - left:      the left operand(delegate value)
     *   - rights:    list of argument values
     *   - nbNamed:   number of named arguments in `rights`
     *   - candidate: whether this validation is performed in candidate mode
     *
     * @returns:
     *   (value, score)
     *     - value: a call value(PrototypeCallValue, FuncPtrCallValue, or ConditionalValue)
     *     - score: overload-resolution score contribution
     *
     * @throws:
     *   ErrorMsg if validation fails and `candidate` is false.
     *   If `candidate` is true, throws a wrapped note describing the failure.
     */
    pub fn validate(dmut context: &ValidationContext,
                     loc:          &Word,
                     type:     &DelegateType,
                     left:         &Value,
                     rights:       [&Value],
                     nbNamed:     usize,
                     candidate:   bool = false)-> (&Value, u32)
        throws ErrorMsg
    {

        if let m: &MethodDelegateValue = left {
            return MethodCallValidation::validate(alias context, loc, m, rights,
                                                   nbNamed-> nbNamed,
                                                   candidate-> candidate);
        }

        {
            // Name parameters are not usable on fptr, delegate or lambda functions
            if (nbNamed != 0us) {
                CallParamListCreation::throwUnknwonNamed(rights[0us .. nbNamed]);
            }

            if (type.params.len != rights.len) {
                throw copy ErrorMsg::fatal(loc, CallParamListCreation::formatTooFew(rights.len, type.params.len));
            }

            let (n_params, score) = CallParamListCreation::validateTypeParamList(alias context,
                                                                                  refs-> type.references,
                                                                                  lazys-> type.lazys,
                                                                                  args-> type.params,
                                                                                  params-> rights);
            let (call, func) = match left {
                n: &NameDelegateValue => {
                    let fstParam = n.closure;
                    let func = n.proto;

                    (copy PrototypeCallValue(loc, type.retType, func, copy [fstParam] ~ n_params), func)
                }
                _ => {
                    let fptr = type.cloneAsFptr();

                    let fstParam: &Value = copy StructFieldAccessValue(loc, PTR_VOID_TYPE, left, DelegateKeys::CLOSURE);
                    let func = copy StructFieldAccessValue(loc, fptr, left, DelegateKeys::FUNC);

                    (copy FuncPtrCallValue(loc, type.retType, func, copy [fstParam] ~ n_params), func)
                }
            };

            // Only happens on internal delegates, in parent ctor calls for instance
            if type.canBeNull {
                let test = copy CmpPointerOperatorValue(loc, BinaryOperators::NOT_EQUAL, func, copy NullValue(loc));
                let cond = copy ConditionalValue(loc, type.retType, test, call, UNIT_VALUE);
                return (cond, score);
            } else {
                return (call, score);
            }
        } catch {
            err: &ErrorMsg => {
                if (!candidate) throw err;
                throw copy ErrorMsg::note(left.loc,
                                           format(ValidateErrorMessage::CANDIDATE_ARE, CallParamListCreation::formatPrettyName(left)),
                                           notes-> copy [err],
                                           oneLine-> true,
                                           withLoc-> true);
            }
        }
    }
}
