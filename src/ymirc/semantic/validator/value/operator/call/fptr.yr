 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in fptr;

use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::errors::_;
use ymirc::utils::format;

use ymirc::lexing::{word, tokens, keys};
use ymirc::semantic::validator::value::operator::call::_;

/**
 * FuncPtrCallValidation
 *
 * Provides semantic validation for calls on function-pointer types:
 *
 *      fptr(arg1, arg2, ...)
 *
 * Function pointers differ from functions, delegates, and lambdas in that:
 *   - They do not support named parameters.
 *   - Their parameter list is fixed and positional.
 *   - Their type signature(params + return type) is fully known at compile time.
 *
 * This module validates argument count, performs type inference and memory
 * verification, computes overload scoring, and constructs the final
 * FuncPtrCallValue.
 */
pub mod FuncPtrCallValidation {

    /**
     * Validate a call to a function pointer.
     *
     * @params:
     *   - context:   validation context
     *   - loc:       location of the call operator
     *   - fptr:      the function-pointer type being invoked
     *   - left:      the left operand(value holding the function pointer)
     *   - rights:    list of argument values
     *   - nbNamed:   number of named arguments in `rights`
     *   - candidate: whether this validation is performed in candidate mode
     *
     * @returns:
     *   (value, score)
     *     - value: a FuncPtrCallValue representing the call
     *     - score: overload-resolution score contribution
     *
     * @throws:
     *   ErrorMsg if validation fails and `candidate` is false.
     *   If `candidate` is true, throws a wrapped note describing the failure.
     */
    pub fn validate(dmut context: &ValidationContext,
                     loc:          &Word,
                     fptr:         &FuncPtrType,
                     left:         &Value,
                     rights:       [&Value],
                     nbNamed:     usize,
                     candidate:   bool = false)-> (&Value, u32)
        throws ErrorMsg
    {
        {
            // Name parameters are not usable on fptr, delegate or lambda functions
            if (nbNamed != 0us) {
                CallParamListCreation::throwUnknwonNamed(rights[0us .. nbNamed]);
            }

            if (fptr.params.len != rights.len) {
                throw copy ErrorMsg::fatal(loc, CallParamListCreation::formatTooFew(rights.len, fptr.params.len));
            }

            let (n_params, score) = CallParamListCreation::validateTypeParamList(alias context,
                                                                                  params-> rights,
                                                                                  refs-> fptr.references,
                                                                                  lazys-> fptr.lazys,
                                                                                  args-> fptr.params);

            return (copy FuncPtrCallValue(loc, fptr.retType, left,  n_params), score);

        } catch {
            err: &ErrorMsg => {
                if (!candidate) throw err;
                throw copy ErrorMsg::note(left.loc, format(ValidateErrorMessage::CANDIDATE_ARE, CallParamListCreation::formatPrettyName(left)),
                                           notes-> copy [err],
                                           oneLine-> true,
                                           withLoc-> true);
            }
        }
    }

}
