in enum_;

use ymirc::errors;
use ymirc::lexing::{keys, word};
use ymirc::semantic::generator::{type::_, value::_};
use ymirc::semantic::validator::value::operator::cast_::implicit;
use ymirc::syntax::expression::_;
use ymirc::utils::format;

/**
 * EnumValueOfCallValidation
 *
 * A call to `E::__valueOf__ (name)` returns the field of the enum `E` named `name`,
 * wrapped in an option, empty when the enum has no such field.
 */
pub mod EnumValueOfCallValidation {

    /**
     * Validate the call of the fake method `__valueOf__` of an enum.
     *
     * A name known at compile time is replaced by the field it names, the call costing
     * nothing at run time, and a name naming no field is an error. Any other name is
     * looked up among the names of the fields at run time.
     *
     * @params:
     *   - context: validation context
     *   - loc:     location of the call operator
     *   - left:    the delegate of the enum whose fields are looked up
     *   - rights:  list of argument values
     *
     * @returns: the field, of type `(E)?`
     *
     * @throws:
     *   ErrorMsg if the call does not take a single string, or if the name is known at
     *   compile time and names no field.
     */
    pub fn validate(dmut context: &ValidationContext,
                    loc:          &Word,
                    left:         &EnumValueOfDelegateValue,
                    rights:       [&Value])-> &Value
        throws ErrorMsg
    {
        let name = EnumValueOfCallValidation::validateName(alias context, loc, rights);
        let optType = copy OptionType(left.loc, left.en, isMutable-> true);
        if let s: &StringValue = context.cteInterpret:.reduce(name) {
            return EnumValueOfCallValidation::createField(s, left.en, optType);
        }

        return EnumValueOfCallValidation::createLookup(alias context, loc, name, left.en, optType);
    }

    /**
     * @params:
     *   - context: validation context
     *   - loc:     location of the call operator
     *   - rights:  list of argument values
     *
     * @returns: the single argument of the call, cast to `[c8]`
     *
     * @throws:
     *   ErrorMsg if the call does not take a single string.
     */
    fn validateName(dmut context: &ValidationContext, loc: &Word, rights: [&Value])-> &Value
        throws ErrorMsg
    {
        if (rights.len != 1us) {
            throw copy ErrorMsg::fatal(loc, CallParamListCreation::formatTooFew(rights.len, 1us));
        }

        return CastImplicitValidation::validate(alias context, rights[0].loc, rights[0], UTF8_TYPE);
    }

    /**
     * @params:
     *   - name:    the name, known at compile time
     *   - en:      the enum whose fields are looked up
     *   - optType: the type `(E)?`
     *
     * @returns: the field named `name`, wrapped in an option
     *
     * @throws:
     *   ErrorMsg if the enum has no field named `name`.
     */
    fn createField(name: &StringValue, en: &EnumType, optType: &OptionType)-> &Value
        throws ErrorMsg
    {
        let field = Utf::decode(name.value.utf8);
        if let Ok(v) = EnumStaticFieldValidation::validate(name.loc, en, field) {
            return copy OptionValue(name.loc, optType, v);
        }

        throw copy ErrorMsg::fatal(name.loc, format(ValidateErrorMessage::UNDEFINED_ENUM_NAME, en, field));
    }

    /**
     * Build the run-time lookup of a name among the names of the fields of an enum:
     *
     *     match name {
     *         "A" => (E::A)?
     *         ...
     *         _ => none
     *     }
     *
     * @params:
     *   - context: validation context
     *   - loc:     location of the call operator
     *   - name:    the name, of type `[c8]`
     *   - en:      the enum whose fields are looked up
     *   - optType: the type `(E)?`
     *
     * @returns: the field named `name` wrapped in an option, empty when there is none
     *
     * @throws:
     *   ErrorMsg if the lookup fails to validate.
     */
    fn createLookup(dmut context: &ValidationContext, loc: &Word, name: &Value, en: &EnumType, optType: &OptionType)-> &Value
        throws ErrorMsg
    {
        let mut lines: [MatchLine] = [];
        for f in en.sym.fields {
            if let Ok(v) = EnumStaticFieldValidation::validate(loc, en, f._0) {
                lines ~= [MatchLine(copy ValueWrapperExpr(loc, copy StringValue(loc, f._0)),
                                    EMPTY_EXPR,
                                    copy ValueWrapperExpr(loc, copy OptionValue(loc, optType, v)))];
            }
        }

        lines ~= [MatchLine(copy VarExpr(loc.locate(Keys::UNDER), isQuoted-> false),
                            EMPTY_EXPR,
                            copy ValueWrapperExpr(loc, copy ErrOptionValue(loc, type-> optType)))];

        return ValueValidation::validate(alias context,
                                          copy MatcherExpr(loc, copy ValueWrapperExpr(name.loc, name), lines, isCatcher-> false));
    }

}
