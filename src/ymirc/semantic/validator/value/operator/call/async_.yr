in async_;

use ymirc::errors;
use ymirc::lexing::word;
use ymirc::semantic::generator::value::_;
use ymirc::semantic::generator::type::native;
use ymirc::utils::format;

/**
 * AsyncRunCallValidation
 *
 * A call to `run` drives the async to completion, and returns the value it completes
 * with, blocking the thread meanwhile. It is valid anywhere, an async included.
 */
pub mod AsyncRunCallValidation {

    /**
     * Validate the call of the fake method `run` of an async value.
     *
     * @params:
     *   - loc:       location of the call operator
     *   - left:      the delegate of the async being run
     *   - rights:    list of argument values
     *   - candidate: whether this validation is performed in candidate mode
     *
     * @returns:
     *   (value, score)
     *     - value: the AsyncRunValue, typed as the value the async completes with
     *     - score: overload-resolution score contribution, always 1
     *
     * @throws:
     *   ErrorMsg if the call takes arguments.
     *   If `candidate` is true, throws a wrapped note describing the failure.
     */
    pub fn validate(loc:       &Word,
                    left:      &AsyncRunDelegateValue,
                    rights:    [&Value],
                    candidate: bool = false)-> (&Value, u32)
        throws ErrorMsg
    {
        if (rights.len != 0us) {
            throw copy ErrorMsg::fatal(loc, CallParamListCreation::formatTooFew(rights.len, 0us));
        }

        let asyncType = if let a: &AsyncType = left.handle.type { a } else { panic; };
        return (copy AsyncRunValue(loc, asyncType.retType, left.handle), 1u32);
    } catch {
        err: &ErrorMsg => {
            if (!candidate) throw err;
            throw copy ErrorMsg::note(left.loc,
                                      format(ValidateErrorMessage::CANDIDATE_ARE, CallParamListCreation::formatPrettyName(left)),
                                      notes-> copy [err],
                                      oneLine-> true,
                                      withLoc-> true);
        }
    }

}
