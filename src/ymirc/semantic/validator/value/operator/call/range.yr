in range;

use ymirc::errors;
use ymirc::lexing::{keys, word};
use ymirc::semantic::interpret;
use ymirc::semantic::generator::value::_;
use ymirc::semantic::generator::type::native;
use ymirc::utils::format;

/**
 * RangeReverseCallValidation
 *
 * A call to `reverse` builds a range holding the same elements in the opposite order.
 */
pub mod RangeReverseCallValidation {

    /**
     * Validate the call of the fake method `reverse` of a range.
     *
     * @params:
     *   - context:   validation context
     *   - loc:       location of the call operator
     *   - left:      the delegate of the range being reversed
     *   - rights:    list of argument values
     *   - candidate: whether this validation is performed in candidate mode
     *
     * @returns:
     *   (value, score)
     *     - value: the reversed range
     *     - score: overload-resolution score contribution, always 1
     *
     * @throws:
     *   ErrorMsg if the call takes arguments.
     *   If `candidate` is true, throws a wrapped note describing the failure.
     */
    pub fn validate(dmut context: &ValidationContext,
                    loc:          &Word,
                    left:         &RangeReverseDelegateValue,
                    rights:       [&Value],
                    candidate:    bool = false)-> (&Value, u32)
        throws ErrorMsg
    {
        if (rights.len != 0us) {
            throw copy ErrorMsg::fatal(loc, CallParamListCreation::formatTooFew(rights.len, 0us));
        }

        let range = if let r: &RangeType = left.range.type { r } else { panic; };
        return (RangeReverseCallValidation::createReverse(alias context, left.loc, left.range, range), 1u32);
    } catch {
        err: &ErrorMsg => {
            if (!candidate) throw err;
            throw copy ErrorMsg::note(left.loc,
                                      format(ValidateErrorMessage::CANDIDATE_ARE, CallParamListCreation::formatPrettyName(left)),
                                      notes-> copy [err],
                                      oneLine-> true,
                                      withLoc-> true);
        }
    }

    /**
     * Build the reversed range of `left`: the same elements in the opposite order.
     *
     * The reversed range goes from the last element actually reached,
     * `fst + (len - 1) * step`, down to `fst` included, by `-step`. An empty range
     * reverses into `(fst .. fst)` by `-step`, so no bound is computed past `fst`.
     * A range that is neither a literal nor a variable is evaluated once, into `#_range`,
     * and so is its length, into `#_len`.
     *
     * @params:
     *   - context: validation context
     *   - loc:     operator location
     *   - left:    range value
     *   - range:   range type
     *
     * @returns:
     *   A &Value representing the reversed range.
     *
     * @throws:
     *   ErrorMsg if reduction fails.
     */
    fn createReverse(dmut context: &ValidationContext, loc: &Word, left: &Value, range: &RangeType)-> &Value
        throws ErrorMsg
    {
        let mut decls: [&Value] = [];
        let mut rng = left;
        if left !of RangeValue && left !of VarRefValue {
            let decl = copy VarDeclValue(loc.locate("#_range"), range, left, isMutable-> false);
            rng = copy VarRefValue(decl.loc, loc, range, decl.uniqId, isSelf-> false, canCte-> true);
            decls ~= [decl];
        }

        let res = RangeReverseCallValidation::createBounds(alias context, loc, rng, range, ref decls);
        if decls.len == 0us {
            return res;
        }

        return copy BlockValue(loc, range, decls ~ [res]);
    }

    /**
     * Build the reversed range of `left`, see createReverse.
     * The declarations it needs are appended to `decls`.
     */
    fn createBounds(dmut context: &ValidationContext, loc: &Word, left: &Value, range: &RangeType, ref mut decls: [&Value])-> &Value
        throws ErrorMsg
    {
        let dmut interpret = alias context.cteInterpret;
        let (fst, scd, step, contains) = ValueCreation::createRangeUnwrap(alias context, left, range,
                                                                          reduce-> true);

        let invStep = interpret:.reduce(copy UnaryOperatorValue(loc, step.type, UnaryOperators::MINUS, step));
        let mut len = interpret:.reduce(copy CastValue(loc, USIZE_TYPE,
                                                       RangeInterpret::reduceLen(alias interpret, loc, fst, scd, step, contains)));

        if let l: &IntValue = len && l.value == 0 {
            return interpret:.reduce(copy RangeValue(loc, range, fst, fst, step-> invStep, isFull-> copy BoolValue(loc, false)));
        }

        if decls.len != 0us && len !of IntValue {
            let lenDecl = copy VarDeclValue(loc.locate("#_len"), USIZE_TYPE, len, isMutable-> false);
            len = copy VarRefValue(lenDecl.loc, loc, USIZE_TYPE, lenDecl.uniqId, isSelf-> false, canCte-> true);
            decls ~= [lenDecl];
        }

        let nbSteps = copy MathIntOperatorValue(loc, USIZE_TYPE, BinaryOperators::MINUS, len, copy IntValue(loc, USIZE_TYPE, 1us));
        let (op, stepU) = {
            let i = interpret:.computeInt(step);
            if i < 0 {
                (BinaryOperators::MINUS, copy IntValue(loc, USIZE_TYPE, 0 - i))
            } else {
                (BinaryOperators::PLUS, copy IntValue(loc, USIZE_TYPE, i))
            }
        } catch {
            _ => { (BinaryOperators::PLUS, copy CastValue(loc, USIZE_TYPE, step)) }
        };

        let dist = copy MathIntOperatorValue(loc, USIZE_TYPE, BinaryOperators::STAR, nbSteps, stepU);
        let last = copy MathIntOperatorValue(loc, range.start, op, fst, copy CastValue(loc, range.start, dist));
        if len of IntValue {
            return interpret:.reduce(copy RangeValue(loc, range, last, fst, step-> invStep, isFull-> copy BoolValue(loc, true)));
        }

        let isEmpty = copy CmpIntOperatorValue(loc, BinaryOperators::DEQUAL, len, copy IntValue(loc, USIZE_TYPE, 0us));
        let start = copy ConditionalValue(loc, range.start, isEmpty, fst, last);
        let isFull = copy CmpIntOperatorValue(loc, BinaryOperators::NOT_EQUAL, len, copy IntValue(loc, USIZE_TYPE, 0us));

        return interpret:.reduce(copy RangeValue(loc, range, start, fst, step-> invStep, isFull-> isFull));
    }
}
