in poll;

use ymirc::errors;
use ymirc::lexing::word;
use ymirc::semantic::generator::value::_;
use ymirc::semantic::generator::type::native;
use ymirc::utils::format;

/**
 * AsyncPollCallValidation
 *
 * A call to `poll` resumes the async once with a waker, a `dg ()-> void` any delegate
 * converts to, and returns the option of the value it completes with: empty while it
 * is pending, the async calling the waker once it can make progress.
 */
pub mod AsyncPollCallValidation {

    /**
     * Validate the call of the fake method `poll` of an async value.
     *
     * @params:
     *   - context:   validation context
     *   - loc:       location of the call operator
     *   - left:      the delegate of the async being polled
     *   - rights:    list of argument values
     *   - candidate: whether this validation is performed in candidate mode
     *
     * @returns:
     *   (value, score)
     *     - value: the AsyncPollValue, typed as the option of the value the async completes with
     *     - score: overload-resolution score contribution
     *
     * @throws:
     *   ErrorMsg if the call does not take exactly one waker.
     *   If `candidate` is true, throws a wrapped note describing the failure.
     */
    pub fn validate(dmut context: &ValidationContext,
                    loc:          &Word,
                    left:         &AsyncPollDelegateValue,
                    rights:       [&Value],
                    candidate:    bool = false)-> (&Value, u32)
        throws ErrorMsg
    {
        if (rights.len != 1us) {
            throw copy ErrorMsg::fatal(loc, CallParamListCreation::formatTooFew(rights.len, 1us));
        }

        let wakerType: &Type = copy DelegateType(loc, [], [], [], VOID_TYPE, isMutable-> false);
        let (wakers, score) = CallParamListCreation::validateTypeParamList(alias context,
                                                                            refs-> copy [false],
                                                                            lazys-> copy [false],
                                                                            args-> copy [wakerType],
                                                                            params-> rights);

        let asyncType = if let a: &AsyncType = left.handle.type { a } else { panic; };
        let optType = copy OptionType(loc, asyncType.retType, isMutable-> true);
        return (copy AsyncPollValue(loc, optType, left.handle, wakers[0]), score);
    } catch {
        err: &ErrorMsg => {
            if (!candidate) throw err;
            throw copy ErrorMsg::note(left.loc,
                                      format(ValidateErrorMessage::CANDIDATE_ARE, CallParamListCreation::formatPrettyName(left)),
                                      notes-> copy [err],
                                      oneLine-> true,
                                      withLoc-> true);
        }
    }

}
