/*
 * Implements semantic validation for calling lambda values in Ymir.
 *
 * Responsibilities:
 *   - Reject named parameters(lambdas do not support them).
 *   - Validate argument count against the lambda parameter list.
 *   - Infer parameter types from the call site.
 *   - Validate the lambda body using LambdaValidation.
 *   - Construct a temporary prototype for the lambda.
 *   - Dispatch the call to MultSymCallValidation.
 *   - Insert generator/frame information after the call is validated.
 *
 * Lambda calls differ from prototype/delegate calls because the lambda body
 * must be validated *at call time*, using the argument types provided by the
 * caller.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::value::operator::call::lambda
 * @File: ymirc/semantic/validator/value/operator/call/lambda.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-04-30
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in lambda;

use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::errors::_;
use ymirc::utils::format;

use ymirc::lexing::{word, tokens, keys};
use ymirc::semantic::validator::value::operator::call::_;


/**
 * LambdaCallValidation
 *
 * Provides semantic validation for calls on lambda values:
 *
 *      (|x| => x + 1)(42)
 *
 * Lambda calls differ from prototype or delegate calls because:
 *
 *   - Lambdas do not have a fixed prototype; their parameter types are
 *     inferred from the call site.
 *   - The lambda body must be validated *after* argument types are known.
 *   - A temporary prototype is synthesized from the inferred types.
 *   - The call is dispatched through MultSymCallValidation using this
 *     synthesized prototype.
 *   - Generator/frame information must be inserted after validation.
 *
 */
pub mod LambdaCallValidation {

    /**
     * Validate a call to a lambda value(LambdaValue).
     *
     * @params:
     *   - context: validation context
     *   - loc:     location of the call operator
     *   - lmbd:    the lambda value being invoked
     *   - rights:  list of argument values
     *   - nbNamed: number of named arguments in `rights`
     *
     * @returns:
     *   (value, score)
     *     - value: the result of the lambda call
     *     - score: overload-resolution score contribution
     *
     * @throws:
     *   ErrorMsg if validation fails.
     */
    pub fn validate(dmut context: &ValidationContext,
                     loc:          &Word,
                     lmbd:         &LambdaValue,
                     rights:       [&Value],
                     nbNamed:     usize,
                     candidate:   bool = false)-> (&Value, u32)
        throws ErrorMsg
    {

        // Name parameters are not usable on fptr, delegate or lambda functions
        if (nbNamed != 0us) {
            CallParamListCreation::throwUnknwonNamed(rights[0us .. nbNamed]);
        }

        if (lmbd.params.len != rights.len) {
            throw copy ErrorMsg::fatal(loc, CallParamListCreation::formatTooFew(rights.len, lmbd.params.len));
        }

        let mut types: [&Type] = copy [i.type for i in rights];
        let (proto, frame) = LambdaValidation::validate(alias context, lmbd, types);
        let ret = MultSymCallValidation::validateCall(alias context, loc, proto, rights,
                                                       nbNamed-> 0us,
                                                       candidate-> candidate,
                                                       inCopy-> false);

        LambdaValidation::insertGenerator(alias context, frame);
        return ret;
    }
}
