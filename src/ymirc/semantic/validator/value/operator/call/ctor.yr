 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in ctor;

use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::errors;
use ymirc::utils::format;

use ymirc::lexing::{word, tokens, keys};
use ymirc::semantic::validator::value::operator::call::_;


/**
 * CtorCallValidation
 *
 * Provides semantic validation for constructor calls:
 *
 *      T(args...)
 *
 * Constructor delegates represent bound constructors, where the `instance`
 * field is the object being initialized and `proto` is the constructor
 * prototype.
 *
 * This module:
 *   - Enforces stack-allocation rules for class constructors.
 *   - Enforces deep-copy restrictions for class constructors.
 *   - Validates argument lists using PrototypeCallValidation.
 *   - Computes overload-resolution scoring.
 *   - Constructs a CtorCallValue containing the final argument list.
 */
pub mod CtorCallValidation {

    /**
     * Validate a call to a constructor delegate(CtorDelegateValue).
     *
     * Candidate mode:
     *   If `candidate` is true, errors are wrapped into a diagnostic note
     *   instead of being thrown immediately. This is used during overload
     *   resolution to report why a candidate failed.
     *
     * @params:
     *   - context:   validation context
     *   - loc:       location of the constructor call
     *   - ctor:      the constructor delegate being invoked
     *   - rights:    list of argument values
     *   - nbNamed:   number of named arguments in `rights`
     *   - candidate: whether this validation is performed in candidate mode
     *   - inCopy:    whether the call occurs inside a copy expression
     *
     * @returns:
     *   (value, score)
     *     - value: a CtorCallValue representing the constructor call
     *     - score: overload-resolution score contribution
     *
     * @throws:
     *   ErrorMsg if validation fails and `candidate` is false.
     *   If `candidate` is true, throws a wrapped note describing the failure.
     */
    pub fn validate(dmut context: &ValidationContext,
                     loc:          &Word,
                     ctor:         &CtorDelegateValue,
                     rights:       [&Value],
                     nbNamed:     usize,
                     candidate:   bool = false,
                     inCopy:       bool = false)-> (&CtorCallValue, u32)
        throws ErrorMsg
    {
        if !inCopy {
            if let c: &ClassPtrType = ctor.instance.type && !c.isStruct {
                throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::CTOR_CLASS_STACK, c),
                                            notes-> copy [copy ErrorMsg::note(loc, format(ValidateErrorMessage::ENCLOSE_COPY_CLASS_CTOR),
                                                                               oneLine-> true)]);
            }
        }

        if context.isInDeepCopy() {
            if let c: &ClassPtrType = ctor.instance.type && !c.isStruct {
                throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::CTOR_CLASS_DCOPY, c),
                                            notes-> copy [copy ErrorMsg::note(context.getCopyExpr().loc, format(ValidateErrorMessage::SIMPLE_COPY_DCOPY_REPLACE))]);
            }
        }

        let (call, score) = PrototypeCallValidation::validate(alias context, loc, ctor.proto, rights,
                                                               nbNamed-> nbNamed,
                                                               candidate-> candidate);


        return (copy CtorCallValue(call.loc, ctor.retType, ctor, call.params, addParams-> call.addParams),
                score);
    }
}
