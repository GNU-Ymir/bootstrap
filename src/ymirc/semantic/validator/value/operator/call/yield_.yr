in yield_;

use ymirc::errors;
use ymirc::lexing::{keys, word};
use ymirc::semantic::generator::type::native;
use ymirc::semantic::generator::value::_;
use ymirc::utils::format;

/**
 * YieldNextCallValidation
 *
 * A call to `next` resumes the generator, and wraps its yielded value into an option:
 *
 *     {
 *         let mut #_yielded: T;
 *         if ((generator).next(#_yielded)) (#_yielded)? else none
 *     }
 */
pub mod YieldNextCallValidation {

    /**
     * Validate the call of the fake method `next` of a generator.
     *
     * @params:
     *   - context:   validation context
     *   - loc:       location of the call operator
     *   - left:      the delegate of the generator being resumed
     *   - rights:    list of argument values
     *   - candidate: whether this validation is performed in candidate mode
     *
     * @returns:
     *   (value, score)
     *     - value: a BlockValue producing the option of the yielded value
     *     - score: overload-resolution score contribution, always 1
     *
     * @throws:
     *   ErrorMsg if the call takes arguments.
     *   If `candidate` is true, throws a wrapped note describing the failure.
     */
    pub fn validate(dmut context: &ValidationContext,
                    loc:          &Word,
                    left:         &YieldNextDelegateValue,
                    rights:       [&Value],
                    candidate:    bool = false)-> (&Value, u32)
        throws ErrorMsg
    {
        if (rights.len != 0us) {
            throw copy ErrorMsg::fatal(loc, CallParamListCreation::formatTooFew(rights.len, 0us));
        }

        let yieldType = if let y: &YieldType = left.generator.type { y } else { panic; };
        let valueDecl = copy VarDeclValue(loc.locate(ForLoopKeys::YIELDED), yieldType.retType.clone(1), UNIT_VALUE,
                                          isMutable-> true);

        let valueRef = VariableCreation::createVarFromDecl(valueDecl, canCte-> false);
        let current = copy VarRefValue(valueDecl.loc, valueDecl.loc, yieldType.retType, valueDecl.uniqId,
                                       isSelf-> false,
                                       canCte-> false);

        let okValue = OptionComposeValidation::validate(alias context, loc, current);
        let optType = if let o: &OptionType = okValue.type { o } else { panic; };
        let noneValue = copy ErrOptionValue(loc, type-> optType);

        let test = copy YieldNextValue(loc, left.generator, valueRef);
        let cond = copy ConditionalValue(loc, optType, test, okValue, noneValue,
                                         isComplete-> true);

        return (copy BlockValue(loc, optType, copy [valueDecl, cond]), 1u32);
    } catch {
        err: &ErrorMsg => {
            if (!candidate) throw err;
            throw copy ErrorMsg::note(left.loc,
                                      format(ValidateErrorMessage::CANDIDATE_ARE, CallParamListCreation::formatPrettyName(left)),
                                      notes-> copy [err],
                                      oneLine-> true,
                                      withLoc-> true);
        }
    }

}
