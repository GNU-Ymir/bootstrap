/*
 * Template prototype call validation.
 *
 * TemplatePrototypeCallValidation performs validation of calls made to
 * template-instantiated functions, methods, and constructors. After template
 * solving and prototype rewriting, this module:
 *
 *   - validates parameter declarations inside template prototypes,
 *   - sorts and matches call arguments against prototype parameters,
 *   - performs implicit template solving for call-site arguments,
 *   - finalizes function, method, and constructor prototypes,
 *   - infers the template arguments of a class from its constructors,
 *   - computes call scores for overload resolution,
 *   - constructs call values(PrototypeCallValue, MethodCallValue, CtorCallValue),
 *   - handles candidate-mode error reporting for overload resolution.
 *
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::value::operator::call::template_
 * @File: ymirc/semantic/validator/value/operator/call/template_.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-05-27
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in template_;

use ymirc::errors;
use ymirc::lexing::word;
use ymirc::semantic::{symbol, template_};
use ymirc::semantic::generator::{type::_, value::_};
use ymirc::semantic::validator::value::operator::call::multsym;
use ymirc::syntax::{declaration, declaration::_, expression::_};
use ymirc::utils::format;


/**
 * TemplatePrototypeCallValidation module
 *
 * Provides validation logic for calls to template-instantiated functions,
 * methods, and constructors.
 *
 */
pub mod TemplatePrototypeCallValidation {

    /**
     * Validate a call to a template-instantiated function.
     *
     * @params:
     *   - context:  validation context used for prototype and call validation
     *   - loc:      source location of the call
     *   - left:     TemplateRefValue representing the function template reference
     *   - func:     function declaration to validate against
     *   - rights:   list of argument values
     *   - nbNamed:  number of named arguments in the call
     *   - candidate: whether the call is being validated as an overload candidate
     *
     * @returns:
     *   - (&Value, TemplateMapper, u32):
     *        * call value (PrototypeCallValue),
     *        * mapper used for template solving,
     *        * call score for overload resolution
     *
     * @throws:
     *   - TEMPLATE_SPE errors if specialization fails
     *   - UNSAFE_CALL if unsafe context is violated
     *   - candidate-mode diagnostics if candidate = true
     */
    pub fn validateFunction(dmut context: &ValidationContext,
                            loc:          &Word,
                            left:         &TemplateRefValue,
                            func:         &FunctionDecl,
                            rights:       [&Value],
                            nbNamed:      usize,
                            candidate:    bool = false)-> (&Value, TemplateMapper, u32)
        throws ErrorMsg
    {
        {
            let argList = TemplatePrototypeCallValidation::validateParamDecls(alias context, left, func.proto.params);
            let (params, rest) = CallParamListCreation::validateParamListSort(loc, argList, rights,
                                                                              nbNamed-> nbNamed,
                                                                              isVariadic-> true);

            let mapper = TemplateSolving::solveImplicit(alias context, loc, left,
                                                        rights-> (params ~ rest),
                                                        forMethod-> false);

            {
                let (proto, hasTest) = TemplateDeclaration::finalizeFunctionPrototype(alias context, loc, left, mapper, func);
                let (finalParams, postRest) = CallParamListCreation::validateParamListSort(loc, proto.params, rights,
                                                                                           nbNamed-> nbNamed,
                                                                                           isVariadic-> false);

                let (_, n_params, score) = CallParamListCreation::validateTypeParamList(alias context, loc, proto.params, finalParams,
                                                                                        verifType-> true,
                                                                                        verifMemory-> true,
                                                                                        isLambda-> false);

                if (proto.isUnsafe) {
                    ValueVerification::verifyUnsafeContext(alias context, proto.loc, msg-> ValidateErrorMessage::UNSAFE_CALL);
                }

                let mut finalScore = score + mapper.score;
                if (hasTest) {
                    finalScore += 1;
                }

                if let Ok(mp) = left.sym.templateMapper {
                    finalScore += mp.score;
                }

                let call = copy PrototypeCallValue(loc, proto.retType, proto, n_params,
                                                   addParams-> postRest);

                return (call, mapper, finalScore);
            } catch {
                err: &ErrorMsg => {
                    let nErr = err.withNote(copy [copy ErrorMsg::note(loc, format(ValidateErrorMessage::TEMPLATE_SPE, mapper),
                                                                      oneLine-> true)]);
                    throw nErr;
                }
            }
        } catch {
            err: &ErrorMsg => {
                if (!candidate) throw err;

                // the template symbol, not the declaration it wraps: a
                // FunctionDecl is located at the keyword introducing it, so
                // pointing there underlines the 'fn' rather than the name of
                // the candidate the note is naming
                throw copy ErrorMsg::note(left.loc, format(ValidateErrorMessage::CANDIDATE_ARE, CallParamListCreation::formatPrettyName(left)),
                                          notes-> copy [err],
                                          oneLine-> true,
                                          withLoc-> true);
            }
        }
    }

    /**
     * Validate a call to a template-instantiated method.
     *
     * @params:
     *   - context:  validation context used for prototype and call validation
     *   - loc:      source location of the call
     *   - left:     MethodDelegateTemplateValue representing the method template reference
     *   - rights:   list of argument values
     *   - nbNamed:  number of named arguments in the call
     *   - candidate: whether the call is being validated as an overload candidate
     *
     * @returns:
     *   - (&Value, TemplateMapper, u32):
     *        * call value (MethodCallValue),
     *        * mapper used for template solving,
     *        * call score for overload resolution
     *
     * @throws:
     *   - TEMPLATE_SPE errors if specialization fails
     *   - UNSAFE_CALL if unsafe context is violated
     *   - candidate-mode diagnostics if candidate = true
     */
    pub fn validateMethod(dmut context: &ValidationContext,
                          loc:         &Word,
                          left:        &MethodDelegateTemplateValue,
                          rights:      [&Value],
                          nbNamed:     usize,
                          candidate:   bool = false)-> (&Value, TemplateMapper, u32)
        throws ErrorMsg
    {
        {
            let func = left.proto.function;

            let argList = TemplatePrototypeCallValidation::validateParamDecls(alias context, left.proto, func.proto.params[1us .. $]);

            let (params, rest) = CallParamListCreation::validateParamListSort(loc, argList, rights,
                                                                              nbNamed-> nbNamed,
                                                                              isVariadic-> true);

            let mapper = TemplateSolving::solveImplicit(alias context, loc, left.proto,
                                                        rights-> (params ~ rest),
                                                        forMethod-> true);

            {
                let (proto, hasTest) = TemplateDeclaration::finalizeFunctionPrototype(alias context, loc, left.proto, mapper, func);
                let (finalParams, postRest) = CallParamListCreation::validateParamListSort(loc, proto.params, rights,
                                                                                           nbNamed-> nbNamed,
                                                                                           isVariadic-> false);

                // Normal call can be performed now
                let (_, n_params, score) = CallParamListCreation::validateTypeParamList(alias context, loc, proto.params, finalParams,
                                                                                        verifType-> true,
                                                                                        verifMemory-> true,
                                                                                        isLambda-> false);

                if (proto.isUnsafe) {
                    ValueVerification::verifyUnsafeContext(alias context, proto.loc, msg-> ValidateErrorMessage::UNSAFE_CALL);
                }

                let mproto = if let mproto: &MethodPrototypeValue = proto {
                    mproto
                } else {
                    panic;
                };
                
                let dgV = copy MethodDelegateValue(loc, mproto,
                                                   closure-> left.closure,
                                                   direct-> true,
                                                   vtableIndex-> 0us,
                                                   isStruct-> left.isStruct);

                let mut finalScore = score + mapper.score;
                if (hasTest) finalScore += 1u32;
                if (dgV.proto.isMutable) finalScore += 1u32;
                if let Ok(mp) = left.proto.sym.templateMapper { finalScore += mp.score; }

                let call = copy MethodCallValue(loc, proto.retType, dgV, n_params, addParams-> postRest);
                return (call, mapper, finalScore);
            } catch {
                err: &ErrorMsg => {
                    let nErr = err.withNote(copy [copy ErrorMsg::note(loc, format(ValidateErrorMessage::TEMPLATE_SPE, mapper),
                                                                      oneLine-> true)]);

                    throw nErr;
                }
            }
        } catch {
            err: &ErrorMsg => {
                if (!candidate) throw err;
                throw copy ErrorMsg::note(left.loc, format(ValidateErrorMessage::CANDIDATE_ARE, CallParamListCreation::formatPrettyName(left)),
                                          notes-> copy [err],
                                          oneLine-> true,
                                          withLoc-> true);
            }
        }
    }

    /**
     * Validate a call to a template-instantiated constructor.
     *
     * @params:
     *   - context:  validation context used for prototype and call validation
     *   - loc:      source location of the call
     *   - left:     CtorDelegateTemplateValue representing the constructor template reference
     *   - rights:   list of argument values
     *   - nbNamed:  number of named arguments in the call
     *   - candidate: whether the call is being validated as an overload candidate
     *
     * @returns:
     *   - (&Value, TemplateMapper, u32):
     *        * call value (CtorCallValue),
     *        * mapper used for template solving,
     *        * call score for overload resolution
     *
     * @throws:
     *   - TEMPLATE_SPE errors if specialization fails
     *   - UNSAFE_CALL if unsafe context is violated
     *   - candidate-mode diagnostics if candidate = true
     */
    pub fn validateCtor(dmut context: &ValidationContext,
                        loc:          &Word,
                        left:         &CtorDelegateTemplateValue,
                        rights:       [&Value],
                        nbNamed:      usize,
                        candidate:    bool = false)-> (&Value, TemplateMapper, u32)
        throws ErrorMsg
    {
        {
            let func = left.proto.ctor;

            let argList = TemplatePrototypeCallValidation::validateParamDecls(alias context, left.proto, func.proto.params);
            let (params, rest) = CallParamListCreation::validateParamListSort(loc, argList, rights,
                                                                              nbNamed-> nbNamed,
                                                                              isVariadic-> true);

            let mapper = TemplateSolving::solveImplicit(alias context, loc, left.proto,
                                                        rights-> (params ~ rest),
                                                        forMethod-> true);

            {
                let (proto, hasTest) = TemplateDeclaration::finalizeCtorPrototype(alias context, loc, left.proto, mapper, func);
                let (finalParams, postRest) = CallParamListCreation::validateParamListSort(loc, proto.params, rights,
                                                                                           nbNamed-> nbNamed,
                                                                                           isVariadic-> false);

                let (_, n_params, score) = CallParamListCreation::validateTypeParamList(alias context, loc, proto.params, finalParams,
                                                                                        verifType-> true,
                                                                                        verifMemory-> true,
                                                                                        isLambda-> false);
                if (proto.isUnsafe) {
                    ValueVerification::verifyUnsafeContext(alias context, proto.loc, msg-> ValidateErrorMessage::UNSAFE_CALL);
                }

                let dgV = copy CtorDelegateValue(loc, left.retType, proto,
                                                 instance-> left.instance,
                                                 nextCtor-> left.nextCtor);

                let mut finalScore = score + mapper.score;
                if (hasTest) finalScore += 1;
                if let Ok(mp) = left.proto.sym.templateMapper {
                    finalScore += mp.score;
                }

                // We have a call, a mapper and a score to return
                let call = copy CtorCallValue(loc, left.retType, dgV, n_params,
                                              addParams-> postRest);

                return (call, mapper, finalScore);
            } catch {
                err: &ErrorMsg => {
                    let nErr = err.withNote(copy [copy ErrorMsg::note(loc, format(ValidateErrorMessage::TEMPLATE_SPE, mapper),
                                                                      oneLine-> true)]);

                    throw nErr;
                }
            }
        } catch {
            err: &ErrorMsg => {
                if (!candidate) throw err;
                throw copy ErrorMsg::note(left.loc, format(ValidateErrorMessage::CANDIDATE_ARE, CallParamListCreation::formatPrettyName(left)),
                                          notes-> copy [err],
                                          oneLine-> true,
                                          withLoc-> true);
            }
        }
    }

    /**
     * Validate the construction of a template class whose template arguments are not given,
     * inferring them from the arguments as each of its unnamed constructors would receive them.
     * The construction is then validated on every specialization so inferred, and the one
     * accepting the arguments with the best score is kept.
     *
     * @params:
     *   - context:   validation context used for inference and call validation
     *   - loc:       source location of the call
     *   - left:      TemplateRefValue representing the class template reference
     *   - cl:        the type declaration of the class template
     *   - rights:    list of argument values
     *   - nbNamed:   number of named arguments in the call
     *   - candidate: whether the call is being validated as an overload candidate
     *   - inCopy:    whether the call occurs inside a copy expression
     *
     * @returns:
     *   - (&Value, TemplateMapper, u32):
     *        * call value (CtorCallValue) on the inferred specialization,
     *        * mapper of the specialization,
     *        * call score for overload resolution
     *
     * @throws:
     *   - NO_CTOR_FOUND if no unnamed constructor infers every template parameter
     *   - WORKS_WITH_BOTH if several specializations accept the arguments with the same score
     *   - candidate-mode diagnostics if candidate = true
     */
    pub fn validateClass(dmut context: &ValidationContext,
                         loc:          &Word,
                         left:         &TemplateRefValue,
                         cl:           &TypeDecl,
                         rights:       [&Value],
                         nbNamed:      usize,
                         candidate:    bool = false,
                         inCopy:       bool = false)-> (&Value, TemplateMapper, u32)
        throws ErrorMsg
    {
        {
            let mappers = TemplatePrototypeCallValidation::inferClassMappers(alias context, loc, left, cl, rights,
                                                                             nbNamed-> nbNamed);

            let mut results: [(&Value, TemplateMapper, u32)] = [];
            let mut errors: [&ErrorMsg] = [];
            let mut highestScore = 0u32;
            for mapper in mappers {
                {
                    let (call, score) = TemplatePrototypeCallValidation::validateSpecializedCtor(alias context, loc, left, mapper, rights,
                                                                                                 nbNamed-> nbNamed,
                                                                                                 inCopy-> inCopy);

                    let finalScore = score + mapper.score;
                    if (finalScore > highestScore) {
                        highestScore = finalScore;
                        results = copy [(call, mapper, finalScore)];
                    } else if (finalScore == highestScore) {
                        results ~= [(call, mapper, finalScore)];
                    }
                } catch {
                    err: &ErrorMsg => {
                        errors ~= [err.withNote(copy [copy ErrorMsg::note(loc, format(ValidateErrorMessage::TEMPLATE_SPE, mapper),
                                                                          oneLine-> true)])];
                    }
                }
            }

            if (results.len == 0us) {
                if (errors.len == 1us) throw errors[0];
                throw copy ErrorMsg::list(errors);
            }

            if (results.len != 1us) {
                let mut notes: [&ErrorMsg] = [];
                for r in results {
                    let ctor: &Value = match r._0 {
                        c: &CtorCallValue => { c.delegate.proto }
                        _ => { left }
                    };

                    notes ~= [copy ErrorMsg::note(ctor.loc, format(ValidateErrorMessage::CANDIDATE_ARE, CallParamListCreation::formatPrettyName(ctor)),
                                                  oneLine-> true,
                                                  withLoc-> true,
                                                  notes-> copy [copy ErrorMsg::note(ctor.loc, format(ValidateErrorMessage::TEMPLATE_SPE, r._1),
                                                                                    oneLine-> true)])];
                }

                throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::WORKS_WITH_BOTH, CallParamListCreation::formatPrettyName(left), rights),
                                           notes-> notes);
            }

            return results[0];
        } catch {
            err: &ErrorMsg => {
                if (!candidate) throw err;
                throw copy ErrorMsg::note(left.loc, format(ValidateErrorMessage::CANDIDATE_ARE, CallParamListCreation::formatPrettyName(left)),
                                          notes-> copy [err],
                                          oneLine-> true,
                                          withLoc-> true);
            }
        }
    }

    /**
     * Infer the template arguments of a class from the arguments given to each of its unnamed
     * constructors, as if the constructor was a template declaring the parameters of the
     * class before its own.
     *
     * @params:
     *   - context: validation context used for template solving
     *   - loc:     source location of the call
     *   - left:    TemplateRefValue representing the class template reference
     *   - cl:      the type declaration of the class template
     *   - rights:  list of argument values
     *   - nbNamed: number of named arguments in the call
     *
     * @returns:
     *   - [TemplateMapper]: the distinct mappers binding every template parameter of the class
     *
     * @throws:
     *   - NO_CTOR_FOUND if no constructor infers them, with a note per constructor
     */
    fn inferClassMappers(dmut context: &ValidationContext,
                         loc:          &Word,
                         left:         &TemplateRefValue,
                         cl:           &TypeDecl,
                         rights:       [&Value],
                         nbNamed:      usize)-> [TemplateMapper]
        throws ErrorMsg
    {
        let mut mappers: [TemplateMapper] = [];
        let mut errors: [&ErrorMsg] = [];
        for ctor in TemplatePrototypeCallValidation::unnamedCtors(cl.decls) {
            let (templates, decl) = ctor;
            {
                let allTemplates = left.sym.decl.params ~ templates;
                let argList = TemplatePrototypeCallValidation::validateParamDecls(alias context, left, decl.proto.params);
                let (params, rest) = CallParamListCreation::validateParamListSort(loc, argList, rights,
                                                                                  nbNamed-> nbNamed,
                                                                                  isVariadic-> TemplatePrototypeCallValidation::hasVariadic(allTemplates));

                let solved = TemplateSolving::solveImplicitCtor(alias context, loc, left, allTemplates, decl,
                                                                rights-> (params ~ rest));
                let mut mapper = TemplateMapper();
                mapper:.merge(solved);
                for name in declaredTemplateNames(templates) {
                    mapper:.remove(name);
                }

                let unresolved = TemplateRewriting::rewriteTemplateParams(mapper, left.sym.decl.params);
                if (unresolved.len != 0us) {
                    throw copy ErrorMsg::list(copy [copy ErrorMsg::fatal(i.loc, format(ValidateErrorMessage::UNRESOLVED_TEMPLATE, i))
                                                    for i in unresolved]);
                }

                let mut known = false;
                for m in mappers if (m == mapper) {
                    known = true;
                }

                if (!known) mappers ~= [mapper];
            } catch {
                err: &ErrorMsg => {
                    errors ~= [copy ErrorMsg::note(decl.loc, format(ValidateErrorMessage::CANDIDATE_ARE, format("%::self %", left, decl.proto)),
                                                   notes-> copy [err],
                                                   oneLine-> true,
                                                   withLoc-> true)];
                }
            }
        }

        if (mappers.len == 0us) {
            throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::NO_CTOR_FOUND, left), notes-> errors);
        }

        return mappers;
    }

    /**
     * Validate a construction on the specialization of a class template.
     *
     * @params:
     *   - context: validation context used for declaration and call validation
     *   - loc:     source location of the call
     *   - left:    TemplateRefValue representing the class template reference
     *   - mapper:  the template arguments of the specialization
     *   - rights:  list of argument values
     *   - nbNamed: number of named arguments in the call
     *   - inCopy:  whether the call occurs inside a copy expression
     *
     * @returns:
     *   - (&Value, u32): the construction and its score
     *
     * @throws:
     *   - TEMPLATE_SPECIALIZATION_FAILS if the specialization cannot be declared
     *   - UNDEFINED_CALL_OP if none of its constructors accepts the arguments
     */
    fn validateSpecializedCtor(dmut context: &ValidationContext,
                               loc:          &Word,
                               left:         &TemplateRefValue,
                               mapper:       TemplateMapper,
                               rights:       [&Value],
                               nbNamed:      usize,
                               inCopy:       bool)-> (&Value, u32)
        throws ErrorMsg
    {
        let mut syms: [dmut &Symbol] = [];
        syms ~= [alias TemplateDeclaration::declare(alias context, loc, mapper, left)];

        let ctors = VariableValidation::validateMultSymbols(alias context, loc, alias syms);
        let value: &MultSymValue = match ctors {
            m: &MultSymValue => { m }
            c: _ => { copy MultSymValue(c.loc, copy [c], prettyStr-> format("%", c)) }
        };

        return MultSymCallValidation::validate(alias context, loc, value, rights,
                                               nbNamed-> nbNamed,
                                               inCopy-> inCopy);
    }

    /**
     * @returns: true iif one of the template parameters is variadic, the only kind that can
     *           receive more arguments than a prototype declares parameters
     */
    fn hasVariadic(templates: [&Expression])-> bool {
        for t in templates if (t of TemplateVariadicVarExpr) {
            return true;
        }

        return false;
    }

    /**
     * @returns: the unnamed constructors among the declarations of a class, each with the
     *           template parameters it declares of its own
     */
    fn unnamedCtors(decls: [&Declaration])-> [([&Expression], &CtorDecl)] {
        let mut result: [([&Expression], &CtorDecl)] = [];
        for d in decls match d {
            b: &BlockDecl => {
                result ~= TemplatePrototypeCallValidation::unnamedCtors(b.decls);
            }
            c: &CondBlockDecl => {
                result ~= TemplatePrototypeCallValidation::unnamedCtors(c.decls);
                result ~= TemplatePrototypeCallValidation::unnamedCtors(copy [c.else_]);
            }
            c: &CtorDecl => {
                if (c.name.isEof) {
                    let noTemplates: [&Expression] = [];
                    result ~= [(noTemplates, c)];
                }
            }
            t: &TemplateDecl => {
                if let c: &CtorDecl = t.decl && c.name.isEof {
                    result ~= [(t.params, c)];
                }
            }
        }

        return result;
    }

    /**
     * Validate a list of parameter declarations inside a template prototype.
     *
     * @params:
     *   - context:   validation context used for parameter validation
     *   - left:      TemplateRefValue representing the template referent
     *   - arguments: list of VarDeclExpr representing prototype parameters
     *
     * @returns:
     *   - [&ProtoVarDeclValue]: validated prototype parameters
     *
     * @throws:
     *   - nothing (errors inside parameters are tolerated and represented)
     */
    fn validateParamDecls(dmut context: &ValidationContext,
                          left:         &TemplateRefValue,
                          arguments:    [&VarDeclExpr])-> [&ProtoVarDeclValue]
    {
        let mut result: [&ProtoVarDeclValue] = [];
        context:.pushReferent(alias context:.getSymbolFromRef(left.sym)); // we push the referent to be in the template prototype context
        context:.enterForeign(isFnBody-> false);

        for arg in arguments {
            context:.enterBlock();

            // We validate what can be validated, and let what cannot be validated as it is
            let (isMut, isRef, isLazy, type, value) = TemplatePrototypeCallValidation::validateParamDecl(alias context, arg);
            let nbConsume = match arg.type {
                lst: &TypeListWrapperExpr => { cast!u32(lst.types.len) }
                _ => 1u32
            };

            let paramGen = copy ProtoVarDeclValue(arg.loc, type, value,
                                                  isMutable-> isMut,
                                                  isReference-> isRef,
                                                  isLazy-> isLazy,
                                                  isSelf-> false,
                                                  nbConsume-> nbConsume,
                                                  isForcedNamed-> arg.isForcedNamed);

            result ~= [paramGen];
            {
                context:.quitBlock(warnUnused-> false);
            } catch { _ => panic; }
        }

        context:.exitForeign();
        context:.popReferent();


        return result;
    }

    /**
     * Validate a single parameter declaration inside a template prototype.
     *
     * @params:
     *   - context: validation context used for type and value validation
     *   - vdecl:   VarDeclExpr representing the parameter declaration
     *   - noValue: whether default value validation should be skipped
     *
     * @returns:
     *   - (bool, bool, bool, &Type, &Value):
     *        * isMutable,
     *        * isReference,
     *        * isLazy,
     *        * validated type (or NONE_TYPE),
     *        * validated value (or TemplateDefaultValue / UNIT_VALUE)
     *
     * @throws:
     *   - nothing (errors are absorbed into fallback values)
     */
    fn validateParamDecl(dmut context: &ValidationContext,
                         vdecl:        &VarDeclExpr,
                         noValue:      bool = false)-> (bool, bool, bool, &Type, &Value) {
        let type = {
            TypeValidation::validateForVarDecl(alias context, vdecl.type, vdecl,
                                               canBeRef-> true,
                                               canBeLazy-> true)
        } catch {
            _ => {
                NONE_TYPE
            }
        };

        let value: &Value = if vdecl.value !of EmptyExpr && !noValue {
            {
                ValueValidation::validate(alias context, vdecl.loc, vdecl.value, type-> type)
            } catch {
                _ => {
                    // we put something, because we don't want the value to be set automatically
                    // It must be named, even if we don't know yet what it is it's default value, template specialization will tell
                    copy TemplateDefaultValue(vdecl.value.loc)
                }
            }
        } else {
            UNIT_VALUE
        };

        return (type.isMutable, vdecl.isRef, vdecl.isLazy, type, value);
    }
}
