in proto;

use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::errors::_;
use ymirc::utils::format;

use ymirc::lexing::{word, tokens, keys};
use ymirc::semantic::validator::value::operator::call::_;


/**
 * PrototypeCallValidation
 *
 * Provides semantic validation for calls on prototype functions:
 *
 *      funcName(arg1, arg2, ...)
 *
 * Prototype functions support:
 *   - Named parameters
 *   - Default values
 *   - Tuple-consuming parameters
 *   - C-variadic parameters(isCVariadic)
 *
 * This module:
 *   - Reorders arguments according to named parameters.
 *   - Validates argument types and memory semantics.
 *   - Computes overload-resolution scoring.
 *   - Constructs a PrototypeCallValue containing the final argument list.
 *   - Enforces unsafe-context restrictions for unsafe functions.
 *
 */
pub mod PrototypeCallValidation {


    /**
     * Validate a call to a prototype function(PrototypeValue).
     *
     * Candidate mode:
     *   If `candidate` is true, errors are wrapped into a diagnostic note
     *   instead of being thrown immediately. This is used during overload
     *   resolution to report why a candidate failed.
     *
     * @params:
     *   - context:   validation context
     *   - loc:       location of the call operator
     *   - left:      the prototype function being invoked
     *   - rights:    list of argument values
     *   - nbNamed:   number of named arguments in `rights`
     *   - candidate: whether this validation is performed in candidate mode
     *
     * @returns:
     *   (value, score)
     *     - value: a PrototypeCallValue representing the call
     *     - score: overload-resolution score contribution
     *
     * @throws:
     *   ErrorMsg if validation fails and `candidate` is false.
     *   If `candidate` is true, throws a wrapped note describing the failure.
     */
    pub fn validate(dmut context: &ValidationContext,
                     loc:          &Word,
                     left:         &PrototypeValue,
                     rights:       [&Value],
                     nbNamed:      usize,
                     candidate:    bool = false)-> (&PrototypeCallValue, u32)
        throws ErrorMsg
    {
        let (params, rest) = CallParamListCreation::validateParamListSort(loc, left.params, rights, nbNamed,
                                                                           isVariadic-> left.isCVariadic);

        let (_, n_params, score) = CallParamListCreation::validateTypeParamList(alias context, loc, left.params, params,
                                                                                 verifType-> true,
                                                                                 verifMemory-> true,
                                                                                 isLambda-> false);

        if (left.isUnsafe) {
            ValueVerification::verifyUnsafeContext(alias context, left.loc, msg-> ValidateErrorMessage::UNSAFE_CALL);
        }

        return (copy PrototypeCallValue(loc, left.retType, left, n_params, addParams-> rest),
                score + left.templateScore);
    } catch {
        err: &ErrorMsg => {
            if (!candidate) throw err;
            throw copy ErrorMsg::note(left.loc,
                                       format(ValidateErrorMessage::CANDIDATE_ARE, CallParamListCreation::formatPrettyName(left)),
                                       notes-> copy [err],
                                       oneLine-> true,
                                       withLoc-> true);
        }
    }
}
