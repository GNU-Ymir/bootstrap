in record_;

use lexing::word;

use ymirc::errors;
use ymirc::semantic::generator::{type::_, value::_};
use ymirc::semantic::validator;
use ymirc::semantic::validator::value::operator::cast_::implicit::_;
use ymirc::utils::format;

/**
 * CastImplicitRecordValidation module
 *
 * Provides the core logic for validating implicit casts involving record
 * types.
 *
 */
pub mod CastImplicitRecordValidation {

    /**
     * Validate an implicit cast to a record type.
     *
     * @params:
     *    - loc:   source location of the cast
     *    - c:     the record type
     *    - v:     the value to cast
     *    - error: original compatibility error to throw if cast fails
     *
     * @returns:
     *    - &Value: rewritten record value when reduction is allowed
     *
     */
    pub fn validate(dmut context: &ValidationContext,
                loc:          &Word,
                c:            &ClassPtrType,
                v:            &Value,
                error:        &ErrorMsg)-> &Value
        throws ErrorMsg
    {
        if v.type of TupleType {
            let ctors = ClassStaticFieldValidation::validateCtors(alias context, loc, c.inner, name-> "");
            let rvalues = ExpandValidation::validate(alias context, loc, v);
            if let exp: &ExpandValue = rvalues {
                return CallValidation::validate(alias context, loc, ctors, exp.values,
                                                inCopy-> false);
            }
        }

        throw error;
    }
}
