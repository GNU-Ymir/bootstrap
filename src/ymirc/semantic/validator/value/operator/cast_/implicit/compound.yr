/*
 * Implicit compound-type cast validation.
 *
 * CastImplicitCompoundValidation performs semantic validation of implicit
 * casts involving compound types. It is responsible for:
 *
 *   - validating implicit casts to pointer types,
 *   - validating implicit casts to option types,
 *   - validating implicit casts to tuple types,
 *   - validating implicit casts to map types,
 *   - delegating array and slice casts to their respective modules,
 *   - reconstructing compound values with rewritten inner values,
 *   - propagating detailed diagnostics when implicit casts fail.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::value::operator::cast_::implicit::compound
 * @File: ymirc/semantic/validator/value/operator/cast_/implicit/compound.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-06-14
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in compound;

use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::_, type::_};
use ymirc::errors;

use ymirc::utils::format;
use lexing::word;

use ymirc::semantic::validator::value::operator::cast_::implicit::_;

/**
 * CastImplicitCompoundValidation module
 *
 * Provides the core logic for validating implicit casts involving compound
 * types.
 *
 */
pub mod CastImplicitCompoundValidation {

    /**
     * Validate an implicit cast from a value to a compound type.
     *
     * @params:
     *   - context: validation context used for recursive cast validation
     *   - loc:     source location of the cast
     *   - c:       target CompoundType
     *   - v:       value to implicitly cast
     *   - error:   original compatibility error to throw if cast fails
     *
     * @returns:
     *   - &Value: rewritten value after implicit cast
     *
     * @throws:
     *   - error if no valid implicit compound cast exists
     */
    pub fn validate(dmut context: &ValidationContext,
                    loc:          &Word,
                    c:            &CompoundType,
                    v:            &Value,
                    error:        &ErrorMsg)-> &Value
        throws ErrorMsg
    {
        match c {
            p: &PointerType => return CastImplicitCompoundValidation::validatePointer(loc, p, v, error);
            m: &MapType => return CastImplicitCompoundValidation::validateMap(loc, m, v, error);
            o: &OptionType => return CastImplicitCompoundValidation::validateOption(alias context, loc, o, v, error);
            t: &TupleType => return CastImplicitCompoundValidation::validateTuple(alias context, loc, t, v, error);

            a: &ArrayType => return CastImplicitArrayValidation::validate(alias context, loc, a, v, error);
            s: &SliceType => return CastImplicitSliceValidation::validate(alias context, loc, s, v, error);
        }

        throw error;
    }

    /**
     * Validate an implicit cast to a pointer type.
     *
     * @params:
     *   - loc:   source location of the cast
     *   - p:     target PointerType
     *   - v:     value to cast
     *   - error: original compatibility error to throw if cast fails
     *
     * @returns:
     *   - &Value: rewritten NullValue
     *
     * @throws:
     *   - error if the value is not NullValue
     */
    fn validatePointer(loc: &Word,
                       p: &PointerType,
                       v: &Value, error: &ErrorMsg)-> &Value
        throws ErrorMsg
    {
        if v of NullValue {
            return copy NullValue(loc, type-> p);
        }

        throw error;
    }

    /**
     * Validate an implicit cast to an option type.
     *
     * @params:
     *   - context: validation context used for recursive cast validation
     *   - loc:     source location of the cast
     *   - o:       target OptionType
     *   - v:       value to cast
     *   - error:   original compatibility error to throw if cast fails
     *
     * @returns:
     *   - &Value: rewritten OptionValue
     *
     * @throws:
     *   - error if cast fails or inner cast fails
     */
    fn validateOption(dmut context: &ValidationContext,
                      loc: &Word,
                      o: &OptionType,
                      v: &Value,
                      error: &ErrorMsg)-> &Value
        throws ErrorMsg
    {
        if v of ErrOptionValue {
            return copy ErrOptionValue(loc, type-> o);
        }

        if let ov: &OptionValue = v {
            {
                let innerV = CastImplicitValidation::validate(alias context, loc, ov.value, o.wrapped);
                let optType = (copy OptionType(loc, innerV.type, isMutable-> false)).clone(ov.type);
                return copy OptionValue(loc, optType, innerV);
            } catch {
                _ => {}
            }
        }

        throw error;
    }

    /**
     * Validate an implicit cast to a tuple type.
     *
     * @params:
     *   - context: validation context used for recursive cast validation
     *   - loc:     source location of the cast
     *   - t:       target TupleType
     *   - v:       value to cast
     *   - error:   original compatibility error to throw if cast fails
     *
     * @returns:
     *   - &Value: rewritten TupleValue
     *
     * @throws:
     *   - error with additional notes if element cast fails
     */
    fn validateTuple(dmut context: &ValidationContext,
                     loc:          &Word,
                     t:            &TupleType,
                     v:            &Value,
                     error:        &ErrorMsg)-> &Value
        throws ErrorMsg
    {

        if let tv: &TupleValue = v {
            if (tv.arity != t.inners.len) {
                throw error;
            }

            let mut params: [&Value] = [];
            let mut types: [&Type] = [];

            {
                for i in 0us .. tv.arity {
                    let innerV = CastImplicitValidation::validate(alias context, loc, tv.values[i], t.inners[i]);
                    TupleComposeValidation::addTupleType(innerV,
                                                         ref params,
                                                         ref types);
                }
            } catch {
                innerErr => {
                    throw error.withNote(copy [innerErr], alone-> true);
                }
            }

            let type = copy TupleType(tv.loc, types, isMutable-> true);
            return copy TupleValue(tv.loc, type, params);
        }

        throw error;
    }

    /**
     * Validate an implicit cast to a map type.
     *
     * @params:
     *   - loc:   source location of the cast
     *   - m:     target MapType
     *   - v:     value to cast
     *   - error: original compatibility error to throw if cast fails
     *
     * @returns:
     *   - &Value: rewritten MapValue when reduction is allowed
     *
     * @throws:
     *   - error with additional notes for invalid map casts
     */
    fn validateMap(loc:   &Word,
                   m:     &MapType,
                   v:     &Value,
                   error: &ErrorMsg)-> &Value
        throws ErrorMsg
    {
        match (v, v.type) {
            (SliceCtorValue(), a: &SliceType) => {
                if a.value of VoidType {
                    return copy MapValue(loc, m, [], [], isReduced-> true);
                }
            }
            (c: &CopierValue, a: &SliceType) => {
                if c.isDeep {
                    throw error.withNote(copy [copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::CTOR_MAP_DCOPY, m),
                                                                    notes-> copy [copy ErrorMsg::note(loc, format(ValidateErrorMessage::SIMPLE_COPY_DCOPY_REPLACE),
                                                                                                      oneLine-> true)])]);
                }

                if a.value of VoidType {
                    return copy MapValue(loc, m, [], [], isReduced-> true);
                }
            }
            (ArrayValue(), ArrayType()) => {
                throw error.withNote(copy [copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::CTOR_MAP_STACK, m),
                                                                notes-> copy [copy ErrorMsg::note(v.loc, format(ValidateErrorMessage::ENCLOSE_COPY_LST),
                                                                                                  oneLine-> true)])]);
            }
        }

        throw error;
    }
}
