/*
 * Implicit scalar-type cast validation.
 *
 * CastImplicitScalarValidation performs semantic validation of implicit casts
 * involving scalar types. It is responsible for:
 *
 *   - validating implicit casts to integer types,
 *   - validating implicit casts to floating-point types,
 *   - validating implicit casts to character types,
 *   - validating implicit casts to function-pointer types,
 *   - validating implicit casts to delegate types,
 *   - reconstructing scalar values with rewritten inner values,
 *   - propagating detailed diagnostics when implicit casts fail.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::value::operator::cast_::implicit::scalar
 * @File: ymirc/semantic/validator/value/operator/cast_/implicit/scalar.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-06-14
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in scalar;

use ymirc::semantic::{validator, interpret};
use ymirc::semantic::generator::{value::_, type::_};
use ymirc::errors::_;

use ymirc::lexing::word;

/**
 * CastImplicitScalarValidation module
 *
 * Provides the core logic for validating implicit casts involving scalar
 * types.
 *
 */
pub mod CastImplicitScalarValidation {

    /**
     * Validate an implicit cast from a value to a scalar type.
     *
     * @params:
     *   - context: validation context used for recursive cast validation
     *   - loc:     source location of the cast
     *   - s:       target ScalarType
     *   - v:       value to implicitly cast
     *   - error:   original compatibility error to throw if cast fails
     *
     * @returns:
     *   - &Value: rewritten value after implicit cast
     *
     * @throws:
     *   - error if no valid implicit scalar cast exists
     */
    pub fn validate(dmut context: &ValidationContext,
                    loc:          &Word,
                    s:            &ScalarType,
                    v:            &Value,
                    error:        &ErrorMsg)-> &Value
        throws ErrorMsg
    {
        match s {
            f: &FuncPtrType => return validateFptr(alias context, loc, f, v, error);
            d: &DelegateType => return validateDelegate(alias context, loc, d, v, error);

            i: &IntType => return validateInt(loc, i, v, error);
            c: &CharType => return validateChar(loc, c, v, error);
            f: &FloatType => return validateFloat(loc, f, v, error);
        }

        throw error;
    }

    /**
     * Validate an implicit cast to an integer type.
     *
     * @params:
     *   - loc:   source location of the cast
     *   - i:     target IntType
     *   - v:     value to cast
     *   - error: original compatibility error to throw if cast fails
     *
     * @returns:
     *   - &Value: rewritten IntValue
     *
     * @throws:
     *   - error with appended notes if overflow occurs
     */
    fn validateInt(loc:          &Word,
                   i:            &IntType,
                   v:            &Value,
                   error:        &ErrorMsg)-> &Value
        throws ErrorMsg
    {
        if let iv: &IntValue = v {
            { // it is a cte int, we might implicit cast it if it does not overflow(ex: 1924-> u8)
                IntInterpret::verifyOverflow(iv.loc, i, iv.value); // but we need to verify overflow
            } catch {
                innerErr => {
                    throw error.appendNotes(copy [innerErr]);
                }
            }

            return copy IntValue(loc, i, iv.value);
        }

        throw error;
    }

    /**
     * Validate an implicit cast to a floating-point type.
     *
     * @params:
     *   - loc:   source location of the cast
     *   - f:     target FloatType
     *   - v:     value to cast
     *   - error: original compatibility error to throw if cast fails
     *
     * @returns:
     *   - &Value: rewritten FloatValue
     *
     * @throws:
     *   - error if cast is not allowed
     */
    fn validateFloat(loc:   &Word,
                     f:     &FloatType,
                     v:     &Value,
                     error: &ErrorMsg)-> &Value
        throws ErrorMsg
    {
        // it is cte, we can automatically transform the value into a value of type 'f'
        if let fv: &FloatValue = v {
            return copy FloatValue(loc, f, fv.value);
        }


        throw error;
    }

    /**
     * Validate an implicit cast to a character type.
     *
     * @params:
     *   - loc:   source location of the cast
     *   - c:     target CharType
     *   - v:     value to cast
     *   - error: original compatibility error to throw if cast fails
     *
     * @returns:
     *   - &Value: rewritten CharValue
     *
     * @throws:
     *   - error with appended notes if overflow occurs
     */
    fn validateChar(loc:          &Word,
                    c:            &CharType,
                    v:            &Value,
                    error:        &ErrorMsg)-> &Value
        throws ErrorMsg
    {
        match v { // e.g. c32-> c8
            cv: &CharValue => {
                { // Cte char value, that may be casted to other char types('a'-> 'a'c8)
                    CharInterpret::verifyOverflow(cv.loc, c, cv);
                } catch {
                    innerErr => {
                        throw error.appendNotes(copy [innerErr]);
                    }
                }

                match cv.encodingSize {
                    8 => return copy CharValue(loc, C8_TYPE, cast!u32(cv.value.utf8));
                    16 => return copy CharValue(loc, C16_TYPE, cast!u32(cv.value.utf16));
                    _ => return copy CharValue(loc, C32_TYPE, cast!u32(cv.value.utf32));
                }
            }
        }

        throw error;
    }

    /**
     * Validate an implicit cast to a function-pointer type.
     *
     * @params:
     *   - context: validation context used for lambda validation
     *   - loc:     source location of the cast
     *   - f:       target FuncPtrType
     *   - v:       value to cast
     *   - error:   original compatibility error to throw if cast fails
     *
     * @returns:
     *   - &Value: lambda prototype value
     *
     * @throws:
     *   - error if cast is not allowed
     */
    fn validateFptr(dmut context: &ValidationContext,
                    loc:          &Word,
                    f:            &FuncPtrType,
                    v:            &Value,
                    error:        &ErrorMsg)-> &Value
        throws ErrorMsg
    {

        if let lmbd: &LambdaValue = v {
            let (proto, frame) = LambdaValidation::validate(alias context, lmbd, f.params);
            TypeVerification::verifyCompatible(loc, lmbd.loc, f, proto.type);
            LambdaCreation::insertGenerator(alias context, frame);

            return proto;
        }

        throw error;
    }

    /**
     * Validate an implicit cast to a delegate type.
     *
     * @params:
     *   - context: validation context used for lambda validation
     *   - loc:     source location of the cast
     *   - d:       target DelegateType
     *   - v:       value to cast
     *   - error:   original compatibility error to throw if cast fails
     *
     * @returns:
     *   - &Value: lambda prototype or delegate value
     *
     * @throws:
     *   - error if cast is not allowed or signatures mismatch
     */
    fn validateDelegate(dmut context: &ValidationContext,
                        loc:          &Word,
                        d:            &DelegateType,
                        v:            &Value,
                        error:        &ErrorMsg)-> &Value
        throws ErrorMsg
    {
        if let lmbd: &LambdaValue = v {
            let (proto, frame) = LambdaValidation::validate(alias context, lmbd, d.params);
            TypeVerification::verifyCompatible(loc, lmbd.loc, d, proto.type);
            LambdaCreation::insertGenerator(alias context, frame);


            return proto;
        }

        if let f: &FuncPtrType = v.type {
            if (f.params.len != d.params.len) throw error;
            if (f.retType != d.retType) throw error;
            for i in 0us .. f.params.len {
                if (f.params[i] != d.params[i]) throw error;
                if (!f.params[i].sameMutability(d.params[i])) throw error;
            }

            if (f.references != d.references) throw error;
            if (f.lazys != d.lazys) throw error;

            return LambdaCreation::createDelegateFromFptr(alias context, loc, f, v);
        }

        throw error;
    }
}
