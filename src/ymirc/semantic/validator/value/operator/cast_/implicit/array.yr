/*
 * Implicit array cast validation.
 *
 * CastImplicitArrayValidation performs semantic validation of implicit casts
 * between array values and array types. It is responsible for:
 *
 *   - validating implicit casts from string literals to character arrays,
 *   - validating implicit casts from array literals to typed arrays,
 *   - validating implicit casts from ArrayAllocValue to typed arrays,
 *   - reconstructing array values with rewritten inner values,
 *   - propagating detailed diagnostics when implicit casts fail.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::value::operator::cast_::implicit::array
 * @File: ymirc/semantic/validator/value/operator/cast_/implicit/array.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-06-14
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in array;

use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::_, type::_};
use ymirc::errors;

use ymirc::lexing::word;

/**
 * CastImplicitArrayValidation module
 *
 * Provides the core logic for validating implicit casts involving arrays.
 *
 */
pub mod CastImplicitArrayValidation {

    /**
     * Validate an implicit cast from a value to an array type.
     *
     * @params:
     *   - context: validation context used for recursive cast validation
     *   - loc:     source location of the cast
     *   - a:       target ArrayType
     *   - v:       value to implicitly cast
     *   - error:   original compatibility error to throw if cast fails
     *
     * @returns:
     *   - &Value: rewritten array value after implicit cast
     *
     * @throws:
     *   - error if no valid implicit array cast exists
     */
    pub fn validate(dmut context: &ValidationContext,
                    loc:          &Word,
                    a:            &ArrayType,
                    v:            &Value,
                    error:        &ErrorMsg)-> &Value
        throws ErrorMsg
    {
        match (a.value, v) {
            (c: &CharType, s: &StringValue) => {
                let result = s.toArray(loc-> loc, resultSize-> c.size);
                if (result.len == a.len) {
                    return result;
                }
            }
            (_, av: &ArrayValue) => {
                return CastImplicitArrayValidation::validateFromLit(alias context, loc, a, av, error);
            }
            (_, av: &ArrayAllocValue) => {
                return CastImplicitArrayValidation::validateFromArrayAlloc(alias context, loc, a, av, error);
            }
        }

        throw error;
    }

    /**
     * Validate an implicit cast from an ArrayValue literal to a typed array.
     *
     * @params:
     *   - context: validation context used for recursive cast validation
     *   - loc:     source location of the cast
     *   - a:       target ArrayType
     *   - av:      ArrayValue literal to cast
     *   - error:   original compatibility error to throw if cast fails
     *
     * @returns:
     *   - &Value: rewritten ArrayValue
     *
     * @throws:
     *   - error with additional notes if element cast fails
     */
    fn validateFromLit(dmut context: &ValidationContext,
                       loc:          &Word,
                       a:            &ArrayType,
                       av:           &ArrayValue,
                       error:        &ErrorMsg)-> &Value
        throws ErrorMsg
    {
        let typeLen = a.len;
        let typeInnerType = a.value;

        let (valueInnerType, valueLen) = if let avt: &ArrayType = av.type {
            (avt.value, avt.len)
        } else {
            panic;
        };

        match (valueLen, valueInnerType, typeLen, typeInnerType) {
            (0, VoidType(), 0, _) => { // [void ; 0]-> [T ; 0]
                return copy ArrayValue(av.loc, a, []);
            }
            (x: usize, _, y: usize, t2: &Type) => {
                if (x == y) { // [T ; N]-> [U ; N]
                    let mut params: [&Value] = [];
                    let mut inner: &Type = copy NoneType(loc);
                    {
                        for i in 0us .. x {
                            let innerV = CastImplicitValidation::validate(alias context, loc, av.values[i], t2);
                            inner = SliceComposeValidation::addArrayType(alias context, innerV, inner,
                                                                         ref params);
                        }
                    } catch {
                        innerErr => {
                            throw error.withNote(copy [innerErr], alone-> true);
                        }
                    }

                    let arrType = copy ArrayType(loc, inner, params.len,
                                                 isMutable-> true);
                    return copy ArrayValue(av.loc, arrType, params);
                }
            }
        }

        throw error;
    }

    /**
     * Validate an implicit cast from an ArrayAllocValue to a typed array.
     *
     * @params:
     *   - context: validation context used for recursive cast validation
     *   - loc:     source location of the cast
     *   - a:       target ArrayType
     *   - av:      ArrayAllocValue to cast
     *   - error:   original compatibility error to throw if cast fails
     *
     * @returns:
     *   - &Value: rewritten ArrayAllocValue
     *
     * @throws:
     *   - error if lengths mismatch or cast fails
     */
    fn validateFromArrayAlloc(dmut context: &ValidationContext,
                              loc:          &Word,
                              a:            &ArrayType,
                              av:           &ArrayAllocValue,
                              error:        &ErrorMsg)-> &Value
        throws ErrorMsg
    {
        if (!av.isDynamic) {
            {
                if let at: &ArrayType = av.type && at.len != a.len {
                    throw error;
                }


                let innerV = CastImplicitValidation::validate(alias context, loc, av.value, a.value);
                let arrType = copy ArrayType(loc, innerV.type, a.len, isMutable-> true);
                return copy ArrayAllocValue::stat(loc, arrType, innerV, av.len);
            } catch {
                innerErr => {
                    throw error.withNote(copy [innerErr], alone-> true);
                }
            }

        }

        throw error;
    }
}
