in union_;

use lexing::word;

use ymirc::errors;
use ymirc::semantic::generator::{type::_, value::_};

/**
 * CastImplicitUnionValidation module
 *
 * Provides the core logic for validating the implicit widening of a member
 * value into the union listing it, wherever a conversion is allowed: a
 * variable initialization, an assignment, an argument, a returned value.
 *
 * A member is matched exactly. A subclass of a member does not widen in: the
 * table a union dispatches through is synthesized per member and binds the
 * implementation that member declares, so a subclass widened in would not
 * dispatch its own overrides.
 *
 * The other direction only exists towards the base a union declares, every
 * member descending from it. It does not exist towards a member, which one is
 * held being known only at runtime.
 */
pub mod CastImplicitUnionValidation {

    /**
     * Read a union as the base it declares.
     *
     * Every member descends from that base and the overlay holds the member as
     * a pointer, so the union reads as a base pointer whichever member it
     * holds, with no test and no knowledge of which.
     *
     * @params:
     *    - loc:  source location of the reading
     *    - u:    the union being read
     *    - v:    the union value
     *    - type: the type the union is read as
     *
     * @returns:
     *    - the union read as that base, or nothing when the type given is
     *      neither the base nor an ancestor of it
     *
     * @throws:
     *    - ErrorMsg if the union failed to validate
     */
    pub fn readAsBase(loc: &Word, u: &UnionType, v: &Value, type: &Type)-> (&Value)?
        throws ErrorMsg
    {
        if let Ok(base) = UnionValidation::reference(u).base {
            if (TypeVerification::isDirectInstance(type, base) || TypeVerification::isAncestor(type, base)) {
                // the base is read as the mutability of the union lets the member be accessed
                let asBase = base.createInstance(loc-> loc,
                                                 isMutable-> u.isDeeplyMutable,
                                                 isInnerMutable-> u.isDeeplyMutable);

                let res: &Value = copy UnionBaseValue(loc, asBase, v);
                return res?;
            }
        }

        none
    }

    /**
     * Validate the widening of a value into a union.
     *
     * The member is stored as the mutability of the union allows it to be
     * accessed, so a union that is not deeply mutable stores a constant
     * member, and a deeply mutable one borrows and requires an explicit
     * alias.
     *
     * @params:
     *    - loc:     source location of the widening
     *    - u:       the union type to widen into
     *    - v:       the value to widen
     *    - error:   original compatibility error to throw if the widening fails
     *
     * @returns:
     *    - &Value: the widened value
     *
     * @throws:
     *    - ErrorMsg if the value is not one of the members of the union, or
     *      if the member cannot be stored as the union accesses it
     */
    pub fn validate(loc:   &Word,
                    u:     &UnionType,
                    v:     &Value,
                    error: &ErrorMsg)-> &Value
        throws ErrorMsg
    {
        let index = match u.indexOf(v.type) {
            Ok(i: usize) => { i }
            _ => { throw error; }
        };

        let member = u.members[index].clone(if (u.isDeeplyMutable) { 2u32 } else { 0u32 });
        MemoryVerification::verifyMemoryOwner(loc, valueLoc-> v.loc, type-> member, value-> v, byReference-> false);

        copy UnionWidenValue(loc, u, v, index)
    }
}
