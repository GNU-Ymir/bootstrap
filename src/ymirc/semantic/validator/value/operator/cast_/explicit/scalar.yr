/*
 * Explicit scalar-type cast validation.
 *
 * CastExplicitScalarValidation performs semantic validation of explicit casts
 * involving scalar types. It is responsible for:
 *
 *   - validating explicit casts to integer types,
 *   - validating explicit casts to floating-point types,
 *   - validating explicit casts to character types,
 *   - validating explicit casts to boolean types,
 *   - reconstructing scalar values with rewritten inner types,
 *   - propagating detailed diagnostics when explicit casts fail.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::value::operator::cast_::explicit::scalar
 * @File: ymirc/semantic/validator/value/operator/cast_/explicit/scalar.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-06-14
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in scalar;

use ymirc::semantic::{validator, interpret};
use ymirc::semantic::generator::{value::_, type::_};
use ymirc::errors;

use ymirc::lexing::word;
use ymirc::utils::format;

/**
 * CastExplicitScalarValidation module
 *
 * Provides the core logic for validating explicit casts involving scalar
 * types.
 *
 */
pub mod CastExplicitScalarValidation {

    /**
     * Validate an explicit cast from a value to a scalar type.
     *
     * @params:
     *   - loc:   source location of the cast
     *   - s:     target ScalarType
     *   - value: value to explicitly cast
     *
     * @returns:
     *   - &Value: rewritten value after explicit cast
     *
     * @throws:
     *   - UNDEFINED_CAST_OP if the cast is not supported
     */
    pub fn validate(loc:   &Word,
                    s:     &ScalarType,
                    value: &Value)-> &Value
        throws ErrorMsg
    {
        match s {
            i: &IntType => return CastExplicitScalarValidation::validateInt(loc, i, value);
            f: &FloatType => return CastExplicitScalarValidation::validateFloat(loc, f, value);
            c: &CharType => return CastExplicitScalarValidation::validateChar(loc, c, value);
            b: &BoolType => return CastExplicitScalarValidation::validateBool(loc, b, value);
        }

        throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::UNDEFINED_CAST_OP, value.type, s));
    }

    /**
     * Validate an explicit cast to an integer type.
     *
     * @params:
     *   - loc:   source location of the cast
     *   - i:     target IntType
     *   - value: value to cast
     *
     * @returns:
     *   - &Value: rewritten CastValue or original IntValue
     *
     * @throws:
     *   - UNDEFINED_CAST_OP if cast is not allowed
     */
    fn validateInt(loc: &Word,
                   i: &IntType,
                   value: &Value)-> &Value
        throws ErrorMsg
    {
        match value.type {
            iC: &IntType => {
                if (iC.size == i.size && iC.isSigned == i.isSigned) {
                    return value;
                }

                return copy CastValue(loc, i, value);
            }
            c: &CharType => {
                if (!i.isSigned && c.size == i.size) {
                    return copy CastValue(loc, i, value);
                }
            }
            BoolType() => {
                if (!i.isSigned && i.size == 8u16) {
                    return copy CastValue(loc, i, value);
                }
            }
            FloatType() => {
                if (i.size >= 32u16) {
                    return copy CastValue(loc, i, value);
                }
            }
        }

        throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::UNDEFINED_CAST_OP, value.type, i));
    }

    /**
     * Validate an explicit cast to a floating-point type.
     *
     * @params:
     *   - loc:   source location of the cast
     *   - f:     target FloatType
     *   - value: value to cast
     *
     * @returns:
     *   - &Value: rewritten CastValue or original FloatValue
     *
     * @throws:
     *   - UNDEFINED_CAST_OP if cast is not allowed
     */
    fn validateFloat(loc: &Word, f: &FloatType, value: &Value)-> &Value
        throws ErrorMsg
    {
        match value.type {
            fC: &FloatType => {
                if (fC.size == f.size) {
                    return value;
                }

                return copy CastValue(loc, f, value);
            }
            i: &IntType => {
                if (i.size >= 32u16) {
                    return copy CastValue(loc, f, value);
                }
            }
        }

        throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::UNDEFINED_CAST_OP, value.type, f));
    }

    /**
     * Validate an explicit cast to a character type.
     *
     * @params:
     *   - loc:   source location of the cast
     *   - c:     target CharType
     *   - value: value to cast
     *
     * @returns:
     *   - &Value: rewritten CastValue or original CharValue
     *
     * @throws:
     *   - UNDEFINED_CAST_OP if cast is not allowed
     */
    fn validateChar(loc: &Word, c: &CharType, value: &Value)-> &Value
        throws ErrorMsg
    {
        match value.type {
            cC: &CharType => {
                if (cC.size == c.size) {
                    return value;
                }

                return copy CastValue(loc, c, value);
            }
            i: &IntType => {
                if (!i.isSigned && i.size == c.size) {
                    return copy CastValue(loc, c, value);
                }
            }
        }

        throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::UNDEFINED_CAST_OP, value.type, c));
    }

    /**
     * Validate an explicit cast to a boolean type.
     *
     * @params:
     *   - loc:   source location of the cast
     *   - b:     target BoolType
     *   - value: value to cast
     *
     * @returns:
     *   - &Value: rewritten CastValue or original BoolValue
     *
     * @throws:
     *   - UNDEFINED_CAST_OP if cast is not allowed
     */
    fn validateBool(loc: &Word, b: &BoolType, value: &Value)-> &Value
        throws ErrorMsg
    {
        match value.type {
            i: &IntType => {
                if (!i.isSigned && i.size == 8u16) {
                    return copy CastValue(loc, b, value);
                }
            }
            BoolType() => {
                return value;
            }
        }

        throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::UNDEFINED_CAST_OP, value.type, b));
    }
}
