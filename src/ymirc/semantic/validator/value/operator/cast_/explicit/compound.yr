 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in compound;

use ymirc::semantic::{validator, interpret};
use ymirc::semantic::generator::{value::_, type::_};
use ymirc::errors::_;

use ymirc::lexing::word;
use ymirc::utils::format;

use ymirc::semantic::validator::value::operator::cast_::_;

/**
 * CastExplicitCompoundValidation module
 *
 * Provides the core logic for validating explicit casts involving compound
 * types.
 *
 */
pub mod CastExplicitCompoundValidation {

    /**
     * Validate an explicit cast from a value to a compound type.
     *
     * @params:
     *   - context: validation context used for recursive cast validation
     *   - loc:     source location of the cast
     *   - c:       target CompoundType
     *   - value:   value to explicitly cast
     *
     * @returns:
     *   - &Value: rewritten value after explicit cast
     *
     * @throws:
     *   - UNDEFINED_CAST_OP if the cast is not supported
     */
    pub fn validate(dmut context: &ValidationContext,
                    loc: &Word,
                    c: &CompoundType,
                    value: &Value)-> &Value
        throws ErrorMsg
    {
        match c {
            o: &OptionType => return CastExplicitCompoundValidation::validateOption(alias context, loc, o, value);
            p: &PointerType => return CastExplicitCompoundValidation::validatePointer(loc, p, value);
        }

        throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::UNDEFINED_CAST_OP, value.type, c));
    }

    /**
     * Validate an explicit cast to a pointer type.
     *
     * @params:
     *   - loc:   source location of the cast
     *   - p:     target PointerType
     *   - value: value to cast
     *
     * @returns:
     *   - &Value: rewritten CastValue or original pointer value
     *
     * @throws:
     *   - UNDEFINED_CAST_OP if the value is not a pointer
     *   - memory-ownership errors if aliasing rules are violated
     */
    fn validatePointer(loc: &Word,
                       p: &PointerType,
                       value: &Value)-> &Value
        throws ErrorMsg
    {
        match value.type {
            oP: &PointerType => {
                if (oP.pointed == p.pointed) {
                    // the cast is to the same type, no need to cast
                    return value;
                } else {
                    {
                        let auxType = p.clone(pattern-> oP);

                        // Make sure there is no implicit alias involved
                        MemoryVerification::verifyMemoryOwner(loc, value.type, value, false);
                        return copy CastValue(loc, auxType, value, isLvalue-> true)
                    } catch {
                        _ => { // else, cast to an imutable value
                            let auxType = p;
                            return copy CastValue(loc, auxType, value, isLvalue-> true)
                        }
                    }
                }
            }
        }

        // Other types are not castable to pointers
        throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::UNDEFINED_CAST_OP, value.type, p));
    }

    /**
     * Validate an explicit cast to an option type.
     *
     * @params:
     *   - context: validation context used for recursive cast validation
     *   - loc:     source location of the cast
     *   - o:       target OptionType
     *   - value:   value to cast
     *
     * @returns:
     *   - &Value: rewritten OptionValue
     *
     * @throws:
     *   - UNDEFINED_CAST_OP if cast is not allowed
     *   - any error produced by inner implicit cast validation
     */
    fn validateOption(dmut context: &ValidationContext,
                      loc:          &Word,
                      o:            &OptionType,
                      value:        &Value)-> &Value
        throws ErrorMsg
    {
        if value of ErrOptionValue {
            if let type: &OptionType = o.toDeeplyMutable() {
                return copy ErrOptionValue(loc, type-> type);
            } else panic;
        }

        if let ov: &OptionValue = value {
            {
                let innerV = CastImplicitValidation::validate(alias context, loc, ov.value, o.wrapped);
                let optType = (copy OptionType(loc, innerV.type, isMutable-> false)).clone(ov.type);
                return copy OptionValue(loc, optType, innerV);
            } catch {
                _ => {}
            }
        }

        throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::UNDEFINED_CAST_OP, value.type, o));
    }
}
