in map;

use ymirc::lexing::word;
use ymirc::syntax::expression::_;

use ymirc::semantic::{interpret, validator};
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::global;
use ymirc::errors::_;
use ymirc::utils::format;

use std::io;


/**
 * MapComposeValidation module
 *
 * Provides validation and construction of map literal values. Supports
 * element-wise validation, type inference for keys and values, and creation of
 * MapType and MapValue nodes. Enforces semantic rules regarding copy contexts:
 *
 *   - non-empty map literals require a surrounding copy expression,
 *   - deep copy of map literals is forbidden,
 *   - empty maps infer VoidType for the key type.
 *
 * All functions assume syntactic correctness and operate during semantic
 * validation.
 */
pub mod MapComposeValidation {

    /**
     * Validate a map literal and construct its semantic value.
     *
     * Steps:
     *   1. Validate each key and value expression.
     *   2. Infer key and value types using addArrayType(shared with array logic).
     *   3. For empty maps, use VoidType as the key type.
     *   4. Construct a MapType and generate its typeinfo.
     *   5. Construct a MapValue containing the validated keys and values.
     *   6. Enforce copy-context rules:
     *        - deep copy of map literals is forbidden,
     *        - non-empty map literals must appear inside a copy expression.
     *
     * @params:
     *   - context: validation context
     *   - mp:      the ListMapExpr representing the map literal
     *
     * @returns:
     *   - a MapValue containing the validated key/value pairs
     *
     * @throws:
     *   - ErrorMsg if any key or value is invalid, typeinfo creation fails, or copy-context rules are violated
     */
    pub fn validate(dmut context: &ValidationContext, mp: &ListMapExpr)-> &Value
        throws ErrorMsg
    {
        let mut keys: [mut &Value] = [];
        let mut values: [mut &Value] = [];
        let mut innerK: &Type = NONE_TYPE;
        let mut innerV: &Type = NONE_TYPE;

        for i in 0us .. mp.keys.len {
            let k = ValueValidation::validate(alias context, mp.keys[i]);
            innerK = SliceComposeValidation::addArrayType(alias context, k, innerK, ref keys);

            let v = ValueValidation::validate(alias context, mp.values[i]);
            innerV = SliceComposeValidation::addArrayType(alias context, v, innerV, ref values);
        }

        if (keys.len == 0us) {
            innerK = copy VoidType(mp.loc);
            innerV = innerV;
        }

        let mpType = copy MapType(mp.loc, innerK.clone(0u32), innerV, isMutable-> true);
        {
            TypeCreation::createMapTypeInfo(alias context, mp.loc, mpType);
        } catch {
            err: &ErrorMsg => {
                throw err.withNote(copy [copy ErrorMsg::note(mp.loc, format(ValidateErrorMessage::VALIDATING))]);
            }
        }

        let mpValue = copy MapValue(mp.loc, mpType, keys, values);
        if (context.isInCopy(mp) && context.isInDeepCopy()) { // dcopy[1 => 2], is prohibited
            throw copy ErrorMsg::fatal(mp.loc, format(ValidateErrorMessage::CTOR_MAP_DCOPY, mpType),
                                        notes-> copy [copy ErrorMsg::note(context.getCopyExpr().loc, format(ValidateErrorMessage::SIMPLE_COPY_DCOPY_REPLACE))]);
        }

        if (!context.isInCopy(mp) && keys.len != 0) { // [1 => 2] must be placed inside a copy op(i.e. copy [1 => 2])
            throw copy ErrorMsg::fatal(mp.loc, format(ValidateErrorMessage::CTOR_MAP_STACK, mpType),
                                        notes-> copy [copy ErrorMsg::note(context.getCopyExpr().loc, format(ValidateErrorMessage::ENCLOSE_COPY_LST), oneLine-> true)]);
        }

        return mpValue;
    }

}
