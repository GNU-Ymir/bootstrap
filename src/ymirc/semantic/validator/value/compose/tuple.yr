in tuple;

use ymirc::syntax::expression::_;
use ymirc::errors::_;
use ymirc::semantic::generator::{value::_, type::_};
use ymirc::semantic::validator;

use ymirc::utils::format;
use ymirc::lexing::keys;

/**
 * TupleComposeValidation module
 *
 * Provides validation and construction of tuple literal values. Supports
 * element-wise validation, expansion of nested tuples via ExpandValue, and
 * inference of element mutability. Produces a TupleType and a corresponding
 * TupleValue containing the validated elements.
 *
 * All functions assume the literal has passed syntactic validation.
 */
pub mod TupleComposeValidation {

    /**
     * Validate a tuple literal and construct its semantic value.
     *
     * Steps:
     *   1. Validate each element of the tuple.
     *   2. If an element is an ExpandValue, flatten its contents into the tuple.
     *   3. Infer the mutability of each element type.
     *   4. Construct a TupleType containing the inferred element types.
     *   5. Construct a TupleValue containing the validated element values.
     *
     * @params:
     *   - context: validation context
     *   - list:    the ListExpr representing the tuple literal
     *
     * @returns:
     *   - a TupleValue with its corresponding TupleType
     *
     * @throws:
     *   - &ErrorMsg if any element is invalid or expands to an invalid value
     */
    pub fn validate(dmut context: &ValidationContext, list: &ListExpr)-> &Value
        throws ErrorMsg
    {
        let mut parameters: [mut &Value] = [];
        let mut types: [mut &Type] = [];

        for it in list.params {
            let val = ValueValidation::validate(alias context, it);
            match val {
                e: &ExpandValue => {
                    for g_it in e.values {
                        TupleComposeValidation::addTupleType(g_it, ref parameters, ref types);
                    }
                }
                g_it: _ => {
                    TupleComposeValidation::addTupleType(g_it, ref parameters, ref types);
                }
            }
        }

        let type = copy TupleType(list.loc, types, isMutable-> true);
        return copy TupleValue(list.loc, type, parameters);
    }

    /**
     * Add a validated tuple element to the tuple’s parameter and type lists.
     *
     * Rejects values of type `NoneType` or `VoidType`, since tuples cannot
     * contain void or untyped values. Infers the element’s mutability using
     * TypeInference::inferImplicitMutability.
     *
     * @params:
     *   - val:    the validated element value
     *   - params: the list of tuple element values being constructed
     *   - types:  the list of tuple element types being constructed
     *
     * @returns:
     *   - nothing; `params` and `types` are modified in place
     *
     * @throws:
     *   - &ErrorMsg if the element has type NoneType or VoidType
     */
    pub fn addTupleType(val: &Value, ref mut params: [&Value], ref mut types: [&Type])
        throws ErrorMsg
    {
        if (val.type of NoneType || val.type of VoidType) {
            throw copy ErrorMsg::fatal(val.loc, ValidateErrorMessage::VOID_VALUE);
        }

        let type = TypeInference::inferImplicitMutability(val.type, val);

        params ~= [val];
        types ~= [type];
    }

}
