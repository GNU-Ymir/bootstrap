 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in array;

use ymirc::lexing::word;

use ymirc::syntax::expression::_;
use ymirc::semantic::validator;

use ymirc::errors::_;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::utils::format;

use ymirc::semantic::validator::value::compose::slicefor::slice;

/**
 * ArrayListComprValidation module
 *
 * Provides semantic validation for list comprehensions applied to arrays. Since
 * arrays are fixed-size and contiguous, the module converts the array into a
 * slice alias and delegates the actual comprehension logic to
 * SliceListComprValidation.
 *
 */
pub mod ArrayListComprValidation {

    /**
     * Validate a list comprehension applied to an array.
     *
     * Steps:
     *   1. Reject arrays whose element type is void.
     *   2. Convert the array into a slice alias using ValueCreation.
     *   3. Extract the resulting SliceType.
     *   4. Delegate validation to SliceListComprValidation::validate.
     *
     * @params:
     *   - context:    validation context
     *   - array:      the array value being iterated
     *   - arrayType:  the type of the array
     *   - floop:      the SliceForAllocatorExpr describing the comprehension
     *   - inCopy:     whether the comprehension is evaluated in copy‑mode
     *   - byAlias:    whether aliasing is permitted
     *
     * @returns:
     *   - (value, usedAlias): the resulting comprehension value and alias usage flag
     *
     * @throws:
     *   - ErrorMsg if the array element type is void
     *   - ErrorMsg if slice alias creation fails
     */
    pub fn validate(dmut context: &ValidationContext,
                    array:        &Value,
                    arrayType:    &ArrayType,
                    floop:        &SliceForAllocatorExpr,
                    inCopy:       bool,
                    byAlias:      bool)-> (&Value, bool)
        throws ErrorMsg
    {
        if arrayType.value of VoidType {
            throw copy ErrorMsg::fatal(array.loc,
                                       end-> floop.loc,
                                       format(ValidateErrorMessage::UNDEF_FOR_LOOP_OPERATOR, floop.vars.len, arrayType));
        }

        let slc = ValueCreation::createSliceAliasFromArray(array.loc, arrayType, array,
                                                           mutable-> byAlias && arrayType.isMutable);

        if let sT: &SliceType = slc.type {
            return SliceListComprValidation::validate(alias context, array, sT, floop,
                                                      inCopy-> inCopy,
                                                      byAlias-> byAlias);
        }

        panic;
    }
}
