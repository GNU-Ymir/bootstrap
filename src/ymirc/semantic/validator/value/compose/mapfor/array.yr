in array;

use ymirc::errors;
use ymirc::semantic::generator::type::native;
use ymirc::semantic::generator::value;
use ymirc::semantic::validator::value::compose::mapfor::slice;
use ymirc::syntax::expression::compose;
use ymirc::utils::format;

/**
 * ArrayMapComprValidation module
 *
 * Provides semantic validation for map comprehensions applied to arrays. The
 * array is converted into a slice alias, and the comprehension is delegated to
 * SliceMapComprValidation.
 */
pub mod ArrayMapComprValidation {

    /**
     * Validate a map comprehension applied to an array.
     *
     * @params:
     *   - context:    validation context
     *   - array:      the array value being iterated
     *   - arrayType:  the type of the array
     *   - floop:      the MapForAllocatorExpr describing the comprehension
     *   - byAlias:    whether aliasing is permitted
     *
     * @returns:
     *   - (value, usedAlias): the resulting comprehension value and alias usage flag
     *
     * @throws:
     *   - ErrorMsg if the array element type is void
     *   - ErrorMsg if slice alias creation fails
     */
    pub fn validate(dmut context: &ValidationContext,
                    array:        &Value,
                    arrayType:    &ArrayType,
                    floop:        &MapForAllocatorExpr,
                    byAlias:      bool)-> (&Value, bool)
        throws ErrorMsg
    {
        if arrayType.value of VoidType {
            throw copy ErrorMsg::fatal(array.loc,
                                       end-> floop.loc,
                                       format(ValidateErrorMessage::UNDEF_FOR_LOOP_OPERATOR, floop.vars.len, arrayType));
        }

        let slc = ValueCreation::createSliceAliasFromArray(array.loc, arrayType, array,
                                                           mutable-> byAlias && arrayType.isMutable);

        if let sT: &SliceType = slc.type {
            return SliceMapComprValidation::validate(alias context, slc, sT, floop,
                                                     byAlias-> byAlias);
        }

        panic;
    }
}
