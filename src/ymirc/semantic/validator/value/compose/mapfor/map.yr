in map;

use ymirc::errors;
use ymirc::lexing::{keys, word};
use ymirc::semantic::generator::{type::_, value::_};
use ymirc::syntax::expression::_;
use ymirc::utils::format;

/**
 * MapMapComprValidation module
 *
 * Provides semantic validation for map comprehensions applied to maps. The
 * iterated map is traversed by key/value pairs using the map iterator
 * protocol.
 */
pub mod MapMapComprValidation {

    /**
     * Validate a map comprehension applied to a map.
     *
     * @params:
     *   - context:    validation context
     *   - src:        the map value being iterated
     *   - srcType:    the type of the iterated map
     *   - floop:      the MapForAllocatorExpr describing the comprehension
     *   - byAlias:    whether aliasing is permitted
     *
     * @returns:
     *   - (value, usedAlias): the resulting comprehension value and alias usage flag
     *
     * @throws:
     *   - ErrorMsg if the number of iterator variables is invalid
     */
    pub fn validate(dmut context: &ValidationContext,
                    src:          &Value,
                    srcType:      &MapType,
                    floop:        &MapForAllocatorExpr,
                    byAlias:      bool)-> (&Value, bool)
        throws ErrorMsg
    {
        if floop.vars.len == 1 {
            return MapMapComprValidation::validateIteration(alias context, src, srcType, floop, floop.vars[0], none,
                                                            byAlias-> byAlias);
        }

        if floop.vars.len == 2 {
            return MapMapComprValidation::validateIteration(alias context, src, srcType, floop, floop.vars[0], (floop.vars[1])?,
                                                            byAlias-> byAlias);
        }

        throw copy ErrorMsg::fatal(floop.loc, format(ValidateErrorMessage::UNDEF_FOR_LOOP_OPERATOR, floop.vars.len, srcType));
    }

    /**
     * Validate a single iteration of a map comprehension over a map.
     *
     * @params:
     *   - context:    validation context
     *   - src:        the iterated map value
     *   - srcType:    the iterated map type
     *   - floop:      comprehension expression
     *   - keyIter:    key iterator variable
     *   - valueIter:  optional value iterator variable
     *   - byAlias:    aliasing flag
     *
     * @returns:
     *   - (value, usedAlias)
     *
     * @throws:
     *   - ErrorMsg if validation fails inside the comprehension
     */
    fn validateIteration(dmut context: &ValidationContext,
                         src:          &Value,
                         srcType:      &MapType,
                         floop:        &MapForAllocatorExpr,
                         keyIter:      &VarDeclExpr,
                         valueIter:    (&VarDeclExpr)?,
                         byAlias:      bool)-> (&Value, bool)
        throws ErrorMsg
    {
        let loc = floop.loc;
        let mut errors: (&ErrorMsg)? = none;
        let mut result: &Value = UNIT_VALUE;
        let mut usedAlias = false;

        context:.enterBlock();
        {
            let (lp, mapDecl, mapVref, mapType, usedAlias_) = MapMapComprValidation::validateInnerLoop(alias context, loc, src, srcType, floop, keyIter, valueIter,
                                                                                                      byAlias-> byAlias);

            result = MapForComposeValidation::validateResult(loc, mapType, copy [mapDecl, lp, mapVref]);
            usedAlias = usedAlias_;
        } catch {
            err => {
                errors = (err)?;
            }
        }

        {
            context:.quitBlock(warnUnused-> (!errors.hasValue));
        } catch {
            err => {
                errors = (err)?;
            }
        }

        if let Ok(err) = errors {
            throw err;
        }

        return (result, usedAlias);
    }

    /**
     * Build the iterator loop inserting a pair for each entry of the iterated
     * map.
     *
     * Constructs the loop using the map iterator protocol:
     *
     *   - MapIteratorBeginValue: create iterator
     *   - MapIteratorNextValue:  advance iterator
     *   - MapIteratorEndValue:   loop termination test
     *   - MapIteratorDelValue:   cleanup in a finally block
     *
     * @params:
     *   - context:    validation context
     *   - loc:        source location
     *   - src:        the iterated map value
     *   - srcType:    the iterated map type
     *   - floop:      comprehension expression
     *   - keyIter:    key iterator variable
     *   - valueIter:  optional value iterator variable
     *   - byAlias:    aliasing flag
     *
     * @returns:
     *   - (loopBlock, mapDecl, mapVref, mapType, usedAlias)
     *
     * @throws:
     *   - ErrorMsg if iterator validation or loop construction fails
     */
    fn validateInnerLoop(dmut context: &ValidationContext,
                         loc:          &Word,
                         src:          &Value,
                         srcType:      &MapType,
                         floop:        &MapForAllocatorExpr,
                         keyIter:      &VarDeclExpr,
                         valueIter:    (&VarDeclExpr)?,
                         byAlias:      bool)-> (&Value, &VarDeclValue, &VarRefValue, &MapType, bool)
        throws ErrorMsg
    {
        let iterType = copy MapIteratorType(src.loc, srcType);
        let beginValue = copy MapIteratorBeginValue(src.loc, iterType, src);

        let iterDecl = copy VarDeclValue(src.loc.locate(ForLoopKeys::ITER), iterType, beginValue, isMutable-> true);
        let iterVref = VariableCreation::createVarFromDecl(iterDecl, canCte-> false);

        let (keyDecl, valueDecl, _, usedAlias) = MapForLoopValidation::validateIteratorVars(alias context, iterVref, srcType, keyIter, valueIter,
                                                                                            byMutRef-> false,
                                                                                            byAlias-> byAlias,
                                                                                            mapIsLvalue-> src.isLvalue);

        let (mapDecl, mapVref, insert, mapType) = MapForComposeValidation::validateInnerInsert(alias context, floop);

        let test = copy MapIteratorEndValue(loc, iterVref);
        let increment = copy MapIteratorNextValue(loc, iterVref);
        let finBlk = copy BlockValue(loc, VOID_TYPE, copy [copy MapIteratorDelValue(loc, iterVref)]);
        let blk = copy BlockValue(loc, VOID_TYPE, copy [keyDecl, valueDecl, insert, increment]);

        let tryFin = copy TryFinallyValue(loc, VOID_TYPE,
                                          copy LoopValue(loc, VOID_TYPE, test, blk),
                                          finBlk,
                                          failVar-> UNIT_VALUE);

        return (copy BlockValue(loc, VOID_TYPE, copy [iterDecl, tryFin]), mapDecl, mapVref, mapType, usedAlias);
    }
}
