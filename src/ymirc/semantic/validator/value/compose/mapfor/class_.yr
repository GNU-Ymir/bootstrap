in class_;

use ymirc::errors;
use ymirc::lexing::word;
use ymirc::semantic::generator::{type::_, value::_};
use ymirc::syntax::expression::compose;
use ymirc::utils::format;

/**
 * ClassMapComprValidation module
 *
 * Provides semantic validation for map comprehensions applied to class objects
 * implementing the class-based for-loop protocol.
 */
pub mod ClassMapComprValidation {

    /**
     * Validate a map comprehension applied to a class object.
     *
     * @params:
     *   - context:    validation context
     *   - object:     the class instance being iterated
     *   - cptr:       the ClassPtrType of the object
     *   - floop:      the MapForAllocatorExpr describing the comprehension
     *   - byAlias:    whether aliasing is permitted
     *   - aliasLoc:   location used for alias-related diagnostics
     *
     * @returns:
     *   - the resulting comprehension value
     *
     * @throws:
     *   - ErrorMsg if iterator method validation fails
     */
    pub fn validate(dmut context: &ValidationContext,
                    object:       &Value,
                    cptr:         &ClassPtrType,
                    floop:        &MapForAllocatorExpr,
                    byAlias:      bool,
                    aliasLoc:     &Word)-> &Value
        throws ErrorMsg
    {
        let loc = floop.loc;
        let mut errors: (&ErrorMsg)? = none;

        let (beginMeth, endMeth) = ClassForLoopValidation::validateBegEndMethods(alias context, loc, object, cptr, byAlias, aliasLoc);

        context:.enterBlock();
        let result = {
            ClassMapComprValidation::validateInnerLoop(alias context, loc, cptr, floop, beginMeth, endMeth)
        } catch {
            err => {
                errors = (copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::FOR_LOOP_CPTR, cptr),
                                               notes-> copy [err]))?;
                UNIT_VALUE
            }
        };

        {
            context:.quitBlock(warnUnused-> (!errors.hasValue));
        } catch {
            err => {
                errors = (err)?;
            }
        }

        if let Ok(err) = errors {
            throw err;
        }

        return result;
    }

    /**
     * Build the loop inserting a pair at each iteration of the object.
     *
     * @params:
     *   - context:    validation context
     *   - loc:        source location
     *   - cptr:       class pointer type
     *   - floop:      comprehension expression
     *   - beginMeth:  BEGIN method value
     *   - endMeth:    END method value
     *
     * @returns:
     *   - the resulting comprehension value
     *
     * @throws:
     *   - ErrorMsg if iterator validation or loop construction fails
     */
    fn validateInnerLoop(dmut context: &ValidationContext,
                         loc:          &Word,
                         cptr:         &ClassPtrType,
                         floop:        &MapForAllocatorExpr,
                         beginMeth:    &Value,
                         endMeth:      &Value)-> &Value
        throws ErrorMsg
    {
        let mut outerLoop: [&Value] = [];
        let mut innerLoop: [&Value] = [];
        let (test, increment) = ClassForLoopValidation::validateLoopVar(alias context, loc, cptr, beginMeth, endMeth, floop.vars,
                                                                        ref innerLoop,
                                                                        ref outerLoop);

        let (mapDecl, mapVref, insert, mapType) = MapForComposeValidation::validateInnerInsert(alias context, floop);

        innerLoop ~= [insert, increment];

        let blk = copy BlockValue(loc, VOID_TYPE, innerLoop);
        let lp = copy LoopValue(loc, VOID_TYPE, test, blk);

        outerLoop ~= [mapDecl, lp, mapVref];

        return MapForComposeValidation::validateResult(loc, mapType, outerLoop);
    }
}
