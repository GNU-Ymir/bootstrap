in yield_;

use ymirc::errors;
use ymirc::lexing::word;
use ymirc::semantic::generator::{type::native, value::_};
use ymirc::syntax::expression::compose;

/**
 * YieldMapComprValidation module
 *
 * Provides semantic validation for map comprehensions applied to generators.
 */
pub mod YieldMapComprValidation {

    /**
     * Validate a map comprehension applied to a generator.
     *
     * @params:
     *   - context:   validation context
     *   - generator: the generator handle being iterated
     *   - yieldType: the type of the generator
     *   - floop:     the MapForAllocatorExpr describing the comprehension
     *   - byAlias:   whether the generator is iterated by alias
     *
     * @returns:
     *   - (the resulting comprehension value, whether the alias was used)
     *
     * @throws:
     *   - ErrorMsg if the validation of the comprehension fails
     */
    pub fn validate(dmut context: &ValidationContext,
                    generator:    &Value,
                    yieldType:    &YieldType,
                    floop:        &MapForAllocatorExpr,
                    byAlias:      bool)-> (&Value, bool)
        throws ErrorMsg
    {
        let loc = floop.loc;
        let mut errors: (&ErrorMsg)? = none;

        context:.enterBlock();
        let result = {
            YieldMapComprValidation::validateInnerLoop(alias context, loc, generator, yieldType, floop, byAlias)
        } catch {
            err => {
                errors = (err)?;
                (UNIT_VALUE, false)
            }
        };

        {
            context:.quitBlock(warnUnused-> (!errors.hasValue));
        } catch {
            err => {
                errors = (err)?;
            }
        }

        if let Ok(err) = errors {
            throw err;
        }

        return result;
    }

    /**
     * Build the loop inserting a pair for each value yielded by the generator.
     *
     * @returns:
     *   - (the resulting comprehension value, whether the alias was used)
     */
    fn validateInnerLoop(dmut context: &ValidationContext,
                         loc:          &Word,
                         generator:    &Value,
                         yieldType:    &YieldType,
                         floop:        &MapForAllocatorExpr,
                         byAlias:      bool)-> (&Value, bool)
        throws ErrorMsg
    {
        let mut outerLoop: [&Value] = [];
        let mut innerLoop: [&Value] = [];
        let (test, usedAlias) = YieldForLoopValidation::validateLoopVar(alias context, loc, generator, yieldType, floop.vars,
                                                                        byAlias,
                                                                        ref innerLoop,
                                                                        ref outerLoop);

        let (mapDecl, mapVref, insert, mapType) = MapForComposeValidation::validateInnerInsert(alias context, floop);

        innerLoop ~= [insert];

        let blk = copy BlockValue(loc, VOID_TYPE, innerLoop);
        let lp = copy LoopValue(loc, VOID_TYPE, test, blk);

        outerLoop ~= [mapDecl, lp, mapVref];

        return (MapForComposeValidation::validateResult(loc, mapType, outerLoop), usedAlias);
    }
}
