mod ::array;
mod ::class_;
mod ::map;
mod ::range;
mod ::slice;
mod ::tuple;
mod ::yield_;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          ROOT          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * MapForComposeValidation module
 *
 * Creates the map collecting the pairs produced by the iteration of a map
 * comprehension, and the insertion of a pair in it.
 *
 * A map is always allocated on the heap, so unlike a slice comprehension a map
 * comprehension has no compile time length to compute.
 */
pub mod MapForComposeValidation {

    /**
     * Validate a `mapfor` allocator expression.
     *
     * This function is a placeholder: `mapfor` expressions are recognized
     * syntactically but not yet implemented semantically. Any invocation of
     * this validator results in a fatal error indicating that the feature is
     * not supported in the current Ymir version.
     *
     * @params:
     *   - context: validation context
     *   - f:       the MapForAllocatorExpr representing the `mapfor` construct
     *
     * @returns:
     *   - never returns; always throws
     *
     * @throws:
     *   - ErrorMsg indicating that `mapfor` expressions are not supported
     */
    pub fn validate(dmut context: &ValidationContext, f: &MapForAllocatorExpr)-> &Value
        throws ErrorMsg
    {
        context;
        f;

        throw copy ErrorMsg::fatal(f.loc, format(ValidateErrorMessage::NOT_SUPPORTED_IN, __YMIR_VERSION__));
    }

    /**
     * Validate the key and the value of the comprehension, and create the map
     * collecting them.
     *
     * The type of the map is infered from the pair produced by the first
     * iteration, exactly as the type of a map literal is infered from its
     * first entry.
     *
     * @params:
     *   - context: validation context
     *   - floop:   the comprehension expression
     *
     * @returns:
     *   - (mapDecl, mapVref, insert, mapType)
     *
     * @throws:
     *   - ErrorMsg if the key or the value is invalid, or has no typeinfo
     */
    pub fn validateInnerInsert(dmut context: &ValidationContext, floop: &MapForAllocatorExpr)-> (&VarDeclValue, &VarRefValue, &Value, &MapType)
        throws ErrorMsg
    {
        let loc = floop.loc;
        let mut keys: [&Value] = [];
        let mut values: [&Value] = [];

        let key = ValueValidation::validate(alias context, floop.key);
        let keyType = SliceComposeValidation::addArrayType(alias context, key, NONE_TYPE, ref keys);

        let value = ValueValidation::validate(alias context, floop.value);
        let valueType = SliceComposeValidation::addArrayType(alias context, value, NONE_TYPE, ref values);

        let mapType = MapForComposeValidation::validateResultType(alias context, loc, keyType, valueType);
        let (mapDecl, mapVref) = MapForComposeValidation::validateResultValueDecl(loc, mapType);

        return (mapDecl, mapVref, copy MapInsertValue(loc, VOID_TYPE, mapVref, keys[0], values[0]), mapType);
    }

    /**
     * Create the type of the map constructed by the comprehension, and
     * register its typeinfo.
     *
     * @params:
     *   - context:   validation context
     *   - loc:       source location
     *   - keyType:   the type of the key produced at each iteration
     *   - valueType: the type of the value produced at each iteration
     *
     * @returns:
     *   - the type of the constructed map
     *
     * @throws:
     *   - ErrorMsg if the typeinfo of the map cannot be created
     */
    pub fn validateResultType(dmut context: &ValidationContext, loc: &Word, keyType: &Type, valueType: &Type)-> &MapType
        throws ErrorMsg
    {
        let mapType = copy MapType(loc, keyType.clone(0u32), valueType, isMutable-> true);
        {
            TypeCreation::createMapTypeInfo(alias context, loc, mapType);
        } catch {
            err: &ErrorMsg => {
                throw err.withNote(copy [copy ErrorMsg::note(loc, format(ValidateErrorMessage::VALIDATING))]);
            }
        }

        return mapType;
    }

    /**
     * Create the declaration of the map collecting the pairs, initialized with
     * an empty map.
     *
     * @params:
     *   - loc:     source location
     *   - mapType: the type of the constructed map
     *
     * @returns:
     *   - (mapDecl, mapVref)
     */
    pub fn validateResultValueDecl(loc: &Word, mapType: &MapType)-> (&VarDeclValue, &VarRefValue) {
        let noKey: [&Value] = [];
        let noValue: [&Value] = [];
        let empty = copy MapValue(loc, mapType, noKey, noValue);
        let mapDecl = copy VarDeclValue(loc.locate(ForLoopKeys::VALUE), mapType, empty, isMutable-> true);

        return (mapDecl, VariableCreation::createVarFromDecl(mapDecl, canCte-> false));
    }

    /**
     * Assemble the block of the comprehension into its final value.
     *
     * @params:
     *   - loc:     source location
     *   - mapType: the type of the constructed map
     *   - values:  the content of the block, ending with the reference to the map
     *
     * @returns:
     *   - the comprehension, wrapped in the copy that constructed it
     */
    pub fn validateResult(loc: &Word, mapType: &MapType, values: [&Value])-> &Value {
        let blk = copy BlockValue(loc, mapType, values);
        let lst = copy ListComprValue(loc, mapType, blk);

        return copy CopierValue(loc, mapType, lst, isDone-> true);
    }
}
