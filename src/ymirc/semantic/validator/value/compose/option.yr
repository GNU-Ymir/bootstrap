/*
 * Implements validation for the postfix option operator `x?` in Ymir.
 *
 * The `?` operator lifts a value into Option!T. It behaves like:
 *
 *     x? => Ok(x) if x does not throw
 *            Err(e) if x throws
 *
 * This operator is syntactic sugar for a minimal implicit try/catch that
 * converts exceptions into Option!T values.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::value::compose::option
 * @File: ymirc/semantic/validator/value/compose/option.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-03-27
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in option;

use ymirc::syntax::expression::_;
use ymirc::errors;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::lexing::{keys, word};

/**
 * OptionComposeValidation module
 *
 * Provides validation for the postfix option operator `x?`.
 *
 * Semantics:
 *   - `x?` evaluates `x` and wraps the result in Option!T.
 *   - If `x` throws, the operator catches the exception and produces
 *     Err(T) instead of propagating it.
 *
 * Throwing detection:
 *   - If the operand has no throwers, the operator lowers directly to:
 *         OptionValue(Ok(x))
 *
 *   - Otherwise, it lowers to a synthetic try/catch:
 *         { Ok(x) }
 *         catch { e => Err(e) }
 *
 */
pub mod OptionComposeValidation {

    /**
     * Validate a postfix option operator `x?`.
     *
     * @returns:
     *   - OptionValue or TryCatchValue
     */
    pub fn validate(dmut context: &ValidationContext, v: &TryExpr)-> &Value
        throws ErrorMsg
    {
        let content = ValueValidation::validate(alias context, v.value);

        return OptionComposeValidation::validate(alias context, v.loc, content);
    }

    /**
     * Validate a postfix option operator `x?` on a pre validated value.
     *
     * @returns:
     *   - OptionValue or TryCatchValue
     */
    pub fn validate(dmut context: &ValidationContext, loc: &Word, content: &Value)-> &Value
        throws ErrorMsg
    {
        let innerType = TypeInference::inferImplicitMutability(content.type, content);
        let optType = copy OptionType(loc, innerType, isMutable-> true);
        ValueVerification::verifyNoBreaking(loc, content);

        if (content.throwers.len == 0) {
            return copy OptionValue(loc, optType, content);
        }

        return OptionComposeValidation::validateCatcher(alias context, loc, optType, content);
    }

    /**
     * Validate a postfix option operator `x?` on a pre validated value that always
     * catches, whether or not `content` declares throwers.
     *
     * A call through a function pointer or a delegate declares none, function types
     * cannot express them, so the catcher is the only thing that knows the call can
     * throw. Used to wrap the call of `&?value` into an option.
     *
     * @returns:
     *   - TryCatchValue
     */
    pub fn validateCatching(dmut context: &ValidationContext, loc: &Word, content: &Value)-> &Value
        throws ErrorMsg
    {
        let innerType = TypeInference::inferImplicitMutability(content.type, content);
        let optType = copy OptionType(loc, innerType, isMutable-> true);

        return OptionComposeValidation::validateCatcher(alias context, loc, optType, content);
    }

    /**
     * Validate the throwing case of `x?`.
     *
     * Constructs the lowering:
     *
     *     {
     *         Ok(x)
     *     } catch {
     *         e => Err(e)
     *     }
     *
     * using OptionValue(Some) and ErrOptionValue.
     *
     * @returns:
     *   - TryCatchValue representing the lowered option-catching logic
     */
    fn validateCatcher(dmut context: &ValidationContext, loc: &Word, optType: &OptionType, content: &Value)-> &Value
        throws ErrorMsg
    {
        let tryValue = copy OptionValue(loc, optType, content);
        let exceptType = TypeCreation::createExceptionType(alias context, loc-> loc);
        let catchVar = copy VarDeclValue(loc.locate("#_catch"),
                                          exceptType,
                                          UNIT_VALUE,
                                          isMutable-> false);

        let catchVarRef = copy VarRefValue(loc-> catchVar.loc,
                                            declLoc-> catchVar.loc,
                                            exceptType,
                                            catchVar.uniqId,
                                            isSelf-> false,
                                            canCte-> false);

        let errValue = copy ErrOptionValue(loc, type-> optType, err-> catchVarRef);

        let tryBlock = copy BlockValue(loc, optType, copy [tryValue]);
        let elsBlock = copy BlockValue(loc, optType, copy [errValue]);

        return copy TryCatchValue(loc, optType, tryBlock, elsBlock, catchVar-> catchVar);
    }

}
