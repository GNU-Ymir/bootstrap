in compose;

use ymirc::syntax::expression::_;
use ymirc::errors::_;
use ymirc::semantic::generator::{value::_, type::_};

use std::io;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub mod ::slice;
pub mod ::slicefor;
pub mod ::lambda;
pub mod ::map;
pub mod ::mapfor;
pub mod ::option;
pub mod ::tuple;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          ROOT          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub mod ComposeValidation {

    pub fn validate(dmut context: &ValidationContext, cmp: &ComposeExpr)-> &Value
        throws ErrorMsg
    {
        match cmp {
            l: &LambdaExpr => return LambdaComposeValidation::validate(alias context, l);
            m: &ListMapExpr => return MapComposeValidation::validate(alias context, m);
            s: &SliceAllocatorExpr => return SliceComposeValidation::validateAlloc(alias context, s);
            t: &TryExpr => return OptionComposeValidation::validate(alias context, t);

            l: &ListExpr if l.isArray => return SliceComposeValidation::validate(alias context, l);
            l: &ListExpr if !l.isArray => return TupleComposeValidation::validate(alias context, l);

            m: &MapForAllocatorExpr => return MapForComposeValidation::validate(alias context, m);
            s: &SliceForAllocatorExpr => return SliceForComposeValidation::validate(alias context, s);
            _ => {
                eprintln("internal value composer validation; ", cmp.__typeinfo.name);
                panic;
            }
        }
    }

}
