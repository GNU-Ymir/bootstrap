 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in compose;

use ymirc::syntax::expression::_;
use ymirc::errors::_;
use ymirc::semantic::generator::{value::_, type::_};

use std::io;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub mod ::slice;
pub mod ::slicefor;
pub mod ::map;
pub mod ::mapfor;
pub mod ::option;
pub mod ::tuple;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          ROOT          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * ComposeValidation module
 *
 * Provides the dispatch function for validating composite expressions.
 *
 * Responsibilities:
 *   - inspect the dynamic variant of a ComposeExpr,
 *   - forward validation to the appropriate specialized module:
 *
 *        * LambdaExpr               → LambdaValidation
 *        * ListMapExpr              → MapComposeValidation
 *        * SliceAllocatorExpr       → SliceComposeValidation::validateAlloc
 *        * TryExpr                  → OptionComposeValidation
 *        * ListExpr(array)         → SliceComposeValidation
 *        * ListExpr(tuple)         → TupleComposeValidation
 *        * MapForAllocatorExpr      → MapForComposeValidation
 *        * SliceForAllocatorExpr    → SliceForComposeValidation
 *
 */
pub mod ComposeValidation {

    /**
     * Validate a composite expression by dispatching to the correct validator.
     *
     * @params:
     *   - context: validation context
     *   - cmp:     composite expression to validate
     *
     * @returns:
     *   - the validated Value
     *
     * @throws:
     *   - ErrorMsg if the delegated validator throws
     */
    pub fn validate(dmut context: &ValidationContext, cmp: &ComposeExpr)-> &Value
        throws ErrorMsg
    {
        match cmp {
            l: &LambdaExpr => return LambdaValidation::validate(alias context, l);
            m: &ListMapExpr => return MapComposeValidation::validate(alias context, m);
            s: &SliceAllocatorExpr => return SliceComposeValidation::validateAlloc(alias context, s);
            t: &TryExpr => return OptionComposeValidation::validate(alias context, t);

            l: &ListExpr if l.isArray => return SliceComposeValidation::validate(alias context, l);
            l: &ListExpr if !l.isArray => return TupleComposeValidation::validate(alias context, l);

            m: &MapForAllocatorExpr => return MapForComposeValidation::validate(alias context, m);
            s: &SliceForAllocatorExpr => return SliceForComposeValidation::validate(alias context, s);
            _ => {
                eprintln("internal value composer validation; ", cmp.__typeinfo.name);
                panic;
            }
        }
    }
}
