in create;

use ymirc::syntax::expression::_;
use ymirc::lexing::word;
use ymirc::semantic::{symbol, validator, generator::{value::_, type::_}};
use ymirc::errors::message;

use ymirc::utils::format;
use ymirc::global::core_;


pub mod ValueCreation {

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          SLICES          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Create a slice alias using an array value
     *
     * @warning: this function does not make a copy of the array, thus it
     * assumes that the value will be used to create a copy of some sort, or
     * passed as a reference to a runtime function that was verified to not leak
     * out the reference.
     *
     * @params:
     *     - loc: the location of the operation
     *     - a: the type of the array to alias
     *     - v: the value of the array to alias
     *     - mutable: true if the alias is mutable(if array is not mutable, does not override its real mutability)
     *
     * @returns: a slice ctor values, containing the address of the array as a pointer
     *
     * */

    pub fn createSliceAliasFromArray(loc: &Word, a: &ArrayType, v: &Value, mutable: bool = true)-> &Value {
        let inner = if (mutable) {
            a.value
        } else { a.value.clone(0u32) };

        let sliceType = {
            copy SliceType(loc, inner, isMutable-> (inner.isMutable && mutable))
        } catch { // array type cannot enclose movable, so inner cannot be a movable
            _ => panic;
        };

        if (a.len != 0us) {
            let ptrType = copy PointerType(loc, inner, isMutable-> inner.isMutable);
            let arrayAddr = copy AddressValue(loc, ptrType, v);
            return copy SliceCtorValue(loc,
                                        sliceType,
                                        arrayAddr,
                                        copy NullValue(loc), // no blk info, array are stack located
                                        copy IntValue(loc, USIZE_TYPE, a.len),
                                        isImplicitAlias-> false);
        }

        let nl = copy NullValue(loc);
        return copy SliceCtorValue(loc,
                                    sliceType,
                                    nl,
                                    nl, // blk info is empty since slice is empty
                                    copy IntValue(loc, USIZE_TYPE, 0),
                                    isImplicitAlias-> false);
    }

    /**
     * Create a slice containing only one element from a single element
     * It can be useful to append values at the end of slices for example
     *
     * @params:
     *    - loc: the location of the creation
     *    - v: the value to put in the slice
     *    - mutable: true if the alias is mutable(if array is not mutable, does not override its real mutability)
     *
     * @returns: a slice ctor values, containing the address of the array as a pointer
     */
    pub fn createSliceFromSingleValue(loc: &Word, v: &Value, mutable: bool = true)-> &Value
        throws ErrorMsg
    {
        let arrType = copy ArrayType(loc, v.type, 1us, isMutable-> mutable);

        return ValueCreation::createSliceAliasFromArray(loc,
                                                         arrType,
                                                         copy ArrayValue(loc, arrType, copy [v]));
    }


    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          ENUM          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub fn createEnumUnwrap(value: &Value)-> &Value {
        if let en: &EnumType = value.type {
            if let v: &EnumFieldAccessValue = value {
                return ValueCreation::createEnumUnwrap(v.value);
            }

            return copy CastValue(value.loc, en.getLastLevelProxy(), value);
        }

        return value;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          RANGES          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */


    pub fn createRangeUnwrap(range: &Value, rangeType: &RangeType, reduce: bool = true)-> (&Value, &Value, &Value, &Value)
        throws ErrorMsg
    {
        let loc = value.loc;
        let mut fst  = copy StructFieldAccessValue(loc, rangeType.start, range, RangeKeys::FST);
        let mut scd  = copy StructFieldAccessValue(loc, rangeType.start, range, RangeKeys::SCD);
        let mut step = copy StructFieldAccessValue(loc, rangeType.step, range, RangeKeys::STEP);
        let mut contains = copy StructFieldAccessValue(loc, BOOL_TYPE, range, RangeKeys::CONTAINS);

        if reduce {
            let dmut interpret = alias context.cteInterpret;

            fst = interpret:.reduce(fst);
            scd = interpret:.reduce(scd);
            step = interpret:.reduce(step);
            contains = interpret:.reduce(contains);
        }

        return (fst, scd, step, contains);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          CLASS          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Construct an object instance from an object type and parameters(usefull
     * to instanciate internal exceptions for example)
     *
     * @params:
     *    - loc: the location of the construction
     *    - type: the type of the class to instanciate(assumed to be ClassPtrType or ClassRefType)
     *    - params: the list of parameters to pass to the ctor
     * @returns: a object value construction
     * @throws:
     *    - &ErrorMsg: if the creation failed
     * */
    pub fn createObjectInstance(dmut context: &ValidationContext, loc: &Word, type: &Type, params: [&Value])-> &Value
        throws ErrorMsg
    {
        let (ctors, isStruct) = match type {
            c: &ClassPtrType => {
                (ClassStaticFieldValidation::validateClassCtors(alias context, loc, c.inner, name-> ""), c.sym.isStruct)
            }
            c: &ClassRefType => {
                (ClassStaticFieldValidation::validateClassCtors(alias context, loc, c, name-> ""), c.sym.isStruct)
            }
            _ => panic;
        }

        return CallValidation::validate(alias context, loc, ctors, params, inCopy-> !isStruct);
    }


    /**
     * Find the method of a class by its name(useful for op overrides)
     * @params:
     *    - loc: the location of the access
     *    - cptr: the type of the class being accessed
     *    - value: the value of the object instance
     *    - meth: the method to find
     * @returns: the method(mult sym)
     * @throws:
     *    - &ErrorMsg: if the class does not have that method
     * */
    pub fn createObjectMethodAcc(dmut context: &ValidationContext,
                                  loc:          &Word,
                                  cptr:         &ClassPtrType,
                                  value:        &Value,
                                  meth:         [c8],
                                  allowImmut:   bool = false)-> &Value

        throws ErrorMsg
    {
        let (inPrv, inProt) = context.getCurrentClassReferentProtections(cptr.inner);
        let var = copy VarExpr(loc.locate(meth), isQuoted-> true);

        {
            return ClassVtableAccessValidation::validate(alias context, loc,
                                                          object-> value,
                                                          cref-> cptr.inner,
                                                          method-> var,
                                                          isProxy-> (value of SuperProxyValue),
                                                          allowImmut-> allowImmut,
                                                          inCall-> true);
        } catch {
            err => {
                throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::CLASS_NO_METHOD, value.type, meth),
                                            notes-> copy [err]);
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          ATOMIC          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub fn createAtomicLocksNoMonitorFuncs(dmut context: &ValidationContext, loc: &Word)-> (&Value, &Value)
        throws ErrorMsg
    {
        let mut lockFn: &Value = UNIT_VALUE;
        if let Ok(lo: &Value) = context.getCoreValue(AtomicUtils::LOCK_GLOBAL) {
            lockFn = lo;
        } else {
            let lockName = VariableCreation::createSyntaxVarFromPath(loc, AtomicUtils::LOCK_GLOBAL);
            lockFn = ValueValidation::validate(alias context, lockName);

            context:.insertCoreValue(AtomicUtils::UNLOCK_GLOBAL, lockFn);
        }

        let mut unlockFn: &Value = UNIT_VALUE;
        if let Ok(un: &Value) = context.getCoreValue(AtomicUtils::UNLOCK_GLOBAL) {
            lockFn = un;
        } else {
            let unlockName = VariableCreation::createSyntaxVarFromPath(loc, AtomicUtils::UNLOCK_GLOBAL);
            unlockFn = ValueValidation::validate(alias context, unlockName);

            context:.insertCoreValue(AtomicUtils::UNLOCK_GLOBAL, unlockFn);
        }

        return (lockFn, unlockFn);
    }

    pub fn createAtomicLocksWithMonitorFuncs(dmut context: &ValidationContext, loc: &Word)-> (&Value, &Value)
        throws ErrorMsg
    {
        let mut lockFn: &Value = UNIT_VALUE;
        if let Ok(lo: &Value) = context.getCoreValue(AtomicUtils::LOCK_MONITOR) {
            lockFn = lo;
        } else {
            let lockName = VariableCreation::createSyntaxVarFromPath(loc, AtomicUtils::LOCK_MONITOR);
            lockFn = ValueValidation::validate(alias context, lockName);

            context:.insertCoreValue(AtomicUtils::UNLOCK_GLOBAL, lockFn);
        }

        let mut unlockFn: &Value = UNIT_VALUE;
        if let Ok(un: &Value) = context.getCoreValue(AtomicUtils::UNLOCK_MONITOR) {
            lockFn = un;
        } else {
            let unlockName = VariableCreation::createSyntaxVarFromPath(loc, AtomicUtils::UNLOCK_MONITOR);
            unlockFn = ValueValidation::validate(alias context, unlockName);

            context:.insertCoreValue(AtomicUtils::UNLOCK_GLOBAL, unlockFn);
        }

        return (lockFn, unlockFn);
    }

    pub fn createOutOfArrayTest(loc: &Word, test: &Value)-> &Value {
        let call = copy PanicValue(loc);
        return copy ConditionalValue(loc, VOID_TYPE, test,
                                      thenv-> call,
                                      elsev-> UNIT_VALUE,
                                      isComplete-> false);
    }
}
