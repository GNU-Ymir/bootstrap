/*
 * Implements validation for `while let` loop expressions in Ymir.
 *
 * A `while let` loop repeatedly matches a pattern against a value and
 * executes the loop body as long as the match succeeds and the optional
 * guard evaluates to true.
 *
 * General form:
 *
 *     while let PATTERN = VALUE[guard GUARD] {
 *         ...
 *     }
 *
 * This module validates the pattern, performs match checking, evaluates
 * optional guards, manages loop scopes, detects constant conditions, and
 * constructs a LoopValue representing the loop.
 *
 * Responsibilities:
 *   - extract the pattern/value pair from the test expression
 *   - validate pattern matching via MatchValidation
 *   - validate optional guard expressions
 *   - detect useless constant guards(infinite or never-entered loops)
 *   - validate the loop body under a scoped environment
 *   - ensure the loop body evaluates to void
 *   - construct the LoopValue
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::value::control::whilelet
 * @File: ymirc/semantic/validator/value/control/whilelet.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-03-30
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in whilelet;

use ymirc::lexing::word;

use ymirc::syntax::expression::_;
use ymirc::semantic::validator;
use ymirc::semantic::generator::{value, value::_, type, type::_};

use ymirc::errors::message;
use ymirc::utils::format;

/**
 * WhileLetLoopValidation module
 *
 * Provides validation for `while let` loop expressions.
 *
 * Semantics:
 *   - The test expression must be a pattern binding or pattern declaration.
 *   - Pattern matching is validated through MatchValidation.
 *   - Optional guards refine the match condition.
 *   - Constant guards produce:
 *        - INFINITE_LOOP  if always true
 *        - NEVER_ENTERED_LOOP if always false
 *
 *   - The loop body is validated inside both:
 *        - a new block scope(for pattern-bound variables)
 *        - a loop scope(for break/continue semantics)
 *
 *   - The loop body must evaluate to void.
 *     (Only `break` determines the loop’s result type, but `while let`
 *      loops always use void as the loop type.)
 *
 * The module enforces:
 *   - correct pattern extraction
 *   - correct matcher and guard validation
 *   - correct scoping of pattern-bound variables
 *   - correct loop-type semantics
 *   - correct memory-ownership rules for the loop body
 */
pub mod WhileLetLoopValidation {

    /**
     * Validate a `while let` loop expression.
     *
     * @params:
     *   - context: validation context
     *   - wl:      while-let loop expression
     *
     * @returns:
     *   - a LoopValue representing the loop
     *
     * @throws:
     *   - ErrorMsg if pattern matching fails, the guard is invalid, the
     *     condition is constant, or the loop body is invalid
     */
    pub fn validate(dmut context: &ValidationContext, wl: &WhileLetLoopExpr)-> &Value
        throws ErrorMsg
    {
        let mut error: (&ErrorMsg)? = none;
        let mut hasErrors = false;

        let (pattern, value) = ConditionalLetValidation::extractPattern(wl.test);
        let result = MatchValidation::validatePattern(alias context, value, pattern);
        if let Ok(err) = result.error {
            throw err;
        }

        let voidType = copy VoidType(wl.loc);
        context:.enterBlock();
        context:.enterLoop();
        context:.setCurrentLoopType(voidType);

        let (content, test) = {
            let guard = MatchValidation::validateGuard(alias context, result, wl.guard);
            if let b: &BoolValue = context.cteInterpret:.reduce(guard.tautology) {
                if b.isTrue throw copy ErrorMsg::fatal(b.loc, format(ValidateErrorMessage::INFINITE_LOOP));
                else {
                    throw copy ErrorMsg::fatal(b.loc, format(ValidateErrorMessage::NEVER_ENTERED_LOOP));
                }
            }

            let content = ValueValidation::validate(alias context, wl.block);
            (content, guard.test)
        } catch {
            err: &ErrorMsg => {
                error = (err)?;
                hasErrors = true;
                (UNIT_VALUE, UNIT_VALUE)
            }
        };

        context:.quitLoop();
        TypeVerification::verifyCompatible(content.loc, wl.loc, content.type, voidType);

        {
            // No need to warn unused if there were errors in the validation of the block(it will complicate the error handling)
            context:.quitBlock(warnUnused-> !hasErrors);
        } catch {
            err: &ErrorMsg => {
                if (!hasErrors) {
                    error = (err)?;
                }
            }
        }

        if let Ok(err) = error {
            throw err;
        }

        return copy LoopValue(wl.loc, voidType, test, content);
    }

}
