in conditional;

use ymirc::syntax::expression::control;
use ymirc::semantic::validator;
use ymirc::semantic::generator::value;
use ymirc::errors::message;

pub mod ConditionalValidation {

    pub fn validate (dmut context: &ValidationContext, cond: &ConditionalExpr)-> &Value
        throws ErrorMsg
    {
        if !cond.isCte.isEof {
            return ConditionalValidation::validateCte (alias context, cond);
        }

        
        context;
        cond;
        panic;
    }

    pub fn validateCte (dmut context: &ValidationContext, cond: &ConditionalExpr)-> &Value
        throws ErrorMsg
    {
        context;
        cond;
        panic;
    }
    
}
