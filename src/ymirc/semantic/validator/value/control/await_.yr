/*
 * Implements validation for `await` expressions in Ymir.
 *
 * The `await` keyword is reserved for future asynchronous features. At the
 * moment, Ymir does not support promises.
 *
 * Any use of `await` results in a fatal diagnostic indicating that the feature
 * is not yet implemented in this version of the language.
 *
 * Responsibilities:
 *   - reject all uses of `await`
 *   - provide a consistent NOT_SUPPORTED_IN diagnostic
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::semantic::validator::value::control::await_
 * @File: ymirc/semantic/validator/value/control/await_.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2026-03-27
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in await_;

use ymirc::syntax::expression::control;
use ymirc::semantic::validator;
use ymirc::semantic::generator::value;
use ymirc::errors::message;
use ymirc::global::common;

use ymirc::utils::format;

/**
 * AwaitValidation module
 *
 * Provides validation for `await` expressions.
 *
 * Current semantics:
 *   - `await` is a reserved keyword.
 *   - The feature is not implemented in the current Ymir version.
 *   - Any attempt to validate an `await` expression results in a fatal error.
 *
 * This module exists to:
 *   - reserve the syntax
 *   - provide a stable error message
 *   - allow future versions of Ymir to implement asynchronous semantics
 */
pub mod AwaitValidation {

    /**
     * Validate an `await` expression.
     *
     * Since asynchronous waiting is not supported in the current version of
     * Ymir, this function always emits a NOT_SUPPORTED_IN diagnostic.
     *
     * @params:
     *   - context: validation context
     *   - aw:      await expression
     *
     * @throws:
     *   - ErrorMsg::fatal indicating that `await` is not supported
     *
     * @returns:
     *   - never returns; always throws
     */
    pub fn validate (dmut context: &ValidationContext, aw: &AwaitExpr)-> &Value
        throws ErrorMsg
    {        
        context;
        aw;

        throw copy ErrorMsg::fatal (aw.loc, format (ValidateErrorMessage::NOT_SUPPORTED_IN, __YMIR_VERSION__));        
    }
    
}
