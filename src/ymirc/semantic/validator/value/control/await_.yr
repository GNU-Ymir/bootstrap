 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in await_;

use ymirc::errors;
use ymirc::lexing::keys;
use ymirc::semantic::generator::value::_;
use ymirc::semantic::generator::type::{custom, native};
use ymirc::syntax::expression::_;
use ymirc::utils::format;

/**
 * AwaitValidation module
 *
 * Semantics:
 *   - an `await` must appear in the body of an async, not in a generator, nor in a
 *     lambda nested in an async,
 *   - it cannot appear inside a try block, a catch or a scope guard, as the body
 *     would be resumed inside a region the resumption cannot re-enter,
 *   - `await e` awaits an async value `e: async-> U`, and is typed `U`,
 *   - `await f` awaits a future value `f: future-> U`, and is typed `U`,
 *   - `await c` awaits a class `c` whose method `poll (waker: dg ()-> void)-> U?` is
 *     called at each resumption until it returns a value, and is typed `U`, the method
 *     being found by name, called on `alias c` when it is mutable, and never throwing,
 *   - `await;` gives control back to the driver, and is typed `void`.
 */
pub mod AwaitValidation {

    /**
     * Validate an `await` expression.
     *
     * @params:
     *   - context: validation context
     *   - aw:      await expression
     *
     * @returns:
     *   - AwaitValue, typed as the value the awaited async or thread completes with
     *
     * @throws:
     *   - ErrorMsg if the await is outside an async, inside a protected region, or
     *     awaits a value that cannot be awaited
     */
    pub fn validate(dmut context: &ValidationContext, aw: &AwaitExpr)-> &Value
        throws ErrorMsg
    {
        if !context.isInAsync() {
            if context.isInGenerator() {
                throw copy ErrorMsg::fatal(aw.loc, ValidateErrorMessage::AWAIT_IN_GENERATOR);
            }

            throw copy ErrorMsg::fatal(aw.loc, ValidateErrorMessage::AWAIT_NO_ASYNC);
        }

        let inRegion = context.getInUnresumableRegion();
        if !inRegion.isEof {
            throw copy ErrorMsg::fatal(aw.loc, end-> inRegion, format(ValidateErrorMessage::SUSPEND_PROTECTED_REGION, Keys::AWAIT));
        }

        if aw.value of EmptyExpr {
            return copy AwaitValue(aw.loc, VOID_TYPE, UNIT_VALUE);
        }

        let handle = ValueValidation::validate(alias context, aw.value);
        ValueVerification::verifyNoBreaking(handle.loc, handle);

        if let a: &AsyncType = handle.type {
            return copy AwaitValue(aw.loc, a.retType, YieldValidation::consume(handle));
        }

        if let f: &FutureType = handle.type {
            return copy AwaitValue(aw.loc, f.retType, handle);
        }

        let (object, byAlias) = if let a: &AliaserValue = handle { (a.value, true) } else { (handle, false) };
        if let c: &ClassPtrType = object.type {
            return AwaitValidation::validatePoll(alias context, aw, object, c, byAlias-> byAlias);
        }

        throw copy ErrorMsg::fatal(aw.loc, format(ValidateErrorMessage::AWAIT_NOT_AWAITABLE, handle.type));
    }

    /**
     * Validate the `await` of a class: the class is stored once, crossing the suspensions,
     * and its method poll is called with the waker of the current async at each resumption.
     *
     * @params:
     *   - context: validation context
     *   - aw:      await expression
     *   - object:  the class awaited
     *   - cptr:    the type of the class awaited
     *   - byAlias: true iff the class is awaited by `await alias c`
     *
     * @returns:
     *   - the block `{ let #_awaited = c; await #_awaited.poll (#_waker) }`, typed as the content
     *     of the option poll returns
     *
     * @throws:
     *   - ErrorMsg if the class has no method poll taking the waker, or it does not return an
     *     option, or it throws
     */
    fn validatePoll(dmut context: &ValidationContext, aw: &AwaitExpr, object: &Value, cptr: &ClassPtrType, byAlias: bool)-> &Value
        throws ErrorMsg
    {
        let decl = copy VarDeclValue(object.loc.locate(GeneratorKeys::AWAITED), object.type, object,
                                     isMutable-> false);
        let awaited = VariableCreation::createVarFromDecl(decl, canCte-> false);
        let inst = if byAlias { copy ClassAliaserValue(awaited.loc, cptr, awaited) } else { awaited };

        let meth = ValueCreation::createObjectMethodAcc(alias context, aw.loc, cptr, inst, AsyncKeys::POLL);
        let poll = CallValidation::validate(alias context, aw.loc, meth, copy [copy AsyncWakerValue(aw.loc)]);
        let (protoLoc, retLoc, protoMsg) = if let c: &MethodCallValue = poll {
            (c.delegate.proto.loc, c.delegate.proto.retType.loc, format("%", c.delegate.proto, tags-> FormatTags(withParams-> true)))
        } else {
            (aw.loc, aw.loc, format("%", poll))
        };

        {
            if let o: &OptionType = poll.type {
                if poll.throwers.len != 0us {
                    let list = copy [copy ErrorMsg::note(it.loc, format("%", it.type)) for it in poll.throwers];
                    throw copy ErrorMsg::fatal(protoLoc, format(ValidateErrorMessage::AWAIT_POLL_THROWS), notes-> list);
                }

                return copy BlockValue(aw.loc, o.inners[0], copy [decl, copy AwaitValue(aw.loc, o.inners[0], poll)]);
            }

            throw copy ErrorMsg::fatal(retLoc, format(ValidateErrorMessage::AWAIT_POLL_NOT_OPTION, poll.type));
        } catch {
            err: &ErrorMsg => {
                throw err.withNote(copy [copy ErrorMsg::note(protoLoc, format(ValidateErrorMessage::CALL_PROTO, protoMsg))]);
            }
        }
    } catch {
        err: &ErrorMsg => {
            throw copy ErrorMsg::fatal(aw.loc, format(ValidateErrorMessage::AWAIT_POLL, cptr), notes-> copy [err]);
        }
    }

}
