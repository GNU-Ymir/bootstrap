 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in await_;

use ymirc::errors;
use ymirc::lexing::keys;
use ymirc::semantic::generator::value::_;
use ymirc::semantic::generator::type::native;
use ymirc::syntax::expression::_;
use ymirc::utils::format;

/**
 * AwaitValidation module
 *
 * Semantics:
 *   - an `await` must appear in the body of an async, not in a generator, nor in a
 *     lambda nested in an async,
 *   - it cannot appear inside a try block, a catch or a scope guard, as the body
 *     would be resumed inside a region the resumption cannot re-enter,
 *   - `await e` awaits an async value `e: async-> U`, and is typed `U`,
 *   - `await f` awaits a future value `f: future-> U`, and is typed `U`,
 *   - `await;` gives control back to the driver, and is typed `void`.
 */
pub mod AwaitValidation {

    /**
     * Validate an `await` expression.
     *
     * @params:
     *   - context: validation context
     *   - aw:      await expression
     *
     * @returns:
     *   - AwaitValue, typed as the value the awaited async or thread completes with
     *
     * @throws:
     *   - ErrorMsg if the await is outside an async, inside a protected region, or
     *     awaits a value that cannot be awaited
     */
    pub fn validate(dmut context: &ValidationContext, aw: &AwaitExpr)-> &Value
        throws ErrorMsg
    {
        if !context.isInAsync() {
            if context.isInGenerator() {
                throw copy ErrorMsg::fatal(aw.loc, ValidateErrorMessage::AWAIT_IN_GENERATOR);
            }

            throw copy ErrorMsg::fatal(aw.loc, ValidateErrorMessage::AWAIT_NO_ASYNC);
        }

        let inRegion = context.getInUnresumableRegion();
        if !inRegion.isEof {
            throw copy ErrorMsg::fatal(aw.loc, end-> inRegion, format(ValidateErrorMessage::SUSPEND_PROTECTED_REGION, Keys::AWAIT));
        }

        if aw.value of EmptyExpr {
            return copy AwaitValue(aw.loc, VOID_TYPE, UNIT_VALUE);
        }

        let handle = ValueValidation::validate(alias context, aw.value);
        ValueVerification::verifyNoBreaking(handle.loc, handle);

        if let a: &AsyncType = handle.type {
            return copy AwaitValue(aw.loc, a.retType, handle);
        }

        if let f: &FutureType = handle.type {
            return copy AwaitValue(aw.loc, f.retType, handle);
        }

        throw copy ErrorMsg::fatal(aw.loc, format(ValidateErrorMessage::AWAIT_NOT_AWAITABLE, handle.type));
    }

}
