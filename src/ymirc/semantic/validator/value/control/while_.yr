/*
 * Implements validation for `while` and `loop` expressions in Ymir.
 *
 * A while-loop has two possible forms:
 *
 *   - `while <test> { ... }`
 *   - `loop { ... }`          (equivalent to `while true { ... }`)
 *
 * This module validates the test expression, detects constant conditions,
 * manages loop-scoped type inference, and constructs a LoopValue representing
 * the loop.
 *
 * Responsibilities:
 *   - validate the test expression(if present)
 *   - detect constant true/false tests and emit diagnostics
 *   - enter and exit loop scopes
 *   - track the inferred loop type(from `break` expressions)
 *   - ensure the loop body evaluates to void
 *   - construct the LoopValue
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::value::control::while_
 * @File: ymirc/semantic/validator/value/control/while_.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-03-27
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in while_;

use ymirc::lexing::word;

use ymirc::syntax::expression::_;
use ymirc::semantic::validator;
use ymirc::semantic::generator::{value, value::_, type, type::_};

use ymirc::errors;
use ymirc::utils::format;

/**
 * WhileLoopValidation module
 *
 * Provides validation for `while` and `loop` expressions.
 *
 * Loop semantics:
 *
 *   - The test expression must be boolean.
 *   - A constant `true` test produces an INFINITE_LOOP diagnostic.
 *   - A constant `false` test produces a NEVER_ENTERED_LOOP diagnostic.
 *
 *   - The loop body is validated inside a loop scope:
 *        - `break` expressions may contribute a loop result type
 *        - `continue` expressions are allowed
 *
 *   - The loop body itself must evaluate to void.
 *     (Only `break` determines the loop’s result type.)
 *
 * The module enforces:
 *   - boolean test expressions
 *   - constant-condition detection
 *   - correct loop-type inference
 *   - correct memory-ownership rules for the loop body
 */
pub mod WhileLoopValidation {

    /**
     * Validate a `while` or `loop` expression.
     *
     * @params:
     *   - context: validation context
     *   - wl:      while-loop expression
     *
     * @returns:
     *   - a LoopValue representing the loop
     *
     * @throws:
     *   - ErrorMsg if the test is invalid, constant, or the body is invalid
     */
    pub fn validate(dmut context: &ValidationContext, wl: &WhileLoopExpr)-> &Value
        throws ErrorMsg
    {
        let mut test: &Value = UNIT_VALUE;
        if wl.test !of EmptyExpr {
            test = ValueValidation::validate(alias context, wl.test);
            TypeVerification::verifyCompatible(test.loc, EOF_WORD, test.type, BOOL_TYPE);

            if let b: &BoolValue = test {
                if b.isTrue throw copy ErrorMsg::fatal(b.loc, format(ValidateErrorMessage::INFINITE_LOOP));
                else {
                    throw copy ErrorMsg::fatal(b.loc, format(ValidateErrorMessage::NEVER_ENTERED_LOOP));
                }
            }
        }

        let voidType = copy VoidType(wl.loc);
        let content = {
            context:.enterLoop();
            if (wl.test !of EmptyExpr)
                context:.setCurrentLoopType(voidType);

            ValueValidation::validate(alias context, wl.block)
        } catch {
            err: &ErrorMsg => {
                context:.quitLoop();
                throw err;
            }
        }

        let mut loopType = context.getCurrentLoopType();
        if (loopType of NoneType) loopType = voidType;

        context:.quitLoop();

        // in `loop` the real type is associated to `break`; but the content block must be void
        //
        TypeVerification::verifyCompatible(content.loc, wl.loc, content.type, voidType);

        return copy LoopValue(wl.loc, loopType, test, content);
    }

}
