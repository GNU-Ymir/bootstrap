/*
 * Implements the root validation logic for Ymir's pattern-matching system.
 *
 * This module orchestrates the validation of:
 * 
 *   - match expressions
 *   - match lines (pattern + guard + value)
 *   - guards
 *   - all pattern kinds (var-decl, option, call, list, equal patterns)
 *
 * Responsibilities:
 * 
 *   - validate the matched value and its memory semantics
 *   - ensure each match line is well-typed and reachable
 *   - compute the combined test expressions for each branch
 *   - detect match completeness and unreachable patterns
 *   - validate guards and integrate them into branch conditions
 *   - recursively validate all pattern kinds
 *   - construct the final conditional expression for the match
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::semantic::validator::value::control::match_
 * @File: ymirc/semantic/validator/value/control/match_.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2026-03-27
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in match_;

use ymirc::lexing::{word, tokens, keys};
use ymirc::syntax::expression::_;
use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::errors::message;

use ymirc::semantic::validator::value::control::match_::_;
use ymirc::utils::format;


/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub mod ::catch_;
mod ::vardecl;
mod ::call;
mod ::option;
mod ::list;

mod ::result;
mod ::info;
mod ::verif;
mod ::create;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          ROOT          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * MatchValidation module
 *
 * Entry point for validating match expressions in Ymir.
 *
 * A match expression consists of:
 *   - a value to match
 *   - a list of match lines
 *   - each line contains:
 *        - a pattern
 *        - an optional guard
 *        - a value expression
 *
 * Semantics:
 *   - The matched value is validated once and stored in a unique variable.
 *   - Each match line is validated in order:
 *        - pattern test
 *        - guard test
 *        - branch value
 *   - Tests are accumulated to detect completeness.
 *   - Unreachable matchers are rejected.
 *   - Memory semantics (move, alias, ref, lazy) are propagated.
 *   - The final match expression is built as nested conditionals.
 *
 * The module enforces:
 *   - no breaking constructs in patterns
 *   - complete type information for matched values
 *   - correct memory-ownership semantics
 *   - correct guard typing (must be boolean)
 *   - correct pattern dispatching
 *   
 */
pub mod MatchValidation {

    /**
     * Validate a full match expression and produce the final value.
     *
     * Steps:
     *   1. Validate the matched value (allowing ref/lazy).
     *   2. Determine memory semantics (move, alias, ref).
     *   3. Create a unique variable holding the matched value.
     *   4. Validate all match lines via validateMatchers.
     *   5. If errors occurred => throw MATCH_VALIDATION with notes.
     *   6. Verify memory-info correctness.
     *   7. Build the final nested conditional expression.
     *
     * @params:
     *   - context: validation context
     *   - m:       the match expression
     *
     * @returns:
     *   The final value representing the match expression.
     *
     * @throws:
     *   ErrorMsg if validation fails or match is incomplete.
     */
    pub fn validate (dmut context: &ValidationContext, m: &MatcherExpr)-> &Value
        throws ErrorMsg
    {
        let mValue = ValueValidation::validate (alias context, m.value, canBeRef-> true);
        ValueVerification::verifyNoBreaking (m.loc, mValue);
        TypeVerification::verifyCompleteWithValue (m.value.loc, mValue.type, mValue, construct-> true);        

        let matchers = m.matchers;
        let (memInfo, isRef) = match mValue {
            r: &ReferencerValue  => { (MemoryInfo (byMutRef-> r.isMutable), true) }
            AliaserValue ()      => { (MemoryInfo (byAlias-> true), false) }
            _                    => { (MemoryInfo (byMove-> !MemoryVerification::needsExplicitMove (mValue)), false) } // is explicit move, if there is no need for a move to move
        };

        // Ensure the value is constructed (and only once) for each branch checks
        let uniqDecl = copy VarDeclValue (mValue.loc.locate ("#_value"),
                                          mValue.type,
                                          mValue,
                                          isMutable-> true,
                                          isReference-> isRef,
                                          isLazy-> false);
        
        let uniq = copy VarRefValue (loc-> uniqDecl.loc,
                                     declLoc-> uniqDecl.loc,
                                     mValue.type,
                                     uniqDecl.uniqId,
                                     isSelf-> false,
                                     canCte-> false);

        let result = MatchValidation::validateMatchers (alias context, m.loc, uniq, matchers, memInfo);
        if (result.errors.len != 0us) {
            throw copy ErrorMsg::fatal (m.loc, format (ValidateErrorMessage::MATCH_VALIDATION, mValue, mValue.type), notes-> result.errors);
        }

        MatchVerification::verifyUselessMemoryInfo (m.loc, valueLoc-> mValue.loc, mValue.type, retInfo-> result.memInfo, memInfo);
        
        if (result.tests.len > 0) {
            let finType = MatchVerification::verifyComplete (m.loc, uniq, result.isComplete, result.type, result.values);
            let mut current: &Value = UNIT_VALUE;
            for i in result.tests.len .. 0us {
                current = MatchCreation::createConditional (m.loc,
                                                            result.tests [i - 1us],
                                                            result.values [i - 1us],
                                                            elsev-> current,
                                                            finType,
                                                            isComplete-> result.isComplete);
            }
            
            if current !of UnitValue {
                return copy BlockValue (m.loc,
                                        current.type,
                                        copy [uniqDecl, current]);                
            }                        
        }

        return copy BlockValue (m.loc,
                                copy VoidType (m.loc),
                                copy [uniqDecl]);        
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          LINES          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Validate all match lines in order and accumulate:
     *   - tests
     *   - values
     *   - resulting type
     *   - memory information
     *   - completeness information
     *
     * Steps:
     *   1. For each line:
     *        - enter a new block
     *        - reject unreachable matchers
     *        - validate the line via validateLine
     *        - accumulate tests, values, types, memInfo
     *        - update completeness (tautology tracking)
     *        - collect errors
     *        - exit block with unused-variable warnings
     *
     *   2. If resulting type is NoneType => replace with VoidType.
     *
     * @params:
     *   - context:  validation context
     *   - loc:      location of the match expression
     *   - value:    the unique matched value
     *   - matchers: list of match lines
     *   - memInfo:  initial memory information
     *
     * @returns:
     *   MatchResult containing tests, values, type, memInfo, errors.
     */
    fn validateMatchers (dmut context: &ValidationContext,
                         loc:          &Word,
                         value:        &Value,
                         matchers:     [MatchLine],
                         memInfo:      MemoryInfo)-> MatchResult {

        let mut result = MatchResult ();                
        let mut currentTautCond: &Value = UNIT_VALUE;

        for line in matchers {
            let mut succeed = true;
            context:.enterBlock ();
            {
                if (result.isComplete) {
                    throw copy ErrorMsg::fatal (line.filter.loc, format (ValidateErrorMessage::UNREACHABLE_MATCHER));
                }
                
                let lineResult = MatchValidation::validateLine (alias context, value, result.type, line, memInfo);
                result.tests ~= [lineResult.test];
                result.values ~= [lineResult.blockValue];
                result.type = lineResult.blockType;

                if currentTautCond of UnitValue {
                    currentTautCond = lineResult.guard.tautology;
                } else {
                    currentTautCond = copy LogicalBoolOperatorValue (lineResult.test.loc,
                                                                     BinaryOperators::DPIPE,
                                                                     lineResult.guard.tautology,
                                                                     currentTautCond);
                }
                
                result.isComplete = MatchVerification::isTautology (alias context, currentTautCond);
                result.memInfo = result.memInfo | lineResult.memInfo;
            } catch {                
                err: &ErrorMsg => {
                    result.errors ~= [err];
                    succeed = false;
                }
            }

            {
                context:.quitBlock (warnUnused-> succeed);
            } catch {
                err: &ErrorMsg => { result.errors ~= [err]; }
            }
        }

        if result.type of NoneType {
            result.type = copy VoidType (loc);
        }

        return result;
    }

    /**
     * Validate a single match line:
     *   pattern => guard => branch value
     *
     * Steps:
     *   1. Validate the pattern and collect:
     *        - pattern test
     *        - memory info
     *        - variable declarations
     *
     *   2. Validate the guard using the pattern variables.
     *
     *   3. Combine pattern test AND guard test.
     *
     *   4. Validate the branch value:
     *        - infer type if needed
     *        - wrap in a BlockValue
     *
     * @params:
     *   - context: validation context
     *   - loc:     location of the match expression
     *   - value:   matched value
     *   - type:    expected branch type
     *   - line:    match line (pattern, guard, value)
     *   - memInfo: inherited memory information
     *
     * @returns:
     *   MatchLineResult
     *   
     * @throws:
     *   ErrorMsg if pattern, guard, or value is invalid.
     */
    fn validateLine (dmut context: &ValidationContext,                     
                     value: &Value,
                     type: &Type,
                     line: MatchLine,                     
                     memInfo: MemoryInfo)-> MatchLineResult
        throws ErrorMsg
    {
        let mut vars: [&VarDeclValue] = [];
        // Validate the pattern
        let (test, retInfo) = MatchValidation::validatePattern (alias context, value, line.filter, memInfo, ref vars);                
        let guard = MatchValidation::validateGuard (alias context, vars, currentCond-> test, guard-> line.guard);        

        // Validate the value associated with successful pattern match
        let val = ValueValidation::validate (alias context, line.value);
        let (t, v) = if (!val.isBreaker && !val.isReturner) {
            TypeInference::inferValueForBranch (alias context, type.loc, type, val)
        } else {
            (type, val)
        };

        return MatchLineResult (vars-> vars,
                                test-> guard.test,
                                memInfo-> retInfo,
                                guard-> guard,
                                blockValue-> copy BlockValue (line.value.loc, v.type, copy [v]),
                                blockType-> t); 
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          GUARDS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Wrapper for guard validation using a PatternResult.
     *
     * @params:
     *   - context: validation context
     *   - pattern: PatternResult containing vars and test
     *   - guard:   guard expression
     *
     * @returns:
     *   GuardResult     
     *
     * @throws:
     *   ErrorMsg if guard is invalid.
     */
    pub fn validateGuard (dmut context: &ValidationContext,
                          pattern:      PatternResult,
                          guard:        &Expression)-> GuardResult
        throws ErrorMsg
    {
        return MatchValidation::validateGuard (alias context,
                                               guard,
                                               pattern.vars,
                                               pattern.test);
    }

    /**
     * Validate a guard expression.
     *
     * Steps:
     *   1. Insert pattern variables into the local scope. @warning: done even if there's no guard
     *   2. If guard is empty:
     *        - guard test = TRUE
     *        - combined test = currentCond AND TRUE
     *   3. Otherwise:
     *        - validate guard expression
     *        - ensure type is Bool
     *        - combined test = currentCond AND guard
     *        - tautology = currentCond AND guard
     *
     * @params:
     *   - context:     validation context
     *   - guard:       guard expression
     *   - vars:        variables introduced by the pattern
     *   - currentCond: test expression from the pattern
     *
     * @returns:
     *   GuardResult (combined test, tautology, raw guard test)
     *
     * @throws:
     *   ErrorMsg if guard is not boolean.
     */
    pub fn validateGuard (dmut context: &ValidationContext,
                          guard:        &Expression,
                          vars:         [&VarDeclValue],                      
                          currentCond:  &Value)-> GuardResult
        throws ErrorMsg
    {        
        let mut testBlk: [&Value] = copy vars;
        for v in vars {
            if (v.name != Keys::UNDER) {
                context:.insertLocal (guard.loc, v.name, v, canShadow-> false);
            }
        }

        if guard of EmptyExpr {            
            testBlk ~= [TRUE_BOOL_VALUE];
            let res: &Value = copy LogicalBoolOperatorValue (currentCond.loc, BinaryOperators::DAND, currentCond,
                                                             copy BlockValue (currentCond.loc, BOOL_TYPE, testBlk, isSet-> true));
            return GuardResult (res, currentCond, TRUE_BOOL_VALUE);
        }
        
        let r = ValueValidation::validate (alias context, guard);
        if (r.type !of BoolType) {
            throw copy ErrorMsg::fatal (r.loc, format (ValidateErrorMessage::INCOMPATIBLE_TYPE, r.type, BOOL_TYPE));
        }

        testBlk ~= [r];
        let res: &Value = copy LogicalBoolOperatorValue (currentCond.loc, BinaryOperators::DAND, currentCond,
                                                         copy BlockValue (currentCond.loc, BOOL_TYPE, testBlk, isSet-> true));

        let taut: &Value = copy LogicalBoolOperatorValue (currentCond.loc, BinaryOperators::DAND, currentCond, r);
        return GuardResult (res, taut, r);                    
    }



    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PATTERNS          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Validate a pattern applied to an expression (entry point).
     *
     * Steps:
     *   1. Validate the value expression (allowing ref/lazy).
     *   2. Determine memory semantics (move, alias, ref, lazy).
     *   3. Dispatch to validatePattern(value, pattern, memInfo).
     *   4. Verify memory-info correctness.
     *   5. On error:
     *        - insert error variables to avoid undefined symbols
     *        - store the error in PatternResult
     *
     * @params:
     *   - context:     validation context
     *   - valueExpr:   expression being matched
     *   - patternExpr: pattern expression
     *   - canBeLazy:   whether lazy patterns are allowed
     *
     * @returns:
     *   PatternResult
     *   
     */
    pub fn validatePattern (dmut context: &ValidationContext,
                            value:        &Expression,
                            pattern:      &Expression,
                            canBeLazy:    bool = false)-> PatternResult
    {

        let mut result = PatternResult ();
        
        {
            let mValue = ValueValidation::validate (alias context, value, canBeRef-> true, canBeLazy-> canBeLazy);
            
            ValueVerification::verifyNoBreaking (pattern.loc, mValue);
            TypeVerification::verifyCompleteWithValue (value.loc, mValue.type, mValue, construct-> true);
            
            let (mut memInfo, fVal) = match mValue {
                r: &ReferencerValue => { (MemoryInfo (byMutRef-> true), r.value) }
                a: &AliaserValue => { (MemoryInfo (byAlias-> true), a.value) }
                l: &LazyValue => { (MemoryInfo (byLazy-> l.isByAlias), l) }

                // explicit move if there is no need for a move to move
                _ => { (MemoryInfo (byMove-> !MemoryVerification::needsExplicitMove (mValue)), mValue) }            
            };
            
            let (test, retInfo) = MatchValidation::validatePattern (alias context, fVal, pattern, memInfo, ref result.vars,
                                                                    canBeLazy-> canBeLazy);

            MatchVerification::verifyUselessMemoryInfo (pattern.loc, valueLoc-> mValue.loc, mValue.type, retInfo-> retInfo, memInfo);        


            result.value = mValue;
            result.test = test;
        } catch {
            err: &ErrorMsg => { // insert error variables to avoid future undefined symbol errors
                {                    
                    MatchCreation::createErrorVariables (context, pattern, ref result.vars);                                        
                } catch {
                    _ => {}               
                }
                
                result.error = (err)?;
            }
        }    
        
        return result;        
    }     

    /**
     * Validate a pattern applied to a value (core dispatcher).
     *
     * Dispatches based on pattern kind:
     *   - VarDeclExpr           => variable declaration pattern
     *   - MatchOptionFilterExpr => option pattern
     *   - MultOperatorExpr      => call pattern
     *   - MatchListFilterExpr   => list/tuple/array pattern
     *   - otherwise             => equality pattern
     *
     * @params:
     *   - context:  validation context
     *   - value:    value being matched
     *   - mtch:     pattern expression
     *   - memInfo:  inherited memory information
     *   - vars:     variable declarations introduced by the pattern
     *   - canBeLazy: allow lazy patterns
     *
     * @returns:
     *   (testExpression, memoryInfo)
     *
     * @throws:
     *   ErrorMsg if pattern is invalid.
     */
    pub fn validatePattern (dmut context: &ValidationContext,
                            value: &Value,
                            mtch: &Expression,
                            memInfo: MemoryInfo,
                            ref mut vars: [&VarDeclValue],                        
                            canBeLazy: bool = false)-> (&Value, MemoryInfo)
        throws ErrorMsg
    {
        match mtch {
            v: &VarDeclExpr => {
                return MatchVarDeclValidation::validate (alias context, value, v, memInfo, ref vars, canBeLazy-> canBeLazy);
            }
            o: &MatchOptionFilterExpr => {
                return MatchOptionValidation::validate (alias context, value, o, memInfo, ref vars);
            }
            m: &MultOperatorExpr => {
                return MatchCallValidation::validate (alias context, value, m, memInfo, ref vars);
            }
            l: &MatchListFilterExpr => {
                return MatchListValidation::validate (alias context, value, l, memInfo, ref vars);                
            }
        }
        
        let test = MatchValidation::validateEqualPattern (alias context, value, mtch);
        return (test, MemoryInfo ());
    }

    /**
     * Validate an equality pattern:
     *
     *     value == mtch
     *     value in range
     *     value == x | y | z
     *
     * Steps:
     *   1. If pattern is `a | b`:
     *        - recursively validate both sides
     *        - combine with OR
     *
     *   2. If pattern is `_`:
     *        - always succeeds (TRUE)
     *
     *   3. Otherwise:
     *        - validate mtch as a value
     *        - if mtch is a range and value is int => use range.contains
     *        - else => strong equality test (value == mtch)
     *        - reduce via constant-expression interpreter
     *
     * @params:
     *   - context: validation context
     *   - value:   value being matched
     *   - mtch:    pattern expression
     *
     * @returns:
     *   Boolean test expression.
     *
     * @throws:
     *   ErrorMsg if equality comparison is invalid.
     */
    fn validateEqualPattern (dmut context: &ValidationContext,
                             value: &Value,
                             mtch: &Expression)-> &Value
        throws ErrorMsg
    {
        // e.g. /x | y | 12/, means either x or y or 12
        if let b: &BinaryExpr = mtch && b.op == BinaryOperators::PIPE {            
            let left = MatchValidation::validateEqualPattern (alias context, value, b.left);
            let right = MatchValidation::validateEqualPattern (alias context, value, b.right);

            return copy LogicalBoolOperatorValue (mtch.loc, BinaryOperators::DPIPE, left, right);            
        }

        // ignoring value when encoutering the var reference expr /_/
        if let t: &VarExpr = mtch && t.name.str == Keys::UNDER {
            return TRUE_BOOL_VALUE;        
        }

        // otherwise making a strong equality test (value == mtch), where mtch is constructed inside the test
        let eqVal = ValueValidation::validate (alias context, mtch); 
        if (eqVal.type of RangeType && value.type of IntType) { // 12 in (0 .. 87)
            return RangeBinOpValidation::validateContains (alias context, mtch.loc, range-> eqVal, value);
        }

        let mut finTest = BinaryValidation::validateComparison (alias context, mtch.loc, BinaryOperators::DEQUAL, value, eqVal);
        finTest = context.cteInterpret:.reduce (finTest);

        return finTest;
    }

}
