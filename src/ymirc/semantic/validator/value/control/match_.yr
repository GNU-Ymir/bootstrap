in match_;

use ymirc::syntax::expression::control;
use ymirc::semantic::validator;
use ymirc::semantic::generator::{value, value::variable, type};

use ymirc::errors::message;

pub record MatchResult {
    pub {
        let value: &Value; // the value passed to the matcher
        let test: &Value; // the runtime test to check wether the pattern works
        let vars: [([c8], &Value)]; // the list of variables to create        
    }

    pub self (value: &Value, test: &Value, vars: [([c8], &Value)])
        with value = value
        , test = test
        , vars = vars
    {}
}

pub mod MatcherValidation {

    pub fn validate (dmut context: &ValidationContext, la: &MatcherExpr)-> &Value
        throws ErrorMsg
    {        
        context;
        la;
        panic;
    }

    pub fn validateMatcher (dmut context: &ValidationContext, value: &Expression, pattern: &Expression, canBeLazy: bool = false)-> (MatchResult, (&ErrorMsg)?) {           
        context;
        la;
        panic;
    }

    /*
     *    - .0: the actual test with var decls
     *    - .1: the tautology test
     *    - .2: the guard test
     */
    pub fn validateGuard (dmut context: &ValidationContext, vars: [([c8], &Value)], guard: &Expression, currentCond: &Value)-> (&Value, &Value, &Value)
        throws ErrorMsg
    {
    }

    
    pub fn validateCatch (dmut context: &ValidationContext, ca: &MatcherExpr, type: &Type, vref: &VarRefValue, throwers: [Thrower])-> (&Value, &Type)
        throws ErrorMsg
    {
        context;
        ca;
        type;
        vref;
        throwers;
        panic;
    }
    
}
