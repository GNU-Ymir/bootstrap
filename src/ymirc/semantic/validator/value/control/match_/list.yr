 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in list;

use ymirc::lexing::{word, tokens, keys};

use ymirc::syntax::expression::_;
use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::errors::message;
use ymirc::utils::format;

use ymirc::semantic::validator::value::control::match_::_;


/**
 * MatchListValidation module
 *
 * Provides validation for list/tuple patterns used in match expressions. A list
 * pattern is a sequence of sub-patterns, optionally ending with a variadic
 * element:
 *
 *     (p1, p2, ..., pn)
 *     (p1, p2, rest...)
 *     [p1, p2, ..., pn]
 *     [p1, p2, rest...]
 *
 * Semantics:
 *   - Tuple patterns operate on tuple values and use tuple expansion.
 *   - Array patterns operate on arrays, slices, or objects exposing `len`
 *     and index access.
 *   - Non-variadic patterns require exact arity.
 *   - Variadic patterns allow the last element to absorb remaining values.
 *   - Each element pattern is validated independently.
 *   - All element tests are combined with logical AND.
 *   - Memory information from each element is merged.
 *
 */
pub mod MatchListValidation {

    /**
     * Dispatch entry point for list/tuple pattern validation.
     *
     * Selects the appropriate validation strategy depending on whether the
     * pattern is a tuple pattern or an array pattern.
     *
     * @params:
     *   - context: validation context for type/memory checking
     *   - value:   the value being matched
     *   - tu:      the list/tuple pattern expression
     *   - memInfo: memory information inherited from the parent pattern
     *   - vars:    list of variable declarations introduced by the pattern
     *
     * @returns:
     *   (testExpression, memoryInfo)
     *
     * @throws:
     *   ErrorMsg if validation fails.
     */
    pub fn validate (dmut context: &ValidationContext,
                     value:        &Value,
                     tu:           &MatchListFilterExpr,
                     memInfo:      MemoryInfo,
                     ref mut vars: [&VarDeclValue])-> (&Value, MemoryInfo)
        throws ErrorMsg
    {
        if tu.isTuple {
            return MatchListValidation::validateTuple (alias context, value, tu, memInfo, ref vars);
        }

        return MatchListValidation::validateArray (alias context, value, tu, memInfo, ref vars);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          TUPLE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Validate a tuple pattern:
     *
     *     (p1, p2, ..., pn)
     *     (p1, p2, rest...)
     *
     * @params:
     *   - context: validation context
     *   - value:   tuple value being matched
     *   - tu:      tuple-pattern expression
     *   - memInfo: inherited memory information
     *   - vars:    variable declarations introduced by the pattern
     *
     * @returns:
     *   (testExpression, memoryInfo)
     *
     * @throws:
     *   ErrorMsg if arity is invalid or any element pattern fails.
     */
    fn validateTuple (dmut context: &ValidationContext,
                      value:        &Value,
                      tu:           &MatchListFilterExpr,
                      memInfo:      MemoryInfo,
                      ref mut vars: [&VarDeclValue])-> (&Value, MemoryInfo)
        throws ErrorMsg
    {
        // transform the tuple into a list of values so the rest of the validation gets easier
        let values = MatchCreation::createTupleExpansion (tu.loc, tu, value);

        // (x, z...) = (1,) is ok,
        // i.e. x <- 1,
        //      z <- (),
        //      
        // but (x, z...) = () is not there is nothing for x
        // 
        if (tu.isVariadic && tu.params.len - 1us > values.len) { 
            throw copy ErrorMsg::fatal (tu.loc,
                                        format (ValidateErrorMessage::TUPLE_ARITY_OVERFLOW, tu.params.len, values.len));
        }

        // (x,) = (1,2) or (x, y) = (1,) are not ok
        if (!tu.isVariadic && tu.params.len != values.len) {
            throw copy ErrorMsg::fatal (tu.loc,
                                        format (ValidateErrorMessage::TUPLE_ARITY_OVERFLOW, tu.params.len, values.len));
        }

        // pattern match inner values
        let mut curValueTest: &Value = TRUE_BOOL_VALUE;
        let mut innerRetInfo = MemoryInfo ();
        
        for i, pattern in tu.params {            
            let (innerTest, innerMemInfo) = MatchListValidation::validateOneTuple (alias context,
                                                                                   values,
                                                                                   value.type,
                                                                                   tu,
                                                                                   i,
                                                                                   pattern, 
                                                                                   memInfo,
                                                                                   ref vars);            

            curValueTest = copy LogicalBoolOperatorValue (value.loc, BinaryOperators::DAND, curValueTest, innerTest);
            innerRetInfo = innerRetInfo | innerMemInfo;            
        }

        return (curValueTest, innerRetInfo);
    }

    /**
     * Validate a single element of a tuple pattern.
     *
     * @params:
     *   - context: validation context
     *   - values:  expanded tuple element values
     *   - type:    type of the original tuple value
     *   - tu:      tuple-pattern expression
     *   - i:       index of the current pattern element
     *   - pattern: sub-pattern to validate
     *   - memInfo: inherited memory information
     *   - vars:    variable declarations introduced by the pattern
     *
     * @returns:
     *   (testExpression, memoryInfo)
     *
     * @throws:
     *   ErrorMsg with an added field-position note.
     */
    fn validateOneTuple (dmut context: &ValidationContext,                    
                         values:        [&Value],
                         type:          &Type,
                         tu:            &MatchListFilterExpr,
                         i:             usize,
                         pattern:       &Expression,      
                         memInfo:       MemoryInfo,
                         ref mut vars: [&VarDeclValue])-> (&Value, MemoryInfo)
        throws ErrorMsg
    {
        let mut assocValue: &Value = UNIT_VALUE;
        let mut currField = ""; // currField is used for clearer errors
        
        // one value by one value
        if (i != tu.params.len - 1us || !tu.isVariadic) {
            assocValue = values [i];
            currField = format ("%", i);             
        }

        // e.g. (x, y...) = (1, 2, 3), y <- (2, 3)
        else { 
            let rest = values [i .. $];
            let mut tupleTypes: [&Type] = [];
            for j in i .. values.len { // create a tuple type to get all last values
                tupleTypes ~= [values [j].type];
                
                if (values [j].type.isMovable) {
                    let note = copy ErrorMsg::note (values [j].loc,
                                                    format (ValidateErrorMessage::CONTAIN_MOVABLE_TYPE_NOTE),
                                                    oneLine-> true);
                    
                    throw copy ErrorMsg::fatal (values [j].loc,
                                                end-> values [j].type.loc,
                                                format (ValidateErrorMessage::CONTAIN_MOVABLE_TYPE, values [j].type),
                                                notes-> copy [note]);
                }
            }

            let tupleType = copy TupleType (pattern.loc, tupleTypes, isMutable-> type.isMutable);

            // declare a tuple literal containing the values
            assocValue = copy TupleValue (pattern.loc, tupleType, rest);
            currField = format ("%..%", i, values.len);
        }

        {
            return MatchValidation::validatePattern (alias context, assocValue, pattern, memInfo, ref vars);
        } catch {
            err : &ErrorMsg => { // add a note to the error so its easier to get the value responsible for the error
                let note = copy ErrorMsg::note (tu.loc,
                                                format (ValidateErrorMessage::FOR_PATTERN_FIELD, currField, type));
                
                throw err.withNote (copy [note]);
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          ARRAY          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Validate an array/slice pattern:
     *
     *     [p1, p2, ..., pn]
     *     [p1, p2, rest...]
     *     
     * @params:
     *   - context: validation context
     *   - value:   array/slice/object being matched
     *   - arr:     array-pattern expression
     *   - memInfo: inherited memory information
     *   - vars:    variable declarations introduced by the pattern
     *
     * @returns:
     *   (testExpression, memoryInfo)
     *
     * @throws:
     *   ErrorMsg if arity is invalid or any element pattern fails.
     */
    fn validateArray (dmut context: &ValidationContext,
                      value:        &Value,
                      arr:          &MatchListFilterExpr,
                      memInfo:      MemoryInfo,
                      ref mut vars: [&VarDeclValue])-> (&Value, MemoryInfo)
        throws ErrorMsg
    {
        // Retreive the len, it may come from an array or a slice, or even an
        // object overriding `len`, so we use the appropriate visitor
        // 
        let len = { 
            FieldValidation::validate (alias context, arr.loc, value, SliceKeys::LEN) 
        } catch {
            err : &ErrorMsg => { 
                throw err.withNote (copy [copy ErrorMsg::note (arr.loc, ValidateErrorMessage::HERE)]);
            }
        }

        let mut lenTest: &Value = TRUE_BOOL_VALUE;
        let mut nbParams: &Value = UNIT_VALUE;
        
        // if it is variadic, then the value should contain at least N - 1
        // elements: 
        //   - [x, y...] = [1] is ok,
        //           -> with N = 2,
        //           
        //   - [y...] = [] is ok
        //           -> with N = 1
        // 
        if (arr.isVariadic) {
            nbParams = copy IntValue (arr.loc, USIZE_TYPE, arr.params.len - 1us); 
            lenTest = copy CmpIntOperatorValue (arr.loc, BinaryOperators::SUP_EQUAL, len, nbParams);
        }

        // not variadic, thus the value has to contain the same number of
        // elements as in the pattern (e.g. [x, y] = [1, 2] is ok, but not [x, y] = [1])
        // 
        else {            
            nbParams = copy IntValue (arr.loc, USIZE_TYPE, arr.params.len); 
            lenTest = copy CmpIntOperatorValue (arr.loc, BinaryOperators::DEQUAL, len, nbParams);
        };

        lenTest = context.cteInterpret:.reduce (lenTest);

        // if the len test is CTE we can send an error if it is not valid (e.g. for array values)
        if let b: &BoolValue = lenTest && !b.isTrue { 
            throw copy ErrorMsg::fatal (arr.loc, format (ValidateErrorMessage::ARRAY_PATTERN_SIZE, nbParams, len));        
        }
        
        let mut curValueTest: &Value = TRUE_BOOL_VALUE;
        let mut innerRetInfo = MemoryInfo ();
        for i, pattern in arr.params {
            let (innerTest, innerMemInfo) = MatchListValidation::validateOneArray (alias context,
                                                                                   value,
                                                                                   arr,
                                                                                   len,
                                                                                   i,
                                                                                   pattern,
                                                                                   memInfo,
                                                                                   ref vars);
            

            curValueTest = copy LogicalBoolOperatorValue (arr.loc, BinaryOperators::DAND, curValueTest, innerTest);
            innerRetInfo = innerRetInfo | innerMemInfo;
        }

        let mut finTest: &Value = copy LogicalBoolOperatorValue (arr.loc, BinaryOperators::DAND, lenTest, curValueTest);
        finTest = context.cteInterpret:.reduce (finTest);
        
        return (finTest, innerRetInfo);
    }

    /**
     * Validate a single element of an array/slice pattern.
     *
     * @params:
     *   - context: validation context
     *   - value:   array/slice/object being matched
     *   - arr:     array-pattern expression
     *   - len:     length of the array/slice
     *   - i:       index of the current pattern element
     *   - pattern: sub-pattern to validate
     *   - memInfo: inherited memory information
     *   - vars:    variable declarations introduced by the pattern
     *
     * @returns:
     *   (testExpression, memoryInfo)
     *
     * @throws:
     *   ErrorMsg with an added field-position note.
     */
    fn validateOneArray (dmut context: &ValidationContext,                    
                         value:        &Value,                         
                         arr:          &MatchListFilterExpr,
                         len:          &Value,
                         i:            usize,
                         pattern:      &Expression,      
                         memInfo:      MemoryInfo,
                         ref mut vars: [&VarDeclValue])-> (&Value, MemoryInfo)
        throws ErrorMsg 
    {            
        // currField is used for clearer errors
        let mut assocValue: &Value = UNIT_VALUE;
        let mut currField = "";

        // entering unsafe context to avoid slice of array len checking that would be useless
        context:.enterUnsafeContext (arr.loc);
        
        {                          
            if (i != arr.params.len - 1us || !arr.isVariadic) {
                let index = copy IntValue (arr.loc, USIZE_TYPE, i);
                assocValue = IndexValidation::validate (alias context, arr.loc, value, index);
                currField = format ("%", i);
            }            

            // variadic, we access the rest of the elements in the value
            else { 
                let index = copy IntValue (arr.loc, USIZE_TYPE, i);
                let rng = copy RangeValue (arr.loc, copy RangeType (arr.loc, USIZE_TYPE, false), index, len);
                assocValue = IndexValidation::validate (alias context, arr.loc, value, rng); 
                currField = format ("%..$", i);
            }
            
        } exit {
            context:.exitUnsafeContext ()?;
        };

        {
            return MatchValidation::validatePattern (alias context, assocValue, pattern, memInfo, ref vars);
        } catch {
            err : &ErrorMsg => { // note the error for clearer errors
                let note = copy ErrorMsg::note (arr.loc,
                                                format (ValidateErrorMessage::FOR_PATTERN_FIELD, currField, value.type));
                
                throw err.withNote (copy [note]);
            }
        }
    }
}
