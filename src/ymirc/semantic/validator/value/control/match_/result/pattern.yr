/*
 * Defines the result container for pattern-validation operations in Ymir.
 *
 * PatternResult is produced by MatchValidation::validatePattern and represents
 * the outcome of validating a single pattern against a value.
 *
 * Responsibilities:
 *   - store the validated value(possibly transformed)
 *   - store the boolean test expression for pattern success
 *   - collect variable declarations introduced by the pattern
 *   - store an error when pattern validation fails
 *
 * PatternResult is used by:
 *   - match line validation
 *   - guard validation
 *   - catch pattern validation
 *   - nested pattern validation(var-decl, call, option, list)
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::value::control::match_::result::pattern
 * @File: ymirc/semantic/validator/value/control/match_/result/pattern.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-04-07
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in pattern;

pub mod ::vardecl;
pub mod ::call;

use ymirc::semantic::generator::{value::_, type};
use ymirc::errors::message;

pub record PatternResult {

    pub {
        // the value passed to the matcher
        let mut value: &Value = UNIT_VALUE;

        // The boolean test expression that determines whether the pattern succeeds.
        // This may include type tests, field tests, guard tests, etc.
        let mut test: &Value = UNIT_VALUE;

        // Variables introduced by the pattern(e.g., x in `x: T`, or fields in call patterns).
        // These are inserted into the match-line scope if the pattern succeeds.
        let mut vars: [&VarDeclValue] = [];

        // Error produced during pattern validation, if any.
        // When set, error variables are inserted into `vars` to avoid undefined symbols.
        let mut error: (&ErrorMsg)? = none;
    }

    /**
     * Construct an empty PatternResult.
     *
     * All fields are initialized to:
     *   • value = UNIT_VALUE
     *   • test  = UNIT_VALUE
     *   • vars  = []
     *   • error = none
     *
     * This constructor is used as the starting point for pattern validation.
     */
    pub self () {}

}
