 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in match_;

use ymirc::semantic::generator::{value::_, type::_};
use ymirc::errors::message;

use ymirc::semantic::validator::value::control::match_::_;

/**
 * MatchResult
 *
 * Represents the accumulated result of validating all match lines in a
 * match expression.
 *
 * MatchResult is used by MatchValidation::validate to construct the
 * final nested conditional expression.
 * 
 */
pub record MatchResult {
    pub {
        
        // list of boolean test expressions for each match line
        let mut tests:      [&Value]    = [];

        // list of branch values for each match line
        let mut values:     [&Value]    = [];

        // list of errors encountered during validation
        let mut errors:     [&ErrorMsg] = [];

        // resulting type of the match expression
        let mut type:       &Type       = NONE_TYPE;

        // whether the match is complete (all cases covered)
        let mut isComplete: bool        = false;

        // merged memory information from all match lines
        let mut memInfo:    MemoryInfo  = MemoryInfo ();
    }

    pub self () {}
}

/**
 * MatchLineResult
 *
 * Represents the result of validating a single match line:
 *   pattern => guard => branch value
 *
 * MatchLineResult is used by MatchValidation::validateMatchers to
 * accumulate match-line results and detect completeness.
 */
pub record MatchLineResult {
    pub  {
        // variables introduced by the pattern
        let mut vars: [&VarDeclValue];

        // boolean test expression for the line
        let mut test: &Value;

        // memory information produced by the pattern
        let mut memInfo: MemoryInfo;        

        // GuardResult for the guard expression
        let mut guard: GuardResult;

        // value produced by the branch
        let mut blockValue: &Value;

        // type of the branch
        let mut blockType: &Type;
    }
    
    pub self (vars: [&VarDeclValue],
              test: &Value,
              memInfo: MemoryInfo,
              guard: GuardResult,
              blockValue: &Value,
              blockType: &Type)
        
        with vars = vars
        , test = test
        , memInfo = memInfo
        , guard = guard
        , blockValue = blockValue
        , blockType = blockType
    {}
    
}
