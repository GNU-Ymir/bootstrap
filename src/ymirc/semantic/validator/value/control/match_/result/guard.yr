/*
 * Defines the result container for guard-validation in Ymir’s pattern
 * matching system.
 *
 * A guard is an additional boolean condition attached to a pattern:
 *
 *     case x if x > 0 => ...
 *
 * GuardResult stores:
 *   - the full test expression(pattern test AND guard test)
 *   - the tautology test(whether the guard is always true)
 *   - the raw guard expression
 *
 * This structure is used by MatchValidation to:
 *   - integrate guard logic into match-line tests
 *   - detect unreachable patterns(tautological guards)
 *   - propagate guard expressions into conditional construction
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::value::control::match_::result::guard
 * @File: ymirc/semantic/validator/value/control/match_/result/guard.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-04-07
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in guard;

use ymirc::semantic::generator::{value::_, type};
use ymirc::errors;

/**
 * GuardResult record
 *
 */
pub record GuardResult {
    pub {
        // full boolean test including pattern variables
        let mut test: &Value;

        // boolean expression indicating whether the guard is compile-time true
        // (pattern becomes irrefutable)
        //
        let mut tautology: &Value;

        // the raw guard expression validated as a boolean
        let mut guard: &Value;
    }

    /**
     * Construct a GuardResult with explicit values.
     *
     * @params:
     *   - test:      full test expression(patternTest AND guardTest)
     *   - tautology: compile-time tautology test for the guard
     *   - guard:     raw guard expression
     *
     * @returns:
     *   A GuardResult containing the provided values.
     */
    pub self (test: &Value, tautology: &Value, guard: &Value)
        with test = test
        , tautology = tautology
        , guard = guard
    {}
}
