/*
 * Defines the result container for validating variable-declaration patterns in
 * Ymir’s pattern-matching system.
 *
 * A var-decl pattern has the form:
 *
 *     x: T
 *     x: T = pattern
 *
 * and is responsible for:
 *   - testing whether the matched value is of type T
 *   - binding the value to a variable
 *   - optionally validating a nested pattern on the casted value
 *   - propagating memory semantics(move/alias/ref/lazy)
 *
 * VarDeclPatternResult stores all information needed by MatchVarDeclValidation,
 * MatchValidation, and CatchValidation.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::value::control::match_::result::pattern::vardecl
 * @File: ymirc/semantic/validator/value/control/match_/result/pattern/vardecl.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-04-07
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in vardecl;

use ymirc::semantic::generator::{value::_, type::_};
use ymirc::errors::message;

use ymirc::semantic::validator::value::control::match_::info;

/**
 * VarDeclPatternResult record
 *
 *
 * The final pattern test is typically:
 *
 *     typeTest AND nestedPatternTest
 *
 * where nestedPatternTest is produced by validating the initializer pattern.
 *
 */
pub record VarDeclPatternResult {
    pub {

        // Boolean test verifying that the matched value is of the declared type.
        // This is the primary condition for the pattern to succeed.
        let mut typeTest: &Value ;

        // The declared type of the variable(e.g., T in `x: T`).
        let mut type: &Type;

        // The original matched value before casting.
        let mut value: &Value;

        // The matched value cast to the declared type.
        let mut castValue: &Value;

        // Memory semantics produced by the pattern(move/alias/ref/lazy).
        let mut memInfo: MemoryInfo;
    }

    pub self (typeTest:   &Value,
              type:      &Type,
              value:     &Value,
              castValue: &Value,
              memInfo:   MemoryInfo)
        with typeTest = typeTest
        , type = type
        , value = value
        , castValue = castValue
        , memInfo = memInfo
    {}

}
