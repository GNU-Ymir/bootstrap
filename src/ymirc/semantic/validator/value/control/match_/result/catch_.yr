/*
 * Defines result containers used during catch-pattern validation.
 *
 * CatchResult accumulates the global state of validating all catch lines:
 *   - test expressions for each catch branch
 *   - resulting values for each branch
 *   - errors encountered during validation
 *   - which thrown types have been caught
 *   - which thrown types remain uncaught
 *   - the resulting type of the catch block
 *
 * CatchLineResult stores the outcome of validating a single catch line:
 *   - variables introduced by the pattern
 *   - the test expression for the line
 *   - memory information
 *   - whether the pattern contains sub-tests
 *   - the type caught by the pattern
 *   - the guard result
 *   - the resulting value and type of the branch
 *
 * These records are used by CatchValidation to build the final catch
 * expression and ensure all thrown types are handled.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::value::control::match_::result::catch_
 * @File: ymirc/semantic/validator/value/control/match_/result/catch_.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-04-07
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in catch_;

use ymirc::semantic::generator::{value::_, type::_};
use ymirc::errors;

use ymirc::semantic::validator::value::control::match_::_;

/**
 * CatchResult
 *
 * Represents the accumulated result of validating all catch patterns in
 * a catch block.
 *
 * The catch block is complete when `rests` becomes empty.
 *
 */
pub record CatchResult {
    pub {
        // list of test expressions for each catch line
        let mut tests:  [&Value]    = [];

        // list of branch values for each catch line
        let mut values: [&Value]    = [];

        // list of errors encountered during validation
        let mut errors: [&ErrorMsg] = [];

        // list of Thrower entries that have been caught
        let mut used:   [Thrower]   = [];

        // resulting type of the catch block
        let mut type:   &Type;

        // list of Thrower entries that remain uncaught
        let mut rests:  [Thrower];
    }

    /**
     * Construct a CatchResult with:
     *   - type  = baseType(type of the try block)
     *   - rests = throwers(all thrown types initially uncaught)
     *
     * @params:
     *   - baseType: resulting type of the try block
     *   - throwers: list of all possible thrown types
     *
     */
    pub self (baseType: &Type, throwers: [Thrower])
        with type = baseType
        , rests = throwers
    {}

}

/**
 * CatchLineResult
 *
 * Represents the result of validating a single catch line.
 *
 * This structure is used by CatchValidation::validateMatchers to
 * accumulate catch-line results and detect completeness.
 *
 */
pub record CatchLineResult {
    pub  {
        // variables introduced by the pattern
        let mut vars: [&VarDeclValue];

        // boolean test expression for the pattern
        let mut test: &Value;

        // whether the pattern contains additional tests(other than caught type test)
        // In which case the test is not really caught, since it can fail under subtests
        let mut hasSubTests: bool;

        // the type caught by this pattern
        let mut type: &Type;

        // GuardResult for the catch guard
        let mut guard: GuardResult;

        // value produced by the catch branch
        let mut blockValue: &Value;

        // type of the catch branch
        let mut blockType: &Type;
    }

    pub self (vars: [&VarDeclValue],
              test: &Value,
              hasSubTests: bool,
              type: &Type,
              guard: GuardResult,
              blockValue: &Value,
              blockType: &Type)
        with vars = vars
        , test = test
        , memInfo = memInfo
        , hasSubTests = hasSubTests
        , type = type
        , guard = guard
        , blockValue = blockValue
        , blockType = blockType
    {}
}
