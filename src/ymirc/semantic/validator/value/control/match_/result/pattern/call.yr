
/*
 * Defines the result container for validating call-operator patterns in
 * Ymir’s pattern-matching system.
 *
 * A call-operator pattern has the form:
 *
 *     SomeType(field-> x, field2-> y)
 *
 * and is used to destructure values by invoking a pattern-specific
 * matcher. CallOpPatternResult stores:
 *
 *   - the overall test expression for the pattern
 *   - the field-test expression(tests on extracted fields)
 *   - the resulting type matched by the call pattern
 *   - memory semantics produced by the pattern
 *
 * This structure is used by MatchCallValidation and CatchValidation.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::value::control::match_::result::pattern::call
 * @File: ymirc/semantic/validator/value/control/match_/result/pattern/call.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-04-07
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in call;

use ymirc::semantic::generator::{value::_, type::_};
use ymirc::errors;

use ymirc::semantic::validator::value::control::match_::info;

/**
 * CallOpPatternResult record
 *
 * The `fieldTest` is kept separate so CatchValidation can detect whether the
 * pattern contains additional tests beyond type matching.
 *
 */
pub record CallOpPatternResult {
    pub {

        // The full boolean test expression for the call pattern.
        // This includes type tests, field tests, and sub-pattern tests.
        let mut test: &Value;

        // The test expression applied specifically to extracted fields.
        // Used to detect whether the pattern contains sub-tests.
        let mut fieldTest: &Value;

        // The resulting type matched by the call pattern.
        // This is the type extracted from the call operator.
        let mut type: &Type;

        // Memory semantics produced by the pattern(move/alias/ref/lazy).
        let mut memInfo: MemoryInfo;
    }

    pub self (test:      &Value,
              fieldTest: &Value,
              type:      &Type,
              memInfo:   MemoryInfo)
        with test = test
        , fieldTest = fieldTest
        , type = type
        , memInfo = memInfo
    {}
}
