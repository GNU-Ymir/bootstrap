/*
 * Defines memory-semantics flags used throughout Ymir’s pattern-matching
 * and value-validation pipeline.
 *
 * MemoryInfo encodes how a value is being consumed or propagated:
 *   - by alias
 *   - by mutable reference
 *   - by lazy access
 *   - by move
 *
 * These flags are combined using bitwise OR and carried through pattern
 * validation, match lines, call-patterns, var-decl patterns, and catch
 * patterns.
 *
 * The MemoryInfo record provides:
 *   - constructors for each memory mode
 *   - bitwise OR operations for merging memory states
 *   - convenience accessors (isByAlias, isByMutRef, etc.)
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::semantic::validator::value::control::match_::info
 * @File: ymirc/semantic/validator/value/control/match_/info.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2026-04-07
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in info;

enum : u32
| MUT_REF = 0b0001
| ALIAS   = 0b0010
| LAZY    = 0b0100
| MOVE    = 0b1000
| NONE    = 0b0000
 -> MemoryInfoState;

/**
 * MemoryInfo
 *
 * Encapsulates memory-semantics flags for a value during pattern
 * matching, call-operator validation, var-decl validation, and catch
 * validation.
 *
 * A MemoryInfo instance stores a bitmask of MemoryInfoState flags and
 * provides:
 *   - constructors for explicit memory modes
 *   - merging via bitwise OR
 *   - accessors for each memory mode
 *
 * MemoryInfo is immutable; merging produces a new instance.
 */
pub record MemoryInfo {
    
    let _value: u32;    

    /**
     * Construct a MemoryInfo from individual memory-mode booleans.
     *
     * @params:
     *   - byAlias:   whether the value is accessed by alias
     *   - byMutRef:  whether the value is accessed by mutable reference
     *   - byLazy:    whether the value is accessed lazily
     *   - byMove:    whether the value is consumed by move
     *
     */
    pub self (byAlias:  bool = false,
              byMutRef: bool = false,
              byLazy:   bool = false,
              byMove:   bool = false)
        with _value = {
            let a = if byAlias { MemoryInfoState::ALIAS } else { MemoryInfoState::NONE };
            let m = if byMutRef { MemoryInfoState::MUT_REF } else { MemoryInfoState::NONE };
            let l = if byLazy { MemoryInfoState::LAZY } else { MemoryInfoState::NONE };
            let v = if byMove { MemoryInfoState::MOVE } else { MemoryInfoState::NONE };

            a | m | v | l
        }        
    {}

    /**
     * Construct a MemoryInfo directly from a raw bitmask.
     *
     * @params:
     *   - value: bitmask of MemoryInfoState flags
     *
     */
    self (value: u32)
        with _value = value
    {}

    /**
     * Merge two MemoryInfo instances by bitwise OR.
     *
     * Used to accumulate memory semantics across pattern branches.
     *
     * @params:
     *   - self: current MemoryInfo
     *   - o:    other MemoryInfo to merge
     *
     * @returns:
     *   A new MemoryInfo containing all flags from both operands.
     */
    pub fn opBinary {"|"} (self, o: MemoryInfo)-> MemoryInfo {
        return MemoryInfo (self._value | o._value);
    }

    /**
     * Merge a MemoryInfo instance with a single MemoryInfoState flag.
     *
     * @params:
     *   - self: current MemoryInfo
     *   - o:    memory-state flag to add
     *
     * @returns:
     *   A new MemoryInfo with the flag added.
     */
    pub fn opBinary {"|"} (self, o: MemoryInfoState)-> MemoryInfo {
        return MemoryInfo (self._value | o);
    }

    /**
     * Check whether the value is accessed lazily.
     *
     * @returns:
     *   true if the LAZY flag is set, false otherwise.
     */
    @field
    pub fn isByLazy (self)-> bool {
        return (self._value & MemoryInfoState::LAZY) != 0;
    }

    /**
     * Check whether the value is accessed by mutable reference.
     *
     * @returns:
     *   true if the MUT_REF flag is set, false otherwise.
     */
    @field
    pub fn isByMutRef (self)-> bool {
        return (self._value & MemoryInfoState::MUT_REF) != 0;
    }

    /**
     * Check whether the value is consumed by move.
     *
     * @returns:
     *   true if the MOVE flag is set, false otherwise.
     */
    @field
    pub fn isByMove (self)-> bool {
        return (self._value & MemoryInfoState::MOVE) != 0;
    }

    /**
     * Check whether the value is accessed by alias.
     *
     * @returns:
     *   true if the ALIAS flag is set, false otherwise.
     */
    @field
    pub fn isByAlias (self)-> bool {
        return (self._value & MemoryInfoState::ALIAS) != 0;
    }

}
