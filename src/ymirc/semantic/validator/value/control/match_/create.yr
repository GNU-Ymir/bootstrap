 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in create;

use ymirc::lexing::{word, keys};
use ymirc::syntax::expression::_;
use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::errors;
use ymirc::utils::format;

use ymirc::semantic::validator::value::control::match_::_;

/**
 * MatchCreation module
 *
 * Provides constructors and helper utilities used during pattern-matching
 * validation. These functions do not perform validation themselves but
 * create intermediate values required by the validator:
 *
 *   - tuple expansion for tuple patterns
 *   - conditional values for match branches
 *   - placeholder variables for error-recovery paths
 *
 * The module enforces:
 *   - correct tuple extraction
 *   - correct conditional construction
 *   - correct variable creation when patterns fail
 */
pub mod MatchCreation {

    /**
     * Expand a tuple value into a list of element values.
     *
     * Used by tuple-pattern validation to normalize tuple values into a
     * flat list, making element-wise pattern matching easier.
     *
     * @params:
     *   - loc:   location of the tuple pattern
     *   - tu:    the tuple-pattern expression
     *   - value: the value being matched; must be of TupleType
     *
     * @returns:
     *   A list of &Value, one for each tuple element.
     *
     * @throws:
     *   ErrorMsg if the matched value is not a tuple.
     */
    pub fn createTupleExpansion(loc: &Word, tu: &MatchListFilterExpr, value: &Value)-> [&Value]
        throws ErrorMsg
    {
        if let ty: &TupleType = value.type {
            return copy [TupleFieldValidation::validate(loc, value, ty, i, reduce-> false)
                         for i in 0 .. ty.inners.len];
        }

        throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::TUPLE_PATTERN, tu, value.type));
    }

    /**
     * Construct a conditional value for match branches.
     *
     * If the test is a compile-time boolean, the function returns the
     * corresponding branch directly. Otherwise, it constructs a
     * ConditionalValue node.
     *
     * @params:
     *   - loc:        location of the conditional expression
     *   - test:       boolean test expression
     *   - thenv:      value for the "true" branch
     *   - elsev:      value for the "false" branch
     *   - type:       resulting type of the conditional
     *   - isComplete: whether the match is known to be complete
     *
     * @returns:
     *   A &Value representing the conditional expression.
     *
     */
    pub fn createConditional(loc:        &Word,
                              test:       &Value,
                              thenv:        &Value,
                              elsev:      &Value,
                              type:       &Type,
                              isComplete: bool)-> &Value {

        if let b: &BoolValue = test {
            if b.isTrue {
                return thenv;
            } else {
                return elsev;
            }
        }

        return copy ConditionalValue(loc,
                                      type-> type,
                                      test-> test,
                                      thenv-> thenv,
                                      elsev-> elsev,
                                      isComplete-> isComplete);
    }

    /**
     * Create placeholder error variables for patterns that failed validation.
     *
     * When a pattern fails, the validator still needs to insert variables into
     * the scope to avoid undefined-symbol errors in later patterns. This
     * function recursively walks the pattern and inserts:
     *
     *     VarDeclValue(name, ErrorType, UNIT_VALUE)
     *
     * for each variable declaration encountered.
     *
     * @params:
     *   - context: validation context
     *   - mtch:    the pattern expression that failed
     *   - vars:    list of variable declarations to append to
     *
     * @returns:
     *   (none) — modifies `vars` in place.
     *
     * @throws:
     *   ErrorMsg if shadowing rules are violated while inserting error vars.
     */
    pub fn createErrorVariables(context: &ValidationContext, mtch: &Expression, ref mut vars: [&VarDeclValue])
        throws ErrorMsg
    {
        match mtch {
            vdecl: &VarDeclExpr => {
                if (vdecl.name.str != Keys::UNDER) {
                    VariableVerification::verifyShadow(context, vdecl.loc, name-> vdecl.name.str, isQuoted-> vdecl.isQuoted);
                    MatchVerification::verifyShadow(vdecl.loc, name-> vdecl.name.str, vars);

                    let var = copy VarDeclValue(vdecl.loc,
                                                 copy ErrorType(vdecl.loc),
                                                 UNIT_VALUE, isMutable-> false);
                    vars ~= [var];
                }

                MatchCreation::createErrorVariables(context, vdecl.value, vars-> ref vars);
            }
            cl: &MultOperatorExpr => {
                for m in cl.rights {
                    MatchCreation::createErrorVariables(context, m, vars-> ref vars);
                }
            }
            o: &MatchOptionFilterExpr => {
                MatchCreation::createErrorVariables(context, o.inner, vars-> ref vars);
            }
            l: &MatchListFilterExpr => {
                for m in l.params {
                    MatchCreation::createErrorVariables(context, m, vars-> ref vars);
                }
            }
        }
    }

}
