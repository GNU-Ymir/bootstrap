in yield_;

use ymirc::errors;
use ymirc::lexing::{keys, word};
use ymirc::semantic::generator::type::native;
use ymirc::semantic::generator::value::_;
use ymirc::syntax::expression::_;
use ymirc::utils::format;

/**
 * YieldForLoopValidation
 *
 * A loop over a generator resumes it until its body is over:
 *
 *     {
 *         let #_iter = generator;
 *         let mut #_yielded: T;
 *         while (#_iter).next(#_yielded) {
 *             let x = #_yielded;
 *             ...
 *         }
 *     }
 */
pub mod YieldForLoopValidation {

    /**
     * Validate a `for` loop iterating over a generator.
     *
     * @params:
     *   - context:   validation context
     *   - generator: the generator handle being iterated
     *   - yieldType: the type of the generator
     *   - floop:     for-loop expression
     *   - byAlias:   whether the generator is iterated by alias
     *
     * @returns:
     *   (the BlockValue of the validated loop, whether the alias was used)
     *
     * @throws:
     *   ErrorMsg if the loop does not declare exactly one variable, or if validation fails.
     */
    pub fn validate(dmut context: &ValidationContext,
                    generator:    &Value,
                    yieldType:    &YieldType,
                    floop:        &ForLoopExpr,
                    byAlias:      bool)-> (&Value, bool)
        throws ErrorMsg
    {
        let loc = floop.loc;
        let mut outerLoop: [&Value] = [];
        let mut innerLoop: [&Value] = [];
        let mut errors: (&ErrorMsg)? = none;
        let mut test: &Value = UNIT_VALUE;
        let mut usedAlias = false;

        context:.enterLoop();
        context:.setCurrentLoopType(VOID_TYPE);
        context:.enterBlock();
        {
            let (resume, used) = YieldForLoopValidation::validateLoopVar(alias context, loc, generator, yieldType, floop.vars,
                                                                         byAlias,
                                                                         ref innerLoop,
                                                                         ref outerLoop);
            test = resume;
            usedAlias = used;
            innerLoop ~= [ValueValidation::validate(alias context, floop.block)];
        } catch {
            err => {
                errors = (err)?;
            }
        }

        let blk = copy BlockValue(loc, VOID_TYPE, innerLoop);
        outerLoop ~= [copy LoopValue(loc, VOID_TYPE, test, blk)];

        {
            context:.quitLoop();
            context:.quitBlock(warnUnused-> (!errors.hasValue));
        } catch {
            err => {
                errors = (err)?;
            }
        }

        if let Ok(err) = errors {
            throw err;
        }

        return (copy BlockValue(loc, VOID_TYPE, outerLoop), usedAlias);
    }

    /**
     * Declare the generator and the yielded value, and the loop variables reading the latter,
     * one per field when several variables destructure a yielded tuple.
     *
     * @params:
     *   - context:   validation context
     *   - loc:       loop location
     *   - generator: the generator handle being iterated
     *   - yieldType: the type of the generator
     *   - vars:      user iterator variable declarations
     *   - byAlias:   whether the yielded value is aliased into the loop variable
     *   - innerLoop: list to append inner loop values
     *   - outerLoop: list to append outer loop values
     *
     * @returns: (the test resuming the generator, whether the alias was used)
     */
    pub fn validateLoopVar(dmut context:      &ValidationContext,
                           loc:               &Word,
                           generator:         &Value,
                           yieldType:         &YieldType,
                           vars:              [&VarDeclExpr],
                           byAlias:           bool,
                           ref mut innerLoop: [&Value],
                           ref mut outerLoop: [&Value])-> (&Value, bool)
        throws ErrorMsg
    {
        let fields = match yieldType.retType {
            t: &TupleType if vars.len == t.inners.len => { t.inners }
            _ => {
                if vars.len != 1us {
                    throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::UNDEF_FOR_LOOP_OPERATOR, vars.len, yieldType));
                }
                []
            }
        };

        let genType = copy YieldType(generator.loc, yieldType.retType, isMutable-> false);
        let genDecl = copy VarDeclValue(generator.loc.locate(ForLoopKeys::ITER), genType, generator, isMutable-> false);
        let valueDecl = copy VarDeclValue(loc.locate(ForLoopKeys::YIELDED), yieldType.retType.clone(1), UNIT_VALUE,
                                          isMutable-> true);

        let genRef = VariableCreation::createVarFromDecl(genDecl, canCte-> false);
        let valueRef = VariableCreation::createVarFromDecl(valueDecl, canCte-> false);

        outerLoop ~= [genDecl, valueDecl];

        let current = copy VarRefValue(valueRef.loc, valueDecl.loc, yieldType.retType, valueDecl.uniqId,
                                       isSelf-> false,
                                       canCte-> false);

        let values: [&Value] = if vars.len == 1us {
            copy [current]
        } else {
            copy [copy TupleFieldAccessValue(vars[i].loc, field, current, i) for i, field in fields]
        };

        let mut usedAlias = false;
        for i, vdecl in vars {
            let (iter, insert) = ClassForLoopValidation::validateIterValidateVDecl(alias context, vdecl, values[i], byAlias-> byAlias);
            if insert {
                context:.insertLocal(iter.loc, iter.name, iter);
            }

            innerLoop ~= [iter];
            usedAlias = usedAlias || iter.value of AliaserValue;
        }

        return (copy YieldNextValue(loc, genRef, valueRef), usedAlias);
    }
}
