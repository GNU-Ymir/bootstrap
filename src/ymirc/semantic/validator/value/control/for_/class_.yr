/*
 * Implements semantic validation for class-based `for` loops in Ymir.
 *
 * Responsibilities:
 *   - Validate iteration over class pointer types using operator overrides.
 *   - Resolve and validate BEGIN, END, NEXT, and GET_ITER operator methods.
 *   - Construct iterator and end sentinel values.
 *   - Validate iterator variable declarations for multi-variable loops.
 *   - Apply aliasing rules for class iteration.
 *   - Build loop test, increment, and body blocks.
 *   - Manage loop and block scopes, including error aggregation.
 *
 * This module is invoked when the left operand of a `for` loop is a class pointer.   
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::semantic::validator::value::control::for_::class_
 * @File: ymirc/semantic/validator/value/control/for_/class_.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2026-05-14
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in class_;

use ymirc::lexing::{word, keys};

use ymirc::syntax::expression::_;
use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::global::_;
use ymirc::errors::message;

use ymirc::utils::format;


/**
 * ClassForLoopValidation
 *
 * Provides semantic validation for `for` loops iterating over class pointers.
 *
 * Class iteration is defined entirely through operator overrides:
 *
 *   - BEGIN      → produces the iterator object
 *   - END        → produces the end sentinel
 *   - NEXT       → advances the iterator
 *   - GET_ITER   → extracts iteration values (supports multi-variable loops)
 *
 */
pub mod ClassForLoopValidation {

    /**
     * Validate a `for` loop iterating over a class pointer.
     *          
     * @params:
     *   - context:   validation context
     *   - object:    class pointer value being iterated
     *   - cptr:      class pointer type
     *   - floop:     for-loop expression
     *   - byAlias:   whether iteration uses aliasing
     *   - aliasLoc:  location of the alias operator (if any)
     *
     * @returns:
     *   A BlockValue representing the validated loop.
     *
     * @throws:
     *   ErrorMsg if BEGIN/END/NEXT/GET_ITER methods are invalid or missing.
     */
    pub fn validate (dmut context: &ValidationContext,
                     object:       &Value,
                     cptr:         &ClassPtrType,
                     floop:        &ForLoopExpr,                     
                     byAlias:      bool,
                     aliasLoc:     &Word)-> &Value
        throws ErrorMsg
    {
        let loc = floop.loc;
        let (beginMeth, endMeth) = ClassForLoopValidation::validateBegEndMethods (alias context, loc, object, cptr, byAlias, aliasLoc);

        let mut outerLoop: [&Value] = [];
        let mut innerLoop: [&Value] = [];
        let mut errors: (&ErrorMsg)? = none;
        let mut test: &Value = UNIT_VALUE;
        
        context:.enterLoop ();
        context:.setCurrentLoopType (VOID_TYPE);
        context:.enterBlock ();
        {
            let (test_, increment) = ClassForLoopValidation::validateLoopVar (alias context, loc, cptr, beginMeth, endMeth, floop.vars,
                                                                              ref innerLoop,
                                                                              ref outerLoop);
            innerLoop ~= [ValueValidation::validate (alias context, floop.block)];
            innerLoop ~= [increment];
            test = test_;
        } catch {
            err => {
                errors = (err)?;
            }
        }

        let blk = copy BlockValue (loc, VOID_TYPE, innerLoop);        
        outerLoop ~= [copy LoopValue (loc, VOID_TYPE, test, blk)];
        
        {
            context:.quitLoop ();
            context:.quitBlock (warnUnused-> (!errors.hasValue));
        } catch {
            err => {
                errors = (err)?;
            }
        }

        if let Ok (err) = errors {
            throw err;
        }
        
        return copy BlockValue (loc, VOID_TYPE, outerLoop);
    }

    /**
     * Resolve and validate BEGIN and END operator methods for class iteration.
     *
     * @params:
     *   - context:   validation context
     *   - loc:       loop location
     *   - object:    class pointer value
     *   - cptr:      class pointer type
     *   - byAlias:   whether aliasing is used
     *   - aliasLoc:  alias operator location
     *
     * @returns:
     *   (beginValue, endValue)
     */
    fn validateBegEndMethods (dmut context: &ValidationContext,
                              loc:          &Word,
                              object:       &Value,
                              cptr:         &ClassPtrType,
                              byAlias:      bool,
                              aliasLoc:     &Word)-> (&Value, &Value)
        throws ErrorMsg
    {
        let inst = if byAlias {
            copy ClassAliaserValue (loc, cptr, object)
        } else {
            object
        };

        let (beginMeth, usedAliasBeg) = ClassForLoopValidation::validateIterOverCall (alias context, loc, inst, cptr,
                                                                                      name-> OpOverrideNames::BEGIN);
        
        let (endMeth, usedAliasEnd) = ClassForLoopValidation::validateIterOverCall (alias context, loc, inst, cptr,
                                                                                    name-> OpOverrideNames::END);

        ClassForLoopValidation::verifyUseAliasCptrIter (loc, aliasLoc, cptr, beginMeth, endMeth, (usedAliasBeg || usedAliasEnd), byAlias);
        
        return (beginMeth, endMeth);
    } catch {
        err => {
            throw copy ErrorMsg::fatal (loc, format (ValidateErrorMessage::FOR_LOOP_CPTR, cptr),
                                        notes-> copy [err]);
        }
    }

    /**
     * Resolve and validate a class operator method call (BEGIN, END).
     *
     * @params:
     *   - context: validation context
     *   - loc:     operator location
     *   - object:  class pointer value
     *   - cptr:    class pointer type
     *   - name:    operator override name (BEGIN or END)
     *
     * @returns:
     *   (methodValue, usedAlias)
     */
    fn validateIterOverCall (dmut context: &ValidationContext, loc: &Word, object: &Value, cptr: &ClassPtrType, name: [c8])-> (&Value, bool)
        throws ErrorMsg
    {
        let meth = ValueCreation::createObjectMethodAcc (alias context, loc, cptr, object, name,
                                                         allowImmut-> true);

        let cl = CallValidation::validate (alias context, loc, meth, []);
        let usedAlias = if let c: &MethodCallValue = cl {
            c.delegate.proto.isMutable
        } else {
            false
        };

        return (meth, usedAlias);
    }

    /**
     * Validate iterator and end declarations, and build loop control expressions.
     *
     * @params:
     *   - context:    validation context
     *   - loc:        loop location
     *   - cptr:       class pointer type
     *   - beginMeth:  BEGIN method result
     *   - endMeth:    END method result
     *   - vars:       user iterator variable declarations
     *   - innerLoop:  list to append inner loop values
     *   - outerLoop:  list to append outer loop values
     *
     * @returns:
     *   (testExpression, incrementExpression)
     */
    fn validateLoopVar (dmut context:      &ValidationContext,
                        loc:               &Word,                        
                        cptr:              &ClassPtrType,
                        beginMeth:         &Value,
                        endMeth:           &Value,
                        vars:              [&VarDeclExpr],
                        ref mut innerLoop: [&Value],
                        ref mut outerLoop: [&Value])-> (&Value, &Value)
        throws ErrorMsg
    {
        let iteratorDecl = copy VarDeclValue (beginMeth.loc.locate (ForLoopKeys::ITER), beginMeth.type.toDeeplyMutable (), beginMeth,
                                              isMutable-> true,
                                              isIterator-> true);
        let endDecl = copy VarDeclValue (endMeth.loc.locate (ForLoopKeys::END), endMeth.type.clone (0), endMeth,
                                         isMutable-> false,
                                         isIterator-> false);
        
        let iteratorType = ClassForLoopValidation::verifyBeginIsValid (alias context, loc, cptr, iteratorDecl, beginMeth);

        let iteratorRef = copy VarRefValue (iteratorDecl.loc, iteratorDecl.loc, iteratorType, iteratorDecl.uniqId,
                                            isSelf-> false,
                                            canCte-> false);
        let endRef = copy VarRefValue (endDecl.loc, endDecl.loc, endDecl.varType, endDecl.uniqId,
                                       isSelf-> false,
                                       canCte-> false);
        let aliasRef = copy ClassAliaserValue (iteratorDecl.loc, iteratorType, iteratorRef);

        let test = BinaryComparisonValidation::validate (alias context, loc, BinaryOperators::NOT_EQUAL, iteratorRef, endRef);
        let increment = ClassForLoopValidation::validateIncrement (alias context, loc, aliasRef, iteratorType);

        outerLoop ~= [iteratorDecl];
        outerLoop ~= [endDecl];

        let nbVars = vars.len;
        for index, v in vars {
            let (iter, insert) = ClassForLoopValidation::validateIterDecl (alias context, loc, v, aliasRef, iteratorType, index, nbVars);
            if insert {
                context:.insertLocal (iter.loc, iter.name, iter);                
            }
            
            innerLoop ~= [iter];
        }

        return (test, increment);
    }

    /**
     * Validate a single iterator variable declaration for class iteration.
     *
     * @params:
     *   - context:      validation context
     *   - loc:          loop location
     *   - vdecl:        iterator variable declaration
     *   - iterator:     iterator value
     *   - iteratorType: class pointer type of the iterator
     *   - index:        index of the iterator variable
     *   - nbVars:       total number of iterator variables
     *
     * @returns:
     *   (declValue, insert)
     */
    fn validateIterDecl (dmut context: &ValidationContext,
                         loc:          &Word,
                         vdecl:        &VarDeclExpr,
                         iterator:     &Value,
                         iteratorType: &ClassPtrType,
                         index:        usize,
                         nbVars:       usize)-> (&VarDeclValue, bool)
        throws ErrorMsg
    {
        let getVal = ClassForLoopValidation::validateIterCallGet (alias context, vdecl.name, iterator, iteratorType, index, nbVars);
        let (protoLoc, protoMsg) = if let c: &MethodCallValue = getVal {
            (c.delegate.proto.loc, format ("%", c.delegate.proto, tags-> FormatTags (withParams-> true)))
        } else {
            (loc, format ("%", getVal))
        };

        
        {
            return ClassForLoopValidation::validateIterValidateVDecl (alias context, vdecl, getVal);
        } catch {
            err : &ErrorMsg => {
                let note = copy ErrorMsg::note (loc, format (ValidateErrorMessage::CALL_GET_OP_ONE_LINE, vdecl.name.str, iterator, index, nbVars),
                                                oneLine-> true);
                
                let protoNote = copy ErrorMsg::note (protoLoc, format (ValidateErrorMessage::CALL_PROTO, protoMsg));
                throw copy ErrorMsg::fatal (vdecl.loc, format (ValidateErrorMessage::USE_GET_OP_ITERATOR, protoMsg, iteratorType),
                                            notes-> copy [note, err.withNote (copy [protoNote])]);
            }
        }
    }

    /**
     * Validate the type and memory semantics of a class iterator variable.
     *
     * @params:
     *   - context: validation context
     *   - vdecl:   iterator variable declaration
     *   - value:   value returned by GET_ITER
     *
     * @returns:
     *   (declValue, insert)
     */
    fn validateIterValidateVDecl (dmut context: &ValidationContext, vdecl: &VarDeclExpr, value: &Value)-> (&VarDeclValue, bool)
        throws ErrorMsg
    {
        let vType = if vdecl.type !of EmptyExpr {
            TypeValidation::validateForVarDecl (alias context, vdecl.type, vdecl,
                                                canBeRef-> false)            
        } else {
            TypeValidation::validateForVarDecl (alias context, copy TypeWrapperExpr (vdecl.loc, value.type), vdecl,
                                                canBeRef-> false)
        }

        TypeVerification::verifyMutableIterator (vdecl.isMutOrDmut, vType, isRef-> false);
        let finVal = TypeInference::inferValueForType (alias context, vdecl.loc, value, vType,
                                                       byReference-> false);

        let retTypeLoc = if let c: &MethodCallValue = value {
            c.delegate.proto.loc
        } else {
            value.loc
        };

        MemoryVerification::verifyMemoryOwner (retTypeLoc, vType, finVal,
                                               construct-> true,
                                               byReference-> false);

        let (nameLoc, insert) = if vdecl.name == Keys::UNDER {
            (vdecl.name.locate (ForLoopKeys::ITER), false)
        } else {
            (vdecl.name, true)
        };

        let decl = copy VarDeclValue (nameLoc, vType, finVal,
                                      isMutable-> (vdecl.isMutable || vdecl.isDeeplyMutable),
                                      isReference-> false,
                                      isIterator-> true);

        return (decl, insert);
    }

    /**
     * Resolve and validate the GET_ITER operator for class iteration.          
     *
     * @params:
     *   - context:      validation context
     *   - loc:          operator location
     *   - iterator:     iterator value
     *   - iteratorType: class pointer type
     *   - index:        index of the iterator variable
     *   - nbVars:       total number of iterator variables
     *
     * @returns:
     *   A &Value representing the result of GET_ITER.
     */
    fn validateIterCallGet (dmut context: &ValidationContext,
                            loc:          &Word,
                            iterator:     &Value,
                            iteratorType: &ClassPtrType,
                            index:        usize,
                            nbVars:       usize)-> &Value
        throws ErrorMsg
    {
        {
            let meth = ValueCreation::createObjectMethodAcc (alias context, loc, iteratorType, iterator, OpOverrideNames::GET_ITER,
                                                             allowImmut-> true);
            
            let templ = TemplateValidation::validateCall (alias context, loc, meth, copy [copy IntValue (loc, USIZE_TYPE, index), copy IntValue (loc, USIZE_TYPE, nbVars)]);
            return CallValidation::validate (alias context, loc, templ, []);                
        } catch {
            err : &ErrorMsg => {
                let note = copy ErrorMsg::note (loc, format (ValidateErrorMessage::CALL_GET_OP_ONE_LINE, loc.str, iterator, index, nbVars),
                                                oneLine-> true);
                
                throw copy ErrorMsg::fatal (loc, format (ValidateErrorMessage::CALL_GET_OP_ITERATOR, iteratorType, index, nbVars),
                                            notes-> copy [note, err]);
            }
        }
    }

    /**
     * Validate the NEXT operator call for class iteration.
     *          
     * @params:
     *   - context:      validation context
     *   - loc:          operator location
     *   - iterator:     iterator value
     *   - iteratorType: class pointer type
     *
     * @returns:
     *   A &Value representing the increment expression.
     */
    fn validateIncrement (dmut context: &ValidationContext,
                          loc: &Word,
                          iterator: &Value,
                          iteratorType: &ClassPtrType)-> &Value
        throws ErrorMsg
    {
        {
            let meth = ValueCreation::createObjectMethodAcc (alias context, loc, iteratorType, iterator, OpOverrideNames::NEXT);
            return CallValidation::validate (alias context, loc, meth, []);
        } catch {
            err : &ErrorMsg => {
                let note = copy ErrorMsg::note (loc, format (ValidateErrorMessage::CALL_NEXT_OP_ONE_LINE, iterator, iterator),
                                                oneLine-> true);
                
                throw copy ErrorMsg::fatal (loc, format (ValidateErrorMessage::CALL_NEXT_OP_ITERATOR, iteratorType),
                                            notes-> copy [note, err]);
            }
        }        
    }

    /**
     * Validate that BEGIN returns a valid iterator type.
     *
     * Behavior:
     *   - Ensures the returned type is a class pointer.
     *   - Ensures the iterator implements the Iterator trait.
     *   - Verifies memory ownership of the BEGIN result.
     *   - Wraps errors with prototype notes and BEGIN-specific diagnostics.
     *
     * @params:
     *   - context:      validation context
     *   - loc:          loop location
     *   - cptr:         class pointer type
     *   - iteratorDecl: VarDeclValue for the iterator
     *   - beginMeth:    BEGIN method result
     *
     * @returns:
     *   The validated iterator class pointer type.
     */
    fn verifyBeginIsValid (dmut context: &ValidationContext,
                           loc:          &Word,
                           cptr:         &ClassPtrType,
                           iteratorDecl: &VarDeclValue,
                           beginMeth:    &Value)-> &ClassPtrType
        throws ErrorMsg
    {
        let (protoLocBeg, retTypeLoc, protoMsg) = if let c: &MethodCallValue = beginMeth {
            (c.delegate.proto.loc, c.delegate.proto.retType.loc, format ("%", c.delegate.proto, tags-> FormatTags (withParams-> true)))
        } else {
            (loc, loc, format ("%", beginMeth))
        };

        {
            if let iterCptr: &ClassPtrType = iteratorDecl.varType {
                let iteratorTrait = TypeCreation::createIteratorTrait (alias context, loc);
                TypeVerification::verifyImplement (iteratorDecl.loc, iterCptr, iteratorTrait);
                MemoryVerification::verifyMemoryOwner (retTypeLoc, iterCptr, beginMeth,
                                                       byReference-> false,
                                                       construct-> true,
                                                       byLazy-> false);

                return iterCptr;
            } else {
                throw copy ErrorMsg::fatal (loc, format (ValidateErrorMessage::NOT_A_CLASS, iteratorDecl.varType));
            }
        } catch {
            err => {
                let noteBeg = copy ErrorMsg::note (protoLocBeg, format (ValidateErrorMessage::CALL_PROTO, protoMsg),
                                                   notes-> copy [err]);
                let rewriteNote = copy ErrorMsg::note (loc, format (ValidateErrorMessage::CALL_BEGIN_ONE_LINE, cptr),
                                                       oneLine-> true);
                
                throw copy ErrorMsg::list (copy [rewriteNote, noteBeg]);
            }
        }
    }
    
    /**
     * Verify aliasing rules for class iteration.
     *
     * Behavior:
     *   - If aliasing was requested but not used by BEGIN/END,
     *     emits an UNECESSARY_ALIAS_CPTR_LOOP error.
     *   - Includes prototype notes for both BEGIN and END.
     *
     * @params:
     *   - loc:        loop location
     *   - aliasLoc:   alias operator location
     *   - cptr:       class pointer type
     *   - beginMeth:  BEGIN method result
     *   - endMeth:    END method result
     *   - usedAlias:  whether aliasing was actually used
     *   - byAlias:    whether aliasing was requested
     */
    fn verifyUseAliasCptrIter (loc:       &Word,
                               aliasLoc:  &Word,
                               cptr:      &ClassPtrType,
                               beginMeth: &Value,
                               endMeth:   &Value,
                               usedAlias: bool,
                               byAlias:   bool)
        throws ErrorMsg
    {
        if (!usedAlias && byAlias) {
            let protoLocBeg = if let c: &MethodCallValue = beginMeth {
                c.delegate.proto.loc
            } else {
                loc 
            };

            let protoLocEnd = if let c: &MethodCallValue = endMeth {
                c.delegate.proto.loc
            } else {
                loc
            };

            let noteBeg = copy ErrorMsg::note (protoLocBeg, format (ValidateErrorMessage::CALL_PROTO, beginMeth),
                                               oneLine-> true,
                                               withLoc-> true);
            
            let noteEnd = copy ErrorMsg::note (protoLocEnd, format (ValidateErrorMessage::CALL_PROTO, endMeth),
                                               oneLine-> true,
                                               withLoc-> true);

            let unecessaryErr = copy ErrorMsg::fatal (aliasLoc, format (ValidateErrorMessage::UNECESSARY_ALIAS_CPTR_LOOP, cptr),
                                                      notes-> copy [noteBeg, noteEnd]);
            
            throw copy ErrorMsg::fatal (loc, format (ValidateErrorMessage::FOR_LOOP_CPTR, cptr),
                                        notes-> copy [unecessaryErr]);
        }        
    }
}
