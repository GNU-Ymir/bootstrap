in range;


use ymirc::lexing::word;

use ymirc::syntax::expression::control;
use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::errors::message;

use ymirc::utils::format;


pub mod RangeForLoopValidation {

    pub fn validate (dmut context: &ValidationContext,
                     iter: &Value,
                     rangeType: &RangeType,
                     floop: &ForLoopExpr,
                     byMutRef: bool,
                     byAlias: bool)-> (&Value, bool, bool)
        throws ErrorMsg
    {}

    pub fn validateCte (dmut context: &ValidationContext,
                        iter: &Value,
                        rangeType: &RangeType,
                        floop: &ForLoopExpr)-> &Value                     
        throws ErrorMsg
    {}        
}
