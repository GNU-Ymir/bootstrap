in unsafe_;

use ymirc::syntax::expression::control;
use ymirc::semantic::validator;
use ymirc::semantic::generator::value::_;

use ymirc::errors;

/**
 * UnsafeValidation module
 *
 * Provides validation for `unsafe` expressions.
 *
 * Semantics:
 *   - Only one unsafe context may be active at a time.
 *   - Entering an unsafe block records its source location.
 *   - Exiting an unsafe block restores the previous safety state.
 *   - Any nested `unsafe` block triggers a MULTIPLE_UNSAFE diagnostic.
 *
 * The module enforces:
 *   - correct scoping of unsafe contexts
 *   - correct cleanup even when validation throws
 *   - consistent error reporting for nested unsafe blocks
 */
pub mod UnsafeValidation {

    /**
     * Validate an `unsafe` expression.
     *
     * An `unsafe` block temporarily enables operations that bypass Ymir’s
     * safety guarantees. Unsafe contexts:
     *
     *   - cannot be nested
     *   - must be explicitly delimited
     *   - must restore the previous safety state even if validation fails
     *
     * This function enforces these rules and wraps the validated expression in
     * a BlockValue whose type reflects implicit mutability inference.
     *
     * @params:
     *   - context: validation context
     *   - u:       unsafe expression
     *
     * @returns:
     *   - a BlockValue representing the validated unsafe block
     *
     * @throws:
     *   - ErrorMsg if nested unsafe blocks are detected, if the inner
     *     expression fails validation, or if exiting the unsafe context
     *     fails
     *
     */
    pub fn validate(dmut context: &ValidationContext, u: &UnsafeExpr)-> &Value
        throws ErrorMsg
    {
        let loc = context.getUnsafeContextLoc();
        if (!loc.isEof) {
            throw copy ErrorMsg::fatal(u.loc,
                                        ValidateErrorMessage::MULTIPLE_UNSAFE,
                                        notes-> copy [copy ErrorMsg::note(loc, "")]);
        }

        let mut error: (&ErrorMsg)? = none;
        let value = {
            context:.enterUnsafeContext(u.loc);
            ValueValidation::validate(alias context, u.value)
        } exit {
            {
                context:.exitUnsafeContext(); // throws NOT_UNSAFE
            } catch {
                err: &ErrorMsg => { error = err?; }
            }
        };

        if let Ok(e) = error {
            throw e;
        }

        let innerType = TypeInference::inferImplicitMutability(value.type, value);
        let ct = copy CastValue(u.loc, innerType, value);
        return context.cteInterpret:.reduce(ct);
    }

}
