/*
 * Implements validation for lazy expressions in Ymir.
 *
 * A lazy expression(`lazy x`) defers the evaluation of `x` by wrapping it
 * inside an implicit lambda. The resulting LazyValue contains:
 *
 *   - the original value(for type information)
 *   - a synthesized lambda that computes the value on demand
 *   - alias-propagation metadata
 *
 * Lazy evaluation is only permitted when the surrounding context explicitly
 * allows it. Otherwise, an UNECESSARY_LAZY diagnostic is emitted.
 *
 * Responsibilities:
 *   - enforce contextual permission for lazy evaluation
 *   - validate and type-check the underlying expression
 *   - forbid lazy void expressions
 *   - determine alias-propagation rules
 *   - synthesize the implicit lambda implementing the lazy computation
 *   - construct the LazyValue
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::value::control::lazy_
 * @File: ymirc/semantic/validator/value/control/lazy_.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-03-27
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in lazy_;

use ymirc::syntax::{expression::_, declaration::function};
use ymirc::semantic::validator;
use ymirc::semantic::generator::{value, value::_, type::_};

use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::format;

use ymirc::errors;
use std::io;

/**
 * LazyValidation module
 *
 * Provides validation for lazy expressions(`lazy x`).
 *
 * Lazy semantics:
 *   - A lazy expression does not evaluate its operand immediately.
 *   - Instead, it generates a hidden lambda that computes the value when
 *     invoked by the runtime.
 *   - The resulting LazyValue stores both the original value and the
 *     synthesized lambda.
 *
 * Alias interaction:
 *   - If the underlying value requires explicit aliasing, the lazy wrapper
 *     uses a cloned type to avoid alias-by-reference.
 *   - Otherwise, the lazy wrapper preserves the alias requirement of the
 *     underlying type.
 *
 * The module enforces:
 *   - contextual permission(`canBeLazy`)
 *   - non-void return types
 *   - correct alias propagation
 *   - correct construction of the implicit lambda
 */
pub mod LazyValidation {

    /**
     * Validate a lazy expression(`lazy x`).
     *
     * @params:
     *   - context:    validation context
     *   - la:         lazy expression
     *   - canBeLazy:  whether lazy evaluation is permitted in this context
     *
     * @returns:
     *   - a LazyValue representing the deferred computation
     *
     * @throws:
     *   - ErrorMsg if lazy evaluation is not permitted or the value is invalid
     */
    pub fn validate(dmut context: &ValidationContext, la: &LazyExpr, canBeLazy: bool)-> &Value
        throws ErrorMsg
    {
        if (!canBeLazy) {
            throw copy ErrorMsg::fatal(la.loc, format(ValidateErrorMessage::UNECESSARY_LAZY));
        }

        let retValue = ValueValidation::validate(alias context, la.value);
        TypeVerification::verifyNonVoid(la.loc, retValue.type, construct-> false);

        let (byAlias, retType) = if (!MemoryVerification::needsExplicitAlias(retValue) && retValue.type.needsExplicitAlias) {
            (true, retValue.type)
        } else {
            (false, retValue.type.cloneMutableUntilBorrow())
        };

        let name = la.loc.locate("#_REF");
        context:.enterBlock();
        {
            let retVdecl = copy VarDeclExpr(loc-> name,
                                            name-> name,
                                            type-> copy TypeWrapperExpr(la.loc, retType, asIs-> true),
                                            value-> EMPTY_EXPR,
                                            isMutOrDmut-> la.loc.locate(Keys::MUTABLE),
                                            isLazyOrRef-> la.loc.locate(Keys::REF));

            let proto = FunctionPrototype(copy [retVdecl],
                                          retType-> EMPTY_EXPR,
                                          isVariadic-> false);

            let (paramVars, paramTypes, _, incomplete) = LambdaPrototypeValidation::validate(alias context, proto);
            if incomplete {
                eprintln("internal lazy value validation");
                panic;
            }

            let vref = copy VarRefValue(name, la.loc, retType, paramVars[0].uniqId,
                                        isReference-> true,
                                        canCte-> false);
            let vexpr = copy ValueWrapperExpr(la.loc, vref);

            let affect = copy BinaryExpr(la.loc.locate(Tokens::EQUAL), vexpr, la.value);
            let blk = copy BlockExpr(la.loc, la.loc, copy [affect, EMPTY_EXPR]);

            let frameName = context.referent.path.push(format("_%_%", la.loc.line, la.loc.col));
            let index = context.getCurrentClosingIndex();

            let lmbdValue = copy LambdaValue(la.loc,
                                             copy LambdaType(la.loc, paramTypes, retType),
                                             frameName,
                                             paramVars,
                                             VOID_TYPE,
                                             blk,
                                             isClosure-> true,
                                             index,
                                             copyLoc-> la.loc);


            let (retProto, frame) = LambdaValidation::validate(alias context, lmbdValue, paramTypes,
                                                               forLazy-> true,
                                                               castClosure-> false);

            LambdaCreation::insertGenerator(alias context, frame);
            return copy LazyValue(la.loc,
                                  type-> retType,
                                  value-> retValue,
                                  lambda-> retProto,
                                  isByAlias-> byAlias);
        } exit {
            context:.safeQuitBlock();
        }
    }
}
