in for_;

use ymirc::lexing::word;

use ymirc::syntax::expression::control;
use ymirc::semantic::validator;
use ymirc::semantic::generator::value;

use ymirc::errors::message;

pub mod ForLoopValidation {

    pub fn validate (dmut context: &ValidationContext, cond: &ForLoopExpr)-> &Value
        throws ErrorMsg
    {
        if !cond.isCte.isEof {
            return ForLoopValidation::validateCte (alias context, cond);
        }

        
        context;
        cond;
        panic;
    }

    pub fn validateCte (dmut context: &ValidationContext, loc: &Word, cond: &ForLoopExpr)-> &Value
        throws ErrorMsg
    {
        context;
        cond;
        panic;
    }
    
}
