/*
 * Implements validation for spawn expressions in Ymir.
 *
 * A spawn expression(`spawn x`) schedules the evaluation of `x` to occur
 * asynchronously. The result of a spawn is a FutureValue, which contains:
 *
 *   - the original value(for type information)
 *   - a synthesized lambda that computes the value asynchronously
 *   - alias-propagation metadata
 *
 * Spawn behaves similarly to lazy evaluation, but produces a FutureType instead
 * of a LazyValue. The spawned computation is always wrapped in an implicit
 * lambda.
 *
 * Responsibilities:
 *   - validate the spawned expression
 *   - determine alias-propagation rules
 *   - synthesize the implicit lambda implementing the asynchronous task
 *   - construct the FutureValue
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::value::control::spawn_
 * @File: ymirc/semantic/validator/value/control/spawn_.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-03-27
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in spawn_;

use ymirc::syntax::{expression::_, declaration::function};
use ymirc::semantic::validator;
use ymirc::semantic::generator::{value, value::_, type::_};

use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::format;

use ymirc::errors;
use std::io;

/**
 * SpawnValidation module
 *
 * Provides validation for spawn expressions(`spawn x`).
 *
 * Spawn semantics:
 *   - The operand is evaluated asynchronously.
 *   - A hidden lambda is generated to compute the value.
 *   - The result is wrapped in a FutureValue of type future-> T.
 *
 * Alias interaction:
 *   - If the underlying value requires explicit aliasing, the spawned
 *     computation uses a cloned mutable-until-borrow type.
 *   - Otherwise, alias requirements propagate from the underlying type.
 *
 * The module enforces:
 *   - correct validation and type-checking of the operand
 *   - correct alias propagation
 *   - correct construction of the implicit lambda
 *   - correct construction of the FutureValue
 */
pub mod SpawnValidation {

    /**
     * Validate a spawn expression(`spawn x`).
     *
     * @params:
     *   - context: validation context
     *   - la:      spawn expression
     *
     * @returns:
     *   - a FutureValue representing the asynchronous computation
     *
     * @throws:
     *   - ErrorMsg if the operand is invalid or the lambda cannot be validated
     */
    pub fn validate(dmut context: &ValidationContext, la: &SpawnExpr)-> &Value
        throws ErrorMsg
    {
        let retValue = ValueValidation::validate(alias context, la.value);
        let (byAlias, innerType) = if (!MemoryVerification::needsExplicitAlias(retValue) && retValue.type.needsExplicitAlias) {
            (true, retValue.type)
        } else {
            (false, retValue.type.cloneMutableUntilBorrow())
        };

        let (lmbdValue, paramTypes) = if (innerType of VoidType) {
            SpawnValidation::validateVoid(alias context, la.loc, retValue, innerType)
        } else {
            SpawnValidation::validateReturn(alias context, la.loc, retValue, innerType)
        }

        let (retProto, frame) = LambdaValidation::validate(alias context, lmbdValue, paramTypes,
                                                           forLazy-> true,
                                                           castClosure-> false);

        LambdaCreation::insertGenerator(alias context, frame);
        let type = copy FutureType(la.loc, innerType, isMutable-> true);

        return copy FutureValue(la.loc,
                                type,
                                retValue,
                                lambda-> retProto,
                                isByAlias-> byAlias);

    }

    /**
     * Validate the lambda for a spawn expression(`spawn x`) that returns a void value.
     *
     * @params:
     *   - context:  validation context
     *   - loc:      the location of the spawn expression
     *   - retValue: the value returned by the spawn
     *   - retType:  the return type of the spawn expression
     *
     * @returns:
     *   - .0: the lambda value called when a thread is spawned
     *   - .1: the list of parameter types of the lambda value
     *
     */
    fn validateVoid(dmut context: &ValidationContext, loc: &Word, retValue: &Value, retType: &Type)-> (&LambdaValue, [&Type])
        throws ErrorMsg
    {
        let proto = FunctionPrototype([],
                                      retType-> EMPTY_EXPR,
                                      isVariadic-> false);

        let (paramVars, paramTypes, _, incomplete) = LambdaPrototypeValidation::validate(alias context, proto);
        if incomplete {
            eprintln("internal lazy value validation");
            panic;
        }

        let blk = copy BlockExpr(loc, loc, copy [copy ValueWrapperExpr(retValue.loc, retValue), EMPTY_EXPR]);
        let frameName = context.referent.path.push(format("_%_%", loc.line, loc.col));
        let index = context.getCurrentClosingIndex();

        let lmbdValue = copy LambdaValue(loc,
                                         copy LambdaType(loc, paramTypes, retType),
                                         frameName,
                                         paramVars,
                                         VOID_TYPE,
                                         blk,
                                         isClosure-> true,
                                         index,
                                         copyLoc-> loc);
        return (lmbdValue, paramTypes);
    }

    /**
     * Validate the lambda for a spawn expression(`spawn x`) that returns a value.
     *
     * @params:
     *   - context:  validation context
     *   - loc:      the location of the spawn expression
     *   - retValue: the value returned by the spawn
     *   - retType:  the return type of the spawn expression
     *
     * @returns:
     *   - .0: the lambda value called when a thread is spawned
     *   - .1: the list of parameter types of the lambda value
     *
     */
    fn validateReturn(dmut context: &ValidationContext, loc: &Word, retValue: &Value, retType: &Type)-> (&LambdaValue, [&Type])
        throws ErrorMsg
    {
        let name = loc.locate("#_REF");
        context:.enterBlock();
        {
            let retVdecl = copy VarDeclExpr(loc-> name,
                                            name-> name,
                                            type-> copy TypeWrapperExpr(loc, retType, asIs-> true),
                                            value-> EMPTY_EXPR,
                                            isMutOrDmut-> loc.locate(Keys::MUTABLE),
                                            isLazyOrRef-> loc.locate(Keys::REF));


            let proto = FunctionPrototype(copy [retVdecl],
                                          retType-> EMPTY_EXPR,
                                          isVariadic-> false);

            let (paramVars, paramTypes, _, incomplete) = LambdaPrototypeValidation::validate(alias context, proto);
            if incomplete {
                eprintln("internal lazy value validation");
                panic;
            }

            let vref = copy VarRefValue(name, loc, retType, paramVars[0].uniqId,
                                        isReference-> true,
                                        canCte-> false);
            let vexpr = copy ValueWrapperExpr(loc, vref);
            let resultExpr = copy ValueWrapperExpr(retValue.loc, retValue);

            let affect = copy BinaryExpr(loc.locate(Tokens::EQUAL), vexpr, resultExpr);
            let blk = copy BlockExpr(loc, loc, copy [affect, EMPTY_EXPR]);

            let frameName = context.referent.path.push(format("_%_%", loc.line, loc.col));
            let index = context.getCurrentClosingIndex();

            let lmbdValue = copy LambdaValue(loc,
                                             copy LambdaType(loc, paramTypes, retType),
                                             frameName,
                                             paramVars,
                                             VOID_TYPE,
                                             blk,
                                             isClosure-> true,
                                             index,
                                             copyLoc-> loc);

            return (lmbdValue, paramTypes);
        } exit {
            context:.safeQuitBlock();
        }
    }
}
