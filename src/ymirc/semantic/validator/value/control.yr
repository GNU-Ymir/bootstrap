 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in control;

use ymirc::syntax::expression::control;
use ymirc::semantic::validator;
use ymirc::semantic::generator::value;

use ymirc::errors::message;
use ymirc::semantic::validator::value::control::_;

use std::io;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub mod ::lazy_;
pub mod ::spawn_;

mod ::atomic_;
mod ::await_;
mod ::unsafe_;
mod ::iflet;
mod ::whilelet;

pub mod ::conditional;
pub mod ::for_;
pub mod ::match_;
pub mod ::while_;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          ROOT          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * ControlValidation module
 *
 * Provides the dispatch function for validating control-flow expressions.
 *
 * This module ensures that all control-flow constructs share a uniform
 * validation entry point.
 */
pub mod ControlValidation {

    /**
     * Validate a control-flow expression by dispatching to the correct validator.
     *
     * @params:
     *   - context:   validation context
     *   - control:   control-flow expression to validate
     *   - canBeLazy: whether lazy expressions are permitted in this context
     *
     * @returns:
     *   - the validated Value
     *
     * @throws:
     *   - ErrorMsg if the delegated validator throws
     */
    pub fn validate(dmut context: &ValidationContext, control: &ControlExpr, canBeLazy: bool)-> &Value
        throws ErrorMsg
    {
        match control {
            a: &AtomicExpr => return AtomicValidation::validate(alias context, a);
            a: &AwaitExpr => return AwaitValidation::validate(alias context, a);
            c: &ConditionalExpr => return ConditionalValidation::validate(alias context, c);
            c: &ConditionalLetExpr => return ConditionalLetValidation::validate(alias context, c);
            f: &ForLoopExpr => return ForLoopValidation::validate(alias context, f);
            l: &LazyExpr => return LazyValidation::validate(alias context, l, canBeLazy-> canBeLazy);
            m: &MatcherExpr => return MatchValidation::validate(alias context, m);
            s: &SpawnExpr => return SpawnValidation::validate(alias context, s);
            u: &UnsafeExpr => return UnsafeValidation::validate(alias context, u);
            w: &WhileLoopExpr => return WhileLoopValidation::validate(alias context, w);
            w: &WhileLetLoopExpr => return WhileLetLoopValidation::validate(alias context, w);
            _ => {
                eprintln("internal control flow validation; ", control.__typeinfo.name);
                panic;
            }
        }
    }
}
