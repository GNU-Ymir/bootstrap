in control;

use ymirc::syntax::expression::control;
use ymirc::semantic::validator;
use ymirc::semantic::generator::value;

use ymirc::errors::message;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub mod ::atomic_;
pub mod ::await_;
pub mod ::conditional;
pub mod ::for_;
pub mod ::iflet;
pub mod ::lazy_;
pub mod ::match_;
pub mod ::spawn_;
pub mod ::unsafe_;
pub mod ::while_;
pub mod ::whilelet;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          ROOT          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub mod ControlValidation {

    pub fn validate(dmut context: &ValidationContext, control: &ControlExpr, canBeLazy: bool)-> &Value
        throws ErrorMsg
    {
        match control {
            a: &AtomicExpr => return AtomicValidation::validate(alias context, a);
            a: &AwaitExpr => return AwaitValidation::validate(alias context, a);
            c: &ConditionalExpr => return ConditionalValidation::validate(alias context, c);
            c: &ConditionalLetExpr => return ConditionalLetValidation::validate(alias context, c);
            f: &ForLoopExpr => return ForLoopValidation::validate(alias context, f);
            l: &LazyExpr => return LazyValidation::validate(alias context, l, canBeLazy-> canBeLazy);
            m: &MatcherExpr => return MatcherValidation::validate(alias context, m);
            s: &SpawnExpr => return SpawnValidation::validate(alias context, s);
            u: &UnsafeExpr => return UnsafeValidation::validate(alias context, u);
            w: &WhileLoopExpr => return WhileLoopExpr::validate(alias context, w);
            w: &WhileLetLoopExpr => return WhileLetLoopExpr::validate(alias context, w);
            _ => {
                eprintln("internal control flow validation; ", control.__typeinfo.name);
                panic;
            }
        }
    }

}
