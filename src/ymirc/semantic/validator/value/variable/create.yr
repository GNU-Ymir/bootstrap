 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in create;

use ymirc::lexing::{word, tokens};

use ymirc::syntax::expression::_;
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::errors::message;
use ymirc::utils::format;

use std::fs::path;


/**
 * VariableCreation module
 *
 * Provides utilities for constructing synthetic variable expressions and
 * generating standardized variable-related error messages. This includes
 * building PathExpr trees from path components and producing detailed error
 * messages for undefined or inaccessible variables.
 *
 * All functions assume syntactic correctness and are used during semantic
 * validation.
 */
pub mod VariableCreation {
    
    /**
     * Create a synthetic variable expression (PathExpr) from a filesystem-like path.
     *
     * This overload accepts a Path object and forwards to the slice-based
     * version. The resulting expression is a chain of VarExpr and PathExpr
     * nodes representing a fully qualified name such as:
     * ```
     * ["core", "array", "opCmp"] → core::array::opCmp
     * ```
     * 
     * @params:
     *   - loc:  the location to attach to the generated expression
     *   - path: a Path object whose components form the variable path
     *
     * @returns:
     *   - an Expression representing the fully qualified variable reference
     *
     * @panic:
     *   - if the path contains zero components
     */
    pub fn createSyntaxVarFromPath (loc: &Word, path: Path)-> &Expression {
        return VariableCreation::createSyntaxVarFromPath (loc, path.parts ());
    }

    /**
     * Create a synthetic variable expression (PathExpr) from a list of path segments.
     *
     * Builds a left-associated PathExpr chain:
     * ```
     * VarExpr("core") :: VarExpr("array") :: VarExpr("opCmp")
     * ```
     * 
     * Each segment is treated as a quoted identifier to avoid accidental
     * keyword interpretation.
     *
     * @params:
     *   - loc:  the location to attach to the generated expression
     *   - path: a non-empty list of identifier components
     *
     * @returns:
     *   - an Expression representing the fully qualified variable reference
     *
     * @panic:
     *   - if `path` is empty
     */
    fn createSyntaxVarFromPath (loc: &Word, path: [[c8]])-> &Expression {
        if (path.len == 0us) panic;
        let mut leaf: &Expression = copy VarExpr (loc.locate (path [0us]), isQuoted-> true);
        for i in 1us .. path.len { // This is relatively simple, we just create a list
            leaf = copy PathExpr (loc.locate (Tokens::DCOLON),
                                  leaf,
                                  copy VarExpr (loc.locate (path[i]), isQuoted-> true));
        }

        leaf
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          ERRORS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Create an error message for an undefined or inaccessible global variable.
     *
     * Steps:
     *   1. Build the base global-access error using the declarator.
     *   2. Check whether the name refers to a native type; if so, append that error.
     *   3. If the name corresponds to an uninitialized class field, append a note.
     *   4. Attach any additional sub-errors provided by the caller.
     *
     * @params:
     *   - context:  validation context
     *   - loc:      location of the failed reference
     *   - name:     the variable name
     *   - subError: optional list of additional errors to attach
     *
     * @returns:
     *   - an ErrorMsg describing the failure
     */
    pub fn createGlobalVarError (context:   &ValidationContext,
                                 loc:      &Word,
                                 name:     [c8],
                                 subError: [&ErrorMsg] = [])-> &ErrorMsg {
        
        let glb = context.declarator.createGlobalAccessError (loc, name, context.referent);
        {
            VariableVerification::verifyNotIsNativeType (loc, name);
        } catch {
            err: &ErrorMsg => {
                return copy ErrorMsg::list (copy [glb, err] ~ subError);
            }
        }

        let sub = if context.isUninitFieldValidated (name) {
            subError ~ [copy ErrorMsg::note (loc, format (ValidateErrorMessage::CLASS_FIELD_NOT_INIT_YET, name))]
        } else { subError }

        glb.withNote (sub)
    }

    /**
     * Create an error message for an undefined or inaccessible local variable.
     *
     * Similar to createGlobalVarError, but tailored for local/module-scoped
     * resolution. Produces a list of errors rather than a single aggregated error.
     *
     * @params:
     *   - context:  validation context
     *   - loc:      location of the failed reference
     *   - module:   the module in which the lookup occurred
     *   - name:     the variable name
     *   - subError: optional list of additional errors to attach
     *
     * @returns:
     *   - a list of ErrorMsg objects describing the failure
     */
    pub fn createLocalVarError (context:  &ValidationContext,
                                loc:      &Word,
                                module:   &ModuleRefValue,
                                name:     [c8],
                                subError: [&ErrorMsg] = [])-> [&ErrorMsg]
    {
        let glb = context.declarator.createLocalAccessError (loc, name, module.sym, context.referent);
        {
            VariableVerification::verifyNotIsNativeType (loc, name);
        } catch {
            err: &ErrorMsg => {
                return (glb ~ [err]) ~ subError;
            }
        }

        glb ~ subError
    }

}
