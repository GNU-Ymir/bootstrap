in verif;

use ymirc::errors;
use ymirc::lexing::{keys, word};
use ymirc::semantic::generator::{type::_, type::native, value::_, value::variable};
use ymirc::utils::format;

prv {
    lazy __NATIVE_TYPES__ = {
        let dmut lst: [[c8] => ()] = copy [];
        for i in NativeTypes::__members__ if i != NativeTypes::ERROR {
            lst[i] = ();
        }

        lst
    };
}

/**
 * VariableVerification module
 *
 * Provides helper predicates and validation routines used during semantic
 * analysis to classify and verify variable references. These checks determine
 * whether a value corresponds to:
 *
 *   - `self`,
 *   - a function parameter,
 *   - an iterator variable,
 *   - a reference parameter,
 *   - or a lazy variable(local or global).
 *
 * The module also enforces rules such as:
 *   - preventing shadowing of existing variables,
 *   - forbidding the use of native type names as identifiers.
 *
 * All functions operate on semantic Value nodes and are lightweight.
 */
pub mod VariableVerification {

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          CHECKS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Determines whether a value refers to the implicit `self` variable.
     *
     * @params:
     *    - value:  The value to inspect.
     * @returns: true iff the value is a VarRefValue referring to `self`.
     */
    pub fn isSelf(value: &Value)-> bool {
        match value {
            v: &VarRefValue => { v.isSelf }
            _ => { false }
        }
    }

    /**
     * Determines whether a value refers to a function parameter.
     *
     * @params:
     *    - value: The value to inspect.
     * @returns: true iff the value is a VarRefValue referring to a parameter.
     */
    pub fn isParameter(value: &Value)-> bool {
        match value {
            v: &VarRefValue => { v.isParam }
            _ => { false }
        }
    }

    /**
     * Determines whether a value refers to an iterator variable.
     *
     * @params:
     *    - value: The value to inspect.
     * @returns: true iff the value is a VarRefValue referring to an iterator.
     */
    pub fn isIterator(value: &Value)-> bool {
        match value {
            v: &VarRefValue => { v.isIterator }
            _ => { false }
        }
    }

    /**
     * Determines whether a value refers to a variable passed by reference.
     *
     * @params:
     *    - value: The value to inspect.
     * @returns: true iff the value is a VarRefValue referring to a ref parameter.
     */
    pub fn isReference(value: &Value)-> bool {
        match value {
            v: &VarRefValue => { v.isReference }
            _ => { false }
        }
    }

    /**
     * Determines whether a value refers to a lazy variable whose result is a
     * temporary.
     *
     * A lazy parameter names a computation, not a location: each read produces the
     * value again in a fresh slot. A lazy global is not in that case - its value is
     * stored inside the global itself and only computed on first read - so it is
     * not reported here.
     *
     * @params:
     *    - value: The value to inspect.
     * @returns: true iff the value refers to a lazy variable.
     */
    pub fn isLazy(value: &Value)-> bool {
        match value {
            v: &VarRefValue => { v.isLazy }
            _ => { false }
        }
    }

    /**
     * Find the variable a value is a part of, or borrows from, e.g. `a` for `a[0].f`
     * or `a[1 .. $]`.
     *
     * @params:
     *    - value: the value
     * @returns: the variable, none if the value is not made of one, and true iff the
     *           value is an element of the variable, that `mut` does not make mutable
     */
    pub fn rootVariable(value: &Value)-> ((&VarRefValue)?, bool) {
        match value {
            v: &VarRefValue => { return (v?, false); }
            a: &ArrayAccessValue => { return VariableVerification::rootVariableOf(a.array); }
            s: &SliceAccessValue => { return VariableVerification::rootVariableOf(s.slice); }
            t: &TupleFieldAccessValue => { return VariableVerification::rootVariableOf(t.object); }
            c: &ClassFieldAccessValue => { return VariableVerification::rootVariableOf(c.object); }
            o: &OptionFieldAccessValue => { return VariableVerification::rootVariableOf(o.object); }
            m: &MapAccessValue => { return VariableVerification::rootVariableOf(m.map); }
            d: &DereferencerValue => { return VariableVerification::rootVariableOf(d.value); }
            a: &AddressValue => { return VariableVerification::rootVariableOf(a.value); }
            s: &SliceCtorValue => { return VariableVerification::rootVariableOf(s.ptr); }
            f: &StructFieldAccessValue => {
                let isRecord = if let c: &ClassPtrType = f.object.type { c.isStruct } else { false };
                return VariableVerification::rootVariableOf(f.object, isRecord-> isRecord);
            }
            p: &MathPointerOperatorValue => {
                return VariableVerification::rootVariable(if (p.left.type of PointerType) { p.left } else { p.right });
            }
            c: &CastValue => { return VariableVerification::rootVariable(c.value); }
            b: &BlockValue if (b.isSet && b.values.len != 0us) => { return VariableVerification::rootVariable(b.values[$ - 1us]); }
        }

        (none, false)
    }

    /**
     * Find the variable an element of `object` is a part of, cf. rootVariable.
     *
     * @params:
     *    - object:   the value whose element is accessed
     *    - isRecord: true iff `object` is a record, whose fields are as mutable as it is
     * @returns: the variable, none if `object` is not made of one, and true iff the
     *           element is not made mutable by `mut`
     */
    fn rootVariableOf(object: &Value, isRecord: bool = false)-> ((&VarRefValue)?, bool) {
        let (root, inner) = VariableVerification::rootVariable(object);
        (root, inner || !isRecord)
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          VERIFICATIONS          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Verify that a new variable name does not shadow an existing one.
     *
     * Rules:
     *   - `_` (ignore variable) never triggers shadowing.
     *   - Internal variables starting with `#` never trigger shadowing.
     *   - A variable whose name is a native type name throws an error.
     *   - If a local variable with the same name already exists, report an error
     *     with a note pointing to the original definition.
     *
     * @params:
     *   - context: validation context
     *   - loc:     location of the new declaration
     *   - name:    variable name
     *   - isQuoted: true iff the variable is surrounded by back-quotes
     *
     * @throws:
     *   - ErrorMsg if shadowing is detected or the name is a native type
     */
    pub fn verifyShadow(context: &ValidationContext, loc: &Word, name: [c8], isQuoted: bool)
        throws ErrorMsg
    {
        // No shadow for ignore var
        if (name == Keys::UNDER) return;

        // No shadow for internal variables
        if (name.len > 0us && name[0] == '#') return;

        if !isQuoted {
            VariableVerification::verifyNotIsNativeType(loc, name);
        }

        if let Ok(gen) = context.getLocalNoUse(name) {
            throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::SHADOWING_DECL, name),
                                       notes-> copy [copy ErrorMsg::note(gen.loc, ValidateErrorMessage::FIRST_DEFINED)]);
        }
    }

    /**
     * Verify that a name is not a native type identifier.
     *
     * Native types(e.g., `i32`, `bool`, etc.) cannot be used as variable names.
     *
     * @params:
     *   - loc:  location of the identifier
     *   - name: the identifier to check
     *
     * @throws:
     *   - ErrorMsg if the name corresponds to a native type
     */
    pub fn verifyNotIsNativeType(loc: &Word, name: [c8])
        throws ErrorMsg
    {
        if name in __NATIVE_TYPES__ {
            throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::IS_NATIVE_TYPE, name));
        }
    }

}
