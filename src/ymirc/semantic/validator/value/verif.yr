in verif;

use ymirc::semantic::validator;
use ymirc::errors::message;
use ymirc::semantic::generator::{value, value::_, type::_};

use ymirc::lexing::word;
use ymirc::utils::bigint;

pub mod ValueVerification {

    pub fn verifyUnsafeContext(dmut context: &ValidationContext, loc: &Word, msg: [c8] = ValidateErrorMessage::UNSAFE_OPERATION)
        throws ErrorMsg
    {
        if context.getUnsafeContextLoc().isEof {
            throw copy ErrorMsg::fatal(loc, msg);
        }

        context:.setUnsafeContextUsed(loc);
    }


    pub fn verifyNoBreaking(loc: &Word, value: &Value)
        throws ErrorMsg
    {
        if value.isBreaker {
            throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::UNREACHBLE_STATEMENT),
                                        notes-> copy [copy ErrorMsg::note(value.breakerLoc, ValidateErrorMessage::EXITING_SCOPE_HERE)]);
        }

        if value.isReturner {
            throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::UNREACHBLE_STATEMENT),
                                        notes-> copy [copy ErrorMsg::note(value.returnerLoc, ValidateErrorMessage::EXITING_SCOPE_HERE)]);
        }
    }

    pub fn verifyIndexOverflow(dmut context: &ValidationContext,
                                loc:          &Word,
                                objectType:   &Type,
                                indexValue:   &Value,
                                indexType:    &IntType,
                                maxLen:       &Value,
                                equalMax:     bool = true)-> bool
        throws ErrorMsg
    {
        let max = context.cteInterpret:.reduce(maxLen);
        let reduced = context.cteInterpret:.reduce(indexValue);
        if let i: &IntValue = reduced {
            if i < 0 {
                throw copy ErrorMsg::fatal(loc,
                                            end-> indexValue.loc,
                                            format(ValidateErrorMessage::NEGATIVE_INT_INDEX, leftType, i));
            }

            if let m: &IntValue = max {
                if ((equalMax && i > m) || i >= m) {
                    throw copy ErrorMsg::fatal(loc, end-> right.getLoc(), format(ValidateErrorMessage::ARRAY_OVERFLOW, maximum, val));
                }

                // not negative and inf of max len at CTE TIME
                return true;
            } else {
                IntInterpret::verifyOverflow(loc, indexType, i);
            }
        }

        return false;
    }

    /**
     * Verify that the range indexes are increasing
     * @returns: true if the test can be made at cte
     */
    pub fn verifyIncreasingRangeIndex(dmut context: &ValidationContext, loc: &Word, objectType: &Type, fst: &Value, scd: &Value)-> bool
        throws ErrorMsg
    {
        let fstR = context.cteInterpret:.reduce(fst);
        let scdR = context.cteInterpret:.reduce(scd);
        if let (i: &IntValue, j: &IntValue) = (fstR, scdR) {
            if j < i {
                throw copy ErrorMsg::fatal(loc, end-> fst.loc, format(ValidateErrorMessage::DECREASING_RANGE_ACCESS, objectType, fstR, scdR));
            }

            return true;
        }

        return false;
    }


}
