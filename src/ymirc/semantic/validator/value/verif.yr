 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in verif;

use ymirc::semantic::validator;
use ymirc::errors::message;
use ymirc::semantic::generator::{value, value::_, type::_};

use ymirc::lexing::word;
use ymirc::utils::bigint;

/**
 * ValueVerification module
 *
 * Provides helper functions for verifying semantic constraints on Values.
 *
 * Responsibilities:
 *   - enforce unsafe-context restrictions,
 *   - detect unreachable statements caused by break/return propagation,
 *   - verify compile-time index bounds for arrays and slices,
 *   - verify compile-time ordering of range indexes.
 *
 * These functions do not perform type inference or value construction. They
 * assume that the Value and Type arguments have already passed primary
 * validation.
 */
pub mod ValueVerification {

    /**
     * Ensure that an unsafe operation occurs inside an unsafe context.
     *
     * @params:
     *   - context: validation context
     *   - loc:     location of the unsafe operation
     *   - msg:     error message(default: UNSAFE_OPERATION)
     *
     * @throws:
     *   - ErrorMsg if operation occurs outside an unsafe context
     */
    pub fn verifyUnsafeContext(dmut context: &ValidationContext, loc: &Word, msg: [c8] = ValidateErrorMessage::UNSAFE_OPERATION)
        throws ErrorMsg
    {
        if context.getUnsafeContextLoc().isEof {
            throw copy ErrorMsg::fatal(loc, msg);
        }

        context:.setUnsafeContextUsed(loc);
    }

    /**
     * Ensure that a statement following a break/return is not executed.
     *
     * @params:
     *   - loc:   location of the unreachable statement
     *   - value: previously validated Value
     *
     * @throws:
     *   - ErrorMsg if the statement is unreachable
     */
    pub fn verifyNoBreaking(loc: &Word, value: &Value)
        throws ErrorMsg
    {
        if value.isBreaker {
            throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::UNREACHBLE_STATEMENT),
                                       notes-> copy [copy ErrorMsg::note(value.breakerLoc, ValidateErrorMessage::EXITING_SCOPE_HERE)]);
        }

        if value.isReturner {
            throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::UNREACHBLE_STATEMENT),
                                       notes-> copy [copy ErrorMsg::note(value.returnerLoc, ValidateErrorMessage::EXITING_SCOPE_HERE)]);
        }
    }

    /**
     * Verify that an integer index is within bounds at compile time.
     *
     * @returns:
     *   - true  if bounds were fully checked at compile time,
     *   - false otherwise.
     *
     * @throws:
     *   - ErrorMsg for negative indexes or overflow
     */
    pub fn verifyIndexOverflow(dmut context: &ValidationContext,
                               loc:          &Word,
                               objectType:   &Type,
                               indexValue:   &Value,
                               indexType:    &IntType,
                               maxLen:       &Value,
                               equalMax:     bool = true)-> bool
        throws ErrorMsg
    {
        let max = context.cteInterpret:.reduce(maxLen);
        let reduced = context.cteInterpret:.reduce(indexValue);
        if let i: &IntValue = reduced {
            if i < 0 {
                throw copy ErrorMsg::fatal(loc,
                                           end-> indexValue.loc,
                                           format(ValidateErrorMessage::NEGATIVE_INT_INDEX, leftType, i));
            }

            if let m: &IntValue = max {
                if ((equalMax && i > m) || i >= m) {
                    throw copy ErrorMsg::fatal(loc, end-> right.getLoc(), format(ValidateErrorMessage::ARRAY_OVERFLOW, maximum, val));
                }

                // not negative and inf of max len at CTE TIME
                return true;
            } else {
                IntInterpret::verifyOverflow(loc, indexType, i);
            }
        }

        return false;
    }


    /**
     * Verify that a range access uses increasing indexes when known at compile time.
     *
     * @returns:
     *   - true  if ordering was checked at compile time,
     *   - false otherwise.
     *
     * @throws:
     *   - ErrorMsg if scd < fst
     */
    pub fn verifyIncreasingRangeIndex(dmut context: &ValidationContext, loc: &Word, objectType: &Type, fst: &Value, scd: &Value)-> bool
        throws ErrorMsg
    {
        let fstR = context.cteInterpret:.reduce(fst);
        let scdR = context.cteInterpret:.reduce(scd);
        if let (i: &IntValue, j: &IntValue) = (fstR, scdR) {
            if j < i {
                throw copy ErrorMsg::fatal(loc, end-> fst.loc, format(ValidateErrorMessage::DECREASING_RANGE_ACCESS, objectType, fstR, scdR));
            }

            return true;
        }

        return false;
    }
}
