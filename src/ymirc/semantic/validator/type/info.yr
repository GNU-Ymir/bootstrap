 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in info;

use ymirc::semantic::{validator, declarator};

use ymirc::syntax::{_, declaration::_, expression::_};
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::semantic::symbol;
use ymirc::global::core_;

use ymirc::errors;

use ymirc::utils::{format, bigint};
use ymirc::lexing::{word, tokens, keys};

use std::{io, stream, conv};

/**
 * TypeInfo module
 *
 * This module validates typeinfo expressions and constructs the runtime
 * metadata structures used by core::typeinfo. It provides:
 *
 *   - typeinfo generation for all built-in and composite types,
 *   - field-info generation for classes and tuples,
 *   - creation of nested typeinfo arrays,
 *   - and dispatching based on the semantic type.
 *
 * All functions assume that the input type has already passed semantic
 * validation. Their purpose is to produce the canonical runtime description of
 * the type.
 *
 */
pub mod TypeInfo {

    /**
     * Validate the `typeinfo` of a type.
     *
     * @params:
     *   - context: validation context
     *   - loc:     location of the typeinfo expression
     *   - type:    the type whose typeinfo is requested
     *
     * @returns:
     *   - a Value representing the runtime typeinfo structure for `type`
     *
     * @throws:
     *   - ErrorMsg if typeinfo cannot be generated for the given type
     */
    pub fn validate(dmut context: &ValidationContext, loc: &Word, type: &Type)-> &Value
        throws ErrorMsg
    {
        let ti = TypeCreation::createTypeInfo(alias context, loc);
        TypeInfo::validate(alias context, loc, ti, type)
    }

    /**
     * Validate the `fieldinfo` of a type.
     *
     * Dispatches to the appropriate handler depending on whether `T` is a
     * class, class pointer, or tuple.
     *
     * @params:
     *   - context: validation context
     *   - loc:     location of the fieldinfo expression
     *   - type:    the type whose field metadata is requested
     *
     * @returns:
     *   - an array value containing field metadata for `type`
     *
     * @throws:
     *   - ErrorMsg if the type does not support field information
     */
    pub fn validateFieldInfos(dmut context: &ValidationContext, loc: &Word, type: &Type)-> &Value
        throws ErrorMsg
    {
        let fi = TypeCreation::createFieldInfo(alias context, loc);
        match type {
            c: &ClassRefType => {
                return TypeInfo::validateFieldInfoClass(alias context, loc, fi, c);
            }
            c: &ClassPtrType => {
                return TypeInfo::validateFieldInfoClass(alias context, loc, fi, c.inner);
            }
            t: &TupleType => {
                return TypeInfo::validateFieldInfoTuple(alias context, loc, fi, t);
            }
        }

        throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::TYPE_HAS_NO_FIELDINFO, type));
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          INNER          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Internal dispatcher for typeinfo generation.
     *
     * Selects the appropriate typeinfo constructor based on the semantic type.
     *
     * @params:
     *   - context: validation context
     *   - loc:     location of the typeinfo request
     *   - ti:      the core::typeinfo::TypeInfo struct type
     *   - type:    the type being described
     *
     * @returns:
     *   - a Value representing the runtime typeinfo for `type`
     *
     * @throws:
     *   - ErrorMsg if the type has no typeinfo representation
     */
    fn validate(dmut context: &ValidationContext, loc: &Word, ti: &ClassPtrType, type: &Type)-> &Value
        throws ErrorMsg
    {
        match type {
            b: &BoolType => {
                return TypeInfo::validateScalarType(alias context, loc, ti, b, TypeInfoIDS::BOOL);
            }
            it: &IntType if it.isSigned => {
                return TypeInfo::validateScalarType(alias context, loc, ti, it, TypeInfoIDS::SIGNED_INT);
            }
            it: &IntType if !it.isSigned => {
                return TypeInfo::validateScalarType(alias context, loc, ti, it, TypeInfoIDS::UNSIGNED_INT);
            }
            c: &CharType => {
                return TypeInfo::validateScalarType(alias context, loc, ti, c, TypeInfoIDS::CHAR);
            }
            f: &FloatType => {
                return TypeInfo::validateScalarType(alias context, loc, ti, f, TypeInfoIDS::FLOAT);
            }
            v: &VoidType => {
                return TypeInfo::validateScalarType(alias context, loc, ti, v, TypeInfoIDS::VOID);
            }
            d: &DelegateType => {
                return TypeInfo::validateDelegateType(alias context, loc, ti, d);
            }
            f: &FuncPtrType => {
                return TypeInfo::validateFuncPtrType(alias context, loc, ti, f);
            }
            a: &ArrayType => {
                return TypeInfo::validateArrayType(alias context, loc, ti, a);
            }
            p: &PointerType => {
                return TypeInfo::validatePointerType(alias context, loc, ti, p);
            }
            r: &RangeType => {
                return TypeInfo::validateRangeType(alias context, loc, ti, r);
            }
            s: &SliceType => {
                return TypeInfo::validateSliceType(alias context, loc, ti, s);
            }
            tu: &TupleType => {
                return TypeInfo::validateTupleType(alias context, loc, ti, tu);
            }
            c: &ClassPtrType => {
                return TypeInfo::validateClassPtrType(alias context, loc, ti, c);
            }
            c: &ClassRefType => {
                return TypeInfo::validateClassRefType(alias context, loc, ti, c);
            }
            o: &OptionType => {
                return TypeInfo::validateOptionType(alias context, loc, ti, o);
            }
            m: &MapType => {
                return TypeInfo::validateMapType(alias context, loc, ti, m);
            }
            e: &EnumType => {
                return TypeInfo::validate(alias context, loc, e.getLastLevelProxy());
            }
        }

        throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::TYPE_HAS_NO_TYPEINFO, type));
    }

    /**
     * Construct the typeinfo value for a scalar type(bool, int, char, float, void).
     *
     * @params:
     *   - context: validation context
     *   - loc:     location of the request
     *   - ti:      the TypeInfo struct type
     *   - scal:    the scalar type
     *   - code:    the TypeID code for this scalar
     *
     * @returns:
     *   - a StructInitValue describing the scalar type
     */
    fn validateScalarType(dmut context: &ValidationContext, loc: &Word, ti: &ClassPtrType, scal: &Type, code: [c8])-> &Value
        throws ErrorMsg
    {
        let mut params: [mut &Value] = copy [UNIT_VALUE ; 4us];
        params[0] = TypeCreation::createTypeID(alias context, loc, code);
        params[1] = TypeSize::validate(alias context, loc, scal);

        params[2] = TypeInfo::createArrayFromTypeInfoValues(alias context, loc, ti, []);

        let name = format("%", scal);
        params[3] = copy StringValue(loc, name);

        return copy StructInitValue(loc,
                                     type-> ti,
                                     values-> params,
                                     fields-> copy [TypeInfoKeys::ID, TypeInfoKeys::SIZE, TypeInfoKeys::INNER, TypeInfoKeys::NAME]);
    }

    /**
     * Construct the typeinfo value for a delegate type.
     *
     * @params:
     *   - context: validation context
     *   - loc:     location of the request
     *   - ti:      the TypeInfo struct type
     *   - d:       the delegate type
     *
     * @returns:
     *   - a StructInitValue describing the delegate type, including return type
     *     and parameter typeinfos
     */
    fn validateDelegateType(dmut context: &ValidationContext, loc: &Word, ti: &ClassPtrType, d: &DelegateType)-> &Value
        throws ErrorMsg
    {
        let mut params: [mut &Value] = copy [UNIT_VALUE ; 4us];
        params[0] = TypeCreation::createTypeID(alias context, loc, TypeInfoIDS::DELEGATE);
        params[1] = TypeSize::validate(alias context, loc, d);

        let name = format("%", d);
        params[3] = copy StringValue(loc, name);

        let mut inners = copy [TypeInfo::validate(alias context, loc, ti, d.retType)];
        inners ~= copy [TypeInfo::validate(alias context, loc, ti, i) for i in d.params];

        params[2] = TypeInfo::createArrayFromTypeInfoValues(alias context, loc, ti, inners);

        return copy StructInitValue(loc,
                                     type-> ti,
                                     values-> params,
                                     fields-> copy [TypeInfoKeys::ID, TypeInfoKeys::SIZE, TypeInfoKeys::INNER, TypeInfoKeys::NAME]);
    }

    /**
     * Construct the typeinfo value for a function pointer type.
     *
     * @params:
     *   - context: validation context
     *   - loc:     location of the request
     *   - ti:      the TypeInfo struct type
     *   - f:       the function pointer type
     *
     * @returns:
     *   - a StructInitValue describing the function pointer type
     */
    fn validateFuncPtrType(dmut context: &ValidationContext, loc: &Word, ti: &ClassPtrType, f: &FuncPtrType)-> &Value
        throws ErrorMsg
    {
        let mut params: [mut &Value] = copy [UNIT_VALUE ; 4us];
        params[0] = TypeCreation::createTypeID(alias context, loc, TypeInfoIDS::FPTR);
        params[1] = TypeSize::validate(alias context, loc, f);

        let name = format("%", f);
        params[3] = copy StringValue(loc, name);

        let mut inners = copy [TypeInfo::validate(alias context, loc, ti, f.retType)];
        inners ~= copy [TypeInfo::validate(alias context, loc, ti, i) for i in f.params];

        params[2] = TypeInfo::createArrayFromTypeInfoValues(alias context, loc, ti, inners);

        return copy StructInitValue(loc,
                                     type-> ti,
                                     values-> params,
                                     fields-> copy [TypeInfoKeys::ID, TypeInfoKeys::SIZE, TypeInfoKeys::INNER, TypeInfoKeys::NAME]);
    }

    /**
     * Construct the typeinfo value for an array type.
     *
     * @params:
     *   - context: validation context
     *   - loc:     location of the request
     *   - ti:      the TypeInfo struct type
     *   - a:       the array type
     *
     * @returns:
     *   - a StructInitValue describing the array type, including element typeinfo
     */
    fn validateArrayType(dmut context: &ValidationContext, loc: &Word, ti: &ClassPtrType, a: &ArrayType)-> &Value
        throws ErrorMsg
    {
        let mut params: [mut &Value] = copy [UNIT_VALUE ; 4us];
        params[0] = TypeCreation::createTypeID(alias context, loc, TypeInfoIDS::ARRAY);
        params[1] = TypeSize::validate(alias context, loc, a);

        let name = format("%", a);
        params[3] = copy StringValue(loc, name);

        params[2] = TypeInfo::createArrayFromTypeInfoValues(alias context,
                                                              loc,
                                                              ti,
                                                              copy [TypeInfo::validate(alias context, loc, ti, a.value)]);

        return copy StructInitValue(loc,
                                     type-> ti,
                                     values-> params,
                                     fields-> copy [TypeInfoKeys::ID, TypeInfoKeys::SIZE, TypeInfoKeys::INNER, TypeInfoKeys::NAME]);
    }

    /**
     * Construct the typeinfo value for a pointer type.
     *
     * @params:
     *   - context: validation context
     *   - loc:     location of the request
     *   - ti:      the TypeInfo struct type
     *   - p:       the pointer type
     *
     * @returns:
     *   - a StructInitValue describing the pointer type
     */
    fn validatePointerType(dmut context: &ValidationContext, loc: &Word, ti: &ClassPtrType, p: &PointerType)-> &Value
        throws ErrorMsg
    {
        let mut params: [mut &Value] = copy [UNIT_VALUE ; 4us];
        params[0] = TypeCreation::createTypeID(alias context, loc, TypeInfoIDS::POINTER);
        params[1] = TypeSize::validate(alias context, loc, p);


        let name = format("%", p);
        params[3] = copy StringValue(loc, name);
        params[2] = TypeInfo::createArrayFromTypeInfoValues(alias context,
                                                              loc,
                                                              ti,
                                                              copy [TypeInfo::validate(alias context, loc, ti, p.pointed)]);

        return copy StructInitValue(loc,
                                     type-> ti,
                                     values-> params,
                                     fields-> copy [TypeInfoKeys::ID, TypeInfoKeys::SIZE, TypeInfoKeys::INNER, TypeInfoKeys::NAME]);
    }

    /**
     * Construct the typeinfo value for a range type.
     *
     * @params:
     *   - context: validation context
     *   - loc:     location of the request
     *   - ti:      the TypeInfo struct type
     *   - r:       the range type
     *
     * @returns:
     *   - a StructInitValue describing the range type
     */
    fn validateRangeType(dmut context: &ValidationContext, loc: &Word, ti: &ClassPtrType, r: &RangeType)-> &Value
        throws ErrorMsg
    {
        let mut params: [mut &Value] = copy [UNIT_VALUE ; 4us];
        params[0] = TypeCreation::createTypeID(alias context, loc, TypeInfoIDS::RANGE);
        params[1] = TypeSize::validate(alias context, loc, r);

        let name = format("%", r);
        params[3] = copy StringValue(loc, name);

        params[2] = TypeInfo::createArrayFromTypeInfoValues(alias context,
                                                              loc,
                                                              ti,
                                                              copy [TypeInfo::validate(alias context, loc, ti, r.start)]);

        return copy StructInitValue(loc,
                                     type-> ti,
                                     values-> params,
                                     fields-> copy [TypeInfoKeys::ID, TypeInfoKeys::SIZE, TypeInfoKeys::INNER, TypeInfoKeys::NAME]);
    }

    /**
     * Construct the typeinfo value for a slice type.
     *
     * @params:
     *   - context: validation context
     *   - loc:     location of the request
     *   - ti:      the TypeInfo struct type
     *   - s:       the slice type
     *
     * @returns:
     *   - a StructInitValue describing the slice type
     */
    fn validateSliceType(dmut context: &ValidationContext, loc: &Word, ti: &ClassPtrType, s: &SliceType)-> &Value
        throws ErrorMsg
    {
        let mut params: [mut &Value] = copy [UNIT_VALUE ; 4us];
        params[0] = TypeCreation::createTypeID(alias context, loc, TypeInfoIDS::SLICE);
        params[1] = TypeSize::validate(alias context, loc, s);

        let name = format("%", s);
        params[3] = copy StringValue(loc, name);

        params[2] = TypeInfo::createArrayFromTypeInfoValues(alias context,
                                                              loc,
                                                              ti,
                                                              copy [TypeInfo::validate(alias context, loc, ti, s.value)]);

        return copy StructInitValue(loc,
                                     type-> ti,
                                     values-> params,
                                     fields-> copy [TypeInfoKeys::ID, TypeInfoKeys::SIZE, TypeInfoKeys::INNER, TypeInfoKeys::NAME]);
    }

    /**
     * Construct the typeinfo value for a map type.
     *
     * @params:
     *   - context: validation context
     *   - loc:     location of the request
     *   - ti:      the TypeInfo struct type
     *   - m:       the map type
     *
     * @returns:
     *   - a StructInitValue describing the map type, including key and value typeinfos
     */
    fn validateMapType(dmut context: &ValidationContext, loc: &Word, ti: &ClassPtrType, m: &MapType)-> &Value
        throws ErrorMsg
    {
        let mut params: [mut &Value] = copy [UNIT_VALUE ; 4us];
        params[0] = TypeCreation::createTypeID(alias context, loc, TypeInfoIDS::MAP);
        params[1] = TypeSize::validate(alias context, loc, m);

        let name = format("%", m);
        params[3] = copy StringValue(loc, name);

        let inners = copy [TypeInfo::validate(alias context, loc, ti, m.key),
                           TypeInfo::validate(alias context, loc, ti, m.value)];

        params[2] = TypeInfo::createArrayFromTypeInfoValues(alias context, loc, ti, inners);

        return copy StructInitValue(loc,
                                     type-> ti,
                                     values-> params,
                                     fields-> copy [TypeInfoKeys::ID, TypeInfoKeys::SIZE, TypeInfoKeys::INNER, TypeInfoKeys::NAME]);
    }

    /**
     * Construct the typeinfo value for a tuple type.
     *
     * @params:
     *   - context: validation context
     *   - loc:     location of the request
     *   - ti:      the TypeInfo struct type
     *   - t:       the tuple type
     *
     * @returns:
     *   - a StructInitValue describing the tuple type, including element typeinfos
     */
    fn validateTupleType(dmut context: &ValidationContext, loc: &Word, ti: &ClassPtrType, t: &TupleType)-> &Value
        throws ErrorMsg
    {
        let mut params: [mut &Value] = copy [UNIT_VALUE ; 4us];
        params[0] = TypeCreation::createTypeID(alias context, loc, TypeInfoIDS::TUPLE);
        params[1] = TypeSize::validate(alias context, loc, t);

        let name = format("%", t);
        params[3] = copy StringValue(loc, name);
        let mut inners = copy [TypeInfo::validate(alias context, loc, ti, i) for i in t.inners];

        params[2] = TypeInfo::createArrayFromTypeInfoValues(alias context, loc, ti, inners);

        return copy StructInitValue(loc,
                                     type-> ti,
                                     values-> params,
                                     fields-> copy [TypeInfoKeys::ID, TypeInfoKeys::SIZE, TypeInfoKeys::INNER, TypeInfoKeys::NAME]);
    }

    /**
     * Construct the typeinfo value for a class pointer type.
     *
     * Structs are handled as class references.
     *
     * @params:
     *   - context: validation context
     *   - loc:     location of the request
     *   - ti:      the TypeInfo struct type
     *   - c:       the class pointer type
     *
     * @returns:
     *   - a StructInitValue describing the class pointer type
     */
    fn validateClassPtrType(dmut context: &ValidationContext, loc: &Word, ti: &ClassPtrType, c: &ClassPtrType)-> &Value
        throws ErrorMsg
    {
        if (c.sym.isStruct)
            return TypeInfo::validateClassRefType(alias context, loc, ti, c.inner);

        let mut params: [mut &Value] = copy [UNIT_VALUE ; 4us];
        params[0] = TypeCreation::createTypeID(alias context, loc, TypeInfoIDS::OBJECT);
        params[1] = TypeSize::validate(alias context, loc, c);

        let name = format("%", c);
        params[3] = copy StringValue(loc, name);

        params[2] = TypeInfo::createArrayFromTypeInfoValues(alias context,
                                                              loc,
                                                              ti,
                                                              copy [TypeInfo::validate(alias context, loc, ti, c.inner)]);

        return copy StructInitValue(loc,
                                     type-> ti,
                                     values-> params,
                                     fields-> copy [TypeInfoKeys::ID, TypeInfoKeys::SIZE, TypeInfoKeys::INNER, TypeInfoKeys::NAME]);
    }

    /**
     * Return the precomputed typeinfo for a class reference type.
     *
     * @params:
     *   - c: the class reference type
     *
     * @returns:
     *   - the typeinfo value stored in the class symbol
     */
    fn validateClassRefType(dmut _: &ValidationContext, _: &Word, _: &ClassPtrType, c: &ClassRefType)-> &Value {
        c.typeInfo
    }

    /**
     * Construct the typeinfo value for an option type.
     *
     * @params:
     *   - context: validation context
     *   - loc:     location of the request
     *   - ti:      the TypeInfo struct type
     *   - o:       the option type
     *
     * @returns:
     *   - a StructInitValue describing the option type
     */
    fn validateOptionType(dmut context: &ValidationContext, loc: &Word, ti: &ClassPtrType, o: &OptionType)-> &Value
        throws ErrorMsg
    {
        let mut params: [mut &Value] = copy [UNIT_VALUE ; 4us];
        params[0] = TypeCreation::createTypeID(alias context, loc, TypeInfoIDS::OPTION);
        params[1] = TypeSize::validate(alias context, loc, o);

        let name = format("%", o);
        params[3] = copy StringValue(loc, name);

        params[2] = TypeInfo::createArrayFromTypeInfoValues(alias context, loc, ti,
                                                              copy [TypeInfo::validate(alias context, loc, ti, o.wrapped)]);

        return copy StructInitValue(loc,
                                     type-> ti,
                                     values-> params,
                                     fields-> copy [TypeInfoKeys::ID, TypeInfoKeys::SIZE, TypeInfoKeys::INNER, TypeInfoKeys::NAME]);
    }

    /**
     * Construct a slice of typeinfo values from a list of typeinfo values.
     *
     * Creates:
     *   - an array of typeinfo values,
     *   - a pointer to that array,
     *   - a slice constructor,
     *   - and a CopierValue to produce the final slice.
     *
     * @params:
     *   - loc:    location of the construction
     *   - ti:     the TypeInfo struct type
     *   - values: the list of typeinfo values to embed
     *
     * @returns:
     *   - a slice value containing the provided typeinfo values
     */
    fn createArrayFromTypeInfoValues(dmut _: &ValidationContext, loc: &Word, ti: &ClassPtrType, values: [&Value])-> &Value
        throws ErrorMsg
    {
        let arrType = copy ArrayType(loc, ti, values.len, isMutable-> false);
        let arrVal = copy ArrayValue(loc, arrType, values);

        let slcType = copy SliceType(loc, ti, isMutable-> false);
        let addr = copy AddressValue(loc,
                                      copy PointerType(loc, ti, isMutable-> false),
                                      arrVal);

        let ctor = copy SliceCtorValue(loc,
                                        type-> slcType,
                                        ptr-> addr,
                                        blk-> copy NullValue(loc), // no need for blk info, slice is copied
                                        len-> copy IntValue(loc, USIZE_TYPE, values.len),
                                        isImplicitAlias-> true);

        return copy CopierValue(loc, slcType, ctor, isDeep-> false);
    }

    /*!
     * ================================================================================
     * ================================================================================
     * =======================            FIELD INFOS             =====================
     * ================================================================================
     * ================================================================================
     */

    /**
     * Construct the fieldinfo array for a class type.
     *
     * Applies access rules(private/protected) based on the current referent.
     *
     * @params:
     *   - context: validation context
     *   - loc:     location of the request
     *   - fi:      the FieldInfo struct type
     *   - c:       the class reference type
     *
     * @returns:
     *   - an ArrayValue containing field metadata(name, offset, size)
     */
    fn validateFieldInfoClass(dmut context: &ValidationContext, loc: &Word, fi: &ClassPtrType, c: &ClassRefType)-> &Value
        throws ErrorMsg
    {
        let (inPrv, inProt) = context.getCurrentClassReferentProtections(c);
        let sizes = TypeSize::computeSizeAndAligns(alias context, loc, c);
        let offset = if (c.sym.isStruct) { 0us } else {
            (c.fields.len - c.localFields.len) + 2us // vtable, monitor, and ancestor fields
        };

        let mut values: [mut &Value] = [];

        for i, field in c.localFields {
            let canAccess = if (c.sym.isFieldPrivate(field.loc.str)) { inPrv }
            else if (c.sym.isFieldProtected(field.loc.str)) { inProt || inPrv }
            else { true };

            if (canAccess) {
                values ~= [copy StructInitValue(loc,
                                                 type-> fi,
                                                 values-> copy [copy StringValue(loc, field.loc.str),
                                                                copy IntValue(loc, USIZE_TYPE, sizes[i + offset].0),
                                                                copy IntValue(loc, USIZE_TYPE, sizes[i + offset].1)],
                                                 fields-> copy [TypeInfoKeys::NAME, TypeInfoKeys::OFFSET, TypeInfoKeys::SIZE])];
            }
        }

        let arrType = copy ArrayType(loc, fi, values.len, isMutable-> false);
        copy ArrayValue(loc, arrType, values)
    }

    /**
     * Construct the fieldinfo array for a tuple type.
     *
     * Tuple fields have no names; offsets and sizes are computed from layout.
     *
     * @params:
     *   - context: validation context
     *   - loc:     location of the request
     *   - fi:      the FieldInfo struct type
     *   - t:       the tuple type
     *
     * @returns:
     *   - an ArrayValue containing field metadata for each tuple element
     */
    fn validateFieldInfoTuple(dmut context: &ValidationContext, loc: &Word, fi: &ClassPtrType, t: &TupleType)-> &Value
        throws ErrorMsg
    {
        let sizes = TypeSize::computeSizeAndAligns(alias context, loc, t);
        let mut values: [&Value] = [];
        for size in sizes {
            values ~= [copy StructInitValue(loc,
                                             type-> fi,
                                             values-> copy [copy StringValue(loc, ""),
                                                            copy IntValue(loc, USIZE_TYPE, size._0),
                                                            copy IntValue(loc, USIZE_TYPE, size._1)],
                                             fields-> copy [TypeInfoKeys::NAME, TypeInfoKeys::OFFSET, TypeInfoKeys::SIZE])];
        }

        let arrType = copy ArrayType(loc, fi, values.len, isMutable-> false);
        copy ArrayValue(loc, arrType, values)
    }



}
