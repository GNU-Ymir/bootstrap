/*
 * This file defines the semantic rules used to verify relationships between
 * types during compilation. It is part of the core validator subsystem and is
 * responsible for enforcing:
 *
 *   - trait implementation rules,
 *   - class inheritance and ancestor relationships,
 *   - enum proxy and super-proxy semantics,
 *   - compatibility rules for native compound types(array, slice, tuple, map, option),
 *   - completeness checks for types and values,
 *   - and general implicit-cast compatibility between types.
 *
 * The functions in this module operate on fully resolved types and values
 * produced by the resolver. They do not perform name lookup; instead, they
 * validate structural and semantic correctness of type usage in expressions,
 * declarations, and casts.
 *
 * Errors produced here are fatal and include detailed notes to help the user
 * understand the origin of incompatible or incomplete types.
 *
 * This module is used throughout the validator to ensure that the Ymir type
 * system remains sound, predictable, and consistent across all language
 * constructs.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::type::verif
 * @File: ymirc/semantic/validator/type/verif.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-03-21
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in verif;

use ymirc::lexing::word;
use ymirc::semantic::{symbol, validator, generator::{value::_, type::_}};
use ymirc::errors;

use ymirc::utils::format;

/**
 * The TypeVerification module provides semantic checks related to:
 *   - trait implementation,
 *   - class ancestry and inheritance,
 *   - proxy and enum-proxy compatibility,
 *   - slice and compound-type compatibility,
 *   - completeness rules for types and values,
 *   - and general type-compatibility validation.
 *
 * These functions are used throughout the semantic validator to ensure that
 * types used in expressions, declarations, and casts follow the structural and
 * inheritance rules of the Ymir type system.
 *
 */
pub mod TypeVerification {

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          IMPLEMENTS          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Verify that a class implements a given trait.
     *
     * This function accepts both ClassPtrType and ClassRefType on the left. If
     * the right type is not a trait, or if the class does not implement the
     * trait, a fatal error is thrown.
     *
     * @params:
     *    - loc:   the location of the `implements` expression
     *    - left:  the class type(ptr or ref)
     *    - right: the trait reference type
     *
     * @throws:
     *    - &ErrorMsg: if `right` is not a trait or if the class does not implement it
     *
     */
    pub fn verifyImplement(loc: &Word, left: &Type, right: &Type)
        throws ErrorMsg
    {
        if (right !of TraitRefType) {
            throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::NOT_A_TRAIT, right));
        }

        let lInner: &ClassRefType = match left { // This function is made to work with classptr and classref
            c: &ClassPtrType => { c.inner }
            c: &ClassRefType => { c }
            _ => {
                throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::NOT_A_CLASS, left));
            }
        };

        for im in lInner.allImplementedTraits {
            if (im == right) return;
        }

        throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::CLASS_NOT_IMPL, lInner, right));
    }

    /**
     * Test whether a class implements a given trait.
     *
     * @returns:
     *    - true  if `left` implements `right`
     *    - false otherwise
     */
    pub fn isImplement(left: &Type, right: &Type)-> bool
        throws ErrorMsg
    {
        if (right !of TraitRefType) {
            return false;
        }

        let lInner: &ClassRefType = match left { // This function is made to work with classptr and classref
            c: &ClassPtrType => { c.inner }
            c: &ClassRefType => { c }
            _ => {
                return false;
            }
        };

        for im in lInner.allImplementedTraits {
            if (im == right) return true;
        }

        false
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          ANCESTOR          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Verify that `left` is an ancestor of `right`.
     *
     * This checks class inheritance(not trait implementation). Both
     * ClassPtrType and ClassRefType are accepted.
     *
     * @throws:
     *    - &ErrorMsg: if `left` is not an ancestor of `right`
     *
     */
    pub fn verifyAncestor(loc: &Word, left: &Type, right: &Type)
        throws ErrorMsg
    {
        if (!TypeVerification::isAncestor(left, right)) {
            throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::NOT_ANCESTOR, left, right));
        }
    }

    /**
     * Test whether `left` is an ancestor of `right`.
     *
     * This walks the ancestor chain of `right` and checks whether `left`
     * appears anywhere in the hierarchy.
     *
     * @returns:
     *    - true  if `left` is an ancestor of `right`
     *    - false otherwise
     *
     */
    pub fn isAncestor(left: &Type, right: &Type)-> bool
        throws ErrorMsg
    {
        let rInner: &ClassRefType = match right { // This function is made to work with classptr and classref
            c: &ClassPtrType => { c.inner }
            c: &ClassRefType => { c }
            _ => { return false; }
        };

        let lInner: &ClassRefType = match left { // This function is made to work with classptr and classref
            c: &ClassPtrType => { c.inner }
            c: &ClassRefType => { c }
            _ => { return false; }
        };

        let mut ancestor = rInner.ancestor;
        while let Ok(c) = ancestor { // we traverse the ancestor of right
            if (c == lInner) { return true; } // if one of the ancestor of right is equal to left, then left is an ancestor of right
            ancestor = c.ancestor; // else we go up again
        }

        false
    }

    /**
     * Test whether two types refer to the exact same class type.
     *
     * This accepts both ClassPtrType and ClassRefType and compares their
     * underlying class symbols.
     *
     * @returns:
     *    - true  if both refer to the same class
     *    - false otherwise
     */
    pub fn isDirectInstance(left: &Type, right: &Type)-> bool
        throws ErrorMsg
    {
        let rInner: &ClassRefType = match right {
            c: &ClassPtrType => { c.inner }
            c: &ClassRefType => { c }
            _ => { return false; }
        };

        let lInner: &ClassRefType = match left { // This function is made to work with classptr and classref
            c: &ClassPtrType => { c.inner }
            c: &ClassRefType => { c }
            _ => { return false; }
        };

        return (lInner == rInner);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          PROXY          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Test whether `right` is an enum type that proxies a value implicitly
     * castable to `left`.
     *
     * This attempts a compatibility check between `left` and the enum's proxy
     * type. If the check succeeds, the enum is considered a proxy.
     *
     * @returns:
     *    - true  if `right` is a proxy enum compatible with `left`
     *    - false otherwise
     */
    pub fn isProxy(left: &Type, right: &Type)-> bool {
        match right {
            re: &EnumType => {
                {
                    TypeVerification::verifyCompatible(left.loc, re.loc, left, re.proxy);
                    true
                } catch {
                    _ => {
                        false
                    }
                }
            }
            _ => {
                false
            }
        }
    }

    /**
     * Test whether a value is a proxy to the superclass.
     *
     * This detects SuperProxyValue and recursively unwraps ClassAliaserValue to
     * find nested proxies.
     *
     * @returns:
     *    - true  if the value represents a super-class proxy
     *    - false otherwise
     */
    pub fn isSuperProxy(value: &Value)-> bool {
        match value {
            SuperProxyValue() => { true }
            c: &ClassAliaserValue => {
                TypeVerification::isSuperProxy(c.value)
            }
            _ => {
                false
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          SLICES          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Test whether a type is a slice whose element type is void.
     *
     * @returns:
     *    - true  if the type is SliceType(void)
     *    - false otherwise
     *
     */
    fn isVoidSlice(type: &Type)-> bool {
        match type {
            s: &SliceType => {
                s.value of VoidType
            }
            _ => { false }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          COMPLETENESS          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Verify that a type is complete and non-void for use in a variable
     * declaration.
     *
     * Lambda types are allowed only when constructing a new variable.
     *
     * @throws:
     *    - &ErrorMsg: if the type is void, incomplete, or not addressable
     *
     */
    pub fn verifyNonVoid(loc: &Word, type: &Type, construct: bool)
        throws ErrorMsg
    {
        TypeVerification::verifyComplete(loc, type, construct);
        if (type of LambdaType && construct) return;
        if (!type.isAddressable) {
            throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::DECLARE_VOID_VAR, type));
        }

        if (type of VoidType) {
            throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::DECLARE_VOID_VAR, type));
        }
    }

    /**
     * Verify that a type is complete and can be used inside another type or to
     * create a value.
     *
     * TemporaryType indicates an incomplete type. ClassRefType is allowed
     * only for structs; non-struct class references are incomplete.
     *
     * @params:
     *    - loc:       the location of the use
     *    - type:      the type to check
     *    - construct: true if this is a variable creation(lambda allowed)
     *
     * @throws:
     *    - &ErrorMsg: if the type is incomplete or invalid in this context
     *
     */
    pub fn verifyComplete(loc: &Word, type: &Type, construct: bool)
        throws ErrorMsg
    {
        if (type of LambdaType && construct) return;
        if (type of TemporaryType) {
            let endLoc = if (!loc.isSameLoc(type.loc) && !type.loc.isEof) {
                type.loc
            } else { EOF_WORD };

            match (type) {
                cl: &ClassRefType => {
                    if (!cl.sym.isStruct) {
                        let notes = copy [copy ErrorMsg::note(loc, format(ValidateErrorMessage::FORGET_AND_CLASS), oneLine-> true)];
                        throw copy ErrorMsg::fatal(loc, end-> endLoc, format(ValidateErrorMessage::INCOMPLETE_TYPE_CLREF, type), notes-> notes);
                    }
                }
            }

            throw copy ErrorMsg::fatal(loc, end-> endLoc, format(ValidateErrorMessage::INCOMPLETE_TYPE, type));
        }
    }

    /**
     * Verify that a type is complete and that a value of that type can be
     * created at the given location.
     *
     * This also validates that method delegates and prototypes are used
     * correctly(i.e., not implicitly addressed).
     *
     * @throws:
     *    - &ErrorMsg: if the type is incomplete or if the value is invalid
     *
     */
    pub fn verifyCompleteWithValue(loc: &Word, valueLoc: &Word = EOF_WORD, type: &Type, value: &Value, construct: bool)
        throws ErrorMsg
    {
        let endLoc = if valueLoc.isEof { value.loc } else { valueLoc };
        match value {
            m: &MethodDelegateValue => {
                if (!m.isAddressed) {
                    throw copy ErrorMsg::fatal(loc, end-> endLoc, format(ValidateErrorMessage::IMPLICIT_ADDRESS_METHOD, m, tags-> FormatTags(withParams-> true)),
                                                notes-> copy [copy ErrorMsg::note(loc, format(ValidateErrorMessage::FORGET_PAR_PROTO_CALL, "()"), oneLine-> true),
                                                              copy ErrorMsg::note(loc, format(ValidateErrorMessage::FORGET_AND_PROTO), oneLine-> true)]);
                }
            }
            p: &PrototypeValue => {
                throw copy ErrorMsg::fatal(loc, end-> endLoc, format(ValidateErrorMessage::IMPLICIT_ADDRESS_FUNCTION, p, tags-> FormatTags(withParams-> true)),
                                            notes-> copy [copy ErrorMsg::note(loc, format(ValidateErrorMessage::FORGET_PAR_PROTO_CALL, "()"), oneLine-> true),
                                                          copy ErrorMsg::note(loc, format(ValidateErrorMessage::FORGET_AND_PROTO), oneLine-> true)]);
            }
        }

        {
            TypeVerification::verifyComplete(loc, type, construct);
        } catch {
            err: &ErrorMsg => {
                throw err.withNote(copy [copy ErrorMsg::note(endLoc, format(ValidateErrorMessage::WHEN_CREATING_VALUE, value))]);
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          COMPATIBILITY          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Verify that two types are compatible for an implicit cast.
     *
     * Compatibility includes:
     *   - direct compatibility via isCompatible(),
     *   - enum proxy compatibility,
     *   - ancestor relationships(unless disabled),
     *   - compatibility inside native compound types(array, slice, tuple,
     *     map, option).
     *
     * @params:
     *    - lLoc:       location of the left operand
     *    - rLoc:       location of the right operand
     *    - left:       target type
     *    - right:      source type
     *    - noAncestor: if true, ancestor casts are forbidden
     *
     * @throws:
     *    - &ErrorMsg: if the types are not compatible
     *
     */
    pub fn verifyCompatible(lLoc: &Word, rLoc: &Word, left: &Type, right: &Type, noAncestor: bool = false)
        throws ErrorMsg
    {
        if (!left.isCompatible(right)) {
            let mut innerErr: [mut &ErrorMsg] = [];
            {
                if (TypeVerification::isProxy(left, right)) return;
                if (!noAncestor) {
                    if (TypeVerification::isAncestor(left, right)) return;;
                    if (TypeVerification::verifyAncestorCompatibleInNativeCompound(left, right)) return;
                } else {
                    if (TypeVerification::isAncestor(left, right)) {
                        throw copy ErrorMsg::fatal(lLoc, end-> rLoc, format(ValidateErrorMessage::CANNOT_CASTTO_BASE_CLASS, right, left));
                    }
                }
            } catch {
                err: &ErrorMsg => {
                    innerErr ~= [err];
                }
            }

            if (lLoc.line == rLoc.line) {
                throw copy ErrorMsg::fatal(lLoc, end-> rLoc, format(ValidateErrorMessage::INCOMPATIBLE_TYPE, left, right), notes-> innerErr);
            } else {
                innerErr ~= [copy ErrorMsg::note(lLoc, "")];
                throw copy ErrorMsg::fatal(rLoc, format(ValidateErrorMessage::INCOMPATIBLE_TYPE, left, right), notes-> innerErr);
            }
        }
    }

    /**
     * Verify compatibility of native compound types(array, slice, tuple, map,
     * option) based on compatibility of their inner types.
     *
     * This allows implicit casts such as:
     *   - [&A] <= [&B] if B is a subclass of A
     *   - [A; N] <= [B; N] under the same rule
     *   - (A, B) <= (C, D) if each element is compatible
     *
     * @returns:
     *    - true  if both types are native compound types and compatible
     *    - false if they are not compound types
     *
     * @throws:
     *    - &ErrorMsg: if the compound types match structurally but their
     *                 inner types are incompatible
     */
    fn verifyAncestorCompatibleInNativeCompound(left: &Type, right: &Type, noAncestor: bool = false)-> bool
        throws ErrorMsg
    {
        match (left, right) {
            (lArr: &ArrayType, rArr: &ArrayType) => { // [&A ; 4] <= [&B ; 4] iif B over A
                if (lArr.len == rArr.len) {
                    let innerLeft = lArr.value;
                    let innerRight = rArr.value;
                    TypeVerification::verifyCompatible(innerLeft.loc, innerRight.loc, innerLeft, innerRight, noAncestor-> noAncestor);

                    return true;
                }
            }
            (lSlc: &SliceType, rSlc: &SliceType) => { // [&A] <= [&B] iif B over A
                let innerLeft = lSlc.value;
                let innerRight = rSlc.value;
                TypeVerification::verifyCompatible(innerLeft.loc, innerRight.loc, innerLeft, innerRight, noAncestor-> noAncestor);

                return true;
            }
            (lTu: &TupleType, rTu: &TupleType) => {
                if (lTu.inners.len == rTu.inners.len) { // (&A,) <= (&B,) iif B over A
                    for i in 0us .. lTu.inners.len {
                        let innerLeft = lTu.inners[i];
                        let innerRight = rTu.inners[i];
                        TypeVerification::verifyCompatible(innerLeft.loc, innerRight.loc, innerLeft, innerRight, noAncestor-> noAncestor);
                    }

                    return true;
                }
            }
            (lMT: &MapType, rMT: &MapType) => {
                let innerKeyLeft = lMT.key;
                let innerKeyRight = rMT.key;
                TypeVerification::verifyCompatible(innerKeyLeft.loc, innerKeyRight.loc, innerKeyLeft, innerKeyRight, noAncestor-> noAncestor);

                let innerValLeft = lMT.value;
                let innerValRight = rMT.value;
                TypeVerification::verifyCompatible(innerValLeft.loc, innerValRight.loc, innerValLeft, innerValRight, noAncestor-> noAncestor);

                return true;
            }
            (lo: &OptionType, ro: &OptionType) => {
                let innerLeft = lo.wrapped;
                let innerRight = ro.wrapped;

                TypeVerification::verifyCompatible(innerLeft.loc, innerRight.loc, innerLeft, innerRight, noAncestor-> noAncestor);

                return true;
            }
        }

        return false;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          MUTABILITIES          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Verifies the semantics of the type of a iterator var decl.
     *
     * @params:
     *   - loc:   location of the mutable iterator
     *   - type:  type of the iterator being verified
     *
     * @returns:
     *   None
     *
     * @throws:
     *   ErrorMsg if the iterator type is mutable but does not require an explicit alias and is not movable.
     */
    pub fn verifyMutableIterator(loc: &Word, type: &Type, isRef: bool)
        throws ErrorMsg
    {
        if type.isMutable && !type.needsExplicitAlias && !type.isMovable && !isRef {
            throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::MUTABLE_CONST_ITERATOR));
        }
    }

    /**
     * Verifies the semantics of a the type of a parameter var decl.
     *
     * @params:
     *   - loc:   location of the mutable iterator
     *   - type:  type of the param being verified
     *
     * @returns:
     *   None
     *
     * @throws:
     *   ErrorMsg if the param type is mutable but does not require an explicit alias and is not movable.
     */
    pub fn verifyMutableParam(loc: &Word, type: &Type, isRef: bool)
        throws ErrorMsg
    {
        if type.isMutable && !type.needsExplicitAlias && !type.isMovable && !isRef {
            throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::MUTABLE_CONST_PARAM));
        }
    }

    /**
     * Verifies the semantics of a the type of a lazy global var decl.
     *
     * @params:
     *   - loc:   location of the mutable iterator
     *   - type:  type of the iterator being verified
     *
     * @returns:
     *   None
     *
     * @throws:
     *   ErrorMsg if the lazy type is mutable but does not require an explicit alias
     */
    pub fn verifyMutableGlobal(loc: &Word, type: &Type, isLazy: bool)
        throws ErrorMsg
    {
        if isLazy && type.isMutable && !type.needsExplicitAlias {
            throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::MUTABLE_LAZY_VAR));
        }
    }
}
