in infer;


use ymirc::lexing::word;
use ymirc::semantic::{symbol, validator};
use ymirc::semantic::generator::{mangler, value::_, type::_};

use ymirc::errors::message;

use ymirc::utils::format;

/**
 * TypeInference module
 *
 * This module provides the inference rules used to adapt values to types and
 * unify types across branching constructs. It centralizes:
 *
 *   - implicit cast inference,
 *   - reference inference for immutable targets,
 *   - branching type unification,
 *   - lambda inference from function/delegate types,
 *   - and class‑ancestor resolution.
 *
 * All functions assume that basic type validation has already been performed.
 * Their purpose is to infer the correct value form or resulting type required
 * by the surrounding expression.
 * 
 */
pub mod TypeInference {

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          IMPLICIT CAST          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */
    
    /**
     * Verify that a value is compatible with a target type, optionally by reference.
     *
     * If `byReference` is true:
     *   - If the value is not already a ReferencerValue and the target type is immutable,
     *     the function retries the check without `byReference` and, if allowed, wraps the
     *     result in a ReferencerValue.
     *   - Otherwise, compatibility is checked directly with no ancestor casting allowed.
     *
     * If `byReference` is false:
     *   - The value is implicitly cast to the target type via CastValidation.
     *
     * @params:
     *   - context:     validation context
     *   - loc:         location of the cast or assignment
     *   - type:        target type
     *   - value:       source value
     *   - byReference: true if the value should be taken by reference
     *
     * @returns: the validated (and possibly implicitly cast or referenced) value
     * @throws:
     *    - ErrorMsg if the value cannot be made compatible with the type
     */
    pub fn inferValueForType (dmut context: &ValidationContext,
                              loc:          &Word,
                              value:        &Value,
                              type:         &Type,                              
                              byReference:  bool)-> &Value
        throws ErrorMsg
    {
        if (!byReference) {
            return CastValidation::validateImplicit (alias context, loc, value, type);
        }
        
        if (value !of ReferencerValue && !type.isMutable) {
            let inner = TypeInference::inferValueForType (alias context, loc, value, type-> type, byReference-> false);
            if (!MemoryVerification::checkLeftOperandMove (inner, allowImmutable-> true, allowSelf-> true)) {
                return inner;
            } else {
                return copy ReferencerValue (value.loc, inner.type, inner, isMutable-> false);
            }
        }
        
        TypeVerification::verifyCompatible (loc, value.loc, type, value.type, noAncestor-> true);
        return value;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          BRANCH          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */
    
    /**
     * Infer a common type for two branch values and return both values cast to it.
     *
     * Attempts unification by casting to the left type first; if that fails,
     * attempts unification by casting to the right type. If both fail,
     * aggregates both errors.
     *
     * @params:
     *   - context: validation context
     *   - loc:     location of the branching expression
     *   - left:    left branch value
     *   - right:   right branch value
     *
     * @returns:
     *   - .0: the inferred common type
     *   - .1: `left` cast or adapted to .0
     *   - .2: `right` cast or adapted to .0
     *
     * @throws:
     *   - ErrorMsg if no common type can be inferred
     */
    pub fn inferValuesForBranch (dmut context: &ValidationContext, loc: &Word, left: &Value, right: &Value)-> (&Type, &Value, &Value)
        throws ErrorMsg
    {
        { // try by casting to left
            let (t1, resLeft) = TypeInference::inferValueForBranch (alias context, loc, NONE_TYPE, left);
            let (t2, resRight) = TypeInference::inferValueForBranch (alias context, loc, t1, right);

            return (t2, resLeft, resRight);
        } catch {
            lerr: &ErrorMsg => {
                { // try by casting to right
                    let (t1, resRight) = TypeInference::inferValueForBranch (alias context, loc, NONE_TYPE, right);
                    let (t2, resLeft) = TypeInference::inferValueForBranch (alias context, loc, t1, left);

                    return (t2, resLeft, resRight);
                } catch {
                    err: &ErrorMsg => {
                        throw copy ErrorMsg::list (copy [lerr, err]);
                    }
                }
            }
        }
    }

    /**
     * Infer a compatible type for a branch value given a previously inferred type.
     *
     * @params:
     *   - context: validation context
     *   - loc:     location of the branch
     *   - oldType: previously inferred type (or NoneType for first branch)
     *   - val:     the branch value to adapt
     *
     * @returns:
     *   - .0: the updated inferred type after considering `val`
     *   - .1: `val` cast or adapted to .0
     *
     * @throws:
     *   - ErrorMsg if no compatible type can be inferred
     */
    pub fn inferValueForBranch (dmut context: &ValidationContext, loc: &Word, oldType: &Type, val: &Value)-> (&Type, &Value)
        throws ErrorMsg
    {
        let v = {
            TypeInference::inferValueForType (alias context, loc, type-> oldType, value-> val, byReference-> false)
        } catch {
            _ => { val }
        };

        let ret = TypeInference::inferBranching (loc, val.loc, oldType, v.type);

        let value = TypeInference::inferValueForType (alias context, loc, type-> ret, value-> v, byReference-> false);
        let finRet = TypeInference::inferImplicitMutability (ret, value);
        (finRet, value)
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          LAMBDA          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */
    
    /**
     * Infer a lambda value from a function or delegate type.
     *
     * @params:
     *   - context: validation context
     *   - type:    expected function or delegate type
     *   - val:     value that should contain or reference a lambda
     *
     * @returns:
     *   - the validated lambda prototype, ready for code generation
     *
     * @throws:
     *   - ErrorMsg if no lambda is found or if the lambda cannot match `type`
     */
    pub fn inferLambdaValue (dmut context: &ValidationContext, type: &Type, val: &Value)-> &Value
        throws ErrorMsg
    {
        let innerVal = match val {
            v: &VarRefValue => { v.value } // The lambda value can be hidden in a variable
            _ => { val }
        };
        
        if let lmbd: &LambdaValue = innerVal {
            let paramTypes = match type {
                f: &FuncPtrType  => { f.params }
                d: &DelegateType => { d.params }                
                _ => {
                    // The lambda value was found, but the result cannot be infered
                    throw copy ErrorMsg::fatal (val.loc, format (ValidateErrorMessage::INCOMPATIBLE_TYPE, type, val.type));
                } 
            }
            
            if (lmbd.params.len != paramTypes.len) {
                throw copy ErrorMsg::fatal (val.loc, format (ValidateErrorMessage::INCOMPATIBLE_TYPE, type, val.type));
            }
            
            // Validate the lambda from the parameters of  'type'
            let (proto, frame) = LambdaValidation::validateBody (alias context, lmbd, paramTypes);
            let name = Mangler::mangle (frame);
            if !context.hasCustomGenerator (name) {
                context:.insertNamedGenerator (name, alias context.referent, frame);
            }
            
            return proto;
        }

        // The lambda value was not found
        throw copy ErrorMsg::fatal (val.loc, format (ValidateErrorMessage::INCOMPATIBLE_TYPE, type, val.type));        
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          CLASS ANCESTOR          =================================
     * ====================================================================================================
     * ====================================================================================================
     */
    
    /**
     * Infer the nearest common ancestor class between two class pointer types.
     *
     * @params:
     *   - loc:   location of the inference
     *   - left:  first class pointer type
     *   - right: second class pointer type
     *
     * @returns:
     *   - Ok(ClassPtrType) if a common ancestor exists
     *   - `none` otherwise
     */
    fn inferCommonAncestor (loc: &Word, left: &ClassPtrType, right: &ClassPtrType)-> (&Type)?
    throws ErrorMsg
    {
        let mut ancestor: (&ClassRefType)? = (left.inner)?;

        // We traverse the list of ancestor of the left
        while let Ok (c) =  ancestor {
            // if one of the ancestor of left is also an ancestor of right, then it is a common ancestor
            if (TypeVerification::isAncestor (c, right)) {
                return (c.createInstance (loc-> loc, isMutable-> false, isInnerMutable-> false))?;
            }

            ancestor = c.ancestor;
        }

        none
    }
    
    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ================================          INNER BRANCHING          =================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Infer a common type for two branch types.
     *
     * Handles:
     *   - identical types with mutability reconciliation,
     *   - slices, tuples, options, pointers, class pointers,
     *   - enum proxies,
     *   - and fallback to error if no common type exists.
     *
     * @params:
     *   - lloc:  location of the left branch
     *   - rloc:  location of the right branch
     *   - left:  type of the left branch
     *   - right: type of the right branch
     *
     * @returns:
     *   - the unified type that both branches can be cast to without explicit cast
     *
     * @throws:
     *   - ErrorMsg if no common type can be inferred
     */
    pub fn inferBranching (lloc: &Word, rloc: &Word, left: &Type, right: &Type)-> &Type
        throws ErrorMsg
    {
        if (left of NoneType) return right;

        if (left == right) {
            if (!left.mutabilityFit (right)) return left; // mutability of right is higher than the one of left, e.g. l = [i32], r = mut [mut i32]
            else return right; // left.mutabilityFit (right), e.g. l = mut [mut i32], r = [i32] or r = mut [mut i32]
        }
        
        match (left, right) {
            (slc: &SliceType, rslc: &SliceType) => {
                return TypeInference::inferBranchingSlices (lloc, rloc, slc, rslc);
            }
            (lp: &ClassPtrType, rp: &ClassPtrType) => {
                return TypeInference::inferBranchingClass (lloc, rloc, lp, rp);
            }
            (ltp: &TupleType, rtp: &TupleType) => {
                return TypeInference::inferBranchingTuple (lloc, rloc, ltp, rtp);
            }
            (opL: &OptionType, opR: &OptionType) => {
                return TypeInference::inferBranchingOptions (lloc, rloc, opL, opR);
            }
            (ptrL: &PointerType, ptrR: &PointerType) => {
                return TypeInference::inferBranchingPointers (lloc, rloc, ptrL, ptrR);
            }
            (e: &EnumType, _) => {
                return TypeInference::inferBranching (lloc, rloc, e.proxy, right);
            }
            (_, e: &EnumType) => {
                return TypeInference::inferBranching (lloc, rloc, left, e.proxy);
            }
        }

        throw copy ErrorMsg::fatal (lloc, end-> rloc, format (ValidateErrorMessage::INCOMPATIBLE_TYPE, left, right));
    }

    /**
     * Infer a common slice type for two slice branches.
     *
     * @params:
     *   - lloc:  location of the left branch
     *   - rloc:  location of the right branch
     *   - left:  left slice type
     *   - right: right slice type
     *
     * @returns:
     *   - a SliceType whose inner type is the unified element type
     *
     * @throws:
     *   - ErrorMsg if the element types cannot be unified
     */
    fn inferBranchingSlices (lloc: &Word, rloc: &Word, left: &SliceType, right: &SliceType)-> &Type
        throws ErrorMsg
    {
        if (left.value of VoidType) return right; // [] literal
        if (right.value of VoidType) return left; // [] literal
        
        let inner = {
            TypeInference::inferBranching (lloc, rloc, left.value, right.value)
        } catch {
            _ => {
                throw copy ErrorMsg::fatal (lloc, end-> rloc, format (ValidateErrorMessage::INCOMPATIBLE_TYPE, left, right));
            }
        }

        return copy SliceType (lloc, inner, isMutable-> left.isMutable && right.isMutable);
    }

    /**
     * Infer a common option type for two option branches.
     *
     * @params:
     *   - lloc:  location of the left branch
     *   - rloc:  location of the right branch
     *   - left:  left option type
     *   - right: right option type
     *
     * @returns:
     *   - an OptionType whose wrapped type is the unified inner type
     *
     * @throws:
     *   - ErrorMsg if the wrapped types cannot be unified
     */
    fn inferBranchingOptions (lloc: &Word, rloc: &Word, left: &OptionType, right: &OptionType)-> &Type
        throws ErrorMsg
    {
        if (left.wrapped of NoneType) return right; // none literal
        if (right.wrapped of NoneType) return left; // none literal

        let inner = {
            TypeInference::inferBranching (lloc, rloc, left.wrapped, right.wrapped)
        } catch {
            _ => {
                throw copy ErrorMsg::fatal (lloc, end-> rloc, format (ValidateErrorMessage::INCOMPATIBLE_TYPE, left, right));
            }
        }

        return copy OptionType (lloc, inner, isMutable-> left.isMutable && right.isMutable)
    }

    /**
     * Infer a common pointer type for two pointer branches.
     *
     * @params:
     *   - lloc:  location of the left branch
     *   - rloc:  location of the right branch
     *   - left:  left pointer type
     *   - right: right pointer type
     *
     * @returns:
     *   - a PointerType whose pointed type is the unified inner type
     *
     * @throws:
     *   - ErrorMsg if the pointed types cannot be unified
     */
    fn inferBranchingPointers (lloc: &Word, rloc: &Word, left: &PointerType, right: &PointerType)-> &Type
        throws ErrorMsg
    {
        if (left.pointed of NoneType) return right; // null literal
        if (right.pointed of NoneType) return left; // null literal

        let inner = {
            TypeInference::inferBranching (lloc, rloc, left.pointed, right.pointed)
        } catch {
            _ => {
                throw copy ErrorMsg::fatal (lloc, end-> rloc, format (ValidateErrorMessage::INCOMPATIBLE_TYPE, left, right));
            }
        }

        return copy PointerType (lloc, inner, isMutable-> left.isMutable && right.isMutable);
    }

    /**
     * Infer a common class pointer type for two class branches.
     *
     * @params:
     *   - lloc:  location of the left branch
     *   - rloc:  location of the right branch
     *   - left:  left class pointer type
     *   - right: right class pointer type
     *
     * @returns:
     *   - the most specific common ancestor class pointer type,
     *     adjusted for mutability
     *
     * @throws:
     *   - ErrorMsg if no common ancestor exists
     */
    fn inferBranchingClass (lloc: &Word, rloc: &Word, left: &ClassPtrType, right: &ClassPtrType)-> &Type
        throws ErrorMsg
    {
        if (TypeVerification::isAncestor (left, right)) {
            if (left.mutabilityFit (right)) return left.clone (pattern-> right);
            else return left;
        }
        if (TypeVerification::isAncestor (right, left)) {
            if (right.mutabilityFit (left)) return right.clone (pattern-> left);
            else return right;
        }
        
        if let Ok (c: &ClassPtrType) = TypeInference::inferCommonAncestor (lloc, left, right) {
            let distLeft  = c.mutabilityDistance (left);
            let distRight = c.mutabilityDistance (right);
            
            if (distLeft > distRight) {
                return c.clone (pattern-> left);
            }
            
            return c.clone (pattern-> right);
        }
        
        throw copy ErrorMsg::fatal (lloc, end-> rloc, format (ValidateErrorMessage::INCOMPATIBLE_TYPE, left, right));                   
    }


    /**
     * Infer a common tuple type for two tuple branches.
     *
     * @params:
     *   - lloc:  location of the left branch
     *   - rloc:  location of the right branch
     *   - left:  left tuple type
     *   - right: right tuple type
     *
     * @returns:
     *   - a TupleType whose elements are the unified element types
     *
     * @throws:
     *   - ErrorMsg if tuple lengths differ or elements cannot be unified
     */
    fn inferBranchingTuple (lloc: &Word, rloc: &Word, left: &TupleType, right: &TupleType)-> &Type
        throws ErrorMsg
    {
        if (left.inners.len != right.inners.len) {
            throw copy ErrorMsg::fatal (lloc, end-> rloc, format (ValidateErrorMessage::INCOMPATIBLE_TYPE, left, right));
        }

        let mut inners: [mut &Type] = [];
        {
            for i in 0us .. left.inners.len {
                let inner = TypeInference::inferBranching (lloc, rloc, left.inners [i], right.inners [i]);
                TypeVerification::verifyComplete (lloc, inner, false);

                inners ~= [inner];
            }
        } catch {
            _ => {
                throw copy ErrorMsg::fatal (lloc, end-> rloc, format (ValidateErrorMessage::INCOMPATIBLE_TYPE, left, right));
            }
        }

        return copy TupleType (lloc, inners, isMutable-> left.isMutable && right.isMutable);
    }

    /**
     * Infer the correct mutability for an inner type based on the value being
     * inserted into a container (array, slice, tuple).
     *
     * @params:
     *   - innerType: the element type declared by the container
     *   - val:       the value being inserted
     *
     * @returns:
     *   - innerType unchanged if it is already mutable and ownership is valid
     *   - otherwise, a version of innerType with mutability relaxed until borrow
     */
    pub fn inferImplicitMutability (innerType: &Type, val: &Value)-> &Type {
        if (innerType.isMutable) {    
            MemoryVerification::verifyMemoryOwner (val.loc, innerType, val, byReference-> false);
            return innerType
        } catch {
            // cannot borrow, need to fallback to const borrow                
            _ => {} 
        }
        
        return innerType.cloneMutableUntilBorrow ();
    }

}
