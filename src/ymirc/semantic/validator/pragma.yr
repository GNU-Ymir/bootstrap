/*
 * Implements the root of the pragma-validation subsystem.
 *
 * Pragmas in Ymir use the syntax:
 *
 *     __pragma!name(params...)
 *
 * and behave as compile-time meta-functions. Each pragma is resolved by name
 * and dispatched through one of two registries:
 *
 *   - __PRAGMA_VALUE_REGISTRY__ - handlers returning a Value
 *   - __PRAGMA_TYPE_REGISTRY__  - handlers returning a Type
 *
 * Handlers are function pointers returning an option:
 *
 *     Ok(&Value) or Err(&ErrorMsg)
 *
 * This allows pragma handlers to signal semantic errors without throwing, while
 * the dispatcher is responsible for converting them into fatal diagnostics. The
 * system is fully extensible: external modules may register additional pragmas
 * at compile-time or initialization time.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::pragma
 * @File: ymirc/semantic/validator/pragma.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2023-02-16
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in pragma;

use ymirc::lexing::keys;
use ymirc::syntax::expression::operator;
use ymirc::semantic::validator;
use ymirc::semantic::generator::{value, type};

use ymirc::utils::format;
use ymirc::errors;

use std::io;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub mod ::compile;
pub mod ::message;
pub mod ::operator;
pub mod ::field_value;
pub mod ::field_type;
pub mod ::field_info;
pub mod ::ancestor_value;
pub mod ::ancestor_root;
pub mod ::ancestor_type;
pub mod ::unproxy;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          ROOT          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * PragmaValidation module
 *
 * Provides the central dispatch mechanism for Ymir pragmas. Pragmas are
 * compile-time meta-functions introduced with the syntax:
 *
 *     __pragma!name(params...)
 *
 * The module maintains two registries:
 *
 *   • value registry - maps pragma names to handlers producing a Value
 *   • type registry  - maps pragma names to handlers producing a Type
 *
 * Handlers are stored as function pointers and must return:
 *
 *     Ok(result) or Err(error)
 *
 * The dispatcher invokes the handler, unwraps the result, and throws any
 * reported error. Unknown pragmas produce a fatal UNKNOWN_PRAGMA diagnostic.
 *
 * The module also exposes `registerValueHandler` and `registerTypeHandler`,
 * allowing extensions or libraries to define new pragmas without modifying the
 * compiler core.
 *
 */
pub mod PragmaValidation {

    prv lazy dmut __PRAGMA_VALUE_REGISTRY__: [[c8] => PragmaValueHandler] = {
        PragmaValidation::createDefaultValueHandlers()
    };

    prv lazy dmut __PRAGMA_TYPE_REGISTRY__: [[c8] => PragmaTypeHandler]  = {
        PragmaValidation::createDefaultTypeHandlers()
    };

    /**
     * Validate a pragma expression that produces a value.
     *
     * Looks up the pragma name in the value-handler registry. If a handler is
     * found, it is invoked and must return:
     *
     *   • Ok(&Value)     - successful evaluation
     *   • Err(&ErrorMsg) - semantic error to be thrown
     *
     * Any other return form is considered an internal error.
     *
     * If the pragma name is not registered, a fatal UNKNOWN_PRAGMA error is
     * emitted.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - the resulting Value
     *
     * @throws:
     *   - ErrorMsg if the handler reports an error or the pragma is unknown
     */
    pub fn validateValue(dmut context: &ValidationContext, p: &PragmaExpr)-> &Value
        throws ErrorMsg
    {
        if let Ok(handler) = __PRAGMA_VALUE_REGISTRY__[p.name.str] {
            let v = handler(alias context, p); // return option, because function pointer in Ymir never throw
            match v {
                Ok(r) => return r;
                Err(e: &ErrorMsg) => throw e;
                _ => {
                    eprintln("internal pragma validation error; handler should return a valid value, or a valid error: ", p.name.str);
                    panic;
                }
            }
        }

        throw copy ErrorMsg::fatal(p.loc, format(ValidateErrorMessage::UNKNOWN_PRAGMA, p.name.str));
    }

    /**
     * Validate a pragma expression that produces a type.
     *
     * Identical to validateValue, but dispatches through the type-handler
     * registry. The handler must return:
     *
     *   • Ok(&Type)      - successful evaluation
     *   • Err(&ErrorMsg) - semantic error to be thrown
     *
     * Unknown pragmas produce a fatal UNKNOWN_PRAGMA error.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - the resulting Type
     *
     * @throws:
     *   - ErrorMsg if the handler reports an error or the pragma is unknown
     */
    pub fn validateType(dmut context: &ValidationContext, p: &PragmaExpr)-> &Type
        throws ErrorMsg
    {
        if let Ok(handler) = __PRAGMA_TYPE_REGISTRY__[p.name.str] {
            let v = handler(alias context, p); // return option, because function pointer in Ymir never throw
            match v {
                Ok(r) => return r;
                Err(e: &ErrorMsg) => throw e;
                _ => {
                    eprintln("internal pragma validation error; handler should return a valid value, or a valid error: ", p.name.str);
                    panic;
                }
            }
        }

        throw copy ErrorMsg::fatal(p.loc, format(ValidateErrorMessage::UNKNOWN_PRAGMA, p.name.str));
    }

    /**
     * Register a new value-producing pragma handler.
     *
     * Allows extensions, libraries, or compiler modules to define new pragmas
     * without modifying the compiler core. If a handler already exists for the
     * given name, it is replaced.
     *
     * @params:
     *   - name:    the pragma identifier(e.g. "compile", "myExt.foo")
     *   - handler: the function pointer implementing the pragma
     */
    pub fn registerValueHandler(name: [c8], handler: PragmaValueHandler) {
        __PRAGMA_VALUE_REGISTRY__[name] = handler;
    }

    /**
     * Register a new type-producing pragma handler.
     *
     * Allows extensions or modules to define type-level pragmas. If a handler
     * already exists for the given name, it is replaced.
     *
     * @params:
     *   - name:    the pragma identifier
     *   - handler: the function pointer implementing the pragma
     */
    pub fn registerTypeHandler(name: [c8], handler: PragmaTypeHandler) {
        __PRAGMA_TYPE_REGISTRY__[name] = handler;
    }

    /**
     * Initialize the default registry of value-producing pragma handlers.
     *
     * Registers the built-in pragmas provided by the compiler core. Additional
     * pragmas may be inserted later via registerValueHandler.
     *
     * @returns:
     *   - a mutable map from pragma names to value handlers
     */
    fn createDefaultValueHandlers()-> dmut[[c8] => PragmaValueHandler] {
        let dmut result: [[c8] => PragmaValueHandler] = copy [];

        result[PragmaKeys::COMPILE]      = &(compile::PragmaCompileValidation::handle);
        result[PragmaKeys::MSG]          = &(message::PragmaMessageValidation::handle);
        result[PragmaKeys::OPERATOR]     = &(operator::PragmaOperatorValidation::handle);
        result[PragmaKeys::FIELD]        = &(field_value::PragmaFieldAccessValidation::handle);
        result[PragmaKeys::FIELD_INFOS]  = &(field_info::PragmaFieldInfosValidation::handle);
        result[PragmaKeys::HAS_ANCESTOR] = &(ancestor_value::PragmaHasAncestorValidation::handle);

        return alias result;
    }

    /**
     * Initialize the default registry of type-producing pragma handlers.
     *
     * @returns:
     *   - a mutable map from pragma names to type handlers
     */
    fn createDefaultTypeHandlers()-> dmut[[c8] => PragmaTypeHandler] {
        let dmut result: [[c8] => PragmaTypeHandler] = copy [];

        result[PragmaKeys::FIELD_TYPE]    = &(field_type::PragmaFieldTypeValidation::handle);
        result[PragmaKeys::UNPROXIED]     = &(unproxy::PragmaEnumUnwrapValidation::handle);
        result[PragmaKeys::ROOT_ANCESTOR] = &(ancestor_root::PragmaRootAncestorValidation::handle);
        result[PragmaKeys::ANCESTOR]      = &(ancestor_type::PragmaGetAncestorValidation::handle);

        return alias result;
    }

}
