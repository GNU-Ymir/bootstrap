in module;

use ymirc::syntax::{declaration::_, expression::_};

use ymirc::semantic::{validator, declarator, symbol};
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::lexing::{word, keys};

use ymirc::errors;
use ymirc::global::state;

use ymirc::utils::{format, log};

use std::fs::path;

/**
 * ModuleValidation module
 *
 * Provides semantic validation for modules. Responsibilities:
 *
 *   - validate all symbols declared in a module,
 *   - validate unittest blocks,
 *   - selectively validate child modules based on declarator filters,
 *   - detect forward-reference cycles,
 *   - insert compiled modules into the validation context.
 *
 * Module validation is performed in two modes:
 *
 *   - Full validation:
 *        Validate all local symbols and unittests.
 *
 *   - Child-only validation:
 *        Validate only submodules that match the declarator filter.
 *
 * This allows incremental compilation and selective module checking.
 */
pub mod ModuleValidation {

    /**
     * Validate a module symbol.
     *
     * Responsibilities:
     *   - skip extern modules,
     *   - determine whether to perform full validation or child-only validation
     *     based on the declarator filter.
     *
     * @params:
     *   - context: validation context
     *   - sym:     ModuleSymbol to validate
     *
     * @throws:
     *   - ErrorMsg if validation fails
     */
    pub fn validate(dmut context: &ValidationContext, dmut sym: &ModuleSymbol)
        throws ErrorMsg
    {
        if (sym.isExtern) {
            return;
        }

        if !context.declarator.checkPassFilter(Path(sym.loc.filename)) {
            if context.declarator.isParentOfFilter(sym.path) {
                ModuleValidation::validateOnlyChilds(alias context, alias sym);
            }
        }
        else {
            ModuleValidation::validateFull(alias context, alias sym);
        }
    }

    /**
     * Fully validate a module and all its contents.
     *
     * Responsibilities:
     *   - validate all local symbols declared in the module,
     *   - validate all unittest blocks,
     *   - insert the module into the compiled-module list.
     *
     * @params:
     *   - context: validation context
     *   - sym:     ModuleSymbol
     *
     * @throws:
     *   - ErrorMsg::list if any symbol or unittest fails validation
     */
    fn validateFull(dmut context: &ValidationContext, dmut sym: &ModuleSymbol)
        throws ErrorMsg
    {
        if (sym.path.parts != []) {
            logging::info("Validate module %", sym.path);
        }

        let mut errors: [&ErrorMsg] = [];
        context:.pushReferent(alias sym);
        let dmut inner = sym:.getAllLocalSymbols(protection-> Protection::PRIVATE);

        // No-parameter functions are eligible for compile-time call folding(see
        // CompileTimeInterpret::cteFunction), which needs the callee's body to
        // already be validated. The main loop below validates local symbols in
        // whatever order the symbol table yields them, so a no-parameter
        // function used for its value(e.g. in a template argument) by another
        // symbol earlier in that order would not yet have a body to fold.
        // Validate no-parameter functions first so their value is always
        // available to the rest of the module, regardless of iteration order.
        // FunctionValidation::validate is idempotent, so the main loop below
        // simply skips them the second time around. Failures are ignored here;
        // the main loop re-attempts and reports them normally.
        for i in 0us .. inner.len {
            if let dmut f: &FunctionSymbol = alias inner[i] {
                if (!f.isMethod && f.decl.proto.params.len == 0us) {
                    { FunctionValidation::validate(alias context, alias f); } catch { _ => {} }
                }
            }
        }

        for i in 0us .. inner.len {
            {
                SymbolValidation::validate(alias context, alias inner[i]);
            } catch {
                err => {
                    errors ~= [err];
                }
            }
        }

        let dmut tests = alias sym.unitTests;
        for i in 0us .. tests.len {
            {
                UnittestValidation::validate(alias context, alias tests[i], i);
            } catch {
                err => {
                    errors ~= [err];
                }
            }
        }

        if (sym.path.parts != []) {
            context:.insertCompiledModule(Path(sym.loc.filename)
                                          .removePrefix(context.declarator.packageDir)
                                          .stripExtension());
        }

        context:.popReferent();

        if (errors.len != 0us) {
            throw copy ErrorMsg::list(errors);
        }
    }

    /**
     * Validate only the child modules of a module, based on the declarator filter.
     *
     * This mode is used when:
     *   - the current module does not match the filter,
     *   - but it is a parent of the filtered module path.
     *
     * Responsibilities:
     *   - validate only submodules whose paths match or are parents of the filter,
     *   - validate lazy-imported modules when they match the filter.
     *
     * @params:
     *   - context: validation context
     *   - sym:     ModuleSymbol
     *
     * @throws:
     *   - ErrorMsg::list if any child module fails validation
     */
    fn validateOnlyChilds(dmut context: &ValidationContext, dmut sym: &ModuleSymbol)
        throws ErrorMsg
    {
        let mut errors: [&ErrorMsg] = [];
        context:.pushReferent(alias sym);

        let dmut inner = sym:.getAllLocalSymbols(protection-> Protection::PRIVATE);
        for i in 0us .. inner.len {
            {
                if let dmut m: &ModuleSymbol = alias inner[i] {
                    if context.declarator.checkPassFilter(Path(m.loc.filename)) || context.declarator.isParentOfFilter(m.path) {
                        ModuleValidation::validate(alias context, alias m);
                    }
                }
                else if let dmut l: &LazyModuleSymbol = alias inner[i] {
                    if context.declarator.checkPassFilter(l.importPath) || context.declarator.isParentOfFilter(l.path) {
                        SymbolValidation::validate(alias context, alias l);
                    }
                }
            } catch {
                err => {
                    errors ~= [err];
                }
            }
        }

        context:.popReferent();

        if (errors.len != 0us) {
            throw copy ErrorMsg::list(errors);
        }
    }
}
