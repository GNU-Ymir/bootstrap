in import_;

use ymirc::syntax::declaration::_;

use ymirc::semantic::{validator, symbol};
use ymirc::semantic::declarator;

use ymirc::errors;
use ymirc::errors::diagnostic;

use ymirc::utils::format;

/**
 * @params:
 *    - sym: a symbol of a validated module
 * @returns: true iif 'sym', or a symbol it declares in the same file, is a template no
 * specialization of which was declared
 */
fn declaresPendingTemplate(sym: &Symbol)-> bool {
    for s in sym.getAllLocalSymbols(protection-> Protection::PRIVATE) {
        if (!sym.inSameFile(s)) continue; // a submodule brings its own imports and is checked on its own
        match s {
            t: &TemplateSymbol => { if (!t.hasInstance) return true; }
            _                  => { if (declaresPendingTemplate(s)) return true; }
        }
    }

    false
}

/**
 * ImportValidation module
 *
 * Provides the check of the `use` declarations of a package. Responsibilities:
 *
 *   - report an import no name resolution ever reached,
 *   - report a `_` import of which a single module is reached.
 *
 * The check runs once the whole package is validated: a symbol of an already
 * validated module can still be validated afterwards -- a template instantiated
 * by a later module, for one -- and reach an import that would look unused
 * halfway through.
 */
pub mod ImportValidation {

    /**
     * Check the imports of every fully validated module.
     *
     * @params:
     *   - context: validation context
     *
     * @throws:
     *   - ErrorMsg::list if an import diagnostic is fatal(i.e. outside debug mode)
     */
    pub fn validate(dmut context: &ValidationContext)
        throws ErrorMsg
    {
        let mut errors: [&ErrorMsg] = [];
        for sym in context.getValidatedModules() {
            // the content of a template is only validated through a specialization, so a
            // module declaring one this compilation never instantiated is only partially
            // validated, and its imports would look unused whatever it does with them
            if (declaresPendingTemplate(sym)) continue;

            for imp in sym.imports {
                if (imp.used.len == 0us) {
                    errors ~= [copy ErrorMsg::warn(imp.loc, format(DeclareErrorMessage::UNUSED_USE, imp.path))];
                }

                else if (imp.isWildcard && imp.modules.len > 1us && imp.used.len == 1us) {
                    let only = imp.used[0].path.toStr();
                    let note = copy ErrorMsg::note(imp.loc, format(DeclareErrorMessage::SINGLE_WILDCARD_USE_NOTE, only));
                    errors ~= [copy ErrorMsg::warn(imp.loc,
                                                   format(DeclareErrorMessage::SINGLE_WILDCARD_USE, only, imp.path),
                                                   notes-> copy [note])];
                }
            }
        }

        // an unused import aborts the validation outside debug mode only, in debug
        // mode it is simply reported
        let fatals = diagnostic::raiseAll(errors);
        if (fatals.len != 0us) {
            throw copy ErrorMsg::list(fatals);
        }
    }

}
