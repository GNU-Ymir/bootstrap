in enum_;

use ymirc::errors;
use ymirc::semantic::symbol;
use ymirc::semantic::generator::type::_;
use ymirc::semantic::generator::value;
use ymirc::semantic::generator::value::literal;
use ymirc::syntax::expression::{empty, instruction};
use ymirc::utils::{format, log};

/**
 * EnumValidation module
 *
 * Provides semantic validation for enum declarations. Responsibilities:
 *
 *   - validate enum type annotations,
 *   - infer enum type when omitted,
 *   - validate enum field expressions,
 *   - enforce memory-ownership rules for enum values,
 *   - detect forward-reference cycles,
 *   - construct EnumType generator values.
 *
 */
pub mod EnumValidation {

    /**
     * Validate an enum symbol and return its EnumType.
     *
     * Responsibilities:
     *   - detect whether validation is required,
     *   - detect forward-reference cycles,
     *   - validate enum content if needed,
     *   - return the resulting EnumType or rethrow stored errors.
     *
     * @params:
     *   - context: validation context
     *   - sym:     EnumSymbol to validate
     *
     * @returns:
     *   - the EnumType generated for the enum
     *
     * @throws:
     *   - ErrorMsg if validation fails
     */
    pub fn validate(dmut context: &ValidationContext, dmut sym: &EnumSymbol)-> &EnumType
        throws ErrorMsg
    {
        if (!EnumValidation::checkValidation(context, sym)) {
            EnumValidation::validateContent(alias context, alias sym);
        }

        match sym.generator {
            r: &EnumType => {
                return r;
            }
            err: &ErrorGenerator => {
                throw err.msg;
            }
            _ => {
                panic;
            }
        }
    }

    /**
     * Validate the full content of an enum declaration.
     *
     * Responsibilities:
     *   - insert the enum into the validation set,
     *   - validate explicit type(if any),
     *   - validate all fields,
     *   - construct the final EnumType,
     *   - wrap errors in VALIDATING diagnostics.
     *
     * @params:
     *   - context: validation context
     *   - sym:     EnumSymbol
     */
    fn validateContent(dmut context: &ValidationContext, dmut sym: &EnumSymbol) {
        logging::info("Validate enum %", sym.path);

        sym.generator = copy ErrorGenerator(sym.loc, copy ErrorMsg::fatal(sym.loc, ValidateErrorMessage::FORWARD_REFERENCE_TYPE));
        context.enumContext:.insert(sym);

        // a member of an enum is folded into its readers, and validated only once, so what
        // the enum reads is kept to be replayed for every later reader
        context.readContext:.enterSymbol(sym.path.toStr());
        {
            let forceType = EnumValidation::validateForceType(alias context, alias sym);
            EnumValidation::validateFields(alias context, alias sym, forceType);
        } catch {
            err => {
                sym.generator = copy ErrorGenerator(sym.loc, copy ErrorMsg::fatal(sym.loc, format(ValidateErrorMessage::VALIDATING_SYMBOL, sym.path.toStr()),
                                                                                  notes-> copy [err]));
            }
        } exit {
            context.readContext:.exitSymbol();
        }

        context.enumContext:.remove(sym);
    }

    /**
     * Validate the explicit type annotation of an enum, if present.
     *
     * If the enum has no explicit type, NONE_TYPE is returned, signaling that
     * type inference must be performed during field validation.
     *
     * If a type is provided:
     *   - validate it via TypeValidation::validate(),
     *   - clone it with mutable-until-borrow semantics.
     *
     * @params:
     *   - context: validation context
     *   - sym:     EnumSymbol
     *
     * @returns:
     *   - the validated type or NONE_TYPE
     *
     * @throws:
     *   - ErrorMsg if the type annotation is invalid
     */
    fn validateForceType(dmut context: &ValidationContext, dmut sym: &EnumSymbol)-> &Type
        throws ErrorMsg
    {
        if sym.decl.type of EmptyExpr {
            return NONE_TYPE;
        }

        let type = TypeValidation::validate(alias context, sym.decl.type,
                                            parentMutable-> false);
        return type.cloneMutableUntilBorrow();
    }

    /**
     * Validate all fields of an enum and infer the enum type if needed.
     *
     * Responsibilities:
     *   - validate each field expression,
     *   - infer enum type when forceType is NONE_TYPE,
     *   - enforce memory-ownership rules,
     *   - insert field values into the local scope,
     *   - construct the final EnumType,
     *   - aggregate and report all field errors,
     *   - merge the tags of the enum once its written fields are valid.
     *
     * @params:
     *   - context:   validation context
     *   - sym:       EnumSymbol
     *   - forceType: explicit type or NONE_TYPE
     *
     * @throws:
     *   - ErrorMsg::list if any field validation fails
     *   - ErrorMsg if a tag cannot be merged into the enum
     */
    fn validateFields(dmut context: &ValidationContext, dmut sym: &EnumSymbol, forceType: &Type)
        throws ErrorMsg
    {
        let mut errors: [&ErrorMsg] = [];
        context:.pushReferent(alias sym);
        context:.enterForeign(isFnBody-> false);
        context:.enterBlock();

        let mut realForceType = forceType;
        for field in sym.decl.fields {
            {
                let (type, value) = EnumValidation::validateField(alias context, field, forceType, realForceType);
                realForceType = type;
                sym:.setField(field.name.str, value);
            } catch {
                err => {
                    errors ~= [err];
                }
            }
        }

        realForceType = realForceType.cloneMutableUntilBorrow();

        sym.generator = copy EnumType(sym.loc, sym, realForceType, isMutable-> true);

        context:.safeQuitBlock();
        context:.exitForeign();
        context:.popReferent();

        if (errors.len != 0us) {
            throw copy ErrorMsg::list(errors);
        }

        TagValidation::mergeEnum(alias context, alias sym);
    }

    /**
     * Validate fields appended to an enum whose written fields are validated, as
     * if the type of the enum were written, from the current referent. The
     * fields reach each other by their names, and are appended to the enum once
     * they all validate, the enum being seen without them while they are.
     *
     * @params:
     *   - context: validation context
     *   - sym:     EnumSymbol, validated
     *   - fields:  the fields to append
     *
     * @returns:
     *   - the names of the fields appended
     *
     * @throws:
     *   - ErrorMsg::list if any field validation fails
     */
    pub fn appendFields(dmut context: &ValidationContext, dmut sym: &EnumSymbol, fields: [&VarDeclExpr])-> [[c8]]
        throws ErrorMsg
    {
        if let en: &EnumType = sym.generator {
            let mut errors: [&ErrorMsg] = [];
            let mut values: [([c8], &Value)] = [];
            context:.enterForeign(isFnBody-> false);
            context:.enterBlock();
            {
                for field in fields {
                    {
                        EnumValidation::verifyNotDeclared(sym, field);
                        let (_, value) = EnumValidation::validateField(alias context, field, en.proxy, en.proxy);
                        values ~= [(field.name.str, value)];
                    } catch {
                        err => {
                            errors ~= [err];
                        }
                    }
                }
            } exit {
                context:.safeQuitBlock();
                context:.exitForeign();
            }

            if (errors.len != 0us) {
                throw copy ErrorMsg::list(errors);
            }

            for v in values {
                sym:.setField(v._0, v._1);
            }

            return copy [v._0 for v in values];
        }

        panic;
    }

    /**
     * Verify that a field appended to an enum is not one of its fields already.
     *
     * @params:
     *   - sym:   EnumSymbol
     *   - field: the field appended
     *
     * @throws:
     *   - ErrorMsg if the enum has a field of that name, noted with the field
     *     written, or with the tag site that appended it
     */
    fn verifyNotDeclared(sym: &EnumSymbol, field: &VarDeclExpr)
        throws ErrorMsg
    {
        if sym.field(field.name.str) of UnitValue return;

        let mut note = copy ErrorMsg::note(sym.loc, ValidateErrorMessage::DEFINED_HERE);
        for f in sym.decl.fields if (f.name.str == field.name.str) {
            note = copy ErrorMsg::note(f.name, ValidateErrorMessage::DEFINED_HERE);
        }

        if let Ok(by) = sym.mergedBy(field.name.str) {
            note = copy ErrorMsg::note(by._0, format(ValidateErrorMessage::TAG_ADDED_MEMBER, format("%::%", sym.path.toStr(), field.name.str), by._1));
        }

        throw copy ErrorMsg::fatal(field.name, format(ValidateErrorMessage::SHADOWING_DECL, field.name.str),
                                   notes-> copy [note]);
    }

    /**
     * Validate a field of an enum, and declare it as a local variable for the
     * fields that follow.
     *
     * @params:
     *   - context:       validation context
     *   - field:         the field
     *   - forceType:     explicit type or NONE_TYPE
     *   - realForceType: the type inferred from the previous fields, when forceType is NONE_TYPE
     *
     * @returns:
     *   - the type inferred with the field, and its value
     *
     * @throws:
     *   - ErrorMsg if the field does not validate
     */
    fn validateField(dmut context: &ValidationContext, field: &VarDeclExpr, forceType: &Type, realForceType: &Type)-> (&Type, &Value)
        throws ErrorMsg
    {
        let mut value = ValueValidation::validate(alias context, field.value);
        let mut type = realForceType;

        if forceType of NoneType {
            let (type_, value_) = TypeInference::inferValueForBranch(alias context, value.loc, realForceType, value);
            type = type_;
            value = value_;
        } else {
            value = TypeInference::inferValueForType(alias context, field.loc, value, forceType, byReference-> false);
        }

        MemoryVerification::verifyMemoryOwner(field.loc, type, value,
                                              construct-> true,
                                              byReference-> false);

        context:.insertLocal(field.loc, field.name.str, value);
        (type, value)
    }

    /**
     * Determine whether an enum is already validated or in validation.
     *
     * @params:
     *   - context: validation context
     *   - sym:     EnumSymbol
     *
     * @returns:
     *   - true if the enum is already validated or in validation,
     *   - false otherwise
     */
    fn checkValidation(context: &ValidationContext, sym: &EnumSymbol)-> bool {
        if sym.generator of EmptyGenerator {
            return sym in context.enumContext;
        }
        return true;
    }
}
