in ctor_verif;

use ymirc::semantic::{validator, template_};
use ymirc::semantic::{generator::_, symbol};
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::errors::_;
use ymirc::utils::{format, log};
use ymirc::lexing::{word, tokens, keys};

use std::{stream, io};

pub mod CtorVerification {

    /**
     * Verify that a constructor call does not generate an infinite recursion
     * */
    pub fn verifyInfiniteRecursion(ctor: &CtorPrototypeValue, ref mut entered: [&Symbol => mut()])
        throws ErrorMsg
    {
        entered[ctor.sym] = ();
        if let ctorSym: &ConstructorSymbol = ctor.sym {
            if let redirect: &CtorCallValue = ctorSym.body {
                if let redirectSym: &ConstructorSymbol = redirect.ctor.proto.sym {
                    if (redirectSym in entered) {
                        throw copy ErrorMsg::fatal(redirect.loc,
                                                    format(ValidateErrorMessage::CTOR_INFINITE_REDIRECTION, redirect.ctor.proto, tags-> FormatTags(withParams-> true)));
                    }

                    if (redirectSym.hasRedirect) {
                        CtorVerification::verifyInfiniteRecursion(redirect.ctor.proto, entered-> ref entered);
                    } catch {
                        err: &ErrorMsg => {
                            throw copy ErrorMsg::fatal(redirect.loc, format(ValidateErrorMessage::CTOR_INFINITE_REDIRECTION, redirect.getCtor().getPrototype(), tags-> FormatTags(withParams-> true)), notes-> copy [err]);
                        }
                    }
                }
            }
        }
    }

}
