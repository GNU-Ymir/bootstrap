 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in unittest;

use ymirc::syntax::{expression::_, declaration::_};
use ymirc::semantic::{validator, template_};
use ymirc::semantic::{generator::_, symbol};
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::errors;
use ymirc::utils::{format, log};
use ymirc::lexing::{word, tokens, keys};

use std::{stream, io};

use ymirc::semantic::validator::symbol::function::_;


/**
 * UnittestValidation module
 *
 * Provides semantic validation for unittest declarations. Responsibilities:
 *
 *   - validate the body of a unittest block,
 *   - ensure the unittest returns void,
 *   - manage local scopes and foreign contexts,
 *   - generate a UnitTestGenerator for execution,
 *   - assign a unique path to each unittest based on its module index.
 *
 * Unittests behave like zero-argument functions evaluated at runtime,
 * but with no return value and no attributes.
 */
pub mod UnittestValidation {

    /**
     * Validate a unittest block.
     *
     * Errors:
     *   - any semantic error inside the unittest body is captured,
     *     then re-thrown after cleanup.
     *
     * @params:
     *   - context: validation context
     *   - sym:     UnitTestSymbol representing the unittest
     *   - uid:     index of the unittest within the module(used for unique naming)
     *
     * @returns:
     *   - nothing(throws on error, otherwise registers a generator)
     *
     * @throws:
     *   - ErrorMsg if the unittest body is invalid
     */
    pub fn validate(dmut context: &ValidationContext, dmut sym: &UnitTestSymbol, uid: usize)
        throws ErrorMsg
    {
        context:.pushReferent(alias sym);
        context:.enterForeign(isFnBody-> true);
        context:.enterBlock();
        context:.setFunctionReturn(VOID_TYPE);

        let mut errors: (&ErrorMsg)? = none;
        let mut body: &Value = UNIT_VALUE;
        {
            body = ValueValidation::validate(alias context, sym.decl.body);
        } catch {
            err => {
                errors = (err)?;
            }
        }

        {
            context:.quitBlock(warnUnused-> !(errors.hasValue));
        } catch {
            err => {
                errors = (err)?;
            }
        }

        context:.exitForeign();
        context:.popReferent();

        if let Ok(err) = errors {
            throw err;
        }

        let path = sym.path.push(format("%", uid));
        let gen = copy UnitTestGenerator(sym.loc, path, body);
        context:.insertGenerator(alias sym, gen);
    }

}
