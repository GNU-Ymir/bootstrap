 *   ```
 */

in class_;

use ymirc::semantic::{validator, symbol, template_};

use ymirc::syntax::{expression::_, declaration::_};
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::lexing::{word, keys, tokens};

use ymirc::errors;
use ymirc::utils::{format, log};

use ymirc::semantic::validator::context::class_;
use ymirc::semantic::validator::symbol::class_::_;
use ymirc::semantic::validator::symbol::class_::method::_;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */


mod ::finalize;
mod ::ancestor;
mod ::cte_;
mod ::fields;
mod ::ctor;
mod ::method;
mod ::dtor;
mod ::typeinfo;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          ROOT          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * ClassValidation module
 *
 * Provides the top-level validation pipeline for classes. Responsibilities:
 *
 *   - manage recursive validation depth,
 *   - handle precary mode for forward references,
 *   - orchestrate all class-validation subsystems,
 *   - install class references,
 *   - schedule finalization,
 *   - propagate and wrap fatal errors.
 *
 * Validation is performed in two layers:
 *
 *   1. validate() — entry point, manages recursion, precary mode, and finalization.
 *   2. validateLayout() — performs the actual semantic validation of the class.
 *
 * The pipeline is robust against forward references and ensures that all
 * classes are eventually validated once their dependencies become available.
 */
pub mod ClassValidation {

    /**
     * Entry point for class validation.
     *
     * @returns:
     *   - the ClassRefType of the validated class
     *
     * @throws:
     *   - ErrorMsg if validation fails
     */
    pub fn validate(dmut context: &ValidationContext, dmut sym: &ClassSymbol, inModule: bool)-> &ClassRefType
        throws ErrorMsg
    {
        // We don't validate if we already have an error
        if (!sym.errorGenerator.hasValue) {
            if !sym.classRef.hasValue {
                sym.classRef = copy ClassRefType(sym.loc, sym);
            }

            let validationLevel = if inModule {
                1u32
            } else {
                context.classContext.level(sym)
            };

            if validationLevel < MAX_RECURSIVE_LEVEL {
                ClassValidation::validateLayout(alias context, alias sym,
                                                inModule-> inModule,
                                                validationLevel-> validationLevel);
            }

            // If there is no error in the prototype of the class, and we are inModule, then we add it to finalizable classes
            if !sym.errorGenerator.hasValue && inModule {
                context.classContext:.insertFinalize(alias sym);
            }

            if context.classContext.isRoot {
                ClassFinalizer::finalize(alias context);
            }

            if let Ok(r) = sym.classRef {
                return r;
            }
        }

        if let Ok(err) = sym.errorGenerator {
            throw err.msg;
        }

        panic;
    }

    /**
     * Perform semantic validation of the class layout.
     *
     * Responsibilities:
     *   - manage recursion depth and precary mode,
     *   - push referent and enter foreign context,
     *   - invoke validateContent() to perform actual validation,
     *   - schedule post-validation passes for forward references,
     *   - unwind precary mode and re-validate deferred classes.
     *
     * Precary mode:
     *   - Activated when validationLevel > 1 and not already active.
     *   - Suppresses fatal errors for forward references.
     *   - Deferred classes are re-validated once precary mode ends.
     *
     * @params:
     *   - context:         validation context
     *   - sym:             class symbol
     *   - inModule:        whether the class is being validated in module context
     *   - validationLevel: recursion depth
     */
    pub fn validateLayout(dmut context:    &ValidationContext,
                          dmut sym:        &ClassSymbol,
                          inModule:        bool = false,
                          validationLevel: u32 = 2u32)
    {
        // A fake typeinfo does not count: its fields are still ERROR_TYPE
        // placeholders, so the layout has to be validated again
        if let Ok(cref) = sym.classRef && (cref.hasCompleteTypeInfo && !inModule) {
            return;
        }

        context.classContext:.set(sym, validationLevel + 1);

        // We are entering a precary validation for the first time?
        let forced = if (validationLevel > 1 && !context.classContext.forcePrecary) {
            context.classContext.forcePrecary = true;
            true
        } else {
            false
        };


        context:.pushReferent(alias sym);
        context:.enterForeign(isFnBody-> false);

        logging::info("Validate class layout % (%)", sym.path, validationLevel);

        // This cannot throw (cf. the function def)
        let (precary, success) = ClassValidation::validateContent(alias context, alias sym, inModule, validationLevel);

        if success { // not success means we have unrecoverable error even in precary(or not precary validation)
            // If the validation failed to be complete due to forward reference, we need to validate it again later
            if !forced && (precary && validationLevel == 1) {
                context.classContext:.insertPost(alias sym, inModule);
            }
        }

        context:.exitForeign();
        context:.popReferent();

        if validationLevel == 1 {
            context.classContext:.remove(sym);
        }

        // Exit the precary context from the first class validation that entered it
        if forced {
            context.classContext.forcePrecary = false;

            // Validate all the class that have been force precary and failed
            let dmut cp = context.classContext:.popPost();
            for _, dmut z in alias cp {
                ClassValidation::validateLayout(alias context, alias z._0,
                                                inModule-> z._1,
                                                validationLevel-> 1u32);
            }
        }
    }

    /**
     * Perform the actual semantic validation of the class.
     *
     * @returns:
     *   - (precary, success)
     *       * precary = true  → field validation incomplete due to forward refs
     *       * success = false → unrecoverable error occurred
     */
    fn validateContent(dmut context:    &ValidationContext,
                       dmut sym:        &ClassSymbol,
                       inModule:        bool,
                       validationLevel: u32)-> (bool, bool) {
        {
            // First we need to validate the ancestor of the class, to generate the vtable, the child class vtable being an override of the one of the ancestor
            let ancestor = ClassAncestorValidation::validate(alias context, alias sym);

            // Validate the static assertions of the class definition(@warning: this is only performed if the validation is a root, to avoid too deep and unreadable errors)
            ClassCteValidation::validate(alias context, alias sym);

            // List the trait implemented by the class before validating vtable
            ClassMethodImplValidation::validateSimple(alias context, alias sym, ancestor);

            // Validate the ctors prototypes of the class
            // Ctors does not need fields to be validated
            ClassCtorValidation::validate(alias context, alias sym, inModule,
                                          withValue-> (validationLevel <= 1));

            // Validate the vtable(without validating the method bodies, just the prototypes)
            ClassMethodValidation::validateVtable(alias context, alias sym, ancestor, inModule,
                                                  withValue-> (validationLevel <= 1));

            // Validate the fields of the class
            // But fields might need the ctors of other class to be validated
            let fieldSuccess = ClassFieldValidation::validate(alias context, alias sym, ancestor,
                                                              precary-> (validationLevel > 1));

            // Validate the default movable ctor if the symbol is an entity
            ClassCtorValidation::validateMovable(alias context, alias sym,
                                                 inModule-> inModule);

            // Validate the ctor generated from the fields if the symbol asks for one
            ClassCtorValidation::validateGenerated(alias context, alias sym,
                                                   inModule-> inModule,
                                                   precary-> (validationLevel > 1));

            // Validate the dtor of the class
            ClassDtorValidation::validate(alias context, alias sym, ancestor, inModule);

            // Validate the typeinfo of the class
            ClassTypeInfoValidation::validate(alias context, alias sym,
                                              fake-> !fieldSuccess);

            return (!fieldSuccess, true);
        } catch {
            err => {
                sym.errorGenerator = copy ErrorGenerator(sym.loc,
                                                         copy ErrorMsg::fatal(sym.loc, ValidateErrorMessage::VALIDATING,
                                                                              notes-> copy [err]));

                return (true, false);
            }
        }
    }
}
