 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in def_;

use ymirc::semantic::{validator, symbol};

use ymirc::syntax::{expression::_, declaration::_};
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::errors;

use ymirc::utils::{format, log};
use ymirc::lexing::{word, tokens};

/**
 * DefValidation module
 *
 * Provides semantic validation for `def` declarations. Responsibilities:
 *
 *   - validate type definitions,
 *   - validate value definitions,
 *   - detect and report forward-reference cycles,
 *   - wrap errors in VALIDATING_SYMBOL diagnostics,
 *   - construct generator values for defs,
 *   - reject unaddressable values(e.g., constructor delegates),
 *   - ensure type definitions resolve to complete types.
 *
 */
pub mod DefValidation {

    /**
     * Validate a `def` symbol, dispatching to either validateType() or
     * validateValue() depending on whether the definition is a type or a value.
     *
     * Responsibilities:
     *   - detect forward-reference cycles using DefContext,
     *   - prevent infinite recursion by limiting validation depth,
     *   - wrap errors in VALIDATING_SYMBOL diagnostics,
     *   - store the resulting generator(Type, Value, or ErrorGenerator).
     *
     * @params:
     *   - context: validation context
     *   - sym:     DefSymbol to validate
     *
     * @throws:
     *   - ErrorMsg if validation fails or forward reference is detected
     */
    pub fn validate(dmut context: &ValidationContext, dmut sym: &DefSymbol)
        throws ErrorMsg
    {
        match sym.generator {
            Value() => return;
            Type() => return;
            e: &ErrorGenerator => {
                throw e.msg;
            }
        }

        logging::info("Validate def %", sym.path);
        let validationLevel = context.defContext.level(sym);
        let maxLevel = if sym.decl.isValue {
            1u32
        } else {
            3u32
        };

        if validationLevel >= maxLevel {
            let error = copy ErrorMsg::fatal(sym.loc, format(ValidateErrorMessage::FORWARD_REFERENCE_AKA, sym.path));
            sym.generator = copy ErrorGenerator(sym.loc, error);
            throw error;
        }

        context.defContext:.set(sym, validationLevel + 1);
        {
            if (sym.decl.isValue) {
                DefValidation::validateValue(alias context, alias sym);
            } else {
                DefValidation::validateType(alias context, alias sym);
            }
        } catch {
            err: &ErrorMsg => {
                context.defContext:.remove(sym);
                throw err;
            }
        }

        if validationLevel == 0 {
            context.defContext:.remove(sym);
        }
    }

    /**
     * Validate a type definition(`def T: TypeExpr`).
     *
     * Responsibilities:
     *   - validate the type expression,
     *   - ensure the resulting type is complete,
     *   - allow class references and class pointers(with struct restriction),
     *   - wrap errors in VALIDATING_SYMBOL diagnostics,
     *   - store the resulting type as the generator.
     *
     * @params:
     *   - context: validation context
     *   - sym:     DefSymbol representing a type definition
     *
     * @throws:
     *   - ErrorMsg if type validation fails
     */
    fn validateType(dmut context: &ValidationContext, dmut sym: &DefSymbol)
        throws ErrorMsg
    {
        context:.pushReferent(alias sym);
        context:.enterForeign(isFnBody-> false);

        let mut errors: (&ErrorMsg)? = none;
        let mut type: &Type = NONE_TYPE;
        {
            let t = TypeValidation::validate(alias context, sym.decl.content, parentMutable-> false);
            if t of ClassRefType {
                type = t;
            }
            else if let c: &ClassPtrType = t {
                if (!c.sym.isStruct) {
                    throw copy ErrorMsg::fatal(sym.decl.content.loc, format(ValidateErrorMessage::CLASS_THROW_PTR, c));
                }

                type = c.inner;
            }
            else {
                TypeVerification::verifyComplete(sym.decl.content.loc, t, false);
                type = t;
            }
        } catch {
            err => {
                errors = (err)?;
            }
        } exit {
            context:.exitForeign();
            context:.popReferent();
        }

        if let Ok(err) = errors {
            let error = copy ErrorMsg::fatal(sym.loc, format(ValidateErrorMessage::VALIDATING_SYMBOL, sym.path),
                                             notes-> copy [err]);

            sym.generator = copy ErrorGenerator(sym.loc, error);
            throw error;
        }

        sym.generator = type.clone(mutLevel-> 0u32);
    }

    /**
     * Validate a value definition(`def x = expr`).
     *
     * Responsibilities:
     *   - validate the value expression,
     *   - reject unaddressable values(e.g., constructor delegates),
     *   - wrap errors in VALIDATING_SYMBOL diagnostics,
     *   - store the resulting value as the generator.
     *
     * @params:
     *   - context: validation context
     *   - sym:     DefSymbol representing a value definition
     *
     * @throws:
     *   - ErrorMsg if validation fails or value is unaddressable
     */
    fn validateValue(dmut context: &ValidationContext, dmut sym: &DefSymbol)
        throws ErrorMsg
    {
        let mut errors: (&ErrorMsg)? = none;
        context:.pushReferent(alias sym);
        context:.enterForeign(isFnBody-> false);

        let mut value: &Value = UNIT_VALUE;
        {
            let loc = sym.decl.content.loc;
            let v = ValueValidation::validate(alias context, sym.decl.content);

            if (DefValidation::checkUnaddressableValue(v)) {
                throw copy ErrorMsg::fatal(sym.loc, end-> loc, format(ValidateErrorMessage::AKA_CLASS_CTOR),
                                           notes-> copy [copy ErrorMsg::note(loc, oneLine-> true, format(ValidateErrorMessage::MAYBE_TYPE_AKA))]);
            }

            value = v;
        } catch {
            err: &ErrorMsg => {
                errors = (err)?;
            }
        } exit {
            context:.exitForeign();
            context:.popReferent();
        }

        if let Ok(err) = errors {
            let error = copy ErrorMsg::fatal(sym.loc, format(ValidateErrorMessage::VALIDATING_SYMBOL, sym.path),
                                             notes-> copy [err]);
            sym.generator = copy ErrorGenerator(sym.loc, error);
            throw error;
        }

        sym.generator = value;
    }

    /**
     * Determine whether a value is unaddressable and therefore invalid as a
     * `def` initializer.
     *
     * Unaddressable values include:
     *   - CtorDelegateValue,
     *   - CtorDelegateTemplateValue,
     *   - any MultSymValue containing an unaddressable value.
     *
     * These values represent constructor delegates, which cannot be bound to
     * a `def` because they do not represent stable, addressable storage.
     *
     * @params:
     *   - v: value to inspect
     *
     * @returns:
     *   - true if the value is unaddressable
     *   - false otherwise
     */
    fn checkUnaddressableValue(v: &Value)-> bool {
        if v of CtorDelegateValue || v of CtorDelegateTemplateValue {
            return true;
        }

        if let m: &MultSymValue = v {
            for i in m.values {
                if checkUnaddressableValue(i) {
                    return true;
                }
            }
        }

        return false;
    }
}
