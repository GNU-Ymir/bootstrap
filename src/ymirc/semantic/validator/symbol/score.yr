in score;

/**
 * Scoring values used when comparing or matching types.
 *
 * Higher scores indicate a stronger or more specific match.
 *
 */
pub enum
// score for a type that does not require rewriting.
| TYPE_NO_CHANGE = 4u32

// score for a type match
| TYPE           = 3u32

// score for a type match that has to wrap the value(e.g. a lambda or a function
// pointer bound to a delegate, that closes it over an empty closure)
| TYPE_WRAP      = 2u32

// score for a mutability match
| MUT            = 1u32
-> Scores;


/**
 * Scoring values used during template specialization matching.
 *
 * Higher scores indicate a more specific or more desirable match.
 *
 */
pub enum
// match on a variable.
| VAR   = 1u32

// match on a type.
| TYPE  = 2u32

// match on a compile-time value
| VALUE = 3u32
-> TemplateScore;
