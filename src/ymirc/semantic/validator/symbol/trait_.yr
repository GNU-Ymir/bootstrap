in trait_;

use ymirc::semantic::{validator, symbol, template_};
use ymirc::syntax::{expression::_, declaration::_};
use ymirc::semantic::generator::type::_;

use ymirc::lexing::word;

use ymirc::errors;
use ymirc::utils::{format, log};

/**
 * TraitValidation module
 *
 * Provides semantic validation for trait declarations. Responsibilities:
 *
 *   - validate conditional declaration blocks,
 *   - evaluate compile-time conditions,
 *   - declare inner trait members based on condition results,
 *   - validate compile-time assertions,
 *   - construct TraitRefType values,
 *   - ensure traits are validated only once.
 *
 */
pub mod TraitValidation {

    /**
     * Validate a trait symbol and return its TraitRefType.
     *
     * Responsibilities:
     *   - ensure the trait is validated only once,
     *   - validate conditional blocks,
     *   - validate compile-time assertions,
     *   - mark the trait as validated,
     *   - return a TraitRefType referencing the trait.
     *
     * @params:
     *   - context: validation context
     *   - sym:     TraitSymbol to validate
     *
     * @returns:
     *   - TraitRefType referencing the validated trait
     *
     * @throws:
     *   - ErrorMsg if validation fails
     */
    pub fn validate(dmut context: &ValidationContext, dmut sym: &TraitSymbol)-> &Type
        throws ErrorMsg
    {
        if (!sym.isValidated) {
            TraitValidation::validateCondBlocks(alias context, alias sym);
            TraitValidation::validateAssertions(alias context, alias sym);
            sym:.setValidated(true);
        }

        return copy TraitRefType(sym.loc, sym);
    }

    /**
     * Validate all conditional declaration blocks inside a trait.
     *
     * Responsibilities:
     *   - evaluate compile-time conditions,
     *   - include or exclude declarations based on condition results,
     *   - recursively process nested conditional blocks,
     *   - declare inner trait members for active branches,
     *   - finalize trait declarations after successful validation.
     *
     * @params:
     *   - context: validation context
     *   - sym:     TraitSymbol
     *
     * @throws:
     *   - ErrorMsg::list if any conditional block fails
     */
    fn validateCondBlocks(dmut context: &ValidationContext, dmut sym: &TraitSymbol)
        throws ErrorMsg
    {
        if (sym.condBlockDecls.len == 0) {
            return;
        }

        let mut errors: [&ErrorMsg] = [];
        {
            context:.pushReferent(alias sym);
            context:.enterForeign(isFnBody-> false);

            for decl in sym.condBlockDecls {
                {
                    TraitValidation::validateCondBlock(alias context, alias sym, decl);
                } catch {
                    err => {
                        errors ~= [err];
                    }
                }
            }

            if (errors.len == 0) {
                {
                    context.declarator:.finalizeDeclaration(alias sym);
                } catch {
                    err => {
                        errors ~= [err];
                    }
                }
            }
        } exit {
            context:.exitForeign();
            context:.popReferent();
        }

        if errors.len != 0 {
            throw copy ErrorMsg::list(errors);
        }
    }

    /**
     * Validate a single conditional block or inner declaration.
     *
     * Behavior:
     *   - If the declaration is a CondBlockDecl:
     *        * evaluate its test expression,
     *        * recursively validate the active branch,
     *        * recursively validate the else branch if inactive.
     *   - Otherwise:
     *        * declare the inner trait member with PROTECTED visibility.
     *
     * @params:
     *   - context: validation context
     *   - sym:     TraitSymbol
     *   - decl:    Declaration(CondBlockDecl or inner declaration)
     *
     * @throws:
     *   - ErrorMsg if test expression or inner declaration is invalid
     */
    fn validateCondBlock(dmut context: &ValidationContext, dmut sym: &TraitSymbol, decl: &Declaration)
        throws ErrorMsg
    {
        if let c: &CondBlockDecl = decl {
            let val = ValueValidation::validate(alias context, c.test);
            let b = context.cteInterpret:.computeBool(val);
            if (b) {
                for innerDecl in c.decls {
                    TraitValidation::validateCondBlock(alias context, alias sym, innerDecl);
                }
            } else {
                TraitValidation::validateCondBlock(alias context, alias sym, c.else_);
            }
        }
        else {
            context.declarator:.declareInnerTrait(decl, alias sym,
                                                  protection-> Protection::PROTECTED);
        }
    }

    /**
     * Validate all compile-time assertions inside a trait.
     *
     * Responsibilities:
     *   - evaluate assertion expressions at compile time,
     *   - report errors for failing assertions,
     *   - aggregate all assertion errors.
     *
     * @params:
     *   - context: validation context
     *   - sym:     TraitSymbol
     *
     * @throws:
     *   - ErrorMsg::list if any assertion fails
     */
    fn validateAssertions(dmut context: &ValidationContext, dmut sym: &TraitSymbol)
        throws ErrorMsg
    {
        if (sym.assertions.len == 0) {
            return;
        }

        let mut errors: [&ErrorMsg] = [];
        {
            context:.pushReferent(alias sym);
            context:.enterForeign(isFnBody-> false);

            for a in sym.assertions {
                {
                    AssertValidation::validateCte(alias context, copy AssertExpr(a.loc, a.test, a.msg));
                } catch {
                    err => {
                        errors ~= [err];
                    }
                }
            }
        } exit {
            context:.popReferent();
            context:.exitForeign();
        }

        if errors.len != 0 {
            throw copy ErrorMsg::list(errors);
        }
    }
}
