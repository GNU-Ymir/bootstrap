 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in global;

use ymirc::syntax::{_, declaration::_, expression::_};
use ymirc::semantic::generator::{value::_, type::_, global};

use ymirc::semantic::{validator, symbol, generator::_};

use ymirc::errors;

use ymirc::utils::{format, log};
use ymirc::lexing::{word, tokens};

/**
 * GlobalVarValidation module
 *
 * Provides semantic validation for global variable declarations.
 * Responsibilities:
 *
 *   - validate extern global declarations,
 *   - validate module-local global declarations,
 *   - perform type validation and inference,
 *   - validate lazy initialization semantics,
 *   - verify memory ownership for global values,
 *   - detect forward-reference cycles,
 *   - construct GlobalVarGenerator entries,
 *   - insert generators into the validation context.
 *
 */
pub mod GlobalVarValidation {

    /**
     * Validate a global variable symbol.
     *
     * Responsibilities:
     *   - detect whether validation is required,
     *   - detect forward-reference cycles,
     *   - validate extern or local global content,
     *   - insert the resulting GlobalVarGenerator into the context
     *     (only for module-local globals).
     *
     * @params:
     *   - context:    validation context
     *   - sym:        GlobalVarSymbol to validate
     *   - inModule: whether the global belongs to the current module
     *
     * @throws:
     *   - ErrorMsg if validation fails
     */
    pub fn validate(dmut context: &ValidationContext, dmut sym: &GlobalVarSymbol, inModule: bool)
        throws ErrorMsg
    {
        if (!GlobalVarValidation::checkValidation(context, sym)) {
            GlobalVarValidation::validateGlobalContent(alias context, alias sym, inModule);
        }

        match sym.generator {
            g: &GlobalVarGenerator => {
                if (!sym.isExtern && inModule) {
                    context:.insertGenerator(alias sym, g);
                }
            }
            err: &ErrorGenerator => {
                throw err.msg;
            }
            _ => panic;
        }
    }

    /**
     * Validate the full content of a global variable declaration.
     *
     * Responsibilities:
     *   - insert the global into the validation set,
     *   - validate extern globals or lazy locals,
     *   - wrap errors in VALIDATING diagnostics,
     *   - remove the global from the validation set.
     *
     * @params:
     *   - context:    validation context
     *   - sym:        GlobalVarSymbol
     *   - inModule: whether the global belongs to the current module
     */
    fn validateGlobalContent(dmut context: &ValidationContext, dmut sym: &GlobalVarSymbol, inModule: bool) {
        logging::info("Validate global variable %", sym.path);

        sym.generator = copy ErrorGenerator(sym.loc, copy ErrorMsg::fatal(sym.loc, ValidateErrorMessage::FORWARD_REFERENCE_TYPE));
        context.globalVarContext:.insert(sym);

        context:.pushReferent(alias sym);
        context:.enterForeign(isFnBody-> false);

        {
            if (sym.isExtern) {
                GlobalVarValidation::validateExternal(alias context, alias sym);
            } else {
                GlobalVarValidation::validateLazyLocal(alias context, alias sym, inModule);
            }
        } catch {
            err => {
                sym.generator = copy ErrorGenerator(sym.loc, copy ErrorMsg::fatal(sym.loc, ValidateErrorMessage::VALIDATING,
                                                                                  notes-> copy [err]));
            }
        }

        context:.popReferent();
        context:.exitForeign();

        context.globalVarContext:.remove(sym);
    }

    /**
     * Validate an extern global variable declaration.
     *
     * Rules:
     *   - extern globals must not have an initializer,
     *   - extern globals must have an explicit type,
     *   - type must be valid for global storage,
     *   - mutability and lazy flags must be legal for globals.
     *
     * @params:
     *   - context: validation context
     *   - sym:     GlobalVarSymbol
     *
     * @throws:
     *   - ErrorMsg if extern global is invalid
     */
    fn validateExternal(dmut context: &ValidationContext, dmut sym: &GlobalVarSymbol)
        throws ErrorMsg
    {
        let v = sym.decl.var;
        if v.value !of EmptyExpr {
            throw copy ErrorMsg::fatal(sym.loc, format(ValidateErrorMessage::EXTERN_GLOBAL_WITH_VALUE),
                                       end-> v.value.loc);
        }

        if v.type of EmptyExpr {
            throw copy ErrorMsg::fatal(sym.loc, format(ValidateErrorMessage::EXTERN_GLOBAL_NO_TYPE),
                                       end-> v.loc);
        }


        let type = TypeValidation::validateForVarDecl(alias context, v.type, v,
                                                      canBeRef-> false,
                                                      canBeLazy-> true);

        TypeVerification::verifyMutableGlobal(v.isMutOrDmut, type, v.isLazy);

        let gvar = copy GlobalVarGenerator(sym.loc, sym.path,
                                           type-> type,
                                           value-> UNIT_VALUE,
                                           isMutable-> (v.isMutable || v.isDeeplyMutable),
                                           isLazy-> v.isLazy,
                                           externLang-> sym.externLang,
                                           isWeak-> sym.isWeak,
                                           isThreadLocal-> false);
        sym.generator = gvar;
    }

    /**
     * Validate a module-local global variable with lazy initialization.
     *
     * Responsibilities:
     *   - validate initializer expression,
     *   - infer type if omitted,
     *   - validate declared type if present,
     *   - infer value for the declared type,
     *   - wrap the value in a LazyExpr and validate it,
     *   - verify memory ownership,
     *   - verify mutability rules for lazy globals,
     *   - construct a GlobalVarGenerator,
     *   - insert generator into the context if inModule.
     *
     * @params:
     *   - context:    validation context
     *   - sym:        GlobalVarSymbol
     *   - inModule: whether the global belongs to the current module
     *
     * @throws:
     *   - ErrorMsg if validation fails
     */
    fn validateLazyLocal(dmut context: &ValidationContext, dmut sym: &GlobalVarSymbol, inModule: bool)
        throws ErrorMsg
    {
        let v = sym.decl.var;
        if v.value of EmptyExpr {
            throw copy ErrorMsg::fatal(sym.loc, format(ValidateErrorMessage::GLOBAL_NO_VALUE),
                                       end-> v.loc);
        };

        let value = ValueValidation::validate(alias context, v.value);

        let mut declType: &Type = NONE_TYPE;

        if v.type of EmptyExpr {
            declType = TypeValidation::validateForVarDecl(alias context, copy TypeWrapperExpr(value.loc, value.type), v,
                                                          canBeRef-> false,
                                                          canBeLazy-> true);
        } else {
            declType = TypeValidation::validateForVarDecl(alias context, v.type, v,
                                                          canBeRef-> false,
                                                          canBeLazy-> true);
        }

        let finValue = TypeInference::inferValueForType(alias context, declType.loc, value, declType,
                                                        byReference-> false);

        let intrLazy = copy LazyExpr(finValue.loc, copy ValueWrapperExpr(v.loc, finValue));
        let lazyVal = LazyValidation::validate(alias context, intrLazy, canBeLazy-> true);
        MemoryVerification::verifyMemoryOwner(declType.loc, declType, lazyVal,
                                              construct-> true,
                                              byReference-> false,
                                              byLazy-> true);

        TypeVerification::verifyMutableGlobal(v.isMutOrDmut, declType, isLazy-> true);

        let gvar = copy GlobalVarGenerator(sym.loc, sym.path,
                                           type-> declType,
                                           value-> lazyVal,
                                           isMutable-> (v.isMutable || v.isDeeplyMutable),
                                           isLazy-> true,
                                           isWeak-> sym.isWeak,
                                           isThreadLocal-> sym.isThreadLocal);

        sym.generator = gvar;
        if (inModule) {
            context:.insertGenerator(alias sym, gvar);
        }
    }

    /**
     * Determine whether a global variable is already validated or in validation.
     *
     * @params:
     *   - context: validation context
     *   - sym:     GlobalVarSymbol
     *
     * @returns:
     *   - true if the global is already validated or in validation,
     *   - false otherwise
     */
    fn checkValidation(context: &ValidationContext, sym: &GlobalVarSymbol)-> bool {
        if sym.generator !of EmptyGenerator {
            return sym in context.globalVarContext;
        }
        return true;
    }
}
