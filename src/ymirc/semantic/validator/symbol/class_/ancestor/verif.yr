in verif;

use ymirc::semantic::{symbol, declarator, validator};
use ymirc::semantic::generator::{value::_, type::_};
use ymirc::errors::_;
use ymirc::lexing::{word, keys};

use ymirc::utils::format;

/**
 * ClassAncestorVerification module
 *
 * Provides recursive-inheritance detection for class declarations.
 * Responsibilities:
 *
 *   - walk the ancestor chain of a class,
 *   - detect cycles where a class inherits from itself,
 *   - produce diagnostic notes showing the inheritance path,
 *   - throw RECURSIVE_ANCESTOR errors when cycles are found.
 *
 * This module is used by ClassAncestorValidation after resolving the
 * ancestor type expression.
 */
pub mod ClassAncestorVerification {

    /**
     * Detect recursive inheritance cycles.
     *
     * A class cannot inherit, directly or indirectly, from itself. This
     * function walks the ancestor chain and reports an error if the starting
     * class symbol is encountered again.
     *
     * @params:
     *   - cref: ClassRefType representing the class to check
     *
     * @throws:
     *   - ErrorMsg if recursive inheritance is detected
     */
    pub fn verifyRecursiveAncestor(cref: &ClassRefType)
        throws ErrorMsg
    {
        let mut curr = cref;
        let mut error = false;
        loop {
            if let Ok(anc) = curr.ancestor {
                if anc.sym == cref.sym {
                    error = true;
                    break;
                }

                curr = anc;
            } else break;
        }

        if error {
            curr = cref;
            let dmut notes: [&ErrorMsg] = [];
            loop {
                notes ~= [copy ErrorMsg::note(curr.loc, format(ValidateErrorMessage::VALIDATING_SYMBOL, curr))];
                if let Ok(anc) = curr.ancestor && anc.sym != cref.sym {
                    curr = anc;
                } else break;
            }

            throw copy ErrorMsg::fatal(curr.loc, format(ValidateErrorMessage::RECURSIVE_ANCESTOR, cref));
        }
    }
}
