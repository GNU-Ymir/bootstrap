in verif;

use ymirc::errors;
use ymirc::semantic::generator::type::temporary;
use ymirc::utils::format;

/**
 * ClassAncestorVerification module
 *
 * Provides recursive-inheritance detection for class declarations.
 * Responsibilities:
 *
 *   - walk the ancestor chain of a class,
 *   - detect cycles where a class inherits from itself,
 *   - throw RECURSIVE_ANCESTOR errors when cycles are found.
 *
 * This module is used by ClassAncestorValidation after resolving the
 * ancestor type expression.
 */
pub mod ClassAncestorVerification {

    /**
     * Detect recursive inheritance cycles, before `ancestor` is installed as the ancestor of `cref`.
     * The installed ancestor chains being acyclic, walking the chain of `ancestor` terminates, and
     * installing it creates a cycle iff that chain reaches `cref`.
     *
     * @params:
     *   - cref:     ClassRefType representing the class to check
     *   - ancestor: the ancestor about to be installed
     *
     * @throws:
     *   - ErrorMsg if recursive inheritance is detected
     */
    pub fn verifyRecursiveAncestor(cref: &ClassRefType, ancestor: &ClassRefType)
        throws ErrorMsg
    {
        let mut curr = ancestor;
        loop {
            if curr.sym == cref.sym {
                throw copy ErrorMsg::fatal(cref.loc, format(ValidateErrorMessage::RECURSIVE_ANCESTOR, cref));
            }

            if let Ok(anc) = curr.ancestor {
                curr = anc;
            } else break;
        }
    }
}
