 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in finalize;

use ymirc::semantic::{validator, symbol, template_};

use ymirc::syntax::{expression::_, declaration::_};
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::lexing::{word, keys, tokens};

use ymirc::errors;
use ymirc::utils::{format, log};

/**
 * ClassFinalizer module
 *
 * Provides the finalization step for class symbols. Responsibilities:
 *
 *   - validate all methods added to the class,
 *   - validate constructors and destructors,
 *   - aggregate validation errors,
 *   - insert the finalized class generator,
 *   - propagate errors for template classes.
 *
 * Finalization is triggered after all class members have been declared and
 * prototype-validated. It ensures that the class is semantically complete
 * before code generation.
 */
pub mod ClassFinalizer {

    /**
     * Finalize all classes pending in the class-context finalization queue.
     *
     * Responsibilities:
     *   - retrieve all class symbols awaiting finalization,
     *   - validate each class via finalize(context, sym, cref),
     *   - aggregate and report all errors.
     *
     * @params:
     *   - context: validation context
     *
     * @throws:
     *   - ErrorMsg::list if any class fails finalization
     */
    pub fn finalize(dmut context: &ValidationContext)
        throws ErrorMsg
    {
        let dmut toFinalize = context.classContext:.popFinalize();
        let dmut errors: [&ErrorMsg] = [];

        for _, dmut sym in alias toFinalize {
            let r = sym.classRefUnwrapped;
            {
                logging::info("Finalize class symbol %", sym.path);
                ClassFinalizer::finalize(alias context, alias sym, r);
            } catch {
                err => {
                    errors ~= [err];
                }
            }
        }

        if errors.len != 0 {
            throw copy ErrorMsg::list(errors);
        }
    }

    /**
     * Finalize a single class symbol.
     *
     * Responsibilities:
     *   - validate all methods added to the class,
     *   - validate constructors,
     *   - validate destructors,
     *   - aggregate validation errors,
     *   - insert the finalized class generator,
     *   - propagate errors for template classes.
     *
     * @params:
     *   - context: validation context
     *   - sym:     ClassSymbol to finalize
     *   - cref:    ClassRefType representing the class
     *
     * @throws:
     *   - ErrorMsg if any method, constructor, or destructor fails validation
     */
    fn finalize(dmut context: &ValidationContext, dmut sym: &ClassSymbol, cref: &ClassRefType)
        throws ErrorMsg
    {
        let mut errors: [&ErrorMsg] = [];
        let dmut addMethods = alias sym.addMethods;
        for i in 0us .. addMethods.len {
            {
                match alias(addMethods[i]) {
                    dmut funcSym: &FunctionSymbol => { // Simply validate all the new symbols of the class
                        MethodValidation::validate(alias context, alias funcSym, cref);
                    }
                    dmut ctorSym: &CtorSymbol => { // Validate the constructor symbol
                        CtorValidation::validate(alias context, alias ctorSym, cref);
                    }
                    dmut dtorSym: &DtorSymbol => {
                        DtorValidation::validate(alias context, alias dtorSym, cref);
                    }
                    _ => panic; // we inserted a symbol that is not a function in the addMethods ??
                }
            } catch {
                e => {
                    errors ~= [e];
                }
            }
        }

        if (errors.len != 0us) { // error validating the methods
            let error = copy ErrorMsg::fatal(sym.loc, format(ValidateErrorMessage::VALIDATING),
                                             notes-> errors);

            context:.insertMissingGenerator(error);
            if (sym.isTemplate) {
                sym.errorGenerator = copy ErrorGenerator(sym.loc, error);
            }

            throw error;
        }

        context:.insertGenerator(alias sym, cref);
    }
}
