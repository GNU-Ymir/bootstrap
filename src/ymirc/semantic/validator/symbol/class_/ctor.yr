in ctor;

use ymirc::syntax::{declaration::_, expression::_};
use ymirc::semantic::{symbol, declarator, validator};
use ymirc::semantic::generator::{value::_, type::_};
use ymirc::errors;
use ymirc::lexing::{word, keys};

use ymirc::utils::format;
use ymirc::semantic::validator::symbol::class_::ctor::_;


/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

mod ::verif;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          ROOT          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * ClassCtorValidation module
 *
 * Provides the main validation pipeline for class constructors. Responsibilities:
 *
 *   - validate all constructor prototypes declared in the class,
 *   - detect ambiguous or duplicate constructor overloads,
 *   - validate template constructor prototypes,
 *   - synthesize default constructors for movable entities,
 *   - enforce field-initialization rules for default constructors,
 *   - install constructor lists into the ClassRefType.
 *
 */
pub mod ClassCtorValidation {

    /**
     * Validate all constructors declared in the class.
     *
     * @params:
     *   - context:   validation context
     *   - sym:       class symbol
     *   - inModule:  whether constructors should be added to add-method list
     *   - withValue: whether constructor bodies should be validated
     *
     * @throws:
     *   - ErrorMsg::list if any constructor prototype fails validation
     */
    pub fn validate(dmut context: &ValidationContext,
                    dmut sym:     &ClassSymbol,
                    inModule:     bool,
                    withValue:    bool)
        throws ErrorMsg
    {
        let dmut cref = alias sym.classRefUnwrapped;

        let mut errors: [&ErrorMsg] = [];
        let mut ctors: [&CtorPrototypeValue] = []; // list of ctor prototypes
        let mut ctorProts: [MethodProtection] = []; // Protection of constructors

        let mut templateCtors: [&TemplateRefCtorValue] = [];
        let mut templateCtorProts: [MethodProtection] = [];

        for it in sym.getAllLocalSymbols(protection-> Protection::PRIVATE, sorted-> true) {
            {
                if let ctor: &CtorSymbol = it {
                    let dmut mutCtor = context:.getCtorFromRef(ctor);
                    ClassCtorValidation::validateProto(alias context, alias mutCtor, cref,
                                                       withValue-> withValue,
                                                       ref ctors,
                                                       ref ctorProts);
                    if inModule {
                        sym:.insertAddMethod(alias mutCtor);
                    }
                }

                else if let tmp: &TemplateSymbol = it {
                    if tmp.decl.decl of CtorDecl {
                        ClassCtorValidation::validateTemplateProto(tmp, cref,
                                                                   ref templateCtors,
                                                                   ref templateCtorProts);
                    }
                }
            } catch {
                err => {
                    errors ~= [err];
                }
            }
        }

        if (errors.len != 0us) {
            throw copy ErrorMsg::list(errors);
        }

        cref:.setCtors(ctors, ctorProts);
        cref:.setTemplateCtors(templateCtors, templateCtorProts);
    }

    /**
     * Ensure that movable entities have a default constructor.
     *
     * @params:
     *   - context:  validation context
     *   - sym:      class symbol
     *   - inModule: whether to insert the synthesized constructor into add-methods
     *
     * @throws:
     *   - ErrorMsg if default constructor synthesis fails
     */
    pub fn validateMovable(dmut context: &ValidationContext,
                           dmut sym:     &ClassSymbol,
                           inModule:     bool)
        throws ErrorMsg
    {
        if (!sym.isEntity) {
            return;
        }

        let dmut cref = alias sym.classRefUnwrapped;
        let oldCtors = cref.ctors;
        let oldCtorProts = cref.ctorProtections;

        let mut hasDefault = false;
        for ct in oldCtors if ct.name == "" && ct.params.len == 0 {
            hasDefault = true;
            break;
        }

        if (!hasDefault) {
            {
                let nCtor = ClassCtorValidation::createDefaultEmpty(alias context, alias sym, cref,
                                                                    inModule-> inModule);
                cref:.setCtors(oldCtors ~ [nCtor], oldCtorProts ~ [MethodProtection::PUB]);
            } catch {
                err => {
                    throw copy ErrorMsg::fatal(sym.loc, format(ValidateErrorMessage::NO_DEFAULT_CTOR_MOVE_STRUCT, sym.path),
                                               notes-> copy [err]);
                }
            }
        }
    }

    /**
     * Ensure that a class asking for it has a constructor built from its fields.
     *
     * A `@data` record asks for that ctor by its attribute, any other class,
     * record or entity asks for it by declaring `self;`.
     *
     * @params:
     *   - context:  validation context
     *   - sym:      class symbol
     *   - inModule: whether to insert the synthesized constructor into add-methods
     *   - precary:  whether the fields were validated without their values
     *
     * @throws:
     *   - ErrorMsg if default constructor synthesis fails
     *
     */
    pub fn validateGenerated(dmut context: &ValidationContext,
                             dmut sym:     &ClassSymbol,
                             inModule:     bool,
                             precary:      bool)
        throws ErrorMsg
    {
        // In a precary validation the field values are left unvalidated, so there is
        // nothing to build the ctor from. The class is validated again afterwards.
        if (precary) {
            return;
        }

        // The two ways of asking are exclusive, the declarator rejects a `self;`
        // inside a `@data` record. Only the attribute asks implicitly: it names no
        // ctor, so the one it asks for yields to a ctor written by hand, where the
        // `self;` is a declaration of its own and collides with it.
        let mut loc: &Word = sym.loc;
        let mut prot = Protection::PUBLIC;
        let mut implicit = true;

        if let Ok((rLoc, rProt)) = sym.generatedCtor {
            loc = rLoc;
            prot = rProt;
            implicit = false;
        } else if (!sym.isData) {
            return;
        }

        let dmut cref = alias sym.classRefUnwrapped;
        let oldCtors = cref.ctors;
        let oldCtorProts = cref.ctorProtections;

        let nCtorOpt = ClassCtorValidation::createDefaultWithParams(alias context, alias sym, cref,
                                                                    loc-> loc,
                                                                    inModule-> inModule,
                                                                    protection-> prot,
                                                                    implicit-> implicit,
                                                                    ctorList-> oldCtors);
        if let Ok(nCtor) = nCtorOpt {
            cref:.setCtors(oldCtors ~ [nCtor], oldCtorProts ~ [to!{MethodProtection}(prot)]);
        }
    }

    /**
     * Validate a single constructor prototype and detect overload conflicts.
     *
     * @params:
     *   - context:    validation context
     *   - ctor:       constructor symbol
     *   - cref:       class reference type
     *   - withValue:  whether to validate constructor bodies
     *   - ctorList:   accumulator for validated constructor prototypes
     *   - ctorProts:  accumulator for constructor protections
     *
     * @throws:
     *   - ErrorMsg if the constructor conflicts with an existing overload
     */
    fn validateProto(dmut context:      &ValidationContext,
                     dmut ctor:         &CtorSymbol,
                     cref:              &ClassRefType,
                     withValue:         bool,
                     ref mut ctorList:  [&CtorPrototypeValue],
                     ref mut ctorProts: [MethodProtection])
        throws ErrorMsg
    {
        let proto = CtorValidation::validateProto(alias context, alias ctor, cref,
                                                  withValue-> withValue);
        for it in ctorList {
            if ClassCtorVerification::areSimilar(proto, it) {
                throw copy ErrorMsg::fatal(proto.loc, format(ValidateErrorMessage::COLLIDING_METHOD_DEFINITION, proto, it),
                                           end-> it.loc);
            }
        }

        ctorList ~= [proto];
        ctorProts ~= [to!{MethodProtection}(ctor.protection)];
    }

    /**
     * Validate a template constructor prototype.
     *
     * @params:
     *   - ctor:      template symbol representing a constructor
     *   - cref:      class reference type
     *   - ctorList:  accumulator for template constructor references
     *   - ctorProts: accumulator for constructor protections
     */
    fn validateTemplateProto(ctor:              &TemplateSymbol,
                             cref:              &ClassRefType,
                             ref mut ctorList:  [&TemplateRefCtorValue],
                             ref mut ctorProts: [MethodProtection])
    {
        ctorList ~= [copy TemplateRefCtorValue(ctor.loc, cref.sym, ctor)];
        ctorProts ~= [to!{MethodProtection}(ctor.protection)];
    }

    /**
     * Synthesize a default constructor for a movable entity.
     *
     * @params:
     *   - context:  validation context
     *   - sym:      class symbol
     *   - cl:       class reference type
     *   - inModule: whether to insert the constructor into add-methods
     *
     * @returns:
     *   - the validated constructor prototype
     *
     * @throws:
     *   - ErrorMsg::list if any field is uninitialized
     *   - ErrorMsg if prototype validation fails
     */
    fn createDefaultEmpty(dmut context: &ValidationContext,
                          dmut sym:     &ClassSymbol,
                          cl:           &ClassRefType,
                          inModule: bool)-> &CtorPrototypeValue
        throws ErrorMsg
    {
        let mut errors: [&ErrorMsg] = [];
        for fi in cl.localFields if fi.value of UnitValue {
            errors ~= [copy ErrorMsg::fatal(fi.loc, format(ValidateErrorMessage::UNINIT_FIELD, fi.name))];
        }

        if (errors.len != 0us) {
            throw copy ErrorMsg::list(errors);
        }

        let rename = sym.loc.locate(Keys::SELF);
        let proto = FunctionPrototype([], EMPTY_EXPR, false);
        let body = copy BlockExpr(rename, rename, []);

        let ctor = copy CtorDecl(loc-> rename,
                                 comm-> "",
                                 rename-> EOF_WORD,
                                 proto-> proto,
                                 redirect-> none,
                                 fields-> [],
                                 body-> body,
                                 attrs-> [],
                                 throwers-> [],
                                 throwerLoc-> EOF_WORD);

        let dmut ctorSym: &CtorSymbol = context.declarator.declareCtor(ctor, alias sym,
                                                                       protection-> Protection::PUBLIC,
                                                                       insert-> false);
        let ctProto = CtorValidation::validateProto(alias context, alias ctorSym, cl);
        if inModule {
            sym:.insertDefaultCtor(alias ctorSym);
        }

        return ctProto;
    }

    /**
     * Synthesize the constructor of a class from its fields.
     *
     * Every public field becomes a parameter of the constructor, in declaration
     * order, and every field is set in the `with` part of the constructor - from
     * its parameter, or from the default value it declares when the field is not
     * public.
     *
     * @params:
     *   - context:    validation context
     *   - sym:        class symbol
     *   - cl:         class reference type
     *   - loc:        the location of the request, the `self;` or the class itself
     *   - inModule:   whether to insert the constructor into add-methods
     *   - protection: the protection of the synthesized constructor
     *   - implicit:   whether the class asked for the ctor by its `@data` attribute
     *   - ctorList:   the constructors already declared by the class
     *
     * @returns:
     *   - the validated constructor prototype, or none if the class asked
     *     implicitly and already declares a constructor with the same signature
     *
     * @throws:
     *   - ErrorMsg::list if a field that is not public has no default value
     *   - ErrorMsg if the request is explicit and collides with a declared ctor
     *   - ErrorMsg if prototype validation fails
     */
    fn createDefaultWithParams(dmut context: &ValidationContext,
                               dmut sym:     &ClassSymbol,
                               cl:           &ClassRefType,
                               loc:          &Word,
                               inModule:     bool,
                               protection:   Protection,
                               implicit:     bool,
                               ctorList:     [&CtorPrototypeValue])-> (&CtorPrototypeValue)?
        throws ErrorMsg
    {
        let mut errors: [&ErrorMsg] = [];
        let mut params: [&VarDeclExpr] = [];
        let mut setters: [FieldCtor] = [];
        let mut throwers: [&Expression] = [];
        let mut thrownTypes: [&Type] = [];

        for fi in cl.localFields {
            if (!sym.isFieldPublic(fi.name)) {
                // A field that is not public is not exposed as a parameter, it is
                // always constructed from the default value it declares
                if (fi.value of UnitValue) {
                    errors ~= [copy ErrorMsg::fatal(fi.loc, format(ValidateErrorMessage::GEN_CTOR_HIDDEN_FIELD_NO_VALUE, fi.name))];
                    continue;
                }

                setters ~= [FieldCtor(fi.loc, fi.loc, copy ValueWrapperExpr(fi.loc, fi.value))];

                // That value is constructed inside the ctor, so the ctor throws whatever it throws
                for th in fi.value.throwers if !ClassCtorValidation::containsType(thrownTypes, th.type) {
                    thrownTypes ~= [th.type];
                    throwers ~= [copy TypeWrapperExpr(th.loc, th.type, asIs-> true)];
                }
            } else {
                let (param, setter) = ClassCtorValidation::createDefaultFieldCtor(fi);
                params ~= [param];
                setters ~= [setter];
            }
        }

        let rename = loc.locate(Keys::SELF);
        let proto = FunctionPrototype(params, EMPTY_EXPR, false);
        let body = copy BlockExpr(rename, rename, []);

        let ctor = copy CtorDecl(loc-> rename,
                                 comm-> "",
                                 rename-> EOF_WORD,
                                 proto-> proto,
                                 redirect-> none,
                                 fields-> setters,
                                 body-> body,
                                 attrs-> [],
                                 throwers-> throwers,
                                 throwerLoc-> rename);

        let dmut ctorSym: &CtorSymbol = context.declarator.declareCtor(ctor, alias sym,
                                                                       protection-> protection,
                                                                       insert-> false);
        let ctProto = CtorValidation::validateProto(alias context, alias ctorSym, cl);

        for it in ctorList if ClassCtorVerification::areSimilar(ctProto, it) {
            // A `self;` declares that ctor, so a ctor written by hand with the same
            // signature declares it twice - where a `@data` attribute names no ctor
            // at all, and the one it asks for is simply dropped
            if (implicit) {
                return none;
            }

            throw copy ErrorMsg::fatal(ctProto.loc, format(ValidateErrorMessage::COLLIDING_METHOD_DEFINITION, ctProto, it),
                                       end-> it.loc);
        }

        // We throw errors only if a default ctor is inserted
        if (errors.len != 0us) {
            throw copy ErrorMsg::list(errors);
        }

        if inModule {
            sym:.insertDefaultCtor(alias ctorSym);
        }

        return ctProto?;
    }

    /**
     * Create the parameter and the field setter of a field that is exposed by
     * the generated constructor.
     *
     * The parameter is declared from the field itself, wrapping its type as is -
     * the type is what describes the inner mutability, so the parameter is only
     * decorated `mut` when that type needs an explicit alias.
     *
     * @params:
     *    - field: the validated field
     *
     * @returns:
     *    - .0: the parameter decl to put in the ctor prototype
     *    - .1: the setter of the field to put in the field construction part of the ctor
     */
    fn createDefaultFieldCtor(field: &VarDeclValue)-> (&VarDeclExpr, FieldCtor) {
        // The mutability of the field is kept only when it borrows mutable data: a
        // parameter is what the field is constructed from, it has no reason to be
        // mutable otherwise
        let needsMut = field.varType.needsExplicitAlias;
        let type = copy TypeWrapperExpr(field.loc, field.varType, asIs-> needsMut);
        let value: &Expression = if (field.value of UnitValue) {
            EMPTY_EXPR
        } else {
            copy ValueWrapperExpr(field.loc, field.value)
        };

        let param = copy VarDeclExpr(loc-> field.loc,
                                     name-> field.loc,
                                     value-> value,
                                     type-> type,
                                     isMutOrDmut-> if (needsMut) { field.loc.locate(Keys::MUTABLE) } else { EOF_WORD },
                                     isLazyOrRef-> EOF_WORD);

        return (param, FieldCtor(field.loc, field.loc, copy VarExpr(field.loc, isQuoted-> field.loc.isString)));
    }

    /**
     * @returns: true iff `type` is already listed in `types`
     */
    fn containsType(types: [&Type], type: &Type)-> bool {
        for it in types if it == type {
            return true;
        }

        false
    }
}
