 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in ancestor;

use ymirc::semantic::symbol;
use ymirc::semantic::generator::type::_;
use ymirc::semantic::validator::symbol::class_::method::_;

/**
 * ClassMethodAncestorValidation module
 *
 * Provides the ancestor-vtable retrieval phase of method validation.
 *
 * Responsibilities:
 *   - copy ancestor vtable entries into the child vtable,
 *   - mark inherited entries as not requiring validation,
 *   - adjust protection levels(private → PRV_PARENT),
 *   - propagate ancestor template methods,
 *   - propagate ancestor-implemented traits.
 *
 */
pub mod ClassMethodAncestorValidation {

    /**
     * Copy ancestor vtable entries into the current class vtable.
     *
     * @params:
     *   - ancestor: optional ClassRefType of the parent class
     *   - vtable:   the vtable being constructed
     */
    pub fn retreiveAncestorVtable(ancestor: (&ClassRefType)?, dmut vtable: &Vtable) {
        if let Ok(cref) = ancestor {
            let ancVtable = cref.vtable;
            let ancProts = cref.vtableProtections;
            let ancImpls = cref.allImplementedTraits;
            let ancTempl = cref.templateMethods;
            let ancTemplPr = cref.templateMethodProtections;

            vtable.methods ~= ancVtable;
            vtable.methodsToValidate ~= copy [alias EMPTY_SYMBOL ; ancVtable.len];

            for j in ancProts { // Insert the protection in the vtable of the current class
                if (j == MethodProtection::PRV) {
                    vtable.methodProts ~= [MethodProtection::PRV_PARENT];  // private methods are not accessible in child class
                } else {
                    vtable.methodProts ~= [j];
                }
            }

            vtable.templateMethods ~= ancTempl;
            vtable.templateMethodProts ~= ancTemplPr;
            vtable.ancestorImplementedTraits ~= ancImpls;
        }
    }
}
