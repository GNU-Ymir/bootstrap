in model;

use ymirc::semantic::generator::{value::_, type::_};
use ymirc::semantic::symbol;

pub class Vtable {

    /**
     * List of concrete method prototypes declared or inherited by the class.
     */
    pub let mut methods: [mut &MethodPrototypeValue] = [];

    /**
     * Protection levels associated with each entry in `methods`.
     *
     * The index of each protection corresponds to the index of the method
     * in `methods`.
     */
    pub let mut methodProts: [mut MethodProtection] = [];

    /**
     * List of template method references declared in the class.
     */
    pub let mut templateMethods: [mut &TemplateRefMethodValue] = [];

    /**
     * Protection levels associated with each entry in `templateMethods`.
     */
    pub let mut templateMethodProts: [mut MethodProtection] = [];

    /**
     * List of traits implemented by the parent class.
     */
    pub let mut ancestorImplementedTraits: [mut &TraitRefType] = [];

    /**
     * List of traits implemented directly by the class.
     */
    pub let mut localImplementedTraits: [mut &TraitRefType] = [];

    /**
     * List of symbols were introduce by the currently validated class, and
     * require body validation.
     */
    pub let dmut methodsToValidate: [&Symbol] = [];

    /**
     * Default constructor for Vtable.
     *
     * Initializes all lists to empty. The vtable is populated during class
     * validation.
     */
    pub self () {}
}
