in verif;

use ymirc::semantic::{symbol, declarator, validator};
use ymirc::semantic::generator::{value::_, type::_};
use ymirc::errors;
use ymirc::lexing::{word, keys};

use ymirc::utils::format;


/**
 * ClassCtorVerification module
 *
 * Centralizes constructor-specific semantic verification.
 *
 */
pub mod ClassCtorVerification {

    /**
     * Determine whether two constructor prototypes are structurally similar.
     *
     * @params:
     *   - left:  first constructor prototype
     *   - right: second constructor prototype
     *
     * @returns:
     *   - true  if the constructors are structurally similar,
     *   - false otherwise
     */
    pub fn areSimilar(left: &CtorPrototypeValue, right: &CtorPrototypeValue)-> bool {
        if (left.name != right.name) {
            return false;
        }

        if (left.params.len != right.params.len) {
            return false;
        }

        for i in 0us .. left.params.len {
            if (left.params[i].type != right.params[i].type) {
                return false;
            }

            if (!left.params[i].type.sameMutability(right.params[i].type)) {
                return false;
            }

            if (left.params[i].isLazy != right.params[i].isLazy) {
                return false;
            }

            if (left.params[i].isReference != right.params[i].isReference) {
                return false;
            }
        }

        return true;
    }
}
