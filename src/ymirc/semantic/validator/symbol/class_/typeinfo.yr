 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in typeinfo;


use ymirc::syntax::expression::_;
use ymirc::semantic::{symbol, declarator, validator};
use ymirc::semantic::generator::{value::_, type::_};
use ymirc::errors::_;

use ymirc::lexing::{word, keys};
use ymirc::global::_;

use ymirc::utils::format;

/**
 * ClassTypeInfoValidation module
 *
 * Provides construction and validation of TypeInfo metadata for classes.
 *
 */
pub mod ClassTypeInfoValidation {

    /**
     * Construct and install the TypeInfoValue for a class.
     *
     * @params:
     *   - context: validation context
     *   - sym:     class symbol
     *   - fake:    whether to skip size computation
     *
     * @throws:
     *   - ErrorMsg if TypeID computation fails or TypeSize validation fails
     */
    pub fn validate(dmut context: &ValidationContext,
                    dmut sym:     &ClassSymbol,
                    fake:         bool)
        throws ErrorMsg
    {
        let dmut cref = alias sym.classRefUnwrapped;
        let type = TypeCreation::createTypeInfo(alias context, sym.loc);
        let id = TypeCreation::createTypeID(alias context, sym.loc,
                                            if (sym.isStruct) { TypeInfoIDS::STRUCT } else { TypeInfoIDS::OBJECT });
        let idInt = {
            context.cteInterpret:.computeInt(id).to!{usize} ()
        } catch {
            _ => {
                throw copy ErrorMsg::fatal(id.loc, format(ValidateErrorMessage::MALFORMED_CORE));
            }
        };

        let mut size: usize = 0;
        if !fake {
            size = TypeSize::validate(alias context, sym.loc, cref).value.toT!{usize}();
        }

        let mut innerSlice: &Value = UNIT_VALUE;
        if let Ok(anc) = cref.ancestor {
            let ancType = copy ArrayType(sym.loc, type, 1, isMutable-> false);
            innerSlice = ValueCreation::createSliceAliasFromArray(sym.loc, ancType,
                                                                  copy ArrayValue(sym.loc, ancType, copy [anc.typeInfo]));
        } else {
            let ancType = copy ArrayType(sym.loc, type, 0, isMutable-> false);
            innerSlice = ValueCreation::createSliceAliasFromArray(sym.loc, ancType, copy ArrayValue(sym.loc, ancType, []));
        }

        let typeinfoFin = copy TypeInfoValue(sym.loc, type,
                                             idInt,
                                             size,
                                             innerSlice,
                                             sym.path.toStr());

        cref:.setTypeInfo(typeinfoFin);
    }
}
