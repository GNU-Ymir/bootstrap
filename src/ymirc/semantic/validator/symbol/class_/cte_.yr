 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in cte_;

use ymirc::semantic::{validator, symbol, template_};
use ymirc::syntax::{expression::_, declaration::_};
use ymirc::semantic::generator::type::_;

use ymirc::lexing::word;

use ymirc::errors::_;
use ymirc::utils::{format, log};

/**
 * ClassCteValidation module
 *
 * Provides compile-time validation for class declarations. Responsibilities:
 *
 *   - evaluate conditional blocks inside classes,
 *   - recursively process nested conditional blocks,
 *   - declare inner class members for active branches,
 *   - validate compile-time assertions,
 *   - ensure conditional blocks are validated only once.
 *
 * Class conditional blocks allow classes to include or exclude declarations
 * based on compile-time conditions, enabling metaprogramming patterns.
 */
pub mod ClassCteValidation {

    /**
     * Validate all compile-time constructs inside a class:
     *   - conditional blocks,
     *   - compile-time assertions.
     *
     * @params:
     *   - context: validation context
     *   - sym:     ClassSymbol
     *
     * @throws:
     *   - ErrorMsg if any conditional block or assertion fails
     */
    pub fn validate(dmut context: &ValidationContext, dmut sym: &ClassSymbol)
        throws ErrorMsg
    {
        if !sym.areCondBlockDeclsValidated {
            {
                ClassCteValidation::validateCondBlocks(alias context, alias sym);
                ClassCteValidation::validateAssertions(alias context, alias sym);
            } exit {
                sym:.setCondBlockValidated();
            }
        }
    }

    /**
     * Validate all compile-time assertions inside a class.
     *
     * @params:
     *   - context: validation context
     *   - sym:     ClassSymbol
     *
     * @throws:
     *   - ErrorMsg::list if any assertion fails
     */
    fn validateAssertions(dmut context: &ValidationContext, dmut sym: &ClassSymbol)
        throws ErrorMsg
    {
        if (sym.assertions.len == 0) {
            return;
        }

        context:.enterForeign(isFnBody-> false);
        let mut errors: [&ErrorMsg] = [];
        {
            for a in sym.assertions {
                AssertValidation::validateCte(alias context, copy AssertExpr(a.loc, a.test, a.msg));
            } catch {
                err => {
                    errors ~= [err];
                }
            }
        } exit {
            context:.exitForeign();
        }

        if errors.len != 0 {
            throw copy ErrorMsg::list(errors);
        }
    }

    /**
     * Validate all conditional declaration blocks inside a class.
     *
     * @params:
     *   - context: validation context
     *   - sym:     ClassSymbol
     *
     * @throws:
     *   - ErrorMsg::list if any conditional block fails
     */
    fn validateCondBlocks(dmut context: &ValidationContext, dmut sym: &ClassSymbol)
        throws ErrorMsg
    {
        if sym.condBlockDecls.len == 0 {
            return;
        }

        let mut errors: [&ErrorMsg] = [];
        {
            context:.enterForeign(isFnBody-> false);

            for it in sym.condBlockDecls {
                ClassCteValidation::validateCondBlock(alias context, alias sym, it);
            } catch {
                err => {
                    errors ~= [err];
                }
            }
            if (errors.len == 0) {
                context.declarator:.finalizeDeclaration(alias sym);
            } catch {
                err => {
                    errors ~= [err];
                }
            }
        } exit {
            context:.exitForeign();
        }

        if (errors.len != 0) {
            throw copy ErrorMsg::list(errors);
        }
    }

    /**
     * Validate a single conditional block or inner declaration inside a class.
     *
     * @params:
     *   - context: validation context
     *   - sym:     ClassSymbol
     *   - decl:    Declaration(CondBlockDecl or inner declaration)
     *
     * @throws:
     *   - ErrorMsg if test expression or inner declaration is invalid
     */
    fn validateCondBlock(dmut context: &ValidationContext, dmut sym: &ClassSymbol, decl: &Declaration)
        throws ErrorMsg
    {

        if let c: &CondBlockDecl = decl {
            let val = ValueValidation::validate(alias context, c.test);
            let b = context.cteInterpret:.computeBool(val);
            if (b) {
                for innerDecl in c.decls {
                    ClassCteValidation::validateCondBlock(alias context, alias sym, innerDecl);
                }
            } else {
                ClassCteValidation::validateCondBlock(alias context, alias sym, c.else_);
            }
        } else {
            context.declarator:.declareInnerClass(decl, alias sym,
                                                  protection-> Protection::PROTECTED);
        }
    }
}
