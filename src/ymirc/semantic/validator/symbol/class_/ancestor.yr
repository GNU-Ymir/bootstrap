in ancestor;

use ymirc::errors;
use ymirc::semantic::symbol;
use ymirc::semantic::generator::type::temporary;
use ymirc::semantic::validator::symbol::class_::ancestor::verif;
use ymirc::syntax::expression::empty;
use ymirc::utils::format;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

mod ::verif;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          ROOTS          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */


/**
 * ClassAncestorValidation module
 *
 * Provides semantic validation for class inheritance. Responsibilities:
 *
 *   - validate the ancestor expression of a class,
 *   - ensure the ancestor is a class type,
 *   - reject inheritance from final classes,
 *   - install the ancestor into the class reference,
 *   - verify recursive-ancestor correctness,
 *   - trigger layout validation of ancestor classes when needed.
 *
 */
pub mod ClassAncestorValidation {

    /**
     * Validate the ancestor of a class symbol.
     *
     * @params:
     *   - context: validation context
     *   - sym:     ClassSymbol whose ancestor is being validated
     *
     * @returns:
     *   - Ok(ClassRefType) if ancestor is valid
     *   - None if no ancestor is declared
     *
     * @throws:
     *   - ErrorMsg if ancestor is invalid or inheritance is illegal
     */
    pub fn validate(dmut context: &ValidationContext, dmut sym: &ClassSymbol)-> ((&ClassRefType)?)
        throws ErrorMsg
    {
        if sym.ancestor of EmptyExpr {
            return none;
        }

        let type = TypeValidation::validate(alias context, sym.ancestor);
        // an error was set to the type while validating its ancestor
        if let Ok(err) = sym.errorGenerator {
            throw err.msg;
        }

        if let ancRef: &ClassRefType = type { // The ancestor class must be a class, obviously
            if (ancRef.sym.isFinal) { // and it cannot be final
                throw copy ErrorMsg::fatal(sym.ancestor.loc, format(ValidateErrorMessage::INHERIT_FINAL_CLASS, ancRef));
            }

            let dmut cref = alias sym.classRefUnwrapped;
            ClassAncestorVerification::verifyRecursiveAncestor(cref, ancRef);
            cref:.setAncestor(ancRef);

            if !ancRef.hasTypeInfo {
                let dmut ancSym: &ClassSymbol = context:.getClassFromRef(ancRef.sym);
                ClassValidation::validateLayout(alias context, alias ancSym,
                                                inModule-> false,
                                                validationLevel-> 2u32);
            }

            return ancRef?;
        }

        throw copy ErrorMsg::fatal(sym.ancestor.loc, format(ValidateErrorMessage::INHERIT_NO_CLASS, type));
    }
}
