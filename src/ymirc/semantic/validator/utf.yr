/*
 * Declares UTF utility functions.
 *
 * This module provides all string-literal–related Unicode processing used
 * during semantic validation. It performs escape-sequence interpretation,
 * Unicode escape decoding, and UTF-8/UTF-16/UTF-32 conversions required by the
 * literal validation subsystem.
 *
 * These functions are pure and stateless. They are used by the literal
 * validator and other semantic components to ensure that string and character
 * literals are well-formed, correctly encoded, and valid according to the Ymir
 * language specification.
 *
 * Supported operations:
 *   - escape-sequence parsing (\n, \t, \u{...}, etc.),
 *   - UTF-8 decoding and encoding,
 *   - UTF-16 and UTF-32 conversion,
 *   - unescaping for diagnostics and pretty-printing.
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::semantic::validator::utf
 * @File: ymirc/semantic/validator/utf.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *   - Emile Cadorel <emile.cadorel@davidson.fr>
 *
 * @Created (YYYY-MM-DD): 2021-12-15
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in utf;

use ymirc::semantic::generator::value::literal;
use ymirc::semantic::validator;

use ymirc::lexing::word;
use ymirc::errors::_;

use ymirc::utils::format;
use std::stream;

prv {        
    /**
     * Mapping of escape characters ('n', 't', 'r', etc.) to their UTF-8 byte value.
     */
    lazy __ESCAPE__: [c8 => u8] = copy ['a' => 7u8,
                                        'b' => 8u8,
                                        'f' => 12u8,
                                        'n' => 10u8,
                                        'r' => 13u8,
                                        't' => 9u8,
                                        'v' => 11u8,
                                        '\\' => 92u8,
                                        '\'' => 39u8,
                                        '\"' => 34u8];
    
    /**
     * Reverse mapping of UTF-8 byte values to their escape-sequence character.
     */
    lazy __UNESCAPE__: [u8 => c8] = copy [7u8 => 'a',
                                          8u8 => 'b',
                                          12u8 => 'f',
                                          10u8 => 'n',
                                          13u8 => 'r',
                                          9u8 => 't',
                                          11u8 => 'v',
                                          92u8 => '\\',
                                          39u8 => '\'',
                                          34u8 => '\"'];

}


pub mod Utf {
    
    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          ESCAPING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Converts a raw literal string into its escaped UTF-8 form.
     *
     * Expands escape sequences such as \n, \t, \r, \\, \', \", and Unicode escapes
     * of the form \u{...}. Produces a UTF-8 encoded string with all escape
     * sequences resolved.
     *
     * @params:
     *   - loc:     source location of the literal (used for error reporting)
     *   - content: raw literal content, including escape sequences
     *
     * @returns: the UTF-8 encoded string with escape sequences resolved
     *
     * @throws:
     *   - &ErrorMsg: if an escape sequence is malformed or unterminated
     *   
     */
    pub fn escape (loc: &Word, content: [c8])-> [c8]
        throws ErrorMsg
    {
        escapeChars (loc, content)
    }

    /**
     * Converts a UTF-8 string into a human-readable escaped form.
     *
     * This is the inverse of `escape`: it inserts visible escape sequences
     * (\n, \t, \\, \", \') for characters that require escaping.
     *
     * @params:
     *   - value:  the UTF-8 string to unescape
     *   - squote: whether to unescape '\'' into '\\''
     *   - dquote: whether to unescape '\"' into '\\"'
     *
     * @returns: a UTF-8 string containing visible escape sequences
     * 
     */
    pub fn unescape (value: [c8], squote: bool = true, dquote: bool = true)-> [c8] {
        let mut res: [c8] = [];
        for c in value {
            if (c == '\'' && !squote) { res ~= [c]; }
            else if (c == '\"' && !dquote) { res ~= [c]; }
            else match __UNESCAPE__ [cast!u8 (c)] {
                Ok (x) => {
                    res ~= ['\\'];
                    res ~= [x];
                }
                _ => { res ~= [c]; }
            }
        }

        res
    }

    /**
     * Traverses a literal string and resolves escape sequences into their UTF-8
     * byte values.
     *
     * Handles:
     *   - simple escapes (\n, \t, \r, etc.)
     *   - Unicode escapes (\u{...})
     *   - error reporting with precise location tracking
     *
     * @params:
     *   - loc:     source location of the literal
     *   - content: raw literal content, including escape sequences
     *
     * @returns: a UTF-8 string with all escape sequences resolved
     *
     * @throws:
     *   - &ErrorMsg: if an escape sequence is malformed or unterminated
     */
    fn escapeChars (loc: &Word, content: [c8])-> [c8]
        throws ErrorMsg
    {
        let mut col = 0us, mut line = 0us;
        let mut it = 0us;
        let dmut stream: [c8] = [];
        
        while it < content.len {
            if (content [it] == '\n') {
                line += 1us;
                col = 0us;
            } else col += 1us;

            if (content [it] == '\\') {
                if (it + 1us < content.len) {
                    if (content [it + 1us] == 'u') {
                        it += 1us;
                        let (it_, code) = escapeUnicode (loc, content [it + 1us .. $], line, col + 1us);
                        it += it_;
                        col += it_ + 1us;
                        for c in code {
                            stream ~= [c];
                        }
                    } else {
                        let pos = __ESCAPE__ [content [it + 1us]];
                        match pos {
                            Ok (x) => {
                                it += 1us;
                                stream ~= [cast!c8 (x)];
                            }
                            _ => {
                                let realLoc = loc.locate (content[it .. $], addLine-> cast!u64 (line), addCol-> cast!u64 (col + 1us));
                                throw copy ErrorMsg::fatal (realLoc, ValidateErrorMessage::UNDEFINED_ESCAPE);
                            }
                        }

                        col += 1us;
                    }
                } else {
                    let realLoc = loc.locate (content [it .. $], addLine-> cast!u64 (line), addCol-> cast!u64 (col));
                    throw copy ErrorMsg::fatal (realLoc, ValidateErrorMessage::UNTERMINATED_ESCAPE);
                }
            } else {
                stream ~= [content [it]];
            }
            
            it += 1us;
        }

        stream
    }

    /**
     * Decodes a Unicode escape sequence of the form \u{...}.
     *
     * Supports decimal, hexadecimal (0x), binary (0b), and octal (0o) formats.
     * Produces UTF-8 bytes representing the decoded Unicode scalar value.
     *
     * @params:
     *   - loc:     source location of the literal
     *   - content: substring starting after the 'u', beginning with '{'
     *   - line:    current line offset inside the literal
     *   - col:     current column offset inside the literal
     *
     * @returns:
     *   - .0: number of characters consumed from `content`
     *   - .1: UTF-8 encoded bytes of the decoded Unicode scalar
     *
     * @throws:
     *   - &ErrorMsg: if the escape is malformed, invalid, or unterminated
     *   
     */
    fn escapeUnicode (loc: &Word, content: [c8], line: usize, col: usize)-> (usize, [c8])
        throws ErrorMsg
    {
        let realLoc = loc.locate (content, addLine-> cast!u64 (line), addCol-> cast!u64 (col + 1us));
        let mut n_pos = 0us;
        if (content.len == 0us) throw copy ErrorMsg::fatal (realLoc, ValidateErrorMessage::UNTERMINATED_ESCAPE);
        else if (content [0us] != '{') {
            throw copy ErrorMsg::fatal (realLoc, ValidateErrorMessage::UNDEFINED_ESCAPE);
        }
        
        for i in 1us .. content.len {
            if (content [i] == '}') {
                n_pos = i;
                break {}
            }
        }
        
        if (n_pos == 0us) {
            throw copy ErrorMsg::fatal (realLoc, ValidateErrorMessage::UNTERMINATED_ESCAPE);
        }

        let valueStr = content [1us .. n_pos];
        let realLocStr = loc.locate (valueStr, addLine-> cast!u64 (line), addCol-> cast!u64 (col + 2us));
        let inner = {
            if (valueStr.len > 2us && valueStr[0us .. 2us] == "0x") {
                std::conv::to!{u32, "x"} (valueStr)
            } else if (valueStr.len > 2us && valueStr[0us .. 2us] == "0b") {
                std::conv::to!{u32, "b"} (valueStr)
            } else if (valueStr.len > 2us && valueStr[0us .. 2us] == "0o") {
                std::conv::to!{u32, "o"} (valueStr)
            } else {
                std::conv::to!{u32} (valueStr)
            }
        } catch {
            _ => {
                throw copy ErrorMsg::fatal (realLocStr, format (ValidateErrorMessage::MALFORMED_INT_LITERAL, valueStr));
            }
        }

        (n_pos + 1us, toUtf8 (inner))
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          DECODING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Decodes a StringValueContent into UTF-8, regardless of its original encoding.
     *
     * @params:
     *   - size:  encoding size (8, 16, or 32 bits)
     *   - value: the encoded string content
     *
     * @returns: the UTF-8 decoded string
     * 
     */
    pub fn decode (size: u16, value: StringValueContent)-> [c8] {
        match size {
            8u16 => { decode (value.utf8) }
            16u16 => { decode (value.utf16) }
            _ => { decode (value.utf32) }
        }
    }

    /**
     * Decodes a UTF-8 byte sequence into a UTF-8 string.
     *
     * @params:
     *   - value: list of UTF-8 bytes
     *
     * @returns: the same content as a [c8] string
     * 
     */
    pub fn decode (value: [u8])-> [c8] {
        copy [cast!c8 (i) for i in value]
    }

    /**
     * Decodes a UTF-16 sequence into UTF-8.
     *
     * Handles surrogate pairs and multi-unit code points.
     *
     * @params:
     *   - value: UTF-16 encoded code units
     *
     * @returns: the UTF-8 decoded string
     * 
     */
    pub fn decode (value: [u16])-> [c8] {
        let mut res: [c8] = [];
        let mut i = 0us;
        while i < value.len {
            let (nb, codes) = toUtf8 (value [i .. $]);
            res ~= codes;
            i += nb;
        }

        res
    }

    /**
     * Decodes a UTF-32 sequence into UTF-8.
     *
     * @params:
     *   - value: UTF-32 encoded scalar values
     *
     * @returns: the UTF-8 decoded string
     * 
     */
    pub fn decode (value: [u32])-> [c8] {
        let mut res: [c8] = [];
        for i in value {
            let codes = toUtf8 (i);
            res ~= codes;
        }

        res
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          UTF-8          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Encodes a UTF-8 string into its raw byte representation.
     *
     * @params:
     *   - str: UTF-8 string
     *
     * @returns: list of UTF-8 bytes
     * 
     */
    pub fn encodeUtf8 (str: [c8])-> [u8] {
        copy [cast!u8 (i) for i in str]
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          UTF-16          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Decodes a UTF-8 code point into one or two UTF-16 code units.
     *
     * @params:
     *   - content: UTF-8 string starting at a code point boundary
     *
     * @returns:
     *   - .0: number of UTF-8 bytes consumed
     *   - .1: UTF-16 code units representing the decoded code point
     */
    fn toUtf16Char (content: [c8])-> (usize, [u16]) {
        let nb = getUtf8CodePointSize (content [0us]);
        match nb {
            4u32 => {
                let a = cast!u32 (cast!u8 (content [0]) & 0x07u8) << 18u32;
                let b = cast!u32 (cast!u8 (content [1]) & 0x3fu8) << 12u32;
                let c = cast!u32 (cast!u8 (content [2]) & 0x3fu8) << 6u32;
                let d = cast!u32 (cast!u8 (content [3]) & 0x3fu8);

                let cp = (a | b | c | d) - 0x10000u32;
                let high = 0xD800u16 + (cast!u16 (cp >> 10u32) & 0x3FFu16);
                let low = 0xDC00u16 + (cast!u16 (cp & 0x3FFu32));

                (4us, copy [high, low])
            }
            3u32 => {
                let a = cast!u16 (cast!u8 (content [0]) & 0x0fu8) << 12u16;
                let b = cast!u16 (cast!u8 (content [1]) & 0x3fu8) << 6u16;
                let c = cast!u16 (cast!u8 (content [2]) & 0x3fu8);

                (3us, copy [a | b | c])
            }
            2u32 => {
                let a = cast!u16 (cast!u8 (content [0]) & 0x1fu8) << 6u16;
                let b = cast!u16 (cast!u8 (content [1]) & 0x3fu8);

                (2us, copy [a | b])
            }
            _ => {
                let a = cast!u16 (cast!u8 (content [0]) & 0x7fu8);
                (1us, copy [a])
            }
        }
    }

    /**
     * Encodes a UTF-8 string into UTF-16.
     *
     * @params:
     *   - content: UTF-8 string
     *
     * @returns: UTF-16 encoded code units
     * 
     */
    pub fn encodeUtf16 (content: [c8])-> [u16] {
        let mut res: [u16] = [];
        let mut i = 0us;
        while i < content.len {
            let (nb, val) = toUtf16Char (content [i .. $]);
            res ~= val;
            i += nb;
        }

        res
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          UTF-32          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Decodes a UTF-8 code point into a UTF-32 scalar value.
     *
     * @params:
     *   - content: UTF-8 string starting at a code point boundary
     *
     * @returns:
     *   - .0: number of UTF-8 bytes consumed
     *   - .1: the decoded UTF-32 scalar value
     */
    fn toUtf32Char (content: [c8])-> (usize, u32) {
        let nb = getUtf8CodePointSize (content [0us]);
        match nb {
            4u32 => {
                let a = cast!u32 (cast!u8 (content [0]) & 0x07u8) << 18u32;
                let b = cast!u32 (cast!u8 (content [1]) & 0x3fu8) << 12u32;
                let c = cast!u32 (cast!u8 (content [2]) & 0x3fu8) << 6u32;
                let d = cast!u32 (cast!u8 (content [3]) & 0x3fu8);

                (4us, (a | b | c | d))
            }
            3u32 => {
                let a = cast!u32 (cast!u8 (content [0]) & 0x0fu8) << 12u16;
                let b = cast!u32 (cast!u8 (content [1]) & 0x3fu8) << 6u16;
                let c = cast!u32 (cast!u8 (content [2]) & 0x3fu8);

                (3us, a | b | c)
            }
            2u32 => {
                let a = cast!u32 (cast!u8 (content [0]) & 0x1fu8) << 6u16;
                let b = cast!u32 (cast!u8 (content [1]) & 0x3fu8);

                (2us, a | b)
            }
            _ => {
                let a = cast!u32 (cast!u8 (content [0]) & 0x7fu8);
                (1us, a)
            }
        }
    }

    /**
     * Encodes a UTF-8 string into UTF-32.
     *
     * @params:
     *   - content: UTF-8 string
     *
     * @returns: UTF-32 encoded scalar values
     * 
     */
    pub fn encodeUtf32 (content: [c8])-> [u32] {
        let mut res: [u32] = [];
        let mut i = 0us;
        while i < content.len {
            let (nb, val) = toUtf32Char (content [i .. $]);
            res ~= [val];
            i += nb;
        }

        res
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          COMMON          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Determines the number of UTF-8 bytes that form a single code point.
     *
     * @params:
     *   - c: first byte of a UTF-8 code point
     *
     * @returns: number of bytes (1, 2, 3, or 4)
     * 
     */
    fn getUtf8CodePointSize (c: c8)-> u32 {
        let code = cast!u8 (c);
        if((code & 0x80u8) == 0u8) {
            1u32
        } else if((code & 0xe0u8) == 0xc0u8) {
            2u32
        } else if((code & 0xf0u8) == 0xe0u8) {
            3u32
        } else {
            4u32
        }
    }

    /**
     * Encodes a Unicode scalar value into UTF-8 bytes.
     *
     * @params:
     *   - code: Unicode scalar value (0–0x10FFFF)
     *
     * @returns: UTF-8 encoded bytes
     * 
     */
    fn toUtf8 (code: u32)-> [c8] {
        if (code < 0x7Fu32) {
            copy [cast!c8 (cast!u8 (code) & 0x7Fu8)]
        } else if (code <= 0x7FFu32) {
            let dmut ret = copy ['\u{0}' ; 2];
            ret [1] = cast!c8 (0x80u8 | (cast!u8 (code) & 0x3Fu8));
            let c2 = code >> 6u32;
            ret [0] = cast!c8 (0xC0u8 | (cast!u8 (c2) & 0x1Fu8));
            ret
        } else if (code <= 0xFFFFu32) {
            let dmut ret = copy ['\u{0}' ;  3];
            ret [2] = cast!c8 (0x80u8 | (cast!u8 (code) & 0x3Fu8));
            let c2 = code >> 6u32;
            ret [1] = cast!c8 (0x80u8 | (cast!u8 (c2) & 0x3Fu8));
            let c3 = c2 >> 6u32;
            ret [0] = cast!c8 (0xE0u8 | (cast!u8 (c3) & 0xFu8));
            ret
        } else if (code <= 0x10FFFFu32) {
            let dmut ret = copy ['\u{0}' ; 4];
            ret [3] = cast!c8 (0x80u8 | (cast!u8 (code) & 0x3Fu8));
            let c2 = code >> 6u32;
            ret [2] = cast!c8 (0x80u8 | (cast!u8 (c2) & 0x3Fu8));
            let c3 = c2 >> 6u32;
            ret [1] = cast!c8 (0x80u8 | (cast!u8 (c3) & 0x3Fu8));
            let c4 = c3 >> 6u32;
            ret [0] = cast!c8 (0xF0u8 | (cast!u8 (c4) & 0x7u8));
            ret
        } else {
            copy [cast!c8 (0xBDu8), cast!c8 (0xBFu8), cast!c8 (0xEFu8)]
        }
    }

    /**
     * Encodes a UTF-16 surrogate pair into UTF-8 bytes.
     *
     * @params:
     *   - code: UTF-16 code units (1 or 2 units)
     *
     * @returns:
     *   - .0: number of UTF-16 units consumed
     *   - .1: UTF-8 encoded bytes
     *   
     */
    fn toUtf8 (code: [u16])-> (usize, [c8]) {
        let high = code[0];
        if ((high & 0xF800u16) != 0xD800u16) {
            return (1us, toUtf8 (cast!u32 (high)));
        }

        let low = code[1];
        let a = cast!u32 (high & 0x03FFu16) << 10u32;
        let b = cast!u32 (low & 0x03FFu16);

        return (2us, toUtf8 ((a | b) + 0x10000u32));
    }


}
