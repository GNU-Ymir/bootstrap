in symbol;

use ymirc::semantic::symbol;
use ymirc::semantic::validator::_;

use ymirc::errors::message;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub mod ::score;
pub mod ::def_;
pub mod ::enum_;
pub mod ::class_;
pub mod ::trait_;
pub mod ::function;
pub mod ::method;
pub mod ::global;


/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          ROOT          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub mod SymbolValidation {

    pub fn validate(dmut context: &ValidationContext, dmut sym: &Symbol)
        throws ErrorMsg
    {
        match alias sym {
            dmut m: &ModuleSymbol => {
                ModuleValidation::validate(alias context, alias m);
            }
            dmut l: &LazyModuleSymbol => {
                ModuleValidation::validate(alias context,
                                            alias context:.getModuleFromLazy(l));
            }
            dmut f: &FunctionSymbol => {
                FunctionValidation::validate(alias context, alias f);
            }
            dmut c: &ClassSymbol => {
                ClassValidation::validate(alias context, alias c, inModule-> true);
            }
            dmut tr: &TraitSymbol => {
                TraitValidation::validate(alias context, alias tr);
            }
            dmut en: &EnumSymbol => {
                EnumValidation::validate(alias context, alias en);
            }
            dmut glb: &GlobalVarSymbol => {
                GlobalVarValidation::validate(alias context, alias glb, fromModule-> true);
            }
            dmut def_: &DefSymbol => {
                DefValidation::validate(alias context, alias def_);
            }
            MacroSymbol() => {
                // Only validated when called
            }
            EmptySymbol() => {
                // Just do nothing
            }
            TemplateSymbol() => {
                // TODO, verify that the symbols can be infered without any call, and if yes then validate it
            }
            _ => {
                eprintln("internal validator error; undefined symbol ", sym.__typeinfo__.name);
                panic;
            }
        }
    }

}
