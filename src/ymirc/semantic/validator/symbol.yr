/*
 * Central dispatch for semantic validation of all symbol kinds.
 *
 * This module provides the top-level entry point for validating any symbol
 * in the Ymir compiler. It performs dynamic dispatch on the concrete symbol
 * type and forwards validation to the appropriate subsystem:
 *
 *   - modules,
 *   - lazy modules,
 *   - functions,
 *   - classes,
 *   - traits,
 *   - enums,
 *   - global variables,
 *   - definitions,
 *   - macros(validated only when invoked),
 *   - template symbols(TODO: early validation).
 *
 * This dispatcher ensures that all symbols follow a uniform validation
 * interface and that each symbol kind is validated by its dedicated module.

 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::symbol
 * @File: ymirc/semantic/validator/symbol.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2025-01-06
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in symbol;

use ymirc::semantic::symbol;
use ymirc::semantic::validator::_;

use ymirc::errors::message;
use ymirc::semantic::validator::symbol::_;

use std::io;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub mod ::score;
pub mod ::def_;
pub mod ::enum_;
pub mod ::class_;
pub mod ::trait_;
pub mod ::function;
pub mod ::global;
pub mod ::module;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          ROOT          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * SymbolValidation module
 *
 * Provides the central dispatch function for validating symbols.
 *
 * Responsibilities:
 *   - inspect the dynamic type of a Symbol,
 *   - forward validation to the correct subsystem,
 *   - handle lazy module resolution,
 *   - ignore symbols that do not require validation(macros, empty symbols),
 *   - report internal errors for unknown symbol types.
 *
 * This module does not perform validation itself; it only delegates.
 */
pub mod SymbolValidation {

    /**
     * Validate a symbol by dispatching to the appropriate validator.
     *
     * @params:
     *   - context: validation context
     *   - sym:     symbol to validate
     *
     * @throws:
     *   - ErrorMsg if the delegated validator throws
     *   - panic for unknown symbol types(internal compiler error)
     */
    pub fn validate(dmut context: &ValidationContext, dmut sym: &Symbol)
        throws ErrorMsg
    {
        match alias sym {
            dmut m: &ModuleSymbol => {
                ModuleValidation::validate(alias context, alias m);
            }
            dmut l: &LazyModuleSymbol => {
                ModuleValidation::validate(alias context,
                                           alias context:.getModuleFromLazy(l));
            }
            dmut f: &FunctionSymbol => {
                FunctionValidation::validate(alias context, alias f);
            }
            dmut c: &ClassSymbol => {
                ClassValidation::validate(alias context, alias c,
                                          inModule-> true);
            }
            dmut tr: &TraitSymbol => {
                TraitValidation::validate(alias context, alias tr);
            }
            dmut en: &EnumSymbol => {
                EnumValidation::validate(alias context, alias en);
            }
            dmut glb: &GlobalVarSymbol => {
                GlobalVarValidation::validate(alias context, alias glb,
                                              inModule-> true);
            }
            dmut def_: &DefSymbol => {
                DefValidation::validate(alias context, alias def_);
            }
            MacroSymbol() => {
                // Only validated when called
            }
            EmptySymbol() => {
                // Just do nothing
            }
            TemplateSymbol() => {
                // TODO, verify that the symbols can be infered without any call, and if yes then validate it
            }
            _ => {
                eprintln("internal validator error; undefined symbol ", sym.__typeinfo__.name);
                panic;
            }
        }
    }
}
