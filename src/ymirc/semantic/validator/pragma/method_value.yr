 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in method_value;

use ymirc::errors;
use ymirc::semantic::generator::value;
use ymirc::semantic::generator::type::custom;
use ymirc::syntax::expression::{literal, memory, operator};
use ymirc::utils::format;

/**
 * PragmaMethodAccessValidation module
 *
 * Provides the implementation of the `__pragma!method` pragma, accessing the
 * method of a class, a record, an entity or a union instance.
 *
 * Expected form:
 *
 *     __pragma!method(object, "methodName")
 *     __pragma!method(alias object, "methodName")
 *
 * The aliased form is the one of `object:.methodName`, reaching the mutable
 * methods. The result is what the access produces: a delegate, the call of a
 * field method, or the method called by the arguments following the pragma.
 */
pub mod PragmaMethodAccessValidation {

    /**
     * Entry point for the pragma handler.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - Ok(&Value) containing the result of `validate`
     *   - Err(&ErrorMsg) if validation fails
     */
    pub fn handle(dmut context: &ValidationContext, p: &PragmaExpr)-> (&Value)? {
        return (PragmaMethodAccessValidation::validate(alias context, p))?;
    }

    /**
     * Validate the `__pragma!method` pragma.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns: the access of the method, as `object.name` or `object:.name` validates it
     *
     * @throws:
     *   - ErrorMsg if the pragma is malformed, if the object has no methods, or if
     *     no method of that name applies, noted when it names a field
     */
    pub fn validate(dmut context: &ValidationContext, p: &PragmaExpr)-> &Value
        throws ErrorMsg
    {
        if (p.params.len != 2us) {
            throw copy ErrorMsg::fatal(p.loc, format(ValidateErrorMessage::MALFORMED_PRAGMA, p.name.str));
        }

        let (expr, isAlias) = if let a: &AliasExpr = p.params[0] { (a.content, true) } else { (p.params[0], false) };
        let mut object = ValueCreation::createEnumUnwrap(ValueValidation::validate(alias context, expr));
        if isAlias {
            object = AliasValidation::validate(alias context, p.params[0].loc, object, isClass-> true, isField-> true);
        }

        let name = context.cteInterpret:.decodeString(ValueValidation::validate(alias context, p.params[1]));
        let method = copy VarExpr(p.loc.locate(name), isQuoted-> true);
        let inCall = context.isInCall(p);

        match object.type {
            c: &ClassPtrType => {
                return ClassFieldOrMethodValidation::validateMethodAccess(alias context, p.loc, object, c.inner, method, inCall-> inCall);
            }
            u: &UnionType => {
                return UnionMethodValidation::validate(alias context, p.loc, object, u, method, inCall-> inCall, withMeta-> false);
            }
        }

        throw copy ErrorMsg::fatal(p.params[0].loc, format(ValidateErrorMessage::TYPE_HAS_NO_METHOD, object.type));
    }

}
