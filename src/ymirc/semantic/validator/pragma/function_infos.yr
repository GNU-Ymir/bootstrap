in function_infos;

use ymirc::errors;
use ymirc::lexing::keys;
use ymirc::semantic::generator::value::_;
use ymirc::semantic::generator::type::native;
use ymirc::semantic::validator::pragma::signature;
use ymirc::syntax::expression::operator;
use ymirc::utils::format;

/**
 * PragmaFunctionInfosValidation module
 *
 * Provides the implementation of the `__pragma!function_infos` pragma.
 *
 * Expected form:
 *
 *     __pragma!function_infos(F)
 *
 * where `F` is a function or a callable type, as resolved by
 * PragmaSignatureValidation. It returns a compile-time FunctionInfo: the path
 * of the function, empty for a callable type or a lambda; its kind, `fn`,
 * `yield` or `async`; whether it is unsafe, inline, C variadic, declares a
 * thrown type or is a method; and its number of parameters, the self of a
 * method left out.
 */
pub mod PragmaFunctionInfosValidation {

    /**
     * Entry point for the pragma handler.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - Ok(&Value) containing the result of `validate`
     *   - Err(&ErrorMsg) if validation fails
     */
    pub fn handle(dmut context: &ValidationContext, p: &PragmaExpr)-> (&Value)? {
        return (PragmaFunctionInfosValidation::validate(alias context, p))?;
    }

    /**
     * Validate the `__pragma!function_infos` pragma.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns: a FunctionInfo describing the function
     *
     * @throws:
     *   - ErrorMsg if the pragma is malformed, if its parameter is not a single instantiated function, or if the
     *     core declares no FunctionInfo record
     */
    pub fn validate(dmut context: &ValidationContext, p: &PragmaExpr)-> &Value
        throws ErrorMsg
    {
        if (p.params.len != 1us) {
            throw copy ErrorMsg::fatal(p.loc, format(ValidateErrorMessage::MALFORMED_PRAGMA, p.name.str));
        }

        let sig = PragmaSignatureValidation::resolve(alias context, p, p.params[0]);
        let fi = TypeCreation::createFunctionInfo(alias context, p.loc);

        copy StructInitValue(p.loc,
                             type-> fi,
                             values-> copy [copy StringValue(p.loc, sig.name),
                                            copy StringValue(p.loc, sig.kind),
                                            copy BoolValue(p.loc, sig.isUnsafe),
                                            copy BoolValue(p.loc, sig.isInline),
                                            copy BoolValue(p.loc, sig.isCVariadic),
                                            copy BoolValue(p.loc, sig.isThrowing),
                                            copy BoolValue(p.loc, sig.isMethod),
                                            copy IntValue(p.loc, USIZE_TYPE, sig.params.len)],
                             fields-> copy [FunctionInfoKeys::NAME,
                                            FunctionInfoKeys::KIND,
                                            FunctionInfoKeys::IS_UNSAFE,
                                            FunctionInfoKeys::IS_INLINE,
                                            FunctionInfoKeys::IS_CVARIADIC,
                                            FunctionInfoKeys::IS_THROWING,
                                            FunctionInfoKeys::IS_METHOD,
                                            FunctionInfoKeys::ARITY])
    }

}
