/*
 * Implements validation for the `__pragma!unproxied(T)` construct.
 *
 * This pragma unwraps an enum type to its underlying proxy type. It accepts a
 * single type parameter and returns:
 *
 *   - the enum’s last-level proxy type, if the argument is an EnumType
 *   - the type unchanged, otherwise
 *
 * This is useful when performing reflection or meta-programming on enum
 * payloads, or when interacting with APIs that expect the underlying type
 * rather than the enum wrapper.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::pragma::unproxy
 * @File: ymirc/semantic/validator/pragma/unproxy.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-03-27
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in unproxy;

use ymirc::syntax::expression::operator;
use ymirc::semantic::validator;

use ymirc::semantic::generator::type::custom;
use ymirc::utils::format;
use ymirc::errors::message;

/**
 * PragmaEnumUnwrapValidation module
 *
 * Provides the implementation of the `__pragma!unproxied` pragma. This pragma
 * removes the enum wrapper from a type and returns its underlying proxy type.
 *
 * Expected form:
 *
 *     __pragma!unproxied(T)
 *
 * where `T` may be any type. If `T` is an EnumType, the pragma returns the
 * enum’s last-level proxy type. Otherwise, it returns `T` unchanged.
 *
 * This pragma is part of the compile-time reflection system and is typically
 * used when inspecting enum payloads or interfacing with APIs that operate on
 * the underlying type.
 *
 */
pub mod PragmaEnumUnwrapValidation {

    /**
     * Entry point for the pragma handler.
     *
     * Wraps `validate` in an option type, allowing integration with the pragma
     * dispatch system. The handler itself never throws; any semantic error is
     * returned as Err(&ErrorMsg).
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - Ok(&Type) containing the result of `validate`
     *   - Err(&ErrorMsg) if validation fails
     */
    pub fn handle(dmut context: &ValidationContext, p: &PragmaExpr)-> (&Type)? {
        return (PragmaEnumUnwrapValidation::validate(alias context, p))?;
    }

    /**
     * Validate the `__pragma!unproxied` pragma.
     *
     * Expected form:
     *
     *     __pragma!unproxied(T)
     *
     * Steps:
     *   1. Ensure exactly one parameter is provided.
     *   2. Validate the parameter as a type.
     *   3. If the type is an EnumType, return its last-level proxy type.
     *   4. Otherwise, return the type unchanged.
     *
     * Errors:
     *   - Wrong number of parameters => MALFORMED_PRAGMA
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - the unwrapped proxy type if T is an enum
     *   - T unchanged otherwise
     *
     * @throws:
     *   - ErrorMsg if the pragma is malformed
     */
    pub fn validate(dmut context: &ValidationContext, p: &PragmaExpr)-> &Type
        throws ErrorMsg
    {
        if (p.params.len != 1us) {
            throw copy ErrorMsg::fatal(p.loc, format(ValidateErrorMessage::MALFORMED_PRAGMA, p.loc.str));
        }

        let ty = TypeValidation::validate(alias context, p.params[0]);
        if let e: &EnumType = ty {
            return e.getLastLevelProxy();
        }

        return ty;
    }

}
