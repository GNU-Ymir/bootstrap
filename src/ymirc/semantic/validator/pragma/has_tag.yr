in has_tag;

use ymirc::errors;
use ymirc::semantic::symbol;
use ymirc::semantic::generator::type::{custom, temporary};
use ymirc::semantic::generator::value::{literal, prototype, template_, variable};
use ymirc::syntax::expression::operator;
use ymirc::utils::format;

/**
 * PragmaHasTagValidation module
 *
 * Provides the implementation of the `__pragma!has_tag` pragma.
 *
 * Expected form:
 *
 *     __pragma!has_tag(sym, tag)
 *
 * where `sym` names a function, a class, an enum or a union, or a template of
 * one of them, and `tag` names a tag, both resolved by the usual lookup. It
 * returns a compile-time `bool`, true iff a site written on top of `sym` names
 * `tag`.
 */
pub mod PragmaHasTagValidation {

    /**
     * Entry point for the pragma handler.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - Ok(&Value) containing the result of `validate`
     *   - Err(&ErrorMsg) if validation fails
     */
    pub fn handle(dmut context: &ValidationContext, p: &PragmaExpr)-> (&Value)? {
        return (PragmaHasTagValidation::validate(alias context, p))?;
    }

    /**
     * Validate the `__pragma!has_tag` pragma.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns: true iff the symbol carries the tag, as a compile-time `bool`
     *
     * @throws:
     *   - ErrorMsg if the pragma is malformed, if its first parameter names no
     *     symbol tags can be written on, or if its second one names no tag
     */
    pub fn validate(dmut context: &ValidationContext, p: &PragmaExpr)-> &Value
        throws ErrorMsg
    {
        if (p.params.len != 2us) {
            throw copy ErrorMsg::fatal(p.loc, format(ValidateErrorMessage::MALFORMED_PRAGMA, p.name.str));
        }

        let sym = PragmaHasTagValidation::validateCarrier(alias context, p.params[0]);
        let tag = ValueValidation::validate(alias context, p.params[1]);
        if let t: &TagRefValue = tag {
            return copy BoolValue(p.loc, TagValidation::carries(alias context, sym, t.sym));
        }

        throw copy ErrorMsg::fatal(p.params[1].loc, format(ValidateErrorMessage::NOT_A_TAG, p.params[1]));
    }

    /**
     * Validate the symbol tags are written on top of: as a type, a class, an
     * enum or a union, and failing that as a value, a function or a template.
     * The name of a tagged function meaning the instance its tags are merged
     * into, the function as written is the one carrying them.
     *
     * @params:
     *   - context: validation context
     *   - expr:    the expression naming the symbol
     *
     * @returns: the symbol
     *
     * @throws:
     *   - ErrorMsg if the expression names no single symbol tags can be written on
     */
    fn validateCarrier(dmut context: &ValidationContext, expr: &Expression)-> &Symbol
        throws ErrorMsg
    {
        let type = (TypeValidation::validate(alias context, expr))?;
        if let Ok(t) = type {
            match t {
                c: &ClassRefType    => return c.sym;
                c: &ClassPtrType    => return c.sym;
                e: &EnumType        => return e.sym;
                u: &UnionType       => return u.sym;
                u: &UnionRefType    => return u.sym;
                r: &TemplateRefType => return r.sym;
            }
        } else {
            match ValueValidation::validate(alias context, expr) {
                pr: &PrototypeValue => {
                    if let f: &FunctionSymbol = pr.sym {
                        if let Ok(u) = f.untagged {
                            return u;
                        }
                    }

                    return pr.sym;
                }
                t: &TemplateRefValue => return t.sym;
            }
        }

        throw copy ErrorMsg::fatal(expr.loc, format(ValidateErrorMessage::NOT_TAGGABLE, expr));
    }

}
