/*
 * Implements validation for the `__pragma!field_type(T, field)` construct.
 *
 * This pragma retrieves the type of a field inside a class or tuple. It accepts
 * two parameters:
 *
 *     __pragma!field_type(T, "fieldName")
 *     __pragma!field_type(T, index)
 *
 * Behavior:
 *   - The first parameter must be a type.
 *   - The second parameter must be either:
 *        - a string(for class/struct fields), or
 *        - an integer(for tuple indexing).
 *   - Enum types are unwrapped to their proxy type.
 *   - Access checks(private/protected) are enforced for class fields.
 *   - Tuple indices support negative indexing.
 *
 * Errors from type or field resolution are surfaced as fatal diagnostics.
 */

in field_type;


use ymirc::lexing::word;

use ymirc::syntax::expression::operator;
use ymirc::semantic::{interpret, validator, declarator};

use ymirc::semantic::generator::{value::literal, type::_};
use ymirc::utils::{format, bigint};
use ymirc::errors::message;


use std::io;

/**
 * PragmaFieldTypeValidation module
 *
 * Provides the implementation of the `__pragma!field_type` pragma. This pragma
 * returns the type of a field inside a class or tuple. It supports:
 *
 *   - class field lookup by name
 *   - tuple element lookup by index(positive or negative)
 *
 * Expected forms:
 *
 *     __pragma!field_type(T, "fieldName")
 *     __pragma!field_type(T, index)
 *
 * The pragma returns the field’s type as a Type node. Access protection rules
 * (private/protected) are enforced for class fields.
 *
 */
pub mod PragmaFieldTypeValidation {

    /**
     * Entry point for the pragma handler.
     *
     * Wraps `validate` in an option type, allowing integration with the pragma
     * dispatch system. The handler itself never throws; any semantic error is
     * returned as Err(&ErrorMsg).
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - Ok(&Type) containing the result of `validate`
     *   - Err(&ErrorMsg) if validation fails
     */
    pub fn handle(dmut context: &ValidationContext, p: &PragmaExpr)-> (&Type)? {
        return (PragmaFieldTypeValidation::validate(alias context, p))?;
    }

    /**
     * Validate the `__pragma!field_type` pragma.
     *
     * Expected form:
     *
     *     __pragma!field_type(T, field)
     *
     * where:
     *   - T is a type
     *   - field is either:
     *        - a string(class/struct field name)
     *        - an integer(tuple index)
     *
     * Steps:
     *   1. Ensure exactly two parameters are provided.
     *   2. Validate the first parameter as a type.
     *   3. Validate the second parameter as a value.
     *   4. Dispatch based on the type:
     *        - ClassPtrType / ClassRefType => validateClass
     *        - TupleType => validateTuple
     *   5. Emit TYPE_NO_FIELD if the field does not exist.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - the Type of the requested field
     *
     * @throws:
     *   - &ErrorMsg if the pragma is malformed or the field is invalid
     */
    pub fn validate(dmut context: &ValidationContext, p: &PragmaExpr)-> &Type
        throws ErrorMsg
    {
        if (p.params.len != 2us) {
            throw copy ErrorMsg::fatal(p.loc, format(ValidateErrorMessage::MALFORMED_PRAGMA, p.loc.str));
        }

        let str = TypeValidation::validate(alias context, p.params[0]);
        let fieldV = ValueValidation::validate(alias context, p.params[1]);

        match str {
            c: &ClassPtrType => {
                let field = context.cteInterpret:.decodeString(fieldV);
                return PragmaFieldTypeValidation::validateClass(alias context, p.loc, c.inner, field);
            }
            c: &ClassRefType => {
                let field = context.cteInterpret:.decodeString(fieldV);
                return PragmaFieldTypeValidation::validateClass(alias context, p.loc, c, field);
            }
            t: &TupleType => {
                let field = context.cteInterpret:.computeInt(fieldV);
                return PragmaFieldTypeValidation::validateTuple(alias context, p.loc, t, field);
            }
        }

        throw copy ErrorMsg::fatal(p.loc, format(ValidateErrorMessage::TYPE_NO_FIELD, str, fieldV));
    }

    /**
     * Resolve the type of a field inside a class.
     *
     * Performs:
     *   - field existence check
     *   - private/protected access checks
     *   - return of the field’s declared type
     *
     * Access rules:
     *   - private fields require inPrv(inside class)
     *   - protected fields require inPrv or inProt(inside class or subclass)
     *
     * @params:
     *   - context: validation context
     *   - loc:     location of the pragma
     *   - c:       class reference type
     *   - field:   field name as a string
     *
     * @returns:
     *   - the field’s type
     *
     * @throws:
     *   - ErrorMsg if the field does not exist or is not accessible
     */
    fn validateClass(dmut context: &ValidationContext, loc: &Word, c: &ClassRefType, field: [c8])-> &Type
        throws ErrorMsg
    {
        let (inPrv, inProt) = context.getCurrentClassReferentProtections(c);
        for v in c.localFields {
            if (v.name == field) {
                // The field exists but is private, and we don't have access to private fields(outside class, or ancestor)
                if (c.sym.isFieldPrivate(field) && !inPrv) {
                    throw copy ErrorMsg::fatal(loc, format(DeclareErrorMessage::PRIVATE_IN_THIS_CONTEXT, field),
                                                notes-> copy [copy ErrorMsg::note(v.loc, ValidateErrorMessage::DECLARED_HERE)]);
                }

                // The field exists but we are outside the class definition
                else if (c.sym.isFieldProtected(field) && !inPrv && !inProt) {
                    throw copy ErrorMsg::fatal(loc, format(DeclareErrorMessage::PRIVATE_IN_THIS_CONTEXT, field),
                                                notes-> copy [copy ErrorMsg::note(v.loc, ValidateErrorMessage::DECLARED_HERE)]);
                }

                return v.varType;
            }
        }

        throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::TYPE_NO_FIELD, c, field));
    }

    /**
     * Resolve the type of a tuple element by index.
     *
     * Supports:
     *   - positive indices: 0 .. arity-1
     *   - negative indices: -1 refers to the last element, etc.
     *
     * Errors:
     *   - index out of bounds => TUPLE_ARITY_OVERFLOW
     *   - integer conversion errors => OVERFLOW_CAPACITY
     *
     * @params:
     *   - context: validation context(unused)
     *   - loc:     location of the pragma
     *   - t:       tuple type
     *   - val:     index as a BigInt
     *
     * @returns:
     *   - the type of the tuple element at the computed index
     *
     * @throws:
     *   - ErrorMsg if the index is invalid or out of range
     */
    fn validateTuple(dmut _: &ValidationContext, loc: &Word, t: &TupleType, val: &BigInt)-> &Type
        throws ErrorMsg
    {
        let arity = t.inners.len;
        {
            let acc = if (val < 0) {
                let _abs: usize = cast!usize(ymirc::utils::math::abs(val.to!isize()));
                if (arity < _abs) throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::TUPLE_ARITY_OVERFLOW, _abs, arity));
                arity - _abs
            } else {
                let res = val.to!usize();
                if (arity <= res) throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::TUPLE_ARITY_OVERFLOW, val, arity));
                res
            };

            return t.inners[acc];
        }  catch {
            x: &ErrorMsg => throw x;
            _ => { // conversion errors
                throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::OVERFLOW_CAPACITY,
                                                         USIZE_TYPE,
                                                         val,
                                                         IntInterpret::createIntMaxValue(0, false)));
            }
        }
    }

}
