/*
 * Implements validation for the `__pragma!field_infos(T)` construct.
 *
 * This pragma retrieves compile-time metadata describing the fields of a type.
 * It accepts a single type parameter and returns a value representing the
 * type’s field information(as produced by TypeInfo::validateFieldInfos).
 *
 * Behavior:
 *   - The pragma requires exactly one parameter.
 *   - The parameter must be a valid type.
 *   - The underlying TypeInfo subsystem performs the actual metadata lookup.
 *   - Any error raised by TypeInfo is wrapped in a MALFORMED_PRAGMA diagnostic.
 *
 * This pragma is part of Ymir’s compile-time reflection system and is used to
 * inspect struct/class fields, generate serializers, derive implementations, or
 * perform meta-programming based on type structure.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::pragma::field_info
 * @File: ymirc/semantic/validator/pragma/field_info.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-03-27
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in field_info;


use ymirc::syntax::expression::operator;
use ymirc::semantic::validator;

use ymirc::semantic::generator::{value, type::native};
use ymirc::utils::format;
use ymirc::errors::message;

/**
 * PragmaFieldInfosValidation module
 *
 * Provides the implementation of the `__pragma!field_infos` pragma. This pragma
 * returns compile-time metadata describing the fields of a type. It delegates
 * the actual reflection logic to TypeInfo::validateFieldInfos.
 *
 * Expected form:
 *
 *     __pragma!field_infos(T)
 *
 * where `T` is any type for which field metadata is available. The pragma
 * returns a Value representing the field information(typically a struct or
 * array of descriptors).
 *
 * Errors from the underlying TypeInfo subsystem are caught and re-emitted as
 * MALFORMED_PRAGMA diagnostics to ensure consistent pragma error reporting.
 *
 */
pub mod PragmaFieldInfosValidation {

    /**
     * Entry point for the pragma handler.
     *
     * Wraps `validate` in an option type, allowing integration with the pragma
     * dispatch system. The handler itself never throws; any semantic error is
     * returned as Err(&ErrorMsg).
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - Ok(&Value) containing the result of `validate`
     *   - Err(&ErrorMsg) if validation fails
     */
    pub fn handle(dmut context: &ValidationContext, p: &PragmaExpr)-> (&Value)? {
        return (PragmaFieldInfosValidation::validate(alias context, p))?;
    }

    /**
     * Validate the `__pragma!field_infos` pragma.
     *
     * Expected form:
     *
     *     __pragma!field_infos(T)
     *
     * Steps:
     *   1. Ensure exactly one parameter is provided.
     *   2. Validate the parameter as a type.
     *   3. Delegate to TypeInfo::validateFieldInfos to retrieve field metadata.
     *   4. If TypeInfo reports an error, wrap it in a MALFORMED_PRAGMA diagnostic.
     *
     * The returned value is whatever TypeInfo produces(typically a structured
     * representation of the type’s fields).
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - a Value representing the field metadata of the type
     *
     * @throws:
     *   - ErrorMsg if the pragma is malformed or TypeInfo reports an error
     */
    pub fn validate(dmut context: &ValidationContext, p: &PragmaExpr)-> &Value
        throws ErrorMsg
    {
        if (p.params.len != 1us) {
            throw copy ErrorMsg::fatal(p.loc, format(ValidateErrorMessage::MALFORMED_PRAGMA, p.loc.str));
        }

        let str = TypeValidation::validate(alias context, p.params[0]);
        {
            return TypeInfo::validateFieldInfos(alias context, p.loc, str);
        } catch {
            err: &ErrorMsg => {
                throw copy ErrorMsg::fatal(p.loc, format(ValidateErrorMessage::MALFORMED_PRAGMA, p.loc.str), notes-> copy [err]);
            }
        }
    }

}
