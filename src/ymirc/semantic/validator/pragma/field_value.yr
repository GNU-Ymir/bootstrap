/*
 * Implements validation for the `__pragma!field(T, field)` construct.
 *
 * This pragma performs *dynamic field access* at compile time. It accepts two
 * parameters:
 *
 *     __pragma!field(object, "fieldName")
 *
 * Behavior:
 *   - The first parameter is evaluated as a value.
 *   - Enum values are automatically unwrapped to their underlying payload.
 *   - The second parameter must evaluate to a string representing the field.
 *   - Delegate types support special pseudo-fields: "func" and "closure".
 *   - Otherwise, dynamic field resolution is delegated to FieldValidation.
 *
 * The pragma returns the resulting field value or throws a diagnostic if the
 * field does not exist or is not accessible.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::pragma::field_value
 * @File: ymirc/semantic/validator/pragma/field_value.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-03-27
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in field_value;

use ymirc::lexing::keys;
use ymirc::syntax::expression::operator;
use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::{literal, operator}, type::native};
use ymirc::utils::format;
use ymirc::errors;

/**
 * PragmaFieldAccessValidation module
 *
 * Provides the implementation of the `__pragma!field` pragma. This pragma
 * performs compile-time dynamic field access on values. It supports:
 *
 *   - class/struct field access
 *   - tuple element access(via FieldValidation)
 *   - enum payload extraction(automatic unwrap)
 *   - delegate pseudo-fields("func", "closure")
 *
 * Expected form:
 *
 *     __pragma!field(object, "fieldName")
 *
 * The pragma returns the value of the requested field. Errors from dynamic
 * access are surfaced as fatal diagnostics.
 *
 */
pub mod PragmaFieldAccessValidation {

    /**
     * Entry point for the pragma handler.
     *
     * Wraps `validate` in an option type, allowing integration with the pragma
     * dispatch system. The handler itself never throws; any semantic error is
     * returned as Err(&ErrorMsg).
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - Ok(&Value) containing the result of `validate`
     *   - Err(&ErrorMsg) if validation fails
     */
    pub fn handle(dmut context: &ValidationContext, p: &PragmaExpr)-> (&Value)? {
        return (PragmaFieldAccessValidation::validate(alias context, p))?;
    }

    /**
     * Validate the `__pragma!field` pragma.
     *
     * Expected form:
     *
     *     __pragma!field(object, "fieldName")
     *
     * Steps:
     *   1. Ensure exactly two parameters are provided.
     *   2. Evaluate the first parameter as a value.
     *   3. Automatically unwrap enum values to their payload.
     *   4. Evaluate the second parameter as a string(field name).
     *   5. Special case: if the object is a DelegateType and the field is
     *      "func" or "closure", return a reduced StructFieldAccessValue.
     *   6. Otherwise, delegate to FieldValidation::validate.
     *
     * Errors:
     *   - Wrong number of parameters
     *   - Field does not exist
     *   - Field is not accessible
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - the value of the requested field
     *
     * @throws:
     *   - ErrorMsg if the pragma is malformed or the field is invalid
     */
    pub fn validate(dmut context: &ValidationContext, p: &PragmaExpr)-> &Value
        throws ErrorMsg
    {
        if (p.params.len != 2us) {
            throw copy ErrorMsg::fatal(p.loc, format(ValidateErrorMessage::MALFORMED_PRAGMA, p.name.str));
        }

        let object = ValueCreation::createEnumUnwrap(ValueValidation::validate(alias context, p.params[0]));
        let field = context.cteInterpret:.decodeString(ValueValidation::validate(alias context, p.params[1]));

        if object.type of DelegateType && (field == DelegateKeys::FUNC || field == DelegateKeys::CLOSURE) {
            return copy StructFieldAccessValue(p.loc,
                                                copy PointerType(p.loc, VOID_TYPE, isMutable-> false),
                                                object,
                                                name-> field,
                                                isReduced-> true);
        }

        return FieldValidation::validate(alias context, p.loc, object, field);
    }

}
