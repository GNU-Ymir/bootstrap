/*
 * Implements validation for the pragmas naming the place they are written in.
 *
 * Five pragmas share this module, all taking no argument and folding to a
 * literal at validation time:
 *
 *   - `__pragma!file()`     the source file containing the pragma
 *   - `__pragma!line()`     the line the pragma is written on
 *   - `__pragma!module()`   the path of the enclosing module
 *   - `__pragma!function()` the path of the enclosing function
 *   - `__pragma!decl()`     the path of the enclosing class, record, entity,
 *                           trait, enum or union
 *
 * The first two read the location of the pragma token, the last three walk the
 * referent chain of the symbol being validated outwards until they meet the
 * kind of symbol they name.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::pragma::location
 * @File: ymirc/semantic/validator/pragma/location.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-09-20
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in location;

use ymirc::errors;
use ymirc::lexing::keys;
use ymirc::semantic::symbol;
use ymirc::semantic::generator::type::native;
use ymirc::semantic::generator::value::literal;
use ymirc::syntax::expression::operator;
use ymirc::utils::format;

/**
 * PragmaLocationValidation module
 *
 * Provides the implementation of the pragmas describing the location of their
 * own writing: `file`, `line`, `module`, `function` and `decl`.
 *
 * All of them take no argument, and produce a constant: a `[c8]` for every one
 * but `line`, which produces a `u64`. Being constants, they fold like any other
 * literal, and can be used wherever a compile time value is expected.
 *
 */
pub mod PragmaLocationValidation {

    /**
     * Entry point of the `__pragma!file` handler.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - Ok(&Value) containing the result of `validateFile`
     *   - Err(&ErrorMsg) if validation fails
     */
    pub fn handleFile(dmut context: &ValidationContext, p: &PragmaExpr)-> (&Value)? {
        return (PragmaLocationValidation::validateFile(alias context, p))?;
    }

    /**
     * Entry point of the `__pragma!line` handler.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - Ok(&Value) containing the result of `validateLine`
     *   - Err(&ErrorMsg) if validation fails
     */
    pub fn handleLine(dmut context: &ValidationContext, p: &PragmaExpr)-> (&Value)? {
        return (PragmaLocationValidation::validateLine(alias context, p))?;
    }

    /**
     * Entry point of the `__pragma!module` handler.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - Ok(&Value) containing the result of `validateModule`
     *   - Err(&ErrorMsg) if validation fails
     */
    pub fn handleModule(dmut context: &ValidationContext, p: &PragmaExpr)-> (&Value)? {
        return (PragmaLocationValidation::validateModule(alias context, p))?;
    }

    /**
     * Entry point of the `__pragma!function` handler.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - Ok(&Value) containing the result of `validateFunction`
     *   - Err(&ErrorMsg) if validation fails
     */
    pub fn handleFunction(dmut context: &ValidationContext, p: &PragmaExpr)-> (&Value)? {
        return (PragmaLocationValidation::validateFunction(alias context, p))?;
    }

    /**
     * Entry point of the `__pragma!decl` handler.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - Ok(&Value) containing the result of `validateDecl`
     *   - Err(&ErrorMsg) if validation fails
     */
    pub fn handleDecl(dmut context: &ValidationContext, p: &PragmaExpr)-> (&Value)? {
        return (PragmaLocationValidation::validateDecl(alias context, p))?;
    }

    /**
     * Validate the `__pragma!file` pragma.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - the name of the file containing the pragma, as a `[c8]`
     *
     * @throws:
     *   - ErrorMsg if the pragma was given an argument
     */
    pub fn validateFile(dmut _: &ValidationContext, p: &PragmaExpr)-> &Value
        throws ErrorMsg
    {
        PragmaLocationValidation::verifyNoParams(p);

        StringLiteralValidation::validate(p.loc, p.loc.filename, StringSuffixes::UTF8)
    }

    /**
     * Validate the `__pragma!line` pragma.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - the line the pragma is written on, as a `u64`
     *
     * @throws:
     *   - ErrorMsg if the pragma was given an argument
     */
    pub fn validateLine(dmut _: &ValidationContext, p: &PragmaExpr)-> &Value
        throws ErrorMsg
    {
        PragmaLocationValidation::verifyNoParams(p);

        let type = copy IntType(p.loc, size-> 64u16, isSigned-> false, isMutable-> false);
        copy IntValue(p.loc, type, cast!usize (p.loc.line))
    }

    /**
     * Validate the `__pragma!module` pragma.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - the path of the module enclosing the pragma, as a `[c8]`
     *
     * @throws:
     *   - ErrorMsg if the pragma was given an argument, or is written outside
     *     any module
     */
    pub fn validateModule(dmut context: &ValidationContext, p: &PragmaExpr)-> &Value
        throws ErrorMsg
    {
        PragmaLocationValidation::verifyNoParams(p);

        let mut current = context.referent;
        while (current !of EmptySymbol) {
            if (current of ModuleSymbol) {
                return StringLiteralValidation::validate(p.loc, current.path.toStr(), StringSuffixes::UTF8);
            }

            current = current.referent;
        }

        throw copy ErrorMsg::fatal(p.loc, format(ValidateErrorMessage::NO_ENCLOSING_PRAGMA,
                                                 p.name.str, PragmaEnclosingKeys::MODULE));
    }

    /**
     * Validate the `__pragma!function` pragma.
     *
     * A method, a constructor, a destructor and a unittest all count as the
     * enclosing function.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - the path of the function enclosing the pragma, as a `[c8]`
     *
     * @throws:
     *   - ErrorMsg if the pragma was given an argument, or is written outside
     *     any function
     */
    pub fn validateFunction(dmut context: &ValidationContext, p: &PragmaExpr)-> &Value
        throws ErrorMsg
    {
        PragmaLocationValidation::verifyNoParams(p);

        let mut current = context.referent;
        while (current !of EmptySymbol) {
            if (current of FunctionSymbol || current of CtorSymbol
                || current of DtorSymbol || current of UnitTestSymbol) {
                return StringLiteralValidation::validate(p.loc, current.path.toStr(), StringSuffixes::UTF8);
            }

            current = current.referent;
        }

        throw copy ErrorMsg::fatal(p.loc, format(ValidateErrorMessage::NO_ENCLOSING_PRAGMA,
                                                 p.name.str, PragmaEnclosingKeys::FUNCTION));
    }

    /**
     * Validate the `__pragma!decl` pragma.
     *
     * A record and an entity are class symbols, and are named by the same path
     * as a class.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - the path of the aggregate declaration enclosing the pragma, as a `[c8]`
     *
     * @throws:
     *   - ErrorMsg if the pragma was given an argument, or is written outside
     *     any aggregate declaration
     */
    pub fn validateDecl(dmut context: &ValidationContext, p: &PragmaExpr)-> &Value
        throws ErrorMsg
    {
        PragmaLocationValidation::verifyNoParams(p);

        let mut current = context.referent;
        while (current !of EmptySymbol) {
            if (current of ClassSymbol || current of TraitSymbol
                || current of EnumSymbol || current of UnionSymbol) {
                return StringLiteralValidation::validate(p.loc, current.path.toStr(), StringSuffixes::UTF8);
            }

            current = current.referent;
        }

        throw copy ErrorMsg::fatal(p.loc, format(ValidateErrorMessage::NO_ENCLOSING_PRAGMA,
                                                 p.name.str, PragmaEnclosingKeys::DECL));
    }

    /**
     * Verify that a pragma of this module was given no argument.
     *
     * @params:
     *   - p: the pragma expression
     *
     * @throws:
     *   - ErrorMsg if the pragma has at least one argument
     */
    fn verifyNoParams(p: &PragmaExpr)
        throws ErrorMsg
    {
        if (p.params.len != 0us) {
            throw copy ErrorMsg::fatal(p.loc, format(ValidateErrorMessage::MALFORMED_PRAGMA, p.name.str));
        }
    }

}
