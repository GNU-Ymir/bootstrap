in method_tag;

use ymirc::errors;
use ymirc::semantic::symbol;
use ymirc::semantic::generator::type::{custom, temporary};
use ymirc::semantic::generator::value::literal;
use ymirc::semantic::validator::pragma::tag_value;
use ymirc::syntax::expression::operator;
use ymirc::utils::format;

/**
 * PragmaMethodTagValidation module
 *
 * Provides the implementation of the `__pragma!method_has_tag`,
 * `__pragma!method_tag` and `__pragma!method_tags` pragmas.
 *
 * Expected forms:
 *
 *     __pragma!method_has_tag(T, "method", tag)
 *     __pragma!method_tag(T, "method", tag)
 *     __pragma!method_tags(T, "method", tag)
 *
 * where `T` is a class, a record or an entity type, `"method"` the
 * compile-time name of some of the methods it declares, and `tag` names a tag.
 * The sites of every method of that name are read, overloads and templates
 * included, in the order they are written. `method_has_tag` returns a
 * compile-time `bool`, true iff one of them names `tag`; `method_tag` and
 * `method_tags` return the value of the single site of `tag` on the methods
 * and the static array of the values of all of them, as `__pragma!field_tag`
 * and `__pragma!field_tags` do for a field.
 */
pub mod PragmaMethodTagValidation {

    /**
     * Entry point for the `__pragma!method_has_tag` handler.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - Ok(&Value) containing the result of `validateHasTag`
     *   - Err(&ErrorMsg) if validation fails
     */
    pub fn handleHasTag(dmut context: &ValidationContext, p: &PragmaExpr)-> (&Value)? {
        return (PragmaMethodTagValidation::validateHasTag(alias context, p))?;
    }

    /**
     * Entry point for the `__pragma!method_tag` handler.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - Ok(&Value) containing the result of `validateTag`
     *   - Err(&ErrorMsg) if validation fails
     */
    pub fn handleTag(dmut context: &ValidationContext, p: &PragmaExpr)-> (&Value)? {
        return (PragmaMethodTagValidation::validateTag(alias context, p))?;
    }

    /**
     * Entry point for the `__pragma!method_tags` handler.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - Ok(&Value) containing the result of `validateTags`
     *   - Err(&ErrorMsg) if validation fails
     */
    pub fn handleTags(dmut context: &ValidationContext, p: &PragmaExpr)-> (&Value)? {
        return (PragmaMethodTagValidation::validateTags(alias context, p))?;
    }

    /**
     * Validate the `__pragma!method_has_tag` pragma.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns: true iff one of the methods carries the tag, as a compile-time `bool`
     *
     * @throws:
     *   - ErrorMsg if the pragma is malformed, if its parameters name no method or no tag,
     *     or if the path of a site of the methods names no tag
     */
    pub fn validateHasTag(dmut context: &ValidationContext, p: &PragmaExpr)-> &Value
        throws ErrorMsg
    {
        let (sym, name, tag) = PragmaMethodTagValidation::validateParams(alias context, p);
        copy BoolValue(p.loc, TagValidation::methodCarries(alias context, sym, name, tag))
    }

    /**
     * Validate the `__pragma!method_tag` pragma.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns: the value of the single site of the tag on the methods
     *
     * @throws:
     *   - ErrorMsg if the pragma is malformed, if its parameters name no method or no tag,
     *     if a site does not resolve, or if the methods carry the tag zero or several times
     */
    pub fn validateTag(dmut context: &ValidationContext, p: &PragmaExpr)-> &Value
        throws ErrorMsg
    {
        let (sym, name, tag) = PragmaMethodTagValidation::validateParams(alias context, p);
        let values = TagValidation::methodSiteValues(alias context, sym, name, tag);

        PragmaTagValueValidation::single(p.loc, format("%.%", sym.path.toStr(), name), tag, values)
    }

    /**
     * Validate the `__pragma!method_tags` pragma.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns: the static array of the values of the sites of the tag on the methods
     *
     * @throws:
     *   - ErrorMsg if the pragma is malformed, if its parameters name no method or no tag,
     *     or if a site does not resolve
     */
    pub fn validateTags(dmut context: &ValidationContext, p: &PragmaExpr)-> &Value
        throws ErrorMsg
    {
        let (sym, name, tag) = PragmaMethodTagValidation::validateParams(alias context, p);
        let values = TagValidation::methodSiteValues(alias context, sym, name, tag);

        PragmaTagValueValidation::array(alias context, p.loc, format("%.%", sym.path.toStr(), name), tag, values)
    }

    /**
     * Validate the parameters of a method tag pragma: a class, a record or an
     * entity type, the name of some of its methods and a tag.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns: the class, the name of the methods, and the tag
     *
     * @throws:
     *   - ErrorMsg if the pragma does not take three parameters, if the first is
     *     not a class, if the class declares no method of that name, or if the
     *     last names no tag
     */
    fn validateParams(dmut context: &ValidationContext, p: &PragmaExpr)-> (&ClassSymbol, [c8], &TagSymbol)
        throws ErrorMsg
    {
        if (p.params.len != 3us) {
            throw copy ErrorMsg::fatal(p.loc, format(ValidateErrorMessage::MALFORMED_PRAGMA, p.name.str));
        }

        let type = TypeValidation::validate(alias context, p.params[0]);
        let sym = match type {
            c: &ClassRefType => { c.sym }
            c: &ClassPtrType => { c.sym }
            _ => {
                throw copy ErrorMsg::fatal(p.params[0].loc, format(ValidateErrorMessage::TYPE_HAS_NO_METHOD, type));
            }
        };

        let name = context.cteInterpret:.decodeString(ValueValidation::validate(alias context, p.params[1]));
        let tag = PragmaTagValueValidation::validateTagName(alias context, p.params[2]);
        for m in sym.methods if (m.loc.str == name) {
            return (sym, name, tag);
        }

        throw copy ErrorMsg::fatal(p.params[1].loc, format(ValidateErrorMessage::CLASS_NO_METHOD, type, name));
    }

}
