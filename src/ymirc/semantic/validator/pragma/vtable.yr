 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in vtable;

use ymirc::errors;
use ymirc::semantic::generator::type::{custom, temporary};
use ymirc::semantic::generator::value::literal;
use ymirc::syntax::expression::operator;
use ymirc::utils::format;

/**
 * PragmaVtableValidation module
 *
 * Provides the implementation of the `__pragma!vtable` pragma.
 *
 * Expected form:
 *
 *     __pragma!vtable(C)
 *
 * where `C` is a class type, written `&C` or `C`. The pragma returns the
 * address of the vtable of the class, typed `*void`. Only a class that is
 * neither abstract nor a structure has a vtable.
 */
pub mod PragmaVtableValidation {

    /**
     * Entry point for the pragma handler.
     *
     * Wraps `validate` in an option type, allowing integration with the pragma
     * dispatch system. The handler itself never throws; any semantic error is
     * returned as Err(&ErrorMsg).
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - Ok(&Value) containing the result of `validate`
     *   - Err(&ErrorMsg) if validation fails
     */
    pub fn handle(dmut context: &ValidationContext, p: &PragmaExpr)-> (&Value)? {
        return (PragmaVtableValidation::validate(alias context, p))?;
    }

    /**
     * Validate the `__pragma!vtable` pragma.
     *
     * Expected form:
     *
     *     __pragma!vtable(C)
     *
     * Steps:
     *   1. Ensure exactly one parameter is provided.
     *   2. Validate the parameter as a type, unwrapping an enum to its proxy.
     *   3. Accept only class types, `&C` and `C` alike.
     *   4. Reject the structures and the abstract classes, they have no vtable.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - a ClassVtableValue referencing the vtable of the class
     *
     * @throws:
     *   - ErrorMsg if the pragma is malformed or the class has no vtable
     */
    pub fn validate(dmut context: &ValidationContext, p: &PragmaExpr)-> &Value
        throws ErrorMsg
    {
        if p.params.len != 1 {
            throw copy ErrorMsg::fatal(p.loc, format(ValidateErrorMessage::MALFORMED_PRAGMA, p.name.str));
        }

        let ty = TypeValidation::validate(alias context, p.params[0]);
        let inner = if let e: &EnumType = ty { e.getLastLevelProxy() } else { ty };

        let cl = match inner {
            c: &ClassPtrType => { c.inner }
            c: &ClassRefType => { c }
            _ => throw copy ErrorMsg::fatal(p.params[0].loc, format(ValidateErrorMessage::NOT_A_CLASS, inner));
        };

        if cl.sym.isStruct {
            throw copy ErrorMsg::fatal(p.params[0].loc, format(ValidateErrorMessage::VTABLE_STRUCT, cl));
        }

        if cl.sym.isAbstract {
            throw copy ErrorMsg::fatal(p.params[0].loc, format(ValidateErrorMessage::VTABLE_ABSTRACT_CLASS, cl));
        }

        return copy ClassVtableValue(p.loc, cl);
    }

}
