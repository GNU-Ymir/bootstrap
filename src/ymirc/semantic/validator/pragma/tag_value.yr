 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in tag_value;

use ymirc::errors;
use ymirc::lexing::word;
use ymirc::semantic::{symbol, template_};
use ymirc::semantic::generator::type::native;
use ymirc::semantic::generator::value::{literal, variable};
use ymirc::semantic::validator::pragma::has_tag;
use ymirc::syntax::expression::operator;
use ymirc::utils::format;

/**
 * PragmaTagValueValidation module
 *
 * Provides the implementation of the `__pragma!tag` and `__pragma!tags` pragmas.
 *
 * Expected forms:
 *
 *     __pragma!tag(sym, tag)
 *     __pragma!tags(sym, tag)
 *
 * where `sym` names a symbol tags can be written on, as for `__pragma!has_tag`,
 * and `tag` names a tag. The value of a site is a compile-time instance of the
 * site record of the tag, a field per parameter holding the argument bound to
 * it. `tag` returns the value of the single site of `tag` on `sym`, `tags` the
 * static array of the values of all of them, in the order they are written.
 */
pub mod PragmaTagValueValidation {

    /**
     * Entry point for the `__pragma!tag` handler.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - Ok(&Value) containing the result of `validateTag`
     *   - Err(&ErrorMsg) if validation fails
     */
    pub fn handleTag(dmut context: &ValidationContext, p: &PragmaExpr)-> (&Value)? {
        return (PragmaTagValueValidation::validateTag(alias context, p))?;
    }

    /**
     * Entry point for the `__pragma!tags` handler.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - Ok(&Value) containing the result of `validateTags`
     *   - Err(&ErrorMsg) if validation fails
     */
    pub fn handleTags(dmut context: &ValidationContext, p: &PragmaExpr)-> (&Value)? {
        return (PragmaTagValueValidation::validateTags(alias context, p))?;
    }

    /**
     * Validate the `__pragma!tag` pragma.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns: the value of the single site of the tag on the symbol
     *
     * @throws:
     *   - ErrorMsg if the pragma is malformed, if its parameters name no tagged symbol or no tag,
     *     if a site does not resolve, or if the symbol carries the tag zero or several times
     */
    pub fn validateTag(dmut context: &ValidationContext, p: &PragmaExpr)-> &Value
        throws ErrorMsg
    {
        if (p.params.len != 2us) {
            throw copy ErrorMsg::fatal(p.loc, format(ValidateErrorMessage::MALFORMED_PRAGMA, p.name.str));
        }

        let sym = PragmaHasTagValidation::validateCarrier(alias context, p.params[0]);
        let tag = PragmaTagValueValidation::validateTagName(alias context, p.params[1]);

        PragmaTagValueValidation::single(p.loc, sym.path.toStr(), tag, TagValidation::siteValues(alias context, sym, tag))
    }

    /**
     * Validate the `__pragma!tags` pragma.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns: the static array of the values of the sites of the tag on the symbol
     *
     * @throws:
     *   - ErrorMsg if the pragma is malformed, if its parameters name no tagged symbol or no tag,
     *     or if a site does not resolve
     */
    pub fn validateTags(dmut context: &ValidationContext, p: &PragmaExpr)-> &Value
        throws ErrorMsg
    {
        if (p.params.len != 2us) {
            throw copy ErrorMsg::fatal(p.loc, format(ValidateErrorMessage::MALFORMED_PRAGMA, p.name.str));
        }

        let sym = PragmaHasTagValidation::validateCarrier(alias context, p.params[0]);
        let tag = PragmaTagValueValidation::validateTagName(alias context, p.params[1]);

        PragmaTagValueValidation::array(alias context, p.loc, sym.path.toStr(), tag, TagValidation::siteValues(alias context, sym, tag))
    }

    /**
     * @params:
     *   - context: validation context
     *   - expr:    the parameter of a pragma naming a tag
     *
     * @returns: the tag
     *
     * @throws:
     *   - ErrorMsg if the expression names no tag
     */
    pub fn validateTagName(dmut context: &ValidationContext, expr: &Expression)-> &TagSymbol
        throws ErrorMsg
    {
        if let t: &TagRefValue = ValueValidation::validate(alias context, expr) {
            return t.sym;
        }

        throw copy ErrorMsg::fatal(expr.loc, format(ValidateErrorMessage::NOT_A_TAG, expr));
    }

    /**
     * @params:
     *   - loc:     the location of the pragma
     *   - carrier: the name of what the sites are written on
     *   - tag:     the tag the sites name
     *   - values:  the values of the sites
     *
     * @returns: the value of the single site
     *
     * @throws:
     *   - ErrorMsg if there is not exactly one site
     */
    pub fn single(loc: &Word, carrier: [c8], tag: &TagSymbol, values: [&Value])-> &Value
        throws ErrorMsg
    {
        if (values.len != 1us) {
            throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::TAG_SITE_NOT_SINGLE, carrier, values.len, tag.path.toStr()),
                                       notes-> copy [copy ErrorMsg::note(v.loc, "") for v in values]);
        }

        values[0]
    }

    /**
     * @params:
     *   - context: validation context
     *   - loc:     the location of the pragma
     *   - carrier: the name of what the sites are written on
     *   - tag:     the tag the sites name
     *   - values:  the values of the sites
     *
     * @returns: the static array of the values, of the site record of the tag;
     * an array of void if there are none and the tag declares template parameters
     *
     * @throws:
     *   - ErrorMsg if two sites instantiate the site record of the tag differently
     */
    pub fn array(dmut context: &ValidationContext, loc: &Word, carrier: [c8], tag: &TagSymbol, values: [&Value])-> &Value
        throws ErrorMsg
    {
        let inner: &Type = if (values.len != 0us) {
            values[0].type
        } else if (tag.decl.templates.len == 0us) {
            TagValidation::siteRecord(alias context, loc, tag, TemplateMapper())
        } else {
            VOID_TYPE
        };

        for v in values if (v.type != inner) {
            throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::TAG_SITES_RECORDS, tag.path.toStr(), carrier, inner, v.type),
                                       notes-> copy [copy ErrorMsg::note(values[0].loc, ""), copy ErrorMsg::note(v.loc, "")]);
        }

        copy ArrayValue(loc, copy ArrayType(loc, inner, values.len, isMutable-> false), values)
    }

}
