 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in version;

use ymirc::errors;
use ymirc::global::state;
use ymirc::lexing::{keys, word};
use ymirc::semantic::generator::value::literal;
use ymirc::syntax::expression::{literal, operator};
use ymirc::utils::format;

/**
 * PragmaVersionValidation module
 *
 * Provides the implementation of the pragmas reading the versions of the
 * compilation.
 *
 * Expected forms:
 *
 *     __pragma!has_version(NAME)
 *     __pragma!version_value(NAME)
 *
 * where `NAME` is the identifier of the version, in any case. The first returns
 * a compile-time `bool`, true iff the version is set, valued or not. The second
 * returns the value of the version as a compile-time `[c8]`, converted if need
 * be by `std::conv::to`, which runs at compile time.
 */
pub mod PragmaVersionValidation {

    /**
     * Entry point of the `__pragma!has_version` handler.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - Ok(&Value) containing the result of `validateHasVersion`
     *   - Err(&ErrorMsg) if validation fails
     */
    pub fn handleHasVersion(dmut context: &ValidationContext, p: &PragmaExpr)-> (&Value)? {
        return (PragmaVersionValidation::validateHasVersion(alias context, p))?;
    }

    /**
     * Entry point of the `__pragma!version_value` handler.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - Ok(&Value) containing the result of `validateVersionValue`
     *   - Err(&ErrorMsg) if validation fails
     */
    pub fn handleVersionValue(dmut context: &ValidationContext, p: &PragmaExpr)-> (&Value)? {
        return (PragmaVersionValidation::validateVersionValue(alias context, p))?;
    }

    /**
     * Validate the `__pragma!has_version` pragma.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns: true iff the version is set, as a compile-time `bool`
     *
     * @throws:
     *   - ErrorMsg if the pragma is not given a single identifier
     */
    pub fn validateHasVersion(dmut _: &ValidationContext, p: &PragmaExpr)-> &Value
        throws ErrorMsg
    {
        let name = PragmaVersionValidation::readName(p);
        copy BoolValue(p.loc, state::isVersionActive(name.str))
    }

    /**
     * Validate the `__pragma!version_value` pragma.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns: the value of the version, as a compile-time `[c8]`
     *
     * @throws:
     *   - ErrorMsg if the pragma is not given a single identifier
     *   - ErrorMsg E4370 if the version is not set, or was given no value
     */
    pub fn validateVersionValue(dmut _: &ValidationContext, p: &PragmaExpr)-> &Value
        throws ErrorMsg
    {
        let name = PragmaVersionValidation::readName(p);
        if let Ok(value) = state::versionValue(name.str) {
            return StringLiteralValidation::validate(p.loc, value, StringSuffixes::UTF8);
        }

        throw copy ErrorMsg::fatal(name, format(ValidateErrorMessage::VERSION_NO_VALUE, name.str));
    }

    /**
     * @params:
     *   - p: the pragma expression
     *
     * @returns: the identifier of the version the pragma reads
     *
     * @throws:
     *   - ErrorMsg if the pragma is not given a single identifier
     */
    fn readName(p: &PragmaExpr)-> &Word
        throws ErrorMsg
    {
        if p.params.len == 1us {
            if let v: &VarExpr = p.params[0] {
                return v.name;
            }
        }

        throw copy ErrorMsg::fatal(p.loc, format(ValidateErrorMessage::MALFORMED_PRAGMA, p.name.str));
    }

}
