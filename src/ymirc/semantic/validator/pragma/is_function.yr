in is_function;

use ymirc::errors;
use ymirc::semantic::generator::{type::_, value::_};
use ymirc::syntax::declaration::function;
use ymirc::syntax::expression::operator;
use ymirc::utils::format;

/**
 * PragmaIsFunctionValidation module
 *
 * Provides the implementation of the `__pragma!is_function` pragma.
 *
 * Expected form:
 *
 *     __pragma!is_function(F)
 *
 * It returns a compile-time `bool`, true iff `F` is a function symbol (a
 * function, a generator, an async, an overload set, a function template, a
 * lambda) or a callable type (a function pointer, a delegate, a closure, a
 * lambda), an enum being unwrapped to its proxy. Anything else is false, so the
 * pragma can guard an overload in a template test.
 */
pub mod PragmaIsFunctionValidation {

    /**
     * Entry point for the pragma handler.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - Ok(&Value) containing the result of `validate`
     *   - Err(&ErrorMsg) if validation fails
     */
    pub fn handle(dmut context: &ValidationContext, p: &PragmaExpr)-> (&Value)? {
        return (PragmaIsFunctionValidation::validate(alias context, p))?;
    }

    /**
     * Validate the `__pragma!is_function` pragma. The parameter is validated
     * as a type, and failing that as a value.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns: true iff the parameter is a function or a callable type, as a compile-time `bool`
     *
     * @throws:
     *   - ErrorMsg if the pragma is malformed, or if its parameter is neither a type nor a value
     */
    pub fn validate(dmut context: &ValidationContext, p: &PragmaExpr)-> &Value
        throws ErrorMsg
    {
        if (p.params.len != 1us) {
            throw copy ErrorMsg::fatal(p.loc, format(ValidateErrorMessage::MALFORMED_PRAGMA, p.name.str));
        }

        let type = (TypeValidation::validate(alias context, p.params[0]))?;
        let result = if let Ok(t) = type {
            PragmaIsFunctionValidation::isCallable(t)
        } else {
            PragmaIsFunctionValidation::isFunction(ValueValidation::validate(alias context, p.params[0]))
        };

        copy BoolValue(p.loc, result)
    }

    /**
     * @params:
     *   - value: a validated value
     *
     * @returns: true iff the value is a function symbol, an overload set of them, or a value of a callable type
     */
    fn isFunction(value: &Value)-> bool {
        match value {
            _: &PrototypeValue  => return true;
            _: &LambdaValue     => return true;
            _: &DelegateValue   => return true;
            t: &TemplateRefValue => return t.sym.decl.decl of FunctionDecl;
            m: &MultSymValue    => {
                for v in m.values {
                    if (!PragmaIsFunctionValidation::isFunction(v)) return false;
                }

                return m.values.len != 0us;
            }
        }

        PragmaIsFunctionValidation::isCallable(value.type)
    }

    /**
     * @params:
     *   - type: a validated type
     *
     * @returns: true iff the type is a function pointer, a delegate, a closure or a lambda type, through
     * enum proxies, or names a function template
     */
    fn isCallable(type: &Type)-> bool {
        let inner = if let e: &EnumType = type { e.getLastLevelProxy() } else { type };
        match inner {
            _: &FuncPtrType     => return true;
            _: &DelegateType    => return true;
            _: &ClosureType     => return true;
            _: &LambdaType      => return true;
            t: &TemplateRefType => return t.sym.decl.decl of FunctionDecl;
        }

        false
    }

}
