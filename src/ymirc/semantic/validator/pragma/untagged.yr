in untagged;

use ymirc::errors;
use ymirc::semantic::symbol;
use ymirc::semantic::generator::value::{multsym, prototype};
use ymirc::syntax::expression::operator;
use ymirc::utils::format;

/**
 * PragmaUntaggedValidation module
 *
 * Provides the implementation of the `__pragma!untagged` pragma.
 *
 * Expected form:
 *
 *     __pragma!untagged(foo)
 *
 * where `foo` names a tagged function, or an overload set holding one. It
 * returns the function as written, before its tags were merged into it.
 */
pub mod PragmaUntaggedValidation {

    /**
     * Entry point for the pragma handler.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - Ok(&Value) containing the result of `validate`
     *   - Err(&ErrorMsg) if validation fails
     */
    pub fn handle(dmut context: &ValidationContext, p: &PragmaExpr)-> (&Value)? {
        return (PragmaUntaggedValidation::validate(alias context, p))?;
    }

    /**
     * Validate the `__pragma!untagged` pragma. In an overload set, the tagged
     * functions are replaced by the functions as written, the others are kept.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns: the function as written, or the overload set holding them
     *
     * @throws:
     *   - ErrorMsg if the pragma is malformed, or if its parameter names no function whose
     *     tags are merged into it
     */
    pub fn validate(dmut context: &ValidationContext, p: &PragmaExpr)-> &Value
        throws ErrorMsg
    {
        if (p.params.len != 1us) {
            throw copy ErrorMsg::fatal(p.loc, format(ValidateErrorMessage::MALFORMED_PRAGMA, p.name.str));
        }

        let value = ValueValidation::validate(alias context, p.params[0]);
        let candidates: [&Value] = if let m: &MultSymValue = value { m.values } else { copy [value] };

        let mut found = false;
        let mut result: [&Value] = [];
        for c in candidates {
            if let pr: &PrototypeValue = c {
                if let f: &FunctionSymbol = pr.sym {
                    if let Ok(untagged) = f.untagged {
                        result ~= [FunctionValidation::validateProto(alias context, alias context:.getFunctionFromRef(untagged))];
                        found = true;
                        continue;
                    }
                }
            }

            result ~= [c];
        }

        if (!found) {
            throw copy ErrorMsg::fatal(p.params[0].loc, format(ValidateErrorMessage::NOT_TAGGED, p.params[0]));
        }

        if (result.len == 1us) return result[0];
        copy MultSymValue(value.loc, result)
    }

}
