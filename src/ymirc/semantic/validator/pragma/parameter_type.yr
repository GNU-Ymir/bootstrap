 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in parameter_type;

use ymirc::errors;
use ymirc::lexing::word;
use ymirc::semantic::generator::type::_;
use ymirc::semantic::validator::pragma::signature;
use ymirc::syntax::expression::operator;
use ymirc::utils::{bigint, format};

/**
 * PragmaParameterTypeValidation module
 *
 * Provides the implementation of the `__pragma!parameter_type` pragma.
 *
 * Expected forms:
 *
 *     __pragma!parameter_type(F, index)
 *     __pragma!parameter_type(F, "name")
 *
 * where `F` is a function or a callable type, as resolved by
 * PragmaSignatureValidation, the index a compile-time integer counting the
 * parameters from 0, and the name a compile-time string. The self of a method
 * is not a parameter.
 */
pub mod PragmaParameterTypeValidation {

    /**
     * Entry point for the pragma handler.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - Ok(&Type) containing the result of `validate`
     *   - Err(&ErrorMsg) if validation fails
     */
    pub fn handle(dmut context: &ValidationContext, p: &PragmaExpr)-> (&Type)? {
        return (PragmaParameterTypeValidation::validate(alias context, p))?;
    }

    /**
     * Validate the `__pragma!parameter_type` pragma.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns: the type of the selected parameter
     *
     * @throws:
     *   - ErrorMsg if the pragma is malformed, if its first parameter is not a single instantiated function, or
     *     if the function has no such parameter
     */
    pub fn validate(dmut context: &ValidationContext, p: &PragmaExpr)-> &Type
        throws ErrorMsg
    {
        if (p.params.len != 2us) {
            throw copy ErrorMsg::fatal(p.loc, format(ValidateErrorMessage::MALFORMED_PRAGMA, p.name.str));
        }

        let sig = PragmaSignatureValidation::resolve(alias context, p, p.params[0]);
        let selector = ValueValidation::validate(alias context, p.params[1]);
        if (selector.type of SliceType) {
            let name = context.cteInterpret:.decodeString(selector);
            return PragmaParameterTypeValidation::byName(p.params[1].loc, sig, name);
        }

        let index = context.cteInterpret:.computeInt(selector);
        PragmaParameterTypeValidation::byIndex(p.params[1].loc, sig, index)
    }

    /**
     * @params:
     *   - loc:   the location of the index
     *   - sig:   the reflected function
     *   - index: the index of the parameter
     *
     * @returns: the type of the parameter at `index`
     *
     * @throws:
     *   - ErrorMsg if the function has not that many parameters
     */
    fn byIndex(loc: &Word, sig: FunctionSignature, index: &BigInt)-> &Type
        throws ErrorMsg
    {
        let arity = sig.params.len;
        {
            if (index < 0) throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::PARAMETER_ARITY_OVERFLOW, index, arity));

            let res = index.to!usize();
            if (arity <= res) throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::PARAMETER_ARITY_OVERFLOW, index, arity));

            return sig.params[res].type;
        } catch {
            x: &ErrorMsg => throw x;
            _ => { // an index too large for a usize
                throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::PARAMETER_ARITY_OVERFLOW, index, arity));
            }
        }
    }

    /**
     * @params:
     *   - loc:  the location of the name
     *   - sig:  the reflected function
     *   - name: the name of the parameter
     *
     * @returns: the type of the parameter named `name`
     *
     * @throws:
     *   - ErrorMsg if the function has no parameter of that name, the parameters of a callable type having none
     */
    fn byName(loc: &Word, sig: FunctionSignature, name: [c8])-> &Type
        throws ErrorMsg
    {
        for param in sig.params if (param.name == name && name != "") {
            return param.type;
        }

        let mut names = "";
        for param in sig.params if (param.name != "") {
            names = if (names == "") { param.name } else { names ~ ", " ~ param.name };
        }

        let notes = if (names != "") {
            copy [copy ErrorMsg::note(loc, format(ValidateErrorMessage::PARAMETER_NAMES, names))]
        } else { [] };

        throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::PARAMETER_UNKNOWN, name), notes-> notes);
    }

}
