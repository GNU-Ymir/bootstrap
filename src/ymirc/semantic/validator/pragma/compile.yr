/*
 * Implements validation for the `__pragma!compile` pragma.
 *
 * The `__pragma!compile` pragma evaluates each of its arguments and returns `true`
 * only if all arguments are valid *either* as values *or* as types. This
 * allows compile-time checks such as:
 *
 *     __pragma!compile (expr)      // succeeds if expr is a valid value
 *     __pragma!compile (TypeName)  // succeeds if TypeName is a valid type
 *
 * If any argument fails both value and type validation, the pragma evaluates
 * to `false`.
 *
 * This module does not emit errors for invalid arguments; it only returns a
 * boolean result. It is therefore safe to use inside conditional compilation
 * constructs.

 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::semantic::validator::pragma::compile
 * @File: ymirc/semantic/validator/pragma/compile.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2026-03-27
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */ 
in compile;

use ymirc::syntax::expression::operator;
use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::literal, type};
use ymirc::utils::format;
use ymirc::errors::message;

/**
 * PragmaCompileValidation module
 *
 * Provides the implementation of the `__pragma!compile` pragma. This pragma
 * checks whether each of its parameters is semantically valid as either:
 *
 *   - a value (via ValueValidation), or
 *   - a type (via TypeValidation).
 *
 * If all parameters validate successfully, the pragma returns `true`.
 * Otherwise, it returns `false` without emitting any diagnostic.
 *
 * This behavior allows `__pragma!compile` to be used as a safe, non-throwing
 * probe inside conditional compilation constructs.
 * 
 */
pub mod PragmaCompileValidation {

    /**
     * Entry point for the pragma handler.
     *
     * Wraps `validate` in an optional return type, allowing integration with
     * the pragma dispatch system. 
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - the result of `validate`, wrapped in an option
     */
    pub fn handle (dmut context: &ValidationContext, p: &PragmaExpr)-> (&Value)? {
        return (PragmaCompileValidation::validate (alias context, p))?;
    }

    /**
     * Validate the `__pragma!compile` pragma.
     *
     * For each parameter:
     *   1. Attempt value validation (ValueValidation::validate).
     *      - If it succeeds => the parameter is valid.
     *      - If it fails => attempt type validation.
     *   2. If both validations fail => the pragma evaluates to `false`.
     *
     * If all parameters validate successfully, the pragma evaluates to `true`.
     *
     * No errors are propagated: invalid parameters simply cause the pragma to
     * return `false`. This allows `__pragma!compile` to be used safely in
     * conditional compilation contexts.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - BoolValue(true)  if all parameters validate
     *   - BoolValue(false) otherwise
     */
    pub fn validate (dmut context: &ValidationContext, p: &PragmaExpr)-> &Value {
        for v in p.params {
            let succValue = {
                ValueValidation::validate (alias context, v, canBeRef-> true, canBeLazy-> true);
                true
            } catch {
                _ => { false }
            };

            let succ = if (!succValue) {
                TypeValidation::validate (alias context, v);
                true
            } catch {
                _ => false
            } else { true };

            if (!succ) return copy BoolValue (p.loc, isTrue-> false);
        }

        return copy BoolValue (p.loc, true);
    }
            
}
