in field_tag;

use ymirc::errors;
use ymirc::semantic::symbol;
use ymirc::semantic::generator::type::{custom, temporary};
use ymirc::semantic::generator::value::literal;
use ymirc::semantic::validator::pragma::tag_value;
use ymirc::syntax::expression::operator;
use ymirc::utils::format;

/**
 * PragmaFieldTagValidation module
 *
 * Provides the implementation of the `__pragma!field_has_tag`,
 * `__pragma!field_tag` and `__pragma!field_tags` pragmas.
 *
 * Expected forms:
 *
 *     __pragma!field_has_tag(T, "field", tag)
 *     __pragma!field_tag(T, "field", tag)
 *     __pragma!field_tags(T, "field", tag)
 *
 * where `T` is a class or a record type, `"field"` the compile-time name of one
 * of the fields it declares, and `tag` names a tag. `field_has_tag` returns a
 * compile-time `bool`, true iff a site written on top of the field names `tag`;
 * `field_tag` and `field_tags` return the value of the single site of `tag` on
 * the field and the static array of the values of all of them, as
 * `__pragma!tag` and `__pragma!tags` do for a symbol.
 */
pub mod PragmaFieldTagValidation {

    /**
     * Entry point for the `__pragma!field_has_tag` handler.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - Ok(&Value) containing the result of `validateHasTag`
     *   - Err(&ErrorMsg) if validation fails
     */
    pub fn handleHasTag(dmut context: &ValidationContext, p: &PragmaExpr)-> (&Value)? {
        return (PragmaFieldTagValidation::validateHasTag(alias context, p))?;
    }

    /**
     * Entry point for the `__pragma!field_tag` handler.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - Ok(&Value) containing the result of `validateTag`
     *   - Err(&ErrorMsg) if validation fails
     */
    pub fn handleTag(dmut context: &ValidationContext, p: &PragmaExpr)-> (&Value)? {
        return (PragmaFieldTagValidation::validateTag(alias context, p))?;
    }

    /**
     * Entry point for the `__pragma!field_tags` handler.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - Ok(&Value) containing the result of `validateTags`
     *   - Err(&ErrorMsg) if validation fails
     */
    pub fn handleTags(dmut context: &ValidationContext, p: &PragmaExpr)-> (&Value)? {
        return (PragmaFieldTagValidation::validateTags(alias context, p))?;
    }

    /**
     * Validate the `__pragma!field_has_tag` pragma.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns: true iff the field carries the tag, as a compile-time `bool`
     *
     * @throws:
     *   - ErrorMsg if the pragma is malformed, if its parameters name no field or no tag,
     *     or if the path of a site of the field names no tag
     */
    pub fn validateHasTag(dmut context: &ValidationContext, p: &PragmaExpr)-> &Value
        throws ErrorMsg
    {
        let (sym, index, tag) = PragmaFieldTagValidation::validateParams(alias context, p);
        copy BoolValue(p.loc, TagValidation::fieldCarries(alias context, sym, index, tag))
    }

    /**
     * Validate the `__pragma!field_tag` pragma.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns: the value of the single site of the tag on the field
     *
     * @throws:
     *   - ErrorMsg if the pragma is malformed, if its parameters name no field or no tag,
     *     if a site does not resolve, or if the field carries the tag zero or several times
     */
    pub fn validateTag(dmut context: &ValidationContext, p: &PragmaExpr)-> &Value
        throws ErrorMsg
    {
        let (sym, index, tag) = PragmaFieldTagValidation::validateParams(alias context, p);
        let values = TagValidation::fieldSiteValues(alias context, sym, index, tag);

        PragmaTagValueValidation::single(p.loc, PragmaFieldTagValidation::fieldName(sym, index), tag, values)
    }

    /**
     * Validate the `__pragma!field_tags` pragma.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns: the static array of the values of the sites of the tag on the field
     *
     * @throws:
     *   - ErrorMsg if the pragma is malformed, if its parameters name no field or no tag,
     *     or if a site does not resolve
     */
    pub fn validateTags(dmut context: &ValidationContext, p: &PragmaExpr)-> &Value
        throws ErrorMsg
    {
        let (sym, index, tag) = PragmaFieldTagValidation::validateParams(alias context, p);
        let values = TagValidation::fieldSiteValues(alias context, sym, index, tag);

        PragmaTagValueValidation::array(alias context, p.loc, PragmaFieldTagValidation::fieldName(sym, index), tag, values)
    }

    /**
     * Validate the parameters of a field tag pragma: a class or a record type,
     * the name of one of its fields and a tag.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns: the class, the index of the field, and the tag
     *
     * @throws:
     *   - ErrorMsg if the pragma does not take three parameters, if the first is
     *     not a class or a record, if the class declares no field of that name,
     *     or if the last names no tag
     */
    fn validateParams(dmut context: &ValidationContext, p: &PragmaExpr)-> (&ClassSymbol, usize, &TagSymbol)
        throws ErrorMsg
    {
        if (p.params.len != 3us) {
            throw copy ErrorMsg::fatal(p.loc, format(ValidateErrorMessage::MALFORMED_PRAGMA, p.name.str));
        }

        let type = TypeValidation::validate(alias context, p.params[0]);
        let sym = match type {
            c: &ClassRefType => { c.sym }
            c: &ClassPtrType => { c.sym }
            _ => {
                throw copy ErrorMsg::fatal(p.params[0].loc, format(ValidateErrorMessage::TYPE_HAS_NO_FIELDINFO, type));
            }
        };

        let name = context.cteInterpret:.decodeString(ValueValidation::validate(alias context, p.params[1]));
        let tag = PragmaTagValueValidation::validateTagName(alias context, p.params[2]);
        for i, f in sym.fields if (f.name.str == name) {
            return (sym, i, tag);
        }

        throw copy ErrorMsg::fatal(p.params[1].loc, format(ValidateErrorMessage::TYPE_NO_FIELD, type, name));
    }

    /**
     * @returns: the name of the field `index` of `sym`, prefixed by the path of the class
     */
    fn fieldName(sym: &ClassSymbol, index: usize)-> [c8] {
        format("%.%", sym.path.toStr(), sym.fields[index].name.str)
    }

}
