 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in parameter_infos;

use ymirc::errors;
use ymirc::lexing::keys;
use ymirc::semantic::generator::value::_;
use ymirc::semantic::generator::type::native;
use ymirc::semantic::validator::pragma::signature;
use ymirc::syntax::expression::operator;
use ymirc::utils::format;

/**
 * PragmaParameterInfosValidation module
 *
 * Provides the implementation of the `__pragma!parameter_infos` pragma.
 *
 * Expected form:
 *
 *     __pragma!parameter_infos(F)
 *
 * where `F` is a function or a callable type, as resolved by
 * PragmaSignatureValidation. It returns a compile-time static array of
 * ParamInfo, one per parameter in declaration order, the self of a method
 * left out. The parameters of a callable type have an empty name, and are
 * neither mutable, named nor defaulted.
 */
pub mod PragmaParameterInfosValidation {

    /**
     * Entry point for the pragma handler.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - Ok(&Value) containing the result of `validate`
     *   - Err(&ErrorMsg) if validation fails
     */
    pub fn handle(dmut context: &ValidationContext, p: &PragmaExpr)-> (&Value)? {
        return (PragmaParameterInfosValidation::validate(alias context, p))?;
    }

    /**
     * Validate the `__pragma!parameter_infos` pragma.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns: a static array of ParamInfo describing the parameters of the function
     *
     * @throws:
     *   - ErrorMsg if the pragma is malformed, if its parameter is not a single instantiated function, or if the
     *     core declares no ParamInfo record
     */
    pub fn validate(dmut context: &ValidationContext, p: &PragmaExpr)-> &Value
        throws ErrorMsg
    {
        if (p.params.len != 1us) {
            throw copy ErrorMsg::fatal(p.loc, format(ValidateErrorMessage::MALFORMED_PRAGMA, p.name.str));
        }

        let sig = PragmaSignatureValidation::resolve(alias context, p, p.params[0]);
        let pi = TypeCreation::createParamInfo(alias context, p.loc);

        let mut values: [&Value] = [];
        for param in sig.params {
            values ~= [copy StructInitValue(p.loc,
                                             type-> pi,
                                             values-> copy [copy StringValue(p.loc, param.name),
                                                            copy BoolValue(p.loc, param.isMutable),
                                                            copy BoolValue(p.loc, param.isRef),
                                                            copy BoolValue(p.loc, param.isLazy),
                                                            copy BoolValue(p.loc, param.isNamed),
                                                            copy BoolValue(p.loc, param.hasDefault)],
                                             fields-> copy [ParamInfoKeys::NAME,
                                                            ParamInfoKeys::IS_MUTABLE,
                                                            ParamInfoKeys::IS_REF,
                                                            ParamInfoKeys::IS_LAZY,
                                                            ParamInfoKeys::IS_NAMED,
                                                            ParamInfoKeys::HAS_DEFAULT])];
        }

        let arrType = copy ArrayType(p.loc, pi, values.len, isMutable-> false);
        copy ArrayValue(p.loc, arrType, values)
    }

}
