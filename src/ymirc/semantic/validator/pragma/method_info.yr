in method_info;

use ymirc::errors;
use ymirc::semantic::symbol;
use ymirc::semantic::generator::value::_;
use ymirc::semantic::generator::type::{custom, native, temporary};
use ymirc::semantic::validator::pragma::{function_infos, signature};
use ymirc::syntax::declaration::block;
use ymirc::syntax::expression::operator;
use ymirc::utils::format;

/**
 * PragmaMethodInfosValidation module
 *
 * Provides the implementation of the `__pragma!method_infos` pragma.
 *
 * Expected form:
 *
 *     __pragma!method_infos(T)
 *
 * where `T` is a class, a record or an entity. It returns a static array of
 * compile-time FunctionInfo, one per method `T` declares, its implementations
 * included, in the order they are written: the methods its ancestors declare
 * and the templates of methods are left out, as are the methods the scope of
 * the pragma cannot access. The name of a FunctionInfo is the one of the
 * method, as `__pragma!method` reaches it.
 */
pub mod PragmaMethodInfosValidation {

    /**
     * Entry point for the pragma handler.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - Ok(&Value) containing the result of `validate`
     *   - Err(&ErrorMsg) if validation fails
     */
    pub fn handle(dmut context: &ValidationContext, p: &PragmaExpr)-> (&Value)? {
        return (PragmaMethodInfosValidation::validate(alias context, p))?;
    }

    /**
     * Validate the `__pragma!method_infos` pragma.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns: the static array of the FunctionInfo of the methods of the type
     *
     * @throws:
     *   - ErrorMsg if the pragma is malformed, if its parameter is not a class,
     *     a record or an entity, or if the prototype of a method does not validate
     */
    pub fn validate(dmut context: &ValidationContext, p: &PragmaExpr)-> &Value
        throws ErrorMsg
    {
        if (p.params.len != 1us) {
            throw copy ErrorMsg::fatal(p.loc, format(ValidateErrorMessage::MALFORMED_PRAGMA, p.name.str));
        }

        let type = TypeValidation::validate(alias context, p.params[0]);
        let cref = match type {
            c: &ClassRefType => { c }
            c: &ClassPtrType => { c.inner }
            _ => {
                throw copy ErrorMsg::fatal(p.params[0].loc, format(ValidateErrorMessage::TYPE_HAS_NO_METHOD, type));
            }
        };

        let fi = TypeCreation::createFunctionInfo(alias context, p.loc);
        let (inPrv, inProt) = context.getCurrentClassReferentProtections(cref);
        let mut values: [&Value] = [];
        for m in cref.sym.methods if let f: &FunctionSymbol = m {
            let canAccess = match f.protection {
                Protection::PRIVATE   => { inPrv }
                Protection::PROTECTED => { inProt || inPrv }
                _                     => { true }
            };

            if (canAccess) {
                let proto = MethodValidation::validateProto(alias context, alias context:.getFunctionFromRef(f), cref);
                values ~= [PragmaFunctionInfosValidation::create(p.loc, fi, PragmaSignatureValidation::fromProto(proto), f.loc.str)];
            }
        }

        let arrType = copy ArrayType(p.loc, fi, values.len, isMutable-> false);
        copy ArrayValue(p.loc, arrType, values)
    }

}
