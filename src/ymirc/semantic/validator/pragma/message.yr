/*
 * Implements validation for the `__pragma!msg(...)` construct.
 *
 * The `msg` pragma evaluates each of its arguments and prints their value to
 * the compiler’s standard output. It is intended for debugging, tracing, and
 * compile-time diagnostics. The pragma always returns `unit`.
 *
 * Behavior:
 *   - String values are printed according to their encoding(UTF-8/16/32).
 *   - Non-string values are printed using the generic formatter.
 *   - No errors are thrown unless argument evaluation fails.
 *
 * This pragma has side effects(console output) but does not influence the
 * semantic value of the program.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::pragma::message
 * @File: ymirc/semantic/validator/pragma/message.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-03-27
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in message;

use ymirc::syntax::expression::operator;
use ymirc::semantic::validator;
use ymirc::semantic::generator::{value::literal, type};
use ymirc::utils::format;
use ymirc::errors;

use std::io;

/**
 * PragmaMessageValidation module
 *
 * Provides the implementation of the `__pragma!msg` pragma. This pragma
 * evaluates each of its parameters as a value and prints them to the compiler
 * output stream. It is primarily used for debugging and compile-time logging.
 *
 * Supported argument types:
 *   - StringValue - printed using the appropriate UTF decoding
 *   - any other Value - printed using the default formatter
 *
 * The pragma always returns `unit` and never propagates errors originating from
 * printing. Errors may still occur if argument evaluation fails.
 *
 */
pub mod PragmaMessageValidation {

    /**
     * Entry point for the pragma handler.
     *
     * Wraps `validate` in an option type, allowing integration with the pragma
     * dispatch system. The handler itself never throws; any semantic error is
     * returned as Err(&ErrorMsg).
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - Ok(&Value) containing the result of `validate`
     *   - Err(&ErrorMsg) if validation fails
     */
    pub fn handle(dmut context: &ValidationContext, p: &PragmaExpr)-> (&Value)? {
        return (PragmaMessageValidation::validate(alias context, p))?;
    }

    /**
     * Validate and execute the `__pragma!msg` pragma.
     *
     * For each argument:
     *   1. Evaluate the expression as a value.
     *   2. If the value is a StringValue:
     *        - decode and print according to its encoding(UTF-8/16/32)
     *      Otherwise:
     *        - print the value using the generic formatter
     *
     * The pragma always returns `unit` and does not propagate printing errors.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - UNIT_VALUE
     *
     * @throws:
     *   - ErrorMsg if argument evaluation fails
     */
    pub fn validate(dmut context: &ValidationContext, p: &PragmaExpr)-> &Value
        throws ErrorMsg
    {
        for v in p.params {
            let mut msg = ValueValidation::validate(alias context, v);
            match msg {
                s: &StringValue => {
                    match s.encodingSize {
                        8u16 => { println(Utf::decode(s.value.utf8)); }
                        16u16 => { println(Utf::decode(s.value.utf16)); }
                        _ => { println(Utf::decode(s.value.utf32)); }
                    }
                }
                m: _ => {
                    println(format("%", m));
                }
            }
        }

        UNIT_VALUE
    }

}
