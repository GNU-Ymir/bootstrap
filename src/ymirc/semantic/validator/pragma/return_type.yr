in return_type;

use ymirc::errors;
use ymirc::semantic::generator::type;
use ymirc::semantic::validator::pragma::signature;
use ymirc::syntax::expression::operator;
use ymirc::utils::format;

/**
 * PragmaReturnTypeValidation module
 *
 * Provides the implementation of the `__pragma!return_type` pragma.
 *
 * Expected form:
 *
 *     __pragma!return_type(F)
 *
 * where `F` is a function or a callable type, as resolved by
 * PragmaSignatureValidation.
 */
pub mod PragmaReturnTypeValidation {

    /**
     * Entry point for the pragma handler.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - Ok(&Type) containing the result of `validate`
     *   - Err(&ErrorMsg) if validation fails
     */
    pub fn handle(dmut context: &ValidationContext, p: &PragmaExpr)-> (&Type)? {
        return (PragmaReturnTypeValidation::validate(alias context, p))?;
    }

    /**
     * Validate the `__pragma!return_type` pragma.
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns: the declared return type of the function
     *
     * @throws:
     *   - ErrorMsg if the pragma is malformed, or if its parameter is not a single instantiated function
     */
    pub fn validate(dmut context: &ValidationContext, p: &PragmaExpr)-> &Type
        throws ErrorMsg
    {
        if (p.params.len != 1us) {
            throw copy ErrorMsg::fatal(p.loc, format(ValidateErrorMessage::MALFORMED_PRAGMA, p.name.str));
        }

        PragmaSignatureValidation::resolve(alias context, p, p.params[0]).retType
    }

}
