/*
 * Implements validation for the `__pragma!has_super(T)` construct.
 *
 * This pragma checks whether a class type has a direct ancestor(superclass).
 * It accepts a single type parameter and returns a boolean indicating whether
 * the class participates in an inheritance chain.
 *
 * Behavior:
 *   - The pragma requires exactly one parameter.
 *   - The parameter must be a class type(ClassPtrType).
 *   - Enum types are unwrapped to their underlying proxy type.
 *   - The pragma returns `true` if the class has a parent, `false` otherwise.
 *
 * This pragma is used for compile-time reflection and conditional logic based
 * on class inheritance.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::pragma::ancestor_value
 * @File: ymirc/semantic/validator/pragma/ancestor_value.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-03-27
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in ancestor_value;


use ymirc::syntax::expression::operator;
use ymirc::semantic::validator;

use ymirc::semantic::generator::{value::literal, type::_};
use ymirc::utils::format;
use ymirc::errors::message;

/**
 * PragmaHasAncestorValidation module
 *
 * Provides the implementation of the `__pragma!has_super` pragma. This pragma
 * determines whether a class type has a direct ancestor by inspecting its
 * inheritance metadata.
 *
 * Expected form:
 *
 *     __pragma!has_super(T)
 *
 * where `T` must be a class type. The pragma returns a boolean value:
 *
 *   - true  - if the class has a superclass
 *   - false - if the class is a root class
 *
 * This pragma complements `__pragma!super` (which returns the ancestor type)
 * and `__pragma!root_super` (which returns the topmost ancestor).
 */
pub mod PragmaHasAncestorValidation {

    /**
     * Entry point for the pragma handler.
     *
     * Wraps `validate` in an option type, allowing integration with the pragma
     * dispatch system. The handler itself never throws; any semantic error is
     * returned as Err(&ErrorMsg).
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - Ok(&Value) containing the result of `validate`
     *   - Err(&ErrorMsg) if validation fails
     */
    pub fn handle(dmut context: &ValidationContext, p: &PragmaExpr)-> (&Value)? {
        return (PragmaHasAncestorValidation::validate(alias context, p))?;
    }

    /**
     * Validate the `__pragma!has_super` pragma.
     *
     * Expected form:
     *
     *     __pragma!has_super(T)
     *
     * Steps:
     *   1. Ensure exactly one parameter is provided.
     *   2. Validate the parameter as a type.
     *   3. If the type is an EnumType, unwrap it to its proxy type.
     *   4. Accept only class types:
     *        - ClassPtrType => extract the underlying class symbol
     *   5. Return a boolean indicating whether the class has a direct ancestor.
     *
     * Errors:
     *   - Wrong number of parameters
     *   - Parameter is not a class type
     *   - ClassRefType used on a non-struct class
     *
     * @params:
     *   - context: validation context
     *   - p:       the pragma expression
     *
     * @returns:
     *   - BoolValue(true)  if the class has a superclass
     *   - BoolValue(false) otherwise
     *
     * @throws:
     *   - ErrorMsg if the pragma is malformed or the parameter is not a class
     */
    pub fn validate(dmut context: &ValidationContext, p: &PragmaExpr)-> &Value
        throws ErrorMsg
    {
        if p.params.len != 1 {
            throw copy ErrorMsg::fatal(p.loc, format(ValidateErrorMessage::MALFORMED_PRAGMA, p.loc.str));
        }

        let ty = TypeValidation::validate(alias context, p.params[0]);
        let inner = if let e: &EnumType = ty { e.getLastLevelProxy() } else { ty };

        let mut cl = match inner {
            c: &ClassPtrType => { c.inner }
            c: &ClassRefType => {
                if !c.sym.isStruct {
                    let loc = p.params[0].loc;
                    let notes = copy [copy ErrorMsg::note(loc, format(ValidateErrorMessage::FORGET_AND_CLASS), oneLine-> true)];
                    throw copy ErrorMsg::fatal(p.loc, end-> loc, format(ValidateErrorMessage::INCOMPLETE_TYPE_CLREF, inner), notes-> notes);
                } else {
                    throw copy ErrorMsg::fatal(p.params[0].loc, format(ValidateErrorMessage::NOT_A_CLASS, inner));
                }
            }
            _ => throw copy ErrorMsg::fatal(p.params[0].loc, format(ValidateErrorMessage::NOT_A_CLASS, inner));
        }

        return copy BoolValue(p.loc, cl.ancestor.hasValue);
    }

}
