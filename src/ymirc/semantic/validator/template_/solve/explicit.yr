in explicit;


use ymirc::syntax::{_, declaration::_, expression::_};
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::semantic::{validator, template_, symbol};

use ymirc::lexing::word;
use ymirc::errors::_;

use ymirc::utils::format;

use ymirc::semantic::validator::template_::solve::{_, explicit::_};

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */


mod ::ofvar;
mod ::and;
mod ::var;
mod ::variadic;
mod ::instruction;
mod ::value;
mod ::literal;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          ROOT          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * TemplateExplicitSolving module
 *
 * The root of all explicit template specialization.
 *
 */
pub mod TemplateExplicitSolving {

    /**
     * Solve a full list of template parameters against a list of provided
     * values(types or values).
     *
     * This loop supports:
     *   - variadic template parameters,
     *   - parameters that consume multiple values,
     *   - dynamic rewriting of template parameter lists.
     */
    pub fn solve(dmut context: &ValidationContext,
                 params: [&Expression],
                 values: [&Generator])-> TemplateSolution
        throws ErrorMsg
    {
        let mut consumed = 0us;
        let mut globalMapper = TemplateMapper();
        let mut syntTemplate = params;

        while (consumed < values.len && syntTemplate.len != 0) {
            let currentElems = values[consumed .. $];
            let rest = syntTemplate[1 .. $];
            {
                let local = TemplateExplicitSolving::solveParamTemplate(alias context,
                                                                        rest,
                                                                        syntTemplate[0],
                                                                        currentElems);
                globalMapper:.merge(local.mapper);
                consumed += local.nbConsumed;
                syntTemplate = TemplateRewriting::rewriteTemplateParams(globalMapper, syntTemplate);
            } catch {
                err => {
                    if (globalMapper.mapping.len != 0) {
                        let note = copy ErrorMsg::note(values[consumed].loc, format(ValidateErrorMessage::TEMPLATE_SPE, globalMapper));
                        throw copy ErrorMsg::list(copy [note, err]);
                    } else throw err;
                }
            }
        }

        return TemplateSolution(globalMapper, consumed);
    }

    /**
     * Dispatch explicit solving for a single template parameter.
     *
     * @returns:
     *   - TemplateSolution(mapper, nbConsumed)
     *
     * This function is the central dispatcher for explicit template solving.
     */
    pub fn solveParamTemplate(dmut context:   &ValidationContext,
                              syntaxTemplate: [&Expression],
                              current:        &Expression,
                              values:         [&Generator])-> TemplateSolution
        throws ErrorMsg
    {
        match current {
            o: &TemplateOfVarExpr => {
                return TemplateExplicitOfVarSolving::solve(alias context, syntaxTemplate, o, values);
            }
            t: &TemplateAndExpr => {
                return TemplateExplicitAndSolving::solve(alias context, syntaxTemplate, t, values);
            }
            t: &TemplateVarExpr => {
                return TemplateExplicitVarSolving::solve(syntaxTemplate, t, values);
            }
            v: &TemplateVariadicVarExpr => {
                return TemplateExplicitVariadicSolving::solve(v, values);
            }
            l: &LiteralExpr => {
                return TemplateExplicitLiteralExprSolving::solve(alias context, l, values);
            }
            i: &InstructionExpr => {
                return TemplateExplicitInstructionSolving::solve(alias context, syntaxTemplate, i, values);
            }
        }

        return TemplateExplicitValueSolving::solve(alias context, current, values);
    }
}
