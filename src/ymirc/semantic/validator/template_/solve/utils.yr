in utils;

use ymirc::lexing::word;

use ymirc::syntax::expression::_;
use ymirc::semantic::generator::{value::_, type::_};
use ymirc::errors::_;

/**
 * TemplateSolvingUtils module
 *
 * Provides helper functions used by all template solving modules.
 *
 * This module is purely functional and contains no solver logic itself.
 */
pub mod TemplateSolvingUtils {

    /**
     * Search for a template parameter expression with the given name.
     *
     * @returns:
     *   - (&Expression)? — Some(expr) if found, none otherwise.
     */
    pub fn findExpression(name: [c8], alls: [&Expression])-> (&Expression)? {
        for i in alls match i {
            v: &VarExpr if (v.name.str == name) => return (v)?;
            v: &TemplateOfVarExpr if (v.name.str == name) => return (v)?;
            v: &TemplateAndExpr if (v.name.str == name) => return (v)?;
            v: &TemplateVariadicVarExpr if (v.name.str == name) => return (v)?;
            v: &TemplateVarExpr if (v.name.str == name) => return (v)?;
            v: &VarDeclExpr if (v.name.str == name) => return (v)?;
        }

        return none;
    }

    /**
     * Create a TypeWrapperExpr for the given type.
     *
     * Behavior:
     *   - if the type is mutable → clone it before wrapping,
     *   - otherwise → wrap the type directly.
     *
     * Used when template parameters expect a type expression rather than a
     * value expression.
     */
    pub fn createTypeWrapper(loc: &Word, type: &Type)-> &Expression {
        if (type.isMutable) {
            return copy TypeWrapperExpr(loc, type.clone(0));
        }

        return copy TypeWrapperExpr(loc, type);
    }

    /**
     * Convert a list of Value objects into their corresponding Type objects.
     *
     * @returns:
     *   - [&Type] — list of types corresponding to the input values.
     *
     * @throws:
     *   - ErrorMsg if a value cannot be converted.
     */
    pub fn createTypes(rights: [&Value])-> [&Type]
        throws ErrorMsg
    {
        let mut types: [mut &Type] = [];
        for it in rights {
            let v = ValueCreation::createEnumUnwrap(it);
            if let s: &StringValue = v {
                if let t: &SliceType = s.type {
                    let size = copy IntValue(t.loc, USIZE_TYPE, s.len);
                    types ~= [copy SliceType(t.loc, t.value, isMutable-> false, withSize-> size)];
                } else {
                    types ~= [it.type.clone(0)];
                }
            } else {
                types ~= [it.type.clone(0)];
            }
        }

        return types;
    }

    /**
     * Extract the template parameter list from an instantiated type.
     *
     * @returns:
     *   - (bool, [&Generator])
     *        * bool = true if the type has template parameters,
     *        * list = extracted template parameter generators.
     */
    pub fn getTemplateListOfType(type: &Type)-> (bool, [&Generator]) {
        let mut list: [&Expression] = [];
        let mut found = false;

        match type {
            cl: &ClassPtrType => {
                if let Ok(inner) = cl.inner? {
                    if let Ok(clTmps) = inner.templateMapper {
                        list = clTmps.mappingSorted;
                        found = true;
                    }
                }
            }
            cl: &ClassRefType => {
                if let Ok(clTmps) = cl.templateMapper {
                    list = clTmps.mappingSorted;
                    found = true;
                }
            }
            t: &TraitRefType => {
                if let Ok(clTmps: _) = t.templateMapper {
                    list = clTmps.mappingSorted;
                    found = true;
                }
            }
        };

        if !found {
            return (false, []);
        }

        let mut vec: [mut &Generator] = [];
        for mp in list match mp {
            t: &TypeWrapperExpr => {
                vec ~= [t.type];
            }
            t: &TypeListWrapperExpr => {
                vec ~= t.types;
            }
            v: &ValueWrapperExpr => {
                vec ~= [v.value];
            }
        }

        return (true, vec);
    }
}
