in model;

use ymirc::semantic::template_;

/**
 * A small record representing the result of a template-solving operation.
 *
 */
pub record TemplateSolution {

    // The inferred bindings for this solving step.
    pub let mapper: TemplateMapper;

    // The number of types consumed from the candidate type list.
    pub let nbConsumed: usize;

    pub self(mapper: TemplateMapper, nbConsumed: usize)
        with mapper = mapper
        , nbConsumed = nbConsumed
    {}
}
