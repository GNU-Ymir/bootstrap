in literal;

use ymirc::syntax::expression::_;
use ymirc::semantic::generator::type;

use ymirc::semantic::{validator, template_};
use ymirc::errors;

use ymirc::semantic::validator::template_::solve::_;

/**
 * TemplateImplicitLiteralSolving module
 *
 * Provides implicit template solving for literal expressions.
 *
 */
pub mod TemplateImplicitLiteralSolving {

    /**
     * Attempt to infer template bindings from a literal expression.
     *
     * @params:
     *   - context    : validation context,
     *   - templates  : list of template parameter expressions,
     *   - typeExpr   : the literal expression being matched,
     *   - types      : candidate types to unify with.
     *
     * @returns:
     *   - TemplateSolution(mapper, nbConsumed)
     *        * mapper     : inferred bindings(possibly empty),
     *        * nbConsumed: always 1 for literal expressions.
     */
    pub fn solveType(dmut context: &ValidationContext,
                     templates:    [&Expression],
                     typeExpr:     &LiteralExpr,
                     types:        [&Type])-> TemplateSolution
        throws ErrorMsg
    {
        if let var: &VarExpr = typeExpr {
            if let Ok(param) = TemplateSolvingUtils::findExpression(var.name.str, templates) {
                return TemplateExplicitSolving::solveParamTemplate(alias context, templates, param, types);
            }
        }

        return TemplateSolution(TemplateMapper(), 1);
    }
}
