in compose;

use ymirc::syntax::{_, declaration::_, expression::_};
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::semantic::{validator, template_, symbol};

use ymirc::lexing::{word, keys};
use ymirc::errors;

use ymirc::utils::format;

use ymirc::semantic::validator::template_::solve::{_, implicit::_};

/**
 * TemplateImplicitComposeSolving module
 *
 * Provides implicit template solving for composition expressions.
 *
 */
pub mod TemplateImplicitComposeSolving {

    /**
     * Dispatch implicit solving based on the concrete ComposeExpr variant.
     *
     * If no rule matches, returns an empty TemplateSolution.
     *
     * @returns:
     *   - TemplateSolution(mapper, nbConsumed)
     */
    pub fn solveType(dmut context: &ValidationContext,
                     templates:    [&Expression],
                     typeExpr:     &ComposeExpr,
                     types:        [&Type])-> TemplateSolution
        throws ErrorMsg
    {
        match typeExpr {
            s: &SliceAllocatorExpr => {
                return TemplateImplicitComposeSolving::solveTypeFromSliceAlloc(alias context, templates, s, types);
            }
            l: &ListExpr if l.isArray => {
                return TemplateImplicitComposeSolving::solveTypeFromSlice(alias context, templates, l, types);
            }
            l: &ListExpr if l.isTuple => {
                return TemplateImplicitComposeSolving::solveTypeFromTuple(alias context, templates, l, types);
            }
            m: &ListMapExpr => {
                return TemplateImplicitComposeSolving::solveTypeFromMap(alias context, templates, m, types);
            }
            t: &TryExpr => {
                return TemplateImplicitComposeSolving::solveTypeFromOption(alias context, templates, t, types);
            }
        }

        return TemplateSolution(TemplateMapper(), 1);
    }

    /**
     * Solve implicit template bindings for a slice allocation:
     *     [value; size]
     *
     * @returns:
     *   - TemplateSolution with merged mapper.
     */
    fn solveTypeFromSliceAlloc(dmut context: &ValidationContext,
                               templates:    [&Expression],
                               slice:        &SliceAllocatorExpr,
                               types:        [&Type])-> TemplateSolution
        throws ErrorMsg
    {
        if (types.len >= 1) {
            let type = TypeCreation::createEnumUnwrap(types[0]);
            if let slc: &SliceType = type {
                return TemplateImplicitComposeSolving::solveTypeFromSliceAlloc(alias context, templates, slice, slc);
            }

            if let arr: &ArrayType = type {
                return TemplateImplicitComposeSolving::solveTypeFromSliceAlloc(alias context, templates, slice, arr);
            }
        }

        return TemplateSolution(TemplateMapper(), 1);
    }

    /**
     * Solve implicit template bindings for a slice allocation, when associated
     * type is a slice.
     *
     * @returns:
     *   - TemplateSolution with merged mapper.
     */
    fn solveTypeFromSliceAlloc(dmut context: &ValidationContext,
                               templates:    [&Expression],
                               slice:        &SliceAllocatorExpr,
                               sliceType:    &SliceType)-> TemplateSolution
        throws ErrorMsg
    {
        let mut retMapper = TemplateMapper();
        let solution = TemplateImplicitSolving::solveType(alias context, templates, slice.value, sliceType.inners);
        retMapper:.merge(solution.mapper);

        if let v: &VarExpr = slice.size && sliceType.size !of UnitValue {
            if let Ok(expr) = TemplateSolvingUtils::findExpression(v.name.str, templates) {
                let valSolution = TemplateExplicitSolving::solveParamTemplate(alias context, templates, expr, copy [sliceType.size]);
                retMapper:.merge(valSolution.mapper);
            }
        }

        return TemplateSolution(retMapper, 1us);
    }

    /**
     * Solve implicit template bindings for a slice allocation, when associated
     * type is an array.
     *
     * @returns:
     *   - TemplateSolution with merged mapper.
     */
    fn solveTypeFromSliceAlloc(dmut context: &ValidationContext,
                               templates:    [&Expression],
                               slice:        &SliceAllocatorExpr,
                               arrayType:    &ArrayType)-> TemplateSolution
        throws ErrorMsg
    {
        let mut retMapper = TemplateMapper();
        let solution = TemplateImplicitSolving::solveType(alias context, templates, slice.value, arrayType.inners);
        retMapper:.merge(solution.mapper);

        if let v: &VarExpr = slice.size {
            if let Ok(expr) = TemplateSolvingUtils::findExpression(v.name.str, templates) {
                let valSolution = TemplateExplicitSolving::solveParamTemplate(alias context, templates, expr, copy [copy IntValue(slice.loc, USIZE_TYPE, arrayType.len)]);
                retMapper:.merge(valSolution.mapper);
            }
        }

        return TemplateSolution(retMapper, 1us);
    }

    /**
     * Solve implicit template bindings for a slice literal:
     *     [expr]
     *
     */
    fn solveTypeFromSlice(dmut context: &ValidationContext,
                          templates:    [&Expression],
                          lst:          &ListExpr,
                          types:        [&Type])-> TemplateSolution
        throws ErrorMsg
    {
        if (types.len >= 1 && lst.params.len == 1) {
            let type = TypeCreation::createEnumUnwrap(types[0]);
            if let slc: &SliceType = type {
                let solution = TemplateImplicitSolving::solveType(alias context, templates, lst.params[0], slc.inners);
                return TemplateSolution(solution.mapper, 1us);
            }
        }

        return TemplateSolution(TemplateMapper(), 1us);
    }

    /**
     * Solve implicit template bindings for a tuple literal:
     *     (a, b, c)
     *
     * @returns:
     *   - TemplateSolution with merged mappers.
     */
    fn solveTypeFromTuple(dmut context: &ValidationContext,
                          templates:    [&Expression],
                          lst:          &ListExpr,
                          types:        [&Type])-> TemplateSolution
        throws ErrorMsg
    {
        if (types.len >= 1us) {
            let type = TypeCreation::createEnumUnwrap(types[0]);
            if let t: &TupleType = type {
                if (lst.params.len > t.inners.len) return TemplateSolution(TemplateMapper(), 1us);

                let mut retMapper = TemplateMapper();
                let mut consumed = 0us;
                let mut syntTemplate = templates;

                for i in 0us .. lst.params.len {
                    let currentParam = TemplateRewriting::rewrite(retMapper, lst.params[i]);
                    let rest = t.inners.len - consumed;
                    let syntaxRest = (lst.params.len - i) - 1us;

                    let consomableTypes = t.inners[consumed .. consumed + (rest - syntaxRest)];
                    let localSolution = TemplateImplicitSolving::solveType(alias context, syntTemplate, currentParam, consomableTypes);

                    retMapper:.merge(localSolution.mapper);
                    consumed += cast!usize(localSolution.nbConsumed);
                    syntTemplate = TemplateRewriting::rewriteTemplateParams(retMapper, syntTemplate);
                }

                return TemplateSolution(retMapper, 1us);
            }
        }

        return TemplateSolution(TemplateMapper(), 1us);
    }

    /**
     * Solve implicit template bindings for a map literal:
     *     [ key => value ]
     *
     */
    fn solveTypeFromMap(dmut context: &ValidationContext,
                        templates:    [&Expression],
                        lst:          &ListMapExpr,
                        types:        [&Type])-> TemplateSolution
        throws ErrorMsg
    {
        if (types.len >= 1us && lst.keys.len == 1us) {
            let type = TypeCreation::createEnumUnwrap(types[0]);
            if let m: &MapType = type {
                let dmut retMapper = TemplateMapper();
                let keySolution = TemplateImplicitSolving::solveType(alias context, templates, lst.keys[0us], m.inners[0 .. 1]);
                retMapper:.merge(keySolution.mapper);

                let syntTemplate = TemplateRewriting::rewriteTemplateParams(retMapper, templates);
                let valueParam = TemplateRewriting::rewrite(retMapper, lst.values[0us]);

                let ofVar = copy TemplateOfVarExpr(valueParam.loc, TemplateOfVarType::OF, valueParam);
                let valueSolution = TemplateExplicitSolving::solveParamTemplate(alias context, syntTemplate, ofVar, m.inners[1 .. 2]);

                retMapper:.merge(valueSolution.mapper);
                return TemplateSolution(retMapper, 1us);
            }
        }

        return TemplateSolution(TemplateMapper(), 1us);
    }

    /**
     * Solve implicit template bindings for an option expression:
     *     value?
     *
     */
    fn solveTypeFromOption(dmut context: &ValidationContext,
                           templates:    [&Expression],
                           try:          &TryExpr,
                           types:        [&Type])-> TemplateSolution
        throws ErrorMsg
    {
        if (types.len >= 1us) {
            let type = TypeCreation::createEnumUnwrap(types[0]);
            if let opt: &OptionType = type {
                let solution = TemplateImplicitSolving::solveType(alias context, templates, try.value, opt.inners);
                return TemplateSolution(solution.mapper, 1us)
            }
        }

        return TemplateSolution(TemplateMapper(), 1us);
    }
}
