/*
 * Explicit template solving for composition expressions(ComposeExpr).
 *
 * TemplateExplicitOfComposeSolving handles explicit template inference when
 * the user provides a composition expression as a template argument and the
 * compiler must match it against an expected type. This includes:
 *
 *   - slice allocations      (SliceAllocatorExpr)
 *   - slice literals         (ListExpr with isArray)
 *   - tuple literals         (ListExpr with isTuple)
 *   - map literals           (ListMapExpr)
 *   - option expressions     (TryExpr)
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::template_::solve::explicit::ofvar::compose
 * @File: ymirc/semantic/validator/template_/solve/explicit/ofvar/compose.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-06-12
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in compose;

use ymirc::syntax::{_, declaration::_, expression::_};
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::semantic::{validator, template_, symbol};

use ymirc::lexing::{word, keys};
use ymirc::errors;

use ymirc::utils::format;

use ymirc::semantic::validator::template_::solve::{_, explicit::_};

/**
 * TemplateExplicitOfComposeSolving module
 *
 * Provides explicit template solving for composition expressions.
 *
 * Supported composition expressions:
 *   - SliceAllocatorExpr
 *   - ListExpr(slice or tuple)
 *   - ListMapExpr
 *   - TryExpr(option)
 *
 * This module is used exclusively by TemplateExplicitSolving.
 */
pub mod TemplateExplicitOfComposeSolving {

    /**
     * Dispatch explicit solving based on the concrete ComposeExpr variant.
     *
     * Behavior:
     *   - SliceAllocatorExpr → solveAlloc()
     *   - ListExpr(isArray) → solveSlice()
     *   - ListExpr(isTuple) → solveTuple()
     *   - ListMapExpr        → solveMap()
     *   - TryExpr            → solveOption()
     *
     * If no rule matches, fallback to TemplateExplicitOfVarSolving::solveOfSpecFallback().
     *
     * @returns:
     *   - TemplateSolution(mapper, nbConsumed)
     */
    pub fn solve(dmut context: &ValidationContext,
                 loc:          &Word,
                 alls:         [&Expression],
                 expr:         &ComposeExpr,
                 type:         &Type)-> TemplateSolution
        throws ErrorMsg
    {
        match expr {
            slc: &SliceAllocatorExpr => {
                return TemplateExplicitOfComposeSolving::solveAlloc(alias context, alls, slc, type);
            }
            l: &ListExpr if l.isArray => {
                return TemplateExplicitOfComposeSolving::solveSlice(alias context, alls, l, type);
            }
            l: &ListExpr if l.isTuple => {
                return TemplateExplicitOfComposeSolving::solveTuple(alias context, alls, l, type);
            }
            m: &ListMapExpr => {
                return TemplateExplicitOfComposeSolving::solveMap(alias context, alls, m, type);
            }
            tr: &TryExpr => {
                return TemplateExplicitOfComposeSolving::solveOption(alias context, alls, tr, type);
            }
        }

        return TemplateExplicitOfVarSolving::solveOfSpecFallback(alias context, loc, expr, type);
    }

    /**
     * Solve explicit template bindings for a slice allocation:
     *     [value; size]
     *
     */
    fn solveAlloc(dmut context: &ValidationContext,
                  alls:         [&Expression],
                  slice:        &SliceAllocatorExpr,
                  type:         &Type)-> TemplateSolution
        throws ErrorMsg
    {
        let unwrap = TypeCreation::createEnumUnwrap(type);
        if let slc: &SliceType = unwrap {
            return TemplateExplicitOfComposeSolving::solveAllocSlice(alias context, alls, slice, slc);
        }

        if let arr: &ArrayType = unwrap {
            return TemplateExplicitOfComposeSolving::solveAllocArray(alias context, alls, slice, arr);
        }

        throw copy ErrorMsg::fatal(type.loc, format(ValidateErrorMessage::NOT_AN_ARRAY, type),
                                   notes-> copy [copy ErrorMsg::note(slice.loc, "")]);
    }

    /**
     * Solve explicit template bindings for a slice allocation against SliceType.
     *
     */
    fn solveAllocSlice(dmut context: &ValidationContext,
                       alls:         [&Expression],
                       slice:        &SliceAllocatorExpr,
                       slcType:      &SliceType)-> TemplateSolution
        throws ErrorMsg
    {
        if (slcType.size of UnitValue) {
            throw copy ErrorMsg::fatal(slice.loc, format(ValidateErrorMessage::UNKNOWN_AT_COMPILE_TIME, USIZE_TYPE),
                                       end-> slice.size.loc);
        }

        let mut retMapper = TemplateMapper(score-> TemplateScore::VAR * 2u32);
        let typeLocal = TemplateExplicitOfVarSolving::solveOfSpec(alias context, slice.value.loc, alls, slice.value, slcType.inners);
        retMapper:.merge(typeLocal.mapper);

        if let v: &VarExpr = slice.size {
            if let Ok(expr) = TemplateSolvingUtils::findExpression(v.name.str, alls) {
                let sizeLocal = TemplateExplicitSolving::solveParamTemplate(alias context, alls, expr, copy [slcType.size]);
                retMapper:.merge(sizeLocal.mapper);
            }
        }

        let finalType = TemplateRewriting::rewrite(retMapper, slice);
        let ofType = TypeValidation::validate(alias context, finalType);
        TypeVerification::verifyCompatible(slice.loc, slcType.loc, ofType, slcType);

        return TemplateSolution(retMapper, 1);
    }

    /**
     * Solve explicit template bindings for a slice allocation against ArrayType.
     *
     */
    fn solveAllocArray(dmut context: &ValidationContext,
                       alls:         [&Expression],
                       slice:        &SliceAllocatorExpr,
                       arrType:      &ArrayType)-> TemplateSolution
        throws ErrorMsg
    {
        let mut retMapper = TemplateMapper(score-> TemplateScore::VAR * 2u32);
        let typeLocal = TemplateExplicitOfVarSolving::solveOfSpec(alias context, slice.value.loc, alls, slice.value, arrType.inners);
        retMapper:.merge(typeLocal.mapper);

        if let v: &VarExpr = slice.size {
            if let Ok(expr) = TemplateSolvingUtils::findExpression(v.name.str, alls) {
                let sizeLocal = TemplateExplicitSolving::solveParamTemplate(alias context, alls, expr, copy [copy IntValue(arrType.loc, USIZE_TYPE, arrType.len)]);
                retMapper:.merge(sizeLocal.mapper);
            }
        }

        let finalType = TemplateRewriting::rewrite(retMapper, slice);
        let ofType = TypeValidation::validate(alias context, finalType);
        TypeVerification::verifyCompatible(slice.loc, arrType.loc, ofType, arrType);

        return TemplateSolution(retMapper, 1);
    }

    /**
     * Solve explicit template bindings for a slice literal:
     *     [expr]
     *
     */
    fn solveSlice(dmut context: &ValidationContext,
                  alls:         [&Expression],
                  lst:          &ListExpr,
                  type:         &Type)-> TemplateSolution
        throws ErrorMsg
    {
        if let slc: &SliceType = TypeCreation::createEnumUnwrap(type) {
            let local = TemplateExplicitOfVarSolving::solveOfSpec(alias context, lst.params[0].loc, alls, lst.params[0us], slc.inners);

            let finalType = TemplateRewriting::rewrite(local.mapper, lst);
            let ofType = TypeValidation::validate(alias context, finalType);
            TypeVerification::verifyCompatible(lst.loc, type.loc, ofType, type);

            let mut retMapper = TemplateMapper(score-> TemplateScore::VAR);
            retMapper:.merge(local.mapper);

            return TemplateSolution(retMapper, 1);
        }

        throw copy ErrorMsg::fatal(type.loc, format(ValidateErrorMessage::NOT_A_SLICE, type),
                                   notes-> copy [copy ErrorMsg::note(lst.loc, "")]);
    }

    /**
     * Solve explicit template bindings for a tuple literal:
     *     (a, b, c)
     *
     * Variadics:
     *   - handled by allowing multiple tuple types to be consumed by a single
     *     template parameter.
     */
    fn solveTuple(dmut context: &ValidationContext,
                  alls:         [&Expression],
                  lst:          &ListExpr,
                  type:         &Type)-> TemplateSolution
        throws ErrorMsg
    {
        if let t: &TupleType = TypeCreation::createEnumUnwrap(type) {
            // Because the inner elements of the template tuple could be variadic templates, we must manage it
            let dmut retMapper = TemplateMapper(score-> TemplateScore::VAR * 2u32);
            let mut consumed = 0us;

            // For the specialization to work, we need to have more or same number of types in the tuple than in the template => (T of (U, J...), J),  call!{(i32, i32, i32)}
            if (lst.params.len > t.inners.len) {
                throw copy ErrorMsg::fatal(t.loc, format(ValidateErrorMessage::MISMATCH_TUPLE_ARITY, t.inners.len, lst.params.len),
                                           notes-> copy [copy ErrorMsg::note(lst.loc, "")]);
            }

            let mut syntTemplate = alls;
            for i in 0us .. lst.params.len {
                let currentParam = TemplateRewriting::rewrite(retMapper, lst.params[i]); // maybe some resolution already happened, we don't want to have collision in the mapper(e.g. (T of (U, U, U), U))
                let rest = t.inners.len - consumed;
                let syntaxRest = (lst.params.len - i) - 1us;

                // Give all the types that rests for variadics, I don't see a better way, because last elements could be other things than templates, so variadics must be the last template elements
                let consomableTypes = t.inners[consumed .. consumed + (rest - syntaxRest)];
                let local = TemplateExplicitOfVarSolving::solveOfSpec(alias context, currentParam.loc, syntTemplate, currentParam, consomableTypes);

                // Merging the mapper
                retMapper:.merge(local.mapper);
                consumed += cast!usize(local.nbConsumed); // increment the number of used types
                syntTemplate = TemplateRewriting::rewriteTemplateParams(retMapper, syntTemplate);
            }

            {
                // we don't check if all types of "type" were used,
                // there is not need, because we validate the template, and check if it is equivalent to "type", so if some elements of "type" were unused, it should fail here
                let finalType = TemplateRewriting::rewrite(retMapper, lst);
                let ofType = TypeValidation::validate(alias context, finalType);
                TypeVerification::verifyCompatible(lst.loc, type.loc, ofType, type);
            } catch {
                err: &ErrorMsg => {
                    throw copy ErrorMsg::note(lst.loc, format(ValidateErrorMessage::TEMPLATE_SPE, retMapper),
                                              notes-> copy [err]);
                }
            }

            return TemplateSolution(retMapper, 1);
        }

        throw copy ErrorMsg::fatal(type.loc, format(ValidateErrorMessage::NOT_A_TUPLE, type),
                                   notes-> copy [copy ErrorMsg::note(lst.loc, "")]);
    }

    /**
     * Solve explicit template bindings for a map literal:
     *     [ key => value ]
     *
     */
    fn solveMap(dmut context: &ValidationContext,
                alls:         [&Expression],
                lst:          &ListMapExpr,
                type:         &Type)-> TemplateSolution
        throws ErrorMsg
    {
        if (lst.keys.len != 1) {
            throw copy ErrorMsg::fatal(lst.loc, format(ValidateErrorMessage::USE_AS_TYPE_TEMPLATE, lst));
        }

        if let m: &MapType = TypeCreation::createEnumUnwrap(type) {
            let dmut retMapper = TemplateMapper(score-> TemplateScore::VAR * 2u32);
            let keyLocal = TemplateExplicitOfVarSolving::solveOfSpec(alias context, lst.keys[0].loc, alls, lst.keys[0us], m.inners[0 .. 1]);
            retMapper:.merge(keyLocal.mapper);

            let syntTemplate = TemplateRewriting::rewriteTemplateParams(retMapper, alls);
            let valueParam = TemplateRewriting::rewrite(retMapper, lst.values[0us]);
            let valueLocal = TemplateExplicitOfVarSolving::solveOfSpec(alias context, valueParam.loc, syntTemplate, valueParam, m.inners[1 .. 2]);

            retMapper:.merge(valueLocal.mapper);

            let finalType = TemplateRewriting::rewrite(retMapper, lst);
            let ofType = TypeValidation::validate(alias context, finalType);
            TypeVerification::verifyCompatible(lst.loc, type.loc, ofType, type);

            return TemplateSolution(retMapper, 1);
        }

        throw copy ErrorMsg::fatal(type.loc, format(ValidateErrorMessage::NOT_A_MAP, type),
                                   notes-> copy [copy ErrorMsg::note(lst.loc, "")]);
    }

    /**
     * Solve explicit template bindings for an option expression:
     *     value?
     *
     */
    fn solveOption(dmut context: &ValidationContext,
                   alls:         [&Expression],
                   try:          &TryExpr,
                   type:         &Type)-> TemplateSolution
        throws ErrorMsg
    {
        if let o: &OptionType = TypeCreation::createEnumUnwrap(type) {
            let local = TemplateExplicitOfVarSolving::solveOfSpec(alias context, try.loc, alls, try.value, o.inners[0 .. 1]);

            let mut retMapper = TemplateMapper(score-> TemplateScore::VAR);

            let finalType = TemplateRewriting::rewrite(local.mapper, try);
            let ofType = TypeValidation::validate(alias context, finalType);
            TypeVerification::verifyCompatible(try.loc, type.loc, ofType, type);

            retMapper:.merge(local.mapper);

            return TemplateSolution(retMapper, 1us);
        }

        throw copy ErrorMsg::fatal(try.loc, format(ValidateErrorMessage::TEMPLATE_SPECIALIZATION_FAILS, try, type));
    }
}
