in literal;

use ymirc::syntax::{_, declaration::_, expression::_};
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::semantic::{validator, template_, symbol};

use ymirc::lexing::{word, keys};
use ymirc::errors;

use ymirc::utils::format;

use ymirc::semantic::validator::template_::solve::{_, explicit::_};

/**
 * TemplateExplicitOfLiteralSolving module
 *
 * Provides explicit template solving for literal expressions.
 *
 * This module is used exclusively by TemplateExplicitSolving.
 */
pub mod TemplateExplicitOfLiteralSolving {

    /**
     * Dispatch explicit solving for a literal expression.
     *
     * @params:
     *   - alls:  list of template parameter expressions,
     *   - expr:  literal expression provided as template argument,
     *   - types: expected types to match against.
     *
     * @returns:
     *   - TemplateSolution(mapper, nbConsumed)
     */
    pub fn solve(dmut context: &ValidationContext,
                 loc: &Word,
                 alls: [&Expression],
                 expr: &LiteralExpr,
                 types: [&Type])-> TemplateSolution
        throws ErrorMsg
    {
        if let var: &VarExpr = expr {
            return TemplateExplicitOfLiteralSolving::solveVar(alias context, alls, var, types);
        }

        return TemplateExplicitOfVarSolving::solveOfSpecFallback(alias context, loc, expr, types[0]);
    }

    /**
     * Solve explicit template bindings for a VarExpr literal.
     *
     */
    fn solveVar(dmut context: &ValidationContext,
                alls: [&Expression],
                var: &VarExpr,
                types: [&Type])-> TemplateSolution
        throws ErrorMsg
    {
        if let Ok(expr) = TemplateSolvingUtils::findExpression(var.name.str, alls) {
            let mut retMapper = TemplateMapper(score-> TemplateScore::VAR);
            let local = TemplateExplicitSolving::solveParamTemplate(alias context, alls, expr, types);
            retMapper:.merge(local.mapper);

            return TemplateSolution(retMapper, local.nbConsumed);
        }

        let mut retMapper = TemplateMapper(score-> TemplateScore::VAR);
        let ofType = TypeValidation::validate(alias context, var);
        TypeVerification::verifyCompatible(var.loc, types[0].loc, ofType, types[0]);
        if TypeVerification::isDirectInstance(ofType, types[0]) {
            retMapper:.addScore(TemplateScore::VAR);
        }

        return TemplateSolution(retMapper, 1);
    }
}
