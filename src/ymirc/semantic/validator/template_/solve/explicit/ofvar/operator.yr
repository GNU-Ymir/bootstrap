/*
 * Explicit template solving for operator-based expressions (OperatorExpr).
 *
 * TemplateExplicitOfOperatorSolving handles explicit template inference when
 * the user provides an operator expression as a template argument and the
 * compiler must match it against an expected type. This includes:
 *
 *   - TemplateCallExpr   (T!(args), T<args>, etc.)
 *   - PathExpr           (a::b)
 *   - BinaryExpr         (a :: b)
 *   - UnaryExpr          (*x, &x, etc.)
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::semantic::validator::template_::solve::explicit::ofvar::operator
 * @File: ymirc/semantic/validator/template_/solve/explicit/ofvar/operator.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2026-06-12
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in operator;

use ymirc::syntax::{_, declaration::_, expression::_};
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::semantic::{validator, template_, symbol};

use ymirc::lexing::{word, keys};
use ymirc::errors;

use ymirc::utils::format;

use ymirc::semantic::validator::template_::solve::{_, explicit::_};


/**
 * TemplateExplicitOfOperatorSolving module
 *
 * Provides explicit template solving for operator-based expressions.
 *
 * Supported operator expressions:
 *   - TemplateCallExpr
 *   - PathExpr
 *   - BinaryExpr
 *   - UnaryExpr
 *
 * This module is used exclusively by TemplateExplicitSolving.
 */
pub mod TemplateExplicitOfOperatorSolving {

    /**
     * Dispatch explicit solving based on the concrete OperatorExpr variant.
     *
     * If no rule matches, fallback to TemplateExplicitOfVarSolving::solveOfSpecFallback().
     *
     * @returns:
     *   - TemplateSolution(mapper, nbConsumed)
     */
    pub fn solve(dmut context: &ValidationContext,
                 loc:          &Word,
                 alls:         [&Expression],
                 expr:         &OperatorExpr,
                 type:         &Type)-> TemplateSolution
        throws ErrorMsg
    {
        match expr {
            c: &TemplateCallExpr => {
                return TemplateExplicitOfOperatorSolving::solveTemplateCall(alias context, alls, c, type);
            }
            p: &PathExpr => {
                return TemplateExplicitOfOperatorSolving::solvePath(alias context, alls, p, type);
            }
            b: &BinaryExpr => {
                return TemplateExplicitOfOperatorSolving::solveBinary(alias context, alls, b, type);
            }
            un: &UnaryExpr => {
                return TemplateExplicitOfOperatorSolving::solveUnary(alias context, alls, un, type);
            }
        }

        return TemplateExplicitOfVarSolving::solveOfSpecFallback(alias context, loc, expr, type);
    }

    /**
     * Solve explicit template bindings for a template call:
     *     T!(args) or T!{args}
     *
     * Error handling:
     *   - on failure, attach a diagnostic note showing partial bindings.
     */
    fn solveTemplateCall(dmut context: &ValidationContext,
                         alls:         [&Expression],
                         call:         &TemplateCallExpr,
                         type:         &Type)-> TemplateSolution
        throws ErrorMsg
    {
        let unwrap = TypeCreation::createEnumUnwrap(type);
        let (has, clTemplates) = TemplateSolvingUtils::getTemplateListOfType(unwrap);
        if (!has || call.rights.len > clTemplates.len) {
            throw copy ErrorMsg::fatal(type.loc, format(ValidateErrorMessage::TEMPLATE_SPECIALIZATION_FAILS, call, type),
                                       notes-> copy [copy ErrorMsg::fatal(call.loc, format(ValidateErrorMessage::INCOMPATIBLE_TYPE, call, type))]);
        }

        let mut retMapper = TemplateMapper(score-> TemplateScore::VAR);
        let mut consumed = 0us;
        let mut syntaxTemplate = alls;

        for i in 0us .. call.rights.len {
            let currentParam = TemplateRewriting::rewrite(retMapper, call.rights[i]);
            let rest = clTemplates.len - consumed;
            let syntaxRest = (call.rights.len - i) - 1us;

            let consomableTypes = clTemplates[consumed .. consumed + (rest - syntaxRest)];
            let local = if (consomableTypes.len > 0 && consomableTypes[0] of Value) {
                let local = TemplateExplicitOfOperatorSolving::solveTemplateCallParamValue(alias context,
                                                                                           alls,
                                                                                           currentParam,
                                                                                           consomableTypes[0 .. 1]);
                TemplateSolution(local.mapper, 1us)
            } else {
                let mut lst: [mut &Type] = [];
                for ti in consomableTypes {
                    if let t: &Type = ti {
                        lst ~= [t];
                    } else break;
                }

                TemplateExplicitOfVarSolving::solveOfSpec(alias context, currentParam.loc, alls, currentParam, lst)
            };

            retMapper:.merge(local.mapper);
            consumed += cast!usize(local.nbConsumed);
            syntaxTemplate = TemplateRewriting::rewriteTemplateParams(retMapper, syntaxTemplate);
        }

        if let v: &VarExpr = call.left {
            if let Ok(expr) = TemplateSolvingUtils::findExpression(v.name.str, alls) {
                let valLocal = TemplateExplicitSolving::solveParamTemplate(alias context, alls, expr, copy [type]);
                retMapper:.merge(valLocal.mapper);
                return TemplateSolution(retMapper, 1);
            }
        }

        {
            let finalType = TemplateRewriting::rewrite(retMapper, call);
            let ofType = TypeValidation::validate(alias context, finalType);
            TypeVerification::verifyCompatible(call.loc, type.loc, ofType, type);
        } catch {
            err => {
                throw copy ErrorMsg::note(call.loc, format(ValidateErrorMessage::TEMPLATE_SPE, retMapper),
                                          notes-> copy [err]);
            }
        }

        return TemplateSolution(retMapper, 1);
    }

    /**
     * Solve a template call argument when the expected template parameter is a value.
     *
     */
    fn solveTemplateCallParamValue(dmut context: &ValidationContext,
                                   alls:         [&Expression],
                                   current:      &Expression,
                                   values:       [&Generator])-> TemplateSolution
        throws ErrorMsg
    {
        if let v: &VarExpr = current {
            if let Ok(expr) = TemplateSolvingUtils::findExpression(v.name.str, alls) {
                return TemplateExplicitSolving::solveParamTemplate(alias context, alls, expr, values);
            }
        }

        return TemplateExplicitValueSolving::solve(alias context, current, values);
    }

    /**
     * Solve explicit template bindings for a path expression:
     *     a::b
     *
     */
    fn solvePath(dmut context: &ValidationContext,
                 alls:         [&Expression],
                 path:         &PathExpr,
                 type:         &Type)-> TemplateSolution
        throws ErrorMsg
    {
        let mut retMapper = TemplateMapper(score-> TemplateScore::VAR);
        let mut finalType: &Expression = path;

        if let v: &VarExpr = path.right {
            if let Ok(expr) = TemplateSolvingUtils::findExpression(v.name.str, alls) {
                let local = TemplateExplicitSolving::solveParamTemplate(alias context, alls, expr, copy [type]);
                retMapper:.merge(local.mapper);

                finalType = TemplateRewriting::rewrite(retMapper, path);
            }
        }

        let ofType = TypeValidation::validate(alias context, finalType);
        TypeVerification::verifyCompatible(path.loc, type.loc, ofType, type);
        if TypeVerification::isDirectInstance(ofType, type) {
            retMapper:.addScore(TemplateScore::VAR);
        }

        return TemplateSolution(retMapper, 1);
    }

    /**
     * Solve explicit template bindings for a binary expression.
     *
     */
    fn solveBinary(dmut context: &ValidationContext,
                   alls:         [&Expression],
                   bin:          &BinaryExpr,
                   type:         &Type)-> TemplateSolution
        throws ErrorMsg
    {
        let mut retMapper = TemplateMapper(score-> TemplateScore::VAR);
        let mut finalType: &Expression = bin;

        if let v: &VarExpr = bin.right && bin.op == BinaryOperators::DCOLON {
            if let Ok(expr) = TemplateSolvingUtils::findExpression(v.name.str, alls) {
                let local = TemplateExplicitSolving::solveParamTemplate(alias context, alls, expr, copy [type]);
                retMapper:.merge(local.mapper);

                finalType = TemplateRewriting::rewrite(retMapper, bin);
            }
        }

        let ofType = TypeValidation::validate(alias context, finalType);
        TypeVerification::verifyCompatible(bin.loc, type.loc, ofType, type);
        if TypeVerification::isDirectInstance(ofType, type) {
            retMapper:.addScore(TemplateScore::VAR);
        }

        return TemplateSolution(retMapper, 1);
    }

    /**
     * Solve explicit template bindings for a unary expression:
     *     *x, &x, etc.
     *
     */
    fn solveUnary(dmut context: &ValidationContext,
                  alls:         [&Expression],
                  un:           &UnaryExpr,
                  type:         &Type)-> TemplateSolution
        throws ErrorMsg
    {
        let unwrap = TypeCreation::createEnumUnwrap(type);
        let mut innerTypes: [&Type] = [];

        if let cl: &ClassPtrType = unwrap && !cl.isStruct {
            innerTypes = copy [cl.inner];
        }
        else if let ct: &CompoundType = unwrap && ct.inners.len == 1 {
            innerTypes = ct.inners;
        }

        if innerTypes.len == 0 {
            throw copy ErrorMsg::fatal(un.loc, format(ValidateErrorMessage::TEMPLATE_SPECIALIZATION_FAILS, un, type));
        }

        let local = TemplateExplicitOfVarSolving::solveOfSpec(alias context, un.value.loc, alls, un.value, innerTypes);
        let finalType = TemplateRewriting::rewrite(local.mapper, un);
        let ofType = TypeValidation::validate(alias context, finalType);
        TypeVerification::verifyCompatible(un.loc, type.loc, ofType, type);

        let mut retMapper = TemplateMapper(score-> TemplateScore::VAR);
        retMapper:.merge(local.mapper);
        if TypeVerification::isDirectInstance(ofType, type) {
            retMapper:.addScore(TemplateScore::VAR);
        }

        return TemplateSolution(retMapper, 1);
    }
}
