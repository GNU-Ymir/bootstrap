in variadic;

use ymirc::syntax::{_, declaration::_, expression::_};
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::semantic::{validator, template_, symbol};

use ymirc::lexing::{word, keys};
use ymirc::errors;

use ymirc::utils::format;

use ymirc::semantic::validator::template_::solve::{_, explicit::_};

/**
 * TemplateExplicitVariadicSolving module
 *
 * Provides explicit template solving for TemplateVariadicVarExpr parameters.
 *
 */
pub mod TemplateExplicitVariadicSolving {

    /**
     * Solve a TemplateVariadicVarExpr against the provided generators.
     *
     * @throws:
     *   - USE_AS_TYPE_TEMPLATE if any generator is not a Type.
     */
    pub fn solve(var:          &TemplateVariadicVarExpr,
                 types:        [&Generator])-> TemplateSolution
        throws ErrorMsg
    {
        let mut retTypes: [mut &Type] = [];
        for i in 0us .. types.len {
            if let t: &Type = types[i] {
                retTypes ~= [t];
            } else { // only types can be used to perform a type specialization
                throw copy ErrorMsg::fatal(types[i].loc, format(ValidateErrorMessage::USE_AS_TYPE_TEMPLATE, types[i]),
                                           notes-> copy [copy ErrorMsg::note(var.loc, "")]);
            }
        }

        let dmut retMapper = TemplateMapper(score-> TemplateScore::VAR);
        if (retTypes.len != 1us) {
            retMapper:.insert(var.name.str, copy TypeListWrapperExpr(var.loc, retTypes));
        } else {
            retMapper:.insert(var.name.str, TemplateSolvingUtils::createTypeWrapper(var.loc, retTypes[0]));
        }

        return TemplateSolution(retMapper, retTypes.len);
    }
}
