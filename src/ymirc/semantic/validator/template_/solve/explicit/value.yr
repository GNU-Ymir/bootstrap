 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in value;

use ymirc::syntax::{_, declaration::_, expression::_};
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::semantic::{validator, template_, symbol};

use ymirc::lexing::{word, keys};
use ymirc::errors;

use ymirc::utils::format;

use ymirc::semantic::validator::template_::solve::{_, explicit::_};

/**
 * TemplateExplicitValueSolving module
 *
 * Provides explicit template solving for value-level template parameters.
 *
 */
pub mod TemplateExplicitValueSolving {

    /**
     * Solve a value-level template parameter.
     *
     * Error handling:
     *   - Any internal error is wrapped into a TEMPLATE_SPECIALIZATION_FAILS
     *     diagnostic with additional notes.
     */
    pub fn solve(dmut context: &ValidationContext,
                 expr:         &Expression,
                 values:       [&Generator])-> TemplateSolution
        throws ErrorMsg
    {
        let val = ValueValidation::validate(alias context, expr);
        if (!context.cteInterpret.isCte(val)) {
            throw copy ErrorMsg::fatal(val.loc, format(ValidateErrorMessage::UNKNOWN_AT_COMPILE_TIME, val.type));
        }

        if (values.len == 0) {
            throw copy ErrorMsg::fatal(expr.loc, format(ValidateErrorMessage::TEMPLATE_SPECIALIZATION_FAILS, expr, values));
        }

        if let v: &Value = values[0] {
            {
                let cmp = BinaryComparisonValidation::validate(alias context, expr.loc, BinaryOperators::DEQUAL, v, val);
                if (context.cteInterpret:.computeBool(cmp)) {
                    let mut retMapper = TemplateMapper(score-> TemplateScore::VALUE);
                    let loc = expr.loc;
                    retMapper:.insert(format("%[%,%]", loc.str, loc.line, loc.col), copy ValueWrapperExpr(loc, v));

                    return TemplateSolution(retMapper, 1);
                }

                throw copy ErrorMsg::fatal(v.loc, format(ValidateErrorMessage::INCOMPATIBLE_VALUES, val, v));
            } catch {
                innerErr => {
                    throw copy ErrorMsg::fatal(expr.loc, format(ValidateErrorMessage::TEMPLATE_SPECIALIZATION_FAILS, expr, values),
                                               notes-> copy [innerErr]);
                }
            }
        }

        throw copy ErrorMsg::fatal(expr.loc, format(ValidateErrorMessage::TEMPLATE_SPECIALIZATION_FAILS, expr, values),
                                   notes-> copy [copy ErrorMsg::fatal(values[0].loc, format(ValidateErrorMessage::USE_AS_VALUE_TEMPLATE, values[0]))]);

    }
}
