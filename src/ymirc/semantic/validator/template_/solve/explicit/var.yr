/*
 * Explicit template solving for TemplateVarExpr(“kind T”).
 *
 * TemplateExplicitVarSolving handles template parameters of the form:
 *
 *     alias T
 *     class T
 *     entity T
 *     record T
 *     tuple T
 *
 * These constraints restrict the *kind* of type that may be bound to the
 * template variable. Unlike TemplateOfVarExpr(which matches structure),
 * TemplateVarExpr enforces categorical constraints on the type itself.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::validator::template_::solve::explicit::var
 * @File: ymirc/semantic/validator/template_/solve/explicit/var.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-06-13
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in var;

use ymirc::syntax::{_, declaration::_, expression::_};
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::semantic::{validator, template_, symbol};

use ymirc::lexing::{word, keys};
use ymirc::errors;

use ymirc::utils::format;

use ymirc::semantic::validator::template_::solve::{_, explicit::_};

/**
 * TemplateExplicitVarSolving module
 *
 * Provides explicit template solving for TemplateVarExpr parameters.
 *
 */
pub mod TemplateExplicitVarSolving {

    /**
     * Solve a TemplateVarExpr against the expected type(s).
     *
     * @throws:
     *   - TEMPLATE_SPECIALIZATION_FAILS if no types are provided,
     *   - USE_AS_TYPE_TEMPLATE if the expected generator is not a Type.
     */
    pub fn solve(alls:         [&Expression],
                 var:          &TemplateVarExpr,
                 types:        [&Generator])-> TemplateSolution
        throws ErrorMsg
    {
        if (types.len == 0) {
            throw copy ErrorMsg::fatal(var.loc, format(ValidateErrorMessage::TEMPLATE_SPECIALIZATION_FAILS, alls, types));
        }

        if let tx: &Type = types[0] {
            let t = TypeCreation::createEnumUnwrap(tx);
            match var.kind {
                TemplateVarType::ALIAS => TemplateExplicitVarSolving::verifyAlias(var.loc, t);
                TemplateVarType::CLASS => TemplateExplicitVarSolving::verifyClass(var.loc, t);
                TemplateVarType::ENTITY => TemplateExplicitVarSolving::verifyEntity(var.loc, t);
                TemplateVarType::RECORD => TemplateExplicitVarSolving::verifyRecord(var.loc, t);
                TemplateVarType::TUPLE => TemplateExplicitVarSolving::verifyTuple(var.loc, t);
            }

            let dmut retMapper = TemplateMapper(score-> TemplateScore::VAR);
            retMapper:.insert(var.name.str, TemplateSolvingUtils::createTypeWrapper(t.loc, t));
            return TemplateSolution(retMapper, 1);
        }

        throw copy ErrorMsg::fatal(types[0].loc, format(ValidateErrorMessage::USE_AS_TYPE_TEMPLATE, types[0]),
                                   notes-> copy [copy ErrorMsg::note(var.loc, "")]);
    }

    /**
     * Verify that the type is aliasable.
     *
     */
    fn verifyAlias(loc: &Word, type: &Type)
        throws ErrorMsg
    {
        if (!type.toDeeplyMutable().needsExplicitAlias) {
            throw copy ErrorMsg::fatal(type.loc, end-> loc, format(ValidateErrorMessage::NOT_ALIASABLE, type));
        }
    }

    /**
     * Verify that the type is a class.
     *
     */
    fn verifyClass(loc: &Word, type: &Type)
        throws ErrorMsg
    {
        let isClass = match type {
            c: &ClassPtrType => { !c.isStruct }
            _ => { false }
        };

        if (!isClass) {
            throw copy ErrorMsg::fatal(type.loc, end-> loc, format(ValidateErrorMessage::NOT_A_CLASS, type));
        }
    }

    /**
     * Verify that the type is an entity.
     *
     */
    fn verifyEntity(loc: &Word, type: &Type)
        throws ErrorMsg
    {
        let isStruct = match type {
            c: &ClassPtrType => { c.isStruct && c.isMovable }
            _ => { false }
        };

        if (!isStruct) {
            throw copy ErrorMsg::fatal(type.loc, end-> loc, format(ValidateErrorMessage::NOT_AN_ENTITY, type));
        }
    }

    /**
     * Verify that the type is a record.
     *
     */
    fn verifyRecord(loc: &Word, type: &Type)
        throws ErrorMsg
    {
        let isStruct = match type {
            c: &ClassPtrType => { c.isStruct && !c.isMovable }
            _ => { false }
        };

        if (!isStruct) {
            throw copy ErrorMsg::fatal(type.loc, end-> loc, format(ValidateErrorMessage::NOT_A_RECORD, type));
        }
    }

    /**
     * Verify that the type is a tuple.
     *
     */
    fn verifyTuple(loc: &Word, type: &Type)
        throws ErrorMsg
    {
        if (type !of TupleType) {
            throw copy ErrorMsg::fatal(type.loc, end-> loc, format(ValidateErrorMessage::NOT_A_TUPLE, type));
        }
    }
}
