 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in ofvar;

use ymirc::errors;
use ymirc::lexing::{keys, word};
use ymirc::semantic::template_;
use ymirc::semantic::generator::{type::_, value};
use ymirc::semantic::validator::template_::solve::_;
use ymirc::semantic::validator::template_::solve::explicit::ofvar::_;
use ymirc::syntax::expression;
use ymirc::syntax::expression::_;
use ymirc::utils::format;



/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

mod ::compose;
mod ::literal;
mod ::operator;
mod ::type;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          ROOT          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * TemplateExplicitOfVarSolving module
 *
 * Provides explicit template solving for TemplateOfVarExpr parameters.
 *
 * This module is the backbone of explicit template specialization.
 */
pub mod TemplateExplicitOfVarSolving {

    /**
     * Dispatch explicit solving based on the TemplateOfVarExpr operator.
     *
     * @params:
     *   - alls  : list of template parameter expressions,
     *   - ofV   : TemplateOfVarExpr to solve,
     *   - types: expected types or values(as Generators).
     *
     * @returns:
     *   - TemplateSolution(mapper, nbConsumed)
     */
    pub fn solve(dmut context: &ValidationContext,
                 alls:         [&Expression],
                 ofV:          &TemplateOfVarExpr,
                 types:        [&Generator])-> TemplateSolution
        throws ErrorMsg
    {
        match ofV.kind {
            TemplateOfVarType::OF => {
                return TemplateExplicitOfVarSolving::solveOf(alias context, alls, ofV, types);
            }
            TemplateOfVarType::IMPL => {
                return TemplateExplicitOfVarSolving::solveImpl(alias context, alls, ofV, types);
            }
            _ => {
                return TemplateExplicitOfVarSolving::solveOver(alias context, alls, ofV, types);
            }
        }
    }

    /**
     * Solve a template parameter of the form:
     *     T of X
     *
     * @returns:
     *   - TemplateSolution with merged mapper and nbConsumed from solveOfSpec().
     */
    fn solveOf(dmut context: &ValidationContext,
               alls:         [&Expression],
               ofV:          &TemplateOfVarExpr,
               types:        [&Generator])-> TemplateSolution
        throws ErrorMsg
    {
        let mut asTypes: [mut &Type] = [];
        for i in types if let t: &Type = i {
            asTypes ~= [t];
        }

        if (asTypes.len == 0) {
            throw copy ErrorMsg::fatal(ofV.loc, format(ValidateErrorMessage::TEMPLATE_SPECIALIZATION_FAILS, ofV, types));
        }

        let varName = ofV.name.str;

        let local = TemplateExplicitOfVarSolving::solveOfSpec(alias context, ofV.name, alls, ofV.spec, asTypes);
        let mut retMapper = TemplateMapper(score-> TemplateScore::VAR);
        retMapper:.merge(local.mapper);

        let rewritten = TemplateRewriting::rewrite(retMapper, ofV.spec);
        let finalType = TypeValidation::validate(alias context, rewritten);
        retMapper:.insert(varName, TemplateSolvingUtils::createTypeWrapper(ofV.loc, finalType));

        return TemplateSolution(retMapper, local.nbConsumed);
    }

    /**
     * Solve the specification of an “of” template parameter.
     *
     * @returns:
     *   - TemplateSolution(mapper, nbConsumed)
     */
    pub fn solveOfSpec(dmut context: &ValidationContext,
                       name:         &Word,
                       alls:         [&Expression],
                       spec:         &Expression,
                       types:        [&Type])-> TemplateSolution
        throws ErrorMsg
    {
        if (types.len == 0) {
            throw copy ErrorMsg::fatal(spec.loc, format(ValidateErrorMessage::TEMPLATE_SPECIALIZATION_FAILS, alls, types));
        }

        match spec {
            c: &ComposeExpr => {
                return TemplateExplicitOfComposeSolving::solve(alias context, name, alls, c, types[0]);
            }
            l: &LiteralExpr => {
                return TemplateExplicitOfLiteralSolving::solve(alias context, name, alls, l, types);
            }
            l: &OperatorExpr => {
                return TemplateExplicitOfOperatorSolving::solve(alias context, name, alls, l, types[0]);
            }
            t: &TypeExpr => {
                return TemplateExplicitOfTypeSolving::solve(alias context, name, alls, t, types[0]);
            }
        }

        return TemplateExplicitOfVarSolving::solveOfSpecFallback(alias context, name, spec, types[0]);
    }

    /**
     * Fallback solver for “of” parameters.
     *
     */
    pub fn solveOfSpecFallback(dmut context: &ValidationContext,
                               loc:          &Word,
                               spec:         &Expression,
                               type:         &Type)-> TemplateSolution
        throws ErrorMsg
    {
        let specType = TypeValidation::validate(alias context, spec);
        TypeVerification::verifyCompatible(loc, type.loc, specType, type);

        let mut retMapper = TemplateMapper(score-> TemplateScore::VAR);
        if (TypeVerification::isDirectInstance(specType, type)) {
            retMapper:.addScore(TemplateScore::VAR);
        }

        return TemplateSolution(retMapper, 1);
    }

    /**
     * Solve a template parameter of the form:
     *     T over X
     *
     * @throws:
     *   - NOT_A_CLASS if expected type is not a class pointer.
     */
    pub fn solveOver(dmut context: &ValidationContext,
                     alls:         [&Expression],
                     ofV:          &TemplateOfVarExpr,
                     types:        [&Generator])-> TemplateSolution
        throws ErrorMsg
    {
        if (types.len == 0) {
            throw copy ErrorMsg::fatal(ofV.loc, format(ValidateErrorMessage::TEMPLATE_SPECIALIZATION_FAILS, alls, types));
        }

        if let t: &Type = types[0] {
            if let c: &ClassPtrType = TypeCreation::createEnumUnwrap(t) && !c.isStruct {
                let mapper = TemplateExplicitOfVarSolving::solveOverClass(alias context, alls, ofV, c);

                let dmut retMapper = TemplateMapper(score-> TemplateScore::VAR);
                retMapper:.merge(mapper);
                retMapper:.insert(ofV.name.str, TemplateSolvingUtils::createTypeWrapper(ofV.loc, c));

                return TemplateSolution(retMapper, 1);
            }
        }

        throw copy ErrorMsg::fatal(types[0].loc, format(ValidateErrorMessage::NOT_A_CLASS, types[0]),
                                   notes-> copy [copy ErrorMsg::note(ofV.loc, "")]);
    }

    /**
     * Solve inheritance constraints for “over”.
     *
     */
    fn solveOverClass(dmut context: &ValidationContext,
                      alls:         [&Expression],
                      ofV:          &TemplateOfVarExpr,
                      cptr:         &ClassPtrType)-> TemplateMapper
        throws ErrorMsg
    {
        let inner: &ClassRefType = cptr.inner;
        let mut errors: [mut &ErrorMsg] = [];
        let mut ancestors: [mut &Type] = [];
        let mut retMapper = TemplateMapper(score-> TemplateScore::TYPE);

        let mut ancestor = inner.ancestor;
        while let Ok(c) = ancestor {
            ancestors ~= [c.createInstance(loc-> ofV.loc, isMutable-> false, isInnerMutable-> false)];
            ancestor = c.ancestor;
        }

        for i in 0 .. ancestors.len {
            {
                let local = TemplateExplicitOfVarSolving::solveOfSpec(alias context, ofV.name,  alls, ofV.spec, ancestors[i .. i + 1]);
                let finalType = TemplateRewriting::rewrite(local.mapper, ofV.spec);
                let ofType = TypeValidation::validate(alias context, finalType);
                TypeVerification::verifyCompatible(cptr.loc, ofType.loc, ancestors[i], ofType);

                retMapper:.merge(local.mapper);
                return retMapper;
            } catch {
                err => {
                    errors ~= [err];
                }
            }
        }

        throw copy ErrorMsg::fatal(ofV.loc, format(ValidateErrorMessage::NOT_ANCESTOR, ofV.spec, cptr),
                                   notes-> errors);
    }

    /**
     * Solve a template parameter of the form:
     *     T impl X
     *
     * T is bound to a class, or to a union, implementing the trait.
     *
     * @throws:
     *   - NOT_A_CLASS if expected type is neither a class pointer nor a union.
     */
    fn solveImpl(dmut context: &ValidationContext,
                 alls:         [&Expression],
                 ofV:          &TemplateOfVarExpr,
                 types:        [&Generator])-> TemplateSolution
        throws ErrorMsg
    {
        if (types.len == 0) {
            throw copy ErrorMsg::fatal(ofV.loc, format(ValidateErrorMessage::TEMPLATE_SPECIALIZATION_FAILS, alls, types));
        }

        if let t: &Type = types[0] {
            let unwrapped = TypeCreation::createEnumUnwrap(t);
            let mapper = match unwrapped {
                c: &ClassPtrType => { TemplateExplicitOfVarSolving::solveImplClass(alias context, alls, ofV, c) }
                u: &UnionType    => { TemplateExplicitOfVarSolving::solveImplUnion(alias context, alls, ofV, u) }
                _                => {
                    throw copy ErrorMsg::fatal(types[0].loc, format(ValidateErrorMessage::NOT_A_CLASS, types[0]),
                                               notes-> copy [copy ErrorMsg::note(ofV.loc, "")]);
                }
            };

            let dmut retMapper = TemplateMapper(score-> TemplateScore::VAR);
            retMapper:.merge(mapper);
            retMapper:.insert(ofV.name.str, TemplateSolvingUtils::createTypeWrapper(ofV.loc, unwrapped));

            return TemplateSolution(retMapper, 1);
        }

        throw copy ErrorMsg::fatal(types[0].loc, format(ValidateErrorMessage::NOT_A_CLASS, types[0]),
                                   notes-> copy [copy ErrorMsg::note(ofV.loc, "")]);
    }

    /**
     * Solve trait implementation constraints for “impl” on a class.
     *
     */
    fn solveImplClass(dmut context: &ValidationContext,
                      alls:         [&Expression],
                      ofV:          &TemplateOfVarExpr,
                      cptr:         &ClassPtrType)-> TemplateMapper
        throws ErrorMsg
    {
        let mut errors: [&ErrorMsg] = [];
        if let Ok(mapper) = TemplateExplicitOfVarSolving::solveImplTraits(alias context, alls, ofV, cptr, cptr.inner.allImplementedTraits, ref errors) {
            return mapper;
        }

        throw copy ErrorMsg::fatal(ofV.loc, format(ValidateErrorMessage::CLASS_NOT_IMPL, cptr, ofV.spec),
                                   notes-> errors);
    }

    /**
     * Solve trait implementation constraints for “impl” on a union, which
     * implements the traits all its members implement, or those of its base
     * when it declares one.
     *
     * @throws:
     *   - UNION_NOT_IMPL, noting the base or the members that do not implement
     *     the trait.
     */
    fn solveImplUnion(dmut context: &ValidationContext,
                      alls:         [&Expression],
                      ofV:          &TemplateOfVarExpr,
                      u:            &UnionType)-> TemplateMapper
        throws ErrorMsg
    {
        let uref = UnionValidation::reference(u);
        let mut errors: [&ErrorMsg] = [];
        if let Ok(mapper) = TemplateExplicitOfVarSolving::solveImplTraits(alias context, alls, ofV, u, uref.allImplementedTraits, ref errors) {
            return mapper;
        }

        throw copy ErrorMsg::fatal(ofV.loc, format(ValidateErrorMessage::UNION_NOT_IMPL, u.sym.path.toStr(), ofV.spec),
                                   notes-> errors ~ TemplateExplicitOfVarSolving::createUnionImplNotes(alias context, alls, ofV, uref));
    }

    /**
     * Solve the trait of an “impl” against the traits a type implements.
     *
     * @returns:
     *   - the mapper of the first trait matching, or nothing, 'errors' then
     *     holding why each trait failed
     */
    fn solveImplTraits(dmut context:   &ValidationContext,
                       alls:           [&Expression],
                       ofV:            &TemplateOfVarExpr,
                       type:           &Type,
                       trs:            [&TraitRefType],
                       ref mut errors: [&ErrorMsg])-> (TemplateMapper)?
    {
        for i in 0us .. trs.len {
            {
                let local = TemplateExplicitOfVarSolving::solveOfSpec(alias context, ofV.name, alls, ofV.spec, trs[i .. i + 1us]);
                let finalType = TemplateRewriting::rewrite(local.mapper, ofV.spec);
                let ofType = TypeValidation::validate(alias context, finalType);
                TypeVerification::verifyImplement(ofV.loc, type, ofType);

                let mut retMapper = TemplateMapper(score-> TemplateScore::TYPE);
                retMapper:.merge(local.mapper);
                return retMapper?;
            } catch {
                err: &ErrorMsg => {
                    errors ~= [err];
                }
            }
        }

        none
    }

    /**
     * @returns a note on the base of a union when it does not implement the
     * trait of an “impl”, or else a note on each member that does not
     */
    fn createUnionImplNotes(dmut context: &ValidationContext,
                            alls:         [&Expression],
                            ofV:          &TemplateOfVarExpr,
                            uref:         &UnionRefType)-> [&ErrorMsg]
        throws ErrorMsg
    {
        let mut ignored: [&ErrorMsg] = [];
        if let Ok(b) = uref.base {
            let bptr = b.createInstance(loc-> b.loc, isMutable-> false, isInnerMutable-> false);
            if TemplateExplicitOfVarSolving::solveImplTraits(alias context, alls, ofV, bptr, b.allImplementedTraits, ref ignored).hasValue {
                return [];
            }

            return copy [copy ErrorMsg::note(uref.sym.decl.ancestor.loc, format(ValidateErrorMessage::UNION_BASE_NOT_IMPL, b, ofV.spec))];
        }

        let mut notes: [&ErrorMsg] = [];
        for i, m in uref.members if let c: &ClassPtrType = m {
            if !TemplateExplicitOfVarSolving::solveImplTraits(alias context, alls, ofV, c, c.inner.allImplementedTraits, ref ignored).hasValue {
                notes ~= [copy ErrorMsg::note(uref.sym.decl.types[i].loc,
                                              format(ValidateErrorMessage::UNION_MEMBER_NOT_IMPL, UnionValidation::declaredType(m), ofV.spec))];
            }
        }

        notes
    }
}
