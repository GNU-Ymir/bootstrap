in literal;

use ymirc::syntax::{_, declaration::_, expression::_};
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::semantic::{validator, template_, symbol};

use ymirc::lexing::{word, keys};
use ymirc::errors::_;

use ymirc::utils::format;

use ymirc::semantic::validator::template_::solve::{_, explicit::_};

/**
 * TemplateExplicitLiteralExprSolving module
 *
 * Provides explicit template solving for literal expressions.
 *
 */
pub mod TemplateExplicitLiteralExprSolving {

    /**
     * Solve a literal expression used as a template parameter.
     *
     * @params:
     *   - lit   : literal expression,
     *   - types: expected generators(usually Type or Value).
     *
     * @returns:
     *   - TemplateSolution(mapper, nbConsumed)
     */
    pub fn solve(dmut context: &ValidationContext,
                 lit:          &LiteralExpr,
                 types:        [&Generator])-> TemplateSolution
        throws ErrorMsg
    {
        if let v: &VarExpr = lit {
            return TemplateExplicitLiteralExprSolving::solveVar(v, types);
        }

        return TemplateExplicitValueSolving::solve(alias context, lit, types);
    }

    /**
     * Solve a literal variable expression:
     *
     *     T
     *
     * where T is expected to bind to a type.
     *
     * @throws:
     *   - TEMPLATE_SPECIALIZATION_FAILS if no types are provided,
     *   - USE_AS_TYPE_TEMPLATE if the expected generator is not a Type.
     */
    fn solveVar(v:            &VarExpr,
                types:       [&Generator])-> TemplateSolution
        throws ErrorMsg
    {
        if (types.len == 0us) {
            throw copy ErrorMsg::fatal(v.loc, format(ValidateErrorMessage::TEMPLATE_SPECIALIZATION_FAILS, v, types));
        }

        if let t: &Type = types[0] {
            VariableVerification::verifyNotIsNativeType(v.loc, v.name.str);
            let mut mapper = TemplateMapper(score-> TemplateScore::VAR);
            mapper:.insert(v.name.str, TemplateSolvingUtils::createTypeWrapper(t.loc, t));

            return TemplateSolution(mapper, 1);
        }

        throw copy ErrorMsg::fatal(types[0].loc,
                                   format(ValidateErrorMessage::USE_AS_TYPE_TEMPLATE, types[0]),
                                   notes-> copy [copy ErrorMsg::note(v.loc, "")]);
    }
}
