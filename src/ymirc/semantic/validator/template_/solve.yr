pub mod TemplateSolving {

    pub fn validateCallValue(dmut context: &ValidationContext, loc: &Word, left: &Value, rights: [&Generator])-> TemplateRewriter
        throws ErrorMsg
    {
        context;
        loc;
        left;
        rights;

        eprintln("internal template solving error");
        panic;
    }

    pub fn validateFromTemplateChecker(dmut context: &ValidationContext, loc: &Word, params: [&Expression], rights: [&Generator])-> TemplateRewriter
        throws ErrorMsg
    {
        panic;
    }

    pub fn validateImplicitValue(dmut context: &ValidationContext,
                                 loc: &Word,
                                 left: &TemplateRefValue,
                                 rights: [&Value],
                                 forMethod: bool = false)-> TemplateRewriter
        throws ErrorMsg
    {
        panic;
    }
}



