 */

in solve;

use ymirc::syntax::{_, declaration::_, expression::_};
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::semantic::{validator, template_, symbol};

use ymirc::lexing::word;
use ymirc::errors::_;

use ymirc::utils::format;

use std::{io, stream};

use ymirc::semantic::validator::template_::solve::_;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

mod ::implicit;
pub mod ::explicit;
mod ::utils;
mod ::model;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          ROOT          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * TemplateSolving module
 *
 * High-level entry point for template specialization.
 *
 */
pub mod TemplateSolving {

    /**
     * Solve a template call of the form:
     *
     *     left!{rights...}
     *
     * Error notes:
     *   - If left.loc differs from call location, a note is added pointing to
     *     the original template reference.
     *
     * @returns:
     *   - TemplateMapper containing inferred bindings.
     */
    pub fn solveCall(dmut context: &ValidationContext,
                     loc: &Word,
                     left: &Value,
                     rights: [&Generator])-> TemplateMapper
        throws ErrorMsg
    {
        match left {
            t: &TemplateRefValue => {
                return TemplateSolving::solveCallTemplateRef(alias context, loc, t, rights);
            }
            m: &MethodDelegateTemplateValue => {
                return TemplateSolving::solveCallTemplateRef(alias context, loc, m.proto, rights);
            }
            c: &CtorDelegateTemplateValue => {
                return TemplateSolving::solveCallTemplateRef(alias context, loc, c.proto, rights);
            }
        }

        let mut notes: [&ErrorMsg] = [];
        if (left.loc != loc) {
            notes ~= [copy ErrorMsg::note(left.loc, "")];
        }

        throw copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::UNDEFINED_TEMPLATE_CALL, left, rights,
                                               tags-> FormatTags(withParams-> true)),
                                   notes-> notes);
    }

    /**
     * Solve explicit template parameters for a template declaration.
     *
     * Used for:
     *   - validating explicit template arguments in declarations,
     *   - checking template constraints.
     */
    pub fn solveChecker(dmut context: &ValidationContext,
                        loc: &Word,
                        params: [&Expression],
                        rights: [&Generator])-> TemplateMapper
        throws ErrorMsg
    {
        let local = TemplateExplicitSolving::solve(alias context, params, rights);

        if (local.nbConsumed < rights.len) {
            throw copy ErrorMsg::fatal(rights[local.nbConsumed].loc, format(ValidateErrorMessage::TEMPLATE_REST, rights[local.nbConsumed .. $]),
                                       notes-> copy [copy ErrorMsg::note(loc, "")]);
        }

        return local.mapper;
    }

    /**
     * Solve template parameters implicitly from call-site expressions.
     *
     * @params:
     *   - left      : TemplateRefValue representing the template,
     *   - rights    : list of argument values,
     *   - forMethod: whether solving is for a method call(affects rules).
     *
     * Used for:
     *   - function calls,
     *   - method calls,
     *   - constructor calls,
     *   - operator calls.
     *
     */
    pub fn solveImplicit(dmut context:   &ValidationContext,
                         loc:       &Word,
                         left:      &TemplateRefValue,
                         rights:    [&Value],
                         forMethod: bool = false)-> TemplateMapper
        throws ErrorMsg
    {
        return TemplateImplicitSolving::solve(alias context, loc, left, rights,
                                              forMethod-> forMethod);
    }

    /**
     * Solve a template call where the left-hand side is a TemplateRefValue.
     *
     * This is the core entry point for explicit template calls.
     */
    fn solveCallTemplateRef(dmut context: &ValidationContext,
                            loc: &Word,
                            left: &TemplateRefValue,
                            rights: [&Generator])-> TemplateMapper
        throws ErrorMsg
    {
        let templateParams = left.sym.decl.params;
        let local = TemplateExplicitSolving::solve(alias context, templateParams, rights);

        if (local.nbConsumed < rights.len) {
            throw copy ErrorMsg::fatal(rights[local.nbConsumed].loc, format(ValidateErrorMessage::TEMPLATE_REST, rights[local.nbConsumed .. $]),
                                       notes-> copy [copy ErrorMsg::note(loc, "")]);
        }

        return local.mapper;
    }
}
