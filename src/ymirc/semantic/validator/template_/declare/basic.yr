/*
 * Template instantiation and symbol declaration.
 *
 * TemplateBasicDeclaration is responsible for *declaring* the concrete
 * symbols produced by template specialization. After template solving
 * produces a TemplateMapper, this module:
 *
 *   1. Rewrites the template declaration using the mapper.
 *   2. Declares the resulting symbol in the symbol tree.
 *   3. Validates the newly declared symbol.
 *   4. Registers the symbol in the template instantiation cache.
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::semantic::validator::template_::declare::basic
 * @File: ymirc/semantic/validator/template_/declare/basic.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2026-06-14
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in basic;

use ymirc::syntax::{_, declaration::_, expression::_};
use ymirc::semantic::generator::{value::_, type::_};

use ymirc::semantic::{validator, template_, symbol};

use ymirc::lexing::word;
use ymirc::errors;

use ymirc::utils::format;

use ymirc::semantic::validator::template_::declare::_;


/**
 * TemplateBasicDeclaration module
 *
 * Provides the core logic for declaring template‑instantiated symbols.
 *
 */
pub mod TemplateBasicDeclaration {

    /**
     * Declare a template instantiation for a TemplateRefValue.
     *
     * @returns:
     *   - &Symbol (mutable reference to the declared symbol)
     */
    pub fn declare(dmut context: &ValidationContext,
                   loc:          &Word,
                   mapper:       TemplateMapper,
                   value:        &TemplateRefValue)-> dmut &Symbol
        throws ErrorMsg
    {        
        let (toDeclare, finalRewriter) = TemplateDeclareFinalization::performTemplateRewrite(alias context, loc, mapper, value);
        let dmut ret = alias TemplateBasicDeclaration::declareTemplateRefValue(alias context, loc, finalRewriter, value, toDeclare);
        if (ret._1) {
            {                
                SymbolValidation::validate(alias context, alias ret._0);
            } catch {
                err: &ErrorMsg => {
                    let fErr = copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::TEMPLATE_SPECIALIZATION_FAILS, value, finalRewriter), notes-> copy [err]);;
                    context.templateContext:.replace(finalRewriter, value.sym, copy ErrorSymbol(fErr));
                    throw fErr;
                }
            }
        }

        return alias ret._0;
    }

    /**
     * Declare a symbol produced by template specialization.
     *
     * @returns:
     *   - (&Symbol, bool)
     *        * Symbol = declared or cached symbol,
     *        * bool   = true if newly declared, false if retrieved from cache.
     */
    pub fn declareTemplateRefValue(dmut context: &ValidationContext,
                                   loc:          &Word,
                                   mapper:       TemplateMapper,
                                   value:        &TemplateRefValue,
                                   toDeclare:    &Declaration)-> dmut(&Symbol, bool)
        throws ErrorMsg
    {
        let dmut search = context.templateContext:.find(value, mapper);
        match alias search {
            Ok(dmut err: &ErrorSymbol) => throw err.error;
            Ok(dmut s: &Symbol) => {
                return (alias s, false);
            }
        }

        {
            let dmut declarator = alias context.declarator;
            let dmut referent = context:.getSymbolFromRef(value.sym.referent);
            let dmut ret = match (toDeclare, value) {
                (c: &CtorDecl, tmp: &TemplateRefCtorValue) => {
                    if let dmut classSym: &ClassSymbol = context:.getSymbolFromRef(tmp.classSym) {
                        alias declarator.declareCtor(c, alias classSym, value.sym.protection)
                    } else panic;
                }
                (c: &TypeDecl, _) => {
                    alias declarator:.declareClass(c, parent-> alias referent, value.sym.protection, fromTemplate-> true)
                }
                (a: &DefDecl, _) => {
                    alias declarator.declareDef(a, parent-> alias referent, value.sym.protection, fromTemplate-> true)
                }
                _ => {
                    alias declarator:.declare(toDeclare, parent-> alias referent)
                }
            };

            declarator:.finalizeDeclaration(alias ret);
            ret:.setFromTemplate(mapper); 

            context.templateContext:.register(mapper, value.sym, alias ret);
            return (alias ret, true);
        }  catch {
            err: &ErrorMsg => {
                let fErr = copy ErrorMsg::fatal(loc, format(ValidateErrorMessage::TEMPLATE_SPECIALIZATION_FAILS, value, mapper),
                                                notes-> copy [err]);
                context.templateContext:.replace(mapper, value.sym, copy ErrorSymbol(fErr));
                throw fErr;
            }
        }
    }
}
