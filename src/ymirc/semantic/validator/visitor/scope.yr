in scope;

/**
 * List of variables declared inside a scope
 * */
pub class DeclaredVars {

    // Name => varref
    pub let mut content: [[c8] => mut &Value] = copy [];
    pub self () {}
}

/**
 * List of variable used inside a scope
 * */
pub class UsedVars {

    // name => loc of usage
    pub let mut content: [[c8] => mut &Word] = copy [];
    pub self () {}
    
    pub fn opContains (self, v: [c8])-> bool {
        v in self.content
    }
}

pub def ScopeList:      &List!{dmut &DeclaredVars};
pub def UsedList:       &List!{dmut &UsedVars};
pub def TypeList:       &List!{&Type};
pub def ValueList:      &List!{&Value};
pub def BoolList:       &List!{bool};
pub def WordList:       &List!{&Word};
pub def ClosureList:    &List!{&ClosureType};
pub def ExpressionList: &List!{&Expression};
pub def GeneratorList:  &List!{&Generator};
pub def ErrorList:      &List!{&ErrorMsg};

lazy __NATIVE_TYPES__ = {
    let dmut lst: [[c8] => ()] = copy [];
    for i in NativeTypes::__members__ if t != NativeTypes::ERROR {
        lst [i] = ();
    }
};
