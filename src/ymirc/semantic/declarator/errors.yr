in errors;

/**
 * List of message that can be sent by the declarator
 */
pub enum DeclareErrorMessage
| ABSTRACT_AND_FINAL                      = "a class cannot be both abstract and final"
| CONFLICT_MODULES                        = "module is ambiguously defined in both %(y) and %(y)"
| DECLARED_HERE                           = "declared here"
| DECL_GLOB_STATIC_NON_EXTERN             = "only external global variables may be declared static"
| DECL_GLOB_THREAD_EXTERN                 = "only local global variables may be declared thread-local"
| DECL_VARIADIC_FUNC                      = "only external C functions may be variadic"
| DTOR_IN_RECORD                          = "record types cannot define destructors"
| EXPECT_CORE_MODULES                     = "expected core module %(y) to be defined"
| IMPORT_EXTERN_PACKAGE                   = "when importing external package %(y)"
| IMPORT_OUT_GLOBAL                       = "child global modules may only be imported from within a global module"
| IMPORT_RECURSIVE                        = "recursive import detected"
| IN_IMPORT                               = "during import of module %(y)"
| MALFORMED_CORE                          = "core module is malformed"
| MAYBE_WAS_MEANT                         = "did you mean %(y)"
| MAYBE_WAS_MEANT_FROM_MOD                = "did you mean %(y) from module %(y)"
| MULTIPLE_DESTRUCTOR                     = "a class may only define one destructor"
| NOT_OVERRIDE                            = "method %(y) is marked override but does not override any base method"
| NO_MODULE_NAMED                         = "no module named %(y) found inside module %(y)"
| NO_SUCH_FILE                            = "module should be located in %(y) or %(y), but no such file exists or access is denied"
| NO_SUCH_FILE_ONE                        = "module should be located in %(y), but no such file exists or access is denied"
| OVERLAID_AND_PACKED                     = "a record cannot be both overlaid and packed"
| PRIVATE_IN_THIS_CONTEXT                 = "%(y) is private in this context"
| PRIVATE_IN_THIS_CONTEXT_FROM_MOD        = "%(y) from module %(y) is private in this context"
| SELF_USE                                = "the %(y) module is imported implicitly; an explicit use is unnecessary"
| SHADOWING_DECL                          = "declaration of %(y) shadows a previous declaration"
| UNDEFINED_ATTRIBUTE_FOR_CLASS           = "custom attribute %(y) is not valid on classes"
| UNDEFINED_ATTRIBUTE_FOR_CTOR            = "custom attribute %(y) is not valid on constructors"
| UNDEFINED_ATTRIBUTE_FOR_FUNCTION        = "custom attribute %(y) is not valid on functions"
| UNDEFINED_ATTRIBUTE_FOR_GLOBAL          = "custom attribute %(y) is not valid on global variables"
| UNDEFINED_ATTRIBUTE_FOR_RECORD          = "custom attribute %(y) is not valid on records"
| UNDEFINED_ATTRIBUTE_FOR_TEMPLATE_METHOD = "custom attribute %(y) is not valid on template methods"
| UNDEFINED_ATTRIBUTE_NO_CLASS            = "custom attribute %(y) may only be applied to classes"
| UNDEFINED_ATTRIBUTE_NO_RECORD           = "custom attribute %(y) may only be applied to records"
| UNDEF_VAR                               = "undefined symbol %(y)"
| UNEXPECTED_IN_CLASS                     = "unexpected declaration inside a class"
| UNEXPECTED_IN_EXTERN                    = "unexpected declaration inside an extern block"
| UNEXPECTED_IN_IMPL                      = "unexpected declaration inside an impl block"
| UNEXPECTED_IN_MACRO                     = "unexpected declaration inside a macro"
| UNEXPECTED_IN_MODULE                    = "unexpected declaration"
| UNEXPECTED_IN_TRAIT                     = "unexpected declaration inside a trait"
| WRONG_MODULE_NAME                       = "module %(y) must be defined in a file named %(y)";
