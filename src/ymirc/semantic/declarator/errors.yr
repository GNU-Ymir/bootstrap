in errors;

use ymirc::errors::code;

/// Local shorthand for the catalogue entry type, cf. `ymirc::errors::code`.
def Error: code::Error;

/// The code of a message that is a context note rather than a diagnostic.
def NO_CODE = code::NO_CODE;

/**
 * List of message that can be sent by the declarator
 */
pub enum DeclareErrorMessage: Error
| ABSTRACT_AND_FINAL                      = Error (3001,    "a class cannot be both abstract and final")
| CONFLICT_MODULES                        = Error (3002,    "module is ambiguously defined in both %(y) and %(y)")
| DECLARED_HERE                           = Error (NO_CODE, "declared here")
| DECL_GLOB_STATIC_NON_EXTERN             = Error (3003,    "only external global variables may be declared static")
| DECL_GLOB_THREAD_EXTERN                 = Error (3004,    "only local global variables may be declared thread-local")
| DECL_VARIADIC_FUNC                      = Error (3005,    "only external C functions may be variadic")
| DEFAULT_CTOR_ALREADY_DECLARED           = Error (3006,    "the ctor built from the fields is already declared")
| DEFAULT_CTOR_IN_DATA                    = Error (3007,    "the ctor built from the fields is implicit in a @(y=data) record")
| DTOR_IN_RECORD                          = Error (3008,    "record types cannot define destructors")
| EXPECT_CORE_MODULES                     = Error (NO_CODE, "expected core module %(y) to be defined")
| IMPORT_EXTERN_PACKAGE                   = Error (NO_CODE, "when importing external package %(y)")
| IMPORT_OUT_GLOBAL                       = Error (NO_CODE, "child global modules may only be imported from within a global module")
| IMPORT_RECURSIVE                        = Error (NO_CODE, "recursive import detected")
| IN_IMPORT                               = Error (NO_CODE, "during import of module %(y)")
| MALFORMED_CORE                          = Error (3009,    "core module is malformed")
| MAYBE_WAS_MEANT                         = Error (NO_CODE, "did you mean %(y)")
| MAYBE_WAS_MEANT_FROM_MOD                = Error (NO_CODE, "did you mean %(y) from module %(y)")
| MULTIPLE_DESTRUCTOR                     = Error (3010,    "a class may only define one destructor")
| NOT_OVERRIDE                            = Error (3011,    "method %(y) is marked override but does not override any base method")
| NO_MODULE_NAMED                         = Error (3012,    "no module named %(y) found inside module %(y)")
| NO_SUCH_FILE                            = Error (3013,    "module should be located in %(y) or %(y), but no such file exists or access is denied")
| NO_SUCH_FILE_ONE                        = Error (3014,    "module should be located in %(y), but no such file exists or access is denied")
| OVERLAID_AND_PACKED                     = Error (3015,    "a record cannot be both overlaid and packed")
| PRIVATE_IN_THIS_CONTEXT                 = Error (3016,    "%(y) is private in this context")
| PRIVATE_IN_THIS_CONTEXT_FROM_MOD        = Error (NO_CODE, "%(y) from module %(y) is private in this context")
| SELF_USE                                = Error (3017,    "the %(y) module is imported implicitly; an explicit use is unnecessary")
| SHADOWING_DECL                          = Error (3018,    "declaration of %(y) shadows a previous declaration")
| UNDEFINED_ATTRIBUTE_FOR_CLASS           = Error (3019,    "custom attribute %(y) is not valid on classes")
| UNDEFINED_ATTRIBUTE_FOR_CTOR            = Error (3020,    "custom attribute %(y) is not valid on constructors")
| UNDEFINED_ATTRIBUTE_FOR_FUNCTION        = Error (3021,    "custom attribute %(y) is not valid on functions")
| UNDEFINED_ATTRIBUTE_FOR_GLOBAL          = Error (3022,    "custom attribute %(y) is not valid on global variables")
| UNDEFINED_ATTRIBUTE_FOR_RECORD          = Error (3023,    "custom attribute %(y) is not valid on records")
| UNDEFINED_ATTRIBUTE_FOR_TEMPLATE_METHOD = Error (3024,    "custom attribute %(y) is not valid on template methods")
| UNDEFINED_ATTRIBUTE_NO_CLASS            = Error (3025,    "custom attribute %(y) may only be applied to classes")
| UNDEFINED_ATTRIBUTE_NO_RECORD           = Error (3026,    "custom attribute %(y) may only be applied to records")
| UNDEF_VAR                               = Error (3027,    "undefined symbol %(y)")
| UNEXPECTED_IN_CLASS                     = Error (3028,    "unexpected declaration inside a class")
| UNEXPECTED_IN_EXTERN                    = Error (3029,    "unexpected declaration inside an extern block")
| UNEXPECTED_IN_IMPL                      = Error (3030,    "unexpected declaration inside an impl block")
| UNEXPECTED_IN_MACRO                     = Error (3031,    "unexpected declaration inside a macro")
| UNEXPECTED_IN_MODULE                    = Error (3032,    "unexpected declaration")
| UNEXPECTED_IN_TRAIT                     = Error (3033,    "unexpected declaration inside a trait")
| WRONG_MODULE_NAME                       = Error (3034,    "module %(y) must be defined in a file named %(y)");
