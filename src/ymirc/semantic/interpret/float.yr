in float;

use ymirc::semantic::generator::{_, value::_, type::_};
use ymirc::global;

use ymirc::semantic::validator;
use ymirc::errors::message;

use ymirc::utils::{format, bigfloat, bigint};
use ymirc::lexing::{word, keys};

/**
 * Compile-time reduction logic for floating-point operators.
 *
 * This module implements the reduction pipeline for all float-related operators
 * encountered during semantic validation. Supported operations:
 *
 *   - comparison operators (<, <=, >, >=, ==, !=)
 *   - arithmetic operators (+, -, *, /)
 *   - special float operators (DXOR, %, exponentiation, modulo)
 *
 * Reduction strategy:
 *   - Operands are reduced using `reduceInOperator`, which performs lazy,
 *     context-aware compile-time evaluation.
 *   - When both operands are FloatValue literals, full CTE evaluation is
 *     performed.
 *   - When only one operand is literal, partial evaluation rules are applied
 *     (e.g., division-by-zero detection).
 *   - When no reduction is possible, the operator is reconstructed with
 *     reduced operands.
 *
 * Special handling:
 *   - DXOR supports both float^int and float^float exponentiation.
 *   - Modulo (%) is supported only for float operands.
 *   - Division by zero is detected and reported as a fatal error.
 *
 * The module also provides a comprehensive set of float-type utilities:
 *   - max/min finite values,
 *   - NaN, infinity, epsilon,
 *   - mantissa size, decimal precision,
 *   - max/min base-10 and base-2 exponents,
 *   - hexadecimal float literal construction.
 *
 * This module is invoked by the operator interpreter whenever a float operator
 * is encountered.
 * 
 */
pub mod FloatInterpret {

    /**
     * Reduces a floating-point comparison operator.
     *
     * Attempts a full CTE reduction by delegating to the internal comparison
     * routine. If reduction succeeds, the resulting BoolValue is returned.
     * Otherwise, the operator is reconstructed with reduced operands.
     *
     * Parameters:
     *   - context: the compile-time interpreter instance.
     *   - bin:     the comparison operator.
     *
     * Returns:
     *   A BoolValue when reduction succeeds, or a reduced CmpFloatOperatorValue.
     *   
     */
    pub fn reduceCmp (dmut context: &CompileTimeInterpret, bin: &CmpFloatOperatorValue)-> &Value
        throws ErrorMsg
    {        
        if let Ok (res) = FloatInterpret::reduceCmp (alias context, bin.loc, bin.op, bin.left, bin.right) {
            return res;
        }
        
        return copy CmpFloatOperatorValue (loc-> bin.loc,
                                           op-> bin.op,
                                           left-> context:.reduce (bin.left),
                                           right-> context:.reduce (bin.right),
                                           isReduced-> true);
    }

    /**
     * Attempts to reduce a floating-point comparison.
     *
     * Steps:
     *   1. Reduce both operands using `reduceInOperator`.
     *   2. If both operands are FloatValue literals, evaluate the comparison:
     *        - <, <=, >, >=, ==, !=
     *   3. If both operands reduce to identical literals, return the known result.
     *   4. Otherwise, return `none` to signal that no reduction is possible.
     *
     * Returns:
     *   A BoolValue wrapped in `option` when reduction succeeds, or `none`.
     *   
     */
    pub fn reduceCmp (dmut context: &CompileTimeInterpret, loc: &Word, bop: BinaryOperators, bleft: &Value, bright: &Value)-> (&Value?)
        throws ErrorMsg
    {
        let left = context:.reduceInOperator (bleft, checkCte-> false);
        let right = context:.reduceInOperator (bright, checkCte-> false);
        
        match (left, right) {
            (l: &FloatValue, r: &FloatValue) => {
                match bop {
                    BinaryOperators::INF       => { return (copy BoolValue (loc, l.value < r.value))?; }
                    BinaryOperators::SUP       => { return (copy BoolValue (loc, l.value > r.value))?; }
                    BinaryOperators::INF_EQUAL => { return (copy BoolValue (loc, l.value <= r.value))?; }
                    BinaryOperators::SUP_EQUAL => { return (copy BoolValue (loc, l.value >= r.value))?; }
                    BinaryOperators::NOT_EQUAL => { return (copy BoolValue (loc, l.value != r.value))?; }
                    BinaryOperators::DEQUAL    => { return (copy BoolValue (loc, l.value == r.value))?; }
                }
            }
        }

        let resLeft = context:.reduce (bleft);
        let resRight = context:.reduce (bright);
        if (resLeft is resRight) || (resLeft.isFullLiteral && resRight.isFullLiteral && resLeft == resRight) {
            match bop {
                BinaryOperators::DEQUAL    => { return (copy BoolValue (loc, true))?; }
                BinaryOperators::NOT_EQUAL => { return (copy BoolValue (loc, false))?; }
                BinaryOperators::SUP       => { return (copy BoolValue (loc, false))?; }
                BinaryOperators::INF       => { return (copy BoolValue (loc, false))?; }
                BinaryOperators::INF_EQUAL => { return (copy BoolValue (loc, true))?; }
                BinaryOperators::SUP_EQUAL => { return (copy BoolValue (loc, true))?; }
            }
        }

        return none;
    }

    /**
     * Reduces a floating-point arithmetic operator.
     *
     * Steps:
     *   1. Reduce both operands using `reduceInOperator`.
     *   2. If both operands are FloatValue literals:
     *        - evaluate +, -, *, /
     *        - detect division by zero
     *        - return a FloatValue literal
     *   3. If only the right operand is literal:
     *        - detect division by zero early
     *   4. Otherwise, reconstruct the operator with reduced operands.
     *
     * Returns:
     *   A FloatValue when reduction succeeds, or a reduced MathFloatOperatorValue.
     *   
     */
    pub fn reduceMath (dmut context: &CompileTimeInterpret, bin: &MathFloatOperatorValue)-> &Value
        throws ErrorMsg
    {
        let left = context:.reduceInOperator (bin.left, checkCte-> false);
        let right = context:.reduceInOperator (bin.right, checkCte-> false);

        match (left, right, bin.type) {
            (l: &FloatValue, r: &FloatValue, t: &FloatType) => {
                let v = match bin.op {
                    BinaryOperators::PLUS  => { l.value + r.value }
                    BinaryOperators::MINUS => { l.value - r.value }
                    BinaryOperators::STAR  => { l.value * r.value }
                    BinaryOperators::DIV   => {
                        if (r.value == 0.0f) throw copy ErrorMsg::fatal (bin.loc, ValidateErrorMessage::DIVISION_BY_ZERO);
                        {
                            l.value / r.value
                        } catch { _        => panic; }
                    }
                    _ => {
                        return copy MathFloatOperatorValue (bin.loc,
                                                            bin.type,
                                                            bin.op,
                                                            context:.reduce (bin.left),
                                                            context:.reduce (bin.right),
                                                            isReduced-> true);
                    }
                }

                return copy FloatValue (bin.loc, t, v);
            }
            (_, r: &FloatValue, _) => {
                if (bin.op == BinaryOperators::DIV && r.value == 0.0f) {
                    throw copy ErrorMsg::fatal (bin.loc, ValidateErrorMessage::DIVISION_BY_ZERO);
                }
            }
        }

        return copy MathFloatOperatorValue (bin.loc,
                                            bin.type,
                                            bin.op,
                                            context:.reduce (bin.left),
                                            context:.reduce (bin.right),
                                            isReduced-> true);
    }

    /**
     * Reduces a special floating-point operator.
     *
     * Supported operations:
     *   - DXOR (exponentiation): float^^int or float^^float
     *   - PERCENT (modulo): float % float
     *
     * Steps:
     *   1. Reduce both operands using `reduceInOperator`.
     *   2. If operands match a supported literal pattern, delegate to:
     *        - reduceMathFloatPow
     *        - reduceMathFloatMod
     *   3. Detect division-by-zero for modulo.
     *   4. Otherwise, reconstruct the operator with reduced operands.
     *
     * Returns:
     *   A FloatValue when reduction succeeds, or a reduced SpecialMathFloatOperatorValue.
     *   
     */
    pub fn reduceSpe (dmut context: &CompileTimeInterpret, bin: &SpecialMathFloatOperatorValue)-> &Value
        throws ErrorMsg
    {
        let left = context:.reduceInOperator (bin.left, checkCte-> false);
        let right = context:.reduceInOperator (bin.right, checkCte-> false);

        match (left, right, bin.type) {
            (l: &FloatValue, r: &IntValue, t: &FloatType) => {
                match bin.op {
                    BinaryOperators::DXOR => { return FloatInterpret::reduceMathFloatPow (bin.loc, t, l, r); }
                }
            }
            (l: &FloatValue, r: &FloatValue, t: &FloatType) => {
                match bin.op {
                    BinaryOperators::DXOR => { return FloatInterpret::reduceMathFloatPow (bin.loc, t, l, r); }
                    BinaryOperators::PERCENT => { return FloatInterpret::reduceMathFloatMod (bin.loc, t, l, r); }
                }
            }
            (_, r: &FloatValue, _) => {
                if (bin.op == BinaryOperators::PERCENT && r.value == 0.0f) {
                    throw copy ErrorMsg::fatal (bin.loc, ValidateErrorMessage::DIVISION_BY_ZERO);
                }
            }
        }

        return copy SpecialMathFloatOperatorValue (loc-> bin.loc,
                                                   type-> bin.type,
                                                   op-> bin.op,
                                                   left-> context:.reduce (bin.left),
                                                   right-> context:.reduce (bin.right),
                                                   call-> context:.reduce (bin.call),
                                                   isReduced-> true);
    }

    /**
     * Computes floating-point modulo.
     *
     * Parameters:
     *   - loc:   source location for error reporting.
     *   - type:  the target float type.
     *   - left:  left operand (FloatValue).
     *   - right: right operand (FloatValue).
     *
     * Throws:
     *   - ErrorMsg::fatal on modulo-by-zero.
     *
     * Returns:
     *   A FloatValue containing the modulo result.
     *   
     */
    fn reduceMathFloatMod (loc: &Word, type: &FloatType, left: &FloatValue, right: &FloatValue)-> &Value
        throws ErrorMsg
    {
        if (right.value == 0.0) throw copy ErrorMsg::fatal (loc, ValidateErrorMessage::DIVISION_BY_ZERO);
        let r = {
            left.value % right.value
        } catch {
            _ => panic;                            
        };

        copy FloatValue (loc, type, r)
    }

    /**
     * Computes floating-point exponentiation where the exponent is an integer.
     *
     * Parameters:
     *   - loc:   source location.
     *   - type:  the target float type.
     *   - left:  base (FloatValue).
     *   - right: exponent (IntValue).
     *
     * Throws:
     *   - ErrorMsg::fatal on overflow or invalid exponentiation.
     *
     * Returns:
     *   A FloatValue containing the exponentiation result.
     */
    fn reduceMathFloatPow (loc: &Word, type: &FloatType, left: &FloatValue, right: &IntValue)-> &Value
        throws ErrorMsg
    {
        let r = {
            left.value ^^ right.value.to!{i64} ()
        } catch {
            _ => throw copy ErrorMsg::fatal (loc, format (ValidateErrorMessage::OVERFLOW_CAPACITY, right.type, right, i64::max));
        }


        copy FloatValue (loc, type, r)
    }

    /**
     * Computes floating-point exponentiation where both operands are floats.
     *
     * No overflow checking is performed; BigFloat handles extended precision.
     *
     * Returns:
     *   A FloatValue containing the exponentiation result.
     *   
     */
    fn reduceMathFloatPow (loc: &Word, type: &FloatType, left: &FloatValue, right: &FloatValue)-> &Value {
        let r = left.value ^^ right.value;
        copy FloatValue (loc, type, r)
    }


    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          UNARY          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Reduces a unary operator applied to a floating-point expression.
     *
     * Supported operation:
     *   • unary minus ( -x )
     *
     * Reduction strategy:
     *   1. The operand is first reduced using `reduceInOperator`, which performs
     *      context-aware reduction without forcing full CTE evaluation.
     *
     *   2. If the operand is a FloatValue literal and the operator is MINUS:
     *        - the negation is computed at compile time using BigFloat arithmetic,
     *        - the result is returned as a new FloatValue.
     *
     *   3. Otherwise, the unary operator is reconstructed with a fully reduced
     *      operand and marked as reduced.
     *
     * Notes:
     *   - Negation is performed using BigFloat to preserve precision and avoid
     *     platform-dependent float behavior.
     *
     * Parameters:
     *   - context: the compile-time interpreter instance.
     *   - un:      the unary operator to reduce.
     *
     * Returns:
     *   A reduced Value corresponding to the unary operation.        
     *   
     */
    pub fn reduceUnary (dmut context: &CompileTimeInterpret, un: &UnaryOperatorValue)-> &Value
        throws ErrorMsg
    {
        let content = context:.reduceInOperator (un.value, checkCte-> false);        
        if let (v: &FloatValue, ti: &FloatType) = (content, un.type) && un.op == UnaryOperators::MINUS {
            return copy FloatValue (un.loc, ti, copy BigFloat (0.0) - v.value);
        }
        
        return copy UnaryOperatorValue (loc-> un.loc,
                                        type-> un.type,
                                        op-> un.op,
                                        value-> context:.reduce (un.value),
                                        isReduced-> true);        
    }
    
    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          UTILS          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */
    
    /**
     * Computes the maximal finite value representable by the given FloatType.
     *
     * Uses IEEE-754 encoding rules based on the float size (32, 64, 80 bits) or
     * the platform’s configured float size.
     *
     * Returns:
     *   A BigFloat representing the largest finite value.
     *   
     */
    pub fn createFloatMaxValue (f: &FloatType)-> &BigFloat {
        match (f.size, state::floatArchSize ()) {
            (32u16, _) => { FloatInterpret::createFloatFromHex ("1"s8, "fffffe"s8, "127"s8) }
            (64u16, _) => { FloatInterpret::createFloatFromHex ("1"s8, "fffffffffffff"s8, "1023"s8) }
            (80u16, _) => { FloatInterpret::createFloatFromHex ("f"s8, "fffffffffffffff"s8, "16380"s8) }

            // fsize
            (_, 32u16) => { FloatInterpret::createFloatFromHex ("1"s8, "fffffe"s8, "127"s8) }
            (_, 64u16) => { FloatInterpret::createFloatFromHex ("1"s8, "fffffffffffff"s8, "1023"s8) }
            _ => {
                FloatInterpret::createFloatFromHex ("f"s8, "fffffffffffffff"s8, "16380"s8)
            }
        }
    }

    /**
     * Computes the minimal finite (non-zero) value representable by the given FloatType.
     *
     * Returns:
     *   A BigFloat representing the smallest positive normalized value.
     */
    pub fn createFloatMinValue (f: &FloatType)-> &BigFloat {
        match (f.size, state::floatArchSize ()) {
            (32u16, _) => { FloatInterpret::createFloatFromHex ("1"s8, "0"s8, "-126"s8) }
            (64u16, _) => { FloatInterpret::createFloatFromHex ("1"s8, "0"s8, "-1022"s8) }
            (80u16, _) => { FloatInterpret::createFloatFromHex ("8"s8, "0"s8, "-16385"s8) }

            // fsize
            (_, 32u16) => {  FloatInterpret::createFloatFromHex ("1"s8, "0"s8, "-126"s8) }
            (_, 64u16) => {  FloatInterpret::createFloatFromHex ("1"s8, "0"s8, "-1022"s8) }
            _ => {
                FloatInterpret::createFloatFromHex ("8"s8, "0"s8, "-16385"s8)
            }
        }
    }
    
    /**
     * Returns a NaN value for the given FloatType.
     *
     * Notes:
     *   - Always returns a BigFloat constructed from f32::nan.
     *   
     */
    pub fn createFloatNanValue (_: &FloatType)-> &BigFloat {
        copy BigFloat (f32::nan)
    }


    /**
     * Returns the number of decimal digits of precision for the given FloatType.
     *
     * Examples:
     *   - f32 -> 6
     *   - f64 -> 15
     *   - f80 -> 18
     *   
     */
    pub fn createFloatDigValue (f: &FloatType)-> usize {
        match (f.size, global::state::floatArchSize ()) {
            (32u16, _) => { 6us }
            (64u16, _) => {  15us }
            (80u16, _) => {  18us }

            // fsize
            (_, 32u16) => { 6us }
            (_, 64u16) => {  15us }
            _ => {  18us }
        }
    }
    
    /**
     * Returns the number of bits in the mantissa for the given FloatType.
     *
     * Examples:
     *   - f32 -> 24 bits
     *   - f64 -> 53 bits
     *   - f80 -> 64 bits
     *   
     */
    pub fn createFloatMantDigValue (f: &FloatType)-> usize {
        match (f.size, state::floatArchSize ()) {
            (32u16, _) => { 24us }
            (64u16, _) => {  53us }
            (80u16, _) => {  64us }

            // fsize
            (_, 32u16) => { 24us }
            (_, 64u16) => {  53us }
            _ => {  64us }
        }
    }
    
    /**
     * Returns the maximum/minimum base-10 exponent such that 10^exp is representable.
     *
     * Examples:
     *   - f32 -> 38
     *   - f64 -> 308
     *   - f80 -> 4932
     */
    pub fn createFloatMax10ExpValue (f: &FloatType)-> usize {
        match (f.size, state::floatArchSize ()) {
            (32u16, _) => { 38us }
            (64u16, _) => { 308us }
            (80u16, _) => { 4932us }

            // fsize
            (_, 32u16) => { 38us }
            (_, 64u16) => { 308us }
            _ => { 4932us }
        }
    }
    
    /**
     * Returns the maximum/minimum base-10 exponent such that 10^exp is representable.
     *
     * Examples:
     *   - f32 -> -37
     *   - f64 -> -307
     *   - f80 -> -4931
     *   
     */
    pub fn createFloatMin10ExpValue (f: &FloatType)-> isize {
        match (f.size, state::floatArchSize ()) {
            (32u16, _) => { -37is }
            (64u16, _) => {  -307is }
            (80u16, _) => {  -4931is }

            // fsize
            (_, 32u16) => { -37is }
            (_, 64u16) => {  -307is }
            _ => {  -4931is }
        }
    }

    /**
     * Returns the maximum base-2 exponent such that 2^exp is representable.
     *
     * Examples:
     *   - f32 -> 128
     *   - f64 -> 1024
     *   - f80 -> 16384
     */
    pub fn createFloatMax2ExpValue (f: &FloatType)-> usize {
        match (f.size, state::floatArchSize ()) {
            (32u16, _) => { 128us }
            (64u16, _) => {  1024us }
            (80u16, _) => { 16384us }

            // fsize
            (_, 32u16) => { 128us }
            (_, 64u16) => {  1024us }
            _ => { 16384us }
        }
    }

    /**
     * Returns the minimum base-2 exponent such that 2^exp is representable.
     *
     * Examples:
     *   - f32 -> -125
     *   - f64 -> -1021
     *   - f80 -> -16381
     */
    pub fn createFloatMin2ExpValue (f: &FloatType)-> isize {
        match (f.size, state::floatArchSize ()) {
            (32u16, _) => { -125is }
            (64u16, _) => {  -1021is }
            (80u16, _) => { -16381is }

            // fsize
            (_, 32u16) => { -125is }
            (_, 64u16) => {  -1021is }
            _ => { -16381is }
        }
    }

    /**
     * Returns a +∞ value for the given FloatType.
     */
    pub fn createFloatInfValue (_: &FloatType)-> &BigFloat {
        copy BigFloat (f32::inf)
    }
    
    /**
     * Returns the machine epsilon for the given FloatType.
     *
     * Examples:
     *   - f32 -> 2^-23
     *   - f64 -> 2^-52
     *   - f80 -> 2^-63
     */
    pub fn createFloatEpsilonValue (f: &FloatType)-> &BigFloat {
        match (f.size, state::floatArchSize ()) {
            (32u16, _) => { copy BigFloat (2.0) ^^ (-23i64) }
            (64u16, _) => {  copy BigFloat (2.0) ^^ (-52i64) }
            (80u16, _) => {  copy BigFloat (2.0) ^^ (-63i64) }

            // fsize
            (_, 32u16) => { copy BigFloat (2.0) ^^ (-23i64) }
            (_, 64u16) => {  copy BigFloat (2.0) ^^ (-52i64) }
            _ => {  copy BigFloat (2.0) ^^ (-63i64) }
        }
    }

    /**
     * Constructs a BigFloat from hexadecimal float components.
     *
     * Parameters:
     *   - int:  integer part of the hex literal
     *   - frac: fractional part
     *   - exp:  exponent part (base-2 exponent)
     *
     * Returns:
     *   A BigFloat representing the decoded floating-point value.
     *
     * Notes:
     *   - Supports both positive and negative exponents.
     *   - Used for parsing IEEE-754-style hexadecimal float literals.
     */
    pub fn createFloatFromHex (int: [c8], frac: [c8], exp: [c8])-> &BigFloat {
        let intPartV = copy BigFloat (copy BigInt (std::conv::to!{usize, 16us} (int)));
        let decPartV = copy BigFloat ((copy BigInt (std::conv::to!{usize, 16us} (frac)))) * (copy BigFloat (16.0) ^^ -cast!i64 (frac.len));
        let expPartV = if (exp [0] == '-'c8) {
            copy BigFloat (2.0) ^^ -std::conv::to!{i64} (exp[1 .. $])
        } else {
            copy BigFloat (2.0) ^^ std::conv::to!{i64} (exp)
        };

        (intPartV + decPartV) * expPartV
    } catch {
        _ => panic;
    }

}
