in bool_;

use ymirc::semantic::generator::{_, value::_, type::_};
use ymirc::global;

use ymirc::semantic::validator::errors;
use ymirc::errors::message;

use ymirc::utils::{format, bigfloat, bigint};
use ymirc::lexing::{word, keys};


/*
 * Compile-time reduction logic for boolean operators.
 *
 * This module implements the reduction pipeline for all boolean-related
 * operators encountered during semantic validation. Supported operations:
 *
 *   • comparison operators (==, !=)
 *   • logical operators (&&, ||)
 *   • unary logical negation (!)
 *
 * Reduction strategy:
 *   - Operands are reduced using `reduceInOperator`, which performs lazy,
 *     context-aware compile-time evaluation.
 *   - When both operands are BoolValue literals, full CTE evaluation is
 *     performed.
 *   - When only one operand is literal, partial-evaluation rules are applied
 *     (e.g., true || x -> true, false && x -> false).
 *   - When no reduction is possible, the operator is reconstructed with
 *     reduced operands.
 *
 * Special handling:
 *   - Logical operators implement short-circuit semantics during reduction.
 *   - Comparison operators only support == and != for booleans.
 *   - Literal folding is performed when both operands reduce to identical
 *     values.
 *
 */
pub mod BoolInterpret {

    /**
     * Reduces a boolean comparison operator.
     *
     * Attempts a full CTE reduction by delegating to the internal comparison
     * routine. If reduction succeeds, the resulting BoolValue is returned.
     * Otherwise, the operator is reconstructed with reduced operands.
     *
     * Parameters:
     *   - context: the compile-time interpreter instance.
     *   - bin:     the comparison operator.
     *
     * Returns:
     *   A BoolValue when reduction succeeds, or a reduced CmpBoolOperatorValue.
     */
    pub fn reduceCmp (dmut context: &CompileTimeInterpreter, bin: &CmpBoolOperatorValue)-> &Value
        throws ErrorMsg
    {
        if let Ok (value) = BoolInterpret::reduceCmp (alias context, bin.loc, bin.op, bin.left, bin.right) {
            return value;
        }

        let resLeft = context:.reduce (bin.left);
        let resRight = context:.reduce (bin.right);
        
        return copy CmpBoolOperatorValue (bin.loc,
                                          bin.op,
                                          resLeft,
                                          resRight,
                                          isReduced-> true);
    }

    /**
     * Attempts to reduce a boolean comparison.
     *
     * Steps:
     *   1. Reduce both operands using `reduceInOperator`.
     *   2. If both operands are BoolValue literals:
     *        - evaluate == and !=
     *   3. If both operands reduce to identical literals, return the known result.
     *   4. Otherwise, return `none` to signal that no reduction is possible.
     *
     * Returns:
     *   A BoolValue wrapped in `Ok` when reduction succeeds, or `none`.
     */
    pub fn reduceCmp (dmut context: &CompileTimeInterpreter, loc: &Word, op: BinaryOperators, bleft: &Value, bright: &Value)-> (&Value?)
        throws ErrorMsg
    {
        let left = context:.reduceInOperator (bleft, checkCte-> false);
        let right = context:.reduceInOperator (bright, checkCte-> false);
        
        if let (l: &BoolValue, r: &BoolValue) = (left, right) {
            match op {
                BinaryOperators::NOT_EQUAL => { return (copy BoolValue (loc, l.isTrue != r.isTrue))?; }
                BinaryOperators::DEQUAL    => { return (copy BoolValue (loc, l.isTrue == r.isTrue))?; }
                _ => panic;            
            }
        }

        let resLeft = context:.reduce (bleft);
        let resRight = context:.reduce (bright);
        if (resLeft is resRight) || (resLeft.isFullLiteral && resRight.isFullLiteral && resLeft == resRight) {
            match op {
                BinaryOperators::NOT_EQUAL => { return (copy BoolValue (loc, false))?; }
                BinaryOperators::DEQUAL    => { return (copy BoolValue (loc, true))?; }
            }
        }
        
        return none;
    }

    /**
     * Reduces a boolean logical operator (&&, ||).
     *
     * Steps:
     *   1. Reduce both operands using `reduceInOperator`.
     *   2. If both operands are BoolValue literals:
     *        - evaluate && and ||
     *   3. If only the left operand is literal:
     *        - true  || x -> true
     *        - false || x -> x
     *        - false && x -> false
     *        - true  && x -> x
     *   4. If only the right operand is literal:
     *        - x || true  -> true
     *        - x || false -> x
     *        - x && false -> false
     *        - x && true  -> x
     *   5. If both operands reduce to identical literals:
     *        - (a && a) -> a
     *        - (a || a) -> a
     *   6. Otherwise, reconstruct the operator with reduced operands.
     *
     * Notes:
     *   - Implements short-circuit semantics during reduction.
     *
     * Returns:
     *   A BoolValue when reduction succeeds, or a reduced LogicalBoolOperatorValue.
     */
    pub fn reduceLogic (dmut context: &CompileTimeInterpreter, bin: &LogicalBoolOperatorValue)-> &Value
        throws ErrorMsg
    {
        let left  = context:.reduceInOperator (bin.left,  checkCte-> false);
        let right = context:.reduceInOperator (bin.right, checkCte-> false);

        match (left, right) {
            (l: &BoolValue, r: &BoolValue) => {
                match bin.op {
                    BinaryOperators::DPIPE => { return copy BoolValue (bin.loc, l.isTrue || r.isTrue) }
                    BinaryOperators::DAND  => { return copy BoolValue (bin.loc, l.isTrue && r.isTrue) }
                    _ => panic;
                }
            }
            (l: &BoolValue, _) => { // only left is cte, but we can still say things without knowing right
                match bin.op {
                    BinaryOperators::DPIPE => {
                        if (l.isTrue) { // true || x => true
                            return copy BoolValue (bin.loc, true);
                        } else { // false || x => x
                            return context:.reduce (bin.right);
                        }
                    }
                    BinaryOperators::DAND => {
                        if (!l.isTrue) { // false && x => false
                            return copy BoolValue (bin.loc, false);
                        } else { // true && x => x
                            return context:.reduce (bin.right);
                        }
                    }
                }
            }
            (_, r: &BoolValue) => {
                match bin.op {
                    BinaryOperators::DPIPE => {
                        if (r.isTrue) { // x || true => true
                            return copy BoolValue (bin.loc, true);
                        } else { // x || false => x
                            return context:.reduce (bin.left);
                        }
                    }
                    BinaryOperators::DAND => {
                        if (!r.isTrue) { // x && false => false
                            return copy BoolValue (bin.loc, false);
                        } else { // x && true => x
                            return context:.reduce (bin.left);
                        }
                    }
                }
            }
        }

        let resLeft = context:.reduce (bin.left);
        let resRight = context:.reduce (bin.right);
        if (resLeft is resRight) || (resLeft.isFullLiteral && resRight.isFullLiteral && resLeft == resRight) {
            return resLeft; // (a && a) == a and (a || a) == a
        }

        return copy LogicalBoolOperatorValue (bin.loc,
                                              bin.op,
                                              resLeft,
                                              resRight,
                                              isReduced-> true);
    }

    /**
     * Reduces a unary boolean operator.
     *
     * Supported operation:
     *   - logical negation (!)
     *
     * Steps:
     *   1. Reduce the operand using `reduceInOperator`.
     *   2. If the operand is a BoolValue literal and the operator is NOT:
     *        - return the negated literal
     *   3. Otherwise, reconstruct the unary operator with a fully reduced operand.
     *
     * Returns:
     *   A BoolValue when reduction succeeds, or a reduced UnaryOperatorValue.
     */
    pub fn reduceUnary (dmut context: &CompileTimeInterpreter, un: &UnaryOperatorValue)-> &Value
        throws ErrorMsg
    {
        let content = context:.reduceInOperator (un.value, checkCte-> false);        
        if let v: &BoolValue = content && un.op == UnaryOperators::NOT {
            return copy BoolValue (un.loc, !v.isTrue);            
        }
        
        return copy UnaryOperatorValue (loc-> un.loc,
                                        type-> un.type,
                                        op-> un.op,
                                        value-> context:.reduce (un.value),
                                        isReduced-> true);
    }
    
}
