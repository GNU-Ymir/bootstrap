 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in intrinsic;

use ymirc::errors;
use ymirc::lexing::word;
use ymirc::semantic::symbol;
use ymirc::semantic::generator::{type::_, value::_};

extern (C) fn _yrt_string_to_f32(s: [c8], ref mut succ: bool)-> f32;
extern (C) fn _yrt_string_to_f64(s: [c8], ref mut succ: bool)-> f64;

/**
 * The compile-time implementations of the functions of the runtime.
 */
pub mod CompileTimeIntrinsics {

    /**
     * Executes the call of a function of the runtime.
     *
     * @params:
     *   - interpret: the compile-time interpreter
     *   - loc: the location of the call
     *   - func: the called function
     *   - type: the type of the call
     *   - args: the literal arguments of the call
     *
     * @returns: the result of the call and the values of its arguments once it returns,
     *           none if the function has no compile-time implementation
     * @throws: ErrorMsg if an argument is not of the expected literal
     */
    pub fn execute(dmut interpret: &CompileTimeInterpret, loc: &Word, func: &FunctionSymbol, type: &Type, args: [&Value])-> ((&Value, [&Value]))?
        throws ErrorMsg
    {
        let name = func.decl.name.str;
        if (name == "_yrt_string_to_f32") {
            return inner::stringToFloat(alias interpret, loc, type, args, 32u16);
        } else if (name == "_yrt_string_to_f64") {
            return inner::stringToFloat(alias interpret, loc, type, args, 64u16);
        }

        none
    }

}

mod inner {

    /**
     * Parses a float of `size` bits, `_yrt_string_to_f*(s: [c8], ref mut succ: bool)`.
     * @returns: the parsed float, and `succ` set to whether the string is a valid float
     */
    pub fn stringToFloat(dmut interpret: &CompileTimeInterpret, loc: &Word, type: &Type, args: [&Value], size: u16)-> ((&Value, [&Value]))?
        throws ErrorMsg
    {
        let fT = if let f: &FloatType = type { f } else { return none; };
        if (args.len != 2us || args[0] !of StringValue) return none;

        let str = interpret:.decodeString(args[0]);
        let mut succ = false;
        let value = if (size == 32u16) {
            copy FloatValue(loc, fT, _yrt_string_to_f32(str, ref succ))
        } else {
            copy FloatValue(loc, fT, _yrt_string_to_f64(str, ref succ))
        };

        return ((value, copy [args[0], copy BoolValue(loc, succ)]))?;
    }

}
