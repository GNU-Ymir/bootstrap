in range;

use ymirc::semantic::generator::{_, value::_, type::_};
use ymirc::global;

use ymirc::semantic::validator::errors;
use ymirc::errors::message;

use ymirc::utils::{format, bigint};
use ymirc::lexing::{word, keys};


/** 
 * Provides reduction logic for range-membership operators. The reducer attempts
 * full constant folding when both the tested value and the range bounds are
 * compile-time integers. When full folding is not possible, the reducer still
 * performs structural validation and reconstructs the operator with reduced
 * operands.
 *
 * Supported operators:
 *   - IN      (x in r)
 *   - NOT_IN  (x !in r)
 *
 * 
 */
pub mod RangeInterpret {

    /**
     * Reduces a range-membership operator.
     *
     * Steps:
     *   1. Reduce both operands with `reduceInStructAccess`.
     *   2. If the right operand is a RangeValue and the left is an IntValue,
     *      evaluate the membership test at compile time:
     *         - handles inclusive/exclusive bounds,
     *         - handles reversed ranges,
     *         - applies NOT_IN by negation.
     *
     *   3. If folding is not possible, rebuild the operator with reduced operands.
     *
     * Notes:
     *   - Performs minimal validation even when the range is not fully literal.
     *   - Only integer ranges are supported here - since range can only contain int values.
     *   
     */
    pub fn reduceContains (dmut context: &CompileTimeInterpreter, rng: &RangeContainsValue)-> &Value
        throws ErrorMsg
    {
        let left = context:.reduceInStructAccess (rng.left);
        let right = context:.reduceInStructAccess (rng.right);
        
        if let r: &RangeValue = right {
            let fstR = r.left;
            let scdR = r.right;
            let containsR = r.isFull;
            
            if let (x: &IntValue, fst: &IntValue, scd: &IntValue, contain: &BoolValue) = (left, fstR, scdR, containsR) {
                let res = if (contain.isTrue) {
                    if (fst.value < scd.value) {
                        x.value >= fst.value && x.value <= scd.value
                    } else {
                        x.value >= scd.value && x.value <= fst.value
                    }
                } else {
                    if (fst.value < scd.value) {
                        x.value >= fst.value && x.value < scd.value
                    } else {
                        x.value > scd.value && x.value <= fst.value
                    }
                };

                if (rng.op == Keys::NOT_IN) {
                    return copy BoolValue (rng.loc, !res)
                } else {
                    return copy BoolValue (rng.loc, res)
                };
            }
        }
        
        return copy RangeContainsValue (rng.loc,
                                        rng.type,
                                        rng.op,
                                        context:.reduce (rng.left),
                                        context:.reduce (rng.right),
                                        rng.call,
                                        isReduced-> true);
    }
    
}
