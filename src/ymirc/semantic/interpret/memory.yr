 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in memory;

use ymirc::lexing::{word, keys};

use ymirc::semantic::{symbol, interpret::_};
use ymirc::semantic::generator::{_, value::_, type::_};

use ymirc::errors::message;
use ymirc::utils::{format, bigint, bigfloat};

use std::io;

/**
 * MemoryInterpret
 *
 * Provides reduction routines for memory-related generator values:
 *   - address-taking (&),
 *   - aliasing and map aliasing,
 *   - referencing and dereferencing,
 *   - lazy/future/copier/mover constructs.
 *
 * Most memory operators cannot be evaluated at compile time, but their
 * operands may still be reduced. Aliasing operators attempt constant folding
 * when the referenced value is a compile-time constant.
 */
pub mod MemoryInterpret {

    /**
     * Dispatches memory-related values to their corresponding reducers.
     *
     * Handles:
     *   - AddressValue
     *   - AliaserValue / MapAliaserValue
     *   - ClassAliaserValue
     *   - CopierValue / MoverValue
     *   - ReferencerValue / DereferencerValue
     *   - LazyValue / FutureValue / ExpandValue
     *
     * Returns the reduced value or the original node when no reduction applies.
     * 
     */
    pub fn reduce (dmut context: &CompileTimeInterpreter, mem: &MemoryValue)-> &Value
        throws ErrorMsg
    {
        match mem {
            a: &AddressValue      => { return reduceAddress (alias context, a); }
            a: &AliaserValue      => { return reduceAliaser (alias context, a); }        
            c: &ClassAliaserValue => { return c; }
            c: &CopierValue       => { return c; }
            d: &DereferencerValue => { return d; }
            e: &ExpandValue       => { return e; }
            f: &FutureValue       => { return f; }
            l: &LazyValue         => { return l; }
            m: &MoverValue        => { return m; }
            r: &ReferencerValue   => { return r; }
            
            _ => {
                eprintln ("internal memory interpret error : ", mem._typeinfo.name);
                panic;    
            }
            
        }
        
    }

    /**
     * Reduces an address-taking operation (&value).
     *
     * The operand is reduced normally; the address operator itself is preserved
     * and marked as reduced.
     */
    fn reduceAddress (dmut context: &CompileTimeInterpreter, addr: &AddressValue)-> &Value
        throws ErrorMsg
    {        
        let inner = context:.reduce (addr.value);

        return copy AddressValue (addr.loc,
                                  addr.type,
                                  inner,
                                  isReduced-> true);
        
    }

    /**
     * Reduces an aliasing operation.
     *
     * Attempts to fold the aliaser when the referenced value is a compile-time
     * constant. Otherwise, rebuilds the aliaser with a reduced operand.
     *
     * Map aliasers are delegated to `reduceMapAliaser`.
     * 
     */
    fn reduceAliaser (dmut context: &CompileTimeInterpreter, al: &AliaserValue)-> &Value
        throws ErrorMsg
    {        
        if let m: &MapAliaserValue = al { 
            return reduceMapAliaser (alias context, m);
        }
        
        let inner = context:.reduceInOperator (al.value, checkCte-> false);
        if (context.isCte (inner)) {
            return copy AliaserValue (al.loc,
                                      al.type,
                                      inner,
                                      isReduced-> true);
            
        } else {
            return copy AliaserValue (al.loc,
                                      al.type,
                                      context:.reduce (al.value),
                                      isReduced-> true);            
        }
    }

    /**
     * Reduces a map aliaser.
     *
     * Similar to normal aliasers, but preserves the MapType information.     
     * Folds the aliaser when the referenced map is a compile-time constant.
     * 
     */
    fn reduceMapAliaser (dmut context: &CompileTimeInterpreter, m: &MapAliaserValue)-> &Value
        throws ErrorMsg
    {
        let mtype = if let mt: &MapType = m.type { mt } else { panic; };
        
        let inner = context:.reduceInOperator (m.value, checkCte-> false);
        if (context.isCte (inner)) {
            return copy MapAliaserValue (m.loc,
                                         mtype,
                                         inner,
                                         isReduced-> true);
            
        } else {
            return copy MapAliaserValue (m.loc,
                                         mtype,
                                         context:.reduce (m.value),
                                         isReduced-> true);            
        }
        
    }
}
