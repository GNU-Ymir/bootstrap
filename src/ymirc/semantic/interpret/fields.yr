in fields;


use ymirc::lexing::{word, keys};

use ymirc::semantic::symbol;
use ymirc::semantic::generator::{_, value::_, type::_};

use ymirc::errors::message;
use ymirc::utils::bigint;

use std::io;

/**
 * Compile-time reduction logic for field-access operators.
 *
 * This module implements the reduction pipeline for all field-access
 * expressions encountered during semantic validation. Field access is one of
 * the most polymorphic operator families in the language: depending on the type
 * of the base expression, a field access may refer to:
 *
 *   • class instance fields,
 *   • class type-info fields,
 *   • enum payloads,
 *   • map metadata (e.g., length),
 *   • option state (set/value/error),
 *   • struct fields (including struct literals),
 *   • range fields (fst, scd, step, contains),
 *   • slice fields (ptr, len),
 *   • tuple fields (by index),
 *   • closure and future metadata.
 *
 * Reduction strategy:
 *   - The base expression is reduced either through `reduce` or
 *     `reduceInOperator`, depending on the context.
 *   - When the base expression is a compile-time literal (struct literal,
 *     tuple literal, option literal, range literal, slice literal, etc.),
 *     the field access may be folded to a literal value.
 *   - When reduction is not possible, the field-access operator is
 *     reconstructed with reduced operands and marked as reduced.
 *
 * Special handling:
 *   - Option, Range, Slice, and Struct field accesses have dedicated
 *     reduction paths that inspect literal values and apply CTE rules.
 *   - Tuple field access supports both direct literal extraction and
 *     reduction through `reduceInStructAccess`.
 *   - Map length access reduces to an integer literal when the map is known.
 *
 * This module is invoked by the operator interpreter whenever a field-access
 * operator is encountered.
 */
pub mod FieldInterpret { 

    /**
     * Reduces a field-access operator.
     *
     * Dispatches to the appropriate reduction routine based on the concrete
     * operator class. Each field-access type has its own reduction logic.
     *
     * Parameters:
     *   - context:     the compile-time interpreter instance.
     *   - f:           the field-access operator to reduce.
     *   - inOperator:  whether the reduction occurs inside an operator evaluation.
     *
     * Returns:
     *   A reduced Value corresponding to the field access.
     *
     * Notes:
     *   - Literal folding is performed when the base expression is a known
     *     compile-time value.
     *   - When no reduction is possible, the operator is reconstructed with
     *     reduced operands.
     */
    pub fn reduce (dmut context: &CompileTimeInterpret, f: &FieldOperatorValue, inOperator: bool)-> &Value
        throws ErrorMsg
    {
        return inner::reduceField (alias context, f, inOperator);
    }

}

mod inner {

    /**
     * Reduces a field-access operator.          
     *
     * Parameters:
     *   - context:     the compile-time interpreter instance.
     *   - f:           the field-access operator to reduce.
     *   - inOperator:  whether the reduction occurs inside an operator evaluation.
     *
     * Returns:
     *   A reduced Value corresponding to the field access.
     *   
     */
    pub fn reduceField (dmut context: &CompileTimeInterpret, f: &FieldOperatorValue, inOperator: bool)-> &Value
        throws ErrorMsg
    {
        match f {
            c: &ClassFieldAccessValue    => { return inner::reduceClassField (alias context, c, inOperator);  }
            c: &ClassTypeInfoAccessValue => { return inner::reduceClassTi (alias context, c, inOperator); }            
            e: &EnumFieldAccessValue     => { return inner::reduceEnumField (alias context, e, inOperator); }            
            m: &MapLenAccessValue        => { return inner::reduceMapLen (alias context, m, inOperator); }
            o: &OptionFieldAccessValue   => { return inner::reduceOptionField (alias context, o, inOperator); }
            s: &StructFieldAccessValue   => { return inner::reduceStructField (alias context, s, inOperator); }
            t: &TupleFieldAccessValue    => { return inner::reduceTupleField (alias context, t, inOperator); }

            c: &ClosureFieldAccessValue  => { return c; }
            u: &FutureFieldAccessValue   => { return u; }
            _ => {
                eprintln ("internal operator interpret error : ", f._typeinfo.name);
                panic;
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          CLASS          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */    

    /**
     * Reduces a class-instance field access.
     *
     * The base object is reduced using either `reduce` or `reduceInOperator`
     * depending on the context. No literal folding is performed for class
     * instances; the field-access operator is simply reconstructed with the
     * reduced object.
     * 
     */
    fn reduceClassField (dmut context: &CompileTimeInterpret, c: &ClassFieldAccessValue, inOperator: bool)-> &Value
        throws ErrorMsg
    {
        let obj = if inOperator {
            context:.reduceInOperator (c.object, checkCte-> false)
        } else {
            context:.reduce (c.object)
        };

        return copy ClassFieldAccessValue (c.loc,
                                           c.type,
                                           obj,
                                           c.name,
                                           isReduced-> true);
    }    

    /**
     * Reduces a class type-info field access.
     *
     * Similar to class-instance field access, but applied to type-info objects.
     * No literal folding is performed.
     * 
     */
    fn reduceClassTi (dmut context: &CompileTimeInterpret, c: &ClassTypeInfoAccessValue, inOperator: bool)-> &Value
        throws ErrorMsg
    {
        let obj = if inOperator {
            context:.reduceInOperator (c.object, checkCte-> false)
        } else {
            context:.reduce (c.object)
        };

        return copy ClassTypeInfoAccessValue (c.loc,
                                              c.type,
                                              obj,                                           
                                              isReduced-> true);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          ENUM          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Reduces an enum field access.
     *
     * The enum payload is reduced. When inside an operator, the payload itself
     * is returned directly. Otherwise, the field-access operator is
     * reconstructed.
     *
     * Enum field access is only valid when the target type is an EnumType.
     * 
     */
    fn reduceEnumField (dmut context: &CompileTimeInterpret, e: &EnumFieldAccessValue, inOperator: bool)-> &Value
        throws ErrorMsg
    {
        let obj = context:.reduce (e.value);
        if inOperator {
            return obj;
        }

        if let en: &EnumType = e.type {
            return copy EnumFieldAccessValue (e.loc,
                                              en,
                                              obj,
                                              e.name,
                                              isReduced-> true);
        }

        panic;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          MAP          =======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Reduces a map length access.
     *
     * If the base expression reduces to a MapValue, the length is folded into
     * an IntValue literal. Otherwise, the operator is reconstructed with the
     * reduced object.
     * 
     */
    fn reduceMapLen (dmut context: &CompileTimeInterpret, m: &MapLenAccessValue, inOperator: bool)-> &Value
        throws ErrorMsg
    {
        let obj = if inOperator {
            context:.reduceInOperator (m.object, checkCte-> false)
        } else {
            context:.reduce (m.object)
        };

        if let v: &MapValue = obj {
            if let ty: &IntType = m.type {
                return copy IntValue (m.loc, ty, copy BigInt (v.keys.len));
            }
        }

        return copy MapLenAccessValue (m.loc,
                                       m.type,
                                       obj,
                                       isReduced-> true);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          OPTIONS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */    

    /**
     * Reduces an option field access.
     *
     * Two passes are performed:
     *   1. A direct reduction of the base object.
     *   2. A reduction through `reduceInStructAccess`, which may expose additional
     *      literal structure.
     *
     * Depending on whether the option is a `Ok` or `Err`, the appropriate
     * helper (`reduceOptionFieldValue` or `reduceOptionFieldError`) is used.
     *
     * Literal folding is performed when the option value is known and CTE rules
     * allow it.
     * 
     */
    fn reduceOptionField (dmut context: &CompileTimeInterpret, o: &OptionFieldAccessValue, inOperator: bool)-> &Value
        throws ErrorMsg
    {
        let object = context:.reduce (o.object);
        let mut defResult: &Value = copy OptionFieldAccessValue (loc-> o.loc,
                                                                 type-> o.type,
                                                                 object-> object,
                                                                 name-> o.name,
                                                                 isReduced-> true);
        match object {
            r: &OptionValue => {
                defResult = inner::reduceOptionFieldValue (context, r, o.name, defResult, false);
            }
            e: &ErrOptionValue => {
                defResult = inner::reduceOptionFieldError (context, e, o.name, defResult, false);
            }
        }

        let box = context:.reduceInStructAccess (o.object);
        match box {
            r: &OptionValue => {
                defResult = inner::reduceOptionFieldValue (context, r, o.name, defResult, !inOperator);
            }
            e: &ErrOptionValue => {
                defResult = inner::reduceOptionFieldError (context, e, o.name, defResult, !inOperator);
            }
        }

        return defResult;
    }

    /**
     * Reduces a field access on a `Ok` option value.
     *
     * Supported fields:
     *   - SET       -> true
     *   - HAS_ERROR -> false
     *   - VALUE     -> the contained value
     *
     * When `checkCte` is true, folding occurs only if the result is a CTE value.
     * 
     */
    fn reduceOptionFieldValue (context: &CompileTimeInterpret, opt: &OptionValue, field: [c8], or: &Value, checkCte: bool)-> &Value {
        let res = match field {
            OptionKeys::SET       => { copy BoolValue (opt.loc, true) }
            OptionKeys::HAS_ERROR => { copy BoolValue (opt.loc, false) }
            OptionKeys::VALUE     => { opt.value }
            _ => {
                or
            }
        };

        if (checkCte && context.isCte (res)) return or;
        return res;
    }        

    /**
     * Reduces a field access on an `Err` option value.
     *
     * Supported fields:
     *   - SET       -> false
     *   - HAS_ERROR -> whether the error is non-null
     *   - ERROR     -> the error value
     *
     * When `checkCte` is true, folding occurs only if the result is a CTE value.
     * 
     */
    fn reduceOptionFieldError (context: &CompileTimeInterpret, opt: &ErrOptionValue, field: [c8], or: &Value, checkCte: bool)-> &Value {
        let res = match field {
            OptionKeys::SET       => { copy BoolValue (opt.loc, false) }
            OptionKeys::HAS_ERROR => { copy BoolValue (opt.loc, opt.err !of NullValue) }
            OptionKeys::ERROR     => { opt.err }
            _ => {
                or
            }
        };

        if (checkCte && context.isCte (res)) return or;
        return res;
    }        

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          STRUCT          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Reduces a struct field access.
     *
     * Special cases:
     *   - OptionType  -> delegated to option reduction
     *   - RangeType   -> delegated to range reduction
     *   - SliceType   -> delegated to slice reduction
     *
     * Otherwise, reduction is performed through `reduceStructFieldImpl`.
     * 
     */
    fn reduceStructField (dmut context: &CompileTimeInterpret, s: &StructFieldAccessValue, inOperator: bool)-> &Value
        throws ErrorMsg
    {
        if s.object.type of OptionType {
            let opt = copy OptionFieldAccessValue (s.loc, s.type, s.object, s.name, isReduced-> false);
            return inner::reduceOptionField (alias context, opt, inOperator);            
        }

        if s.object.type of RangeType {
            return inner::reduceRangeField (alias context, s, inOperator);
        }

        if s.object.type of SliceType {
            return inner::reduceSliceField (alias context, s, inOperator);            
        }        

        return inner::reduceStructFieldImpl (alias context, s, inOperator);        
    }

    /**
     * Reduces a struct field access on a struct literal or copier.
     *
     * Two passes are performed:
     *   1. Reduction of the base object.
     *   2. Reduction through `reduceInStructAccess`, which may expose additional
     *      literal structure.
     *
     * Literal folding is performed when the struct literal contains the field and
     * CTE rules allow it.
     * 
     */
    fn reduceStructFieldImpl (dmut context: &CompileTimeInterpret, s: &StructFieldAccessValue, inOperator: bool)-> &Value
        throws ErrorMsg
    {
        let object = context:.reduce (s.object);
        let mut defResult: &Value = copy StructFieldAccessValue (loc-> s.loc,
                                                                 type-> s.type,
                                                                 object-> object,
                                                                 name-> s.name,
                                                                 isReduced-> true);

        match object {
            r: &StructInitValue => {
                defResult = inner::reduceStructFieldInit (context, r, s.name, defResult, false);
            }
            c: &CopierValue => {
                match c.value {
                    r: &StructInitValue => {
                        defResult = inner::reduceStructFieldInit (context, r, s.name, defResult, false);
                    }
                }
            }
        }

        match context:.reduceInStructAccess (s.object) {
            r: &StructInitValue => {
                defResult = inner::reduceStructFieldInit (context, r, s.name, defResult, !inOperator);
            }
            c: &CopierValue => {
                match c.value {
                    r: &StructInitValue => {
                        defResult = inner::reduceStructFieldInit (context, r, s.name, defResult, !inOperator);
                    }
                }
            }
        }

        return defResult;
    }

    /**
     * Attempts to extract a field from a StructInitValue literal.
     *
     * If the field exists and either:
     *   - `checkCte` is false, or
     *   - the field value is a CTE value,
     * then the literal field value is returned.
     *
     * Otherwise, the fallback value (`or`) is returned.
     * 
     */
    fn reduceStructFieldInit (context:  &CompileTimeInterpret,
                              v:        &StructInitValue,
                              acc:      [c8],
                              or:       &Value,
                              checkCte: bool)-> & Value {
        
        for i, f in v.fields if f == acc {
            if (!checkCte || context.isCte (v.values [i])) {
                return v.values [i];            
            }
        }

        return or;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          RANGE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Reduces a range field access on a range literal or copier.
     *
     * Two passes are performed:
     *   1. Reduction of the base object.
     *   2. Reduction through `reduceInStructAccess`, which may expose additional
     *      literal rangeure.
     *
     * Literal folding is performed when the range literal contains the field and
     * CTE rules allow it.
     * 
     */
    fn reduceRangeField (dmut context: &CompileTimeInterpret, s: &StructFieldAccessValue, inOperator: bool)-> &Value
        throws ErrorMsg
    {
        let object = context:.reduce (s.object);
        let mut defResult: &Value = copy StructFieldAccessValue (loc-> s.loc,
                                                                 type-> s.type,
                                                                 object-> object,
                                                                 name-> s.name,
                                                                 isReduced-> false);
        match object {
            r: &RangeValue => {
                defResult = inner::reduceRangeFieldValue (context, r, s.name, defResult, false);
            }
            c: &CopierValue => {
                match c.value {
                    r: &RangeValue => {
                        defResult = inner::reduceRangeFieldValue (context, r, s.name, defResult, false);
                    }
                }
            }
        }


        let box = context:.reduceInStructAccess (s.object);
        match box {
            r: &RangeValue => {
                defResult = inner::reduceRangeFieldValue (context, r, s.name, defResult, !inOperator);
            }
            c: &CopierValue => {
                match c.value {
                    r: &RangeValue => {
                        defResult = inner::reduceRangeFieldValue (context, r, s.name, defResult, !inOperator);
                    }
                }
            }
        }

        return defResult;
    }

    /**
     * Reduces a field access on a range value.
     *
     * Supported fields:
     *   - FST       -> left bound
     *   - SCD       -> right bound
     *   - CONTAINS  -> full-range flag
     *   - STEP      -> step value
     *
     * Literal folding is performed when the base expression is a RangeValue or a
     * copier wrapping a RangeValue.
     * 
     */
    fn reduceRangeFieldValue (context:  &CompileTimeInterpret,
                              rng:      &RangeValue,
                              field:    [c8],
                              or:       &Value,
                              checkCte: bool)-> &Value {
        let res = match field {
            RangeKeys::FST => { rng.left }
            RangeKeys::SCD => { rng.right }
            RangeKeys::CONTAINS => { rng.isFull }
            RangeKeys::STEP => { rng.step }
            _ => {
                or
            }
        };

        if (checkCte && !context.isCte (res)) return or;
        return res;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          SLICE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Reduces a slice field access on a slice literal or copier.
     *
     * Two passes are performed:
     *   1. Reduction of the base object.
     *   2. Reduction through `reduceInStructAccess`, which may expose additional
     *      literal sliceure.
     *
     * Literal folding is performed when the slice literal contains the field and
     * CTE rules allow it.
     * 
     */
    fn reduceSliceField (dmut context: &CompileTimeInterpret, s: &StructFieldAccessValue, inOperator: bool)-> &Value
        throws ErrorMsg
    {
        let object = context:.reduce (s.object);
        let mut defResult: &Value = copy StructFieldAccessValue (loc-> s.loc,
                                                                 type-> s.type,
                                                                 object-> object,
                                                                 name-> s.name,
                                                                 isReduced-> false);
        match object {
            r: &SliceCtorValue => {
                defResult = inner::reduceSliceFieldValue (context, r, s.name, defResult, false);
            }
            c: &CopierValue => {
                match c.value {
                    r: &SliceCtorValue => {
                        defResult = inner::reduceSliceFieldValue (context, r, s.name, defResult, false);
                    }
                }
            }
        }

        let mut box = context:.reduceInStructAccess (s.object);
        if let bl: &BlockValue = box && s.name == SliceKeys::LEN && bl.values.len > 0 {
            box = bl.values [$ - 1];
        }

        match box {
            r: &SliceCtorValue => {
                defResult = inner::reduceSliceFieldValue (context, r, s.name, defResult, !inOperator);
            }
            c: &CopierValue => {
                match c.value {
                    r: &SliceCtorValue => {
                        defResult = inner::reduceSliceFieldValue (context, r, s.name, defResult, !inOperator);
                    }
                }
            }
        }

        return defResult;
    }

    /**
     * Reduces a field access on a slice value.
     *
     * Supported fields:
     *   - PTR -> pointer to the slice data
     *   - LEN -> length of the slice
     *
     * Literal folding is performed when the base expression is a SliceCtorValue
     * or a copier wrapping one. Special handling is applied for LEN when the
     * reduced value is a block.
     * 
     */
    fn reduceSliceFieldValue (context:  &CompileTimeInterpret,
                              slc:      &SliceCtorValue,
                              field:    [c8],
                              or:       &Value,
                              checkCte: bool)-> &Value
    {
        let res = match field {
            SliceKeys::PTR => { return slc.ptr }
            SliceKeys::LEN => { return slc.len }
            _ => {
                or
            }
        };

        if (checkCte && !context.isCte (res)) return or;
        return res;
    }
    
    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          TUPLE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Reduces a tuple field access.
     *
     * Two reduction attempts are made:
     *   1. Through `reduceInStructAccess`, which may expose tuple literals.
     *   2. Through normal reduction of the base object.
     *
     * If the tuple literal contains the requested index and either:
     *   - we are inside an operator, or
     *   - the element is a CTE value,
     * then the element is returned directly.
     *
     * Otherwise, the field-access operator is reconstructed.
     * 
     */
    fn reduceTupleField (dmut context: &CompileTimeInterpret, t: &TupleFieldAccessValue, inOperator: bool)-> &Value
        throws ErrorMsg
    {
        if let lit: &TupleValue = context:.reduceInStructAccess (t.object) && lit.values.len > t.index {        
            if (inOperator || context.isCte (lit.values [t.index])) {
                return lit.values [t.index];            
            }
        }
        
        let object = context:.reduce (t.object);
        if let lit: &TupleValue = object && lit.values.len > t.index {
            return lit.values [t.index];
        }
        
        return copy TupleFieldAccessValue (loc-> t.loc,
                                           type-> t.type,
                                           object-> object,
                                           index-> t.index,
                                           isReduced-> true);
    }
    
    
}
