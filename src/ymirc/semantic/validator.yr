pub def EnumValidation   = symbol::enum_::EnumValidation;
pub def ClassValidation  = symbol::class_::ClassValidation;
pub def TraitValidation  = symbol::trait_::TraitValidation;
pub def GlobalVarValidation = symbol::global::GlobalVarValidation;

pub def FunctionValidation = symbol::function::basic::FunctionValidation;
pub def MethodValidation   = symbol::function::method::MethodValidation;
pub def LambdaValidation   = symbol::function::lambda::LambdaValidation;




