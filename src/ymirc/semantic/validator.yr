 */

pub def ScopeValidation = verif::scope::ScopeValidation;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =================================          EXPORTED CLASS          =================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub def ValidationContext: context::root::ValidationContext;
pub def DefContext:        context::def_::DefContext;
pub def ClassContext:      context::class_::ClassContext;
pub def LambdaContext:     context::lambda::LambdaContext;
pub def RecursiveContext:  context::recursive::RecursiveContext;
pub def TemplateContext:   context::template_::TemplateContext;

pub def CLASS_MAX_RECURSIVE_LEVEL = context::class_::MAX_RECURSIVE_LEVEL;

pub def DeclaredVars: context::scope::DeclaredVars;
pub def UsedVars: context::scope::UsedVars;

pub def Scores: scores::Scores;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ==================================          LIST HELPERS          ==================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub def ScopeList:      List!{dmut &(context::scope::DeclaredVars)};
pub def UsedList:       List!{dmut &(context::scope::UsedVars)};
pub def TypeList:       List!{&Type};
pub def ValueList:      List!{&Value};
pub def BoolList:       List!{bool};
pub def WordList:       List!{&Word};
pub def ClosureList:    List!{dmut &ClosureType};
pub def ExpressionList: List!{&Expression};
pub def GeneratorList:  List!{&Generator};
pub def ErrorList:      List!{&ErrorMsg};
