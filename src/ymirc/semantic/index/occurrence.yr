in occurrence;

use ymirc::global::state;
use ymirc::lexing::word;
use ymirc::semantic::symbol;
use ymirc::semantic::generator::{type, value::_};
use ymirc::utils::format;

use std::stream;

/**
 * Whether a token declares the entity it names, or refers to it
 */
pub enum OccurrenceKind : [c8]
| DECLARATION = "decl"
| REFERENCE   = "ref"
;

/**
 * A token of the source naming an entity
 */
pub record Occurrence {

    pub {
        // The token naming the entity
        let loc: &Word;

        // Whether the token declares the entity, or refers to it
        let kind: OccurrenceKind;

        // The entity, when it is a symbol
        let symbol: &Symbol;

        // The declaration of the entity, when it is a local variable, a parameter or a field
        let decl: &Value;

        // What the token was validated to (a prototype, a type...), unit if nothing was
        let resolved: &Generator;

        // The token closing the block a local entity is declared in, EOF when unknown
        let scopeEnd: &Word;
    }

    /**
     * @params:
     *    - loc:    the token naming the entity
     *    - kind:   whether the token declares the entity, or refers to it
     *    - symbol: the entity, when it is a symbol
     *    - decl:   the declaration of the entity, when it is local
     *    - resolved: what the token was validated to
     *    - scopeEnd: the token closing the block a local entity is declared in
     */
    pub self (loc: &Word, kind: OccurrenceKind, symbol: &Symbol = EMPTY_SYMBOL, decl: &Value = UNIT_VALUE,
              resolved: &Generator = UNIT_VALUE, scopeEnd: &Word = EOF_WORD)
        with loc = loc
        , kind = kind
        , symbol = symbol
        , decl = decl
        , resolved = resolved
        , scopeEnd = scopeEnd
    {}

    /**
     * @returns: true iif the token covers the column `col` of the line `line`
     * of the file `file` (both counted from 1, as the tokens are)
     */
    pub fn covers(self, file: [c8], line: u64, col: u64)-> bool {
        self.loc.filename == file && self.loc.line == line && col >= self.loc.col && col < self.loc.col + cast!u64(self.loc.str.len)
    }

    /**
     * @returns: the token declaring the entity
     */
    pub fn declLoc(self)-> &Word {
        if (self.symbol !of EmptySymbol) { self.symbol.loc } else { self.decl.loc }
    }

    /**
     * @returns: true iif `o` names the same entity, that is one declared by the
     * same token (the instances of a template, a declaration validated again),
     * or the same one when it is declared outside of the files
     */
    pub fn isSameEntity(self, o: Occurrence)-> bool {
        if ((self.symbol of EmptySymbol) != (o.symbol of EmptySymbol)) return false;

        let decl = self.declLoc();
        if (decl.isEof || decl.filename == "") return self.symbol is o.symbol && self.decl is o.decl;
        decl.isSameLoc(o.declLoc())
    }

    /**
     * @returns: the type of the entity when it is local, none otherwise
     */
    pub fn localType(self)-> (&Type)? {
        match self.decl {
            v: &VarDeclValue      => return v.varType?;
            p: &ProtoVarDeclValue => return p.type?;
        }

        none
    }

    impl Streamable;
    impl Formattable {

        /**
         * Format the occurrence as:
         *     file:line:col kind token -> entity@line:col
         * a symbol being written by its path, a local entity by its name and
         * its type, at the position of their declaration.
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(state::relativePath(self.loc.filename), ":", self.loc.line, ":", self.loc.col, " ", self.kind, " ", self.loc.str, " -> ");
            if (self.symbol !of EmptySymbol) {
                stream:.write(self.symbol.path);
            } else {
                stream:.write(self.decl.loc.str);
            }

            let decl = self.declLoc();
            if (!decl.isEof) {
                stream:.write("@", decl.line, ":", decl.col);
            }

            if let Ok(t) = self.localType() {
                stream:.write(" : ", t);
            }
        }
    }
}
