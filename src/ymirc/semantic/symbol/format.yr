in format;

use ymirc::utils::format;

/**
 * Trait providing recursive symbol-tree formatting.
 *
 * AdvanceSymFormatting defines `formatSymTree`, a helper used by the Formatter
 * to print a symbol and its entire subtree. The output includes:
 *
 *   - the symbol's full name,
 *   - the list of imported modules(`use` and core modules),
 *   - all child symbols stored in the symbol table,
 *   - public/private visibility markers,
 *   - indentation reflecting the symbol hierarchy.
 *
 * This trait is mixed into Symbol so that any symbol can be printed as a
 * structured tree for debugging, diagnostics, or developer tooling.
 */
pub trait AdvanceSymFormatting {

    /**
     * Recursively format the symbol and its children as a tree.
     *
     * @params:
     *   - stream: the formatter used to write the output
     *
     * Behavior:
     *   - Prints the symbol's full name.
     *   - If the symbol imports modules(via `use` or core modules), prints them
     *     in a `use { ... }` block.
     *   - Indents and recursively prints all child symbols stored in the symbol
     *     table, marking public symbols with the `pub` prefix.
     *   - Each child symbol invokes its own `formatSymTree`, producing a complete
     *     hierarchical view of the symbol tree.
     *
     * This method is intended for debugging and introspection. It does not follow
     * protection rules; it prints the entire structure regardless of visibility.
     */
    pub fn formatSymTree(self, dmut stream: &Formatter) {
        let name = self._fullName.toStr();
        if (name != ""s8) {
            stream:.write(name);
        }

        if (self._used.len != 0us || self._coreModules.len != 0us) {
            stream:.write(" - use {"s8);
            let mut i = 0us;
            for v in self._used {
                if (i != 0us) stream:.write(", "s8);
                stream:.write(v.path.toStr());
                i += 1us;
            }

            for v in self._coreModules {
                if (i != 0us) stream:.write(", "s8);
                stream:.write(v.path.toStr());
                i += 1us;
            }
            stream:.write("}"s8);
        }

        if (name != ""s8) {
            stream:.write("\n"s8);
            stream:.entabing();
        }


        for n, v in self._table.content {
            for s in v {
                if (self._table.isPublic(n, s)) {
                    stream:.write("pub "s8);
                }

                s.formatSymTree(alias stream);
            }
        }

        if (name != ""s8) {
            stream:.detabing();
        }
    }

}
