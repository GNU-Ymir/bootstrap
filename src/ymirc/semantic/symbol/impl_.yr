in impl_;

use ymirc::utils::format;
use ymirc::lexing::word;

use ymirc::syntax::declaration::_;

use std::stream;

/**
 * Symbol representing an `impl` declaration.
 *
 * ImplSymbol is attached to an `ImplDecl` and is inserted into the symbol
 * table when an `impl` block appears inside a class or module. It stores only
 * the syntactic declaration; all semantic processing (method insertion,
 * trait resolution, validation) is handled elsewhere.
 *
 * ImplSymbol:
 *   - is always public,
 *   - is always strong (not weak), 
 *   - serves as a structural marker for the compiler.
 *   
 */
@final
pub class ImplSymbol over Symbol {

    pub {
        // The syntaxic impl
        let decl: &ImplDecl;
    }

    /**
     * Construct an ImplSymbol.
     *
     * @params:
     *   - loc:     source location of the `impl` declaration
     *   - comm:    documentation comments attached to the declaration
     *   - decl:    the syntactic `ImplDecl`
     *
     */
    pub self (loc:  &Word,
              comm: [c8],
              decl: &ImplDecl)
        
        with super (loc, comm, isWeak-> false, protection-> Protection::PUBLIC)
        , decl = decl
    {}

    impl Streamable;

}
