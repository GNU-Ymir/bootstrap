/*
 * Declares the SymbolList and ImutSymbolList class.
 *
 * These containers store sets of symbols while guaranteeing that each symbol
 * appears at most once. They provide two variants:
 *
 *   - SymbolList:     stores deeply mutable symbol references,
 *   - ImutSymbolList: stores immutable symbol references.
 *
 * Both classes expose a mutable interface for inserting symbols, but differ in
 * how symbols are stored internally. SymbolList uses a mutable hashset of
 * mutable references, while ImutSymbolList uses a hashset of immutable
 * references.
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::semantic::symbol::sym_list
 * @File: ymirc/semantic/symbol/sym_list.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *   - Emile Cadorel <emile.cadorel@davidson.fr>
 *
 * @Created (YYYY-MM-DD): 2023-02-15
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in sym_list;

use std::stream;

/**
 * A mutable list of symbols ensuring uniqueness.
 *
 * SymbolList stores mutable references to symbols and guarantees that each
 * symbol appears at most once. Internally, it uses a hashset keyed by the
 * symbol reference itself, allowing O(1) insertion and lookup.
 *
 * The list is mutable, but the symbols it contains are also deeply mutable,
 * making this class suitable for semantic passes that modify symbol state.
 */
@final
pub class SymbolList {

    prv {
        // The hashset to make sure the symbols appears only once    
        let dmut _set: [&Symbol => &Symbol] = copy [];
    }
    
    /**
     * Create an empty SymbolList.
     */

    pub self () {}
    
    /**
     * Insert a symbol into the list.
     *
     * @params:
     *   - sym: the symbol to insert
     *
     * If the symbol is already present, the list is unchanged. Uniqueness is
     * enforced by the underlying hashset.
     */
    pub fn insert (mut self, dmut sym: &Symbol) {
        self._set [sym] = alias sym;        
    }

    /**
     * @returns a mutable array of the symbols contained in the list.
     *
     * The returned array is a copy of the hashset contents. Modifying the
     * returned array does not affect the list.
     */
    pub fn opIndex (mut self)-> dmut [&Symbol] {
        copy [alias s for _, dmut s in alias self._set]        
    }

    /**
     * @returns a const array of the symbols contained in the list.
     *
     * The returned array is a copy of the hashset contents. 
     */
    pub fn opIndex (self)-> [&Symbol] {
        copy [s for _, s in self._set]        
    }

    impl Streamable;
}


/**
 * A mutable list of immutable symbols ensuring uniqueness.
 *
 * ImutSymbolList stores immutable references to symbols and guarantees that
 * each symbol appears at most once. It is used when the compiler must track
 * symbols without allowing mutation of the referenced symbol objects.
 * 
 */
@final
pub class ImutSymbolList {

    pub {
        // The hashset to make sure the symbols appears only once        
        let mut _set: [&Symbol => mut &Symbol] = copy [];
    }
    
    /**
     * Create an empty ImutSymbolList.
     */
    pub self () {}
    
    /**
     * Insert a symbol into the list.
     *
     * @params:
     *   - sym: the symbol to insert
     *
     * If the symbol is already present, the list is unchanged. Uniqueness is
     * enforced by the underlying hashset.
     */
    pub fn insert (mut self, sym: &Symbol) {
        self._set [sym] = sym;          
    }
    
    /**
     * @returns an immutable array of the symbols contained in the list.
     *
     * The returned array is a copy of the hashset contents.
     */
    pub fn opIndex (self)-> [&Symbol] {
        copy [s for _, s in self._set]
    }

    impl Streamable;
}
