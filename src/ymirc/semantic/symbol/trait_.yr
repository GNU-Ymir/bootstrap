in trait_;

use ymirc::utils::format;
use ymirc::lexing::{word, tokens};

use ymirc::semantic::generator::_;

use ymirc::syntax::declaration::_;
use ymirc::syntax::expression::_;

use std::stream;

/**
 * Represents a trait declaration in the semantic symbol table.
 *
 * A TraitSymbol is created for each TraitDecl encountered during semantic
 * analysis. It stores:
 *   - the syntactic declaration (TraitDecl),
 *   - the list of assertion expressions declared inside the trait,
 *   - the associated assertion comments,
 *   - the conditional blocks (CondBlockDecl),
 *   - the validation state used by the trait validator.
 *
 * Trait symbols participate in the semantic pass responsible for checking
 * trait constraints, validating assertions, and processing conditional
 * blocks. This class is final: traits do not admit specialization.
 */
@final
pub class TraitSymbol over Symbol {

    pub {
        // The syntactic trait        
        let decl: &TraitDecl;
    }

    prv {
        // The list of assertion of the class
        let mut _assertions: [mut &AssertDecl] = [];

        // The conditional blocks
        let mut _condBlocks: [mut &CondBlockDecl] = [];

        // True if the symbol is already validated by trait validator (in semantic pass)
        let mut _validated: bool = false;
    }

    /**
     * Creates a new TraitSymbol.
     *
     * @params:
     *   - loc:        the source location of the trait keyword.
     *   - comm:       the extracted documentation comment, if any.
     *   - decl:       the syntactic TraitDecl node.
     *   - protection: the declared protection level of the trait.
     *
     */
    pub self (loc:        &Word,
              comm:       [c8],
              decl:       &TraitDecl,
              protection: Protection)
        
        with super (loc, comm, isWeak-> false, protection-> protection)
        , decl = decl
        
    {}

    /**
     * Returns the list of assertion expressions declared in the trait.
     *
     * Assertions represent semantic constraints that must be satisfied by
     * any type implementing the trait.
     */
    @field
    pub fn assertions (self)-> [&AssertDecl] {
        self._assertions
    }
    
    /**
     * Returns the list of conditional blocks declared in the trait.
     *
     * Conditional blocks allow traits to express requirements that depend
     * on compile-time conditions.
     */
    @field
    pub fn condBlockDecls (self)-> [&CondBlockDecl] {
        self._condBlocks
    }

    /**
     * Returns true iff the trait has already been validated by the trait
     * validator during the semantic pass.
     */
    @field
    pub fn isValidated (self)-> bool {
        self._validated
    }
    
    /**
     * Adds a new assertion to the trait.
     *
     * @params:
     *   - assertion: the assertion expression to add.     
     *
     */
    pub fn addAssertion (mut self, assertion: &AssertDecl) {
        self._assertions ~= [assertion];        
    }
    
    /**
     * Adds a new conditional block to the trait.
     *
     * @params:
     *   - c: the conditional block declaration to add.
     */
    pub fn addCondBlockDecl (mut self, c: &CondBlockDecl) {
        self._condBlocks ~= [c];
    }

    /**
     * Marks the trait as validated or not.
     *
     * @params:
     *   - b: true iff the trait has been validated by the trait validator.
     */
    pub fn setValidated (mut self, b: bool) {
        self._validated = b;
    }


    impl Streamable;

}
