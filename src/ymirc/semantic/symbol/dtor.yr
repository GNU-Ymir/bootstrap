in dtor;

use ymirc::utils::format;
use ymirc::lexing::{word, tokens};

use ymirc::semantic::generator::_;

use ymirc::syntax::expression::_;
use ymirc::syntax::declaration::_;

use std::stream;

/**
 * Symbol representing a destructor declaration.
 *
 * A DtorSymbol is attached to a `DtorDecl` inside a class. It stores:
 *
 *   - the syntactic destructor declaration,
 *   - the validated prototype (frame) of the destructor,
 *   - the validated body generator,
 *   - the class that owns the destructor.
 *
 */
@final
pub class DtorSymbol over Symbol {

    pub {
        // The syntax destructor
        let decl: &DtorDecl;
    }

    prv {
        // The destructor validated at validation time
        let mut _proto: &Generator = EMPTY_GENERATOR;

        // The body of the dtor validated at validation time
        let mut _body: &Generator = EMPTY_GENERATOR;

        // The class that contains the destructor
        let dmut _class: &ClassSymbol;
    }

    /**
     * Construct a DtorSymbol.
     *
     * @params:
     *   - loc:  source location of the destructor declaration
     *   - comm: documentation comments attached to the declaration
     *   - decl: the syntactic destructor declaration
     *   - cl:   the class containing this destructor
     *
     * The destructor is always public.
     */
    pub self (loc:     &Word,
              comm:    [c8],
              decl:    &DtorDecl,
              dmut cl: &ClassSymbol)
        
        with super (loc, comm, isWeak-> false, protection-> Protection::PUBLIC)
        , _class = alias cl
        , decl = decl
    {}

    /**
     * @returns the validated prototype (frame) of the destructor.
     *
     * This is set during validation and describes the destructor's calling frame.
     */
    @field
    pub fn frameProto (self)-> &Generator {
        self._proto
    }

    /**
     * @returns the validated body generator of the destructor.
     *
     * This is set during validation and represents the executable body of the
     * destructor.
     */
    @field
    pub fn body (self)-> &Generator {
        self._body
    }
    
    /**
     * @returns the class that contains this destructor.
     */
    @field
    pub fn parentClass (self)-> &ClassSymbol {
        self._class
    }
    
    /**
     * @returns the class that contains this destructor (mutable view).
     */
    @field
    pub fn parentClass (mut self)-> dmut &ClassSymbol {
        alias self._class
    }
    
    /**
     * @returns true iff the destructor has no executable content.
     *
     * A destructor is considered empty when:
     *   - its body is an EmptyExpression, or
     *   - its body is a BlockExpr with no guards and no statements.
     */
    @field
    pub fn isEmpty (self)-> bool {
        match self.decl.body {
            EmptyExpr () => { true }
            bl: &BlockExpr => {
                bl.guards.len == 0us && bl.content.len == 0us
            }
            _ => { false }
        }
    }
    
    /**
     * Set the validated prototype and body of the destructor.
     *
     * @params:
     *   - proto: the validated prototype (frame)
     *   - body:  the validated body generator
     *
     * Called during semantic validation.
     */
    pub fn setFrameProto (mut self, proto: &Generator, body: &Generator) {
        self._proto = proto;
        self._body = body;
    }

    impl Streamable;

}
