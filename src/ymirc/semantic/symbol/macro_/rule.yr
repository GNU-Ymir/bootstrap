 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in rule;

use ymirc::lexing::word;
use ymirc::syntax::declaration::_;

use std::stream;

/**
 * Represents a macro rule used during macro expansion.
 *
 * A MacroRuleSymbol corresponds to a MacroRuleDecl where decl.isCtor == false.
 * It defines one of the rewriting steps applied to a macro expression after the
 * constructor rule has been matched. Macro rules form a chain of
 * transformations that progressively rewrite the macro expression until a final
 * expanded form is produced.
 *
 */
@final
pub class MacroRuleSymbol over Symbol {

    pub {
        // The syntactic declaration of the rule (assuming decl.isCtor == false)
        let decl: &MacroRuleDecl;
    }

    /**
     * Creates a new MacroRuleSymbol.
     *
     * Parameters:
     *   - loc:  the source location of the rule.
     *   - comm: the extracted documentation comment, if any.
     *   - decl: the syntactic MacroRuleDecl node.
     *
     */
    pub self (loc:  &Word,
              comm: [c8],
              decl: &MacroRuleDecl)
        
        with super (loc, comm, isWeak-> false, protection-> Protection::PRIVATE)
        , decl = decl
    {}

    impl Streamable;
    
}
