 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in ctor;

use ymirc::lexing::word;
use ymirc::syntax::declaration::_;

use std::stream;

/**
 * Represents the constructor of a macro invocation.
 *
 * It stores the MacroRuleDecl that defines the constructor rule(decl.isCtor ==
 * true), and serves as the symbolic entry point for macro expansion.
 *
 * During macro resolution, the constructor is decomposed using the macro rules
 * associated with the macro declaration. This symbol provides the semantic
 * identity and metadata needed for that process.
 *
 */
@final
pub class MacroCtorSymbol over Symbol {

    pub {
        // The syntaxic constructor(assuming decl.isCtor == true)
        let decl: &MacroRuleDecl;
    }

    /**
     * Creates a new MacroCtorSymbol.
     *
     * Parameters:
     *   - loc:        the source location of the constructor rule.
     *   - comm:       the extracted documentation comment, if any.
     *   - content:    the MacroRuleDecl representing the constructor.
     *
     * MacroCtors are always public in macros.
     *
     */
    pub self (loc:        &Word,
              comm:       [c8],
              decl:    &MacroRuleDecl)

        with super (loc, comm, isWeak-> false, protection-> Protection::PUBLIC)
        , decl = decl
    {}

    impl Streamable;
}
