in ctor;

use ymirc::utils::format;
use ymirc::lexing::{word, tokens, keys};

use ymirc::semantic::generator::_;

use ymirc::syntax::expression::_;
use ymirc::syntax::declaration::_;

use std::{stream, fs::path};

/**
 * Symbol representing a constructor declaration.
 *
 * A CtorSymbol is attached to a `CtorDecl` inside a class. It stores:
 *
 *   - the syntactic constructor declaration,
 *   - whether the constructor is marked `unsafe`,
 *   - the class that owns the constructor,
 *   - the validated prototype(frame) of the constructor,
 *   - the validated body generator,
 *   - whether the constructor redirects to another constructor.
 *
 * CtorSymbol does not perform validation itself; it simply records the
 * information produced by the validator and generator subsystems.
 */
@final
pub class CtorSymbol over Symbol {

    pub {
        // The syntax constructor
        let decl: &CtorDecl;

        // True iif the ctor is unsafe
        let isUnsafe: bool;
    }

    prv {
        // The constructor validated at validation time
        let mut _proto: &Generator = EMPTY_GENERATOR;

        // The class that contains the constructor
        let dmut _class: &ClassSymbol;

        // The body of the ctor set at validation time
        let mut _body: &Generator = EMPTY_GENERATOR;

        // True if the constructor uses a redirection ctor
        let mut _hasRedirect: bool = false;
    }

    /**
     * Construct a CtorSymbol.
     *
     * @params:
     *   - loc:        source location of the constructor declaration
     *   - comm:       documentation comments attached to the declaration
     *   - decl:       the syntactic constructor declaration
     *   - cl:         the class containing this constructor
     *   - protection: visibility of the constructor
     *   - isUnsafe:   true iff the constructor is marked `unsafe`
     *
     */
    pub self (loc:        &Word,
              comm:       [c8],
              decl:       &CtorDecl,
              dmut cl:    &ClassSymbol,
              isUnsafe:   bool,
              protection: Protection)

        with super (loc, comm, isWeak-> false, protection-> protection)
        , _class = alias cl
        , decl = decl
        , isUnsafe = isUnsafe
    {}

    /**
     * @returns the validated prototype(frame) of the constructor.
     *
     * This is set during validation and describes the constructor's parameter
     * structure and calling frame.
     */
    @field
    pub fn frameProto(self)-> &Generator {
        self._proto
    }

    /**
     * @returns the validated body generator of the constructor.
     *
     * This is set during validation and represents the executable body of the
     * constructor.
     */
    @field
    pub fn body(self)-> &Generator {
        self._body
    }

    /**
     * @returns true iff the constructor uses a redirection constructor.
     *
     * A redirection constructor delegates initialization to another constructor
     * of the same class, or a call to the constructor of the parent class.
     */
    @field
    pub fn hasRedirect(self)-> bool {
        self._hasRedirect
    }

    /**
     * @returns the class that contains this constructor.
     */
    @field
    pub fn parentClass(self)-> &ClassSymbol {
        self._class
    }

    /**
     * @returns the class that contains this constructor(mutable view).
     */
    @field
    pub fn parentClass(mut self)-> dmut &ClassSymbol {
        alias self._class
    }

    /**
     * Set the validated prototype and body of the constructor.
     *
     * @params:
     *   - proto:       the validated prototype(frame)
     *   - body:        the validated body generator
     *   - hasRedirect: true iff the constructor redirects to another constructor
     *
     * Called during semantic validation.
     */
    pub fn setFrameProto(mut self, proto: &Generator, body: &Generator, hasRedirect: bool) {
        self._proto = proto;
        self._body = body;
        self._hasRedirect = hasRedirect;
    }

    /**
     * Compute the full name of the constructor symbol.
     *
     * Constructors may be unnamed(`""`), in which case the base Symbol
     * implementation is used. Otherwise, the constructor name is appended to the
     * parent class's path, including template information when applicable.
     */
    prot over computeFullName(self)-> &SymbolPath {
        let mut toPush = self.decl.name.str;
        if (toPush == "") {
            toPush = Keys::SELF;
        }

        let mut p = match self._referent {
            Ok(x: _) => {
                x.path
            }
            _ => { copy SymbolPath("") }
        };

        return p.push(toPush, tmpls-> self._templateMapper);
    }

    impl Streamable;
}
