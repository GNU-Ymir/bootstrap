in template_;

use ymirc::utils::format;
use ymirc::lexing::{word, tokens, keys};

use ymirc::semantic::generator::_;

use ymirc::syntax::declaration::_;
use ymirc::syntax::expression::_;
use std::stream;

/**
 * Represents a template declaration in the semantic symbol table.
 *
 * A TemplateSymbol is created for each TemplateDecl encountered during
 * semantic analysis. It exposes:
 *   - the syntactic declaration(TemplateDecl),
 *   - the symbolic identity and protection level,
 *   - the logic for computing the fully-qualified name of the template,
 *     including constructor-based naming rules.
 *
 */
@final
pub class TemplateSymbol over Symbol {

    pub {
        // The syntaxic content of the template
        let decl: &TemplateDecl;

        // True iif inner decl is a function within a class/record/entity or trait
        let isMethod: bool;
    }

    /**
     * Creates a new TemplateSymbol.
     *
     * Parameters:
     *   - loc:        the source location of the declaration keyword.
     *   - comm:       the extracted documentation comment, if any.
     *   - decl:       the TemplateDecl node representing the template.
     *   - protection: the declared protection level(public, protected, …).
     *
     */
    pub self (loc:        &Word,
              comm:       [c8],
              decl:       &TemplateDecl,
              protection: Protection,
              inClass:   bool)

        with super (loc, comm, isWeak-> false, protection-> protection)
        , decl = decl
        , isMethod = inClass && (decl.decl of FunctionDecl)
    {}

    /**
     * Computes the fully-qualified name of this template symbol.
     *
     * @info: for a ctor template, the loc of the template declaration is empty, so the
     * default computation would return the path of the class itself. The name of the ctor is
     * pushed explicitly instead(`self` for an unnamed ctor), otherwise the prototype created
     * from this template would be named after the class, and the mapper of the template would
     * override the mapper of the class(cf. `SymbolPath::withTemplates`).
     */
    prot over computeFullName(self)-> &SymbolPath {
        if let ctor: &CtorDecl = self.decl.decl {
            let name = if (ctor.name.str == "") { Keys::SELF } else { ctor.name.str };
            let mut p = match self._referent {
                Ok(x: _) => {
                    x.path
                }
                _ => { copy SymbolPath("") }
            };

            return p.push(name, tmpls-> self._templateMapper);
        }

        return (self.super).computeFullName();
    }

    impl Streamable;

}
