 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in function;

use ymirc::errors;
use ymirc::lexing::word;
use ymirc::semantic::generator;
use ymirc::syntax::declaration::_;

use std::stream;

/**
 * Symbol representing a function declaration.
 *
 * FunctionSymbol is attached to a `FunctionDecl` and stores:
 *
 *   - the syntactic function declaration,
 *   - semantic attributes such as:
 *       - C-variadic(`isCVariadic`),
 *       - override(`isOver`),
 *       - final(`isFinal`),
 *       - unsafe(`isUnsafe`),
 *       - method status(`isMethod`),
 *   - the validated prototype(frame) of the function,
 *   - the validated body generator(used for compile-time evaluation).
 *
 */
@final
pub class FunctionSymbol over Symbol {

    pub {
        // The syntaxic declaration of the function
        let decl: &FunctionDecl;

        // True iif the function is a C variadic function
        let isCVariadic: bool;

        // True iif the function is marked override
        let isOver: bool;

        // True iif the function is marked final
        let isFinal: bool;

        // True iif the function is marked as a field
        let isField: bool;

        // True iif the function is marked as inline
        let isInline: bool;

        // True iif the function is marked unsafe
        let isUnsafe: bool;

        // True if declared within a class, struct or entity
        let isMethod: bool;
    }

    prv {
        // The generator set at validation time for the prototype of the function
        let mut _proto: &Generator = EMPTY_GENERATOR;

        // The body set at validation time(used for cte compute)
        let mut _body: &Generator = EMPTY_GENERATOR;

        // The instances of the `apply` overloads its tags merged into it, innermost first
        let mut _merges: [&FunctionSymbol] = [];

        // The function as written, if this one is the instance its tags were merged into
        let mut _untagged: (&FunctionSymbol)? = none;

        // True while its tags are merged into it, and once they are
        let mut _merging: bool = false;
        let mut _merged: bool = false;

        // True while its prototype is validated
        let mut _validatingProto: bool = false;

        // The error the merge of its tags failed with
        let mut _mergeError: (&ErrorMsg)? = none;
    }

    /**
     * Construct a FunctionSymbol.
     *
     * @params:
     *   - loc:         source location of the function declaration
     *   - comm:        documentation comments attached to the declaration
     *   - decl:        the syntactic function declaration
     *   - protection:  visibility of the function
     *   - isMethod:    true iff the function is declared inside a class, struct, or entity
     *   - isCVariadic: true iff the function uses C-style variadic arguments
     *   - isOver:      true iff the function is marked `override`
     *   - isFinal:     true iff the function is marked `final`
     *   - isUnsafe:    true iff the function is marked `unsafe`
     *   - isField:     true iif the function is marked `field`
     *   - isInline:    true iif the function is marked `inline`
     *
     */
    pub self (loc:         &Word,
              comm:        [c8],
              decl:        &FunctionDecl,
              isMethod:    bool,
              isCVariadic: bool,
              isOver:      bool,
              isFinal:     bool,
              isUnsafe:    bool,
              isInline:    bool,
              isField:     bool,
              protection:  Protection)

        with super (loc, comm, isWeak-> false, protection-> protection)
        , decl = decl
        , isCVariadic = isCVariadic
        , isOver = isOver
        , isFinal = isFinal
        , isUnsafe = isUnsafe
        , isMethod = isMethod
        , isField = isField
        , isInline = isInline
    {}

    /**
     * @returns the validated prototype(frame) of the function.
     *
     * This describes the function’s parameters, return type, and calling frame.
     */
    @field
    pub fn frameProto(self)-> &Generator {
        self._proto
    }

    /**
     * @returns the validated body generator of the function.
     *
     * The body may be empty if:
     *   - the function has not yet been validated, or
     *   - the function is not eligible for compile-time evaluation.
     *
     */
    @field
    pub fn frameBody(self)-> &Generator {
        self._body
    }

    /**
     * @returns true iff the function is a virtual method
     */
    @field
    pub fn isVirtual(self)-> bool {
        return self.isMethod && (!self.isFinal || self.isOver);
    }

    /**
     * Set the validated prototype and body of the function.
     *
     * @params:
     *   - proto: the validated prototype(frame)
     *   - body:  the validated body generator
     *
     * Called during semantic validation.
     */
    pub fn setFrameProto(mut self, proto: &Generator, body: &Generator) {
        self._proto = proto;
        self._body = body;
    }

    /**
     * @returns: the instances of the `apply` overloads the tags of the function
     * were merged into, innermost first, the last one being the function its name means
     */
    @field
    pub fn merges(self)-> [&FunctionSymbol] {
        self._merges
    }

    /**
     * @returns: the function the name of this one means, the outermost instance its
     * tags were merged into, itself if none was
     */
    @field
    pub fn named(self)-> &FunctionSymbol {
        if (self._merges.len != 0us) {
            return self._merges[$ - 1us];
        }

        self
    }

    /**
     * @returns: the function as written, if this one is the instance its tags were merged into
     */
    @field
    pub fn untagged(self)-> (&FunctionSymbol)? {
        self._untagged
    }

    /**
     * @returns: true while the tags of the function are merged into it
     */
    @field
    pub fn isMerging(self)-> bool {
        self._merging
    }

    /**
     * @returns: true once the tags of the function are merged into it
     */
    @field
    pub fn isMerged(self)-> bool {
        self._merged
    }

    /**
     * @returns: the error the merge of the tags of the function failed with, if it did
     */
    @field
    pub fn mergeError(self)-> (&ErrorMsg)? {
        self._mergeError
    }

    /**
     * @returns: true while the prototype of the function is validated
     */
    @field
    pub fn isValidatingProto(self)-> bool {
        self._validatingProto
    }

    /**
     * Mark the prototype of the function as being validated, or as no longer being
     *
     * @params:
     *   - validating: true when its validation starts, false when it ends
     */
    pub fn setValidatingProto(mut self, validating: bool) {
        self._validatingProto = validating;
    }

    /**
     * Mark the tags of the function as being merged into it
     */
    pub fn setMerging(mut self) {
        self._merging = true;
    }

    /**
     * Mark the merge of the tags of the function as failed
     *
     * @params:
     *   - err: the error it failed with
     */
    pub fn setMergeError(mut self, err: &ErrorMsg) {
        self._mergeError = err?;
        self._merging = false;
    }

    /**
     * Set the instances the tags of the function were merged into
     *
     * @params:
     *   - merges: the instances, innermost first
     */
    pub fn setMerges(mut self, merges: [&FunctionSymbol]) {
        self._merges = merges;
        self._merging = false;
        self._merged = true;
    }

    /**
     * Move the function to a hidden path, `__untagged` nested in its own, that no
     * lookup reaches, its name meaning the instance its tags were merged into. The
     * template mapper of a specialization moves to the last segment, as a call
     * site mangles it.
     */
    pub fn hide(mut self) {
        let path = self._fullName;
        self._fullName = path.parent.push(path.file).push("__untagged", tmpls-> path.templates[$ - 1us]);
    }

    /**
     * Take the identity of the function a tag merged into this one: its path, its
     * weakness, and the template mapper of its specialization
     *
     * @params:
     *   - original: the function as written
     */
    pub fn takeIdentity(mut self, original: &FunctionSymbol) {
        self._fullName = original.path;
        self._isWeak = original.isWeak;
        self._templateMapper = original.templateMapper;
        self._untagged = original?;
    }

    impl Streamable;

}
