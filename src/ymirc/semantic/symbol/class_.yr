/*
 * Declares the ClassSymbol class.
 *
 * ClassSymbol represents the semantic information associated with a class
 * declaration in the AST. It stores the syntactic structure of the class
 * (fields, assertions, conditional blocks), its semantic attributes
 * (record/entity/packed/overlaid), and validation-time results such as the
 * generated ClassRefType or error generator.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::symbol::class_
 * @File: ymirc/semantic/symbol/class_.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2021-11-29
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in class_;

use ymirc::errors;
use ymirc::lexing::{tokens, word};
use ymirc::semantic::generator;
use ymirc::semantic::generator::type;
use ymirc::semantic::generator::type::temporary;
use ymirc::semantic::generator::value;
use ymirc::semantic::generator::value::template_;
use ymirc::syntax::{declaration::_, expression::_};
use ymirc::utils::format;

use std::stream;

/**
 * Symbol representing a class declaration.
 *
 * ClassSymbol stores both the syntactic and semantic information associated
 * with a class. It tracks:
 *
 *   - the ancestor expression(if any),
 *   - structural attributes(record, entity, packed, overlaid),
 *   - semantic attributes(abstract, final),
 *   - declared fields and their protection levels,
 *   - assertions and conditional blocks,
 *   - the destructor symbol,
 *   - methods added that are not present in ancestor vtable,
 *   - validation-time results(ClassRefType or ErrorGenerator).
 *
 * ClassSymbol does not itself perform validation; it merely stores the
 * information required by the validator and generator subsystems.
 */
@final
pub class ClassSymbol over Symbol {

    pub {
        // The ancestor of the class
        let ancestor: &Expression;

        // True iif the class is abstract
        let isAbstract: bool;

        // True iif the class is final
        let isFinal: bool;

        // True if the class is a structure(final, no ancestor, and on the stack)
        let isRecord: bool;

        // True if the struct is movable
        let isEntity: bool;

        // True if the struct is packed
        let isPacked: bool;

        // True if the struct is overlaid
        let isOverlaid: bool;

        // True if this is a data record
        let isData: bool;
    }

    prv {
        // The fields of the class
        let mut _fields: [mut &VarDeclExpr] = [];

        // The comments about the fields
        let mut _fieldComments: [mut[c8]] = [];

        // The name of the fields that are marked private
        let dmut _privateFields: [[c8] => ()] = copy [];

        // The name of the fields that are marked protected
        let dmut _protectedFields: [[c8] => ()] = copy [];

        // The name of the fields that are marked protected
        let dmut _publicFields: [[c8] => ()] = copy [];

        // The list of assertion of the class
        let mut _assertions: [mut &AssertDecl] = [];

        // The list of cond blocks of the class
        let mut _condBlock: [mut &CondBlockDecl] = [];

        // True iif conditional blocks have already been validated
        let mut _condBlockValidated: bool = false;
    }


    prv {
        // The destructor of the class
        let dmut _dtor: &Symbol = alias EMPTY_SYMBOL;

        // The generator set at validation time, to avoid multiple validation of the same symbol
        let dmut _classRef: (&ClassRefType)? = none;

        // The generator set to keep error if the validation of the class failed
        let mut _error: (&ErrorGenerator)? = none;

        /**
         * The list of method that aren't described inside an ancestor vtable
         */
        let dmut _addMethods: [&Symbol] = [];

        /**
         * The default ctors of the class
         */
        let mut _defaultCtors: [&CtorSymbol] = [];

        /**
         * The protection of the ctor built from the fields of the class, none
         * if the class asks for no such ctor
         */
        let mut _generatedCtorProt: (Protection)? = none;
    }

    /**
     * Construct a ClassSymbol.
     *
     * @params:
     *   - loc:        source location of the class declaration
     *   - comm:       documentation comments attached to the class
     *   - ancestor:   the ancestor expression(or empty expression)
     *   - isEntity:   true iff the class is an entity (movable, stack-allocated)
     *   - isRecord:   true iff the class is a record (stack-allocated, no inheritance)
     *   - isPacked:   true iff the class uses packed layout
     *   - isOverlaid: true iff the class uses overlaid layout
     *   - isAbstract: true iff the class is abstract
     *   - isFinal:    true iff the class is final
     *   - protection: visibility of the class
     *
     */
    pub self (loc:        &Word,
              comm:       [c8],
              ancestor:   &Expression,
              isEntity:   bool,
              isRecord:   bool,
              isPacked:   bool,
              isOverlaid: bool,
              isData:     bool,
              isAbstract: bool,
              isFinal:    bool,
              protection: Protection)

        with super (loc, comm, isWeak-> false, protection-> protection)
        , ancestor = ancestor
        , isAbstract = isAbstract
        , isFinal = isFinal
        , isRecord = isRecord
        , isEntity = isEntity
        , isOverlaid = isOverlaid
        , isPacked = isPacked
        , isData = isData
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns the list of field declarations of the class.
     */
    @field
    pub fn fields(self)-> [&VarDeclExpr] {
        self._fields
    }

    /**
     * @returns the list of comments associated with each field.
     */
    @field
    pub fn fieldComments(self)-> [[c8]] {
        self._fieldComments
    }

    /**
     * @returns the protection of the ctor built from the fields of the class,
     *          none if the class asks for no such ctor.
     */
    @field
    pub fn generatedCtorProt(self)-> (Protection)? {
        self._generatedCtorProt
    }

    /**
     * @returns true iff a field named `name` exists and is declared private.
     */
    pub fn isFieldPrivate(self, name: [c8])-> bool {
        name in self._privateFields
    }

    /**
     * @returns true iff a field named `name` exists and is declared protected.
     */
    pub fn isFieldProtected(self, name: [c8])-> bool {
        name in self._protectedFields
    }

    /**
     * @returns true iff a field named `name` exists and is declared public.
     */
    pub fn isFieldPublic(self, name: [c8])-> bool {
        name in self._publicFields
    }

    /**
     * @returns the list of assertions declared in the class.
     */
    @field
    pub fn assertions(self)-> [&AssertDecl] {
        self._assertions
    }

    /**
     * @returns the list of conditional blocks declared in the class.
     */
    @field
    pub fn condBlockDecls(self)-> [&CondBlockDecl] {
        self._condBlock
    }

    /**
     * @returns true iff conditional blocks have already been validated.
     */
    @field
    pub fn areCondBlockDeclsValidated(self)-> bool {
        self._condBlockValidated
    }

    /**
     * @returns true iff the class is a struct(record or entity).
     */
    @field
    pub fn isStruct(self)-> bool {
        self.isRecord || self.isEntity
    }

    /**
     * @returns the ClassRefType associated with this class, if validation succeeded.
     */
    @field
    pub fn classRef(mut self)-> dmut(&ClassRefType)? {
        alias self._classRef
    }

    /**
     * @returns the ClassRefType, or throws the stored error if validation failed.
     *
     * @warning: panics if neither classRef nor errorGenerator is set.
     */
    @field
    pub fn classRefUnwrapped(mut self)-> dmut &ClassRefType
        throws ErrorMsg
    {
        if let Ok(dmut cl) = alias self._classRef {
            return alias cl;
        }

        if let Ok(err) = self._error {
            throw err.msg;
        }

        panic;
    }

    /**
     * @returns the ClassRefType associated with this class (immutable view).
     */
    @field
    pub fn classRef(self)-> (&ClassRefType)? {
        self._classRef
    }

    /**
     * @returns the ClassRefType, or throws the stored error if validation failed.
     *
     * @warning: panics if neither classRef nor errorGenerator is set.
     */
    @field
    pub fn classRefUnwrapped(self)-> &ClassRefType
        throws ErrorMsg
    {
        if let Ok(cl) = self._classRef {
            return cl;
        }

        if let Ok(err) = self._error {
            throw err.msg;
        }

        panic;
    }

    /**
     * @returns the ErrorGenerator if validation failed, otherwise none.
     */
    @field
    pub fn errorGenerator(self)-> (&ErrorGenerator)? {
        self._error
    }

    /**
     * @returns the list of methods added to the class (mutable view).
     */
    @field
    pub fn addMethods(mut self)-> dmut[&Symbol] {
        return alias self._addMethods;
    }

    /**
     * @returns the list of methods added to the class (immutable view).
     */
    @field
    pub fn addMethods(self)-> [&Symbol] {
        return self._addMethods;
    }

    /**
     * @returns the destructor symbol of the class (mutable view).
     */
    @field
    pub fn dtor(mut self)-> dmut &Symbol {
        alias self._dtor
    }

    /**
     * @returns the destructor symbol of the class (immutable view).
     */
    @field
    pub fn dtor(self)-> &Symbol {
        self._dtor
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */


    /**
     * Add a method to the class that is not present in the ancestor's vtable.
     *
     */
    pub fn insertAddMethod(mut self, dmut meth: &Symbol) {
        self._addMethods ~= [alias meth];
    }

    /**
     * Add a default ctor to the class
     *
     */
    pub fn insertDefaultCtor(mut self, dmut ctor: &CtorSymbol) {
        for dc in self._defaultCtors {
            if dc.decl == ctor.decl {
                return;
            }
        }

        self._defaultCtors ~= [alias ctor];
        self._addMethods ~= [alias ctor];
    }

    /**
     * Ask for a ctor built from the fields of the class, with the protection
     * `protection`.
     *
     */
    pub fn setGeneratedCtor(mut self, protection: Protection) {
        self._generatedCtorProt = (protection)?;
    }

    /**
     * Set the ClassRefType produced during validation.
     */
    @field
    pub fn classRef(mut self, dmut info: &ClassRefType) {
        self._classRef = (alias info)?;
    }

    /**
     * Set the error generator when validation fails.
     *
     * This clears any previously stored ClassRefType.
     */
    @field
    pub fn errorGenerator(mut self, error: &ErrorGenerator) {
        self._classRef = none;
        self._error = (error)?;
    }

    /**
     * Set the destructor symbol of the class.
     *
     * Also updates the destructor's referent to this class.
     */
    @field
    pub fn dtor(mut self, dmut dtor: &Symbol) {
        self._dtor = alias dtor;
        self._dtor:.setReferent(alias self);
    }

    /**
     * Add a field declaration to the class.
     *
     * @params:
     *   - field:      the field declaration
     *   - comm:       comments associated with the field
     *   - protection: visibility of the field
     *
     * The field is appended to the field list, and its name is recorded in the
     * appropriate protection map.
     */
    pub fn addField(mut self, field: &VarDeclExpr, comm: [c8], protection: Protection) {
        self._fields ~= [field];
        self._fieldComments ~= [comm];
        match protection {
            Protection::PUBLIC => {
                self._publicFields[field.name.str] = ();
            }
            Protection::PROTECTED => {
                self._protectedFields[field.name.str] = ();
            }
            _ => {
                self._privateFields[field.name.str] = ();
            }
        }
    }

    /**
     * Add an assertion to the class.
     *
     * @params:
     *   - assertion: the assertion expression
     *
     */
    pub fn addAssertion(mut self, assertion: &AssertDecl) {
        self._assertions ~= [assertion];
    }

    /**
     * Add a conditional block to the class.
     *
     */
    pub fn addCondBlockDecl(mut self, c: &CondBlockDecl) {
        self._condBlock ~= [c];
    }

    /**
     * Mark conditional blocks as validated to prevent repeated validation.
     */
    pub fn setCondBlockValidated(mut self) {
        self._condBlockValidated = true;
    }

    impl Streamable;

}
