in union_;

use ymirc::lexing::word;
use ymirc::semantic::generator::_;
use ymirc::syntax::declaration::_;

use std::stream;

/**
 * Symbol representing an union declaration.
 *
 * UnionSymbol is attached to an `UnionDecl` and stores:
 *
 *   - the syntactic union declaration,
 *   - the validated generator produced during semantic analysis,
 *   - the ordered list of member types.
 *
 * Members are stored in declaration order, the index of a member in that list
 * being the discriminant identifying it at runtime.
 */
@final
pub class UnionSymbol over Symbol {

    pub {
        // The syntax expression of the union
        let decl: &UnionDecl;
    }

    prv {
        // The generator set at validation time
        let mut _gen: &Generator = EMPTY_GENERATOR;

        // The list of member types of the union, in declaration order
        let mut _types: [&Type] = [];
    }

    /**
     * Construct an UnionSymbol.
     *
     * @params:
     *   - loc:        source location of the union declaration
     *   - comm:       documentation comments attached to the declaration
     *   - decl:       the syntactic union declaration
     *   - protection: visibility of the union
     *
     * The symbol is always strong(not weak) and inherits symbol-table behavior
     * from the base Symbol class.
     */
    pub self (loc:        &Word,
              comm:       [c8],
              decl:       &UnionDecl,
              protection: Protection)

        with super (loc, comm, isWeak-> false, protection-> protection)
        , decl = decl
    {}

    /**
     * @returns the validated generator associated with the union.
     *
     * This is set during semantic validation and contains the type information
     * for the union.
     */
    @field
    pub fn generator(self)-> &Generator {
        self._gen
    }

    /**
     * Set the validated generator for the union.
     *
     * @params:
     *   - gen: the generator produced during validation
     */
    @field
    pub fn generator(mut self, gen: &Generator) {
        self._gen = gen;
    }

    /**
     * @returns the member types of the union, in declaration order.
     */
    @field
    pub fn types(self)-> [&Type] {
        self._types
    }

    /**
     * Set the member types of the union.
     *
     * @params:
     *   - types: the member types, in declaration order
     */
    @field
    pub fn types(mut self, types: [&Type]) {
        self._types = types;
    }

    impl Streamable;

}
