in enum_;

use ymirc::utils::format;
use ymirc::lexing::{word, tokens};

use ymirc::semantic::generator::{_, value::literal};

use ymirc::syntax::declaration::_;
use ymirc::syntax::expression::_;

use std::stream;

/**
 * Symbol representing an enumeration declaration.
 *
 * EnumSymbol is attached to an `EnumDecl` and stores:
 *
 *   - the syntactic enumeration declaration,
 *   - the validated generator produced during semantic analysis,
 *   - the ordered list of enumeration fields and their constant values.
 *
 * Enumeration fields are stored in declaration order rather than in a map,
 * because order is semantically meaningful(e.g., for iteration or code
 * generation). Each field is represented as a pair `(name, value)`.
 *
 * EnumSymbol does not perform validation itself; it simply records the
 * information produced by the validator and generator subsystems.
 */
@final
pub class EnumSymbol over Symbol {

    pub {
        // The syntax expression of the enum
        let decl: &EnumDecl;
    }

    prv {
        // The generator set at validation time
        let mut _gen: &Generator = EMPTY_GENERATOR;

        // The list of field of the enumeration
        // We don't use a map, because order has to be kept
        //
        let dmut _fields: [([c8], &Value)] = [];
    }

    /**
     * Construct an EnumSymbol.
     *
     * @params:
     *   - loc:        source location of the enumeration declaration
     *   - comm:       documentation comments attached to the declaration
     *   - decl:       the syntactic enumeration declaration
     *   - protection: visibility of the enumeration
     *
     * The symbol is always strong(not weak) and inherits symbol-table behavior
     * from the base Symbol class.
     */
    pub self (loc:        &Word,
              comm:       [c8],
              decl:       &EnumDecl,
              protection: Protection)

        with super (loc, comm, isWeak-> false, protection-> protection)
        , decl = decl
    {}

    /**
     * @returns the validated generator associated with the enumeration.
     *
     * This is set during semantic validation and contains the type information
     * for the enumeration.
     */
    @field
    pub fn generator(self)-> &Generator {
        self._gen
    }

    /**
     * Look up a field in the enumeration.
     *
     * @params:
     *   - name: the name of the field to search for
     *
     * @returns the constant value associated with the field, or `UNIT_VALUE`
     *          if the field does not exist.
     *
     * Field lookup is linear because declaration order is preserved.
     */
    pub fn field(self, name: [c8])-> &Value {
        for i in self._fields {
            if (i._0 == name) return i._1;
        }

        UNIT_VALUE
    }

    /**
     * @returns the list of fields declared in the enumeration.
     *
     * Each field is represented as a pair `(name, value)` and appears in the
     * order it was declared.
     */
    @field
    pub fn fields(self)-> [([c8], &Value)] {
        self._fields
    }


    /**
     * Set the validated generator for the enumeration.
     *
     * @params:
     *   - gen: the generator produced during validation
     */
    @field
    pub fn generator(mut self, gen: &Generator) {
        self._gen = gen;
    }

    /**
     * Insert a field into the enumeration.
     *
     * @params:
     *   - name:  the name of the enumeration field
     *   - value: the constant value associated with the field
     *
     * Fields are appended in declaration order.
     */
    pub fn setField(mut self, name: [c8], value: &Value) {
        self._fields ~= [(name, value)];
    }

    impl Streamable;

}
