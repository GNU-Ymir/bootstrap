in global;

use ymirc::utils::format;
use ymirc::lexing::{word, tokens};

use ymirc::semantic::generator::_;

use ymirc::syntax::declaration::_;
use ymirc::syntax::expression::_;

use std::stream;

/**
 * Symbol representing a global variable declaration.
 *
 * GlobalVarSymbol is attached to a `GlobalVarDecl` and stores:
 *
 *   - the syntactic declaration of the global variable,
 *   - whether the variable is:
 *       * static (`isStatic`),
 *       * external(`isExtern`),
 *       * thread-local(`isThreadLocal`),
 *   - the validated generator produced during semantic analysis.
 *
 * A static global is initialized eagerly at program startup, while a non-static
 * global is lazily initialized. External globals refer to variables defined
 * outside the current module or translation unit. Thread-local globals have one
 * instance per thread.
 *
 */
@final
pub class GlobalVarSymbol over Symbol {

    pub {
        // The syntaxic global var
        let decl: &GlobalVarDecl;

        // True if the variable is static (lazy otherwise)
        let isStatic: bool;

        // True if the variable is external
        let isExtern: bool;

        // True if the variable is thread local
        let isThreadLocal: bool;
    }

    prv {
        // The generator set at validation time after the validation  of the symbol
        let mut _gen: &Generator = EMPTY_GENERATOR;
    }

    /**
     * Construct a GlobalVarSymbol.
     *
     * @params:
     *   - loc:           source location of the global variable declaration
     *   - comm:          documentation comments attached to the declaration
     *   - decl:          the syntactic global variable declaration
     *   - protection:    visibility of the global variable
     *   - isExtern:      true iff the variable is declared `extern`
     *   - isStatic:      true iff the variable is declared `static`
     *   - isThreadLocal: true iff the variable is declared `threadlocal`
     *
     */
    pub self (loc:           &Word,
              comm:          [c8],
              decl:          &GlobalVarDecl,
              isExtern:      bool,
              isStatic:      bool,
              isThreadLocal: bool,
              protection:    Protection)

        with super (loc, comm, isWeak-> false, protection-> protection)
        , decl = decl
        , isExtern = isExtern
        , isStatic = isStatic
        , isThreadLocal = isThreadLocal
    {}

    /**
     * @returns the generator associated with the global variable.
     *
     * Before validation, this is `EMPTY_GENERATOR`. After validation, it contains
     * the type and initialization information for the global variable.
     */
    @field
    pub fn generator(self)-> &Generator {
        self._gen
    }

    /**
     * Set the validated generator for the global variable.
     *
     * Called during semantic validation once the type and initialization
     * information has been computed.
     */
    @field
    pub fn generator(mut self, gen: &Generator) {
        self._gen = gen;
    }

    impl Streamable;

}
