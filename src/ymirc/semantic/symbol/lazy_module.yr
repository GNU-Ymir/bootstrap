/*
 * Declares the LazyModuleSymbol class. 
 *
 * LazyModuleSymbol represents a module that is known to exist but has not yet
 * been loaded or parsed. It is inserted into the symbol table when an import
 * statement references a module, allowing the compiler to defer reading and
 * validating the module file until it is actually needed.
 *
 * A LazyModuleSymbol is replaced by a real ModuleSymbol when the module is
 * first accessed. This avoids unnecessary I/O and parsing for modules that
 * are imported but never referenced.
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::semantic::symbol::lazy_module
 * @File: ymirc/semantic/symbol/lazy_module.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2024-10-03
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in lazy_module;

use ymirc::utils::format;
use ymirc::lexing::{word, tokens};
use ymirc::semantic::symbol::_;
use ymirc::semantic::generator::_;

use ymirc::syntax::declaration::_;
use ymirc::syntax::expression::_;

use std::{stream, fs::path};

/**
 * Symbol representing a lazily loaded module.
 *
 * LazyModuleSymbol is created when an import statement references a module
 * whose file has not yet been parsed. It stores:
 *
 *   - the import path of the module file,
 *   - the location of the import statement,
 *   - the module's declared name,
 *   - the absolute package directory used to resolve the module path,
 *   - the finalized symbol (a real ModuleSymbol) once the module is loaded.
 *
 * Until the module is actually needed, LazyModuleSymbol acts as a placeholder
 * in the symbol table. When the module is accessed, the compiler replaces the
 * lazy symbol with a fully constructed ModuleSymbol and stores it in
 * `finalized`.
 *
 */
@final
pub class LazyModuleSymbol over Symbol {

    pub {
        // The path of the file to read
        let importPath: Path;

        // The location of the lazyModule if it is a sub lazyModule declared throw an importation
        let importLoc: &Word;

        // The name of the module
        let moduleName: [c8];

        // The absolute root path of the package (to create a relative path with importPath)
        let packageDir: Path;        
    }

    prv {
        // The symbol set when the module is loaded for real
        let mut _finalized: &Symbol = EMPTY_SYMBOL;
    }

    /**
     * Construct a LazyModuleSymbol.
     *
     * @params:
     *   - name:       the declared name of the module
     *   - importLoc:  the location of the import statement that introduced it
     *   - path:       the filesystem path to the module file
     *   - packageDir: the root directory of the package containing the module
     *   - protection: visibility of the module (public by default)
     *
     * The symbol is created without loading or parsing the module file. The
     * module will be materialized only when accessed.
     */
    pub self (name:       [c8],
              importLoc:  &Word,
              path:       Path,
              packageDir: Path,
              protection: Protection)
        
        with super (importLoc, "", isWeak-> false, protection-> protection)
        , importLoc = importLoc
        , importPath = path
        , moduleName = name
        , packageDir = packageDir
        
    {}

    /**
     * @returns the finalized module symbol if the lazy module has been loaded,
     *          or `EMPTY_SYMBOL` if it has not yet been materialized.
     *
     * Once the module is loaded, this returns the real ModuleSymbol.
     */
    @field
    pub fn finalized (self)-> &Symbol {
        self._finalized
    }
    
    /**
     * Set the finalized module symbol.
     *
     * Called when the lazy module is resolved and replaced by a real
     * ModuleSymbol. After this assignment, the lazy symbol acts as a proxy
     * for the fully loaded module.
     */
    @field
    pub fn finalized (mut self, s: &Symbol) {
        self._finalized = s;
    }

    impl Streamable;
    impl Formattable {

        /**
         * Format the lazy module symbol for debugging or diagnostics.
         *
         * Prints:
         *   - "LazyModule: "
         *   - the import location,
         *   - the full name of the module.
         */
        pub over format (self, dmut stream: &Formatter) {
            stream:.write ("LazyModule: [", self.loc.str, " (", self._fullName.toStr (), ")", "]");
        }
    }

}
