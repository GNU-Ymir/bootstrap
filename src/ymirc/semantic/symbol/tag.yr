 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in tag;

use ymirc::lexing::word;
use ymirc::semantic::template_;
use ymirc::syntax::{declaration::_, expression};

use std::stream;

/**
 * A tag written on top of a declaration, `#[web::route ("/f")]`
 */
pub record TagSite {

    pub {
        // The name of the tag, the last identifier of its path
        let loc: &Word;

        // The path naming the tag
        let tag: &Expression;

        // The arguments the tag is constructed with, named ones included
        let args: [&Expression];
    }

    /**
     * @params:
     *    - loc:  the name of the tag
     *    - tag:  the path naming the tag
     *    - args: the arguments the tag is constructed with
     */
    pub self (loc: &Word, tag: &Expression, args: [&Expression])
        with loc = loc
        , tag = tag
        , args = args
    {}

    impl Streamable;
}

/**
 * An `apply` or a `self` overload of a tag, selected for a tag site
 */
pub record TagOverload {

    pub {
        // The overload, a template declaration unless it is a `self` taking no template parameter
        let decl: &Declaration;

        // The tag parameters bound to the arguments of the site, and the first template
        // parameter of the overload bound to the tagged symbol
        let mapper: TemplateMapper;
    }

    /**
     * @params:
     *    - decl:   the overload
     *    - mapper: the tag parameters and the first template parameter, bound
     */
    pub self (decl: &Declaration, mapper: TemplateMapper)
        with decl = decl
        , mapper = mapper
    {}

    impl Streamable;
}

/**
 * A tag site resolved for the symbol it tags: the tag it names, the arguments
 * bound to the parameters of the tag, and the overloads applying to the symbol
 */
pub record TagResolution {

    pub {
        // The tag site, as written on top of the declaration
        let site: TagSite;

        // The tag the site names, a TagSymbol
        let tag: &Symbol;

        // The parameters of the tag bound to the compile-time values of the arguments
        let params: TemplateMapper;

        // The `apply` overload merged into the tagged symbol, none for a registration-only tag
        let apply: (TagOverload)?;

        // The `self` overload run for the site, none if the tag declares none
        let ctor: (TagOverload)?;
    }

    /**
     * @params:
     *    - site:   the tag site
     *    - tag:    the tag it names
     *    - params: the parameters of the tag, bound
     *    - apply:  the `apply` overload selected, if any
     *    - ctor:   the `self` overload selected, if any
     */
    pub self (site: TagSite, tag: &Symbol, params: TemplateMapper, apply: (TagOverload)?, ctor: (TagOverload)?)
        with site = site
        , tag = tag
        , params = params
        , apply = apply
        , ctor = ctor
    {}

    impl Streamable;
}

/**
 * Symbol representing a tag declaration.
 *
 * ```
 * tag name (params) {
 *     globals          // one per tag, shared by every site
 *     apply overloads  // the rewrites merged into the tagged symbols
 *     self overloads   // the tag ctors, run once per tag site
 * }
 * ```
 *
 * The globals are symbols of its table. The `apply` and `self` overloads are
 * kept as declarations: they are only declared once instantiated for a tag
 * site, so overloads of different kinds can share the name `apply`. A `self`
 * overload is also kept as the template of a function, out of the table.
 */
@final
pub class TagSymbol over Symbol {

    pub {
        // The syntax declaration of the tag
        let decl: &TagDecl;
    }

    prv {
        // The `apply` overloads, in declaration order
        let mut _applies: [(&Declaration, Protection)] = [];

        // The `self` overloads, in declaration order
        let mut _ctors: [(&Declaration, Protection)] = [];

        // The `self` overloads, each as the template of a function instantiated for the tag sites
        let mut _ctorTemplates: [&TemplateSymbol] = [];
    }

    /**
     * @params:
     *   - loc:        the name of the tag
     *   - comm:       documentation comments attached to the declaration
     *   - decl:       the syntactic tag declaration
     *   - protection: visibility of the tag
     */
    pub self (loc:        &Word,
              comm:       [c8],
              decl:       &TagDecl,
              protection: Protection)

        with super (loc, comm, isWeak-> false, protection-> protection)
        , decl = decl
    {}

    /**
     * @returns: the parameters of the tag, the arguments of a tag site are given to
     */
    @field
    pub fn proto(self)-> FunctionPrototype {
        self.decl.proto
    }

    /**
     * @returns: the `apply` overloads, with their protection, in declaration order
     */
    @field
    pub fn applies(self)-> [(&Declaration, Protection)] {
        self._applies
    }

    /**
     * @returns: the `self` overloads, with their protection, in declaration order
     */
    @field
    pub fn ctors(self)-> [(&Declaration, Protection)] {
        self._ctors
    }

    /**
     * @returns: the template of a function a `self` overload is instantiated
     * from for the tag sites, a template without parameters if it takes none
     */
    pub fn ctorTemplate(self, decl: &Declaration)-> &TemplateSymbol {
        for i, c in self._ctors if c._0 is decl {
            return self._ctorTemplates[i];
        }

        panic;
    }

    /**
     * Append an `apply` overload
     *
     * @params:
     *   - decl:       a function, a class, an enum or a union named `apply`, or a template of one
     *   - protection: the protection it is declared with
     */
    pub fn insertApply(mut self, decl: &Declaration, protection: Protection) {
        self._applies ~= [(decl, protection)];
    }

    /**
     * Append a `self` overload
     *
     * @params:
     *   - decl:       a ctor, or a template of one
     *   - protection: the protection it is declared with
     *   - tmpl:       the template of the function it is instantiated from
     */
    pub fn insertCtor(mut self, decl: &Declaration, protection: Protection, tmpl: &TemplateSymbol) {
        self._ctors ~= [(decl, protection)];
        self._ctorTemplates ~= [tmpl];
    }

    impl Streamable;

}
