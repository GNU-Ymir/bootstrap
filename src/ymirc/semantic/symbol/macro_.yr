in macro_;

pub mod ::ctor;
pub mod ::rule;

use ymirc::utils::format;
use ymirc::lexing::{word, tokens};

use ymirc::syntax::declaration::_;

use std::stream;

/**
 * Symbol representing a macro declaration.
 *
 * MacroSymbol is attached to a `MacroDecl` and inserted into the symbol table
 * so that macro constructors and macro rules can be discovered during parsing
 * and semantic analysis. It stores only the syntactic declaration; all macro
 * expansion logic is handled by the macro subsystem.
 *
 * MacroSymbol:
 *   - inherits visibility from the declaration,
 *   - contains no validation-time generators,
 *   - serves as the anchor for macro constructors and rules.
 *
 */
pub class MacroSymbol over Symbol {

    pub {
        // The syntactic macro declaration
        let decl: &MacroDecl;
    }

    /**
     * Construct a MacroSymbol.
     *
     * @params:
     *   - loc:        source location of the macro declaration
     *   - comm:       documentation comments attached to the declaration
     *   - decl:       the syntactic macro declaration
     *   - protection: visibility of the macro
     *
     */
    pub self (loc:        &Word,
              comm:       [c8],
              decl:       &MacroDecl,
              protection: Protection)

        with super (loc, comm, isWeak-> false, protection-> protection)
        , decl = decl
    {}

    impl Streamable;

}
