/*
 * Declares the ErrorSymbol class.
 *
 * ErrorSymbol represents a placeholder symbol used when a declaration fails
 * validation. It allows the compiler to insert a symbol into the symbol table
 * even when the original declaration is invalid, ensuring that name resolution
 * and subsequent passes can continue without crashing.
 *
 * ErrorSymbol carries the associated ErrorMsg so that any later attempt to use
 * the symbol can surface the correct diagnostic.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::symbol::error
 * @File: ymirc/semantic/symbol/error.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2024-08-12
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in error;

use ymirc::utils::format;
use ymirc::lexing::word;

use ymirc::errors::_;
use ymirc::syntax::declaration::_;

/**
 * Symbol representing a failed declaration.
 *
 * ErrorSymbol is inserted into the symbol table when a declaration cannot be
 * validated. It preserves the structure of the symbol hierarchy and allows
 * name resolution to proceed, while ensuring that any later use of the symbol
 * produces the correct diagnostic.
 *
 * ErrorSymbol:
 *   - stores the ErrorMsg describing the validation failure,
 *   - is always private,
 *   - is always strong(not weak),
 *   - formats as the underlying error message.
 *
 * This class is used for error recovery and does not participate in normal
 * semantic behavior.
 */
@final
pub class ErrorSymbol over Symbol {

    pub {
        // The error message associated to the symbol
        let error: &ErrorMsg;
    }

    /**
     * Construct an ErrorSymbol.
     *
     * @params:
     *   - error: the error message associated with the failed declaration
     *
     * The symbol is created with:
     *   - EOF_WORD as its location,
     *   - empty documentation comments,
     *   - private protection.
     *
     * This ensures that the symbol can safely occupy a slot in the symbol table
     * without interfering with normal lookup rules.
     */
    pub self (error: &ErrorMsg)
        with super (EOF_WORD, ""s8, isWeak-> false, protection-> Protection::PRIVATE)
        , error = error
    {}

    impl Formattable {

        /**
         * Format the error symbol by printing its associated error message.
         *
         * This is used when the symbol appears in diagnostics or debugging output.
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(self.error);
        }

    }

}
