/*
 * Declares the ModuleSymbol class.
 *
 * ModuleSymbol represents the semantic information associated with a module. It
 * stores visibility and import-related metadata and acts as the root symbol for
 * all declarations contained in the module. A ModuleSymbol owns a symbol table
 * and participates in name resolution, import processing, and package
 * structure.
 *
 * A module may be:
 *   - external(`isExtern`): originating from another package,
 *   - global(`isGlobal`): if it is declared in it's own file,
 *   - imported from another file(`importLoc`): when created through an
 *     import statement rather than as the primary module being compiled.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::symbol::module
 * @File: ymirc/semantic/symbol/module.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2021-11-29
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in module;

use ymirc::utils::format;
use ymirc::lexing::{word, tokens};

use ymirc::syntax::declaration::_;
use ymirc::syntax::expression::_;

use std::stream;

/**
 * Symbol representing a module.
 *
 * ModuleSymbol is the root symbol for a module’s declarations. It stores:
 *
 *   - whether the module originates from an external package(`isExtern`),
 *   - whether it is the global module(`isGlobal`),
 *   - the location of the import that introduced it(`importLoc`), if any.
 *
 * A ModuleSymbol owns a symbol table containing all top-level declarations
 * (functions, types, globals, nested modules, etc.).
 *
 */
@final
pub class ModuleSymbol over Symbol {

    pub {
        // True iif the module was imported for an external package
        let isExtern: bool;

        // True iif the module is global
        let isGlobal: bool;

        // The location of the module if it is a sub module declared throw an importation
        let importLoc: &Word;
    }

    /**
     * Construct a ModuleSymbol.
     *
     * @params:
     *   - loc:       source location of the module declaration(or file header)
     *   - importLoc: location of the import that introduced this module, or
     *                EOF_WORD if this is the primary module being compiled
     *   - comm:      documentation comments attached to the module
     *   - isExtern:  true iff the module belongs to an external package
     *   - isGlobal:  true iff this module is defined in it's own file
     *   - protection: visibility of the module
     *
     */

    pub self (loc:        &Word,
              importLoc:  &Word,
              comm:       [c8],
              isExtern:   bool,
              isGlobal:   bool,
              protection: Protection)

        with super (loc, comm, isWeak-> false, protection-> protection)
        , importLoc = importLoc
        , isExtern = isExtern
        , isGlobal = isGlobal

    {}

    impl Streamable;
    impl Formattable {

        /**
         * Format the module symbol and its contents.
         *
         * Prints:
         *   - the module header(location and full name),
         *   - all entries in the module’s symbol table,
         *   - each child symbol formatted recursively.
         *
         * This is intended for debugging, diagnostics, and developer tooling.
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write("Module: [", self.loc.str, " (", self._fullName.toStr(), ")", "]");
            let inner = self._table.content;
            stream:.entabing();
            for n, i in inner {
                for s in i {
                    stream:.write("\n- ", n, ": ");
                    s.format(alias stream);
                }
            }

            stream:.detabing();
        }
    }

}
