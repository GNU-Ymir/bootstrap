/*
 * Declares the SymbolPath class.
 *
 * SymbolPath represents a fully qualified symbol name, split into its
 * hierarchical components and enriched with optional template specialization
 * information for each part. It is used throughout the compiler to represent
 * canonical symbol identities, perform structural comparisons, and generate
 * stable string forms for diagnostics, caching, and symbol-table operations.
 *
 * A SymbolPath consists of:
 *   - a list of path segments(e.g., ["core", "std", "etc", "foo"]),
 *   - a parallel list of optional TemplateMapper instances, one per segment.
 *
 * Template information is attached to the segment that owns the template
 * specialization, allowing the compiler to distinguish, for example:
 *     pkg::Vec!{i32}::Vec::push
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::semantic::symbol::path
 * @File: ymirc/semantic/symbol/path.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2024-02-21
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in path;

use ymirc::semantic::template_;
use std::{stream, io, fs::path};

use ymirc::utils::{format, comparison};

/**
 * Represents a hierarchical symbol path with optional template specialization.
 *
 * A SymbolPath stores:
 *   - `parts`:     the list of path segments,
 *   - `templates`: the list of template specializations, one per segment.
 *
 * Both arrays always have the same length. Template entries may be `none`,
 * indicating that the corresponding segment has no template specialization.
 *
 * SymbolPath supports:
 *   - parsing from a string using `::` as a separator,
 *   - structural comparison,
 *   - appending new segments or other SymbolPaths,
 *   - replacing the last segment(e.g., for file resolution),
 *   - extracting parent paths,
 *   - formatting with or without template information,
 *   - conversion to filesystem paths.
 *
 * This class is used heavily in symbol resolution, template instantiation,
 * module loading, and diagnostics.
 */
@final
pub class SymbolPath {

    prv {
        // The content of the path
        let mut _parts: [mut[c8]] = [];

        // The templates of the path
        let mut _tmpls: [mut(TemplateMapper)?] = [];
    }

    /**
     * Construct a SymbolPath by parsing a string.
     *
     * @params:
     *   - path:  the string to parse, using `::` as a separator
     *   - tmpls: the template mapper to attach to the last segment(optional)
     *
     * All intermediate segments receive `none` as their template mapper.
     *
     * Example:
     *   SymbolPath("pkg::Vec", tmpls)
     *   produces:
     *     parts  = ["pkg", "Vec"]
     *     templates = [none, tmpls]
     */
    pub self (path: [c8], tmpls: (TemplateMapper)? = none) {
        let sep = "::";
        let mut last = 0us;
        for i in 0us .. path.len {
            if (path[i .. $].len >= sep.len) {
                if (path[i .. i + sep.len] == sep) {
                    self._parts ~= [path[last .. i]];
                    self._tmpls ~= [cast!{TemplateMapper?} (none)];
                    last = i + sep.len;
                }
            }
        }

        if (last != path.len) {
            self._parts ~= [path[last .. $]];
            self._tmpls ~= [tmpls];
        }
    }

    /**
     * Internal constructor used to build a SymbolPath directly from arrays.
     *
     * @params:
     *   - path:  the list of path segments
     *   - tmpls: the list of template mappers, one per segment
     *
     * This avoids reparsing and is used by operations such as `push`, `parent`,
     * and `withFile`.
     */
    prv self (path: [[c8]], tmpls: [(TemplateMapper)?]) {
        self._parts ~= path;
        self._tmpls ~= tmpls;
    }

    /**
     * Convert the symbol path to a string.
     *
     * @params:
     *   - withTemplates: include template specializations if true
     *
     * The output uses `::` as a separator. Template specializations are appended
     * using the `!<template>` syntax.
     *
     * Example:
     *   pkg::Vec!{i32}::Vec::push
     */
    pub fn toStr(self, withTemplates: bool = true)-> [c8] {
        let sep = "::";
        let dmut stream = copy StringStream();
        for j, i in self._parts {
            if j != 0us {
                stream:.write(sep);
            }

            stream:.write(i);
            if (withTemplates) {
                if let Ok(x) = self._tmpls[j] {
                    stream:.write(format("!%::%", x.simpleFormat(), i));
                }
            }
        }

        return stream[];
    }

    /**
     * Convert the symbol path to a filesystem Path.
     *
     * @params:
     *   - withTemplates: include template specializations if true
     *
     * The resulting Path uses `::` as its separator, matching the module loader’s
     * expectations.
     */
    pub fn asStdPath(self, withTemplates: bool = false)-> Path {
        Path(self.toStr(withTemplates-> withTemplates), sep-> "::")
    }

    /**
     * Replace the last segment of the path with a new file name.
     *
     * @params:
     *   - f: the new final segment
     *
     * Used primarily when resolving module file names.
     */
    pub fn withFile(self, f: [c8])-> &SymbolPath {
        let dmut res = copy SymbolPath(self._parts, self._tmpls);
        if (res._parts.len != 0us) {
            res._parts = alias res._parts[0 .. $ - 1];
        }

        res._parts ~= [f];
        res
    }

    /**
     * @returns the last segment of the path, or an empty string if the path is empty.
     */
    @field
    pub fn file(self)-> [c8] {
        if (self._parts.len > 0) {
            return self._parts[$ - 1];
        }

        return "";
    }

    /**
     * @returns the parent path(all segments except the last).
     *
     * If the path is empty, returns the path unchanged.
     */
    @field
    pub fn parent(self)-> &SymbolPath {
        if (self._parts.len > 0) {
            return copy SymbolPath(self._parts[0 .. $ - 1], self._tmpls[0 .. $ - 1]);
        }

        return self;
    }


    /**
     * Append a string path to the current path.
     *
     * @params:
     *   - path:  the string to split and append
     *   - tmpls: the template mapper to attach to the last appended segment
     *
     * The string is split using `::`. All intermediate segments receive `none`.
     */
    pub fn push(self, path: [c8], tmpls: (TemplateMapper)? = none)-> &SymbolPath {
        let sep = "::";
        let dmut aux = copy SymbolPath(self._parts, self._tmpls);
        {
            let mut last = 0us;
            for i in 0us .. path.len {
                if (path[i .. $].len >= sep.len) {
                    if (path[i .. i + sep.len] == sep) {
                        aux._parts ~= [path[last .. i]];
                        aux._tmpls ~= [cast!{(TemplateMapper)?} (none)];
                        last = i + sep.len;
                    }
                }
            }

            if (last != path.len) {
                aux._parts ~= [path[last .. $]];
                aux._tmpls ~= [tmpls];
            }
        }

        aux
    }

    /**
     * Append another SymbolPath to the current path.
     *
     * @params:
     *   - path: the SymbolPath to append
     *
     * Both parts and template lists are concatenated.
     */
    pub fn push(self, path: &SymbolPath)-> &SymbolPath {
        let dmut aux = copy SymbolPath(self._parts, self._tmpls);
        aux._parts ~= path._parts;
        aux._tmpls ~= path._tmpls;

        aux
    }

    /**
     * Append another SymbolPath to the current path using the `/` operator.
     *
     * @params:
     *   - path: the SymbolPath to append
     *
     *
     * The original SymbolPath is not modified; a new instance is returned.
     * This operator provides a concise syntax for hierarchical path construction:
     *    ```
     *    let full = base / sub;
     *    ```
     * which is equivalent to:
     *    ```
     *    let full = base.push(sub);
     *    ```
     */
    pub fn opBinary {"/"} (self, path: &SymbolPath)-> &SymbolPath {
        self.push(path)
    }

    /**
     * Replace the template mapper of the last segment.
     *
     * @params:
     *   - tmpls: the new template mapper
     *
     * If the path is empty, no change is made.
     */
    pub fn withTemplates(self, tmpls: (TemplateMapper)?)-> &SymbolPath {
        let dmut aux = copy SymbolPath(self._parts, self._tmpls);
        if (self._tmpls.len != 0us) {
            aux._tmpls[$ - 1] = tmpls;
        }

        aux
    }

    /**
     * @returns the list of path segments.
     */
    @field
    pub fn parts(self)-> [[c8]] {
        self._parts
    }

    /**
     * @returns the list of template mappers, one per segment.
     */
    @field
    pub fn templates(self)-> [(TemplateMapper)?] {
        self._tmpls
    }


    impl Comparable!{&SymbolPath} {

        /**
         * Compare two SymbolPaths structurally.
         *
         * @params:
         *   - o: another SymbolPath
         *
         * Two paths are equal iff:
         *   - they have the same number of segments,
         *   - all segments match exactly,
         *   - all template mappers match pairwise(both none or both equal).
         */
        pub over opEquals(self, o: &SymbolPath)-> bool {
            if (self._parts.len != o._parts.len) return false;
            if (self._parts != o._parts) return false;
            for i, z in self._tmpls match (z, o._tmpls[i]) {
                (Ok(a: _), Ok(b: _)) => if (a != b) return false;
                (_, Ok()) => return false;
                (Ok(), _) => return false;
            }

            true
        }
    }

    impl std::stream::Streamable {

        /**
         * Write the string representation of the path into a StringStream.
         *
         * Equivalent to writing `toStr()` with templates included.
         */
        pub over toStream(self, dmut stream: &StringStream) {
            stream:.write(self.toStr());
        }
    }
}
