/*
 * Declares the EmptySymbol class.
 *
 * EmptySymbol is a placeholder symbol used to represent the absence of a
 * meaningful symbol. It is used in situations where the compiler needs a symbol
 * object for structural or semantic reasons, but no real declaration exists—for
 * example, a class with no destructor, or an unresolved reference that must
 * still be represented in the symbol table.
 *
 * EmptySymbol participates in the symbol hierarchy but carries no semantic
 * content. It is always private and always strong (never weak).
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::semantic::symbol::empty
 * @File: ymirc/semantic/symbol/empty.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2021-11-26
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in empty;

use ymirc::syntax::declaration::_;
use ymirc::utils::format;

use ymirc::lexing::word;
use std::stream;

/**
 * Placeholder symbol representing an empty or missing declaration.
 *
 * EmptySymbol is used when a symbol is required structurally but no actual
 * declaration exists. Examples include:
 *   - classes with no destructor (placeholder destructor symbol),
 *   - internal compiler constructs that require a symbol identity,
 *   - error-recovery paths where a symbol must be returned.
 *
 * EmptySymbol:
 *   - has no children,
 *   - has no semantic meaning,
 *   - is always private,
 *   - is always strong (not weak),
 *   - formats as `<empty-symbol>`.
 */
@final
pub class EmptySymbol over Symbol {

    /**
     * Construct an EmptySymbol at a specific location.
     *
     * @params:
     *   - loc: source location associated with the placeholder symbol
     *
     * The symbol is always private and always strong.
     */
    pub self (loc : &Word)
        with super (loc, ""s8, isWeak-> false, protection-> Protection::PRIVATE)
    {}

    /**
     * Construct an EmptySymbol with no location.
     *
     * Uses EOF_WORD as the location. This is typically used for internal
     * placeholders created by the compiler.
     */
    pub self ()
        with super (EOF_WORD, ""s8, isWeak-> false, protection-> Protection::PRIVATE)
    {}

    impl Streamable;
    impl Formattable {
        
        /**
         * Format the symbol as `<empty-symbol>`.
         *
         * Used for debugging, diagnostics, and internal tracing.
         */
        pub over format (self, dmut stream : &Formatter) {
            stream:.write ("<empty-symbol>");
        }
    }
}
