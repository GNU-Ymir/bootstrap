in def_;

use ymirc::utils::format;
use ymirc::lexing::{word, tokens};

use ymirc::semantic::generator::_;
use ymirc::syntax::declaration::_;

/**
 * Symbol representing a `def` declaration.
 *
 * A DefSymbol is the semantic counterpart of a `def` declaration in the AST.
 * It stores the syntactic declaration(`DefDecl`) and, once validated, caches
 * the generator produced for that definition. DefSymbol participates in the
 * standard symbol hierarchy and inherits all lookup, protection, and
 * referent-management behavior from Symbol.
 *
 * DefSymbol:
 *   - owns the AST node describing the definition,
 *   - may later hold a generator produced during semantic analysis.
 *
 * This class provides a lightweight bridge between syntax and semantic
 * generation for simple definitions.
 */
@final
pub class DefSymbol over Symbol {

    pub {
        /**
         * The AST declaration associated with this symbol.
         */
        let decl: &DefDecl;

        /**
         * Cached generator produced during semantic validation.
         *
         * Initially set to EMPTY_GENERATOR and replaced once the generator is
         * computed. This avoids recomputing generators for repeated accesses.
         */
        let mut generator: &Generator = EMPTY_GENERATOR;
    }

    /**
     * Construct a DefSymbol.
     *
     * @params:
     *   - loc:        source location of the symbol
     *   - comm:       documentation comments attached to the declaration
     *   - decl:       the AST node representing the `def` declaration
     *   - protection: visibility of the definition
     *
     * The symbol is always strong(not weak) and inherits all symbol-table
     * behavior from the base Symbol class.
     */
    pub self (loc:        &Word,
              comm:       [c8],
              decl:       &DefDecl,
              protection: Protection)

        with super (loc, comm, isWeak-> false, protection-> protection)
        , decl = decl
    {}

}
