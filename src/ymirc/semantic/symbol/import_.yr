in import_;

use ymirc::lexing::word;
use ymirc::semantic::symbol;

use ymirc::utils::format;
use std::stream;


/**
 * @params:
 *    - m:   an imported module
 *    - sym: a symbol a name resolution found
 * @returns: true iif 'sym' is 'm' or is declared somewhere inside it
 */
fn holds(lst: [&Symbol], sym: &Symbol)-> bool {
    for s in lst {
        if (s is sym) return true;
    }

    false
}

/**
 * @params:
 *    - m:   an imported module
 *    - sym: a symbol a name resolution found
 * @returns: true iif 'sym' is 'm' or is declared somewhere inside it
 */
pub fn declares(m: &Symbol, sym: &Symbol)-> bool {
    let mut current = sym;
    while (current !of EmptySymbol) {
        if (current is m) return true;

        current = current.referent;
    }

    false
}

/**
 * The modules a single `use` path made reachable by short name, the candidates
 * they offered, and the ones a resolution actually selected.
 *
 * A scope keeps one record per `use` path, so a brace group is tracked path by
 * path, and a `_` path keeps all the modules it expanded to in a single record.
 *
 * `use` never decides what is reachable -- package resolution and `mod` do that
 * -- it only lets a symbol be named by its short name. So a record is used when
 * a resolution *selected* a symbol that only this record offered: a candidate
 * that lost overload resolution, and a candidate the scope could have named
 * without the `use` anyway, both leave it unused.
 */
@final
pub class ImportInfo {

    pub {
        // The location of the last segment of the path, what a diagnostic points at
        let loc: &Word;

        // The path as it was written, for diagnostics
        let path: [c8];

        // True if the path ended with '_', importing every submodule at once
        let isWildcard: bool;
    }

    prot {
        // The modules the path resolved to
        let mut _modules: [&Symbol];

        // The subset of self._modules a selected symbol came from
        let mut _used: [&Symbol] = [];

        // The candidates this record offered that no other route made reachable
        let mut _offered: [&Symbol] = [];
    }

    /**
     * @params:
     *    - loc:        the location of the last segment of the used path
     *    - path:       the path as it was written
     *    - isWildcard: true iif the path ended with '_'
     *    - modules:    the modules the path resolved to
     */
    pub self (loc: &Word, path: [c8], isWildcard: bool, modules: [&Symbol])
        with loc = loc
        , path = path
        , isWildcard = isWildcard
        , _modules = modules
    {}

    /**
     * @returns: the modules the path resolved to
     */
    @field
    pub fn modules(self)-> [&Symbol] {
        self._modules
    }

    /**
     * @returns: the candidates this record offered
     */
    @field
    pub fn offered(self)-> [&Symbol] {
        self._offered
    }

    /**
     * @returns: the modules of the record a selected symbol came from
     */
    @field
    pub fn used(self)-> [&Symbol] {
        self._used
    }

    /**
     * @returns: true iif every module of the record is already used
     * @info: such a record needs no further recording, nothing is left to credit
     */
    @field
    pub fn isFullyUsed(self)-> bool {
        self._used.len == self._modules.len
    }

    /**
     * Record that this import offered 'sym' to a name resolution.
     * @info: the record ignores a symbol none of its modules declares, so a caller
     * can offer every new candidate to every import of the scope
     * @info: only the caller knows whether another route offered it too, and it
     * does not offer it when one did
     */
    pub fn offer(mut self, sym: &Symbol) {
        if (self.isFullyUsed) return;

        if (holds(self._offered, sym)) return;

        for m in self._modules {
            if (declares(m, sym)) {
                self._offered ~= [sym];
                return;
            }
        }
    }

    /**
     * Credit the module of this import that offered 'sym', if it did offer it.
     * @params:
     *    - sym: the symbol a resolution selected
     */
    pub fn markSelected(mut self, sym: &Symbol) {
        if (self.isFullyUsed) return;
        if (!holds(self._offered, sym)) return;

        for m in self._modules {
            if (self.isUsed(m)) continue;
            if (declares(m, sym)) {
                self._used ~= [m];
                return;
            }
        }
    }

    /**
     * @returns: true iif 'm' was already credited
     */
    fn isUsed(self, m: &Symbol)-> bool {
        for u in self._used {
            if (u is m) return true;
        }

        false
    }

    impl Streamable;
    impl Formattable {

        /**
         * Format the import and the modules it was used through.
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write("Import: [", self.path, "]");
            stream:.entabing();
            for m in self._modules {
                stream:.write("\n- ", m.path.toStr(), if (self.isUsed(m)) { " (used)" } else { "" });
            }

            stream:.detabing();
        }
    }

}
