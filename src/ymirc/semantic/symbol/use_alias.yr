 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in use_alias;

use ymirc::utils::format;
use ymirc::lexing::word;

use ymirc::syntax::declaration::_;

use std::stream;

/**
 * Symbol representing the local name a `use` binds its result to.
 *
 * The alias is a module scope whose table is always empty: the modules the
 * `use` resolved to are attached to it as imports, so a member lookup through
 * the alias sees exactly what a scope having used those modules would see.
 *
 * The symbol is never inserted in the table of its referent, it is reachable
 * only through the alias list of the scope that declared it.
 *
 */
@final
pub class UseAliasSymbol over ModuleSymbol {

    /**
     * @params:
     *    - name: the local name the `use` binds its result to
     */
    pub self (name: &Word)
        with super (name, EOF_WORD, "", isExtern-> false, isGlobal-> false, protection-> Protection::PRIVATE)
    {}

    /**
     * Look up symbols by name inside the aliased modules.
     */
    pub over getLocalSymbols(self, name: [c8], protection: Protection = Protection::PUBLIC)-> dmut &ImutSymbolList {
        let dmut res = copy ImutSymbolList();
        for module in self._used {
            module.getSymbols(name, protection-> protection, fromUsed-> true, res-> alias res);
        }

        alias res
    }

    /**
     * Look up symbols by name inside the aliased modules.
     */
    pub over getLocalSymbols(mut self, name: [c8], protection: Protection = Protection::PUBLIC)-> dmut &SymbolList {
        let dmut res = copy SymbolList();
        for i in 0us .. self._used.len {
            let dmut module = alias (self._used[i]);
            module:.getSymbols(name, protection-> protection, fromUsed-> true, res-> alias res);
        }

        alias res
    }

    /**
     * Look up symbols of the aliased modules whose names are within a
     * Levenshtein distance, for suggestions.
     */
    pub over getCloseLocalSymbols(self, name: [c8], distance: usize, protection: Protection = Protection::PUBLIC)-> dmut &ImutSymbolList {
        let dmut res = copy ImutSymbolList();
        for module in self._used {
            module.getCloseSymbols(name, distance, protection-> protection, fromUsed-> true, res-> alias res);
        }

        alias res
    }

    impl Streamable;
    impl Formattable {

        /**
         * Format the alias and the modules it binds.
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write("UseAlias: [", self.loc.str, "]");
            stream:.entabing();
            for m in self._used {
                stream:.write("\n- ", m.path.toStr());
            }

            stream:.detabing();
        }
    }

}
