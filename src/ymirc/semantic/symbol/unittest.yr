in unittest;

use ymirc::utils::format;
use ymirc::lexing::{word, tokens};
use ymirc::semantic::generator::_;

use ymirc::syntax::declaration::_;
use ymirc::syntax::expression::_;
use std::stream;

/**
 * Represents a unit test declaration in the semantic symbol table.
 *
 * A UnitTestSymbol is created for each UnitTestDecl encountered during
 * semantic analysis. It stores:
 *   - the syntactic declaration of the test,
 *   - the generator produced after validation(or EMPTY_GENERATOR before),
 *   - the symbolic identity of the test, always private.
 *
 * Unit tests are compiled as private symbols and do not participate in
 * name resolution. Their generator is produced only after semantic
 * validation of the test body.
 */
@final
pub class UnitTestSymbol over Symbol {

    pub {
        // The syntaxix declaration of the function
        let decl: &UnitTestDecl;
    }

    prv {
        // The generator of the unittest after validation
        let mut _gen: &Generator = EMPTY_GENERATOR;
    }

    /**
     * Creates a new UnitTestSymbol.
     *
     * @params:
     *   - loc:  the source location of the `unittest` keyword.
     *   - comm: the extracted documentation comment, if any.
     *   - decl: the syntactic UnitTestDecl node.
     *
     * Unit tests are always private symbols, so the constructor forces
     * Protection::PRIVATE.
     */
    pub self (loc:  &Word,
              comm: [c8],
              decl: &UnitTestDecl)

        with super (loc, comm, isWeak-> false, protection-> Protection::PRIVATE)
        , decl = decl
    {}

    /**
     * Returns the generator associated with the unit test.
     *
     * The generator may still be EMPTY_GENERATOR if the test has not yet been
     * validated by the semantic pass.
     */
    @field
    pub fn generator(self)-> &Generator {
        self._gen
    }

    /**
     * Sets the generator of the unit test after semantic validation.
     *
     * @params:
     *   - gen: the generator produced for the test body.
     */
    @field
    pub fn generator(mut self, gen: &Generator) {
        self._gen = gen;
    }


    impl Streamable;
}
