 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in table;

use ymirc::semantic::symbol;
use ymirc::syntax::declaration::_;

use ymirc::utils::string;
use std::stream;

/**
 * Symbol table used by Symbol instances.
 *
 * A Table maps names to lists of symbols. It stores:
 *   - all declared symbols,
 *   - the subset of symbols declared public,
 *   - template symbols stored separately,
 *   - the total number of inserted symbols.
 *
 * Table supports:
 *   - insertion and replacement,
 *   - removal of individual symbols,
 *   - clearing all entries,
 *   - protection-aware lookup,
 *   - fuzzy lookup using Levenshtein distance,
 *   - retrieval of public or private subsets.
 *
 * Table does not perform hierarchical lookup; that is handled by Symbol.
 */
@final
pub class Table {

    // The content of the table
    let mut _content: [[c8] => dmut[&Symbol]] = copy [];

    // The list of symbols that are public(subset of self._content)
    let mut _publicSyms: [[c8] => dmut[&Symbol]] = copy [];

    // All the templates(solution) contained in the table
    let dmut _templates: [&Symbol] = [];

    /**
     * Create an empty table containing no symbols.
     */
    pub self () {}

    /*!
     * ================================================================================
     * ================================================================================
     * =========================           GETTERS            =========================
     * ================================================================================
     * ================================================================================
     */

    /**
     * @returns all template symbols stored in the table.
     *
     * Template symbols are stored separately from normal content because they
     * participate in template resolution rather than standard name lookup.
     */
    @field
    pub fn templates(self)-> [&Symbol] {
        self._templates
    }


    /**
     * @returns all template symbols(mutable view).
     */
    @field
    pub fn templates(mut self)-> dmut[&Symbol] {
        return alias self._templates;
    }

    /**
     * @returns the full mapping of names to symbol lists.
     *
     * This includes both public and non-public symbols.
     */
    @field
    pub fn content(self)-> [[c8] => [&Symbol]] {
        self._content
    }

    /**
     * @returns the mapping of names to public symbol lists.
     *
     * This is a subset of `content`, containing only symbols declared public.
     */
    @field
    pub fn publicContent(self)-> [[c8] => [&Symbol]] {
        self._publicSyms
    }

    /**
     * @returns the full mapping of names to symbol lists(mutable view).
     */
    @field
    pub fn content(mut self)-> dmut[[c8] => [&Symbol]] {
        alias self._content
    }

    /**
     * @returns the mapping of names to public symbol lists(mutable view).
     */
    @field
    pub fn publicContent(mut self)-> dmut[[c8] => [&Symbol]] {
        alias self._publicSyms
    }

    /**
     * @returns true iff `sym` is declared public under the given name.
     */
    pub fn isPublic(self, name: [c8], sym: &Symbol)-> bool {
        if let Ok(v) = self._publicSyms[name] {
            for s in v {
                if (s is sym) return true;
            }
        }

        false
    }

    /*!
     * ================================================================================
     * ================================================================================
     * =========================          INSERTION           =========================
     * ================================================================================
     * ================================================================================
     */

    /**
     * Insert a symbol into the table.
     *
     * @params:
     *   - name:     the name under which the symbol is stored
     *   - sym:      the symbol to insert
     *   - replace:  if true, replace any existing symbols with the same name
     *
     * If `replace` is false, the symbol is appended to the existing list.
     * Public symbols are also inserted into the public subset.
     */
    pub fn insert(mut self, name: [c8], dmut sym: &Symbol, replace: bool = false) {
        if (replace) {
            self._content[name] = copy [alias sym];
        } else if let Ok(dmut v) = alias self._content[name] {
            v ~= [alias sym];
            self._content[name] = alias v;
        } else {
            self._content[name] = copy [alias sym];
        }

        match sym.protection {
            Protection::PUBLIC => {
                if (replace) {
                    self._publicSyms[name] = copy [alias sym];
                } else if let Ok(dmut v) = alias self._publicSyms[name] {
                    v ~= [alias sym];
                    self._publicSyms[name] = alias v;
                } else {
                    self._publicSyms[name] = copy [alias sym];
                }
            }
        }
    }


    /**
     * Insert a template symbol into the table.
     *
     * Template symbols are not stored in the main content map. They are used
     * exclusively during template resolution.
     */
    pub fn insertTemplate(mut self, dmut sym: &Symbol) {
        self._templates ~= [alias sym];
    }


    /**
     * Remove a symbol from the table.
     *
     * @params:
     *   - name: the name under which the symbol is stored
     *   - sym:  the symbol to remove(matched by address identity)
     *
     * If the symbol is not found, nothing happens. If the last symbol under
     * a name is removed, the entry is erased entirely.
     */
    pub fn remove(mut self, name: [c8], dmut sym: &Symbol) {
        if let Ok(dmut v) = alias self._content[name] {
            for x in 0 .. v.len {
                if v[x] is sym {
                    v = v[0 .. x] ~ v[x + 1 .. $];
                    break;
                }
            }

            if v.len == 0 { self._content:.remove(name); }
            else {
                self._content[name] = alias v;
            }
        }

        if let Ok(dmut v) = alias self._publicSyms[name] {
            for x in 0 .. v.len {
                if v[x] is sym {
                    v = v[0 .. x] ~ v[x + 1 .. $];
                    break;
                }
            }

            if v.len == 0 { self._publicSyms:.remove(name); }
            else {
                self._publicSyms[name] = alias v;
            }
        }
    }


    /**
     * Remove all symbols from the table.
     *
     * Clears normal content, public symbols, and template symbols.
     */
    pub fn clear(mut self) {
        self._content = copy [];
        self._publicSyms = copy [];
        self._templates = [];
    }

    /*!
     * ================================================================================
     * ================================================================================
     * =========================          SEARCHING           =========================
     * ================================================================================
     * ================================================================================
     */

    /**
     * Find all symbols with the given name.
     *
     * @params:
     *   - name:       the name to search for
     *   - protection: filter by protection level(PUBLIC or PRIVATE)
     *
     * @returns a mutable list of symbols matching the name and protection.
     *
     * PUBLIC returns only public symbols.
     * PRIVATE returns all symbols.
     */
    pub fn find(mut self, name: [c8], protection: Protection = Protection::PRIVATE)-> dmut[&Symbol] {
        if protection == Protection::PUBLIC {
            if let Ok(dmut v) = alias self._publicSyms[name] {
                return alias v;
            }
        }

        else if let Ok(dmut x) = alias self._content[name] {
            return alias x;
        }

        return [];
    }

    /**
     * Find all symbols with the given name(immutable view).
     *
     * @params:
     *   - name:       the name to search for
     *   - protection: filter by protection level
     *
     * @returns an immutable list of symbols matching the name and protection.
     */
    pub fn find(self, name: [c8], protection: Protection = Protection::PRIVATE)-> [&Symbol] {
        if protection == Protection::PUBLIC {
            if let Ok(v) = self._publicSyms[name] {
                return v;
            }
        }

        else if let Ok(x) = self._content[name] {
            return x;
        }

        return [];
    }

    /**
     * Find all symbols whose names are within a given Levenshtein distance.
     *
     * @params:
     *   - name:       the target name
     *   - distance:   maximum allowed Levenshtein distance
     *   - protection: filter by protection level
     *
     * @returns a list of symbols whose names are close to `name`.
     *
     * Used for error recovery and suggestion generation.
     */
    pub fn findClose(self, name: [c8], distance: usize, protection: Protection = Protection::PRIVATE)-> [&Symbol] {
        if (name.len <= distance) return [];

        let mut lst = self._content;
        if protection == Protection::PUBLIC {
            lst = self._publicSyms;
        }

        let mut res: [mut &Symbol] = [];
        for n, s in lst if n.len > distance + 1us {
            let levDist = string::levenshteinDistance(n, name);
            if (levDist <= distance) {
                for j in s if j !of EmptySymbol {
                    res ~= [j];
                }
            }
        }

        res
    }
}
