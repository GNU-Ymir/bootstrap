 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in args;

use std::{io, config::_, env};

/**
 * Stores all command-line options passed to the compiler. Fields:
 *
 */
pub record YmirArguments {

    // list of include packages
    pub let includes: [[c8]] = [];

    // path of the root module to compile
    pub let file: [c8] = "";

    // list of version flags(-fversion)
    pub let fversion: [[c8]] = [];

    // enable debug mode
    pub let debug: bool;

    // enable Ymir dump mode
    pub let fdump: bool;

    // disable semantic validation
    pub let noSem: bool;

    // disable lint/expansion
    pub let noLint: bool;

    // optimization level (-O0 .. -O3), 0 means no optimization pass is run
    pub let optLevel: u32;

    // dump the optimized YIL (--fdump-yil-opt)
    pub let fdumpYilOpt: bool;

    // dump the YIL after each individual optimization pass (--fdump-yil-opt-each)
    pub let fdumpYilOptEach: bool;

    // print the per pass optimization statistics (--fopt-stats)
    pub let foptStats: bool;

    // names of the passes forcefully enabled, whatever the optimization level (-fenable-pass=)
    pub let enabledPasses: [[c8]] = [];

    // names of the passes forcefully disabled, whatever the optimization level (-fdisable-pass=)
    pub let disabledPasses: [[c8]] = [];

    pub self (file: [c8],
              includes: [[c8]] = [],
              fversion: [[c8]] = [],
              debug: bool = false,
              fdump: bool = false,
              noSem: bool = false,
              noLint: bool = false,
              optLevel: u32 = 0u32,
              fdumpYilOpt: bool = false,
              fdumpYilOptEach: bool = false,
              foptStats: bool = false,
              enabledPasses: [[c8]] = [],
              disabledPasses: [[c8]] = [])
        with file = file
        , includes = includes
        , fversion = fversion
        , debug = debug
        , fdump = fdump
        , noSem = noSem
        , noLint = noLint
        , optLevel = optLevel
        , fdumpYilOpt = fdumpYilOpt
        , fdumpYilOptEach = fdumpYilOptEach
        , foptStats = foptStats
        , enabledPasses = enabledPasses
        , disabledPasses = disabledPasses
    {}
}
