/*
 * Declares core-level enumerations used by the Ymir runtime and compiler.
 *
 * reference Ymir Runtime(YRT) functions, operator override identifiers. This
 * module centralizes all symbolic names required by the compiler to TypeInfo
 * categories, and core module paths. These enums provide a single authoritative
 * source for runtime entry points and core type utilities, ensuring consistency
 * across semantic validation, code generation, and the backend.
 *
 * The values declared here are tightly coupled to the Ymir runtime ABI and
 * must remain synchronized with the implementation of the YRT. They are used
 * by:
 *   - the generator(to emit calls to runtime helpers),
 *   - the validator(to resolve operator overrides and traits),
 *   - the TypeInfo subsystem,
 *   - the core library loader.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::global::core_
 * @File: ymirc/global/core_.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *   - Emile Cadorel <emile.cadorel@davidson.fr>
 *
 * @Created(YYYY-MM-DD): 2022-01-26
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in core_;

use std::fs::path;

/**
 * Names of Ymir Runtime(YRT) helper functions.
 *
 * These identifiers correspond to runtime entry points used by the generator to
 * implement core language features such as allocation, slicing, exception
 * handling, futures, and unittest coverage. They must remain synchronized with
 * the YRT implementation.
 */
pub enum YRuntimeFuncs
| ALLOC_CLASS         = "_yrt_alloc_class"
| ALLOC_NO_SET_SLICE  = "_yrt_alloc_slice_no_set"
| ALLOC_SET_SLICE     = "_yrt_alloc_slice"
| APPEND_SLICE        = "_yrt_append_slice"
| BEGIN_CATCH         = "_yrt_exc_begin_catch"
| CALL_FPTR_AS_DG     = "_yrt_call_fptr_as_dg"
| CALL_LAZY           = "_yrt_call_lazy"
| CHECK_FUTURE        = "_yrt_check_finished_future"
| CMP_CLASS_OF_TYPE   = "_yrt_cmp_class_of_type"
| CONCAT_SLICE        = "_yrt_concat_slices"
| COVERAGE_HIT_BRANCH = "_yrt_unittest_coverage_hit_branch"
| COVERAGE_HIT_ENTER  = "_yrt_unittest_coverage_hit_enter"
| COVERAGE_HIT_EXIT   = "_yrt_unittest_coverage_hit_exit"
| DUPLICATE_SLICE     = "_yrt_dup_slice"
| DUPLICATE_TUPLE     = "_yrt_dup_tuple"
| MAP_COPY            = "_yrt_dup_map"
| MAP_EMPTY           = "_yrt_map_empty"
| MAP_FIND            = "_yrt_map_find"
| MAP_INSERT          = "_yrt_map_insert"
| MAP_ITER_BEGIN      = "_yrt_map_iter_begin"
| MAP_ITER_DEL        = "_yrt_map_iter_del"
| MAP_ITER_END        = "_yrt_map_iter_end"
| MAP_ITER_KEY        = "_yrt_map_iter_key"
| MAP_ITER_NEXT       = "_yrt_map_iter_next"
| MAP_ITER_VAL        = "_yrt_map_iter_val"
| PANIC               = "_yrt_exc_panic"
| REGISTER_UNIT_TEST  = "_yrt_register_unittest"
| RUN_MAIN_DEBUG      = "_yrt_run_main_debug"
| RUN_MAIN_RELEASE    = "_yrt_run_main"
| RUN_UNITTESTS       = "_yrt_run_unittests"
| SPAWN_FUTURE        = "_yrt_spawn_future"
| THROW_EXCEPT        = "_yrt_exc_throw"
| WAIT_FUTURE         = "_yrt_wait_future";

/**
 * Names of operator override methods.
 *
 * These identifiers correspond to special methods that user-defined types may
 * implement to override operators(binary, unary, indexing, iteration, etc.).
 * The semantic validator resolves these names when checking operator usage.
 */
pub enum OpOverrideNames
| BIN                = "opBinary"
| BIN_RIGHT          = "opBinaryRight"
| CMP                = "opCmp"
| CONTAINS           = "opContains"
| DOLLAR             = "opDollar"
| EQUALS             = "opEquals"
| INDEX_ASSIGN       = "opIndexAssign"
| INDEX              = "opIndex"
| RANGE              = "opRange"
| RANGE_RIGHT        = "opRangeRight"
| UNARY              = "opUnary"
| BEGIN              = "begin"
| END                = "end"
| NEXT               = "next"
| GET_ITER           = "get"
| LEN                = "len"
| DCOPY              = "deepCopy";

/**
 * Identifiers used by the TypeInfo subsystem.
 *
 * These values categorize the different runtime type representations(arrays,
 * slices, maps, tuples, closures, primitives, etc.). They are used by the
 * generator and runtime to construct and inspect TypeInfo objects.
 */
pub enum TypeInfoIDS
| ARRAY              = "ARRAY"
| BOOL               = "BOOL"
| CHAR               = "CHAR"
| CLOSURE            = "CLOSURE"
| DELEGATE           = "DELEGATE"
| FLOAT              = "FLOAT"
| FPTR               = "FUNC_PTR"
| MAP                = "MAP"
| OBJECT             = "OBJECT"
| OPTION             = "OPTION"
| POINTER            = "POINTER"
| RANGE              = "RANGE"
| SIGNED_INT         = "SIGNED_INT"
| SLICE              = "SLICE"
| STRUCT             = "STRUCT"
| TUPLE              = "TUPLE"
| UNSIGNED_INT       = "UNSIGNED_INT"
| VOID               = "VOID";

/**
 * Paths to core modules required by the compiler.
 *
 * These modules provide fundamental runtime types and exceptions that must be
 * available during semantic validation and code generation.
 */
pub enum UseCoreModules
| EXCEPTION          = Path("core/exception")
| ASSERT_EXCEPTION   = Path("core/exception/assertion")
| IO_EXCEPTION       = Path("core/exception/io")
| OPTION_EXCEPTION   = Path("core/exception/option")
| TYPES              = Path("core/types");

/**
 * Paths to atomic utilities used by the runtime.
 *
 * These functions implement global and monitor-level locking primitives.
 */
pub enum AtomicUtils
| LOCK_GLOBAL        = Path("core/atom/_yrt_lock_global")
| UNLOCK_GLOBAL      = Path("core/atom/_yrt_unlock_global")
| LOCK_MONITOR       = Path("core/atom/atomicMonitorEnter")
| UNLOCK_MONITOR     = Path("core/atom/atomicMonitorExit");

/**
 * Paths to range-related helper functions.
 *
 * These utilities implement range operations such as containment, stepping,
 * and reversing.
 */
pub enum RangeUtils
| OP_CONTAINS_FUNC   = Path("core/types/range/opContains")
| STEP_BY_FUNC       = Path("core/types/range/stepBy")
| REVERSE_FUNC       = Path("core/types/range/reverse");

/**
 * Paths to global trait definitions.
 *
 * These traits are recognized by the compiler and used during semantic
 * validation(Iterable, Hashable, Copiable, etc.).
 */
pub enum GlobalTraitUtils
| ITERABLE_TRAIT     = Path("core/types/Iterable")
| HASHABLE_TRAIT     = Path("core/types/Hashable")
| COPIABLE_TRAIT     = Path("core/types/Copiable");

/**
 * Paths to core mathematical helper functions.
 *
 * These functions implement integer and floating-point power operations,
 * modulo, and floating-point comparisons.
 */
pub enum MathUtils
| FFMOD_FUNC         = Path("core/math/ffmod")
| IPOW_FUNC          = Path("core/math/ipow")
| FIPOW_FUNC         = Path("core/math/fipow")
| FFPOW_FUNC         = Path("core/math/ffpow")
| FLOAT_CMP_FUNC     = Path("core/math/fcmp");

/**
 * Paths to map-related helper functions.
 *
 * These functions implement hashing, key comparison, removal, length
 * computation, and deep-copying of map values.
 */
pub enum MapUtils
| HASH_KEY_FUNC      = Path("core/types/map/hashKey")
| CMP_KEY_FUNC       = Path("core/types/map/compareKeys")
| REMOVE_FUNC        = Path("core/types/map/removeKey")
| LEN_FUNC           = Path("core/types/map/len")
| DCOPY_FUNC         = Path("core/types/map/deepCopyMap");

/**
 * Paths to delegate and function-pointer conversion utilities.
 */
pub enum DelegateUtils
| CAST_FPTR_TO_DG    = Path("core/types/function/castToDG");

/**
 * Paths to core exception types.
 *
 * These are used by the validator and generator when resolving exception
 * types, constructing throw expressions, and generating runtime error paths.
 */
pub enum ExceptionUtils
| EMPTY_VAL_OPTION   = Path("core/exception/option/EmptyValOption")
| EMPTY_ERR_OPTION   = Path("core/exception/option/EmptyErrOption")
| OPTION_ERR         = Path("core/exception/option/OptionException")
| IO_ERR             = Path("core/exception/io/IOError")
| ASSERT_ERR         = Path("core/exception/assertion/AssertError")
| EXCEPTION          = Path("core/exception/Exception");

/**
 * Paths to slice-related helper functions.
 *
 * These functions implement comparison, equality, containment, and deep-copy
 * operations for array and slice types.
 */
pub enum SliceUtils
| OP_CMP_FUNC        = Path("core/types/array/opCmp")
| OP_EQUALS_FUNC     = Path("core/types/array/opEquals")
| OP_CONTAINS_FUNC   = Path("core/types/array/opContains")
| DCOPY_FUNC         = Path("core/types/array/deepCopySlice");

/**
 * Paths to TypeInfo-related core types.
 *
 * These modules define the runtime structures used to represent type metadata
 * (TypeInfo, TypeIDs, FieldInfo).
 */
pub enum TypeUtils
| TYPEINFO_TYPE      = Path("core/types/info/TypeInfo")
| TYPEIDS_TYPE       = Path("core/types/info/TypeIDs")
| FIELDINFO_TYPE     = Path("core/types/info/FieldInfo");
