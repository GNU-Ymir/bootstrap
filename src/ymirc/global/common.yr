in common;

pub lazy __YMIR_VERSION__ = "1.2";

/**
 * File extensions used by the Ymir toolchain.
 *
 */
pub enum
// extension for Ymir source files(.yr)
| YMIR_EXTENSION = "yr"

// extension for Ymir Intermediate Language files(.yil)
| YIL_EXTENSION  = "yil"
-> CommonVars;


/**
 * Compilation modes supported by the Ymir compiler.
 *
 */
pub enum
// debug build(extra checks, no optimizations)
| DEBUG      = "debug"

// standalone build(no runtime dependencies)
| STANDALONE = "standalone"

// unit test build(enables __test blocks)
| UNITTEST   = "unittest"
-> Versions;
