/*
 * Declares the State class, which stores the global compilation state.
 *
 * This module centralizes all configuration flags, paths, version settings, and
 * environment-dependent values used throughout the compiler. The State object
 * acts as the shared context for a compilation unit, tracking options such as
 * debug mode, unittest activation, include directories, architecture sizes, and
 * output configuration.
 *
 * The global State instance is created lazily and persists for the duration of
 * a compilation. All compiler subsystems — lexing, syntax, semantic validation,
 * code generation, and backend — rely on this shared context to make consistent
 * decisions about the environment, target architecture, enabled features, and
 * user-provided options.
 *
 * The State class also manages derived information such as relative paths,
 * dependency-dump locations, and module filtering rules, ensuring that
 * incremental builds and diagnostic modes behave predictably.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::global::state
 * @File: ymirc/global/state.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2021-11-20
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in state;

use std::{io, env, fs::{sys, path}, stream};
use ymirc::utils::string;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          LAZYS          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * The current working directory of the compiler process.
 *
 * Used as the reference point for computing relative paths.
 */
lazy __GLOB_CURRENT_LOC__ = env::currentDir();

/**
 * The singleton State instance used for the entire compilation.
 *
 * This value is never exposed directly; all access goes through
 * module-level getters and setters.
 */
lazy dmut __instance__: [State] = copy [State()];

/**
 * Cache mapping absolute paths to their relative equivalents.
 *
 * Used to avoid recomputing relative paths repeatedly during diagnostics
 * and dependency tracking.
 *
 */
lazy mut __GLOB_REL__: [mut[[c8] => mut[c8]]] = copy [copy []];

/**
 * The counter used to generate the unique identifiers of the macro expansions.
 *
 * It is part of the global state, and thus reset between two compilations, so
 * that compiling the same file twice generates the same identifiers.
 */
lazy dmut __MACRO_UID__ = copy [0us];

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =================================          GET INSTANCES          ==================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * Resets the global State instance to its default configuration.
 *
 * Used when running multiple compilations in the same process(e.g., unit
 * tests, REPL, or incremental tooling). Also clears the cached relative-path
 * table.
 *
 */
pub fn resetToDefault() {
    __instance__[0] = State();
    __GLOB_REL__[0] = copy [];
    __MACRO_UID__[0] = 0us;
}

/**
 * Generates the unique identifier of a macro expansion(the '__uid' of the
 * macro rewriter).
 *
 * @return an identifier that was never returned since the last reset of the
 * global state.
 */
pub fn nextMacroUniqID()-> usize {
    __MACRO_UID__[0] += 1us;
    __MACRO_UID__[0]
}

/**
 * Computes a path relative to the compiler's working directory.
 *
 * Results are cached for efficiency. If the path lies outside the working
 * directory, the original path is returned unchanged.
 *
 * @param:
 *    - p:  A filesystem path as a UTF-8 string.
 *
 * @return   The relative path if applicable, otherwise the original.
 */
pub fn relativePath(p: [c8])-> [c8] {
    if (p == []) return p;

    if let Ok(res) = __GLOB_REL__[0][p] {
        return res;
    }

    let loc = Path(p);
    if (__GLOB_CURRENT_LOC__.isPrefix(loc)) {
        let res = loc.removePrefix(__GLOB_CURRENT_LOC__).toStr();
        __GLOB_REL__[0][p] = res;
        return res;
    }

    return p;
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          GETTERS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * @return true if debug mode is enabled.
 *
 * Debug mode activates additional runtime checks and disables certain
 * optimizations to improve debuggability.
 *
 */
pub fn isDebugActive()-> bool {
    __instance__[0]._isDebug
}

/**
 * @return true if YIL export mode is active.
 *
 * When enabled, the compiler emits the Ymir Intermediate Language(YIL)
 * representation to object files.
 */
pub fn isExportYIL()-> bool {
    __instance__[0]._exportYIL
}

/**
 * @return the output directory where the YIL files should be written.
 */
pub fn yilOutputDir()-> Path {
    __instance__[0]._yilOutputDir
}

/**
 * @return true if unittest mode is enabled.
 *
 * This activates parsing and code generation of `__test` blocks.
 *
 */
pub fn isUnittestActive()-> bool {
    __instance__[0]._isUnitTest
}

/**
 * @return true if code coverage instrumentation is active.
 *
 * Coverage is only enabled when unittest mode is active.
 *
 */
pub fn isCodeCoverageActive()-> bool {
    __instance__[0]._isUnitTest && __instance__[0]._isCodeCoverage
}

/**
 * @return true if verbose mode is enabled.
 *
 * Verbose mode prints additional diagnostic information during compilation.
 *
 */
pub fn isVerboseActive()-> bool {
    __instance__[0]._isVerbose
}

/**
 * @return the path of the package being compiled.
 */
pub fn package()-> Path {
    __instance__[0]._package
}

/**
 * @return the root module passed to the compiler.
 */
pub fn rootModule()-> Path {
    __instance__[0]._rootModule
}

/**
 * Checks whether a version identifier is active.
 *
 * Version identifiers are used for conditional compilation(`__version`).
 *
 * @param:
 *    - v:  The version string to check.
 *
 * @return   true iff the version is active.
 */
pub fn isVersionActive(v: [c8])-> bool {
    let version = copy [std::char::toUpper(i) for i in v];
    version in __instance__[0]._versions
}

/**
 * @return the prefix directory used to resolve include paths.
 *
 * The include prefix is the directory from which the compiler expects to find
 * the standard library sources. When the compiler executable is located, the
 * prefix is assumed to contain an `include/ymir/<version>` directory holding
 * the core modules of the Ymir standard library.
 *
 * If the executable location is not known(e.g., when invoked without a
 * resolved path), the compiler falls back to the system-wide installation
 * directory `/usr/include/ymir/<version>`.
 *
 */
pub fn includePrefix()-> Path {
    __instance__[0]._includePrefix
}

/**
 * @return the directory containing the Ymir core library.
 */
pub fn corePath()-> Path {
    __instance__[0]._corePath
}

/**
 * @return the list of include directories specified via `-I`.
 */
pub fn includeDirs()-> [Path] {
    copy [p for p, _ in __instance__[0]._includeDirs]
}

/**
 * @return true if standalone mode is active.
 *
 * Standalone mode disables reliance on system libraries and forces the compiler
 * to embed or statically link required components.
 */
pub fn isStandalone()-> bool {
    __instance__[0]._isStandalone
}

/**
 * @return true iff Ymir IR dumping is enabled.
 *
 * This is a debugging feature similar to GCC's `-fdump-tree-*`.
 */
pub fn isYmirDumpingActive()-> bool {
    __instance__[0]._isYmirDump
}

/**
 * @return the optimization level requested by the user(0 .. 3).
 *
 * At level 0 the YIL optimizer runs no pass at all, so the YIL handed to the
 * backend is exactly the raw expander output.
 */
pub fn optLevel()-> u32 {
    __instance__[0]._optLevel
}

/**
 * @return true iff the optimized YIL should be dumped(`--fdump-yil-opt`).
 */
pub fn isYilOptDumpingActive()-> bool {
    __instance__[0]._isYilOptDump
}

/**
 * @return true iff the YIL should be dumped after each individual optimization
 * pass(`--fdump-yil-opt-each`).
 */
pub fn isYilOptDumpingEachActive()-> bool {
    __instance__[0]._isYilOptDumpEach
}

/**
 * @return true iff the per pass optimization statistics should be printed
 * (`--fopt-stats`).
 */
pub fn isOptStatsActive()-> bool {
    __instance__[0]._isOptStats
}

/**
 * @return true iff the pass named `name` was forcefully enabled by the user
 * (`-fenable-pass=`), whatever the optimization level.
 */
pub fn isPassForceEnabled(name: [c8])-> bool {
    name in __instance__[0]._enabledPasses
}

/**
 * @return true iff the pass named `name` was forcefully disabled by the user
 * (`-fdisable-pass=`), whatever the optimization level.
 */
pub fn isPassForceDisabled(name: [c8])-> bool {
    name in __instance__[0]._disabledPasses
}

/**
 * @return true iff the control flow graph of at least one frame should be
 * dumped(`--fdump-cfg=`).
 */
pub fn isCfgDumpingActive()-> bool {
    __instance__[0]._cfgDumpFilters.len != 0us
}

/**
 * @return true iff the control flow graph of the frame named `name` should be
 * dumped.
 *
 * A frame is selected when one of the `--fdump-cfg=` filters is `*`, or is a
 * substring of its mangled name: mangled names are unreadable, and asking for
 * the graph of `foo` is what one actually wants to type.
 */
pub fn isCfgDumped(name: [c8])-> bool {
    for f, _ in __instance__[0]._cfgDumpFilters {
        if (f == "*") return true;
        if (string::contains(name, f)) return true;
    }

    false
}

/**
 * @return true if dependency dumping is enabled.
 *
 * Used for incremental compilation to track which files changed.
 */
pub fn isDumpDependenciesActive()-> bool {
    __instance__[0]._isDumpDeps
}

/**
 * @return the directory where dependency information should be written.
 */
pub fn dependencyDumpDir()-> Path {
    __instance__[0]._dumpDepDir
}

/**
 * @return true if documentation dumping(`-fdoc`) is enabled.
 */
pub fn isDocDumpingActive()-> bool {
    __instance__[0]._isDumpDoc
}

/**
 * @return the file where documentation output should be written.
 */
pub fn docDumpFile()-> Path {
    __instance__[0]._dumpDocFile
}

/**
 * @return true if symbol tree dumping is enabled.
 *
 * This is a debugging feature for inspecting the semantic symbol tree.
 */
pub fn isSymTreeDumpingActive()-> bool {
    __instance__[0]._isSymTreeDump
}

/**
 * @return the size in bits of the pointer type on the target architecture.
 */
pub fn pointerArchSize()-> u32 {
    __instance__[0]._sizeTypeSize
}

/**
 * @return the size in bits of the largest supported floating-point type.
 */
pub fn floatArchSize()-> u32 {
    __instance__[0]._floatTypeSize
}

/**
 * @returns the maximum size an array can take inside a frame
 * */
pub fn arrayMaxStackSize()-> usize {
    __instance__[0]._stackArrayMaxSize
}

/**
 * @return the maximum number of iterations allowed for compile-time
 * unrolled loops.
 */
pub fn maxCteLoopIter()-> usize {
    __instance__[0]._maxCteLoopIter
}

/**
 * @return true if module filtering is active.
 *
 * When enabled, only a subset of modules will be compiled.
 */
pub fn hasModuleFilters()-> bool {
    __instance__[0]._filteringModules
}

/**
 * @return the list of module paths that should be compiled when filtering
 * is active.
 */
pub fn moduleFilters()-> [Path] {
    __instance__[0]._pathFilters
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SETTERS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * Sets the path of the compiler executable.
 *
 * Also updates the include prefix based on the executable's directory.
 */
pub fn setExecutable(name: [c8]) {
    __instance__[0]._executable = Path(name);
    state::setPrefix(__instance__[0]._executable.parent().toStr());
}

/**
 * Sets the package path being compiled.
 */
pub fn setPackage(package: Path) {
    __instance__[0]._package = package;
}

/**
 * Sets the root module of the compilation.
 */
pub fn setRootModule(path: Path) {
    __instance__[0]._rootModule = path;
}

/**
 * Enables YIL export mode and sets the output file path.
 */
pub fn activateYILExport(path: Path) {
    __instance__[0]._exportYIL = true;
    __instance__[0]._yilOutputDir = path;
}

/**
 * Enables debug mode.
 */
pub fn activateDebug() {
    __instance__[0]._isDebug = true;
}

/**
 * Enables unittest mode.
 */
pub fn activateUnittest() {
    __instance__[0]._isUnitTest = true;
}

/**
 * Disables code coverage instrumentation(activated by default when activateUnittest is called the first time).
 */
pub fn deactivateCodeCoverage() {
    __instance__[0]._isCodeCoverage = false;
}

/**
 * Enables verbose mode.
 */
pub fn activateVerbose() {
    __instance__[0]._isVerbose = true;
}

/**
 * Enables standalone mode.
 */
pub fn activateStandalone() {
    __instance__[0]._isStandalone = true;
}

/**
 * Enables documentation dumping and sets the output file.
 */
pub fn activateDocDumping(loc: Path) {
    __instance__[0]._isDumpDoc = true;
    __instance__[0]._dumpDocFile = loc;
}

/**
 * Enables Ymir IR dumping.
 */
pub fn activateYmirDumping() {
    __instance__[0]._isYmirDump = true;
}

/**
 * Sets the optimization level(clamped to the 0 .. 3 range).
 */
pub fn setOptLevel(level: u32) {
    __instance__[0]._optLevel = if (level > 3u32) { 3u32 } else { level };
}

/**
 * Enables the dumping of the optimized YIL.
 */
pub fn activateYilOptDumping() {
    __instance__[0]._isYilOptDump = true;
}

/**
 * Enables the dumping of the YIL after each individual optimization pass.
 */
pub fn activateYilOptDumpingEach() {
    __instance__[0]._isYilOptDumpEach = true;
}

/**
 * Enables the printing of the per pass optimization statistics.
 */
pub fn activateOptStats() {
    __instance__[0]._isOptStats = true;
}

/**
 * Forcefully enables an optimization pass, whatever the optimization level.
 */
pub fn forceEnablePass(name: [c8]) {
    __instance__[0]._enabledPasses[name] = ();
}

/**
 * Forcefully disables an optimization pass, whatever the optimization level.
 */
pub fn forceDisablePass(name: [c8]) {
    __instance__[0]._disabledPasses[name] = ();
}

/**
 * Enables the dumping of the control flow graph of the frames whose mangled name
 * contains `filter`(`*` selecting every frame).
 */
pub fn activateCfgDumping(filter: [c8]) {
    __instance__[0]._cfgDumpFilters[filter] = ();
}

/**
 * Enables dependency dumping and sets the output directory.
 */
pub fn activateDependencyDumping(loc: Path) {
    __instance__[0]._isDumpDeps = true;
    __instance__[0]._dumpDepDir = loc;
}

/**
 * Enables symbol tree dumping.
 */
pub fn activateSymTreeDumping() {
    __instance__[0]._isSymTreeDump = true;
}

/**
 * Activates a version identifier for conditional compilation.
 *
 * The version string is normalized to uppercase.
 */
pub fn addVersion(v: [c8]) {
    let version = copy [std::char::toUpper(i) for i in v];
    __instance__[0]._versions[version] = ();
}

/**
 * Adds a directory to the include search path(`-I` option).
 */
pub fn addIncludeDir(dir: [c8]) {
    __instance__[0]._includeDirs[Path(dir)] = ();
}

/**
 * Sets the core library path if valid from current directory, fall back on default path otherwise.
 */
pub fn setPrefix(prefix: [c8]) {
    let path = Path(prefix).push(__instance__[0]._includePrefix);
    if (fs::sys::isDir(path)) {
        __instance__[0]._corePath = path;
    } else {
        __instance__[0]._corePath = Path("/usr").push(__instance__[0]._includePrefix);
    }
}

/**
 * Sets the pointer size(in bits) for the target architecture.
 */
pub fn setPointerArchSize(size: u32) {
    __instance__[0]._sizeTypeSize = size;
}

/**
 * Sets the size(in bits) of the largest supported floating-point type.
 */
pub fn setFloatArchSize(size: u32) {
    __instance__[0]._floatTypeSize = size;
}

/**
 * Set the maximum size an array can take inside a frame
 * */
pub fn setArrayMaxStackSize(size: usize) {
    __instance__[0]._stackArrayMaxSize = size;
}

/**
 * Sets the maximum number of iterations allowed for compile-time loop
 * unrolling.
 */
pub fn setMaxCteLoopIter(nb: usize) {
    __instance__[0]._maxCteLoopIter = nb;
}

/**
 * Adds a module path to the list of modules to compile when filtering is
 * active.
 */
pub fn insertPathFilter(p: Path) {
    __instance__[0]._filteringModules = true;
    __instance__[0]._pathFilters ~= [p];
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          IMPLEM          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * Implementation of the global State class.
 *
 * The State object encapsulates all compilation-wide configuration and
 * environment information, including:
 *   - command-line options(debug, verbose, unittest, standalone, etc.),
 *   - architecture characteristics(pointer size, float size),
 *   - include directories and core library paths,
 *   - version flags and conditional compilation settings,
 *   - output configuration(YIL export, doc dump, dependency dump),
 *   - module filtering for incremental or selective builds.
 *
 */
record State {

    pub {

        /**
         * Whether debug mode is active. Enables additional runtime checks and
         * disables certain optimizations to improve debuggability.
         *
         * */
        let mut _isDebug: bool = false;


        /**
         * Whether verbose mode is active. When enabled, the compiler prints
         * additional diagnostic information.
         *
         * */
        let mut _isVerbose: bool = false;


        /**
         * Whether standalone mode is active. Standalone mode disables reliance
         * on system libraries and forces the compiler to embed or statically
         * link required components.
         *
         * */
        let mut _isStandalone: bool = false;

        /**
         * Whether documentation dumping(`-fdoc`) is enabled. When active, the
         * compiler emits a JSON documentation file.
         *
         * */
        let mut _isDumpDoc: bool = false;

        /**
         * Output file for documentation dumping. Only meaningful when
         * `_isDumpDoc` is true.
         *
         * */
        let mut _dumpDocFile: Path = Path("");

        /**
         * Whether Ymir IR dumping is enabled(`-fdump-ymir`). This is a
         * debugging feature similar to GCC's `-fdump-tree-*`.
         *
         * */
        let mut _isYmirDump: bool = false;

        /**
         * The optimization level requested by the user(`-O0` .. `-O3`). At
         * level 0 no optimization pass is run at all, and the YIL handed to the
         * backend is the raw expander output.
         *
         * */
        let mut _optLevel: u32 = 0u32;

        /**
         * Whether the optimized YIL should be dumped(`--fdump-yil-opt`).
         *
         * */
        let mut _isYilOptDump: bool = false;

        /**
         * Whether the YIL should be dumped after every individual optimization
         * pass(`--fdump-yil-opt-each`). Used to pinpoint the exact pass that
         * introduced a bad transformation.
         *
         * */
        let mut _isYilOptDumpEach: bool = false;

        /**
         * Whether the per pass optimization statistics should be printed at the
         * end of the expansion step(`--fopt-stats`).
         *
         * */
        let mut _isOptStats: bool = false;

        /**
         * Names of the optimization passes forcefully enabled whatever the
         * optimization level(`-fenable-pass=`).
         *
         * */
        let dmut _enabledPasses: [[c8] => ()] = copy [];

        /**
         * Names of the optimization passes forcefully disabled whatever the
         * optimization level(`-fdisable-pass=`).
         *
         * */
        let dmut _disabledPasses: [[c8] => ()] = copy [];

        /**
         * Names, or name fragments, of the frames whose control flow graph must
         * be dumped as graphviz(`--fdump-cfg=`). The special filter `*` selects
         * every frame of the module.
         *
         * */
        let dmut _cfgDumpFilters: [[c8] => ()] = copy [];

        /**
         * Whether symbol tree dumping is enabled. Used for debugging the
         * semantic symbol tree.
         *
         */
        let mut _isSymTreeDump: bool = false;


        /**
         * Whether dependency dumping is enabled. Used for incremental
         * compilation to track which files changed.
         *
         * */
        let mut _isDumpDeps: bool = false;

        /**
         * Directory where dependency information should be written.
         *
         * */
        let mut _dumpDepDir: Path = Path("");


        /**
         * Whether YIL export mode is active. When enabled, the compiler emits
         * the Ymir Intermediate Language.
         *
         * */
        let mut _exportYIL: bool = false;

        /**
         * Output directory for YIL export.
         *
         * */
        let mut _yilOutputDir: Path = Path("");

        /**
         * Whether unittest mode is active. Enables parsing and execution of
         * `__test` blocks.
         *
         * */
        let mut _isUnitTest: bool = false;

        /**
         * Whether code coverage instrumentation is active. Enabled by default,
         * but only meaningful when unittest mode is active.
         *
         * */
        let mut _isCodeCoverage: bool = true;

        /**
         * Base directory used to locate the standard library.
         *
         * The compiler expects this directory to contain:
         *     include/ymir/<version>
         *
         * When the executable path is known, this prefix is derived from the
         * executable's directory. Otherwise, the compiler falls back to `/usr`.
         *
         * */
        let _includePrefix: Path = Path("include/ymir/" ~ common::MIDGARD_VERSION);

        /**
         * Fully resolved path to the standard library root.
         *
         * Computed as:
         *     <prefix>/include/ymir/<version>
         *
         * or `/usr/include/ymir/<version>` if the executable location is unknown.
         *
         * */
        let mut _corePath: Path;

        /**
         * Path to the compiler executable. Used to derive the include prefix
         * when available.
         *
         * */
        let mut _executable: Path = Path("");

        /**
         * Path of the package being compiled. Typically the directory
         * containing the root module.
         *
         */
        let mut _package: Path = Path("");

        /**
         * Path of the root module passed to the compiler.
         * */
        let mut _rootModule: Path = Path("");

        /**
         * Set of include directories specified via `-I`.
         * Stored as a map for efficient membership testing.
         */
        let dmut _includeDirs: [Path => ()] = copy [];

        /**
         * Set of active version identifiers for conditional compilation. Stored
         * in uppercase for normalization.
         *
         */
        let dmut _versions: [[c8] => ()] = copy [];

        /**
         * Size in bits of the pointer type on the target architecture.
         * Defaults to 64 bits.
         * */
        let mut _sizeTypeSize: u32 = 64u32;

        /**
         * Size in bits of the largest supported floating-point type. Defaults
         * to 128 bits(e.g., `__float80`, aligned on 16 bytes).
         *
         */
        let mut _floatTypeSize: u32 = 128u32;

        /**
         * Maximum number of iterations allowed for compile-time loop unrolling.
         * */
        let mut _maxCteLoopIter: usize = 1024us;

        /**
         * Maximum size an array on the stack can be
         * */
        let mut _stackArrayMaxSize: usize = 1048576us; // 1MB

        /**
         * List of module paths to compile when module filtering is active. Only
         * meaningful when `_filteringModules` is true.
         *
         */
        let mut _pathFilters: [mut Path] = [];

        /**
         * Whether module filtering is active. When enabled, only modules listed
         * in `_pathFilters` are compiled.
         *
         */
        let mut _filteringModules: bool = false;
    }

    /**
     * Constructs a new State object with default configuration. Initializes
     * `_corePath` based on the fallback system prefix `/usr`.
     *
     */
    pub self ()
        with _corePath = Path("/usr").push(self._includePrefix)
    {}

    impl Streamable;
}
