in comparison;


/**
 * Provides structural equality for classes.
 *
 * The default implementation compares two values of the same dynamic type by:
 *   - first delegating to `super.opEquals` when the superclass defines one,
 *   - then comparing all fields declared in the class using their own `opEquals`
 *     implementations.
 *
 * This establishes a uniform, inheritance-aware notion of structural equality.
 * Subclasses may override `opEquals` to refine or restrict equality, but should
 * always call `super.opEquals` first to preserve the superclass invariants.
 *
 * Equality succeeds only when:
 *   - `o` has the same dynamic type as `self`, and
 *   - all superclass and field comparisons succeed.
 */
pub trait Comparable {T} {
    
    pub fn opEquals (self, o: T)-> bool {
                 
        if let t: typeof(self) = o {
            t;
            
            cte if __pragma!compile (self.super) {
                if !self.super.opEquals (o)
                    return false;
            }
            
            cte for i in 0 .. typeof (self)::field_infos.len {
                let name = cte {typeof (self)::field_infos [i].name};
                let a = __pragma!field (self, name);
                let b = __pragma!field (t, name);

                if a != b return false;
            }

            return true;
        }

        return false;
    }
}
