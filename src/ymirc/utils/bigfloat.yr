/*
 * Declares the BigFloat class.
 *
 * BigFloat provides arbitrary-precision floating-point arithmetic using the
 * MPFR library. It behaves like a normal floating-point number, supporting
 * arithmetic operators, comparisons, conversions, and formatted output.
 *
 * Special values (NaN, +inf, -inf) are tracked explicitly to ensure
 * predictable semantics independent of MPFR’s internal flags.
 *
 * <h2>Overview</h2>
 * 
 * BigFloat provides arbitrary-precision floating-point arithmetic based on the
 * MPFR library. It behaves like a normal floating-point number but with
 * significantly higher precision (1024 bits by default) and predictable
 * IEEE-754-like semantics for NaN and infinities.
 *
 * <h2>Basic Usage</h2>
 * ```yr
 * use ymirc::utils::bigfloat;
 *
 * let a = copy BigFloat(1230.5);
 * let b = copy BigFloat("3.1415926535897932384626");
 *
 * let c = 24 + (a * b + 10.0);
 * println("c = %", c);          // high-precision result
 *
 * if c > 10000 {
 *     println("Large value");
 * }
 * ```
 *
 * <h2>Special Values</h2>
 * ```yr
 * let nan  = copy BigFloat::nan();
 * let pinf = copy BigFloat::inf(true);
 * let ninf = copy BigFloat::inf(false);
 *
 * println(nan.isNan);          // true
 * println(pinf.isPositiveInf); // true
 * println(ninf.isNegativeInf); // true
 * ```
 *
 * <h2>Interoperability</h2>
 * BigFloat can be constructed from:
 *   - `f32`, `f64`
 *   - `BigInt`
 *   - string representations
 *
 * And supports mixed arithmetic:
 * ```yr
 * let x = copy BigFloat(12.0);
 * println(x + 3);        // integer promoted to BigFloat
 * println(3.5 * x);      // float promoted to BigFloat
 * ```
 *
 * <h2>Precision</h2>
 * 
 * All BigFloat instances currently use 1024-bit precision. Future versions may
 * allow per-instance precision control.
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::utils::bigfloat
 * @File: ymirc/utils/bigfloat.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2023-08-09
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in bigfloat;

use std::{io, conv, traits, stream};
use ymirc::utils::{gmp, bigint};

pub class BigFloatError over Exception {
    pub let msg: [c32];
    pub self (msg: [c32]) with msg = msg {}
    impl Streamable;
}

/**
 * Arbitrary-precision floating-point number.
 *
 * BigFloat wraps an MPFR value and provides high-precision arithmetic with
 * predictable IEEE-754-like semantics. It supports:
 *
 *   - construction from integers, floats, and strings,
 *   - arithmetic operators (+, -, *, /, %, ^^),
 *   - comparisons,
 *   - formatted output,
 *   - explicit NaN and infinity handling,
 *   - automatic cleanup of MPFR resources.
 *
 * Precision is currently fixed at 1024 bits for all instances.
 *
 * @note
 *   BigFloat tracks NaN and infinities manually. Operations involving these
 *   values follow IEEE-754 rules.
 */
@final
pub class BigFloat {

    prv {
        // lib gmp content
        let dmut _content: mpfr_t = mpfr_t ();

        let mut _contentInit: bool = false;

        let mut _isNan: bool = false;

        let mut _isInf: bool = false;

        let mut _isPositive: bool = true; // only for inf
    }
    
    /**
     * Constructs a BigFloat from an already-initialized MPFR value.
     *
     * @params:
     *   - content: an initialized MPFR object
     *
     * @note
     *   Used internally after MPFR arithmetic operations.
     */
    prv self (content: mpfr_t)
        with _content = content, _contentInit = true
    {}
    
    /**
     * Constructs a BigFloat from a BigInt.
     *
     * @params:
     *   - b: the integer to convert
     *
     * @behavior:
     *   - Initializes an MPFR value with 1024-bit precision.
     *   - Converts the BigInt into the MPFR representation.
     */
    pub self (b: &BigInt) {
        self._contentInit = true;
        mpfr_init2 (alias &self._content, 1024us);

        let z = b.getZ ();
        mpfr_set_z (alias &self._content, &z, mpfr_rnd_t::MPFR_RNDN);
    }
    
    /**
     * Constructs a BigFloat equal to 0.0.
     */
    pub self zero ()
        with self (0.0)
    {}
    
    /**
     * Constructs a BigFloat representing NaN.
     *
     * @note
     *   The internal MPFR value is not initialized for NaN.
     */
    pub self nan ()
        with _isNan = true
    {}

    /**
     * Constructs a BigFloat representing positive or negative infinity.
     *
     * @params:
     *   - positive: true for +inf, false for -inf
     */
    pub self inf (positive: bool)
        with _isInf = true
        , _isPositive = positive
    {}
    
    /**
     * Constructs a BigFloat from a 32-bit floating-point value.
     *
     * @params:
     *   - x: the value to convert
     *
     * @behavior:
     *   - Delegates to the f64 constructor.
     */
    pub self (x: f32)
        with self (cast!f64 (x))
    {}
    
    /**
     * Constructs a BigFloat from a 64-bit floating-point value.
     *
     * @params:
     *   - x: the value to convert
     *
     * @behavior:
     *   - Detects NaN and infinities explicitly.
     *   - Otherwise initializes an MPFR value and stores the number.
     */
    pub self (x: f64) {
        let mut z = x;
        if (x != z) {
            self._isNan = true;
        } else if (x == f64::inf) {
            self._isInf = true;
        } else if (x == -f64::inf) {
            self._isInf = true;
            self._isPositive = false;
        } else {
            self._contentInit = true;
            mpfr_init2 (alias &self._content, 1024us);
            mpfr_set_d (alias &self._content, x, mpfr_rnd_t::MPFR_RNDN);
        }
    }

    /**
     * Constructs a BigFloat from a string representation.
     *
     * @params:
     *   - x:    the string to parse
     *   - base: numeric base (default: 10)
     *
     * @behavior:
     *   - Initializes an MPFR value with 1024-bit precision.
     *   - Parses the string using MPFR’s `mpfr_set_str`.
     */
    pub self (x: [c8], base: u32 = 10u32) {
        self._contentInit = true;
        mpfr_init2 (alias &self._content, 1024us);

        mpfr_set_str (alias &self._content, x.toStringZ (), base, mpfr_rnd_t::MPFR_RNDN);
    }

    /*!
     * ================================================================================
     * ================================================================================
     * ========================             GETTERS              ======================
     * ================================================================================
     * ================================================================================
     */
    
    /**
     * @returns: true iff the value is NaN.
     */
    @field
    pub fn isNan (self)-> bool {
        self._isNan
    }

    /**
     * @returns: true iff the value is +inf
     * */
    @field
    pub fn isPositiveInf (self)-> bool {
        self._isInf && self._isPositive
    }

    /**
     * @returns: true iff the value is -inf
     * */
    @field
    pub fn isNegativeInf (self)-> bool {
        self._isInf && !self._isPositive
    }

    /**
     * Returns the underlying MPFR value.
     *
     * @returns:
     *   A reference to the internal `mpfr_t`.
     *
     * @note
     *   Intended for low-level interop only.
     */
    pub fn getF (self)-> mpfr_t {
        self._content
    }

    /*!
     * ================================================================================
     * ================================================================================
     * =========================             ADD              =========================
     * ================================================================================
     * ================================================================================
     */

    /**
     * Adds two BigFloat values.
     *
     * @params:
     *   - o: the right operand
     *
     * @returns:
     *   A new BigFloat containing the result.
     *
     * @behavior:
     *   - NaN propagates.
     *   - Inf + Inf with opposite signs → NaN.
     *   - Inf + finite → Inf.
     *   - Otherwise uses MPFR addition.
     */
    pub fn opBinary {"+"} (self, o: &BigFloat)-> &BigFloat {
        // Nan + anything = nan
        if (self._isNan || o._isNan) return copy BigFloat::nan ();

        match (self._isInf, o._isInf) {
            (true, true) => {
                // -inf + inf = Nan || inf + -inf = NaN
                if self._isPositive != o._isPositive {
                    return copy BigFloat::nan ();
                }

                // inf + inf = inf || -inf + -inf = -inf
                return copy BigFloat::inf (self._isPositive);
            }
            (true, false) => {
                // x(inf) + y || x(-inf) + y => x
                return copy BigFloat::inf (self._isPositive);
            }            
            (false, true) => {
                // x + y(inf) || x + y(-inf) => y        
                return copy BigFloat::inf (o._isPositive);
            }
        }
        
        // x + y
        let dmut res = mpfr_t ();
        mpfr_init2 (alias &res, 1024us);
        mpfr_add (alias &res, &self._content, &o._content, mpfr_rnd_t::MPFR_RNDN);

        copy BigFloat (res)
    }


    /**
     * Adds a BigFloat and a numeric value.
     *
     * @params:
     *   - o: converted to BigFloat
     */
    pub fn opBinary {"+", T} (self, o: T)-> &BigFloat {
        self + copy BigFloat (o)
    }
    
    /**
     * Adds a numeric value and a BigFloat, with `self` as right operand.
     *
     * @params:
     *   - o: converted to BigFloat
     *   
     */
    pub fn opBinaryRight {"+", T} (self, o: T)-> &BigFloat {
        copy BigFloat (o) + self
    }

    /*!
     * ================================================================================
     * ================================================================================
     * =========================             SUB              =========================
     * ================================================================================
     * ================================================================================
     */

    /**
     * Subtracts two BigFloat values.
     *
     * @behavior:
     *   - NaN propagates.
     *   - Inf - Inf with same sign → NaN.
     *   - Inf - finite → Inf.
     *   - finite - Inf → -Inf.
     *   - Otherwise uses MPFR subtraction.
     */
    pub fn opBinary {"-"} (self, o: &BigFloat)-> &BigFloat {
        if (self._isNan || o._isNan) copy BigFloat::nan ();

        match (self._isInf, o._isInf) {
            (true, true) => {
                // inf - inf = Nan || -inf - (-inf) = Nan
                if self._isPositive == o._isPositive {
                    return copy BigFloat::nan ();        
                }
                
                // inf - -inf = inf || -inf - inf = -inf                
                return copy BigFloat::inf (self._isPositive);                    
            }
            (true, false) => {
                // x(inf) - y || x(-inf) - y => x
                return copy BigFloat::inf (self._isPositive);    
            }
            (false, true) => {
                // x - y(inf) || x - y(-inf) => -y
                return copy BigFloat::inf (!o._isPositive);    
            }
        }
        
        let dmut res = mpfr_t ();
        mpfr_init2 (alias &res,  1024us);
        mpfr_sub (alias &res, &self._content, &o._content, mpfr_rnd_t::MPFR_RNDN);

        copy BigFloat (res)
    }

    /**
     * Subtract a BigFloat and a numeric value.
     *
     * @params:
     *   - o: converted to BigFloat
     */
    pub fn opBinary {"-", T} (self, o: T)-> &BigFloat {
        self - copy BigFloat (o)
    }

    /**
     * Subtract a BigFloat and a numeric value, with `self` as right operand.
     *
     * @params:
     *   - o: converted to BigFloat
     */
    pub fn opBinaryRight {"-", T} (self, o: T)-> &BigFloat {
        copy BigFloat (o) - self
    }

    /*!
     * ================================================================================
     * ================================================================================
     * =========================             MUL              =========================
     * ================================================================================
     * ================================================================================
     */

    /**
     * Multiplies two BigFloat values.
     *
     * @behavior:
     *   - NaN propagates.
     *   - 0 * Inf → NaN.
     *   - Inf * finite → Inf with correct sign.
     *   - Inf * Inf → Inf or -Inf.
     *   - Otherwise uses MPFR multiplication.
     */
    pub fn opBinary {"*"} (self, o: &BigFloat)-> &BigFloat {
        if (self._isNan || o._isNan) return copy BigFloat::nan ();
        match (self._isInf, o._isInf) {
            (true, true) => {
                // inf * inf = inf || inf * -inf = -inf || -inf * -inf = inf
                return copy BigFloat::inf (self._isPositive == o._isPositive);
            }
            (true, false) => {                
                let cmp = mpfr_cmp_ui (&o._content, 0u64);                    
                if cmp == 0 {
                    // 0 * inf = Nan
                    return copy BigFloat::nan ();
                }

                let sign = (cmp > 0);
                return copy BigFloat::inf (self._isPositive == sign);                                
            }
            (false, true) => {                                
                let cmp = mpfr_cmp_ui (&self._content, 0u64);                    
                if cmp == 0 {
                    // 0 * inf = Nan
                    return copy BigFloat::nan ();
                }

                let sign = (cmp > 0);
                return copy BigFloat::inf (o._isPositive == sign);                
            }                
        }
        
        let dmut res = mpfr_t ();
        mpfr_init2 (alias &res, 1024us);
        mpfr_mul (alias &res, &self._content, &o._content, mpfr_rnd_t::MPFR_RNDN);

        copy BigFloat (res)
    }

    /**
     * Multiplies a BigFloat and a numeric value.
     *
     * @params:
     *   - o: converted to BigFloat
     */
    pub fn opBinary {"*", T} (self, o: T)-> &BigFloat {
        self * copy BigFloat (o)
    }

    /**
     * Multiplies a BigFloat and a numeric value, with `self` as right operand.
     *
     * @params:
     *   - o: converted to BigFloat
     */
    pub fn opBinaryRight {"*", T} (self, o: T)-> &BigFloat {
        copy BigFloat (o) * self
    }

    /*!
     * ================================================================================
     * ================================================================================
     * =========================            DIVIDE            =========================
     * ================================================================================
     * ================================================================================
     */

    /**
     * Divides two BigFloat values.
     *
     * @throws:
     *   - BigFloatError if dividing by zero.
     *
     * @behavior:
     *   - NaN propagates.
     *   - Inf / Inf → NaN.
     *   - finite / Inf → 0 with correct sign.
     *   - Inf / finite → Inf with correct sign.
     *   - Otherwise uses MPFR division.
     */
    pub fn opBinary {"/"} (self, o: &BigFloat)-> &BigFloat
        throws BigFloatError
    {        
        if (self._isNan || o._isNan) return copy BigFloat::nan ();
        match (self._isInf, o._isInf) {
            (true, true) => {
                return copy BigFloat::nan ();
            }
            (false, true) => {
                let cmp = mpfr_cmp_ui (&self._content, 0u64);
                let sign = (cmp > 0);
                
                let dmut res = copy BigFloat::zero ();
                res._isPositive = (sign == o._isPositive);

                return res;
            }
            (true, false) => {
                let cmp = mpfr_cmp_ui (&o._content, 0u64);                    
                if cmp == 0 {
                    throw copy BigFloatError ("Division by 0");
                }

                let osign = (cmp > 0);
                return copy BigFloat::inf (self._isPositive == osign);
            }            
        }            

        let cmp = mpfr_cmp_ui (&o._content, 0u64);                    
        if cmp == 0 {
            throw copy BigFloatError ("Division by 0");
        }
        
        let dmut res = mpfr_t ();
        mpfr_init2 (alias &res, 1024us);
        mpfr_div (alias &res, &self._content, &o._content, mpfr_rnd_t::MPFR_RNDN);

        copy BigFloat (res)
    }

    /**
     * Divides a BigFloat and a numeric value.
     *
     * @params:
     *   - o: converted to BigFloat
     */
    pub fn opBinary {"/", T} (self, o: T)-> &BigFloat
        throws BigFloatError
    {
        self / copy BigFloat (o)
    }
    
    /**
     * Divides a BigFloat and a numeric value, with `self` as right operand.
     *
     * @params:
     *   - o: converted to BigFloat
     */
    pub fn opBinaryRight {"/", T} (self, o: T)-> &BigFloat
        throws BigFloatError
    {
        copy BigFloat (o) / self
    }

    /**
     * Computes the floating-point modulo.
     *
     * @throws:
     *   - BigFloatError if divisor is zero.
     *
     * @behavior:
     *   - Inf % x → NaN.
     *   - x % Inf → x.
     *   - Otherwise uses MPFR fmod.
     */
    pub fn opBinary {"%"} (self, o: &BigFloat)-> &BigFloat
        throws BigFloatError
    {
        if (self._isNan || o._isNan) return copy BigFloat::nan ();
        match (self._isInf, o._isInf) {
            (true, _) => {
                return copy BigFloat::nan ();
            }
            (false, true) => {
                return self;
            }            
        }
        
        if (mpfr_cmp_ui (&o._content, 0u64) == 0) {
            throw copy BigFloatError ("Division by 0");
        }
        
        let dmut res = mpfr_t ();
        mpfr_init2 (alias &res, 1024us);
        mpfr_fmod (alias &res, &self._content, &o._content, mpfr_rnd_t::MPFR_RNDN);

        copy BigFloat (res)
    }

    /**
     * Computes the floating-point modulo.
     *
     * @params:
     *    - o: Converted to a BigFloat
     *    
     */
    pub fn opBinary {"%", T} (self, o: T)-> &BigFloat
        throws BigFloatError
    {
        self % copy BigFloat (o)
    }

    /**
     * Computes the floating-point modulo, with `self` as right operand.
     *
     * @params:
     *    - o: Converted to a BigFloat
     *    
     */
    pub fn opBinaryRight {"%", T} (self, o: T)-> &BigFloat
        throws BigFloatError
    {
        copy BigFloat (o) % self
    }

    /**
     * Raises the BigFloat to an integer power.
     *
     * @params:
     *   - exp: exponent
     *
     * @returns:
     *   A new BigFloat containing the result.
     */
    pub fn opBinary {"^^"} (self, exp: i64)-> &BigFloat {
        let dmut res = mpfr_t ();
        mpfr_init2 (alias &res, 1024us);
        mpfr_pow_si (alias &res, &self._content, exp, mpfr_rnd_t::MPFR_RNDN);

        copy BigFloat (res)
    }

    /**
     * Raises the BigFloat to a BigFloat exponent.
     *
     * @params:
     *   - exp: exponent
     *
     * @returns:
     *   A new BigFloat containing the result.
     */
    pub fn opBinary {"^^"} (self, exp: &BigFloat)-> &BigFloat {
        let dmut res = mpfr_t ();
        mpfr_init2 (alias &res, 1024us);
        mpfr_pow (alias &res, &self._content, &exp._content, mpfr_rnd_t::MPFR_RNDN);

        copy BigFloat (res)
    }

    /*!
     * ================================================================================
     * ================================================================================
     * =========================          COMPARISON          =========================
     * ================================================================================
     * ================================================================================
     */

    /**
     * Compares two BigFloat values.
     *
     * @returns:
     *   -1, 0, or 1 depending on ordering.
     *
     * @behavior:
     *   - NaN compares greater than any non-NaN.
     *   - Infinities compare according to sign.
     *   - Otherwise uses MPFR comparison.
     */
    pub fn opCmp (self, o: &BigFloat)-> i32 {
        if (self._isNan) { if (o._isNan) return 0; else return 1; }
        else if (o._isNan) { return 1; }

        else if (self._isInf && o._isInf) {
            if (self._isPositive && !o._isPositive) return 1;
            else if (!self._isPositive && o._isPositive) return -1;
            else return 0;
        }

        else if (o._isInf) { if (o._isPositive) return -1; else return 1; }
        else if (self._isInf) { if (self._isPositive) return 1; else return -1; }

        mpfr_cmp (&self._content, &o._content)
    }
    
    /**
     * Compares a BigFloat with a numeric value.
     *
     * @params:
     *    - o: converted to a BigFloat
     */
    pub fn opCmp {T} (self, o: T)-> i32 {
        self.opCmp (copy BigFloat (o))
    }

    /*!
     * ================================================================================
     * ================================================================================
     * =========================          CONVERTION          =========================
     * ================================================================================
     * ================================================================================
     */

    /**
     * Converts the BigFloat to a hexadecimal MPFR string.
     *
     * @returns:
     *   A newly allocated string containing the representation.
     *
     * @format:
     *   Uses MPFR’s "%RZA" format.
     */
    pub fn toHexString (self)-> [c8] {
        let len = mpfr_snprintf (null, 0u32, "%RZA".ptr, &self._content);

        let dmut res = copy ['\u{0}' ; len + 1us];
        mpfr_snprintf (alias res.ptr, len + 1u32, "%RZA".ptr, &self._content);

        return res[0us .. $ - 1us];
    }

    /*!
     * ================================================================================
     * ================================================================================
     * =========================             DTOR              ========================
     * ================================================================================
     * ================================================================================
     */

    /**
     * Releases MPFR resources.
     *
     * @behavior:
     *   - Calls `mpfr_clear` only if the internal value was initialized.
     *   
     */
    __dtor (mut self) {
        if (self._contentInit) {
            mpfr_clear (alias &self._content);
        }
    }


    impl Streamable {

        /**
         * Writes the BigFloat to a stream.
         *
         * @behavior:
         *   - Prints "nan" for NaN.
         *   - Prints "inf" or "-inf" for infinities.
         *   - Otherwise prints the value using MPFR’s "%Rg" format.
         */
        pub over toStream (self, dmut stream: &StringStream) {
            if (self._isNan) {                
                stream:.write ("nan");
            }
            else if (self._isInf) {
                if (self._isPositive) {
                    stream:.write ("inf");
                } else { stream:.write ("-inf"); }
            }
            else {
                let len = mpfr_snprintf (null, 0u32, "%Rg".ptr, &self._content);
                let dmut res = copy ['\u{0}' ; len + 1us];

                mpfr_snprintf (alias res.ptr, len + 1u32, "%Rg".ptr, &self._content);
                stream:.write (res [0us .. $ - 1us]);
            }
        }
    }
    

}
