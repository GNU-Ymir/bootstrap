/*
 * Provides low-level bindings to the GMP and MPFR libraries.
 *
 * This module exposes the raw C interfaces required to manipulate
 * arbitrary-precision integers (`mpz_t`) and arbitrary-precision floating-point
 * numbers (`mpfr_t`). It is intended as a thin FFI layer; no safety checks,
 * memory management, or high-level abstractions are provided.
 *
 * Users are responsible for:
 *   - calling the appropriate initialization functions (`__gmpz_init`,
 *     `mpfr_init2`, etc.),
 *   - ensuring correct rounding modes for MPFR operations,
 *   - freeing allocated objects using `__gmpz_clear` and `mpfr_clear`,
 *   - respecting GMP/MPFR aliasing and lifetime rules.
 *
 * Higher-level wrappers should be implemented in separate modules. 
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::utils::gmp
 * @File: ymirc/utils/gmp.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2022-06-19
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in gmp;

/**
 * Represents a GMP arbitrary-precision integer.
 *
 * This record contains a fixed-size placeholder array matching the size of
 * `mpz_t` in the GMP ABI. It does not store the integer directly; instead, GMP
 * manages the internal heap-allocated limbs.
 *
 * @note
 *   - Must be initialized with `__gmpz_init` or `__gmpz_init_set_str`
 *     before use.
 *   - Must be freed with `__gmpz_clear` to avoid memory leaks.
 */
pub record mpz_t {
    pub let a : [u32 ; 4u32] = [0u32 ; 4u32];
    pub self () {}
}

/**
 * Represents an MPFR arbitrary-precision floating-point number.
 *
 * This record contains a placeholder array matching the MPFR ABI layout. The
 * actual mantissa and exponent are allocated and managed by MPFR.
 *
 * @note
 *   - Must be initialized with `mpfr_init2` before use.
 *   - Must be freed with `mpfr_clear`.
 */
pub record mpfr_t {
    pub let a : [u32 ; 8u32] = [0u32 ; 8u32];
    pub self () {}
}

/**
 * Rounding modes for MPFR operations.
 *
 * Values correspond to the MPFR C API:
 *   - MPFR_RNDN — round to nearest, ties to even
 *   - MPFR_RNDZ — round toward zero
 *   - MPFR_RNDU — round toward +∞
 *   - MPFR_RNDD — round toward −∞
 *   - MPFR_RNDA — round away from zero
 */
pub enum : u32
| MPFR_RNDN = 0u32
| MPFR_RNDZ = 1u32
| MPFR_RNDU = 2u32
| MPFR_RNDD = 3u32
| MPFR_RNDA = 4u32
 -> mpfr_rnd_t;

/**
 * ================================================================================
 * ================================================================================
 * =========================          ALLOCATION          =========================
 * ================================================================================
 * ================================================================================
 */

/**
 * Initializes an `mpz_t` and sets its value from a string.
 *
 * @params:
 *   - a:    pointer to an uninitialized `mpz_t`
 *   - str:  C string representing the integer
 *   - base: numeric base (2–62)
 */
pub extern (C) fn __gmpz_init_set_str (dmut a : *mpz_t, str : *c8, base : u32)-> void;

/**
 * Initializes an empty `mpz_t`.
 *
 * Must be paired with `__gmpz_clear`.
 */
pub extern (C) fn __gmpz_init (dmut a : *mpz_t)-> void;

/**
 * Initializes an `mpfr_t` with the given precision (in bits).
 *
 * Must be paired with `mpfr_clear`.
 */
pub extern (C) fn mpfr_init2 (dmut a : *mpfr_t, prec : usize)-> void;

/**
 * ================================================================================
 * ================================================================================
 * =========================            ASSIGN            =========================
 * ================================================================================
 * ================================================================================
 */

/**
 * Sets an `mpz_t` from an unsigned integer.
 */
pub extern (C) fn __gmpz_set_ui (dmut a : *mpz_t, val : u64);

/**
 * Sets an `mpz_t` from a signed integer.
 */
pub extern (C) fn __gmpz_set_si (dmut a : *mpz_t, val : i64);

/**
 * Sets an `mpz_t` from a string representation.
 */
pub extern (C) fn __gmpz_set_str (dmut a : *mpz_t, val : *c8, base : u32);

/**
 * Sets an `mpfr_t` from a string representation.
 *
 * @params:
 *   - base: numeric base (2–62)
 *   - rnd:  rounding mode
 */
pub extern (C) fn mpfr_set_str (dmut a : *mpfr_t, val : *c8, base : u32, rnd : mpfr_rnd_t);

/**
 * Converts an `mpz_t` into an `mpfr_t`.
 */
pub extern (C) fn mpfr_set_z (dmut a : *mpfr_t, b : *mpz_t, rnd : mpfr_rnd_t);

/**
 * Converts an `mpfr_t` into an `mpz_t` using the given rounding mode.
 */
pub extern (C) fn mpfr_get_z (dmut a : *mpz_t, b : *mpfr_t, rnd : mpfr_rnd_t);

/**
 * Sets an `mpfr_t` from a double‑precision floating‑point value.
 */
pub extern (C) fn mpfr_set_d (dmut a : *mpfr_t, b : f64, rnd : mpfr_rnd_t);

/**
 * ================================================================================
 * ================================================================================
 * =========================          FORMATTING          =========================
 * ================================================================================
 * ================================================================================
 */

/**
 * Prints using GMP's printf‑style formatting.
 *
 * @warning
 *   This function writes directly to stdout using C I/O.
 */
pub extern (C) fn __gmp_printf (str : *c8, ...);

/**
 * Writes formatted output into a buffer using GMP formatting rules.
 *
 * @returns:
 *   Number of characters written.
 */
pub extern (C) fn __gmp_snprintf (dmut buf : *c8, len : u32, str : *c8, ...)-> u32;

/**
 * Writes formatted output for MPFR values into a buffer.
 */
pub extern (C) fn mpfr_snprintf (dmut buf : *c8, len : u32, str : *c8, ...)-> u32;


/**
 * ================================================================================
 * ================================================================================
 * =========================            ARITHM            =========================
 * ================================================================================
 * ================================================================================
 */


/**
 * Computes res = a * b.
 */
pub extern (C) fn __gmpz_mul (dmut res : *mpz_t, a : *mpz_t, b : *mpz_t);

/**
 * Computes res = a + b.
 */
pub extern (C) fn __gmpz_add (dmut res : *mpz_t, a : *mpz_t, b : *mpz_t);

/**
 * Computes res = a - b.
 */
pub extern (C) fn __gmpz_sub (dmut res : *mpz_t, a : *mpz_t, b : *mpz_t);

/**
 * Computes quotient using ceiling division: res = ceil(a / b).
 */
pub extern (C) fn __gmpz_cdiv_q (dmut res : *mpz_t, a : *mpz_t, b : *mpz_t);

/**
 * Computes remainder using ceiling division.
 */
pub extern (C) fn __gmpz_cdiv_r (dmut res : *mpz_t, a : *mpz_t, b : *mpz_t);

/**
 * Computes quotient using truncation toward zero.
 */
pub extern (C) fn __gmpz_tdiv_q (dmut res : *mpz_t, a : *mpz_t, b : *mpz_t);

/**
 * Computes remainder using truncation toward zero.
 */
pub extern (C) fn __gmpz_tdiv_r (dmut res : *mpz_t, a : *mpz_t, b : *mpz_t);

/**
 * Computes res = a mod b.
 */
pub extern (C) fn __gmpz_mod (dmut res : *mpz_t, a : *mpz_t, b : *mpz_t);

/**
 * Computes res = a^^b where b is an unsigned integer.
 */
pub extern (C) fn __gmpz_pow_ui (dmut res : *mpz_t, a : *mpz_t, b : u64);

/**
 * Computes exact division: res = a / b, assuming b divides a.
 */
pub extern (C) fn __gmpz_divexact (dmut res : *mpz_t, a : *mpz_t, b : *mpz_t);

/**
 * Computes res = a + b with rounding mode `rnd`.
 */
pub extern (C) fn mpfr_add (dmut res : *mpfr_t, a : *mpfr_t, b : *mpfr_t, rnd : mpfr_rnd_t);

/**
 * Computes res = a * b with rounding mode `rnd`.
 */
pub extern (C) fn mpfr_mul (dmut res : *mpfr_t, a : *mpfr_t, b : *mpfr_t, rnd : mpfr_rnd_t);

/**
 * Computes res = a - b with rounding mode `rnd`.
 */
pub extern (C) fn mpfr_sub (dmut res : *mpfr_t, a : *mpfr_t, b : *mpfr_t, rnd : mpfr_rnd_t);

/**
 * Computes res = a / b with rounding mode `rnd`.
 */
pub extern (C) fn mpfr_div (dmut res : *mpfr_t, a : *mpfr_t, b : *mpfr_t, rnd : mpfr_rnd_t);

/**
 * Computes res = a ^^ b with rounding mode `rnd`.
 */
pub extern (C) fn mpfr_pow (dmut res : *mpfr_t, a : *mpfr_t, b : *mpfr_t, rnd : mpfr_rnd_t);

/**
 * Computes res = fmod(a, b) with rounding mode `rnd`.
 */
pub extern (C) fn mpfr_fmod (dmut res : *mpfr_t, a : *mpfr_t, b : *mpfr_t, rnd : mpfr_rnd_t);

/**
 * Computes res = a * b where b is an unsigned integer.
 */
pub extern (C) fn mpfr_mul_ui (dmut res : *mpfr_t, a : *mpfr_t, b : u64, rnd : mpfr_rnd_t);

/**
 * Computes res = a + b where b is an unsigned integer.
 */
pub extern (C) fn mpfr_add_ui (dmut res : *mpfr_t, a : *mpfr_t, b : u64, rnd : mpfr_rnd_t);

/**
 * Computes res = a - b where b is an unsigned integer.
 */
pub extern (C) fn mpfr_sub_ui (dmut res : *mpfr_t, a : *mpfr_t, b : u64, rnd : mpfr_rnd_t);

/**
 * Computes res = a / b where b is an unsigned integer.
 */
pub extern (C) fn mpfr_div_ui (dmut res : *mpfr_t, a : *mpfr_t, b : u64, rnd : mpfr_rnd_t);

/**
 * Computes res = a ^^ b where b is an unsigned integer.
 */
pub extern (C) fn mpfr_pow_ui (dmut res : *mpfr_t, a : *mpfr_t, b : u64, rnd : mpfr_rnd_t);

/**
 * Computes res = a ^^ b where b is an signed integer.
 */
pub extern (C) fn mpfr_pow_si (dmut res : *mpfr_t, a : *mpfr_t, b : i64, rnd : mpfr_rnd_t);

/**
 * Computes res = fmod (a, b) where b is an unsigned integer.
 */
pub extern (C) fn mpfr_fmod_ui (dmut res : *mpfr_t, a : *mpfr_t, b : u64, rnd : mpfr_rnd_t);

/**
 * ================================================================================
 * ================================================================================
 * =========================          COMPARISON          =========================
 * ================================================================================
 * ================================================================================
 */

/**
 * Compares an `mpz_t` with an unsigned integer.
 *
 * @returns:
 *   - negative if o < u
 *   - zero     if o == u
 *   - positive if o > u
 */
pub extern (C) fn __gmpz_cmp_ui (o : *mpz_t, u : u64)-> i32;

/**
 * Compares two `mpz_t` values.
 */
pub extern (C) fn __gmpz_cmp (o : *mpz_t, b : *mpz_t)-> i32;

/**
 * Compares an `mpfr_t` with a double.
 */
pub extern (C) fn mpfr_cmp_d (o : *mpfr_t, u : f64)-> i32;

/**
 * Compares an `mpfr_t` with an unsigned integer.
 */
pub extern (C) fn mpfr_cmp_ui (o : *mpfr_t, u : u64)-> i32;

/**
 * Compares two `mpfr_t` values.
 */
pub extern (C) fn mpfr_cmp (o : *mpfr_t, b : *mpfr_t)-> i32;

/**
 * ================================================================================
 * ================================================================================
 * =========================           CONVERT            =========================
 * ================================================================================
 * ================================================================================
 */

/**
 * Converts an `mpz_t` to an unsigned integer.
 *
 * @warning
 *   Overflow is not checked.
 */
pub extern (C) fn __gmpz_get_ui (a : *mpz_t)-> u64;

/**
 * Converts an `mpz_t` to a signed integer.
 *
 * @warning
 *   Overflow is not checked.
 */
pub extern (C) fn __gmpz_get_si (a : *mpz_t)-> i64;

/**
 * ================================================================================
 * ================================================================================
 * =========================             FREE             =========================
 * ================================================================================
 * ================================================================================
 */

/**
 * Frees the internal memory of an `mpz_t`.
 *
 * Must be called exactly once for each initialized `mpz_t`.
 */
pub extern (C) fn __gmpz_clear (dmut a : *mpz_t);

/**
 * Frees the internal memory of an `mpfr_t`.
 *
 * Must be called exactly once for each initialized `mpfr_t`.
 */
pub extern (C) fn mpfr_clear (dmut a : *mpfr_t);
