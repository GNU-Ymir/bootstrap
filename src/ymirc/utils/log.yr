in log;

use std::{io, conv, stream, traits};
use ymirc::utils::{format, colors};
use ymirc::global::state;


/**
 * Provides simple logging utilities for debugging and diagnostic output.
 *
 * This module offers four log levels(`info`, `warn`, `success`, `failure`) and
 * prints messages only when verbose mode is enabled in the global state. Each
 * message is timestamped relative to the first call to `init()` or
 * `setRelativeTime()`.
 *
 * Messages are formatted using `ymirc::utils::format` and may include
 * additional parameters. Overloads accept either a single parameter or a tuple
 * of parameters.
 *
 * @behavior:
 *   - Timestamps are expressed in seconds as a floating-point value.
 *   - Verbosity is controlled by `state::instance().isVerboseActive()`.
 *   - In UNITTEST mode, logging is always enabled.
 *   - Colors are applied according to the log level.
 *
 * @example:
 *   logging::info("Loaded % modules", count);
 *   logging::warn("Deprecated API used");
 *   logging::success("Compilation finished");
 *   logging::failure("Cannot open file: %", path);
 */

pub mod logging {

    lazy dmut __start__: [u64] = copy [0u64];

    extern (C) fn clock()-> u64;
    def CLOCKS_PER_SEC = 1_000_000.0;

    fn getInstant()-> f64 {
        if __start__[0] == 0 {
            __start__[0] = clock();
        }

        cast!f64((clock() - __start__[0])) / CLOCKS_PER_SEC
    }

    enum LoggingMods: [c8]
    | SUCCESS = "Success"
    | FAILURE = "Failure"
    | INFO    = "Info"
    | WARN    = "Warn";

    /**
     * Initializes the logging timer.
     *
     * Sets the internal reference timestamp used to compute relative times for
     * log messages. If the timer is already initialized, this function has no
     * effect.
     *
     * @behavior:
     *   - Called automatically on first log emission if not invoked manually.
     *   - Useful when the user wants timestamps to start from a specific point.
     */
    pub fn init() {
        if (__start__[0] == 0)
            __start__[0] = clock();
    }

    /**
     * Prints an informational log message.
     *
     * @params:
     *   - msg: the message to print
     *
     * @behavior:
     *   - Printed only when verbose mode is active, except in UNITTEST mode.
     *   - Timestamp and log level are automatically prepended.
     *   - Message is printed in default color.
     */
    pub fn info(msg: [c8]) {
        let l = cte if __version!UNITTEST { true } else { state::isVerboseActive()  };
        if l {
            println(format("[%(b)] : %(B)s => % ", LoggingMods::INFO, getInstant(), msg));
        }
    }

    /**
     * Prints a formatted informational log message.
     *
     * @params:
     *   - msg:    format string
     *   - params: parameters for formatting
     *
     * @behavior:
     *   - Accepts either a single parameter or a tuple of parameters.
     *   - Printed only when verbose mode is active, except in UNITTEST mode.
     *   - Timestamp and log level are automatically prepended.
     */
    pub fn info {T...} (msg: [c8], params: T) {
        let l = cte if __version!UNITTEST { true } else { state::isVerboseActive()  };
        if l {
            let dmut stream = copy StringStream();
            cte if isTuple!{typeof(params)} {
                stream:.write(format(msg, expand params));
            } else {
                stream:.write(format(msg, params));
            }
            println(format("[%(b)] : %(B)s => % ", LoggingMods::INFO, getInstant(), stream[]));
        }
    }

    /**
     * Prints a warning log message.
     *
     * @params:
     *   - msg: the message to print
     *
     * @behavior:
     *   - Printed only when verbose mode is active, except in UNITTEST mode.
     *   - Timestamp and log level are automatically prepended.
     *   - Message is printed in yellow.
     */
    pub fn warn(msg: [c8]) {
        let l = cte if __version!UNITTEST { true } else { state::isVerboseActive()  };
        if l {
            println(format("[%(y)] : %(B)s => % ", LoggingMods::WARN, getInstant(), msg));
        }
    }

    /**
     * Prints a formatted warning log message.
     *
     * @params:
     *   - msg:    format string
     *   - params: parameters for formatting
     *
     * @behavior:
     *   - Accepts either a single parameter or a tuple of parameters.
     *   - Printed only when verbose mode is active, except in UNITTEST mode.
     *   - Timestamp and log level are automatically prepended.
     *   - Message is printed in yellow.
     */
    pub fn warn {T...} (msg: [c8], params: T) {
        let l = cte if __version!UNITTEST { true } else { state::isVerboseActive()  };
        if l {
            let dmut stream = copy StringStream();
            cte if isTuple!{typeof(params)} {
                stream:.write(format(msg, expand params));
            } else {
                stream:.write(format(msg, params));
            }

            println(format("[%(y)] : %(B)s => % ", LoggingMods::WARN, getInstant(), stream[]));
        }
    }

    /**
     * Prints a success log message.
     *
     * @params:
     *   - msg: the message to print
     *
     * @behavior:
     *   - Printed only when verbose mode is active, except in UNITTEST mode.
     *   - Timestamp and log level are automatically prepended.
     *   - Message is printed in green.
     */
    pub fn success(msg: [c8]) {
        let l = cte if __version!UNITTEST { true } else { state::isVerboseActive() };
        if l {
            println(format("[%(g)] : %(B)s => % ", LoggingMods::SUCCESS, getInstant(), msg));
        }
    }

    /**
     * Prints a formatted success log message.
     *
     * @params:
     *   - msg:    format string
     *   - params: parameters for formatting
     *
     * @behavior:
     *   - Accepts either a single parameter or a tuple of parameters.
     *   - Printed only when verbose mode is active, except in UNITTEST mode.
     *   - Timestamp and log level are automatically prepended.
     *   - Message is printed in green.
     */
    pub fn success {T...} (msg: [c8], params: T) {
        let l = cte if __version!UNITTEST { true } else { state::isVerboseActive() };
        if l {
            let dmut stream = copy StringStream();
            cte if isTuple!{typeof(params)} {
                stream:.write(format(msg, expand params));
            } else {
                stream:.write(format(msg, params));
            }

            println(format("[%(g)] : %(B)s => % ", LoggingMods::SUCCESS, getInstant(), stream[]));
        }
    }

    /**
     * Prints an error or failure log message.
     *
     * @params:
     *   - msg: the message to print
     *
     * @behavior:
     *   - Printed only when verbose mode is active, except in UNITTEST mode.
     *   - Timestamp and log level are automatically prepended.
     *   - Message is printed in red.
     */
    pub fn failure(msg: [c8]) {
        let l = cte if __version!UNITTEST { true } else { state::isVerboseActive() };
        if l {
            println(format("[%(r)] : %(B)s => % ", LoggingMods::FAILURE, getInstant(), msg));
        }
    }

    /**
     * Prints a formatted error or failure log message.
     *
     * @params:
     *   - msg:    format string
     *   - params: parameters for formatting
     *
     * @behavior:
     *   - Accepts either a single parameter or a tuple of parameters.
     *   - Printed only when verbose mode is active, except in UNITTEST mode.
     *   - Timestamp and log level are automatically prepended.
     *   - Message is printed in red.
     */
    pub fn failure {T...} (msg: [c8], params: T) {
        let l = cte if __version!UNITTEST { true } else { state::isVerboseActive() };
        if l {
            let dmut stream = copy StringStream();
            cte if isTuple!{typeof(params)} {
                stream:.write(format(msg, expand params));
            } else {
                stream:.write(format(msg, params));
            }

            println(format("[%(r)] : %(B)s => % ", LoggingMods::FAILURE, getInstant(), stream[]));
        }
    }

    /**
     * Resets the internal logging timer.
     *
     * Sets the reference timestamp to the current clock value. All subsequent
     * log messages will display time relative to this new point.
     *
     * @use_cases:
     *   - Measuring the duration of a specific phase of execution.
     *   - Resetting timestamps between test cases.
     */
    pub fn setRelativeTime() {
        __start__[0] = clock();
    }

}
