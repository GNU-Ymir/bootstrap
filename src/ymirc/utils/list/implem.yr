/*
 * Implements the IList class.
 *
 * This module defines the `IList` class, which provides the underlying behavior
 * for `ymirc::utils::list::List`. It implements a dynamically sized sequence
 * backed by a resizable array, supporting operations such as `push`, `pop`,
 * `front`, `back`, indexing, and capacity growth.
 *
 * Mutability is controlled by the template parameter `mutable`:
 *   - When `mutable == true`, the list stores *deeply mutable* class
 *     instances(`dmut T`). Mutating an element mutates the underlying
 *     object.
 *   - When `mutable == false`, the list stores immutable values(`T`), and
 *     the list itself is mutable but its elements are not.
 *
 * This module is not intended to be used directly. Users should import
 * `ymirc::utils::list` and use the `List` alias instead.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::utils::list::implem
 * @File: ymirc/utils/list/implem.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2025-01-15
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in implem;

use std::stream;

/**
 * A dynamically sized list backed by a resizable array.
 *
 * @params:
 *   - T:        element type
 *   - mutable:  whether elements are deeply mutable(`true`) or immutable(`false`)
 *
 * @behavior:
 *   - Capacity grows automatically when needed.
 *   - Elements are stored contiguously in memory.
 *   - Indexing is bounds-unchecked; out-of-range access triggers `panic`.
 *   - `mutable == true`:
 *       - `_data` is `dmut[T]` where `T` is a `dmut` class type.
 *       - Returned elements are mutable references.
 *   - `mutable == false`:
 *       - `_data` is `[mut T]` storing immutable values.
 *       - Returned elements are copies or immutable references.
 *
 * @complexity:
 *   - `push`: amortized O(1)
 *   - `pop`: O(1)
 *   - `front`, `back`, indexing: O(1)
 *   - `grow`: O(n) with n = current length
 */
@final
pub class IList {T, mutable: bool} {

    cte if mutable {
        let dmut _data: [T] = [];
    } else {
        let mut _data: [mut T] = [];
    }
        
    prv let mut _len: usize = 0us;            

    /**
     * Creates an empty list with zero capacity.
     */
    pub self () {}

    cte if mutable {

        /**
         * Appends a mutable element to the end of the list.
         *
         * @params:
         *   - val: dmut T — the element to append
         *
         * @behavior:
         *   - Grows the underlying storage if needed.
         *   - Stores the element by aliasing its reference.
         */
        pub fn push(mut self, dmut val: T) {
            if self._data.len == self._len {
                self:.grow();
            }

            self._data[self._len] = alias val;
            self._len += 1;
        }

        /**
         * Returns a mutable slice of the list contents.
         *
         * @returns:
         *   A `dmut[T]` containing all elements currently in the list.
         */
        pub fn opIndex(mut self)-> dmut[T] {
            alias self._data[0 .. self._len]
        }

        /**
         * Returns a mutable reference to the element at the given index.
         *
         * @params:
         *   - index: index of the element
         *
         * @returns:
         *   A `dmut T` reference.
         *
         * @behavior:
         *   - Panics if `index >= len`.
         */
        pub fn opIndex(mut self, index: usize)-> dmut T {
            alias self._data[index]
        }

        /**
         * Replaces the last element of the list.
         *
         * @params:
         *   - v: new value
         *
         * @behavior:
         *   - Does nothing if the list is empty.
         */
        @field
        pub fn back(mut self, dmut v: T) {
            if self._len > 0 {
                self._data[self._len - 1] = alias v;
            }
        }

        /**
         * Returns the last element of the list.
         *
         * @returns:
         *   - Mutable reference(`dmut T`)
         *
         * @behavior:
         *   - Panics if the list is empty.
         */
        @field
        pub fn back(mut self)-> dmut T {
            if self._len > 0 {
                return alias self._data[self._len - 1];
            }

            panic;
        }

        /**
         * Returns the first element of the list.
         *
         * @returns:
         *   - Mutable reference(`dmut T`) when `mutable == true`
         *
         * @behavior:
         *   - Panics if the list is empty.
         */
        @field
        pub fn front(mut self)-> dmut T {
            if self._len > 0 {
                return alias self._data[0];
            }

            panic;
        }
    } else {

        /**
         * Appends an immutable value to the end of the list.
         *
         * @params:
         *   - val: T — the value to append
         *
         * @behavior:
         *   - Grows the underlying storage if needed.
         *   - Stores the value by copy.
         */
        pub fn push(mut self, val: T) {
            if self._data.len == self._len {
                self:.grow();
            }

            self._data[self._len] = val;
            self._len += 1;
        }

        /**
         * Replaces the last element of the list.
         *
         * @params:
         *   - v: new value
         *
         * @behavior:
         *   - Does nothing if the list is empty.
         */
        @field
        pub fn back(mut self, v: T) {
            if self._len > 0 {
                self._data[self._len - 1] = v;
            }
        }

        /**
         * Returns a mutable slice of immutable elements.
         *
         * @returns:
         *   A `mut[mut T]` containing all elements currently in the list.
         */
        pub fn opIndex(mut self)-> mut[mut T] {
            alias self._data[0 .. self._len]
        }

    }

    /**
     * Returns an immutable copy of the element at the given index.
     *
     * @params:
     *   - index: index of the element
     *
     * @returns:
     *   A value of type `T`.
     *
     * @behavior:
     *   - Panics if `index >= len`.
     */
    pub fn opIndex(self, index: usize)-> T {
        self._data[index]
    }

    /**
     * Returns an immutable slice of the list contents.
     *
     * @returns:
     *   A `[T]` slice containing all elements currently in the list.
     */
    pub fn opIndex(self)-> [T] {
        self._data[0 .. self._len]
    }

    /**
     * Returns the last element of the list.
     *
     * @returns:
     *   - Immutable value(`T`)
     *
     * @behavior:
     *   - Panics if the list is empty.
     */
    @field
    pub fn back(self)-> T {
        if self._len > 0 {
            return self._data[self._len - 1];
        }

        panic;
    }

    /**
     * Returns the first element of the list.
     *
     * @returns:
     *   - Immutable value(`T`)
     *
     * @behavior:
     *   - Panics if the list is empty.
     */
    @field
    pub fn front(self)-> T {
        if self._len > 0 {
            return self._data[0];
        }

        panic;
    }

    /**
     * Removes all elements from the list without changing capacity.
     *
     * @behavior:
     *   - Sets length to zero.
     *   - Does not deallocate or shrink the underlying storage.
     */
    pub fn clear(mut self) {
        self._len = 0;
    }

    /**
     * Returns whether the list contains no elements.
     */
    @field
    pub fn isEmpty(self)-> bool {
        self._len == 0
    }

    /**
     * Returns the number of elements currently stored in the list.
     */
    @field
    pub fn len(self)-> usize {
        self._len
    }

    /**
     * Removes the last element from the list.
     *
     * @behavior:
     *   - Does nothing if the list is empty.
     *   - Does not shrink capacity.
     */
    pub fn pop(mut self) {
        if self._len == 0 { return; }
        self._len -= 1;
    }

    /**
     * Doubles the capacity of the underlying storage.
     *
     * @behavior:
     *   - Allocates a new array of size `2 * old_capacity`.
     *   - Copies existing elements into the new array.
     *   - Updates the internal storage pointer.
     *
     * @complexity:
     *   O(n), where n = current length.
     *
     * @note:
     *   This function is called automatically when pushing into a full list.
     */
    prv fn grow(mut self) {
        if (self._data.len == 0us) { // empty
            self._data = alias core::types::array::allocArray!T(2);
        }  else {
            let n_len = self._data.len * 2;
            cte if mutable {
                let dmut aux: [T] = core::types::array::allocArray!T(n_len);
                core::types::array::memCopy!T(self._data, alias aux);
                self._data = alias aux;
            } else {
                let mut aux: [mut T] = core::types::array::allocArray!T(n_len);
                core::types::array::memCopy!T(self._data, alias aux);
                self._data = alias aux;
            }
        }
    }


}
