in memory;

pub mod Runtime {F, T} {

    /**
     * Performs a raw, unchecked reinterpretation cast between two types.
     *
     * @warning
     *   This function is **unsafe**. It performs a bit-level reinterpretation of
     *   the value `x` as type `T` without any validation, conversion, or runtime
     *   checks. The caller is fully responsible for ensuring that:
     *
     *     - `F` and `T` have compatible memory layouts,
     *     - the resulting value is valid for type `T`,
     *     - alignment requirements of `T` are satisfied,
     *     - no aliasing or lifetime rules are violated.
     *
     * @params:
     *   - x: F — the value to reinterpret
     *
     * @returns:
     *   A mutable value of type `T` whose bit pattern is identical to `x`.
     *
     * @behavior:
     *   - This is a thin wrapper around the Ymidgard runtime intrinsic.
     *   - No conversion, padding, or byte-order adjustment is performed.
     *   - Misuse leads to undefined behavior.
     *
     * @use_cases:
     *   - Interfacing with low-level runtime structures,
     *   - Implementing FFI bindings,
     *   - Working with raw memory buffers,
     *   - Implementing advanced abstractions that require type-punning.
     *
     * @example:
     *   // Reinterpret a u32 as four bytes(unsafe!)
     *   let x: u32 = 0x11223344;
     *   let bytes = Runtime!{u32, [u8;4]}::_yrt_unsafe_cast(x);
     */
    pub extern (C) fn _yrt_unsafe_cast(x: F)-> dmut T;
}
