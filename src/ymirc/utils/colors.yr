/* 
 * <h2>Overview</h2>
 * This module defines ANSI escape sequences for console colors and text
 * attributes. It provides a simple enumeration (`Colors`) that can be used to
 * colorize terminal output in a portable and readable way.
 *
 * When the `NO_COLORS` version flag is enabled, all color codes expand to empty
 * strings, ensuring that output remains clean on terminals that do not support
 * ANSI sequences or when color is explicitly disabled.
 *
 * <h2>Basic Usage</h2>
 * ```yr
 * use ymirc::utils::colors;
 *
 * println(format ("%Hello in red%!", Colors::RED, Colors::RESET));
 * println(format ("%Warning:% something happened", Colors::YELLOW, Colors::RESET));
 * println(format ("%Success:% operation completed", Colors::GREEN, Colors::RESET));
 * ```
 *
 *
 * <h2>Using Colors with <code>format</code></h2>
 * The <code>format</code> function natively supports color placeholders using
 * the syntax <code>%(c)</code>, where <code>c</code> is one of the color
 * identifiers defined in this module.
 *
 * Example:
 * ```yr
 * println(format("%(y): something happened", "Warning"));   // yellow
 * println(format("%(r)", "Error"));                         // red
 * println(format("%(g): Operation completed", "Success"));  // green
 * ```
 *
 * Colors are automatically reset at the end of each formatted segment.
 *
 *
 * <h2>Background Colors</h2>
 * ```yr
 * println("% Text on blue background %", Colors::BLUE_BACK, Colors::RESET);
 * ```
 *
 * <h2>Text Attributes</h2>
 * The enum also includes:
 *   - `BOLD`
 *   - `FAINT`
 *   - `ITALIC`
 *   - `UNDERLINE`
 *   - `BLINK`
 *   - `RESET`
 *
 * Example:
 * ```yr
 * println("%Important:% read the documentation", Colors::BOLD, Colors::RESET);
 * ```
 *
 * <h2>Disabling Colors</h2>
 * Compile with:
 * ```yr
 * -fversion NO_COLORS
 * ```
 * to disable all ANSI sequences. This is useful for:
 *   - logging to files,
 *   - terminals without color support,
 *   - automated testing.
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::utils::colors
 * @File: ymirc/utils/colors.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2021-11-12
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in colors;

__version NO_COLORS {
    pub enum
    | PURPLE      = ""
    | BLUE        = ""    
    | YELLOW      = ""
    | RED         = ""
    | GREEN       = ""
    | BLACK       = ""
    | WHITE       = ""

    | PURPLE_BACK = ""
    | BLUE_BACK   = ""    
    | YELLOW_BACK = ""
    | RED_BACK    = ""
    | GREEN_BACK  = ""
    | BLACK_BACK  = ""
    | WHITE_BACK  = ""
        
    | BOLD        = ""
    | BLINK       = ""
    | UNDERLINE   = ""
    | ITALIC      = ""
    | FAINT       = ""
    | RESET       = ""    
     -> Colors;
} else {
    pub enum
    | PURPLE      = "\u{0x001B}[1;35m"
    | BLUE        = "\u{0x001B}[1;36m"    
    | YELLOW      = "\u{0x001B}[1;33m"
    | RED         = "\u{0x001B}[1;31m"
    | GREEN       = "\u{0x001B}[1;32m"
    | BLACK       = "\u{0x001B}[1;30m"
    | WHITE       = "\u{0x001B}[1;37m"

    | PURPLE_BACK = "\u{0x001B}[1;45m"
    | BLUE_BACK   = "\u{0x001B}[1;46m"    
    | YELLOW_BACK = "\u{0x001B}[1;43m"
    | RED_BACK    = "\u{0x001B}[1;41m"
    | GREEN_BACK  = "\u{0x001B}[1;42m"
    | BLACK_BACK  = "\u{0x001B}[1;40m"
    | WHITE_BACK  = "\u{0x001B}[1;47m"
        
    | BOLD        = "\u{0x001B}[1;50m"
    | BLINK       = "\u{0x001B}[5m"
    | UNDERLINE   = "\u{0x001B}[4m"
    | ITALIC      = "\u{0x001B}[3m"
    | FAINT       = "\u{0x001B}[2m"
    | RESET       = "\u{0x001B}[0m"
     -> Colors;
}
