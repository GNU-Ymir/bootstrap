/*
 * Declares the BigInt class. 
 *
 * BigInt provides arbitrary-precision signed integer arithmetic using the GMP
 * library. It behaves like a normal integer value, supporting arithmetic
 * operators, comparisons, conversions, and formatted output.
 *
 * <hr>
 *
 * <h2>Overview</h2>
 * BigInt wraps GMP’s `mpz_t` type and exposes a safe, idiomatic Ymir API for
 * high-precision integer computations. All values are signed.
 *
 * <h2>Basic Usage</h2>
 * ```yr
 * use ymirc::utils::bigint;
 *
 * let a = copy BigInt(12345678901234567890u64);
 * let b = copy BigInt("-98765432109876543210");
 *
 * let c = a * b + 42;
 * println("c = %", c);
 *
 * if c < 0 {
 *     println("Negative result");
 * }
 * ```
 *
 * <h2>Interoperability</h2>
 * BigInt can be constructed from:
 *   - all built-in integer types,
 *   - strings in arbitrary bases,
 *   - BigFloat (rounded to nearest integer).
 *
 * Mixed arithmetic is supported:
 * ```yr
 * let x = copy BigInt(12);
 * println(x + 3);     // integer promoted to BigInt
 * println(3 - x);     // right-side operator overload
 * ```
 *
 * <h2>Conversion</h2>
 * BigInt can be converted back to native integers using:
 *   - `to!T()`  — checked conversion (throws on overflow)
 *   - `toT!T()` — trusted conversion (panics on overflow)
 *   - `toN!T()` — unchecked conversion (wraps/truncates)
 *
 * <h2>Memory</h2>
 * BigInt automatically frees its GMP resources in the destructor.
 *
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::utils::bigint
 * @File: ymirc/utils/bigint.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2022-06-19
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in bigint;

use std::{io, conv, traits, stream};
use ymirc::utils::{gmp, bigfloat};

pub class BigIntError over Exception {
    pub let msg: [c32];
    pub self (msg: [c32]) with msg = msg {}
    impl Streamable;
}

/**
 * Arbitrary-precision signed integer.
 *
 * BigInt wraps GMP’s `mpz_t` type and provides high-precision integer
 * arithmetic with operator overloading, conversions, comparisons, and
 * formatted output. All values are signed and unbounded.
 *
 * @note
 *   BigInt instances manage their own GMP memory and free it automatically
 *   in the destructor.
 */
@final
pub class BigInt {

    prv {
        //  gmp content
        let dmut _content: mpz_t = mpz_t ();
    }
    
    /**
     * Constructs a BigInt from an already-initialized GMP value.
     *
     * @params:
     *   - content: initialized GMP integer
     *
     * @note
     *   Used internally after GMP arithmetic operations.
     */
    prv self (content: mpz_t)
        with _content = content
    {}
    
    /**
     * Constructs a BigInt equal to 0.
     */
    pub self ()
        with self (0u64)
    {}    

    
    /**
     * Constructs a BigInt from an unsigned integer.
     */
    pub self (x: u8)
        with self (cast!u64 (x))
    {}
    
    /**
     * Constructs a BigInt from an signed integer.
     */
    pub self (x: i8)
        with self (cast!i64 (x))
    {}
    
    /**
     * Constructs a BigInt from an unsigned integer.
     */
    pub self (x: u16)
        with self (cast!u64 (x))
    {}
    
    /**
     * Constructs a BigInt from an signed integer.
     */
    pub self (x: i16)
        with self (cast!i64 (x))
    {}
    
    /**
     * Create a big int from an unsigned integer
     */    
    pub self (x: u32)
        with self (cast!u64 (x))
    {}
    
    /**
     * Create a big int from an signed integer
     */    
    pub self (x: i32)
        with self (cast!i64 (x))
    {}
    
    /**
     * Create a big int from an unsigned integer
     */
    pub self (x: u64) {
        __gmpz_init (alias &self._content);
        __gmpz_set_ui (alias &self._content, x);
    }
    
    /**
     * Create a big int from an signed integer
     */
    pub self (x: i64) {
        __gmpz_init (alias &self._content);
        __gmpz_set_si (alias &self._content, x);
    }

    /**
     * Create a big int from an unsigned integer
     */
    pub self (x: usize) {
        __gmpz_init (alias &self._content);
        __gmpz_set_ui (alias &self._content, cast!u64 (x));
    }
    
    /**
     * Create a big int from an signed integer
     */
    pub self (x: isize) {
        __gmpz_init (alias &self._content);
        __gmpz_set_si (alias &self._content, cast!i64 (x));
    }

    /**
     * Constructs a BigInt from a string representation.
     *
     * @params:
     *   - x:    the string to parse
     *   - base: numeric base (default: 10)
     *
     * @behavior:
     *   - Initializes the GMP integer.
     *   - Parses the string using `__gmpz_set_str`.
     */
    pub self (x: [c8], base: u32 = 10u32) {
        __gmpz_init (alias &self._content);
        __gmpz_set_str (alias &self._content, x.toStringZ (), base);
    }

    /**
     * Constructs a BigInt from a BigFloat by rounding to nearest.
     *
     * @params:
     *   - f: the floating-point value to convert
     *
     * @behavior:
     *   - Initializes the GMP integer.
     *   - Converts using MPFR’s `mpfr_get_z` with rounding mode `MPFR_RNDN`.
     */
    pub self (f: &BigFloat) {
        __gmpz_init (alias &self._content);
        let mf = f.getF ();

        mpfr_get_z (alias &self._content, &mf, mpfr_rnd_t::MPFR_RNDN);
    }

    /**
     * Returns the underlying GMP value.
     *
     * @returns:
     *   A reference to the internal `mpz_t`.
     *
     * @note
     *   Intended for low-level interop only.
     */
    pub fn getZ (self)-> mpz_t {
        self._content
    }

    /**
     * Adds two BigInt values.
     *     
     */
    pub fn opBinary {"+"} (self, o: &BigInt)-> &BigInt {
        let dmut res = mpz_t ();
        __gmpz_init (alias &res);
        __gmpz_add (alias &res, &self._content, &o._content);

        copy BigInt (res)
    }

    /**
     * Adds a BigInt and a numeric value.
     *
     * @params:
     *   - o: converted to BigInt
     */
    pub fn opBinary {"+", T} (self, o: T)-> &BigInt {
        self + copy BigInt (o)
    }

    /**
     * Adds a numeric value and a BigInt, where `self` is the right operand.
     *
     * @params:
     *   - o: converted to BigInt
     */
    pub fn opBinaryRight {"+", T} (self, o: T)-> &BigInt {
        copy BigInt (o) + self
    }
    
    /**
     * Subtracts two BigInt values.
     *     
     */
    pub fn opBinary {"-"} (self, o: &BigInt)-> &BigInt {
        let dmut res = mpz_t ();
        __gmpz_init (alias &res);
        __gmpz_sub (alias &res, &self._content, &o._content);
        
        copy BigInt (res)
    }

    /**
     * Subtracts a BigInt and a numeric value.
     *
     * @params:
     *   - o: converted to BigInt
     */
    pub fn opBinary {"-", T} (self, o: T)-> &BigInt {
        self - copy BigInt (o)
    }

    /**
     * Subtracts a numeric value and a BigInt, where `self` is the right operand.
     *
     * @params:
     *   - o: converted to BigInt
     */
    pub fn opBinaryRight {"-", T} (self, o: T)-> &BigInt {
        copy BigInt (o) - self
    }

    /**
     * Multiplies two BigInt values.
     *     
     */
    pub fn opBinary {"*"} (self, o: &BigInt)-> &BigInt {
        let dmut res = mpz_t ();
        __gmpz_init (alias &res);
        __gmpz_mul (alias &res, &self._content, &o._content);
        
        copy BigInt (res)
    }

    /**
     * Multiplies a BigInt and a numeric value.
     *
     * @params:
     *   - o: converted to BigInt
     */
    pub fn opBinary {"*", T} (self, o: T)-> &BigInt {
        self * copy BigInt (o)
    }

    /**
     * Multiplies a numeric value and a BigInt, where `self` is the right operand.
     *
     * @params:
     *   - o: converted to BigInt
     */
    pub fn opBinaryRight {"*", T} (self, o: T)-> &BigInt {
        copy BigInt (o) * self
    }
    
    /**
     * Divides two BigInt values using truncated division.
     *
     * @throws:
     *   - BigIntError if dividing by zero.
     */
    pub fn opBinary {"/"} (self, o: &BigInt)-> &BigInt
        throws BigIntError
    {
        if (__gmpz_cmp_ui (&o._content, 0u64) == 0) {
            throw copy BigIntError ("Dividing by 0");
        }
        
        let dmut res = mpz_t ();
        __gmpz_init (alias &res);
        __gmpz_tdiv_q (alias &res, &self._content, &o._content);
        
        copy BigInt (res)
    }

    /**
     * Divides a BigInt and a numeric value.
     *
     * @params:
     *   - o: converted to BigInt
     */
    pub fn opBinary {"/", T} (self, o: T)-> &BigInt
        throws BigIntError
    {
        self / copy BigInt (o)
    }

    /**
     * Divides a numeric value and a BigInt, where `self` is the right operand.
     *
     * @params:
     *   - o: converted to BigInt
     */
    pub fn opBinaryRight {"/", T} (self, o: T)-> &BigInt
        throws BigIntError
    {
        copy BigInt (o) / self
    }

    /**
     * Computes the remainder of two BigInt values.
     *
     * @throws:
     *   - BigIntError if divisor is zero.
     */
    pub fn opBinary {"%"} (self, o: &BigInt)-> &BigInt
        throws BigIntError
    {
        if (__gmpz_cmp_ui (&o._content, 0u64) == 0) {
            throw copy BigIntError ("Dividing by 0");
        }
        
        let dmut res = mpz_t ();
        __gmpz_init (alias &res);

        __gmpz_tdiv_r (alias &res, &self._content, &o._content);
        
        copy BigInt (res)
    }

    /**
     * Computes the remainder of a BigInt and a numeric value.
     *
     * @params:
     *   - o: converted to BigInt
     */
    pub fn opBinary {"%", T} (self, o: T)-> &BigInt
        throws BigIntError
    {
        self % copy BigInt (o)
    }

    /**
     * Computes the remainder of a numeric value and a BigInt, where `self` is the right operand.
     *
     * @params:
     *   - o: converted to BigInt
     */
    pub fn opBinaryRight {"%", T} (self, o: T)-> &BigInt
        throws BigIntError
    {
        copy BigInt (o) % self
    }

    /**
     * Raises the BigInt to an integer power.
     *
     * @params:
     *   - o: exponent (must fit in u64)
     *
     * @throws:
     *   - BigIntError if exponent does not fit in u64.
     */
    pub fn opBinary {"^^"} (self, o: &BigInt)-> &BigInt
        throws BigIntError
    {                
        let dmut res = mpz_t ();
        __gmpz_init (alias &res);
        __gmpz_pow_ui (alias &res, &self._content, o.to!u64 ());
        
        copy BigInt (res)
    }

    /**
     * Raises the BigInt to an integer power.
     *
     * @params:
     *   - o: exponent (must fit in u64)
     *
     * @throws:
     *   - BigIntError if exponent does not fit in u64.
     */
    pub fn opBinary {"^^", T} (self, o: T)-> &BigInt
        throws BigIntError
    {
        self ^^ copy BigInt (o)
    }

    /**
     * Raises a numeric value to a BigInt power.
     *
     * @params:
     *   - o: the numeric value to raise.
     *
     * @throws:
     *   - BigIntError if `self` does not fit in u64.
     */
    pub fn opBinaryRight {"^^", T} (self, o: T)-> &BigInt
        throws BigIntError
    {
        copy BigInt (o) ^^ self
    }
    
    /**
     * Compares two BigInt values.
     *
     * @returns:
     *   -1, 0, or 1 depending on ordering.
     */
    pub fn opCmp (self, o: &BigInt)-> i32 {
        __gmpz_cmp (&self._content, &o._content)
    }

    /**
     * Compares a BigInt with a numeric value.
     */
    pub fn opCmp {T} (self, o: T)-> i32 {
        self.opCmp (copy BigInt (o))
    }

    /**
     * Returns the absolute value of the BigInt.
     */
    pub fn abs (self)-> &BigInt {
        if (self < 0) { return 0 - self }
        else { return self; }
    }

    /**
     * Converts the BigInt to a built-in integer type.
     *
     * @throws:
     *   - BigIntError if the value does not fit in the target type.
     */
    pub fn to {T} (self)-> T
        throws BigIntError
    {
        if (self < T::min) throw copy BigIntError ("Fail to convert");
        if (self > T::max) throw copy BigIntError ("Fail to convert");
        cte if !isSigned!{T} {
            let ui = __gmpz_get_ui (&self._content);
            cast!T (ui)
        } else {
            let si = __gmpz_get_si (&self._content);
            cast!T (si)
        }
    }

    /**
     * Converts the BigInt to a built-in integer type.
     *
     * @warning:
     *   Panics if the value does not fit in the target type.
     */
    pub fn toT {T} (self)-> T
    {
        if (self < T::min) panic;
        if (self > T::max) panic;
        cte if !isSigned!{T} {
            let ui = __gmpz_get_ui (&self._content);
            cast!T (ui)
        } else {
            let si = __gmpz_get_si (&self._content);
            cast!T (si)
        }
    }

    /**
     * Converts the BigInt to a built-in integer type without overflow checks.
     *
     * @warning:
     *   May truncate or wrap the value.
     */
    pub fn toN {T} (self)-> T
    {
        cte if !isSigned!{T} {
            let ui = __gmpz_get_ui (&self._content);
            cast!T (ui)
        } else {
            let si = __gmpz_get_si (&self._content);
            cast!T (si)
        }
    }
    
    /**
     * Releases GMP resources.
     *
     * @behavior:
     *   - Calls `__gmpz_clear` on the internal value.
     */
    __dtor (mut self) {
        __gmpz_clear (alias &self._content);    
    }
    
    impl Streamable {

        /**
         * Writes the BigInt to a stream.
         *
         * @behavior:
         *   - Uses GMP’s "%Zd" formatting.
         *   - Allocates a temporary buffer to hold the string representation.
         */
        pub over toStream (self, dmut stream: &StringStream) {
            let len = __gmp_snprintf (null, 0u32, "%Zd".ptr, &self._content);
            let dmut res = copy ['\u{0}' ; len + 1us];

            __gmp_snprintf (alias res.ptr, len + 1u32, "%Zd".ptr, &self._content);
            stream:.write (res[0us .. $ - 1us]);
        }        

    }

}
