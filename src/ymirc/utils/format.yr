/*
 * Declares traits, and classes used to format elements into strings.
 *
 * <h2>Overview</h2>
 * This module provides Ymir’s extended formatting system. It replaces the
 * standard formatter with a more expressive version that supports:
 *
 *   - ad-hoc formatting flags,
 *   - inline color directives,
 *   - recursive formatting of complex types,
 *   - automatic fallback to <code>Streamable</code>,
 *   - error-aware formatting for diagnostic output.
 *
 * The central component is <code>Formatter</code>, which writes efficiently
 * into a <code>StringStream</code> and exposes <code>write</code> and
 * <code>writef</code> methods for structured formatting.
 *
 * <h2>Basic Usage</h2>
 * ```yr
 * use ymirc::utils::format;
 *
 * let s = format("Hello %, the answer is %", "world", 42);
 * println(s);   // "Hello world, the answer is 42"
 * ```
 *
 * <h2>Color Formatting</h2>
 * The formatter supports inline color codes using the syntax:
 *
 *   - <code>%(x)</code> — apply color to the next formatted argument  
 *   - <code>@(x=...)</code> — apply color to a literal substring
 *
 * Example:
 * ```yr
 * println(format("%(y)%: something happened", "Warning"));   // yellow
 * println(format("%(r)%", "Error"));                         // red
 * println(format("%(g)%: operation completed", "Success"));  // green
 *
 * println(format("Status: @(g=OK)"));                        // literal colored text
 * ```
 *
 * Colors are automatically reset after each colored segment. When compiled with
 * <code>__version NO_COLORS</code>, all color directives expand to empty
 * strings.
 *
 * <h2>Formatting Complex Types</h2>
 * Any type implementing <code>Formattable</code> or <code>ErrorFormattable</code>
 * is formatted using its custom logic:
 * ```yr
 * class X {
 *     impl Formattable {
 *         pub over format (self, dmut stream: &Formatter) {
 *              stream:.write ("X!!");
 *         }
 *     }
 * }
 * 
 * let x = copy X();
 * println(format("Value = %", x)); // 'Value = X!!'
 * ```
 *
 * Arrays, tuples, options, and records/classes are formatted structurally.
 *
 * <h2>Format Tags</h2>
 * <code>FormatTags</code> allows enabling or disabling additional formatting
 * features (debug mode, parameter printing, variable IDs, etc.):
 * ```yr
 * let tags = FormatTags(forDebug-> true);
 * println (format("Debug: %", someValue, tags-> tags));
 * ```
 *
 * <h2>Low-Level Usage</h2>
 * The <code>Formatter</code> class can be used directly for incremental
 * construction:
 * ```yr
 * let dmut f = copy Formatter();
 * f:.write("x = ");
 * f:.writef("%", 123);
 * println(f[]);
 * ```
 * <hr>
 * 
 * @Package: ymirc        
 * @Module: ymirc::utils::format
 * @File: ymirc/utils/format.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created (YYYY-MM-DD): 2021-11-12
 * @Copyright (C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */


in format;

use ymirc::utils::colors;
use std::{io, stream};


pub lazy dmut __WITH_COLOR__: [bool] = copy [true];

pub fn doNotFormatColor (b: bool) {
    __WITH_COLOR__ [0] = !b;
}

/**
 * Trait for types that support custom formatting.
 *
 * A type implementing `Formattable` provides a `format` method that writes its
 * representation into a `Formatter`. This allows fine-grained control over how
 * values appear in formatted strings.
 *
 * @note
 *   If a type does not implement `Formattable`, the formatter falls back to
 *   `Streamable` or raw writing.
 */
pub trait Formattable {
    pub fn format (self, dmut stream: &Formatter);
}

/**
 * Trait for types that support structured error formatting.
 *
 * This trait is used by the diagnostic subsystem to format nested errors, track
 * recursion depth, and avoid re‑printing repeated error IDs.
 *
 * @params:
 *   - root:  whether this is the top‑level error
 *   - depth: current recursion depth
 *
 * @note
 *   Only error types should implement this trait.
 */
pub trait ErrorFormattable {
    pub fn format (self, dmut stream: &Formatter, root: bool, depth: u32);
}

/**
 * Controls optional behaviors of the formatting engine.
 *
 * FormatTags allows callers to enable or disable additional formatting
 * features. These flags are primarily used by the compiler, error reporter,
 * and debugging tools to customize how values, parameters, and diagnostics
 * are displayed.
 *
 * @fields:
 *   - withParams:
 *       Enables printing of parameter lists when formatting callable objects.
 *
 *   - withErrorIds:
 *       Enables printing of unique error identifiers during error formatting.
 *       Useful for debugging recursive or repeated errors.
 *
 *   - withVarIds:
 *       Enables printing of variable identifiers (internal compiler IDs).
 *
 *   - forParams:
 *       Indicates that formatting is being performed inside a parameter list.
 *       Used to adjust spacing and punctuation rules.
 *
 *   - forDebug:
 *       Enables debug‑oriented formatting, exposing additional internal
 *       information about values and structures.
 *
 *   - verbose:
 *       Enables verbose formatting, printing extended details when available.
 *
 *   - short:
 *       Enables compact formatting, suppressing non‑essential information.
 *
 *   - withVars:
 *       Enables printing of variable names or symbolic identifiers.
 *
 * @example:
 * ```yr
 * let tags = FormatTags(forDebug-> true, verbose-> true);
 * println(format("Value = %", tags-> tags, someValue));
 * ```
 */
pub record FormatTags {
    pub let withParams: bool;
    pub let withErrorIds: bool;
    pub let withVarIds: bool;
    pub let forParams: bool;
    pub let forDebug: bool;
    pub let verbose: bool;
    pub let short: bool;
    pub let withVars: bool;

    pub self (withParams:   bool = false,
              withErrorIds: bool = false,
              withVarIds:   bool = false,
              forParams:    bool = false,
              forDebug:     bool = false,
              verbose:      bool = false,
              short:        bool = false,
              withVars:     bool = false)
        
        with withParams = withParams
        , withErrorIds  = withErrorIds
        , withVarIds    = withVarIds
        , forParams     = forParams
        , forDebug      = forDebug
        , verbose       = verbose
        , short         = short
        , withVars      = withVars
    {}
}

/**
 * A high-performance string formatter.
 *
 * Formatter writes into an internal `StringStream` and provides advanced
 * formatting features:
 *
 *   - inline formatting (`writef`),
 *   - color directives (`%(r)`, `@(g=...)`),
 *   - structural formatting of arrays, tuples, options, and records,
 *   - recursion-aware error formatting,
 *   - indentation control (`entabing`, `detabing`),
 *   - tracking of printed error/value IDs,
 *   - configurable behavior via `FormatTags`.
 *
 * Formatter is the core engine behind the `format` free functions.
 */
@final
pub class Formatter {

    prv {
        /**
         * Internal output buffer.
         *
         * All formatted content is written into this `StringStream`. The final
         * result is obtained through `opIndex`, which returns the accumulated
         * `[c8]` slice.
         */        
        let dmut _content: &StringStream = copy StringStream ();

        /**
         * Currently active color code, or `none` if no color is applied.
         *
         * Used by `writef` to restore color after writing punctuation or
         * structural delimiters (e.g., `{`, `}`, `,`).
         */        
        let mut _currentColor: ([c8])? = none;

        /**
         * Set of error IDs already formatted by this formatter.
         *
         * Prevents infinite recursion when formatting nested or repeated errors.
         */        
        let dmut _errorIds: [usize => ()] = copy [];
        
        /**
         * Tracks whether at least one full error has been written.
         *
         * Used by the diagnostic subsystem to decide whether to print "previous
         * error..." or a full error block.
         */
        let mut _wroteErrors: bool = false;
        
        /**
         * Set of value IDs already formatted by this formatter.
         *
         * Used to avoid re‑printing large or recursive values multiple times.
         */        
        let dmut _valueIds: [usize => ()] = copy [];
        
        /**
         * Mapping from internal YIL node IDs to stable, sequential identifiers.
         *
         * Ensures deterministic formatting of YIL structures.
         */
        let dmut _yilIds: [usize => usize] = copy [];
        
        /**
         * Counter used to assign new YIL IDs.
         */
        let mut _lastYilId: usize = 1us;
        
        /**
         * Formatting behavior flags.
         *
         * These tags control how the formatter prints parameters, variables,
         * debug information, and error metadata.
         */
        let _tags: FormatTags;
    }

    /**
     * Creates a formatter that shares error/value ID tracking with another.
     *
     * @params:
     *   - other: the formatter to inherit state from
     *
     * @behavior:
     *   - Shares `_errorIds` and `_valueIds` with `other`.
     *   - Copies formatting tags.
     *   - Creates a fresh output buffer.
     *
     */
    pub self from (dmut other: &Formatter)
        with _errorIds      = alias other._errorIds
        , _valueIds         = alias other._valueIds
        , _tags             = other._tags
    {}


    /**
     * Creates an empty formatter with the given formatting tags.
     *
     * @params:
     *   - tags: FormatTags — controls formatting behavior (default: none)
     */
    pub self (tags: FormatTags = FormatTags ())
        with _tags = tags
    {}

    /*!
     * =============================================================================
     * =============================================================================
     * =========================          ENTABING        ==========================
     * =============================================================================
     * =============================================================================
     */

    /**
     * Increases indentation for subsequent writes.
     *
     * @params:
     *   - txt: indentation string (default: four spaces)
     */
    pub fn entabing (mut self, txt: [c8] = "    ") {
        self._content:.entabing (txt-> txt);
    }

    /**
     * Decreases indentation level.
     */
    pub fn detabing (mut self) {
        self._content:.detabing ();
    }

    /*!
     * =============================================================================
     * =============================================================================
     * ===========================          CUSTOM        ==========================
     * =============================================================================
     * =============================================================================
     */

    /**
     * Returns a stable, unique ID for a given internal value.
     *
     * Used by the YIL (Ymir Intermediate Language) formatter to assign
     * deterministic identifiers to nodes.
     */
    pub fn getYilId (mut self, id: usize)-> usize {
        if let Ok (v) = self._yilIds [id] {
            return v;
        }

        let res = self._lastYilId ;
        self._lastYilId += 1;
        self._yilIds [id] = res;
        return res;
    }

    /*!
     * =============================================================================
     * =============================================================================
     * ============================          IDS        ============================
     * =============================================================================
     * =============================================================================
     */

    /**
     * @returns:
     *   true if the given error ID has already been formatted.
     */
    pub fn hasWrittenError (self, id: usize)-> bool {
        id in self._errorIds
    }

    /**
     * @returns:
     *   true if the given value ID has already been formatted.
     */
    pub fn hasWrittenValue (self, id: usize)-> bool {
        id in self._valueIds
    }
    
    /**
     * @returns:
     *   true if at least one full error has been formatted.
     */
    pub fn hasWrittenSomeErrors (self)-> bool {
        self._wroteErrors
    }

    /**
     * Marks whether a full error has been written.
     *
     * @params:
     *   - set: bool — new state
     */
    pub fn wroteErrors (mut self, set: bool) {
        self._wroteErrors = set;
    }

    /**
     * Registers an error ID as printed.
     */
    pub fn registerError (mut self, id: usize) {
        self._errorIds [id] = ();
    }

    /**
     * Registers a value ID as printed.
     */
    pub fn registerValue (mut self, id: usize) {
        self._valueIds [id] = ();
    }

    /**
     * @returns:
     *   The formatting tags associated with this formatter.
     */
    @field
    pub fn tags (self)-> FormatTags {
        self._tags
    }

    /*!
     * =============================================================================
     * =============================================================================
     * =========================          WRITTING        ==========================
     * =============================================================================
     * =============================================================================
     */
    
    /**
     * Writes a single UTF‑8 character into the formatter.
     */
    pub fn write (mut self, c: c8) -> dmut &Formatter {
        self._content:.write (c);
        alias self
    }
    
    /**
     * Writes a UTF‑8 string into the formatter.
     */
    pub fn write (mut self, c: [c8]) -> dmut &Formatter {
        self._content:.write (c);
        alias self
    }

    /**
     * Writes a primitive value into the formatter.
     *
     * @info:
     *   The value must be convertible to `[c8]`.
     */
    pub fn if (!is!{T}{class U} && !is!{T}{record U}) write {T} (mut self, c: T) -> dmut &Formatter {
        self._content:.write (c);
        alias self
    }

    /**
     * Writes a slice in `{a, b, c}` form.
     *
     * @behavior:
     *   - Respects current color state.
     *   - Resets color around punctuation.
     */
    pub fn write {T of [U], U} (mut self, c: T) -> dmut &Formatter {
        let mut j = 0u64;
        if let Ok (x) = self._currentColor && __WITH_COLOR__ [0] {
            self:.write (Colors::RESET, '{'c8, x);
        } else {
            self:.write ('{'c8);
        }

        for i in c {
            if (j != 0u64) {
                if let Ok (x) = self._currentColor && __WITH_COLOR__ [0] {
                    self:.write (Colors::RESET, ", ", x);
                } else {
                    self:.write (", ");
                }
            }

            j += 1u64;
            self:.write (i);            
        }

        if let Ok (x) = self._currentColor && __WITH_COLOR__ [0] {
            self:.write (Colors::RESET, '}'c8, x);
        } else {
            self:.write ('}'c8);
        }

        alias self
    }
    
    /**
     * Writes multiple values sequentially.
     */
    pub fn write {F, T...} (mut self, f: F, r: T) -> dmut &Formatter {
        self:.write (f);
        cte if (is!T {Z of (U,), U...}) {
            for i in r
                self:.write (i);
        } else {
            self:.write (r);
        }
        alias self
    }
    
    /**
     * Writes a tuple in `(a, b, c)` form.
     */
    pub fn write {T of (U,), U...} (mut self, a: T) -> dmut &Formatter {
        self:.write ('('c8);
        let mut j = 0;
        for i in a {
            if j != 0 {
                self:.write (','c8);
            }
            self:.write (i);
            j += 1;
        }        
        if (j == 1) self:.write (','c8);
        self:.write (')'c8);
        alias self
    }

    /**
     * Writes an option value as:
     *   - `Ok(x)`
     *   - `Err(msg)`
     *   - `Err()`
     */
    pub fn write {T} (mut self, a: T?) -> dmut &Formatter {
        match a {
            Ok  (x:_)   => self:.write ("Ok(", x, ')'c8);
            Err (msg:_) => self:.write ("Err(", msg, ')'c8);
            Err ()      => self:.write ("Err()");
        }
        alias self
    }
    
    /**
     * Writes a record or class.
     *
     * @behavior:
     *   - If the type implements `Formattable`, calls `format`.
     *   - If it implements `ErrorFormattable`, calls error formatting.
     *   - Otherwise falls back to raw writing.
     */
    pub fn if (is!{T}{class C} || is!{T}{record C}) write {T} (mut self, a: T) -> dmut &Formatter {
        cte if (is!{T}{U impl Formattable}) {
            a.format (alias self);
        } else cte if (is!{T}{U impl ErrorFormattable}) {
            a.format (alias self, root-> true, depth-> 0);
        } else {
            self._content:.write (a);
        }

        alias self
    }

    /*!
     * ===============================================================================
     * ===============================================================================
     * =========================          FORMATTING        ==========================
     * ===============================================================================
     * ===============================================================================
     */

    /**
     * Writes a formatted string with placeholders.
     *
     * @params:
     *   - format: format string
     *   - f:      first argument
     *   - args:   remaining arguments
     *
     * @syntax:
     *   - `%` inserts the next argument
     *   - `%(x)` applies a color to the next argument
     *   - `@(x=...)` applies a color to a literal substring
     *
     * @example:
     *   stream:.writef("x = %, y = %", 1, 2);
     */
    pub fn writef {F, T...} (mut self, format: [c8], f: F, args: T) -> dmut &Formatter {
        let mut i = 0us;
        while i < format.len {
            if (format [i] == '\\'c8 && i < format.len - 1us) {
                i += 1us;
            } else if (format [i] == '%'c8) {
                i += 1us;
                if (format.len > 2us && i < format.len - 2us && format [i] == '('c8) {
                    let col = match format [i + 1us] {
                        'r'c8 => { Colors::RED }
                        'b'c8 => { Colors::BLUE }
                        'y'c8 => { Colors::YELLOW }
                        'p'c8 => { Colors::PURPLE }
                        'g'c8 => { Colors::GREEN }
                        'B'c8 => { Colors::BOLD }
                        _ => { Colors::RESET }
                    };
                    if (__WITH_COLOR__ [0]) {
                        self._currentColor = (col)?;
                        self:.write (col);
                    }
                    self:.write (f);
                    if (__WITH_COLOR__ [0]) {
                        self:.write (Colors::RESET);
                        self._currentColor = none;
                    }

                    cte if (T,)::arity > 1 {
                        self:.writef (format [i + 3us .. $], expand args);
                    } else {
                        self:.writef (format [i + 3us .. $], args);
                    }
                } else {
                    self:.write (f);
                    cte if (T,)::arity > 1 {
                        self:.writef (format [i .. $], expand args);
                    } else {
                        self:.writef (format [i .. $], args);
                    }
                }
                
                break{}
            } else if (format [i] == '@'c8) {
                i += 1us;
                let col = match format [i + 1us] {
                    'r'c8 => { Colors::RED }
                    'b'c8 => { Colors::BLUE }
                    'y'c8 => { Colors::YELLOW }
                    'p'c8 => { Colors::PURPLE }
                    'g'c8 => { Colors::GREEN }
                    'B'c8 => { Colors::BOLD }
                    _ => { Colors::RESET }
                };

                i += 3us;
                if (__WITH_COLOR__ [0]) {
                    self._currentColor = (col)?;
                    self:.write (col);
                }
                while format [i] != ')'c8 {
                    self:.write (format [i]);
                    i += 1us;
                }

                i += 1us;
                if (__WITH_COLOR__ [0]) {
                    self:.write (Colors::RESET);
                    self._currentColor = none;
                }
            } else {
                self:.write (format [i]);
                i += 1us;
            }
        }
        alias self
    } 

    /**
     * Writes a formatted string with a single argument.
     */
    pub fn writef {F} (mut self, format: [c8], f: F) -> dmut &Formatter {
        let mut i = 0us;
        while i < format.len {
            if (format [i] == '\\'c8 && i < format.len - 1u64) {
                i += 1us;
            } else if (format [i] == '%'c8) {
                i += 1us;
                if (format.len > 2us && i < format.len - 2us && format [i] == '('c8) {
                    let col = match format [i + 1us] {
                        'r'c8 => { Colors::RED }
                        'b'c8 => { Colors::BLUE }
                        'y'c8 => { Colors::YELLOW }
                        'p'c8 => { Colors::PURPLE }
                        'g'c8 => { Colors::GREEN }
                        'B'c8 => { Colors::BOLD }
                        _ => { Colors::RESET }
                    };
                    if (__WITH_COLOR__ [0]) {
                        self._currentColor = (col)?;
                        self:.write (col);
                    }
                    self:.write (f);
                    if (__WITH_COLOR__ [0]) {
                        self:.write (Colors::RESET);                        
                        self._currentColor = none;
                    }
                    i += 3us;
                } else {
                    self:.write (f);
                }                
            } else if (format [i] == '@'c8) {
                i += 1us; // skip (
                let col = match format [i + 1us] {
                    'r'c8 => { Colors::RED }
                    'b'c8 => { Colors::BLUE }
                    'y'c8 => { Colors::YELLOW }
                    'p'c8 => { Colors::PURPLE }
                    'g'c8 => { Colors::GREEN }
                    'B'c8 => { Colors::BOLD }
                    _ => { Colors::RESET }
                };

                i += 3us; // skip y=
                if (__WITH_COLOR__ [0]) {
                    self._currentColor = (col)?;
                    self:.write (col);
                }
                while format [i] != ')'c8 {
                    self:.write (format [i]);
                    i += 1us;
                }

                i += 1us; // skip )
                if (__WITH_COLOR__ [0]) {
                    self:.write (Colors::RESET);
                    self._currentColor = none;
                }
            } else {
                self:.write (format [i]);
                i += 1us;
            }
        }
        alias self
    }

    /**
     * Writes a raw format string without arguments.
     */
    pub fn writef (mut self, format: [c8])-> dmut &Formatter {
        self:.write (format);
        alias self
    }

    /*!
     * ===============================================================================
     * ===============================================================================
     * =========================          GETTERS        =============================
     * ===============================================================================
     * ===============================================================================
     */
    
    /**
     * Returns the accumulated formatted content as a `[c8]` slice.
     */
    pub fn opIndex (self) -> [c8] {
        self._content []
    }
    
    /**
     * @returns:
     *   The currently active color, or `none` if no color is applied.
     */
    pub fn getCurrentColor (self)-> ([c8])? {
        self._currentColor
    }

    /*!
     * ================================================================================
     * ================================================================================
     * =========================           SETTERS            =========================
     * ================================================================================
     * ================================================================================
     */

    /**
     * Sets the current writing color.
     *
     * @params:
     *   - color: optional color code
     */
    pub fn setCurrentColor (mut self, color: ([c8])?) {
        self._currentColor = color;
    }

    impl Streamable {
        
        /**
         * Writes the formatter’s content into another stream.
         *
         * Used when a Formatter itself is printed.
         */
        pub over toStream (self, dmut stream: &StringStream) {
            stream:.write (self._content[]);
        }
    }
    
}

/**
 * Formats a string using the given tags and arguments.
 *
 * @returns:
 *   A newly allocated `[c8]` containing the formatted result.
 */
pub fn format {T...} (txt: [c8], tags: FormatTags, args: T) -> [c8] {
    let dmut buf = copy Formatter (tags-> tags);
    cte if (T,)::arity > 1 {
        buf:.writef (txt, expand args);
    } else {
        buf:.writef (txt, args);
    }

    buf[]
}

/**
 * Formats a string using default formatting tags.
 */
pub fn format {T...} (txt: [c8], args: T) -> [c8] {
    let dmut buf = copy Formatter (tags-> FormatTags ());
    cte if (T,)::arity > 1 {
        buf:.writef (txt, expand args);
    } else {
        buf:.writef (txt, args);
    }

    buf[]
}

/**
 * Formats a raw string without arguments.
 */
pub fn format (txt: [c8], tags: FormatTags) -> [c8] {
    let dmut buf = copy Formatter (tags-> tags);
    buf:.writef (txt, "");
    buf[]
}

/**
 * Formats a raw string without arguments.
 */
pub fn format (txt: [c8]) -> [c8] {
    let dmut buf = copy Formatter (tags-> FormatTags ());
    buf:.writef (txt, "");
    buf[]
}
