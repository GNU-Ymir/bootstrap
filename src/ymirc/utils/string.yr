in string;

use std::algorithm::comparison;
use ymirc::utils::colors;
use std::{stream, conv};

/**
 * Returns the index of the last occurrence of a character in a UTF-32 string.
 *
 * @params:
 *   - str: the string to search
 *   - c:   the character to locate
 *
 * @returns:
 *   The index of the last occurrence of `c` in `str`.
 *   If `c` does not appear in `str`, returns `str.len`.
 *
 * @behavior:
 *   - Search is performed from the end toward the beginning.
 *   - Complexity: O(n).
 */
pub fn findLast(str: [c32], c: c32)-> usize {
    for i in str.len .. 0us {
        if (str[i - 1us] == c) return i - 1us;
    }

    return str.len;
}

/**
 * Returns the index of the last occurrence of a character in a UTF-8 string.
 *
 * @params:
 *   - str: the string to search
 *   - c:   the character to locate
 *
 * @returns:
 *   The index of the last occurrence of `c` in `str`.
 *   If `c` does not appear in `str`, returns `str.len`.
 *
 * @behavior:
 *   - Search is performed from the end toward the beginning.
 *   - Complexity: O(n).
 */
pub fn findLast(str: [c8], c: c8)-> usize {
    for i in str.len .. 0us {
        if (str[i - 1us] == c) return i - 1us;
    }

    return str.len;
}


/**
 * Produces a shortened representation of a string.
 *
 * If `str.len < max`, the original string is returned unchanged. Otherwise, the
 * string is truncated symmetrically and `add` is inserted between the preserved
 * prefix and suffix.
 *
 * @params:
 *   - str:  the string to shorten
 *   - max:  maximum allowed length(default: 100)
 *   - add:  marker inserted in the middle(default: "[...]")
 *
 * @returns:
 *   A new string whose length is <= `max`.
 *
 * @behavior:
 *   - The preserved prefix and suffix have equal length when possible.
 *   - `add` is always included when truncation occurs.
 *
 * @example:
 *   shorten("abcdefghijklmnopqrstuvwxyz", max-> 10)
 *-> "abc[...]yz"
 */
pub fn shorten(str: [c8], max: u64 = 100u64, add: [c8] = { Colors::BOLD ~ "[...]" ~ Colors::RESET })-> [c8] {
    if (str.len < max) {
        return str;
    } else {
        let xIndex = cast!usize(max) / 2us - (add.len / 2);
        let yIndex = (str.len) - (cast!usize(max) / 2us) + (add.len - (add.len / 2));

        let mut fst = str[0us .. xIndex];
        fst ~= add;
        fst ~= str[yIndex .. $];

        return fst
    }
}

/**
 * Centers a string within a field of width `nb`, padding with `concat`.
 *
 * @params:
 *   - str:    the string to center
 *   - nb:     total width of the resulting string
 *   - concat: padding character(default: ' ')
 *
 * @returns:
 *   A new string of length `nb`, or `str` unchanged if `str.len ≥ nb`.
 *
 * @behavior:
 *   - Padding is distributed symmetrically.
 *   - When `nb - str.len` is odd, the right side receives the extra padding.
 *   - Works for any integral type `I`.
 *
 * @example:
 *   center("test", 10u64)-> "   test   "
 */
pub fn center(str: [c8], nb: usize, concat: c8 = ' ')-> [c8] {
    if (str.len >= cast!usize(nb)) {
        str
    } else {
        let p = cast!usize(nb) - str.len;
        let dmut res = copy ['\u{0}' ; nb];
        let mut j = 0us;
        while j < p / 2 {
            res[j] = concat;
            j += 1us;
        }
        for i in str {
            res[j] = i;
            j += 1us;
        }
        while j < res.len {
            res[j] = concat;
            j += 1us;
        }
        res
    }
}

/**
 * Centers a string within a field of width `nb`, padding with `concat`.
 * Concat is single char but encoded in utf32(to enable the centering using unicode values).
 * It's length is considered to be 1.
 *
 * @params:
 *   - str:    the string to center
 *   - nb:     total width of the resulting string
 *   - concat: padding character(default: ' ')
 *
 * @returns:
 *   A new string of length `nb`, or `str` unchanged if `str.len >= nb`.
 *
 * @behavior:
 *   - Padding is distributed symmetrically.
 *   - When `nb - str.len` is odd, the right side receives the extra padding.
 *   - Works for any integral type `I`.
 *
 * @example:
 *   center("test", 10u64)-> "   test   "
 */
pub fn center32(str: [c8], nb: usize, concat: c32 = ' 'c32)-> [c8] {
    if (str.len >= cast!usize(nb)) {
        str
    } else {
        let p = cast!usize(nb) - str.len;
        let dmut res = copy std::stream::StringStream();
        let sconcat = std::conv::to![c8](copy [concat]);
        let mut j = 0us;
        while j < p / 2 {
            res:.write(sconcat);
            j += 1us;
        }
        res:.write(str);
        while j < p {
            res:.write(sconcat);
            j += 1us;
        }

        return res[];
    }
}


/**
 * Computes the Levenshtein edit distance between two strings.
 *
 * @params:
 *   - left:  first string
 *   - right: second string
 *
 * @returns:
 *   The minimum number of insertions, deletions, and substitutions
 *   required to transform `left` into `right`.
 *
 * @behavior:
 *   - Dynamic programming implementation.
 *   - Complexity: O(n*m) time, O(n*m) memory.
 *   - Characters are compared as raw UTF-8 code units(no normalization).
 */
pub fn levenshteinDistance(left: [c8], right: [c8])-> usize {
    if (left.len == 0us) return right.len;
    if (right.len == 0us) return left.len;

    let rlen = right.len + 1us, llen = left.len + 1us;
    let dmut matrix = copy [0us ; (left.len + 1us) * (right.len + 1us)];
    for k in 0us .. llen {
        matrix[k * rlen] = k;
    }

    for k in 0us .. rlen {
        matrix[k] = k;
    }

    for x in 1us .. llen {
        for y in 1us .. rlen  {
            if left[x - 1us] == right[y - 1us] {
                matrix[x * rlen + y] = min(
                    matrix[(x - 1us) * rlen + y] + 1us,
                    min(
                        matrix[(x - 1us) * rlen + (y - 1us)],
                        matrix[x * rlen + (y - 1us)] + 1us));

            } else {
                matrix[x * rlen + y] = min(
                    matrix[(x - 1us) * rlen + y] + 1us,
                    min(
                        matrix[(x - 1us) * rlen + (y - 1us)] + 1us,
                        matrix[x * rlen + (y - 1us)] + 1us));
            }
        }
    }

    matrix[left.len * rlen + right.len]
}

/**
 * Remove leading and trailing underscores from an identifier while preserving
 * internal ones.
 *
 * Underscores are accumulated but only emitted after the first non-underscore
 * character is seen. Trailing underscores are dropped because they are never
 * flushed.
 *
 * Examples:
 *     "__foo"    → "foo"
 *     "foo__"    → "foo"
 *     "_a_b_"    → "a_b"
 *     "___"      → ""
 *
 * @params:
 *    - name: raw identifier as a byte slice
 * @return: identifier without leading or trailing underscores
 *
 */
pub fn stripUnders(name: [c8])-> [c8] {
    let dmut result = copy StringStream();
    let mut started = false, mut nb = 0us;
    for i in name {
        if (i == '_'c8) {
            nb += 1us;
        } else {
            if (started) {
                for _ in 0us .. nb {
                    result:.write('_'c8);
                }
            }
            result:.write(i);
            started = true;
            nb = 0us;
        }
    }

    result[]
}

/**
 * Computes the length of the longest line in a string.
 *
 * @params:
 *   - str: the input string
 *
 * @returns:
 *   The maximum number of characters between two newline characters. If the
 *   string contains no newline, returns `str.len`.
 *
 * @behavior:
 *   - Newlines(`'\n'`) delimit lines.
 *   - Does not count the newline character itself.
 */
pub fn maxLineLength(str: [c8])-> usize {
    let mut curMax = 0us, mut curLineLen = 0us;
    for i in str {
        if (i == '\n') {
            if curLineLen > curMax { curMax = curLineLen; }
            curLineLen = 0us;
        }

        else curLineLen += 1us;
    }

    if curMax == 0us {
        str.len // no line return found
    } else {
        curMax
    }
}

/**
 * Computes the MD5 hash of a byte array.
 *
 * @params:
 *   - data: input message
 *
 * @returns:
 *   A 32 chars lowercase hexadecimal string representing the MD5 digest.
 *
 * @behavior:
 *   - Implements the MD5 algorithm as specified in RFC 1321.
 *   - Processes the message in 512-bit(64-byte) blocks.
 *   - Padding: appends 0x80, then zeros, then the 64-bit message length in bits.
 *   - Message words and output digest use little-endian encoding.
 *   - Internal state initialized to standard MD5 constants(A, B, C, D).
 *   - Produces the canonical MD5 output identical to `md5sum`.
 *
 * @example:
 *   md5("abc") → "900150983cd24fb0d6963f7d28e17f72"
 */
pub fn md5(data: [u8])-> [c8] {

    // --- MD5 constants -------------------------------------------------------
    let K = [
        0xd76aa478_u32, 0xe8c7b756_u32, 0x242070db_u32, 0xc1bdceee_u32,
        0xf57c0faf_u32, 0x4787c62a_u32, 0xa8304613_u32, 0xfd469501_u32,
        0x698098d8_u32, 0x8b44f7af_u32, 0xffff5bb1_u32, 0x895cd7be_u32,
        0x6b901122_u32, 0xfd987193_u32, 0xa679438e_u32, 0x49b40821_u32,

        0xf61e2562_u32, 0xc040b340_u32, 0x265e5a51_u32, 0xe9b6c7aa_u32,
        0xd62f105d_u32, 0x02441453_u32, 0xd8a1e681_u32, 0xe7d3fbc8_u32,
        0x21e1cde6_u32, 0xc33707d6_u32, 0xf4d50d87_u32, 0x455a14ed_u32,
        0xa9e3e905_u32, 0xfcefa3f8_u32, 0x676f02d9_u32, 0x8d2a4c8a_u32,

        0xfffa3942_u32, 0x8771f681_u32, 0x6d9d6122_u32, 0xfde5380c_u32,
        0xa4beea44_u32, 0x4bdecfa9_u32, 0xf6bb4b60_u32, 0xbebfbc70_u32,
        0x289b7ec6_u32, 0xeaa127fa_u32, 0xd4ef3085_u32, 0x04881d05_u32,
        0xd9d4d039_u32, 0xe6db99e5_u32, 0x1fa27cf8_u32, 0xc4ac5665_u32,

        0xf4292244_u32, 0x432aff97_u32, 0xab9423a7_u32, 0xfc93a039_u32,
        0x655b59c3_u32, 0x8f0ccc92_u32, 0xffeff47d_u32, 0x85845dd1_u32,
        0x6fa87e4f_u32, 0xfe2ce6e0_u32, 0xa3014314_u32, 0x4e0811a1_u32,
        0xf7537e82_u32, 0xbd3af235_u32, 0x2ad7d2bb_u32, 0xeb86d391_u32
    ];

    let S: [u32; 64] = [
        7,12,17,22,  7,12,17,22,  7,12,17,22,  7,12,17,22,
        5, 9,14,20,  5, 9,14,20,  5, 9,14,20,  5, 9,14,20,
        4,11,16,23,  4,11,16,23,  4,11,16,23,  4,11,16,23,
        6,10,15,21,  6,10,15,21,  6,10,15,21,  6,10,15,21
    ];

    // --- Initial state -------------------------------------------------------
    let mut a0: u32 = 0x67452301u32;
    let mut b0: u32 = 0xefcdab89u32;
    let mut c0: u32 = 0x98badcfeu32;
    let mut d0: u32 = 0x10325476u32;

    // --- Preprocessing -------------------------------------------------------
    let mut msg: [mut u8] = copy data;

    // append "1" bit
    msg ~= [0x80_u8];

    // pad with zeros until length ≡ 56 mod 64
    while ((msg.len % 64us) != 56us) {
        msg ~= [0x00_u8];
    }

    // append original length in bits(little endian)
    let bitLen: usize = (data.len * 8us);
    for i in 0us .. 8us {
        msg ~= [cast!u8((bitLen >> (8us * i)) & 0xffu64)];
    }

    // --- Process 512-bit chunks ---------------------------------------------
    for chunkStart in (0us .. msg.len).stepBy(64us) {

        let mut M: [u32] = [];
        for i in 0us .. 16us {
            let j = chunkStart + (i * 4);
            let v = (cast!u32(msg[j]))
                    | (cast!u32(msg[j+1]) << 8)
                    | (cast!u32(msg[j+2]) << 16)
                    | (cast!u32(msg[j+3]) << 24);
            M ~= [v];
        }

        let mut A = a0;
        let mut B = b0;
        let mut C = c0;
        let mut D = d0;

        for i in 0u32 .. 64u32 {
            let (mut F: u32, mut g: u32) =
                if (i < 16us) {
                    ((B & C) | ((!B) & D), i)
                } else if (i < 32) {
                    ((D & B) | ((!D) & C), (5*i + 1) % 16)
                } else if (i < 48) {
                    (B ^ C ^ D, (3 * i + 5) % 16)
                } else {
                    (C ^ (B | (!D)), (7 * i) % 16)
                };

            F = F + A + K[i] + M[g];
            A = D;
            D = C;
            C = B;
            B = B + ((F << S[i]) | (F >> (32 - S[i])));
        }

        a0 += A;
        b0 += B;
        c0 += C;
        d0 += D;
    }

    // --- Output digest -------------------------------------------------------
    let dmut out = copy StringStream();

    fn writeLE(dmut out: &StringStream, c: u32) {
        let x = cast!u8(c & 0xff);
        let y = cast!u8((c >> 8) & 0xff);
        let z = cast!u8((c >> 16) & 0xff);
        let w = cast!u8((c >> 24) & 0xff);

        fn writeByte(dmut out: &StringStream, b: u8) {
            let s = to!{[c8], "x"}(b);   // produces "0x5" or "0xa3"
            let hex = s[2..$];          // strip "0x"

            if (hex.len == 1) {
                out:.write("0");        // add leading zero
            }
            out:.write(hex);
        }

        writeByte(alias out, x);
        writeByte(alias out, y);
        writeByte(alias out, z);
        writeByte(alias out, w);
    }

    writeLE(alias out, a0);
    writeLE(alias out, b0);
    writeLE(alias out, c0);
    writeLE(alias out, d0);

    out[]
}
