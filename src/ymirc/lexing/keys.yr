 */
pub enum PragmaKeys
| ANCESTOR      = "super"
| COMPILE       = "compile"
| FIELD         = "field"
| FIELD_INFOS   = "field_infos"
| FIELD_TYPE    = "field_type"
| HAS_ANCESTOR  = "has_super"
| MSG           = "msg"
| OPERATOR      = "operator"
| ROOT_ANCESTOR = "root_super"
| UNPROXIED     = "unproxied";

/**
 * Keys used in macro pattern matching to classify expected token types.
 *
 */
pub enum MacroKeys
| ANY    = "any"
| CHAR   = "char"
| EXPR   = "expr"
| FLOAT  = "float"
| IDENT  = "ident"
| INT    = "int"
| STRING = "str"
| TOKEN  = "token"
| WORD   = "word"
| INDEX  = "index"
| UID    = "uid"
| SKIPS  = "skips"
| FILEI  = "#__macro";

/**
 * Keys representing built-in macro rule categories.
 *
 */
pub enum MacroKnownRuleKeys
| ANY     = "any"
| CHAR    = "char"
| EXPR    = "expr"
| OPERAND = "operand"
| IDENT   = "ident"
| STRING  = "str"
| TOKEN   = "token"
| LITERAL = "literal";

/**
 * Keys used to access delegate metadata(function pointer + context).
