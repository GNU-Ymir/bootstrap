/**
 * Suffixes allowed after string literals, indicating their encoding.
 *
 */
pub enum StringSuffixes
| UTF8  = "s8"
| UTF16 = "s16"
| UTF32 = "s32";

/**
 * Suffixes allowed after character literals, indicating their encoding.
 *
 */
pub enum CharSuffixes
| UTF8  = "c8"
| UTF16 = "c16"
| UTF32 = "c32";

/**
 * Suffixes allowed after integer literals, specifying their numeric type.
 *
 */
pub enum FixedSuffixes
| U8	= "u8"
| U16	= "u16"
| U32	= "u32"
| U64	= "u64"
| USIZE = "us"
| I8	= "i8"
| I16	= "i16"
| I32	= "i32"
| I64	= "i64"
| ISIZE = "is";

/**
 * Suffixes allowed after floating-point literals, specifying precision.
 *
 */
pub enum FloatSuffixes
| F32   = "f"
| F64   = "d"
| F80   = "l"
| REAL  = "r";

/**
 * Valid exponent markers for floating-point literals.
 *
 */
pub enum FloatExp
| LE = "e"
| BE = "E"
| LP = "p"
| BP = "P";

/**
 * Keywords that introduce top-level declarations in a module.
 *
 */
pub enum GlobalDeclKeys
| DEF      = Keys::DEF
| ENUM     = Keys::ENUM
| MACRO    = Keys::MACRO
| MOD      = Keys::MOD
| TRAIT    = Keys::TRAIT
| UNITTEST = Keys::UNITTEST
| CLASS    = Keys::CLASS
| FUNCTION = Keys::FUNCTION
| LAZY     = Keys::LAZY
| RECORD   = Keys::RECORD
| STATIC   = Keys::STATIC
| ENTITY   = Keys::ENTITY
| UNION    = Keys::UNION;

/**
 * Tokens used in macro repetition constructs(e.g., `*`, `+`, `?`).
 *
 */
pub enum MacroMultTokens
| STAR     = Tokens::STAR
| PLUS     = Tokens::PLUS
| INTEG    = Tokens::INTEG;


/**
 * Groups of binary operators ordered by precedence.
 * Used by the expression parser to resolve operator binding.
 *
 */
pub enum BinaryOperatorsLevels
| LEVEL_0 = copy [Tokens::EQUAL, Tokens::DIV_AFF, Tokens::MINUS_AFF, Tokens::PLUS_AFF, Tokens::STAR_AFF, Tokens::PERCENT_AFF, Tokens::TILDE_AFF, Tokens::LEFTD_AFF, Tokens::RIGHTD_AFF]
| LEVEL_1 = copy [Tokens::DPIPE]
| LEVEL_2 = copy [Tokens::DAND]
| LEVEL_3 = copy [Tokens::INF, Tokens::SUP, Tokens::INF_EQUAL, Tokens::SUP_EQUAL, Tokens::NOT_EQUAL, Tokens::DEQUAL, Keys::OF, Keys::IS, Keys::IN, Keys::NOT_OF, Keys::NOT_IS, Keys::NOT_IN, Tokens::CONGRUENT, Tokens::UNCONGRUENT]
| LEVEL_4 = copy [Tokens::TDOT, Tokens::DDOT]
| LEVEL_5 = copy [Tokens::LEFTD, Tokens::RIGHTD]
| LEVEL_6 = copy [Tokens::PIPE, Tokens::XOR, Tokens::AND]
| LEVEL_7 = copy [Tokens::PLUS, Tokens::TILDE, Tokens::MINUS]
| LEVEL_8 = copy [Tokens::STAR, Tokens::PERCENT, Tokens::DIV]
| LEVEL_9 = copy [Tokens::DXOR];

/**
 * Named precedence levels for binary operators.
 * These correspond to the indices of `BinaryOperatorsLevels`.
 *
 */
pub enum BinaryOperatorsLevelNames: u32 
| AFFECT     = 0
| BOOL_LOGIC = 1
| COMPARE    = 3
| RANGE      = 4
| MATH       = 7
| OPERAND    = 10;

/**
 * Canonical identifiers for all binary operators recognized by the lexer.
 *
 */
pub enum BinaryOperators: [c8]
| EQUAL            = Tokens::EQUAL
| DIV_AFF          = Tokens::DIV_AFF
| MINUS_AFF        = Tokens::MINUS_AFF
| PLUS_AFF         = Tokens::PLUS_AFF
| STAR_AFF         = Tokens::STAR_AFF
| PERCENT_AFF      = Tokens::PERCENT_AFF
| TILDE_AFF        = Tokens::TILDE_AFF
| LEFTD_AFF        = Tokens::LEFTD_AFF
| RIGHTD_AFF       = Tokens::RIGHTD_AFF
| DPIPE            = Tokens::DPIPE
| DAND             = Tokens::DAND
| INF              = Tokens::INF
| SUP              = Tokens::SUP
| INF_EQUAL        = Tokens::INF_EQUAL
| SUP_EQUAL        = Tokens::SUP_EQUAL
| NOT_EQUAL        = Tokens::NOT_EQUAL
| DEQUAL           = Tokens::DEQUAL
| CONGRUENT        = Tokens::CONGRUENT
| UNCONGRUENT      = Tokens::UNCONGRUENT
| OF               = Keys::OF
| IS               = Keys::IS
| IN               = Keys::IN
| NOT_OF           = Keys::NOT_OF
| NOT_IS           = Keys::NOT_IS
| NOT_IN           = Keys::NOT_IN
| TDOT             = Tokens::TDOT
| DDOT             = Tokens::DDOT
| LEFTD            = Tokens::LEFTD
| RIGHTD           = Tokens::RIGHTD
| PIPE             = Tokens::PIPE
| XOR              = Tokens::XOR
| AND              = Tokens::AND
| PLUS             = Tokens::PLUS
| TILDE            = Tokens::TILDE
| MINUS            = Tokens::MINUS
| STAR             = Tokens::STAR
| PERCENT          = Tokens::PERCENT
| DIV              = Tokens::DIV
| DXOR             = Tokens::DXOR
| DOT              = Tokens::DOT
| DOT_AND          = Tokens::DOT_AND
| DCOLON           = Tokens::DCOLON;

/**
 * Canonical identifiers for unary operators recognized by the lexer.
 *
 */
pub enum UnaryOperators
| MINUS  = Tokens::MINUS
| AND    = Tokens::AND
| STAR   = Tokens::STAR
| NOT    = Tokens::NOT;

/**
 * Identifiers for multi-character operators such as call `()` and index `[]`.
 *
 */
pub enum MultOperators
| CALL      = "()"
| INDEX     = "[]"
| INDEX_AND = ":[]";

/**
 * Keywords representing variable or declaration decorators.
 *
 */
pub enum Decorators
| MUT     = Keys::MUTABLE
| DMUT    = Keys::DMUTABLE;

/**
 * Keywords used to express memory-related operations(copy, move, alias, etc.).
 *
 */
pub enum MemoryKeys
| COPY    = Keys::COPY
| EXPAND  = Keys::EXPAND
| ALIAS   = Keys::ALIAS
| DCOPY   = Keys::DCOPY
| REF     = Keys::REF
| MOVE    = Keys::MOVE;

/**
 * List of known user-defined attributes that can appear in attribute blocks.
 *
 */
pub enum Attributes: [c8]
| ABSTRACT      = "abstract"
| FINAL         = "final"
| FIELD         = "field"
| THREAD        = "thread"
| OVERLAID      = "overlaid"
| PACKED        = "packed"
| UNSAFE        = Keys::UNSAFE
| INLINE        = Keys::INLINE;

/**
 * Keywords used in `scope(exit|failure|success)` constructs.
 *
 */
pub enum ScopeGuardType: [c8]
| EXIT    = Keys::EXIT
| FAILURE = Keys::FAILURE
| SUCCESS = Keys::SUCCESS;

/**
 * Keys used to access slice metadata fields in the runtime.
 *
 */
pub enum SliceKeys
| PTR      = "ptr"
| LEN      = "len"
| BLK_INFO = "blk_info";

/**
 * Keys used to access TypeInfo fields during reflection.
 *
 */
pub enum TypeInfoKeys
| ID     = "typeid"
| SIZE   = "size"
| INNER  = "inner"
| NAME   = "name"
| OFFSET = "offset";

/**
 * Keys used to access fields of lazy values.
 *
 */
pub enum LazyKeys
| IS_SET = "set"
| VALUE  = "value"
| SIZE   = "size"
| FUNC   = "func";

/**
