/*
 * Declares all keyword and operator-related enumerations used during lexing.
 *
 * This module defines the symbolic names associated with lexical fragments
 * extracted from Ymir source code. It includes:
 *
 *   - language keywords,
 *   - reserved keywords,
 *   - literal suffixes,
 *   - operator identifiers and precedence levels,
 *   - macro-related keys,
 *   - attribute names,
 *   - and various classification enums used throughout the compiler.
 *
 * These enums form the backbone of the lexing and parsing phases, providing a
 * canonical mapping between raw token strings and their semantic meaning.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::lexing::keys
 * @File: ymirc/lexing/keys.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2021-11-20
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in keys;

use ymirc::lexing::tokens;


/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          UTILS          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */


/**
 * Transform a string into a value of `E`
 *
 * @panic: if the name does not exist in the enum
 * */
pub fn toEnum {E} (str: [c8])-> E {
    for i in E::__members__ {
        if i == str {
            return i;
        }
    }

    panic;
}

/**
 * Transform a string into a value of `MultOperators`
 *
 * @panic: if the name does not exist in the enum
 * */
pub fn toMultOp(str: [c8])-> MultOperators {
    if str == Tokens::LPAR             return MultOperators::CALL;
    if str == Tokens::LCRO             return MultOperators::INDEX;
    if str == Tokens::LCRO_AND         return MultOperators::INDEX_AND;
    if str == MultOperators::CALL      return MultOperators::CALL;
    if str == MultOperators::INDEX     return MultOperators::INDEX;
    if str == MultOperators::INDEX_AND return MultOperators::INDEX_AND;

    std::io::eprintln("internal syntax error: invalid mult operator, ", str);
    panic;
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ==================================          ENUMERATIONS          ==================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * List of all keywords recognized by the Ymir lexer. These represent language
 * constructs, control flow, declarations, modifiers, and special compiler
 * directives.
 *
 */
pub enum Keys
| ALIAS              = "alias"
| ASSERT             = "assert"
| ASYNC              = "async"
| ATOMIC             = "atomic"
| AWAIT              = "await"
| BREAK              = "break"
| CAST               = "cast"
| CATCH              = "catch"
| CLANG              = "C"
| CLASS              = "class"
| COMPILE            = "compile"
| CONST              = "const"
| CONTINUE           = "continue"
| COPY               = "copy"
| CTE                = "cte"
| DCOPY              = "dcopy"
| DEF                = "def"
| DELEGATE           = "dg"
| DMUTABLE           = "dmut"
| DTOR               = "__dtor"
| ELSE               = "else"
| END                = "end"
| ENTITY             = "entity"
| ENUM               = "enum"
| EXIT               = "exit"
| EXPAND             = "expand"
| EXTERN             = "extern"
| FAILURE            = "failure"
| FALSE              = "false"
| FIELDINFO          = "field_infos"
| FOR                = "for"
| FUNCTION           = "fn"
| FUTURE             = "future"
| IF                 = "if"
| IMPL               = "impl"
| IN                 = "in"
| INLINE             = "inline"
| IS                 = "is"
| LAZY               = "lazy"
| LET                = "let"
| LIB_ROOT           = "__lib__"
| LOOP               = "loop"
| MACRO              = "macro"
| MAIN               = "main"
| MATCH              = "match"
| MOD                = "mod"
| MOVE               = "move"
| MUTABLE            = "mut"
| NEW                = "new"
| NONE               = "none"
| NOT_IN             = "!in"
| NOT_IS             = "!is"
| NOT_OF             = "!of"
| NULL               = "null"
| OF                 = "of"
| OVER               = "over"
| PANIC              = "panic"
| PRAGMA             = "__pragma"
| PRIVATE            = "prv"
| PROTECTED          = "prot"
| PUBLIC             = "pub"
| RECORD             = "record"
| REF                = "ref"
| RETURN             = "return"
| SELF               = "self"
| SIZEOF             = "size"
| SKIPS              = "skips"
| SPAWN              = "spawn"
| STATIC             = "static"
| SUCCESS            = "success"
| SUPER              = "super"
| TEMPLATE           = "template"
| THROW              = "throw"
| THROWS             = "throws"
| TRAIT              = "trait"
| TRUE               = "true"
| TUPLE              = "tuple"
| TYPEID             = "typeid"
| TYPEINFO           = "typeinfo"
| TYPEOF             = "typeof"
| UNDER              = "_"
| UNION              = "union"
| UNITTEST           = "__test"
| UNIT_TEST_REGISTER = "__unittest__global__"
| UNSAFE             = "unsafe"
| USE                = "use"
| VERSION            = "__version"
| WHILE              = "while"
| WITH               = "with"
| YIELD              = "yield"
| YLANG              = "YMIR";

/**
 * List of reserved keywords that cannot be used as identifiers. These are a
 * strict subset of `Keys` and represent syntactic constructs that the language
 * forbids redefining.
 *
 */
pub enum ForbiddenKeys
| ALIAS             = Keys::ALIAS
| ASSERT            = Keys::ASSERT
| ASYNC             = Keys::ASYNC
| ATOMIC            = Keys::ATOMIC
| AWAIT             = Keys::AWAIT
| BREAK             = Keys::BREAK
| CAST              = Keys::CAST
| CATCH             = Keys::CATCH
| CLASS             = Keys::CLASS
| CONST             = Keys::CONST
| CONTINUE          = Keys::CONTINUE
