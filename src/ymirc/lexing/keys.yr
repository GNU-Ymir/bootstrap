| ARITY       = "arity"
| DIG         = "dig"
| EPSILON     = "epsilon"
| INF         = "inf"
| INIT        = "init"
| MANT_DIG    = "mant_dig"
| MAX         = "max"
| MAX_10_EXP  = "max_10_exp"
| MAX_EXP     = "max_exp"
| MIN         = "min"
| MIN_10_EXP  = "min_10_exp"
| MIN_EXP     = "min_exp"
| NAN         = "nan"
| SIZE        = "size";

/**
 * Keys used to access runtime metadata of class instances.
 *
 */
pub enum ClassKeys
| VTABLE  = "#_vtable"
| MONITOR = "#_monitor"
| SET     = "#_set"
| NEXT    = "next";

/**
 * Filters used in `match` expressions for `Option` types.
 *
 */
pub enum MatchOptionFilters
| SOME = "Ok"
| NONE = "Err";

/**
 * Keys used to access fields of `Option` values.
 *
 */
pub enum OptionKeys
| CONTENT    = "content"
| ERROR      = "error"
| VALUE      = "value"
| SET        = "hasValue"
| HAS_ERROR  = "hasError"
| MATCH_SOME = MatchOptionFilters::SOME
| MATCH_NONE = MatchOptionFilters::NONE;

/**
 * Keys used to access fields of map objects.
 *
 */
pub enum MapKeys
| BLK_INFO = "minfo"
| ENTRIES  = "entries"
| CAP      = "cap"
| LOADED   = "loaded"
| DATA     = "data"
| LEN      = "len"
| REMOVE   = "remove";


pub enum EnumKeys
| MEMBERS = "members"
| NAMES   = "names";

/**
 * Keys used to access fields of coverage information structures.
 *
 */
pub enum CoverageInfoKeys
| FILE = "file"
| FUNC = "function"
| LOCS = "locations";

/**
 * Kind of a coverage location, stored as the third member of every entry of the
 * `__COV__` table(see `GlobalExpander::finalizeCoverageLocTable`).
 *
 * A LINE entry answers "was this source line reached", and there is exactly one of them per
 * source line of a frame. A BRANCH_TRUE/BRANCH_FALSE pair answers "were both outcomes of this
 * conditional exercised", and both members of a pair carry the location of the conditional
 * itself, so the report can pair them back together.
 *
 * These values are ABI: they are mirrored by `CoverageLocKind` in
 * `midgard/test-rt/utils/coverage/tree.yr`, and any change here must be made there too.
 */
pub enum CoverageLocKinds: u32
| LINE         = 0
| BRANCH_TRUE  = 1
| BRANCH_FALSE = 2;

/**
 * Kinds of template variables(alias, class, entity, tuple, etc.).
 *
 */
pub enum TemplateVarType
| ALIAS  = Keys::ALIAS
| CLASS  = Keys::CLASS
| ENTITY = Keys::ENTITY
| TUPLE  = Keys::TUPLE
| RECORD = Keys::RECORD
| UNION  = Keys::UNION
| ENUM   = Keys::ENUM;

/**
 * Kinds of template specialization filters(`of`, `over`, `impl`).
 *
 */
pub enum TemplateOfVarType
| OF   = Keys::OF
| OVER = Keys::OVER
| IMPL = Keys::IMPL;

/**
 * Keys used to declare standard iterator names in for loops
 *
 */
pub enum ForLoopKeys
| INDEX    = "#_index"
| ITER     = "#_iter"
| VALUE    = "#_value"
| NB_ITER  = "#_nb_iters"
| END      = "#_end";
