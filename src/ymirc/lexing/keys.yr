pub enum RangeKeys
| STEP     = "step"
| FST      = "fst"
| SCD      = "scd"
| CONTAINS = "contains"
| STEP_BY  = "stepBy"
| REVERSE  = "reverse"
| LEN      = "len";

/**
 * Keys used inside `__pragma` blocks to configure compiler behavior.
