in tokenizer;

use ymirc::lexing::{_, tokenizer::_, macro_::_};

pub def Tokenizer: implem::Tokenizer;
pub def Slice: slice::Slice;

pub lazy __MACRO_TOKENIZER__ = MacroTokenizer();


/**
 * MacroTokenizer
 *
 * A macro-specific tokenizer that delegates to the generic Tokenizer but
 * simplifies the returned Slice structure for macro lexing.
 *
 */
pub record MacroTokenizer {

    prv {
        let mut _tzer: Tokenizer;
    }

    /**
     * Construct a MacroTokenizer.
     *
     * The resulting tokenizer is ready to be used by MacroLexer.
     */
    pub self()
        with _tzer = Tokenizer(copy MacroPatternTokens::__members__)
    {
        self:.configureSkips();
    }

    /**
     * Extract the next slice from the input string.
     *
     * @returns:
     *   - Slice describing the next token boundary.
     */
    pub fn next(self, str: [c8])-> Slice {
        let (len, isToken, _, _, _) = self._tzer.next(str);
        if len == 0 // Empty split, EOF
            return Slice();

        let mut split = Slice();
        split.tok = str[0 .. len];
        split.isToken = isToken;
        split.isSkip = false;
        split.isString = false;
        split.isComment = false;
        split.isKeyword = false;

        return split;
    }
}
