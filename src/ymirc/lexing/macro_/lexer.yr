in lexer;

use ymirc::lexing::{_, macro_::_};


/**
 * MacroLexer
 *
 * Tokenizes macro content into a sequence of Word objects.
 *
 */
@final
pub class MacroLexer {

    /*! Immutable fields */
    prv {
        // The content of the macro rewritten string
        let _content: [c8];
    }

    /*! Mutable fields */
    prv {
        // The current word that is being read
        let mut _cursor: usize = 0;

        // The list of allocated words found in the string
        let mut _words: [&Word] = [];

        // The word returned when the lexer is eof
        let mut _eofWord: &Word;
    }

    /**
     * Construct a MacroLexer from macro content.
     *
     * @params:
     *   - content: the macro-generated byte sequence,
     *   - trim    : indentation offset applied after newlines.
     *
     */
    pub self(content: [c8], trim: usize)
        with _content = content
        , _eofWord = EOF_WORD
    {
        self:.tokenizeAll(__MACRO_TOKENIZER__, trim);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          USAGE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Returns the word being pointed by cursor and make the cursor move forward
     *
     * @info
     *   EOF word is returned if we reached the end of the collection
     *
     * @returns:
     *    - .0: the word
     *    - .1: the comment attached to the word
     * */
    pub fn next(mut self)-> &Word {
        if (self._cursor >= self._words.len) {
            self._cursor += 1;
            return self._eofWord;
        }

        let toRet = self._words[self._cursor];
        self._cursor += 1;

        return toRet;
    }

    /**
     * Returns the word pointed by the cursor without making the cursor move forward
     *
     * @info
     *    EOF is returned if we reached the end of the collection
     *
     * @returns: the word pointed by the cursor
     * */
    pub fn peek(self)-> &Word {
        if (self._cursor >= self._words.len) {
            return self._eofWord;
        }

        return self._words[self._cursor];
    }

    /**
     * Move the cursor back by one
     *
     * @info
     *   Do nothing if we are already at the start of the collection
     * */
    pub fn rewind(mut self) {
        if self._cursor == 0
            return;

        self._cursor -= 1;
    }

    /**
     * Move the cursor back to the seek of a given word
     *
     * @panic
     *    Panic if we try to make the cursor move forward(i.e. self.getSeek() < seek)
     *
     * @info
     *   if the seek is not an exact word, move to the word whose .seek < seek
     *
     * @params:
     *    - seek: the seek of the word to rewind to
     *
     * */
    pub fn rewindToSeek(mut self, seek: usize) {

        // rewindToSeek must not be used to go forward
        if self.getSeek() < seek {
            std::io::eprintln("internal lexer error: rewinding forward");
            panic;
        }

        // rewind to end, and already at end
        if seek == self._content.len {
            self._cursor = self._words.len;
            return;
        }

        loop {
            // First word break
            if self._cursor == 0
                return;

            // Current word is seek are before it
            if self._cursor < self._words.len && self._words[self._cursor].seek <= seek
                return;

            // Rewind by one
            self._cursor -= 1;
        }
    }

    /**
     * @returns: the seek of the word pointed by the cursor of the collection
     *
     * @info
     *   if EOF returns the seek of the EOF word
     * */
    pub fn getSeek(self)-> usize {
        if self._cursor >= self._words.len // End of file returns the seek past last word
            return self._content.len;

        // returns the seek of the current word
        self._words[self._cursor].seek
    }

    /**
     * @returns: true iif we reached the end of the collection
     * */
    @field
    pub fn isEof(self)-> bool {
        self._cursor >= self._words.len
    }


    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          TOKENIZATION          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Tokenize the entire macro content.
     *
     * This function produces the complete `_words` array.
     */
    prv fn tokenizeAll(mut self, tzer: MacroTokenizer, trim: usize) {
        let mut cursor = SrcCursor("", self._content);
        let dmut scope = copy scope::SrcScopeList();

        while cursor.seek < self._content.len {
            let slc = tzer.next(self._content[cursor.seek .. $]);
            if slc.tok.len == 0 {
                break;
            }

            if slc.isToken {
                scope:.push(cursor.instantiateTok(slc.tok), "");
                if slc.tok == "\n" {
                    cursor:.newLine();
                    cursor:.forward(trim);
                } else {
                    cursor:.forward(slc.tok.len);
                }
            }

            else {
                let word = self.tokenizeWord(slc.tok, ref cursor);
                scope:.push(word, "");
                cursor:.forward(slc.tok.len);
            }
        }

        self._eofWord = cursor.instantiateEof();
        self._words = scope[][0].words;
    }

    /**
     * Classify a token as either:
     *   - decimal number → tokenizeDecWord(),
     *   - identifier or name → tokenizeName(),
     *   - fallback → instantiateLoc().
     */
    fn tokenizeWord(self, tok: [c8], ref mut cursor: SrcCursor)-> &Word {
        if tok.len >= 1 && tok[0] >= '0' && tok[0] <= '9' {
            return self.tokenizeDecWord(tok, cursor);
        }

        return self.tokenizeName(tok, cursor);
    }

    /**
     * Classify a token as a name(identifier) or a location token.
     *
     * @returns:
     *   - &NameWord or &LocWord
     */
    fn tokenizeName(self, tok: [c8], cursor: SrcCursor)-> &Word {
        if tok == Keys::UNDER {
            return cursor.instantiateName(tok);
        }

        let mut i = 0us, mut found = false;
        for j, c in tok {
            if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') {
                i = j;
                found = true;
                break;
            }

            else if (c != '_') {
                return cursor.instantiateLoc(tok);
            }
        }

        if !found {
            return cursor.instantiateLoc(tok);
        }

        for j in i .. tok.len {
            let c = tok[j];
            if (c < 'a' || c > 'z') && (c < 'A' || c > 'Z') && (c != '_') && (c < '0' || c > '9') {
                return cursor.instantiateLoc(tok);
            }
        }

        return cursor.instantiateName(tok);
    }

    /**
     * Classify a decimal numeric literal.
     *
     */
    fn tokenizeDecWord(self, tok: [c8], cursor: SrcCursor)-> &Word {
        let startCursor = cursor;        
        for c in tok {
            if c != '_' && (c < '0' || c > '9') {
                return cursor.instantiateLoc(tok);
            }
        }

        return startCursor.instantiateNum(tok,
                                          notation-> NumericNotation::DEC,
                                          suffix-> EOF_WORD);
    }
}
