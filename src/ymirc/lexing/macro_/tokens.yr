in tokens;

use ymirc::lexing::tokens;

/**
 * MacroPatternTokens
 *
 * Enumerates all tokens recognized by the macro tokenizer.
 *
 */
pub enum MacroPatternTokens: [c8]
| ANTI      = Tokens::ANTI
| MACRO_ACC = Tokens::MACRO_ACC
| MACRO_CRO = Tokens::MACRO_CRO
| MACRO_PAR = Tokens::MACRO_PAR
| LACC      = Tokens::LACC
| LCRO      = Tokens::LCRO
| DCOLON    = Tokens::DCOLON
| RACC      = Tokens::RACC
| RCRO      = Tokens::RCRO
| RPAR      = Tokens::RPAR
| DOLLAR    = Tokens::DOLLAR
| MINUS     = Tokens::MINUS
| SPACE     = SkipTokens::SPACE
| RETURN    = SkipTokens::RETURN
| RRETURN   = SkipTokens::RRETURN
| TAB       = SkipTokens::TAB;
