in condition;

use ymirc::global::state;
use ymirc::lexing::word;

/**
 * The condition that is always true, an empty conjunction (the root scope, and the fallback '#else')
 * */
pub lazy ALWAYS_COND: &VersionCond = copy VersionAll ([]);

/**
 * The condition of a version directive ('#if' or '#else if')
 * */
@abstract
pub class VersionCond {

    /***/
    pub self () {}

    /**
     * @returns: true iif the condition holds on the versions currently active
     * */
    pub fn isActive(self)-> bool;

}

/**
 * A version name, true iif the version is set, whatever its value
 * */
@final
pub class VersionName over VersionCond {

    // the identifier (or backquoted identifier) naming the version
    pub let name: &Word;

    /**
     * @params:
     *    - name: the word naming the version
     * */
    pub self (name: &Word)
        with name = name
    {}

    /**
     * @returns: true iif the version is set
     * */
    pub over isActive(self)-> bool {
        state::isVersionActive(self.name.str)
    }

}

/**
 * A conjunction ('&'), true iif all its operands are, and therefore when it has none
 * */
@final
pub class VersionAll over VersionCond {

    // the conditions that must all hold
    pub let operands: [&VersionCond];

    /**
     * @params:
     *    - operands: the conditions that must all hold
     * */
    pub self (operands: [&VersionCond])
        with operands = operands
    {}

    /**
     * @returns: true iif every operand is active
     * */
    pub over isActive(self)-> bool {
        for o in self.operands {
            if !o.isActive() return false;
        }

        true
    }

}

/**
 * A disjunction ('|'), true iif one of its operands is
 * */
@final
pub class VersionAny over VersionCond {

    // the conditions of which one at least must hold
    pub let operands: [&VersionCond];

    /**
     * @params:
     *    - operands: the conditions of which one at least must hold
     * */
    pub self (operands: [&VersionCond])
        with operands = operands
    {}

    /**
     * @returns: true iif an operand is active
     * */
    pub over isActive(self)-> bool {
        for o in self.operands {
            if o.isActive() return true;
        }

        false
    }

}

/**
 * A negation ('!'), true iif its operand is not
 * */
@final
pub class VersionNot over VersionCond {

    // the negated condition
    pub let operand: &VersionCond;

    /**
     * @params:
     *    - operand: the negated condition
     * */
    pub self (operand: &VersionCond)
        with operand = operand
    {}

    /**
     * @returns: true iif the operand is not active
     * */
    pub over isActive(self)-> bool {
        !self.operand.isActive()
    }

}
