in errors;

use ymirc::errors::code;

/// Local shorthand for the catalogue entry type, cf. `ymirc::errors::code`.
def Error: code::Error;

/// The code of a message that is a context note rather than a diagnostic.
def NO_CODE = code::NO_CODE;

/**
 * Error messages that can be raised during the lexing step.
 */
pub enum LexingErrorMessage: Error
| UNTERMINATED_STRING              = Error (1001,    "unterminated string literal %(y)")
| UNTERMINATED_COMMENT             = Error (1002,    "unterminated comment block %(y)")
| RETURN_IN_SINGLE_LINE_COMMENT    = Error (1003,    "line break encountered inside a single-line comment")
| RETURN_IN_SINGLE_LINE_STRING     = Error (1004,    "line break encountered inside a single-line string literal")
| ESCAPE_RETURN_PROHIBITED_STRING  = Error (1005,    "escaping a line break is prohibited; use a multiline string instead @(y=\"\"\")")
| ESCAPE_RETURN_PROHIBITED_COMMENT = Error (1006,    "escaping a line break is prohibited; use a multiline comment instead @(y=/**/)")
| ESCAPE_AT_END_OF_STRING          = Error (1007,    "escape character found at end of string literal")
| ESCAPE_AT_END_OF_COMMENT         = Error (1008,    "escape character found at end of comment block")
| INVALID_HEX_NUMBER               = Error (1009,    "invalid numeric value formatted in hexadecimal")
| INVALID_DEC_NUMBER               = Error (1010,    "invalid numeric value formatted in decimal")
| INVALID_BIN_NUMBER               = Error (1011,    "invalid numeric value formatted in binary")
| INVALID_OCT_NUMBER               = Error (1012,    "invalid numeric value formatted in octal")
| MISSING_HEX_FLOAT_SIGN           = Error (1013,    "expected sign information in hexadecimal floating-point literal")
| MISSING_SCI_FLOAT_SIGN           = Error (1014,    "expected sign information in scientific floating-point literal")
| INVALID_IDENTIFIER               = Error (1015,    "%(y) is not a valid identifier; use backquotes for special identifiers(e.g. `%(y)`)")
| EMPTY_BIN_NUMBER                 = Error (1016,    "binary number is empty")
| EMPTY_OCT_NUMBER                 = Error (1017,    "octal number is empty")
| EMPTY_HEX_NUMBER                 = Error (1018,    "hexadecimal number is empty")
| EMPTY_EXP_FLOAT_NUMBER           = Error (1019,    "the exponent part of the floating-point number is empty")
| EMPTY_DEC_FLOAT_NUMBER           = Error (1020,    "the fractional part of the floating-point number is empty")
| MISSING_P_IN_HEX_FLOAT           = Error (1021,    "missing the exponent part in a floating-point number formatted in hexadecimal")
| UNTERMINATED_VERSION_BLOCK       = Error (1022,    "unterminated version block: missing @(y=#end)")
| UNMATCHED_VERSION_END            = Error (1023,    "@(y=#)%(y) without matching @(y=#if)")
| MISSING_VERSION_CONDITION        = Error (1024,    "missing version condition: expected identifier or backquoted identifier")
| UNDEFINED_VERSION_DIRECTIVE      = Error (1025,    "undefined version directive; expecting @(y=if), @(y=else) or @(y=end)");
