in global;

use std::config::_;
use ymirc::utils::format;

use ymirc::lexing::keys;
use ymirc::syntax::{declaration::_, expression::_};

use ymirc::semantic::{generator::_, symbol};

use ymirc::semantic::validator;
use ymirc::doc::visitor;
use ymirc::doc::standard::StandardVisitor;
use ymirc::doc::type_::TypeVisitor;

/**
 * Visitor in charge of dumping global variables, validated and unvalidated.
 * */
pub mod GlobalVisitor {

    /**
     * Dump the documentation of a global variable declaration.
     *
     * */
    pub fn dumpGlobal(ctx: DocVisitor, g: &GlobalVarSymbol)-> &Config {
        if let glb: &GlobalVarGenerator = g.generator {
            let dmut res = copy Dict();
            res["kind"] = copy Str("global");
            StandardVisitor::dumpStandard(ctx, g, alias res);
            res["thread_local"] = copy Bool(g.isThreadLocal);
            res["static"] = copy Bool(g.isStatic);
            res["extern"] = copy Bool(g.isExtern);
            res["type"] = TypeVisitor::dumpType(ctx, glb.type);
            res["mutability"] = copy Str(if (glb.type.isDeeplyMutable && glb.type.borrowsData) { "dmut" } else if (glb.isMutable) { "mut" } else { "" });
            res["value"] = copy Str(Utf::unescape(format("%", glb.value)));
            res
        } else {
            GlobalVisitor::dumpGlobalUnvalidated(ctx, g.decl, protection-> g.protection)
        }
    }

    /**
     * Dump the declaration of a global unvalidated global variable.
     *
     * */
    pub fn dumpGlobalUnvalidated(ctx: DocVisitor, g: &GlobalVarDecl, protection: Protection)-> &Config {
        let dmut res = copy Dict();
        res["kind"] = copy Str("global");
        StandardVisitor::dumpStandard(ctx, g.var.name.str, g.comm, g.var.loc, protection, alias res);

        let mut thLocal = false;
        for a in g.attrs {
            if a.attr == Attributes::THREAD { thLocal = true; }
        }
        res["thread_local"] = copy Bool(thLocal);
        res["static"] = copy Bool(g.isStatic);
        if (g.var.value !of EmptyExpr) {
            res["value"] = copy Str(Utf::unescape(format("%", g.var.value)));
        }

        res
    }
}
