in function;

use std::config::_;
use ymirc::utils::format;

use ymirc::syntax::{declaration::_, expression::_};

use ymirc::semantic::{generator::_, symbol};
use ymirc::semantic::generator::value::_;

use ymirc::semantic::validator;
use ymirc::doc::visitor;
use ymirc::doc::standard::StandardVisitor;
use ymirc::doc::type_::TypeVisitor;

/**
 * Visitor in charge of dumping functions, methods, ctors, and their
 * parameters/throwers, validated and unvalidated.
 * */
pub mod FunctionVisitor {

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          FUNCTIONS          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Dump documentation for a validated function symbol.
     *
     * Dispatches to:
     *   - dumpCtor,
     *   - dumpMethod,
     *   - dumpFunction(proto),
     *   - dumpFunctionUnvalidated.
     *
     * Skips destructors.
     */
    pub fn dumpFunction(ctx: DocVisitor, f: &FunctionSymbol)-> &Config {
        if let p: &CtorPrototypeValue = f.frameProto {
            return FunctionVisitor::dumpCtor(ctx, p);
        }

        if let _: &DtorPrototypeValue = f.frameProto {
            return copy None();
        }

        if let p: &MethodPrototypeValue = f.frameProto {
            return FunctionVisitor::dumpMethod(ctx, p);
        }

        if let p: &PrototypeValue = f.frameProto {
            return FunctionVisitor::dumpFunction(ctx, p);
        }

        FunctionVisitor::dumpFunctionUnvalidated(ctx, f)
    }


    /**
     * Dump documentation for a validated classical function.
     *
     */
    pub fn dumpFunction(ctx: DocVisitor, proto: &PrototypeValue)-> &Config {
        let dmut res = copy Dict();
        res["kind"] = copy Str("function");
        StandardVisitor::dumpStandard(ctx, proto.sym, alias res);
        FunctionVisitor::dumpParams(ctx, proto.params, alias res);
        FunctionVisitor::dumpThrowers(ctx, proto.throwers, alias res);

        let dmut attrs = copy Array();
        if (proto.isUnsafe) attrs:.push(copy Str("unsafe"));
        if (proto.isInline) attrs:.push(copy Str("inline"));
        res["attributes"] = attrs;
        res["ret_type"] = TypeVisitor::dumpType(ctx, proto.retType);

        res
    }

    /**
     * Dump documentation for a validated constructor.
     *
     */
    pub fn dumpCtor(ctx: DocVisitor, ctor: &CtorPrototypeValue)-> &Config {
        let dmut res = copy Dict();
        res["kind"] = copy Str("ctor");
        StandardVisitor::dumpStandard(ctx, ctor.sym, alias res);
        FunctionVisitor::dumpParams(ctx, ctor.params, alias res);
        FunctionVisitor::dumpThrowers(ctx, ctor.throwers, alias res);

        let dmut attrs = copy Array();
        if (ctor.isUnsafe) attrs:.push(copy Str("unsafe"));
        res["attributes"] = attrs;

        res
    }

    /**
     * Dump documentation for a validated method.
     *
     */
    pub fn dumpMethod(ctx: DocVisitor, meth: &MethodPrototypeValue)-> &Config {
        let dmut res = copy Dict();
        res["kind"] = copy Str("method");

        StandardVisitor::dumpStandard(ctx, meth.sym, alias res);
        FunctionVisitor::dumpParams(ctx, meth.params, alias res);
        let dmut attrs = copy Array();
        if (meth.isFinal) attrs:.push(copy Str("final"));
        if (meth.isVirtual) attrs:.push(copy Str("virtual"));
        if (meth.isEmpty) attrs:.push(copy Str("abstract"));
        if (meth.isField) attrs:.push(copy Str("field"));
        if (meth.isUnsafe) attrs:.push(copy Str("unsafe"));

        res["attributes"] = attrs;

        if (meth.isMutable) {
            res["mutable"] = copy Bool(true);
        } else { res["mutable"] = copy Bool(false); }

        FunctionVisitor::dumpThrowers(ctx, meth.throwers, alias res);
        res["ret_type"] = TypeVisitor::dumpType(ctx, meth.retType);

        res
    }

    /**
     * Dump the list of thrown types for a validated function/method.
     */
    pub fn dumpThrowers(ctx: DocVisitor, throwers: [Thrower], dmut res: &Dict) {
        let dmut thrs = copy Array();
        for t in throwers {
            thrs:.push(TypeVisitor::dumpType(ctx, t.type));
        }

        res["throwers"] = thrs;
    }

    /**
     * Dump parameters of a validated function/method.
     *
     * For each parameter:
     *   - name,
     *   - type,
     *   - mutability("dmut", "mut", or ""),
     *   - ref,
     *   - lazy,
     *   - default value(if present).
     */
    pub fn dumpParams(ctx: DocVisitor, funcParams: [&ProtoVarDeclValue], dmut res: &Dict) {
        let dmut parameters = copy Array();
        for v in funcParams {
            let dmut param = copy Dict();
            param["name"] = copy Str(v.name);
            param["type"] = TypeVisitor::dumpType(ctx, v.type);
            param["mutability"] = copy Str(if (v.type.isDeeplyMutable && v.type.borrowsData) { "dmut" } else if (v.isMutable) { "mut" } else { "" });
            param["ref"] = copy Bool(v.isReference);
            param["lazy"] = copy Bool(v.isLazy);

            if (v.value !of UnitValue) {
                param["value"] = copy Str(Utf::unescape(format("%", v.value)));
            }

            parameters:.push(param);
        }

        res["params"] = parameters;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =============================          UNVALIDATED FUNCTIONS          ==============================
     * ====================================================================================================
     * ====================================================================================================
     */


    /**
     * Dump documentation for an unvalidated function symbol.
     *
     */
    pub fn dumpFunctionUnvalidated(ctx: DocVisitor, f: &FunctionSymbol)-> &Config {
        let dmut res = copy Dict();
        res["kind"] = if (f.isMethod) { copy Str("method") } else { copy Str("function") };
        StandardVisitor::dumpStandard(ctx, f, alias res);
        FunctionVisitor::dumpFunctionUnvalidated(ctx, f.decl, alias res, forMethod-> f.isMethod, noStandard-> true);
        res
    }

    /**
     * Dump the content of an unvalidated ctor declaration.
     *
     */
    pub fn dumpCtorUnvalidated(ctx: DocVisitor, c: &CtorDecl, dmut res: &Dict, noStandard: bool = false, protection: Protection, condition: [c8] = "") {
        if (!noStandard) {
            res["kind"] = copy Str("ctor");
            let name = if (c.name.isEof) { c.loc.str } else { c.name.str };
            StandardVisitor::dumpStandard(ctx, name, c.comm, c.loc, protection, alias res);
        }

        FunctionVisitor::dumpParamsUnvalidated(ctx, c.proto.params, alias res);
        FunctionVisitor::dumpThrowerUnvalidated(ctx, c.throwers, alias res);
        if (condition != "") {
            res["condition"] = copy Str(condition);
        }
    }

    /**
     * Dump the content of an unvalidated function declaration.
     *
     */
    pub fn dumpFunctionUnvalidated(ctx: DocVisitor, f: &FunctionDecl, dmut res: &Dict, forMethod: bool, protection: Protection = Protection::PRIVATE, noStandard: bool = false, condition: [c8] = "") {
        if (!noStandard) {
            res["kind"] = if (forMethod) { copy Str("method") } else { copy Str("function") };
            StandardVisitor::dumpStandard(ctx, f.name.str, f.comm, f.loc, protection, alias res);
        }

        FunctionVisitor::dumpParamsUnvalidated(ctx, f.proto.params, alias res, forMethod-> forMethod);
        FunctionVisitor::dumpThrowerUnvalidated(ctx, f.throwers, alias res);
        res["ret_type"] = TypeVisitor::dumpTypeUnvalidated(ctx, f.proto.retType);

        if (forMethod) {
            if (f.proto.params[0].isMutable) {
                res["mutable"] = copy Bool(true);
            } else res["mutable"] = copy Bool(false);
        }

        let dmut attrs = copy Array();
        for a in f.attrs {
            attrs:.push(copy Str(a.attr));
        }
        res["attributes"] = attrs;

        if (condition != "") {
            res["condition"] = copy Str(condition);
        }
    }

    /**
     * Dump parameters of an unvalidated function/method.
     *
     * Skips the first parameter for methods(self).
     */
    pub fn dumpParamsUnvalidated(ctx: DocVisitor, proto: [&VarDeclExpr], dmut res: &Dict, forMethod: bool = false) {
        let dmut parameters = copy Array();
        for i, v in proto {
            if (!forMethod || i != 0) { // skip self for methods
                let dmut param = copy Dict();
                param["name"] = copy Str(v.name.str);
                param["type"] = TypeVisitor::dumpTypeUnvalidated(ctx, v.type);
                param["mutability"] = copy Str(if (v.isDeeplyMutable) { "dmut" } else if (v.isMutable) { "mut" } else { "" });
                param["ref"] = copy Bool(v.isRef);
                param["lazy"] = copy Bool(v.isLazy);

                if (v.value !of EmptyExpr) {
                    param["value"] = copy Str(Utf::unescape(format("%", v.value)));
                }

                parameters:.push(param);
            }
        }

        res["params"] = parameters;
    }

    /**
     * Dump throwers for an unvalidated function.
     *
     */
    pub fn dumpThrowerUnvalidated(ctx: DocVisitor, throwers: [&Expression], dmut res: &Dict) {
        let dmut thrs = copy Array();
        for t in throwers {
            thrs:.push(TypeVisitor::dumpTypeUnvalidated(ctx, t));
        }

        res["throwers"] = thrs;
    }
}
