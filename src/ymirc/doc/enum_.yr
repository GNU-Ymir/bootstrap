in enum_;

use std::config::_;
use ymirc::utils::format;

use ymirc::syntax::declaration::_;

use ymirc::semantic::{generator::_, symbol};
use ymirc::semantic::generator::type::_;

use ymirc::semantic::validator;
use ymirc::doc::visitor;
use ymirc::doc::standard::StandardVisitor;
use ymirc::doc::type_::TypeVisitor;

/**
 * Visitor in charge of dumping enumerations, validated and unvalidated.
 * */
pub mod EnumVisitor {

    /**
     * Dump the documentation of an enum symbol.
     *
     * */
    pub fn dumpEnum(ctx: DocVisitor, e: &EnumSymbol)-> &Config {
        match e.generator {
            EmptyGenerator() => {
                return EnumVisitor::dumpEnumUnvalidated(ctx, e.decl, protection-> e.protection);
            }
        }

        let dmut res = copy Dict();
        res["kind"] = copy Str("enum");
        StandardVisitor::dumpStandard(ctx, e, alias res);

        let dmut fields = copy Array();
        for i, f in e.fields {
            let doc = e.decl.fieldComms[i];
            let dmut fi = copy Dict();
            fi["name"] = copy Str(f._0);
            fi["value"] = copy Str(Utf::unescape(format("%", f._1)));
            fi["doc"] = copy Str(Utf::unescape(doc));
            fields:.push(fi);
        }

        res["fields"] = fields;
        if let et: &EnumType = e.generator {
            res["type"] = TypeVisitor::dumpType(ctx, et);
        }

        res
    }

    /**
     * Dump the documentation of an enum that has not been validated yet.
     *
     * */
    pub fn dumpEnumUnvalidated(ctx: DocVisitor, e: &EnumDecl, protection: Protection)-> &Config {
        let dmut res = copy Dict();
        res["kind"] = copy Str("enum");
        StandardVisitor::dumpStandard(ctx, e.name.str, e.comm, e.loc, protection, alias res);

        let dmut fields = copy Array();
        for i, f in e.fields {
            let doc = e.fieldComms[i];
            let dmut fi = copy Dict();
            fi["name"] = copy Str(f.name.str);
            fi["value"] = copy Str(Utf::unescape(format("%", f.value)));
            fi["doc"] = copy Str(Utf::unescape(doc));
            fields:.push(fi);
        }

        res["fields"] = fields;
        res["type"] = TypeVisitor::dumpTypeUnvalidated(ctx, e.type);
        res
    }
}
