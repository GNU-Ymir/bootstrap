/*
 * DocVisitor — produces structured documentation for modules and symbols.
 *
 * The DocVisitor walks validated(and unvalidated) semantic symbols and produces
 * a structured Config/Dict representation suitable for documentation generation.
 * It handles:
 *
 *   - modules(validated and unvalidated),
 *   - functions, methods, ctors, dtors,
 *   - template functions and template methods,
 *   - classes, records, entities,
 *   - class fields, methods, ctors, template ctors/methods,
 *   - trait implementations,
 *   - enums, globals, defs, macros, templates,
 *   - unvalidated declarations(functions, classes, fields, ctors, methods),
 *   - throwers, parameters, attributes, conditions, assertions.
 *
 * The visitor normalizes:
 *   - symbol names,
 *   - file/line/column locations,
 *   - protection levels,
 *   - comments(UTF-unescaped),
 *   - type representations(validated and unvalidated).
 *
 * This is only the top-level dispatcher: each symbol kind is documented by
 * its own visitor, under `ymirc::doc`(`module`, `function`, `class_`,
 * `trait_`, `enum_`, `global`, `def_`, `macro_`, `template_`, `type_`),
 * mirroring the layout of `ymirc::syntax::visitor`. `standard` holds the
 * metadata(name/location/protection/comments) shared by every one of them.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::doc::visitor
 * @File: ymirc/doc/visitor.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2025-02-07
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in visitor;

use std::{config::_, fs::path};

use ymirc::semantic::symbol;

use ymirc::doc::module::ModuleVisitor;
use ymirc::doc::function::FunctionVisitor;
use ymirc::doc::class_::ClassVisitor;
use ymirc::doc::trait_::TraitVisitor;
use ymirc::doc::enum_::EnumVisitor;
use ymirc::doc::global::GlobalVisitor;
use ymirc::doc::def_::DefVisitor;
use ymirc::doc::macro_::MacroVisitor;
use ymirc::doc::template_::TemplateVisitor;

/**
 * Produces documentation trees for modules and all their contained symbols.
 * Converts semantic symbols into Config/Dict structures containing:
 *
 *   - name, location, protection, comments,
 *   - parameters, return types, throwers,
 *   - attributes, mutability, reference/lazy flags,
 *   - class fields, methods, ctors, template members,
 *   - trait implementations and assertions,
 *   - unvalidated declarations(functions, classes, fields, ctors, methods).
 *
 * All output is normalized and UTF-unescaped.
 */
pub record DocVisitor {

    let _packageDir: Path;

    /**
     * Construct a documentation visitor.
     *
     * @params:
     *   - packageDir: the root directory of the package, used to strip prefixes
     *                 from file paths in documentation output.
     */
    pub self (packageDir: Path)
        with _packageDir = packageDir
    {}

    /**
     * @returns:
     *   - the root directory of the package, used by every kind-specific
     *     visitor to strip prefixes from file paths in documentation output.
     */
    pub fn packageDir(self)-> Path {
        self._packageDir
    }

    /**
     * Dump documentation for a symbol.
     *
     * Dispatches based on symbol type:
     *   - ModuleSymbol,
     *   - FunctionSymbol,
     *   - ClassSymbol,
     *   - TraitSymbol,
     *   - EnumSymbol,
     *   - GlobalVarSymbol,
     *   - DefSymbol,
     *   - MacroSymbol,
     *   - TemplateSymbol.
     *
     * @returns:
     *   - &Config: documentation tree, or None for unsupported symbols.
     */
    pub fn dump(self, sym: &Symbol)-> &Config {
        match sym {
            m: &ModuleSymbol => {
                return ModuleVisitor::dumpModule(self, m);
            }
            f: &FunctionSymbol => {
                return FunctionVisitor::dumpFunction(self, f);
            }
            c: &ClassSymbol => {
                return ClassVisitor::dumpClass(self, c);
            }
            t: &TraitSymbol => {
                return TraitVisitor::dumpTrait(self, t);
            }
            e: &EnumSymbol => {
                return EnumVisitor::dumpEnum(self, e);
            }
            g: &GlobalVarSymbol => {
                return GlobalVisitor::dumpGlobal(self, g);
            }
            a: &DefSymbol => {
                return DefVisitor::dumpDef(self, a);
            }
            m: &MacroSymbol => {
                return MacroVisitor::dumpMacro(self, m);
            }
            t: &TemplateSymbol => {
                return TemplateVisitor::dumpTemplate(self, t);
            }
        }

        return copy None();
    }
}
