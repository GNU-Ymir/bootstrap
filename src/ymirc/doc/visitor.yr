/*
 * DocVisitor — produces structured documentation for modules and symbols.
 *
 * The DocVisitor walks validated(and unvalidated) semantic symbols and produces
 * a structured Config/Dict representation suitable for documentation generation.
 * It handles:
 *
 *   - modules(validated and unvalidated),
 *   - functions, methods, ctors, dtors,
 *   - template functions and template methods,
 *   - classes, records, entities,
 *   - class fields, methods, ctors, template ctors/methods,
 *   - trait implementations,
 *   - enums, globals, defs, macros, templates,
 *   - unvalidated declarations(functions, classes, fields, ctors, methods),
 *   - throwers, parameters, attributes, conditions, assertions.
 *
 * The visitor normalizes:
 *   - symbol names,
 *   - file/line/column locations,
 *   - protection levels,
 *   - comments(UTF-unescaped),
 *   - type representations(validated and unvalidated).
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::doc::visitor
 * @File: ymirc/doc/visitor.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2025-02-07
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in visitor;

use std::{config::_, fs::path};
use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::format;

use ymirc::syntax::{declaration::_, expression::_};

use ymirc::semantic::{validator, generator::_, symbol};
use ymirc::semantic::generator::{type::_, value::_};

/**
 * Produces documentation trees for modules and all their contained symbols.
 * Converts semantic symbols into Config/Dict structures containing:
 *
 *   - name, location, protection, comments,
 *   - parameters, return types, throwers,
 *   - attributes, mutability, reference/lazy flags,
 *   - class fields, methods, ctors, template members,
 *   - trait implementations and assertions,
 *   - unvalidated declarations(functions, classes, fields, ctors, methods).
 *
 * All output is normalized and UTF-unescaped.
 */
pub record DocVisitor {

    let _packageDir: Path;

    /**
     * Construct a documentation visitor.
     *
     * @params:
     *   - packageDir: the root directory of the package, used to strip prefixes
     *                 from file paths in documentation output.
     */
    pub self (packageDir: Path)
        with _packageDir = packageDir
    {}

    /**
     * Dump documentation for a symbol.
     *
     * Dispatches based on symbol type:
     *   - ModuleSymbol,
     *   - FunctionSymbol,
     *   - ClassSymbol,
     *   - TraitSymbol,
     *   - EnumSymbol,
     *   - GlobalVarSymbol,
     *   - DefSymbol,
     *   - MacroSymbol,
     *   - TemplateSymbol.
     *
     * @returns:
     *   - &Config: documentation tree, or None for unsupported symbols.
     */
    pub fn dump(self, sym: &Symbol)-> &Config {
        match sym {
            m: &ModuleSymbol => {
                return self.dumpModule(m);
            }
            f: &FunctionSymbol => {
                return self.dumpFunction(f);
            }
            c: &ClassSymbol => {
                return self.dumpClass(c);
            }
            t: &TraitSymbol => {
                return self.dumpTrait(t);
            }
            e: &EnumSymbol => {
                return self.dumpEnum(e);
            }
            g: &GlobalVarSymbol => {
                return self.dumpGlobal(g);
            }
            a: &DefSymbol => {
                return self.dumpDef(a);
            }
            m: &MacroSymbol => {
                return self.dumpMacro(m);
            }
            t: &TemplateSymbol => {
                return self.dumpTemplate(t);
            }
        }

        return copy None();
    }

    /**
     * Dump standard metadata for a validated symbol.
     *
     * Writes into `res`:
     *   - name,
     *   - loc_file, loc_line, loc_col,
     *   - doc(UTF-unescaped),
     *   - protect("pub", "prot", "prv").
     */
    fn dumpStandard(self, sym: &Symbol, dmut res: &Dict) {
        res:["name"] = copy Str(sym.path.toStr());
        res:["loc_file"] = copy Str(Path(sym.loc.filename).removePrefix(self._packageDir).toStr());
        res:["loc_line"] = copy Int(cast!i64(sym.loc.line));
        res:["loc_col"] = copy Int(cast!i64(sym.loc.col));
        res:["doc"] = copy Str(Utf::unescape(sym.comm));

        match sym.protection {
            Protection::PUBLIC => { res:["protect"] = copy Str("pub"); }
            Protection::PROTECTED => { res:["protect"] = copy Str("prot"); }
            _ => { res:["protect"] = copy Str("prv"); }
        }
    }

    /**
     * Dump standard metadata for an unvalidated declaration.
     *
     * Same fields as the validated version, but takes raw name/comments.
     */
    fn dumpStandard(self, name: [c8], comments: [c8], loc: &Word, protection: Protection, dmut res: &Dict) {
        res:["name"] = copy Str(name);
        res:["loc_file"] = copy Str(Path(loc.filename).removePrefix(self._packageDir).toStr());
        res:["loc_line"] = copy Int(cast!i64(loc.line));
        res:["loc_col"] = copy Int(cast!i64(loc.col));
        res:["doc"] = copy Str(Utf::unescape(comments));

        match protection {
            Protection::PUBLIC => { res:["protect"] = copy Str("pub"); }
            Protection::PROTECTED => { res:["protect"] = copy Str("prot"); }
            _ => { res:["protect"] = copy Str("prv"); }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          MODULE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Dump documentation for a validated module.
     *
     * @returns:
     *   - &Config
     */
    fn dumpModule(self, m: &ModuleSymbol)-> &Config {
        if (m.isExtern) {
            return copy None();
        }

        let dmut res = copy Dict();
        res:["kind"] = copy Str("module");
        self.dumpStandard(m, alias res);

        let dmut childs = copy Array();
        let inners = m.getAllLocalSymbols(protection-> Protection::PRIVATE);
        for i in inners match self.dump(i) {
            None() => {}
            c: _ => {
                childs:.push(c);
            }
        }

        res:["childs"] = childs;
        return res;
    }

    /**
     * Dump documentation for an unvalidated module declaration.
     *
     * @returns:
     *   - &Config
     */
    fn dumpModuleUnvalidated(self, m: &ModuleDecl, protection: Protection)-> &Config {
        let dmut res = copy Dict();
        res:["kind"] = copy Str("module");
        self.dumpStandard(m.loc.str, m.comm, m.loc, protection, alias res);

        let dmut childs = copy Array();
        for i in m.decls {
            self.dumpUnvalidated(i, protection-> Protection::PRIVATE, alias childs);
        }
        res:["childs"] = childs;
        res
    }


    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          FUNCTIONS          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Dump documentation for a validated function symbol.
     *
     * Dispatches to:
     *   - dumpCtor,
     *   - dumpMethod,
     *   - dumpFunction(proto),
     *   - dumpFunctionUnvalidated.
     *
     * Skips destructors.
     */
    fn dumpFunction(self, f: &FunctionSymbol)-> &Config {
        if let p: &CtorPrototypeValue = f.frameProto {
            return self.dumpCtor(p);
        }

        if let _: &DtorPrototypeValue = f.frameProto {
            return copy None();
        }

        if let p: &MethodPrototypeValue = f.frameProto {
            return self.dumpMethod(p);
        }

        if let p: &PrototypeValue = f.frameProto {
            return self.dumpFunction(p);
        }

        self.dumpFunctionUnvalidated(f)
    }


    /**
     * Dump documentation for a validated classical function.
     *
     */
    fn dumpFunction(self, proto: &PrototypeValue)-> &Config {
        let dmut res = copy Dict();
        res:["kind"] = copy Str("function");
        self.dumpStandard(proto.sym, alias res);
        self.dumpParams(proto.params, alias res);
        self.dumpThrowers(proto.throwers, alias res);

        let dmut attrs = copy Array();
        if (proto.isUnsafe) attrs:.push(copy Str("unsafe"));
        if (proto.isInline) attrs:.push(copy Str("inline"));
        res:["attributes"] = attrs;
        res:["ret_type"] = self.dumpType(proto.retType);

        res
    }

    /**
     * Dump documentation for a validated constructor.
     *
     */
    fn dumpCtor(self, ctor: &CtorPrototypeValue)-> &Config {
        let dmut res = copy Dict();
        res:["kind"] = copy Str("ctor");
        self.dumpStandard(ctor.sym, alias res);
        self.dumpParams(ctor.params, alias res);
        self.dumpThrowers(ctor.throwers, alias res);

        let dmut attrs = copy Array();
        if (ctor.isUnsafe) attrs:.push(copy Str("unsafe"));
        res:["attributes"] = attrs;

        res
    }

    /**
     * Dump documentation for a validated method.
     *
     */
    fn dumpMethod(self, meth: &MethodPrototypeValue)-> &Config {
        let dmut res = copy Dict();
        res:["kind"] = copy Str("method");

        self.dumpStandard(meth.sym, alias res);
        self.dumpParams(meth.params, alias res);
        let dmut attrs = copy Array();
        if (meth.isFinal) attrs:.push(copy Str("final"));
        if (meth.isVirtual) attrs:.push(copy Str("virtual"));
        if (meth.isEmpty) attrs:.push(copy Str("abstract"));
        if (meth.isField) attrs:.push(copy Str("field"));
        if (meth.isUnsafe) attrs:.push(copy Str("unsafe"));

        res:["attributes"] = attrs;

        if (meth.isMutable) {
            res:["mutable"] = copy Bool(true);
        } else { res:["mutable"] = copy Bool(false); }

        self.dumpThrowers(meth.throwers, alias res);
        res:["ret_type"] = self.dumpType(meth.retType);

        res
    }

    /**
     * Dump the list of thrown types for a validated function/method.
     */
    fn dumpThrowers(self, throwers: [Thrower], dmut res: &Dict) {
        let dmut thrs = copy Array();
        for t in throwers {
            thrs:.push(self.dumpType(t.type));
        }

        res:["throwers"] = thrs;
    }

    /**
     * Dump parameters of a validated function/method.
     *
     * For each parameter:
     *   - name,
     *   - type,
     *   - mutability("dmut", "mut", or ""),
     *   - ref,
     *   - lazy,
     *   - default value(if present).
     */
    fn dumpParams(self, funcParams: [&ProtoVarDeclValue], dmut res: &Dict) {
        let dmut parameters = copy Array();
        for v in funcParams {
            let dmut param = copy Dict();
            param:["name"] = copy Str(v.name);
            param:["type"] = self.dumpType(v.type);
            param:["mutability"] = copy Str(if (v.type.isDeeplyMutable && v.type.borrowsData) { "dmut" } else if (v.isMutable) { "mut" } else { "" });
            param:["ref"] = copy Bool(v.isReference);
            param:["lazy"] = copy Bool(v.isLazy);

            if (v.value !of UnitValue) {
                param:["value"] = copy Str(Utf::unescape(format("%", v.value)));
            }

            parameters:.push(param);
        }

        res:["params"] = parameters;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =============================          UNVALIDATED FUNCTIONS          ==============================
     * ====================================================================================================
     * ====================================================================================================
     */


    /**
     * Dump documentation for an unvalidated function symbol.
     *
     */
    fn dumpFunctionUnvalidated(self, f: &FunctionSymbol)-> &Config {
        let dmut res = copy Dict();
        res:["kind"] = if (f.isMethod) { copy Str("method") } else { copy Str("function") };
        self.dumpStandard(f, alias res);
        self.dumpFunctionUnvalidated(f.decl, alias res, forMethod-> f.isMethod, noStandard-> true);
        res
    }

    /**
     * Dump the content of an unvalidated ctor declaration.
     *
     */
    fn dumpCtorUnvalidated(self, c: &CtorDecl, dmut res: &Dict, noStandard: bool = false, protection: Protection, condition: [c8] = "") {
        if (!noStandard) {
            res:["kind"] = copy Str("ctor");
            let name = if (c.name.isEof) { c.loc.str } else { c.name.str };
            self.dumpStandard(name, c.comm, c.loc, protection, alias res);
        }

        self.dumpParamsUnvalidated(c.proto.params, alias res);
        self.dumpThrowerUnvalidated(c.throwers, alias res);
        if (condition != "") {
            res:["condition"] = copy Str(condition);
        }
    }

    /**
     * Dump the content of an unvalidated function declaration.
     *
     */
    fn dumpFunctionUnvalidated(self, f: &FunctionDecl, dmut res: &Dict, forMethod: bool, protection: Protection = Protection::PRIVATE, noStandard: bool = false, condition: [c8] = "") {
        if (!noStandard) {
            res:["kind"] = if (forMethod) { copy Str("method") } else { copy Str("function") };
            self.dumpStandard(f.loc.str, f.comm, f.loc, protection, alias res);
        }

        self.dumpParamsUnvalidated(f.proto.params, alias res, forMethod-> forMethod);
        self.dumpThrowerUnvalidated(f.throwers, alias res);
        res:["ret_type"] = self.dumpTypeUnvalidated(f.proto.retType);

        if (forMethod) {
            if (f.proto.params[0].isMutable) {
                res:["mutable"] = copy Bool(true);
            } else res:["mutable"] = copy Bool(false);
        }

        let dmut attrs = copy Array();
        for a in f.attrs {
            attrs:.push(copy Str(a.attr));
        }
        res:["attributes"] = attrs;

        if (condition != "") {
            res:["condition"] = copy Str(condition);
        }
    }

    /**
     * Dump parameters of an unvalidated function/method.
     *
     * Skips the first parameter for methods(self).
     */
    fn dumpParamsUnvalidated(self, proto: [&VarDeclExpr], dmut res: &Dict, forMethod: bool = false) {
        let dmut parameters = copy Array();
        for i, v in proto {
            if (!forMethod || i != 0) { // skip self for methods
                let dmut param = copy Dict();
                param:["name"] = copy Str(v.name.str);
                param:["type"] = self.dumpTypeUnvalidated(v.type);
                param:["mutability"] = copy Str(if (v.isDeeplyMutable) { "dmut" } else if (v.isMutable) { "mut" } else { "" });
                param:["ref"] = copy Bool(v.isRef);
                param:["lazy"] = copy Bool(v.isLazy);

                if (v.value !of EmptyExpr) {
                    param:["value"] = copy Str(Utf::unescape(format("%", v.value)));
                }

                parameters:.push(param);
            }
        }

        res:["params"] = parameters;
    }

    /**
     * Dump throwers for an unvalidated function.
     *
     */
    fn dumpThrowerUnvalidated(self, throwers: [&Expression], dmut res: &Dict) {
        let dmut thrs = copy Array();
        for t in throwers {
            thrs:.push(self.dumpTypeUnvalidated(t));
        }

        res:["throwers"] = thrs;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          CLASS          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Dump documentation for a validated class symbol.
     *
     * If the class has a ClassRefType, dispatches to dumpClass(c, cref).
     */
    fn dumpClass(self, c: &ClassSymbol)-> &Config {
        if let Ok(r) = c.classRef {
            return self.dumpClass(c, r);
        }

        copy None()
    }

    /**
     * Dump documentation for a validated class reference.
     *
     */
    fn dumpClass(self, c: &ClassSymbol, cref: &ClassRefType)-> &Config {
        let dmut res = copy Dict();

        self.dumpStandard(c, alias res);

        if (c.isRecord) { res:["kind"] = copy Str("record"); }
        else if (c.isEntity) { res:["kind"] = copy Str("entity"); }
        else {
            res:["kind"] = copy Str("class");

            if let Ok(anc) = cref.ancestor {
                res:["ancestor"] = self.dumpType(anc);
            }

            res:["has_dtor"] = copy Bool(cref.dtor !of UnitValue);
            res:["abstract"] = copy Bool(cref.sym.isAbstract);
            res:["final"] = copy Bool(cref.sym.isFinal);
        }

        self.dumpClassFields(cref, alias res);
        self.dumpAssertions(cref, alias res);
        self.dumpCtors(cref, alias res);
        self.dumpTemplateCtors(cref, alias res);
        self.dumpMethods(cref, alias res);
        self.dumpTemplateMethods(cref, alias res);
        self.dumpImpl(cref, alias res);

        res
    }

    /**
     * Dump validated class fields.
     *
     */
    fn dumpClassFields(self, cref: &ClassRefType, dmut res: &Dict) {
        let dmut fields = copy Array();
        for i, v in cref.localFields {
            let dmut fi = copy Dict();
            fi:["name"] = copy Str(v.loc.str);
            fi:["mutability"] = copy Str(if (v.varType.isDeeplyMutable && v.varType.borrowsData) { "dmut" } else if (v.isMutable) { "mut" } else { "" });
            fi:["ref"] = copy Bool(v.isReference);
            fi:["lazy"] = copy Bool(v.isLazy);
            fi:["doc"] = copy Str(Utf::unescape(cref.sym.fieldComments[i]));
            fi:["protect"] = copy Str(if (cref.sym.isFieldPrivate(v.loc.str)) { "prv" } else if (cref.sym.isFieldProtected(v.loc.str)) { "prot" } else { "pub"});
            fi:["type"] = self.dumpType(v.varType);
            fields:.push(fi);
        }

        res:["fields"] = fields;
    }

    /**
     * Dump validated class assertions.
     *
     */
    fn dumpAssertions(self, cref: &ClassRefType, dmut res: &Dict) {
        let dmut assertions = copy Array();
        for exp in cref.sym.assertions {
            let dmut as = copy Dict();
            as:["test"] = copy Str(Utf::unescape(format("%", exp.test)));
            as:["msg"] = copy Str(Utf::unescape(format("%", exp.msg)));
            as:["doc"] = copy Str(Utf::unescape(exp.comm));
            assertions:.push(as);
        }

        res:["asserts"] = assertions;
    }

    /**
     * Dump validated constructors.
     *
     */
    fn dumpCtors(self, cref: &ClassRefType, dmut res: &Dict) {
        let dmut ctors = copy Array();
        for ct in cref.ctors {
            ctors:.push(self.dumpCtor(ct));
        }

        res:["ctors"] = ctors;
    }

    /**
     * Dump validated template constructors.
     *
     */
    fn dumpTemplateCtors(self, cref: &ClassRefType, dmut res: &Dict) {
        let dmut ctors = copy Array();
        for c in cref.templateCtors {
            let dmut tmp = copy Dict();
            tmp:["kind"] = copy Str("template");
            self.dumpTemplateParams(c.sym.decl, alias tmp);
            if (c.sym.decl.guard !of EmptyExpr) {
                res:["test"] = copy Str(Utf::unescape(format("%", c.sym.decl.guard)));
            }

            if let ct: &CtorDecl = c.sym.decl.decl {
                let name = if (ct.name.isEof) { ct.loc.str } else { ct.name.str };
                self.dumpStandard(name, c.sym.comm, c.loc, protection-> c.sym.protection, alias tmp);

                let dmut inner = copy Dict();
                self.dumpCtorUnvalidated(ct, alias inner, noStandard-> false, protection-> Protection::PUBLIC);
                let dmut childs = copy Array();
                childs:.push(inner);
                tmp:["content"] = childs;
            }

            ctors:.push(tmp);
        }

        res:["template_ctors"] = ctors;
    }

    /**
     * Dump the methods of a class
     *
     * */
    fn dumpMethods(self, cref: &ClassRefType, dmut res: &Dict) {
        let dmut meths = copy Array();
        for m in cref.vtable {
            if m.classRef == cref && m.traitSym of EmptySymbol {
                meths:.push(self.dumpMethod(m));
            }
        }

        res:["methods"] = meths;
    }

    /**
     * Dump the template method of a class
     *
     * */
    fn dumpTemplateMethods(self, cref: &ClassRefType, dmut res: &Dict) {
        let dmut meths = copy Array();
        for m in cref.templateMethods if m.classSym == cref.sym {
            let dmut tmp = copy Dict();
            tmp:["kind"] = copy Str("template");
            self.dumpStandard(m.sym, alias tmp);
            self.dumpTemplateParams(m.sym.decl, alias tmp);
            if (m.sym.decl.guard !of EmptyExpr) {
                tmp:["test"] = copy Str(Utf::unescape(format("%", m.sym.decl.guard)));
            }

            if let f: &FunctionDecl = m.sym.decl.decl {
                let dmut inner = copy Dict();
                self.dumpFunctionUnvalidated(f, alias inner, forMethod-> true, noStandard-> false, protection-> Protection::PUBLIC);
                let dmut childs = copy Array();
                childs:.push(inner);
                tmp:["content"] = childs;
            }

            meths:.push(tmp);
        }

        res:["template_methods"] = meths;
    }

    /**
     * Dump the list of trait implemented by the class
     *
     * */
    fn dumpImpl(self, cref: &ClassRefType, dmut res: &Dict) {
        let dmut tr = copy Array();
        for t in cref.implementedTraits {
            let dmut im = copy Dict();
            im:["kind"] = copy Str("impl");
            im:["trait"] = self.dumpType(t);
            tr:.push(im);
        }

        res:["implements"] = tr;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===============================          UNVALIDATED CLASS          ================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Dump an unvalidated class symbol.
     *
     * */
    fn dumpClassUnvalidated(self, cl: &TypeDecl, protection: Protection)-> &Config {
        let dmut res = copy Dict();
        self.dumpStandard(cl.loc.str, cl.comm, cl.loc, protection, alias res);

        let mut is_class = false;
        if (cl.isRecord) { res:["kind"] = copy Str("record"); }
        else if (cl.isEntity) { res:["kind"] = copy Str("entity"); }
        else {
            res:["kind"] = copy Str("class");
            if cl.ancestor !of EmptyExpr {
                res:["ancestor"] = self.dumpTypeUnvalidated(cl.ancestor);
            }
            is_class = true;

            for a in cl.attrs {
                if (a.attr == Attributes::ABSTRACT) { res:["abstract"] = copy Bool(true); }
                if (a.attr == Attributes::FINAL) { res:["final"] = copy Bool(true); }
            }
        }


        let dmut fields = copy Array();
        let dmut assertions = copy Array();
        let dmut ctors = copy Array(), dmut temp_ctors = copy Array();
        let dmut meths = copy Array(), dmut temp_meths = copy Array();
        let dmut implements = copy Array();

        let mut has_dtor = false;
        for d in cl.decls {
            if (self.dumpClassUnvalidatedInner(d, protection-> Protection::PROTECTED,
                                               alias fields,
                                               alias assertions,
                                               alias ctors, alias temp_ctors,
                                               alias meths, alias temp_meths,
                                               alias implements)) {
                has_dtor = true;
            }
        }

        if (is_class) {
            res:["has_dtor"] = copy Bool(has_dtor);
        }

        res:["fields"] = fields;
        res:["methods"] = meths;
        res:["template_methods"] = temp_meths;
        res:["ctors"] = ctors;
        res:["template_ctors"] = temp_ctors;
        res:["assertions"] = assertions;
        res:["implements"] = implements;

        res
    }

    /**
     * Dump the documentation of the inner content of an unvalidated class.
     *
     * */
    fn dumpClassUnvalidatedInner(self, d: &Declaration, protection: Protection, dmut fields: &Array, dmut assertions: &Array, dmut ctors: &Array, dmut temp_ctors: &Array, dmut meths: &Array, dmut temp_meths: &Array, dmut implements: &Array, condition: [c8] = "")-> bool {
        match d {
            dl: &BlockDecl => {
                let mut has_dtor = false;
                let inProt = if dl.isSet { protection } else { dl.protection };
                for i in dl.decls {
                    if (self.dumpClassUnvalidatedInner(i, protection-> inProt,
                                                       alias fields,
                                                       alias assertions,
                                                       alias ctors, alias temp_ctors,
                                                       alias meths, alias temp_meths,
                                                       alias implements, condition-> condition)) {
                        has_dtor = (condition == "");
                    }
                }

                return has_dtor;
            }
            c: &CondBlockDecl => {
                let innerTest = Utf::unescape(
                    if condition != "" { format("% && (%)", condition, c.test)  } else { format("%", c.test) });

                for i in c.decls {
                    self.dumpClassUnvalidatedInner(i, protection-> protection,
                                                   alias fields,
                                                   alias assertions,
                                                   alias ctors, alias temp_ctors,
                                                   alias meths, alias temp_meths,
                                                   alias implements, condition-> innerTest);
                }
                if let b: &BlockDecl = c.else_ {
                    let mut elseTest = if condition != "" {
                        format("% && !(%)", condition, c.test)
                    } else {
                        format("!(%)", c.test)
                    };
                    elseTest = Utf::unescape(elseTest);

                    self.dumpClassUnvalidatedInner(b, protection-> protection,
                                                   alias fields,
                                                   alias assertions,
                                                   alias ctors, alias temp_ctors,
                                                   alias meths, alias temp_meths,
                                                   alias implements, condition-> elseTest);
                }
            }
            ct: &CtorDecl => {
                let dmut inner = copy Dict();
                self.dumpCtorUnvalidated(ct, alias inner, noStandard-> false, protection-> Protection::PUBLIC, condition-> condition);
                ctors:.push(inner);
            }
            DtorDecl() => { return true; }
            im: &ImplDecl => {
                let dmut res = copy Dict();
                res:["kind"] = copy Str("impl");
                res:["trait"] = self.dumpTypeUnvalidated(im.who);
                if (condition != "") {
                    res:["condition"] = copy Str("condition");
                }
                implements:.push(res);
            }
            g: &GlobalVarDecl => {
                fields:.push(self.dumpClassFieldUnvalidated(g, protection-> protection, condition-> condition));
            }
            a: &AssertDecl => {
                let dmut as = copy Dict();
                as:["test"] = copy Str(Utf::unescape(format("%", a.test)));
                as:["msg"] = copy Str(Utf::unescape(format("%", a.msg)));
                as:["doc"] = copy Str(Utf::unescape(a.comm));
                if (condition != "") {
                    as:["condition"] = copy Str(condition);
                }
                assertions:.push(as);
            }
            f: &FunctionDecl => {
                let dmut res = copy Dict();
                self.dumpFunctionUnvalidated(f, alias res, forMethod-> true, noStandard-> false, protection-> protection, condition-> condition);
                meths:.push(res);
            }
            t: &TemplateDecl => {
                let dmut tmp = copy Dict();
                let dmut childs = copy Array();
                tmp:["kind"] = copy Str("template");
                self.dumpTemplateParams(t, alias tmp);

                let test = if (t.guard !of EmptyExpr) {
                    Utf::unescape(
                        if condition != "" { format("% && %", condition, t.guard)  } else { format("%", t.guard) })
                } else { condition };

                if (test != "") {
                    tmp:["test"] = copy Str(test);
                }

                match t.decl {
                    f: &FunctionDecl => {
                        self.dumpStandard(f.loc.str, t.comm, t.loc, protection, alias tmp);
                        let dmut inner = copy Dict();
                        self.dumpFunctionUnvalidated(f, alias inner, forMethod-> true, noStandard-> false, protection-> protection);
                        childs:.push(inner);
                        tmp:["content"] = childs;
                        temp_meths:.push(tmp);
                    }
                    c: &CtorDecl => {
                        let name = if (c.name.isEof) { c.loc.str } else { c.name.str };
                        self.dumpStandard(name, t.comm, t.loc, protection, alias tmp);
                        let dmut inner = copy Dict();
                        self.dumpCtorUnvalidated(c, alias inner, noStandard-> false, protection-> Protection::PUBLIC);
                        childs:.push(inner);
                        tmp:["content"] = childs;
                        temp_ctors:.push(tmp);
                    }
                }
            }
        }

        false
    }

    /**
     * Dump the documentation of a field of an unvalidated class.
     *
     * */
    fn dumpClassFieldUnvalidated(self, field: &GlobalVarDecl, protection: Protection, condition: [c8])-> &Config {
        let v = field.var;
        let dmut fi = copy Dict();
        fi:["name"] = copy Str(v.name.str);
        fi:["type"] = self.dumpTypeUnvalidated(v.type);
        fi:["mutability"] = copy Str(if (v.isDeeplyMutable) { "dmut" } else if (v.isMutable) { "mut" } else { "" });
        fi:["ref"] = copy Bool(v.isRef);
        fi:["doc"] = copy Str(Utf::unescape(field.comm));
        fi:["lazy"] = copy Bool(v.isLazy);
        fi:["protect"] = copy Str(if protection == Protection::PRIVATE { "prv" } else if protection == Protection::PROTECTED { "prot" } else { "pub" });

        if (v.value !of EmptyExpr) {
            fi:["value"] = copy Str(Utf::unescape(format("%", v.value)));
        }

        if (condition != "") {
            fi:["condition"] = copy Str(condition);
        }

        fi
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          TRAITS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Dump the documentation of a trait symbol.
     *
     * */
    fn dumpTrait(self, t: &TraitSymbol)-> &Config {
        let dmut res = copy Dict();
        res:["kind"] = copy Str("trait");
        self.dumpStandard(t, alias res);

        let dmut methods = copy Array();
        for i in t.getAllLocalSymbols(protection-> Protection::PRIVATE) match i {
            f: &FunctionSymbol => {
                methods:.push(self.dumpFunctionUnvalidated(f));
            }
        }

        let dmut assertions = copy Array();
        for exp in t.assertions {
            let dmut as = copy Dict();
            as:["test"] = copy Str(Utf::unescape(format("%", exp.test)));
            as:["msg"] = copy Str(Utf::unescape(format("%", exp.msg)));
            as:["doc"] = copy Str(Utf::unescape(exp.comm));
            assertions:.push(as);
        }

        res:["assertions"] = assertions;
        res:["methods"] = methods;
        return res;
    }

    /**
     * Dump the documentation of a trait that has not been validated.
     *
     * */
    fn dumpTraitUnvalidated(self, t: &TraitDecl, protection: Protection)-> &Config {
        let dmut res = copy Dict();
        res:["kind"] = copy Str("trait");
        self.dumpStandard(t.loc.str, t.comm, t.loc, protection, alias res);

        let dmut methods = copy Array(), dmut assertions = copy Array();
        for i in t.decls {
            self.dumpTraitUnvalidatedInner(i, alias methods,
                                           alias assertions,
                                           protection-> Protection::PROTECTED);
        }

        res:["methods"] = methods;
        res:["assertions"] = assertions;
        res
    }

    /**
     * Dump the content of an unvalidated trait.
     *
     * */
    fn dumpTraitUnvalidatedInner(self, d: &Declaration, dmut methods: &Array, dmut assertions: &Array, condition: [c8] = "", protection: Protection) {
        match d {
            dl: &BlockDecl => {
                for i in dl.decls {
                    self.dumpTraitUnvalidatedInner(i, alias methods, alias assertions, protection-> dl.protection, condition-> condition);
                }
            }
            c: &CondBlockDecl => {
                let innerTest = Utf::unescape(
                    if condition != "" { format("% && (%)", condition, c.test)  } else { format("%", c.test) });
                for i in c.decls {
                    self.dumpTraitUnvalidatedInner(i, alias methods, alias assertions, protection-> protection, condition-> innerTest);
                }
                if let b: &BlockDecl = c.else_ {
                    let elseTest = Utf::unescape(
                        if condition != "" { format("% && !(%)", condition, c.test)  } else { format("!(%)", c.test) });
                    self.dumpTraitUnvalidatedInner(b, alias methods, alias assertions, protection-> protection, condition-> elseTest);
                }
            }
            f: &FunctionDecl => {
                let dmut ch = copy Dict();
                self.dumpFunctionUnvalidated(f, alias ch, forMethod-> true, protection-> protection, noStandard-> false, condition-> condition);
                methods:.push(ch);
            }
            a: &AssertDecl => {
                let dmut as = copy Dict();
                as:["test"] = copy Str(Utf::unescape(format("%", a.test)));
                as:["msg"] = copy Str(Utf::unescape(format("%", a.msg)));
                as:["doc"] = copy Str(Utf::unescape(a.comm));
                if (condition != "") {
                    as:["condition"] = copy Str(condition);
                }
                assertions:.push(as);
            }
            _ => {}
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          ENUMERATION          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Dump the documentation of an enum symbol.
     *
     * */
    fn dumpEnum(self, e: &EnumSymbol)-> &Config {
        match e.generator {
            EmptyGenerator() => {
                return self.dumpEnumUnvalidated(e.decl, protection-> e.protection);
            }
        }

        let dmut res = copy Dict();
        res:["kind"] = copy Str("enum");
        self.dumpStandard(e, alias res);

        let dmut fields = copy Array();
        for i, f in e.fields {
            let doc = e.decl.fieldComms[i];
            let dmut fi = copy Dict();
            fi:["name"] = copy Str(f._0);
            fi:["value"] = copy Str(Utf::unescape(format("%", f._1)));
            fi:["doc"] = copy Str(Utf::unescape(doc));
            fields:.push(fi);
        }

        res:["fields"] = fields;
        if let et: &EnumType = e.generator {
            res:["type"] = self.dumpType(et);
        }

        res
    }

    /**
     * Dump the documentation of an enum that has not been validated yet.
     *
     * */
    fn dumpEnumUnvalidated(self, e: &EnumDecl, protection: Protection)-> &Config {
        let dmut res = copy Dict();
        res:["kind"] = copy Str("enum");
        self.dumpStandard(e.loc.str, e.comm, e.loc, protection, alias res);

        let dmut fields = copy Array();
        for i, f in e.fields {
            let doc = e.fieldComms[i];
            let dmut fi = copy Dict();
            fi:["name"] = copy Str(f.loc.str);
            fi:["value"] = copy Str(Utf::unescape(format("%", f.value)));
            fi:["doc"] = copy Str(Utf::unescape(doc));
            fields:.push(fi);
        }

        res:["fields"] = fields;
        res:["type"] = self.dumpTypeUnvalidated(e.type);
        res
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          GLOBAL          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Dump the documentation of a global variable declaration.
     *
     * */
    fn dumpGlobal(self, g: &GlobalVarSymbol)-> &Config {
        if let glb: &GlobalVarGenerator = g.generator {
            let dmut res = copy Dict();
            res:["kind"] = copy Str("global");
            self.dumpStandard(g, alias res);
            res:["thread_local"] = copy Bool(g.isThreadLocal);
            res:["static"] = copy Bool(g.isStatic);
            res:["extern"] = copy Bool(g.isExtern);
            res:["type"] = self.dumpType(glb.type);
            res:["mutability"] = copy Str(if (glb.type.isDeeplyMutable && glb.type.borrowsData) { "dmut" } else if (glb.isMutable) { "mut" } else { "" });
            res:["value"] = copy Str(Utf::unescape(format("%", glb.value)));
            res
        } else {
            self.dumpGlobalUnvalidated(g.decl, protection-> g.protection)
        }
    }

    /**
     * Dump the declaration of a global unvalidated global variable.
     *
     * */
    fn dumpGlobalUnvalidated(self, g: &GlobalVarDecl, protection: Protection)-> &Config {
        let dmut res = copy Dict();
        res:["kind"] = copy Str("global");
        self.dumpStandard(g.var.loc.str, g.comm, g.var.loc, protection, alias res);

        let mut thLocal = false;
        for a in g.attrs {
            if a.attr == Attributes::THREAD { thLocal = true; }
        }
        res:["thread_local"] = copy Bool(thLocal);
        res:["static"] = copy Bool(g.isStatic);
        if (g.var.value !of EmptyExpr) {
            res:["value"] = copy Str(Utf::unescape(format("%", g.var.value)));
        }

        res
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          DEF          =======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Dump the documentation of a def symbol.
     *
     * */
    fn dumpDef(self, aka: &DefSymbol)-> &Config {
        if let type: &Type = aka.generator {
            let dmut res = copy Dict();
            res:["kind"] = copy Str("def");
            self.dumpStandard(aka, alias res);
            res:["type"] = self.dumpType(type);
            res
        } else if let value: &Value = aka.generator {
            let dmut res = copy Dict();
            res:["kind"] = copy Str("def");
            self.dumpStandard(aka, alias res);
            res:["value"] = copy Str(Utf::unescape(format("%", value)));
            res
        } else {
            self.dumpDefUnvalidated(aka.decl, protection-> aka.protection)
        }
    }

    /**
     * Dump the documentation of an unvalidated def symbol.
     *
     * */
    fn dumpDefUnvalidated(self, aka: &DefDecl, protection: Protection)-> &Config {
        let dmut res = copy Dict();
        res:["kind"] = copy Str("def");
        self.dumpStandard(aka.loc.str, aka.comm, aka.loc, protection, alias res);

        if (aka.isValue) {
            res:["value"] = copy Str(Utf::unescape(format("%", aka.content)));
        } else {
            res:["type"] = self.dumpTypeUnvalidated(aka.content);
        }

        res
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          TEMPLATE          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Dump the documentation of a template symbol.
     *
     * */
    fn dumpTemplate(self, t: &TemplateSymbol)-> &Config {
        self.dumpTemplateUnvalidated(t.decl, protection-> t.protection)
    }

    /**
     * Dump the documentation of a template declaration.
     *
     * */
    fn dumpTemplateUnvalidated(self, t: &TemplateDecl, protection: Protection)-> &Config {
        let dmut childs = copy Array();
        self.dumpUnvalidated(t.decl, protection-> protection, alias childs);
        if (childs.len != 0) {
            let dmut tmp = copy Dict();
            tmp:["kind"] = copy Str("template");

            self.dumpTemplateParams(t, alias tmp);
            self.dumpStandard(t.loc.str, t.comm, t.loc, protection, alias tmp);
            tmp:["content"] = childs;
            if (t.guard !of EmptyExpr) {
                tmp:["test"] = copy Str(Utf::unescape(format("%", t.guard)));
            }

            return tmp;
        }

        copy None()
    }

    /**
     * Dump the documentation of an unvalidated declaration.
     *
     * */
    fn dumpUnvalidated(self, d: &Declaration, protection: Protection, dmut result: &Array) {
        match d {
            b: &BlockDecl => {
                let inProt = if (b.isSet) { protection } else { b.protection };
                for i in b.decls {
                    self.dumpUnvalidated(i, protection-> inProt, alias result);
                }
            }
            t: &TemplateDecl => {
                result:.push(self.dumpTemplateUnvalidated(t, protection-> protection));
            }
            m: &ModuleDecl => {
                result:.push(self.dumpModuleUnvalidated(m, protection-> protection));
            }
            c: &TypeDecl => {
                result:.push(self.dumpClassUnvalidated(c, protection-> protection));
            }
            t: &TraitDecl => {
                result:.push(self.dumpTraitUnvalidated(t, protection-> protection));
            }
            e: &EnumDecl => {
                result:.push(self.dumpEnumUnvalidated(e, protection-> protection));
            }
            f: &FunctionDecl => {
                let dmut res = copy Dict();
                self.dumpFunctionUnvalidated(f, alias res, forMethod-> false, noStandard-> false, protection-> protection);
                result:.push(res);
            }
            m: &MacroDecl => {
                result:.push(self.dumpMacroUnvalidated(m, protection-> protection));
            }
            g: &GlobalVarDecl => {
                result:.push(self.dumpGlobalUnvalidated(g, protection-> protection));
            }
            a: &DefDecl => {
                result:.push(self.dumpDefUnvalidated(a, protection-> protection));
            }
        }
    }

    /**
     * Dump the documentation of template parameters.
     *
     * */
    fn dumpTemplateParams(self, tmpl: &TemplateDecl, dmut res: &Dict) {
        let dmut elems = copy Array();
        for p in tmpl.params match p {
            a: &TemplateAndExpr => {
                elems:.push(self.dumpTemplateAndParam(a));
            }
            o: &TemplateOfVarExpr => {
                elems:.push(self.dumpTemplateOfParam(o));
            }
            v: &TemplateVarExpr => {
                elems:.push(self.dumpTemplateVar(v));
            }
            v: &TemplateVariadicVarExpr => {
                elems:.push(self.dumpTemplateVariadicVar(v));
            }
            z => {
                let dmut v = copy Dict();
                v:["kind"] = copy Str("any");
                v:["content"] = copy Str(Utf::unescape(format("%", z)));
                elems:.push(v);
            }
        }

        res:["templates"] = elems;
    }

    /**
     * Dump the documentation of a template "and" param.
     *
     * */
    fn dumpTemplateAndParam(self, a: &TemplateAndExpr)-> &Config {
        let dmut res = copy Dict();
        let dmut inner = copy Array();
        res:["kind"] = copy Str("and");
        for z in a.inners {
            inner:.push(self.dumpTemplateOfParam(z));
        }

        res:["content"] = inner;
        res
    }

    /**
     * Dump the documentation of a template "of" param.
     *
     * */
    fn dumpTemplateOfParam(self, o: &TemplateOfVarExpr)-> &Config {
        let dmut res = copy Dict();
        res:["kind"] = copy Str(o.kind);
        res:["name"] = copy Str(o.loc.str);
        res:["content"] = copy Str(Utf::unescape(format("%", o.spec)));
        res
    }

    /**
     * Dump the documentation of a template "var" param.
     *
     * */
    fn dumpTemplateVar(self, v: &TemplateVarExpr)-> &Config {
        let dmut res = copy Dict();
        res:["kind"] = copy Str(v.kind);
        res:["name"] = copy Str(v.loc.str);
        res
    }

    /**
     * Dump the documentation of a template variadic param.
     *
     * */
    fn dumpTemplateVariadicVar(self, v: &TemplateVariadicVarExpr)-> &Config {
        let dmut res = copy Dict();
        res:["kind"] = copy Str("variadic");
        res:["name"] = copy Str(v.loc.str);
        res:["value"] = copy Bool(v.isValue);
        res
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          MACROS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Dump the documentation of a macro.
     *
     * */
    fn dumpMacro(self, m: &MacroSymbol)-> &Config {
        self.dumpMacroUnvalidated(m.decl, m.protection)
    }

    /**
     * Dump the documentation of a macro.
     *
     * */
    fn dumpMacroUnvalidated(self, m: &MacroDecl, protection: Protection)-> &Config {
        let dmut res = copy Dict();
        res:["kind"] = copy Str("macro");
        self.dumpStandard(m.loc.str, m.comm, m.loc, protection, alias res);

        let dmut rules = copy Array();
        let dmut ctors = copy Array();
        for d in m.decls {
            self.dumpInnerMacro(d, alias rules, alias ctors, protection-> Protection::PUBLIC);
        }

        res:["ctors"] = ctors;
        res:["rules"] = rules;
        res
    }

    /**
     * Dump the documentation of rules and ctors that can be found in a macro.
     *
     * */
    fn dumpInnerMacro(self, d: &Declaration, dmut rules: &Array, dmut ctors: &Array, protection: Protection) {
        match d {
            bl: &BlockDecl => {
                for id in bl.decls {
                    self.dumpInnerMacro(id, alias rules, alias ctors, protection-> bl.protection);
                }
            }
            r: &MacroRuleDecl => {
                self.dumpMacroCtorRule(r, alias rules, alias ctors, protection-> protection);
            }
        }
    }

    /**
     * Dump the documentation of a macro ctor or macro rule.
     *
     * */
    fn dumpMacroCtorRule(self, rule: &MacroRuleDecl, dmut rules: &Array, dmut ctors: &Array, protection: Protection) {
        let dmut res = copy Dict();
        res:["kind"] = copy Str(if (rule.isCtor) { "ctor" } else { "rule" });
        self.dumpStandard(rule.loc.str, rule.comm, rule.loc, protection, alias res);

        res:["rule"] = copy Str(Utf::unescape(format("%", rule.rule)));
        let dmut skips = copy Array();
        for s in rule.skips {
            skips:.push(copy Str(Utf::unescape(format("%", s))));
        }

        res:["skips"] = skips;
        if (rule.isCtor) {
            ctors:.push(res);
        } else {
            rules:.push(res);
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          TYPES          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Dump the documentation of a type.
     *
     * */
    fn dumpType(self, ty: &Type)-> &Config {
        let dmut res = copy Dict();
        res:["mutability"] = copy Str(if (ty.isDeeplyMutable && ty.borrowsData) { "dmut" } else if ty.isMutable { "mut" } else { "" });

        match ty {
            f: &FuncPtrType => {
                res:["kind"] = copy Str("fptr");
                let dmut inners = copy Array();
                let dmut refs = copy Array();
                let dmut lazys = copy Array();
                for i, p in f.params {
                    inners:.push(self.dumpType(p));
                    refs:.push(copy Bool(f.references[i]));
                    lazys:.push(copy Bool(f.lazys[i]));
                }
                res:["params"] = inners;
                res:["refs"] = refs;
                res:["lazys"] = lazys;
                res:["return"] = self.dumpType(f.retType);
            }
            d: &DelegateType => {
                res:["kind"] = copy Str("delegate");
                let dmut inners = copy Array();
                let dmut refs = copy Array();
                let dmut lazys = copy Array();
                for i, p in d.params {
                    inners:.push(self.dumpType(p));
                    refs:.push(copy Bool(d.references[i]));
                    lazys:.push(copy Bool(d.lazys[i]));
                }
                res:["params"] = inners;
                res:["refs"] = refs;
                res:["lazys"] = lazys;
                res:["return"] = self.dumpType(d.retType);
            }
            n: &ScalarType => {
                res:["kind"] = copy Str("scalar");
                res:["name"] = copy Str(Utf::unescape(format("%", n.clone(0u32))));
            }
            c: &ArrayType => {
                res:["kind"] = copy Str("array");
                res:["inner"] = self.dumpType(c.inners[0]);
                res:["len"] = copy Int(cast!i64(c.len));
            }
            f: &FutureType => {
                res:["kind"] = copy Str("future");
                res:["inner"] = self.dumpType(f.retType);
            }
            o: &OptionType => {
                res:["kind"] = copy Str("option");
                res:["inner"] = self.dumpType(o.inners[0]);
            }
            p: &PointerType => {
                res:["kind"] = copy Str("pointer");
                res:["inner"] = self.dumpType(p.inners[0]);
            }
            r: &RangeType => {
                res:["kind"] = copy Str("range");
                res:["inner"] = self.dumpType(r.inners[0]);
            }
            s: &SliceType => {
                res:["kind"] = copy Str("slice");
                res:["inner"] = self.dumpType(s.inners[0]);
            }
            m: &MapType => {
                res:["kind"] = copy Str("map");
                res:["key"] = self.dumpType(m.inners[0]);
                res:["value"] = self.dumpType(m.inners[1]);
            }
            t: &TupleType => {
                res:["kind"] = copy Str("tuple");
                let dmut inners = copy Array();
                for i in t.inners {
                    inners:.push(self.dumpType(i));
                }
                res:["inners"] = inners;
            }
            c: &ClassPtrType => {
                res:["kind"] = copy Str(if (c.isEntity) { "entity" } else if (c.isRecord) { "record" } else { "class" });
                res:["name"] = copy Str(c.sym.path.toStr());
            }
            c: &ClassRefType => {
                return self.dumpType(c.createInstance(false, false));
            }
            e: &EnumType => {
                res:["kind"] = copy Str("enum");
                res:["proxy"] = self.dumpType(e.proxy);
                res:["name"] = copy Str(e.sym.path.toStr());
            }
            t => {
                res:["name"] = copy Str(Utf::unescape(format("%", t)));
                res:["kind"] = copy Str("any");
            }
        }

        res
    }

    /**
     * Dump an unvalidated type.
     *
     * */
    fn dumpTypeUnvalidated(self, type: &Expression)-> &Config {
        let (current, mutability) = if let d: &DecoratedTypeExpr = type {
            let (isMutable_, isDeeplyMutable_) = (d.kind == Decorators::MUT, d.kind == Decorators::DMUT);
            (d.content, if isDeeplyMutable_ { "dmut" } else if isMutable_ { "mut" } else { "" })
        } else {
            (type, "")
        };

        let dmut res = copy Dict();
        res:["kind"] = copy Str("any");
        res:["mutability"] = copy Str(mutability);
        res:["name"] = copy Str(Utf::unescape(format("%", current)));
        res
    }
}
