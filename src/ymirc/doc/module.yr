in module;

use std::config::_;

use ymirc::syntax::declaration::_;

use ymirc::semantic::symbol;

use ymirc::doc::visitor;
use ymirc::doc::standard::StandardVisitor;
use ymirc::doc::template_::TemplateVisitor;

/**
 * Visitor in charge of dumping modules, validated and unvalidated.
 * */
pub mod ModuleVisitor {

    /**
     * Dump documentation for a validated module.
     *
     * @returns:
     *   - &Config
     */
    pub fn dumpModule(ctx: DocVisitor, m: &ModuleSymbol)-> &Config {
        if (m.isExtern) {
            return copy None();
        }

        let dmut res = copy Dict();
        res["kind"] = copy Str("module");
        StandardVisitor::dumpStandard(ctx, m, alias res);

        let dmut childs = copy Array();
        let inners = m.getAllLocalSymbols(protection-> Protection::PRIVATE);
        for i in inners match ctx.dump(i) {
            None() => {}
            c: _ => {
                childs:.push(c);
            }
        }

        res["childs"] = childs;
        return res;
    }

    /**
     * Dump documentation for an unvalidated module declaration.
     *
     * @returns:
     *   - &Config
     */
    pub fn dumpModuleUnvalidated(ctx: DocVisitor, m: &ModuleDecl, protection: Protection)-> &Config {
        let dmut res = copy Dict();
        res["kind"] = copy Str("module");
        StandardVisitor::dumpStandard(ctx, m.name.str, m.comm, m.loc, protection, alias res);

        let dmut childs = copy Array();
        for i in m.decls {
            TemplateVisitor::dumpUnvalidated(ctx, i, protection-> Protection::PRIVATE, alias childs);
        }
        res["childs"] = childs;
        res
    }
}
