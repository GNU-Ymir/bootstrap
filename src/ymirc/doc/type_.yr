in type_;

use std::config::_;
use ymirc::utils::format;

use ymirc::lexing::keys;
use ymirc::syntax::expression::_;

use ymirc::semantic::generator::type::_;

use ymirc::semantic::validator;
use ymirc::doc::visitor;

/**
 * Visitor in charge of dumping type representations, validated and
 * unvalidated.
 * */
pub mod TypeVisitor {

    /**
     * Dump the documentation of a type.
     *
     * */
    pub fn dumpType(ctx: DocVisitor, ty: &Type)-> &Config {
        let dmut res = copy Dict();
        res["mutability"] = copy Str(if (ty.isDeeplyMutable && ty.borrowsData) { "dmut" } else if ty.isMutable { "mut" } else { "" });

        match ty {
            f: &FuncPtrType => {
                res["kind"] = copy Str("fptr");
                let dmut inners = copy Array();
                let dmut refs = copy Array();
                let dmut lazys = copy Array();
                for i, p in f.params {
                    inners:.push(TypeVisitor::dumpType(ctx, p));
                    refs:.push(copy Bool(f.references[i]));
                    lazys:.push(copy Bool(f.lazys[i]));
                }
                res["params"] = inners;
                res["refs"] = refs;
                res["lazys"] = lazys;
                res["return"] = TypeVisitor::dumpType(ctx, f.retType);
            }
            d: &DelegateType => {
                res["kind"] = copy Str("delegate");
                let dmut inners = copy Array();
                let dmut refs = copy Array();
                let dmut lazys = copy Array();
                for i, p in d.params {
                    inners:.push(TypeVisitor::dumpType(ctx, p));
                    refs:.push(copy Bool(d.references[i]));
                    lazys:.push(copy Bool(d.lazys[i]));
                }
                res["params"] = inners;
                res["refs"] = refs;
                res["lazys"] = lazys;
                res["return"] = TypeVisitor::dumpType(ctx, d.retType);
            }
            n: &ScalarType => {
                res["kind"] = copy Str("scalar");
                res["name"] = copy Str(Utf::unescape(format("%", n.clone(0u32))));
            }
            c: &ArrayType => {
                res["kind"] = copy Str("array");
                res["inner"] = TypeVisitor::dumpType(ctx, c.inners[0]);
                res["len"] = copy Int(cast!i64(c.len));
            }
            f: &FutureType => {
                res["kind"] = copy Str("future");
                res["inner"] = TypeVisitor::dumpType(ctx, f.retType);
            }
            o: &OptionType => {
                res["kind"] = copy Str("option");
                res["inner"] = TypeVisitor::dumpType(ctx, o.inners[0]);
            }
            p: &PointerType => {
                res["kind"] = copy Str("pointer");
                res["inner"] = TypeVisitor::dumpType(ctx, p.inners[0]);
            }
            r: &RangeType => {
                res["kind"] = copy Str("range");
                res["inner"] = TypeVisitor::dumpType(ctx, r.inners[0]);
            }
            s: &SliceType => {
                res["kind"] = copy Str("slice");
                res["inner"] = TypeVisitor::dumpType(ctx, s.inners[0]);
            }
            m: &MapType => {
                res["kind"] = copy Str("map");
                res["key"] = TypeVisitor::dumpType(ctx, m.inners[0]);
                res["value"] = TypeVisitor::dumpType(ctx, m.inners[1]);
            }
            t: &TupleType => {
                res["kind"] = copy Str("tuple");
                let dmut inners = copy Array();
                for i in t.inners {
                    inners:.push(TypeVisitor::dumpType(ctx, i));
                }
                res["inners"] = inners;
            }
            c: &ClassPtrType => {
                res["kind"] = copy Str(if (c.isEntity) { "entity" } else if (c.isRecord) { "record" } else { "class" });
                res["name"] = copy Str(c.sym.path.toStr());
            }
            c: &ClassRefType => {
                return TypeVisitor::dumpType(ctx, c.createInstance(false, false));
            }
            e: &EnumType => {
                res["kind"] = copy Str("enum");
                res["proxy"] = TypeVisitor::dumpType(ctx, e.proxy);
                res["name"] = copy Str(e.sym.path.toStr());
            }
            t => {
                res["name"] = copy Str(Utf::unescape(format("%", t)));
                res["kind"] = copy Str("any");
            }
        }

        res
    }

    /**
     * Dump an unvalidated type.
     *
     * */
    pub fn dumpTypeUnvalidated(_: DocVisitor, type: &Expression)-> &Config {
        let (current, mutability) = if let d: &DecoratedTypeExpr = type {
            let (isMutable_, isDeeplyMutable_) = (d.kind == Decorators::MUT, d.kind == Decorators::DMUT);
            (d.content, if isDeeplyMutable_ { "dmut" } else if isMutable_ { "mut" } else { "" })
        } else {
            (type, "")
        };

        let dmut res = copy Dict();
        res["kind"] = copy Str("any");
        res["mutability"] = copy Str(mutability);
        res["name"] = copy Str(Utf::unescape(format("%", current)));
        res
    }
}
