in macro_;

use std::config::_;
use ymirc::utils::format;

use ymirc::syntax::declaration::_;

use ymirc::semantic::symbol;

use ymirc::semantic::validator;
use ymirc::doc::visitor;
use ymirc::doc::standard::StandardVisitor;

/**
 * Visitor in charge of dumping macros, and their rules/ctors.
 * */
pub mod MacroVisitor {

    /**
     * Dump the documentation of a macro.
     *
     * */
    pub fn dumpMacro(ctx: DocVisitor, m: &MacroSymbol)-> &Config {
        MacroVisitor::dumpMacroUnvalidated(ctx, m.decl, m.protection)
    }

    /**
     * Dump the documentation of a macro.
     *
     * */
    pub fn dumpMacroUnvalidated(ctx: DocVisitor, m: &MacroDecl, protection: Protection)-> &Config {
        let dmut res = copy Dict();
        res["kind"] = copy Str("macro");
        StandardVisitor::dumpStandard(ctx, m.name.str, m.comm, m.loc, protection, alias res);

        let dmut rules = copy Array();
        let dmut ctors = copy Array();
        for d in m.decls {
            MacroVisitor::dumpInnerMacro(ctx, d, alias rules, alias ctors, protection-> Protection::PUBLIC);
        }

        res["ctors"] = ctors;
        res["rules"] = rules;
        res
    }

    /**
     * Dump the documentation of rules and ctors that can be found in a macro.
     *
     * */
    pub fn dumpInnerMacro(ctx: DocVisitor, d: &Declaration, dmut rules: &Array, dmut ctors: &Array, protection: Protection) {
        match d {
            bl: &BlockDecl => {
                for id in bl.decls {
                    MacroVisitor::dumpInnerMacro(ctx, id, alias rules, alias ctors, protection-> bl.protection);
                }
            }
            r: &MacroRuleDecl => {
                MacroVisitor::dumpMacroCtorRule(ctx, r, alias rules, alias ctors, protection-> protection);
            }
        }
    }

    /**
     * Dump the documentation of a macro ctor or macro rule.
     *
     * */
    pub fn dumpMacroCtorRule(ctx: DocVisitor, rule: &MacroRuleDecl, dmut rules: &Array, dmut ctors: &Array, protection: Protection) {
        let dmut res = copy Dict();
        res["kind"] = copy Str(if (rule.isCtor) { "ctor" } else { "rule" });
        let name = if (rule.name.isEof) { rule.loc.str } else { rule.name.str };
        StandardVisitor::dumpStandard(ctx, name, rule.comm, rule.loc, protection, alias res);

        res["rule"] = copy Str(Utf::unescape(format("%", rule.rule)));
        let dmut skips = copy Array();
        for s in rule.skips {
            skips:.push(copy Str(Utf::unescape(format("%", s))));
        }

        res["skips"] = skips;
        if (rule.isCtor) {
            ctors:.push(res);
        } else {
            rules:.push(res);
        }
    }
}
