in class_;

use std::config::_;
use ymirc::utils::format;

use ymirc::lexing::keys;
use ymirc::syntax::{declaration::_, expression::_};

use ymirc::semantic::{generator::_, symbol};
use ymirc::semantic::generator::{type::_, value::_};

use ymirc::semantic::validator;
use ymirc::doc::visitor;
use ymirc::doc::standard::StandardVisitor;
use ymirc::doc::type_::TypeVisitor;
use ymirc::doc::function::FunctionVisitor;
use ymirc::doc::template_::TemplateVisitor;

/**
 * Visitor in charge of dumping classes, records, entities and their
 * fields/ctors/methods/impls, validated and unvalidated.
 * */
pub mod ClassVisitor {

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          CLASS          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Dump documentation for a validated class symbol.
     *
     * If the class has a ClassRefType, dispatches to dumpClass(c, cref).
     */
    pub fn dumpClass(ctx: DocVisitor, c: &ClassSymbol)-> &Config {
        if let Ok(r) = c.classRef {
            return ClassVisitor::dumpClass(ctx, c, r);
        }

        copy None()
    }

    /**
     * Dump documentation for a validated class reference.
     *
     */
    pub fn dumpClass(ctx: DocVisitor, c: &ClassSymbol, cref: &ClassRefType)-> &Config {
        let dmut res = copy Dict();

        StandardVisitor::dumpStandard(ctx, c, alias res);

        if (c.isRecord) { res["kind"] = copy Str("record"); }
        else if (c.isEntity) { res["kind"] = copy Str("entity"); }
        else {
            res["kind"] = copy Str("class");

            if let Ok(anc) = cref.ancestor {
                res["ancestor"] = TypeVisitor::dumpType(ctx, anc);
            }

            res["has_dtor"] = copy Bool(cref.dtor !of UnitValue);
            res["abstract"] = copy Bool(cref.sym.isAbstract);
            res["final"] = copy Bool(cref.sym.isFinal);
        }

        ClassVisitor::dumpClassFields(ctx, cref, alias res);
        ClassVisitor::dumpAssertions(ctx, cref, alias res);
        ClassVisitor::dumpCtors(ctx, cref, alias res);
        ClassVisitor::dumpTemplateCtors(ctx, cref, alias res);
        ClassVisitor::dumpMethods(ctx, cref, alias res);
        ClassVisitor::dumpTemplateMethods(ctx, cref, alias res);
        ClassVisitor::dumpImpl(ctx, cref, alias res);

        res
    }

    /**
     * Dump validated class fields.
     *
     */
    pub fn dumpClassFields(ctx: DocVisitor, cref: &ClassRefType, dmut res: &Dict) {
        let dmut fields = copy Array();
        for i, v in cref.localFields {
            let dmut fi = copy Dict();
            fi["name"] = copy Str(v.loc.str);
            fi["mutability"] = copy Str(if (v.varType.isDeeplyMutable && v.varType.borrowsData) { "dmut" } else if (v.isMutable) { "mut" } else { "" });
            fi["ref"] = copy Bool(v.isReference);
            fi["lazy"] = copy Bool(v.isLazy);
            fi["doc"] = copy Str(Utf::unescape(cref.sym.fieldComments[i]));
            fi["protect"] = copy Str(if (cref.sym.isFieldPrivate(v.loc.str)) { "prv" } else if (cref.sym.isFieldProtected(v.loc.str)) { "prot" } else { "pub"});
            fi["type"] = TypeVisitor::dumpType(ctx, v.varType);
            fields:.push(fi);
        }

        res["fields"] = fields;
    }

    /**
     * Dump validated class assertions.
     *
     */
    pub fn dumpAssertions(_: DocVisitor, cref: &ClassRefType, dmut res: &Dict) {
        let dmut assertions = copy Array();
        for exp in cref.sym.assertions {
            let dmut as = copy Dict();
            as["test"] = copy Str(Utf::unescape(format("%", exp.test)));
            as["msg"] = copy Str(Utf::unescape(format("%", exp.msg)));
            as["doc"] = copy Str(Utf::unescape(exp.comm));
            assertions:.push(as);
        }

        res["asserts"] = assertions;
    }

    /**
     * Dump validated constructors.
     *
     */
    pub fn dumpCtors(ctx: DocVisitor, cref: &ClassRefType, dmut res: &Dict) {
        let dmut ctors = copy Array();
        for ct in cref.ctors {
            ctors:.push(FunctionVisitor::dumpCtor(ctx, ct));
        }

        res["ctors"] = ctors;
    }

    /**
     * Dump validated template constructors.
     *
     */
    pub fn dumpTemplateCtors(ctx: DocVisitor, cref: &ClassRefType, dmut res: &Dict) {
        let dmut ctors = copy Array();
        for c in cref.templateCtors {
            let dmut tmp = copy Dict();
            tmp["kind"] = copy Str("template");
            TemplateVisitor::dumpTemplateParams(ctx, c.sym.decl, alias tmp);
            if (c.sym.decl.guard !of EmptyExpr) {
                res["test"] = copy Str(Utf::unescape(format("%", c.sym.decl.guard)));
            }

            if let ct: &CtorDecl = c.sym.decl.decl {
                let name = if (ct.name.isEof) { ct.loc.str } else { ct.name.str };
                StandardVisitor::dumpStandard(ctx, name, c.sym.comm, c.loc, protection-> c.sym.protection, alias tmp);

                let dmut inner = copy Dict();
                FunctionVisitor::dumpCtorUnvalidated(ctx, ct, alias inner, noStandard-> false, protection-> Protection::PUBLIC);
                let dmut childs = copy Array();
                childs:.push(inner);
                tmp["content"] = childs;
            }

            ctors:.push(tmp);
        }

        res["template_ctors"] = ctors;
    }

    /**
     * Dump the methods of a class
     *
     * */
    pub fn dumpMethods(ctx: DocVisitor, cref: &ClassRefType, dmut res: &Dict) {
        let dmut meths = copy Array();
        for m in cref.vtable {
            if m.classRef == cref && m.traitSym of EmptySymbol {
                meths:.push(FunctionVisitor::dumpMethod(ctx, m));
            }
        }

        res["methods"] = meths;
    }

    /**
     * Dump the template method of a class
     *
     * */
    pub fn dumpTemplateMethods(ctx: DocVisitor, cref: &ClassRefType, dmut res: &Dict) {
        let dmut meths = copy Array();
        for m in cref.templateMethods if m.classSym == cref.sym {
            let dmut tmp = copy Dict();
            tmp["kind"] = copy Str("template");
            StandardVisitor::dumpStandard(ctx, m.sym, alias tmp);
            TemplateVisitor::dumpTemplateParams(ctx, m.sym.decl, alias tmp);
            if (m.sym.decl.guard !of EmptyExpr) {
                tmp["test"] = copy Str(Utf::unescape(format("%", m.sym.decl.guard)));
            }

            if let f: &FunctionDecl = m.sym.decl.decl {
                let dmut inner = copy Dict();
                FunctionVisitor::dumpFunctionUnvalidated(ctx, f, alias inner, forMethod-> true, noStandard-> false, protection-> Protection::PUBLIC);
                let dmut childs = copy Array();
                childs:.push(inner);
                tmp["content"] = childs;
            }

            meths:.push(tmp);
        }

        res["template_methods"] = meths;
    }

    /**
     * Dump the list of trait implemented by the class
     *
     * */
    pub fn dumpImpl(ctx: DocVisitor, cref: &ClassRefType, dmut res: &Dict) {
        let dmut tr = copy Array();
        for t in cref.implementedTraits {
            let dmut im = copy Dict();
            im["kind"] = copy Str("impl");
            im["trait"] = TypeVisitor::dumpType(ctx, t);
            tr:.push(im);
        }

        res["implements"] = tr;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===============================          UNVALIDATED CLASS          ================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Dump an unvalidated class symbol.
     *
     * */
    pub fn dumpClassUnvalidated(ctx: DocVisitor, cl: &TypeDecl, protection: Protection)-> &Config {
        let dmut res = copy Dict();
        StandardVisitor::dumpStandard(ctx, cl.name.str, cl.comm, cl.loc, protection, alias res);

        let mut is_class = false;
        if (cl.isRecord) { res["kind"] = copy Str("record"); }
        else if (cl.isEntity) { res["kind"] = copy Str("entity"); }
        else {
            res["kind"] = copy Str("class");
            if cl.ancestor !of EmptyExpr {
                res["ancestor"] = TypeVisitor::dumpTypeUnvalidated(ctx, cl.ancestor);
            }
            is_class = true;

            for a in cl.attrs {
                if (a.attr == Attributes::ABSTRACT) { res["abstract"] = copy Bool(true); }
                if (a.attr == Attributes::FINAL) { res["final"] = copy Bool(true); }
            }
        }


        let dmut fields = copy Array();
        let dmut assertions = copy Array();
        let dmut ctors = copy Array(), dmut temp_ctors = copy Array();
        let dmut meths = copy Array(), dmut temp_meths = copy Array();
        let dmut implements = copy Array();

        let mut has_dtor = false;
        for d in cl.decls {
            if (ClassVisitor::dumpClassUnvalidatedInner(ctx, d, protection-> Protection::PROTECTED,
                                               alias fields,
                                               alias assertions,
                                               alias ctors, alias temp_ctors,
                                               alias meths, alias temp_meths,
                                               alias implements)) {
                has_dtor = true;
            }
        }

        if (is_class) {
            res["has_dtor"] = copy Bool(has_dtor);
        }

        res["fields"] = fields;
        res["methods"] = meths;
        res["template_methods"] = temp_meths;
        res["ctors"] = ctors;
        res["template_ctors"] = temp_ctors;
        res["assertions"] = assertions;
        res["implements"] = implements;

        res
    }

    /**
     * Dump the documentation of the inner content of an unvalidated class.
     *
     * */
    pub fn dumpClassUnvalidatedInner(ctx: DocVisitor, d: &Declaration, protection: Protection, dmut fields: &Array, dmut assertions: &Array, dmut ctors: &Array, dmut temp_ctors: &Array, dmut meths: &Array, dmut temp_meths: &Array, dmut implements: &Array, condition: [c8] = "")-> bool {
        match d {
            dl: &BlockDecl => {
                let mut has_dtor = false;
                let inProt = if dl.isSet { protection } else { dl.protection };
                for i in dl.decls {
                    if (ClassVisitor::dumpClassUnvalidatedInner(ctx, i, protection-> inProt,
                                                       alias fields,
                                                       alias assertions,
                                                       alias ctors, alias temp_ctors,
                                                       alias meths, alias temp_meths,
                                                       alias implements, condition-> condition)) {
                        has_dtor = (condition == "");
                    }
                }

                return has_dtor;
            }
            c: &CondBlockDecl => {
                let innerTest = Utf::unescape(
                    if condition != "" { format("% && (%)", condition, c.test)  } else { format("%", c.test) });

                for i in c.decls {
                    ClassVisitor::dumpClassUnvalidatedInner(ctx, i, protection-> protection,
                                                   alias fields,
                                                   alias assertions,
                                                   alias ctors, alias temp_ctors,
                                                   alias meths, alias temp_meths,
                                                   alias implements, condition-> innerTest);
                }
                if let b: &BlockDecl = c.else_ {
                    let mut elseTest = if condition != "" {
                        format("% && !(%)", condition, c.test)
                    } else {
                        format("!(%)", c.test)
                    };
                    elseTest = Utf::unescape(elseTest);

                    ClassVisitor::dumpClassUnvalidatedInner(ctx, b, protection-> protection,
                                                   alias fields,
                                                   alias assertions,
                                                   alias ctors, alias temp_ctors,
                                                   alias meths, alias temp_meths,
                                                   alias implements, condition-> elseTest);
                }
            }
            ct: &CtorDecl => {
                let dmut inner = copy Dict();
                FunctionVisitor::dumpCtorUnvalidated(ctx, ct, alias inner, noStandard-> false, protection-> Protection::PUBLIC, condition-> condition);
                ctors:.push(inner);
            }
            DtorDecl() => { return true; }
            im: &ImplDecl => {
                let dmut res = copy Dict();
                res["kind"] = copy Str("impl");
                res["trait"] = TypeVisitor::dumpTypeUnvalidated(ctx, im.who);
                if (condition != "") {
                    res["condition"] = copy Str("condition");
                }
                implements:.push(res);
            }
            g: &GlobalVarDecl => {
                fields:.push(ClassVisitor::dumpClassFieldUnvalidated(ctx, g, protection-> protection, condition-> condition));
            }
            a: &AssertDecl => {
                let dmut as = copy Dict();
                as["test"] = copy Str(Utf::unescape(format("%", a.test)));
                as["msg"] = copy Str(Utf::unescape(format("%", a.msg)));
                as["doc"] = copy Str(Utf::unescape(a.comm));
                if (condition != "") {
                    as["condition"] = copy Str(condition);
                }
                assertions:.push(as);
            }
            f: &FunctionDecl => {
                let dmut res = copy Dict();
                FunctionVisitor::dumpFunctionUnvalidated(ctx, f, alias res, forMethod-> true, noStandard-> false, protection-> protection, condition-> condition);
                meths:.push(res);
            }
            t: &TemplateDecl => {
                let dmut tmp = copy Dict();
                let dmut childs = copy Array();
                tmp["kind"] = copy Str("template");
                TemplateVisitor::dumpTemplateParams(ctx, t, alias tmp);

                let test = if (t.guard !of EmptyExpr) {
                    Utf::unescape(
                        if condition != "" { format("% && %", condition, t.guard)  } else { format("%", t.guard) })
                } else { condition };

                if (test != "") {
                    tmp["test"] = copy Str(test);
                }

                match t.decl {
                    f: &FunctionDecl => {
                        StandardVisitor::dumpStandard(ctx, f.name.str, t.comm, t.loc, protection, alias tmp);
                        let dmut inner = copy Dict();
                        FunctionVisitor::dumpFunctionUnvalidated(ctx, f, alias inner, forMethod-> true, noStandard-> false, protection-> protection);
                        childs:.push(inner);
                        tmp["content"] = childs;
                        temp_meths:.push(tmp);
                    }
                    c: &CtorDecl => {
                        let name = if (c.name.isEof) { c.loc.str } else { c.name.str };
                        StandardVisitor::dumpStandard(ctx, name, t.comm, t.loc, protection, alias tmp);
                        let dmut inner = copy Dict();
                        FunctionVisitor::dumpCtorUnvalidated(ctx, c, alias inner, noStandard-> false, protection-> Protection::PUBLIC);
                        childs:.push(inner);
                        tmp["content"] = childs;
                        temp_ctors:.push(tmp);
                    }
                }
            }
        }

        false
    }

    /**
     * Dump the documentation of a field of an unvalidated class.
     *
     * */
    pub fn dumpClassFieldUnvalidated(ctx: DocVisitor, field: &GlobalVarDecl, protection: Protection, condition: [c8])-> &Config {
        let v = field.var;
        let dmut fi = copy Dict();
        fi["name"] = copy Str(v.name.str);
        fi["type"] = TypeVisitor::dumpTypeUnvalidated(ctx, v.type);
        fi["mutability"] = copy Str(if (v.isDeeplyMutable) { "dmut" } else if (v.isMutable) { "mut" } else { "" });
        fi["ref"] = copy Bool(v.isRef);
        fi["doc"] = copy Str(Utf::unescape(field.comm));
        fi["lazy"] = copy Bool(v.isLazy);
        fi["protect"] = copy Str(if protection == Protection::PRIVATE { "prv" } else if protection == Protection::PROTECTED { "prot" } else { "pub" });

        if (v.value !of EmptyExpr) {
            fi["value"] = copy Str(Utf::unescape(format("%", v.value)));
        }

        if (condition != "") {
            fi["condition"] = copy Str(condition);
        }

        fi
    }
}
