in def_;

use std::config::_;
use ymirc::utils::format;

use ymirc::syntax::declaration::_;

use ymirc::semantic::{generator::_, symbol};

use ymirc::semantic::validator;
use ymirc::doc::visitor;
use ymirc::doc::standard::StandardVisitor;
use ymirc::doc::type_::TypeVisitor;

/**
 * Visitor in charge of dumping `def` symbols, validated and unvalidated.
 * */
pub mod DefVisitor {

    /**
     * Dump the documentation of a def symbol.
     *
     * */
    pub fn dumpDef(ctx: DocVisitor, aka: &DefSymbol)-> &Config {
        if let type: &Type = aka.generator {
            let dmut res = copy Dict();
            res["kind"] = copy Str("def");
            StandardVisitor::dumpStandard(ctx, aka, alias res);
            res["type"] = TypeVisitor::dumpType(ctx, type);
            res
        } else if let value: &Value = aka.generator {
            let dmut res = copy Dict();
            res["kind"] = copy Str("def");
            StandardVisitor::dumpStandard(ctx, aka, alias res);
            res["value"] = copy Str(Utf::unescape(format("%", value)));
            res
        } else {
            DefVisitor::dumpDefUnvalidated(ctx, aka.decl, protection-> aka.protection)
        }
    }

    /**
     * Dump the documentation of an unvalidated def symbol.
     *
     * */
    pub fn dumpDefUnvalidated(ctx: DocVisitor, aka: &DefDecl, protection: Protection)-> &Config {
        let dmut res = copy Dict();
        res["kind"] = copy Str("def");
        StandardVisitor::dumpStandard(ctx, aka.name.str, aka.comm, aka.loc, protection, alias res);

        if (aka.isValue) {
            res["value"] = copy Str(Utf::unescape(format("%", aka.content)));
        } else {
            res["type"] = TypeVisitor::dumpTypeUnvalidated(ctx, aka.content);
        }

        res
    }
}
