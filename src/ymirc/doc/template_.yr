in template_;

use std::config::_;
use ymirc::utils::format;

use ymirc::syntax::{declaration::_, expression::_};

use ymirc::semantic::symbol;

use ymirc::semantic::validator;
use ymirc::doc::visitor;
use ymirc::doc::standard::StandardVisitor;
use ymirc::doc::module::ModuleVisitor;
use ymirc::doc::class_::ClassVisitor;
use ymirc::doc::trait_::TraitVisitor;
use ymirc::doc::enum_::EnumVisitor;
use ymirc::doc::function::FunctionVisitor;
use ymirc::doc::macro_::MacroVisitor;
use ymirc::doc::global::GlobalVisitor;
use ymirc::doc::def_::DefVisitor;

/**
 * Visitor in charge of dumping templates and their parameters, and
 * dispatching unvalidated declarations to the visitor of their kind.
 * */
pub mod TemplateVisitor {

    /**
     * Dump the documentation of a template symbol.
     *
     * */
    pub fn dumpTemplate(ctx: DocVisitor, t: &TemplateSymbol)-> &Config {
        TemplateVisitor::dumpTemplateUnvalidated(ctx, t.decl, protection-> t.protection)
    }

    /**
     * Dump the documentation of a template declaration.
     *
     * */
    pub fn dumpTemplateUnvalidated(ctx: DocVisitor, t: &TemplateDecl, protection: Protection)-> &Config {
        let dmut childs = copy Array();
        TemplateVisitor::dumpUnvalidated(ctx, t.decl, protection-> protection, alias childs);
        if (childs.len != 0) {
            let dmut tmp = copy Dict();
            tmp["kind"] = copy Str("template");

            TemplateVisitor::dumpTemplateParams(ctx, t, alias tmp);
            StandardVisitor::dumpStandard(ctx, t.loc.str, t.comm, t.loc, protection, alias tmp);
            tmp["content"] = childs;
            if (t.guard !of EmptyExpr) {
                tmp["test"] = copy Str(Utf::unescape(format("%", t.guard)));
            }

            return tmp;
        }

        copy None()
    }

    /**
     * Dump the documentation of an unvalidated declaration.
     *
     * */
    pub fn dumpUnvalidated(ctx: DocVisitor, d: &Declaration, protection: Protection, dmut result: &Array) {
        match d {
            b: &BlockDecl => {
                let inProt = if (b.isSet) { protection } else { b.protection };
                for i in b.decls {
                    TemplateVisitor::dumpUnvalidated(ctx, i, protection-> inProt, alias result);
                }
            }
            t: &TemplateDecl => {
                result:.push(TemplateVisitor::dumpTemplateUnvalidated(ctx, t, protection-> protection));
            }
            m: &ModuleDecl => {
                result:.push(ModuleVisitor::dumpModuleUnvalidated(ctx, m, protection-> protection));
            }
            c: &TypeDecl => {
                result:.push(ClassVisitor::dumpClassUnvalidated(ctx, c, protection-> protection));
            }
            t: &TraitDecl => {
                result:.push(TraitVisitor::dumpTraitUnvalidated(ctx, t, protection-> protection));
            }
            e: &EnumDecl => {
                result:.push(EnumVisitor::dumpEnumUnvalidated(ctx, e, protection-> protection));
            }
            f: &FunctionDecl => {
                let dmut res = copy Dict();
                FunctionVisitor::dumpFunctionUnvalidated(ctx, f, alias res, forMethod-> false, noStandard-> false, protection-> protection);
                result:.push(res);
            }
            m: &MacroDecl => {
                result:.push(MacroVisitor::dumpMacroUnvalidated(ctx, m, protection-> protection));
            }
            g: &GlobalVarDecl => {
                result:.push(GlobalVisitor::dumpGlobalUnvalidated(ctx, g, protection-> protection));
            }
            a: &DefDecl => {
                result:.push(DefVisitor::dumpDefUnvalidated(ctx, a, protection-> protection));
            }
        }
    }

    /**
     * Dump the documentation of template parameters.
     *
     * */
    pub fn dumpTemplateParams(ctx: DocVisitor, tmpl: &TemplateDecl, dmut res: &Dict) {
        let dmut elems = copy Array();
        for p in tmpl.params match p {
            a: &TemplateAndExpr => {
                elems:.push(TemplateVisitor::dumpTemplateAndParam(ctx, a));
            }
            o: &TemplateOfVarExpr => {
                elems:.push(TemplateVisitor::dumpTemplateOfParam(ctx, o));
            }
            v: &TemplateVarExpr => {
                elems:.push(TemplateVisitor::dumpTemplateVar(ctx, v));
            }
            v: &TemplateVariadicVarExpr => {
                elems:.push(TemplateVisitor::dumpTemplateVariadicVar(ctx, v));
            }
            z => {
                let dmut v = copy Dict();
                v["kind"] = copy Str("any");
                v["content"] = copy Str(Utf::unescape(format("%", z)));
                elems:.push(v);
            }
        }

        res["templates"] = elems;
    }

    /**
     * Dump the documentation of a template "and" param.
     *
     * */
    pub fn dumpTemplateAndParam(ctx: DocVisitor, a: &TemplateAndExpr)-> &Config {
        let dmut res = copy Dict();
        let dmut inner = copy Array();
        res["kind"] = copy Str("and");
        for z in a.inners {
            inner:.push(TemplateVisitor::dumpTemplateOfParam(ctx, z));
        }

        res["content"] = inner;
        res
    }

    /**
     * Dump the documentation of a template "of" param.
     *
     * */
    pub fn dumpTemplateOfParam(_: DocVisitor, o: &TemplateOfVarExpr)-> &Config {
        let dmut res = copy Dict();
        res["kind"] = copy Str(o.kind);
        res["name"] = copy Str(o.loc.str);
        res["content"] = copy Str(Utf::unescape(format("%", o.spec)));
        res
    }

    /**
     * Dump the documentation of a template "var" param.
     *
     * */
    pub fn dumpTemplateVar(_: DocVisitor, v: &TemplateVarExpr)-> &Config {
        let dmut res = copy Dict();
        res["kind"] = copy Str(v.kind);
        res["name"] = copy Str(v.loc.str);
        res
    }

    /**
     * Dump the documentation of a template variadic param.
     *
     * */
    pub fn dumpTemplateVariadicVar(_: DocVisitor, v: &TemplateVariadicVarExpr)-> &Config {
        let dmut res = copy Dict();
        res["kind"] = copy Str("variadic");
        res["name"] = copy Str(v.loc.str);
        res["value"] = copy Bool(v.isValue);
        res
    }
}
