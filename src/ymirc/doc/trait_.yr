in trait_;

use std::config::_;
use ymirc::utils::format;

use ymirc::syntax::{declaration::_, expression::_};

use ymirc::semantic::{generator::_, symbol};

use ymirc::semantic::validator;
use ymirc::doc::visitor;
use ymirc::doc::standard::StandardVisitor;
use ymirc::doc::function::FunctionVisitor;

/**
 * Visitor in charge of dumping traits, validated and unvalidated.
 * */
pub mod TraitVisitor {

    /**
     * Dump the documentation of a trait symbol.
     *
     * */
    pub fn dumpTrait(ctx: DocVisitor, t: &TraitSymbol)-> &Config {
        let dmut res = copy Dict();
        res["kind"] = copy Str("trait");
        StandardVisitor::dumpStandard(ctx, t, alias res);

        let dmut methods = copy Array();
        for i in t.getAllLocalSymbols(protection-> Protection::PRIVATE) match i {
            f: &FunctionSymbol => {
                methods:.push(FunctionVisitor::dumpFunctionUnvalidated(ctx, f));
            }
        }

        let dmut assertions = copy Array();
        for exp in t.assertions {
            let dmut as = copy Dict();
            as["test"] = copy Str(Utf::unescape(format("%", exp.test)));
            as["msg"] = copy Str(Utf::unescape(format("%", exp.msg)));
            as["doc"] = copy Str(Utf::unescape(exp.comm));
            assertions:.push(as);
        }

        res["assertions"] = assertions;
        res["methods"] = methods;
        return res;
    }

    /**
     * Dump the documentation of a trait that has not been validated.
     *
     * */
    pub fn dumpTraitUnvalidated(ctx: DocVisitor, t: &TraitDecl, protection: Protection)-> &Config {
        let dmut res = copy Dict();
        res["kind"] = copy Str("trait");
        StandardVisitor::dumpStandard(ctx, t.name.str, t.comm, t.loc, protection, alias res);

        let dmut methods = copy Array(), dmut assertions = copy Array();
        for i in t.decls {
            TraitVisitor::dumpTraitUnvalidatedInner(ctx, i, alias methods,
                                           alias assertions,
                                           protection-> Protection::PROTECTED);
        }

        res["methods"] = methods;
        res["assertions"] = assertions;
        res
    }

    /**
     * Dump the content of an unvalidated trait.
     *
     * */
    pub fn dumpTraitUnvalidatedInner(ctx: DocVisitor, d: &Declaration, dmut methods: &Array, dmut assertions: &Array, condition: [c8] = "", protection: Protection) {
        match d {
            dl: &BlockDecl => {
                for i in dl.decls {
                    TraitVisitor::dumpTraitUnvalidatedInner(ctx, i, alias methods, alias assertions, protection-> dl.protection, condition-> condition);
                }
            }
            c: &CondBlockDecl => {
                let innerTest = Utf::unescape(
                    if condition != "" { format("% && (%)", condition, c.test)  } else { format("%", c.test) });
                for i in c.decls {
                    TraitVisitor::dumpTraitUnvalidatedInner(ctx, i, alias methods, alias assertions, protection-> protection, condition-> innerTest);
                }
                if let b: &BlockDecl = c.else_ {
                    let elseTest = Utf::unescape(
                        if condition != "" { format("% && !(%)", condition, c.test)  } else { format("!(%)", c.test) });
                    TraitVisitor::dumpTraitUnvalidatedInner(ctx, b, alias methods, alias assertions, protection-> protection, condition-> elseTest);
                }
            }
            f: &FunctionDecl => {
                let dmut ch = copy Dict();
                FunctionVisitor::dumpFunctionUnvalidated(ctx, f, alias ch, forMethod-> true, protection-> protection, noStandard-> false, condition-> condition);
                methods:.push(ch);
            }
            a: &AssertDecl => {
                let dmut as = copy Dict();
                as["test"] = copy Str(Utf::unescape(format("%", a.test)));
                as["msg"] = copy Str(Utf::unescape(format("%", a.msg)));
                as["doc"] = copy Str(Utf::unescape(a.comm));
                if (condition != "") {
                    as["condition"] = copy Str(condition);
                }
                assertions:.push(as);
            }
            _ => {}
        }
    }
}
