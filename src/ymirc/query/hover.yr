in hover;

use ymirc::lexing::word;
use ymirc::semantic::index;
use ymirc::semantic::generator::value::literal;
use ymirc::utils::format;

/**
 * The description of the entity a token names
 */
@data
pub record Hover {
    // The token the description is about
    let loc: &Word;

    // The signature or the type of the entity, followed by its documentation
    let text: [c8];
}

pub mod HoverQuery {

    /**
     * @returns: the description of the entity named by the token covering the
     * column `col` of the line `line` of `file`, none if no token naming an entity does
     */
    pub fn at(index: &SemanticIndex, file: [c8], line: u64, col: u64)-> (Hover)? {
        if let Ok(occ) = index.at(file, line, col) {
            return Hover(occ.loc, HoverQuery::describe(index, occ))?;
        }

        none
    }

    /**
     * @returns: the signature or the type of the entity `occ` names, as its token
     * resolved it or as another one did, followed by its documentation for a symbol
     */
    pub fn describe(index: &SemanticIndex, occ: Occurrence)-> [c8] {
        if let Ok(t) = occ.localType() {
            return format("%: %", occ.decl.loc.str, t);
        }

        let mut text = format("%", occ.symbol.path);
        if (occ.resolved !of UnitValue) {
            text = format("%", occ.resolved, tags-> FormatTags(withParams-> true));
        } else for o in index.referencesOf(occ) if o.resolved !of UnitValue {
            text = format("%", o.resolved, tags-> FormatTags(withParams-> true));
            break;
        }

        let doc = HoverQuery::trim(occ.symbol.comm);
        if (doc != "") {
            text = text ~ "\n\n" ~ doc;
        }

        text
    }

    /**
     * @returns: `txt` without its leading and trailing blanks
     */
    fn trim(txt: [c8])-> [c8] {
        let mut begin = 0us;
        let mut end = txt.len;
        while (begin < end && (txt[begin] == ' ' || txt[begin] == '\n' || txt[begin] == '\t')) { begin += 1us; }
        while (end > begin && (txt[end - 1us] == ' ' || txt[end - 1us] == '\n' || txt[end - 1us] == '\t')) { end -= 1us; }
        txt[begin .. end]
    }
}
