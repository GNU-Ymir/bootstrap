in navigation;

use ymirc::lexing::word;
use ymirc::semantic::index;

pub mod NavigationQuery {

    /**
     * @returns: the token declaring the entity named by the token covering the
     * column `col` of the line `line` of `file`, none if no token naming an
     * entity does, or if the entity is not declared in a file
     */
    pub fn definition(index: &SemanticIndex, file: [c8], line: u64, col: u64)-> (&Word)? {
        if let Ok(occ) = index.at(file, line, col) {
            let decl = occ.declLoc();
            if (!decl.isEof && decl.filename != "") return decl?;
        }

        none
    }

    /**
     * @returns: the tokens naming the entity named by the token covering the
     * column `col` of the line `line` of `file`, the declaration excluded
     * unless `withDeclaration`
     */
    pub fn references(index: &SemanticIndex, file: [c8], line: u64, col: u64, withDeclaration: bool = true)-> [&Word] {
        let mut res: [&Word] = [];
        if let Ok(occ) = index.at(file, line, col) {
            for o in index.referencesOf(occ) {
                if (withDeclaration || o.kind == OccurrenceKind::REFERENCE) {
                    res ~= [o.loc];
                }
            }
        }

        res
    }
}
