in json;

use ymirc::errors::lsp;
use ymirc::lexing::word;

use std::config::data;

pub mod QueryExporting {

    /**
     * @returns: the line and column of the queries (from 1, in bytes) of the
     * protocol position `line`, `character` (from 0, in `encoding` units) of `content`
     */
    pub fn fromPosition(content: [c8], line: u64, character: u64, encoding: PositionEncoding)-> (u64, u64) {
        let mut l = 0u64;
        let mut i = 0us;
        while (l < line && i < content.len) {
            if (content[i] == '\n') l += 1u64;
            i += 1us;
        }

        let start = i;
        let mut units = 0u64;
        while (units < character && i < content.len && content[i] != '\n') {
            let b = cast!u8(content[i]);
            if (encoding == PositionEncoding::UTF8) {
                units += 1u64;
            } else if ((b & 0xC0u8) != 0x80u8) {
                units += if (b >= 0xF0u8) { 2u64 } else { 1u64 };
            }

            i += 1us;
            while (encoding != PositionEncoding::UTF8 && i < content.len && (cast!u8(content[i]) & 0xC0u8) == 0x80u8) { i += 1us; }
        }

        (line + 1u64, cast!u64(i - start) + 1u64)
    }

    /**
     * @returns: a `Hover`
     */
    pub fn dump(h: Hover, encoding: PositionEncoding)-> &Config {
        let dmut contents = copy Dict();
        contents["kind"] = copy Str("plaintext");
        contents["value"] = copy Str(h.text);

        let dmut res = copy Dict();
        res["contents"] = contents;
        res["range"] = lsp::JsonExporting::dumpRange(Location(h.loc, h.loc, encoding));
        res
    }

    /**
     * @returns: the `Location`s of the tokens `locs`
     */
    pub fn dump(locs: [&Word], encoding: PositionEncoding)-> &Config {
        let dmut res = copy Array();
        for l in locs {
            res:.push(lsp::JsonExporting::dumpLocation(Location(l, l, encoding)));
        }

        res
    }

    /**
     * @returns: the `DocumentSymbol`s of the declarations `syms`
     */
    pub fn dump(syms: [DocumentSymbol], encoding: PositionEncoding)-> &Config {
        let dmut res = copy Array();
        for s in syms {
            let range = lsp::JsonExporting::dumpRange(Location(s.loc, s.loc, encoding));
            let dmut d = copy Dict();
            d["name"] = copy Str(s.name);
            d["kind"] = copy Int(cast!i64(s.kind));
            d["range"] = range;
            d["selectionRange"] = range;
            if (s.children.len != 0us) {
                d["children"] = QueryExporting::dump(s.children, encoding);
            }

            res:.push(d);
        }

        res
    }

    /**
     * @returns: the `CompletionItem`s `items`
     */
    pub fn dump(items: [CompletionItem])-> &Config {
        let dmut res = copy Array();
        for i in items {
            let dmut d = copy Dict();
            d["label"] = copy Str(i.label);
            d["kind"] = copy Int(cast!i64(i.kind));
            if (i.detail != "") {
                d["detail"] = copy Str(i.detail);
            }

            res:.push(d);
        }

        res
    }
}
