in outline;

use ymirc::lexing::word;
use ymirc::semantic::symbol;
use ymirc::syntax::declaration::{block, custom, function};

/**
 * The kind of a declaration, valued as the protocol's `SymbolKind`
 */
pub enum SymbolKind : i32
| MODULE      = 2
| CLASS       = 5
| METHOD      = 6
| FIELD       = 8
| CONSTRUCTOR = 9
| ENUM        = 10
| INTERFACE   = 11
| FUNCTION    = 12
| VARIABLE    = 13
| CONSTANT    = 14
| STRUCT      = 23
;

/**
 * A declaration of a file, and the ones nested in it
 */
@data
pub record DocumentSymbol {
    // The name of the declaration
    let name: [c8];

    // The kind of the declaration
    let kind: SymbolKind;

    // The token naming the declaration
    let loc: &Word;

    // The declarations nested in it
    let children: [DocumentSymbol];
}

pub mod OutlineQuery {

    /**
     * @returns: the declarations of `file`, found in the symbol tree of `root`,
     * in the order of the file
     */
    pub fn symbols(root: &Symbol, file: [c8])-> [DocumentSymbol] {
        OutlineQuery::sorted(OutlineQuery::collect(root, file))
    }

    /**
     * @returns: the declarations of `file` nested in `sym`; a module of the
     * file itself is not one, its own being, nor is an impl, its methods being
     * the ones of its class
     */
    fn collect(sym: &Symbol, file: [c8])-> [DocumentSymbol] {
        let mut res: [DocumentSymbol] = [];
        for s in sym.allLocalSymbols(protection-> Protection::PRIVATE) {
            if let m: &ModuleSymbol = s && (m.isGlobal || m.loc.filename != file) {
                res ~= OutlineQuery::collect(s, file);
                continue;
            }

            if (s of ImplSymbol) {
                res ~= OutlineQuery::collect(s, file);
                continue;
            }

            if (s.loc.isEof || s.loc.filename != file) continue;
            if let Ok(kind) = OutlineQuery::kindOf(s) {
                let mut children = OutlineQuery::collect(s, file);
                if let c: &ClassSymbol = s {
                    for f in c.fields {
                        children ~= [DocumentSymbol(f.name.str, SymbolKind::FIELD, f.name, [])];
                    }
                }

                res ~= [DocumentSymbol(s.loc.str, kind, s.loc, OutlineQuery::sorted(children))];
            }
        }

        res
    }

    /**
     * @returns: the kind of the declaration of `sym`, none if it declares
     * nothing an outline lists
     */
    fn kindOf(sym: &Symbol)-> (SymbolKind)? {
        match sym {
            ModuleSymbol()    => return SymbolKind::MODULE?;
            c: &ClassSymbol   => return (if (c.isStruct) { SymbolKind::STRUCT } else { SymbolKind::CLASS })?;
            f: &FunctionSymbol => return (if (f.isMethod) { SymbolKind::METHOD } else { SymbolKind::FUNCTION })?;
            CtorSymbol()      => return SymbolKind::CONSTRUCTOR?;
            DtorSymbol()      => return SymbolKind::METHOD?;
            EnumSymbol()      => return SymbolKind::ENUM?;
            TraitSymbol()     => return SymbolKind::INTERFACE?;
            UnionSymbol()     => return SymbolKind::STRUCT?;
            GlobalVarSymbol() => return SymbolKind::VARIABLE?;
            DefSymbol()       => return SymbolKind::CONSTANT?;
            MacroSymbol()     => return SymbolKind::FUNCTION?;
            t: &TemplateSymbol => match t.decl.decl {
                CtorDecl()     => return SymbolKind::CONSTRUCTOR?;
                FunctionDecl() => return (if (t.isMethod) { SymbolKind::METHOD } else { SymbolKind::FUNCTION })?;
                c: &TypeDecl   => return (if (c.isRecord || c.isEntity) { SymbolKind::STRUCT } else { SymbolKind::CLASS })?;
                TraitDecl()    => return SymbolKind::INTERFACE?;
                EnumDecl()     => return SymbolKind::ENUM?;
                UnionDecl()    => return SymbolKind::STRUCT?;
                _              => return SymbolKind::FUNCTION?;
            }
        }

        none
    }

    /**
     * @returns: `syms` in the order they are declared in the file
     */
    fn sorted(syms: [DocumentSymbol])-> [DocumentSymbol] {
        use std::algorithm::sorting;
        sort(copy syms, |a, b| => {
            let la = a.loc;
            let lb = b.loc;
            la.line < lb.line || (la.line == lb.line && la.col < lb.col)
        })
    }
}
