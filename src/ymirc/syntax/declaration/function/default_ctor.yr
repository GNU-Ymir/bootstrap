in default_ctor;

use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::{format, comparison};
use std::stream;

/**
 * Syntaxic node representation of a default constructor request(`self;`)
 *
 * A class, record or entity asks with it for a constructor built from its
 * fields, instead of writing that constructor by hand. There is nothing to
 * declare - no prototype, no body - the declaration is only the request, the
 * constructor itself is synthesized at validation time from the fields of the
 * type.
 * */
@final
pub class DefaultCtorDecl over Declaration {

    /**
     * @params:
     *    - loc:  the location of the `self` keyword
     *    - comm: the comments about the declaration
     * */
    pub self (loc: &Word, comm: [c8])
        with super (loc, comm)
    {}

    impl Comparable!{&Declaration};
    impl Streamable;
    impl Formattable {
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(Keys::SELF, Tokens::SEMI_COLON, Tokens::RETURN);
        }
    }
}
