in attributes;

use ymirc::lexing::{word, keys, tokens};
use ymirc::syntax::expression;
use ymirc::utils::{comparison, format};

use std::stream;

/**
 * @returns: the number of arguments the attribute `attr` takes
 * */
pub fn attributeArity (attr: Attributes)-> usize {
    match attr {
        Attributes::PARAMETERS => { 1us }
        _ => { 0us }
    }
}

pub record AttributeWord {

    // The location of the attribute
    pub let loc: &Word;

    // The given attribute activated
    pub let attr: Attributes;

    // The arguments given to the attribute
    pub let args: [&Expression];

    /**
     * @params:
     *    - loc:  the location of the Attribute definition
     *    - attr: the attribute activated
     *    - args: the arguments given to the attribute
     * */
    pub self (loc: &Word, attr: Attributes, args: [&Expression] = [])
        with loc = loc
        , attr = attr
        , args = args
    {}

    /**
     * @returns: true iif `o` activates the same attribute with the same arguments
     * */
    pub fn opEquals(self, o: AttributeWord)-> bool {
        self.attr == o.attr && self.args == o.args
    }

    impl Streamable;
    impl Formattable {

        /**
         * Pretty formatting of the attribute inside the stream
         * */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(self.attr);
            if (self.args.len != 0us) {
                stream:.write(Tokens::LPAR);
                for i, a in self.args {
                    if (i != 0us) stream:.write(Tokens::COMA, " ");
                    a.format(alias stream);
                }
                stream:.write(Tokens::RPAR);
            }
        }
    }
}
