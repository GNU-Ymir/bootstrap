in tag;

use ymirc::lexing::{keys, tokens, word};
use ymirc::syntax::declaration::function;
use ymirc::syntax::expression;
use ymirc::syntax::expression::empty;
use ymirc::utils::{comparison, format};

use std::stream;

/**
 * Syntaxic representation of a tag declaration
 *
 * ```
 * tag if guard name {templates} (params) {
 *     globals          // one per tag, shared by every site
 *     apply overloads  // the rewrites merged into the tagged symbols
 *     self overloads   // the tag ctors, run once per tag site
 * }
 * ```
 */
@final
pub class TagDecl over Declaration {

    pub {
        // The name of the tag
        let name: &Word;

        // The template parameters of the tag, inferred from the arguments of a tag site
        let templates: [&Expression];

        // The test of the template parameters, EmptyExpr if there is none
        let guard: &Expression;

        // The parameters of the tag, the arguments of a tag site are given to
        let proto: FunctionPrototype;

        // The globals, `apply` and `self` declarations of the tag
        let decls: [&Declaration];
    }

    /**
     * @params:
     *    - loc:   the location of the `tag` keyword
     *    - comm:  the comments about the tag
     *    - name:  the name of the tag
     *    - proto: the parameters of the tag
     *    - decls: the declarations inside the tag
     *    - templates: the template parameters of the tag
     *    - guard: the test of the template parameters, EmptyExpr if there is none
     */
    pub self (loc: &Word, comm: [c8], name: &Word, proto: FunctionPrototype, decls: [&Declaration],
              templates: [&Expression] = [], guard: &Expression = EMPTY_EXPR)
        with super (loc, comm)
        , name = name
        , templates = templates
        , guard = guard
        , proto = proto
        , decls = decls
    {}

    impl Comparable!{&Declaration};
    impl Streamable;
    impl Formattable {
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(Keys::TAG, ' ');
            if self.guard !of EmptyExpr {
                stream:.write(Keys::IF, ' ');
                self.guard.format(alias stream);
                stream:.write(' ');
            }

            stream:.write(self.name.str, ' ');
            if (self.templates.len != 0us) {
                stream:.write(Tokens::LACC);
                for i, e in self.templates {
                    if (i != 0us) stream:.write(Tokens::COMA, " ");
                    e.format(alias stream);
                }

                stream:.write(Tokens::RACC, ' ');
            }

            self.proto.format(alias stream);
            stream:.write(" ", Tokens::LACC, Tokens::RETURN);
            stream:.entabing();
            for i in self.decls {
                i.format(alias stream);
            }
            stream:.detabing();
            stream:.write(Tokens::RACC, Tokens::RETURN);
        }
    }

}
