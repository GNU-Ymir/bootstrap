in tagged;

use ymirc::lexing::{tokens, word};
use ymirc::syntax::expression;
use ymirc::utils::{comparison, format};

use std::stream;

/**
 * Syntaxic representation of a declaration written after a list of tags,
 * `#[a("x"), b] decl`. The doc comment written before the tags is the one of
 * the declaration.
 */
@final
pub class TaggedDecl over Declaration {

    pub {
        // The tag sites, in the order they are written: a path, or a call of a path
        let tags: [&Expression];

        // The tagged declaration
        let decl: &Declaration;
    }

    /**
     * @params:
     *    - loc:  the location of the first tag list
     *    - tags: the tag sites
     *    - decl: the tagged declaration
     */
    pub self (loc: &Word, tags: [&Expression], decl: &Declaration)
        with super (loc, "")
        , tags = tags
        , decl = decl
    {}

    impl Comparable!{&Declaration};
    impl Streamable;
    impl Formattable {
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(Tokens::MACRO_CRO);
            for i, e in self.tags {
                if (i != 0us) stream:.write(Tokens::COMA, " ");
                e.format(alias stream);
            }
            stream:.write(Tokens::RCRO, Tokens::RETURN);
            self.decl.format(alias stream);
        }
    }

}
