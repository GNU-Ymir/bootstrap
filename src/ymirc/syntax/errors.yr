in errors;

use ymirc::errors::code;

/// Local shorthand for the catalogue entry type, cf. `ymirc::errors::code`.
def Error: code::Error;

/// The code of a message that is a context note rather than a diagnostic.
def NO_CODE = code::NO_CODE;

/**
 * Errors that can happen within a syntax visit.
 *
 * */
pub enum SyntaxErrorMessage: Error
| BLOCK_NEVER_CLOSED          = Error (2001,    "block is never closed")
| IF_NON_TEMPLATE             = Error (NO_CODE, "cannot test a non-template declaration")
| IN_DECL_BLOCK               = Error (NO_CODE, "invalid syntax inside a declaration block")
| MISSING_TEMPLATE_ACC        = Error (NO_CODE, "ambiguous template application: multiple top-level '!' markers(e.g., A!B!C). Use braces to disambiguate(A!{B!C})")
| TEMPLATE_SYMBOL             = Error (NO_CODE, "when reading template symbol")
| MULTIPLE_ATTRS              = Error (2002,    "decorator %(y) is defined multiple times")
| MULTIPLE_AUX_CSTRS          = Error (2003,    "multiple constructor redirects are not permitted")
| MULTIPLE_SAME_GUARD         = Error (2004,    "scope guard %(y) is declared multiple times")
| READING_LOCAL_DECLARATION   = Error (NO_CODE, "failed to read local symbol declaration")
| READING_PATTERN_DECLARATION = Error (NO_CODE, "failed to read pattern variable declaration")
| READING_LET_DECLARATION     = Error (NO_CODE, "failed to read standard variable declaration")
| UNDEFINED_ATTRIBUTE         = Error (2005,    "undefined attribute %(y)")
| UNDEF_DECORATOR_IN_MATCH    = Error (2006,    "decorator %(y) cannot be applied to a subpattern variable")
| UNEXPECTED                  = Error (2007,    "unexpected %(y)")
| UNEXPECTED_ATTRIBUTES       = Error (2008,    "unexpected attribute list %(y)")
| UNEXPECTED_BUT_LST          = Error (2009,    "read %(y), but expected %(y)")
| UNTERMINATED_BLOCK          = Error (2010,    "unterminated block")
| USED_AS_IDENTIFIER          = Error (2011,    "%(y) cannot be used as an identifier");
