in cache;

use ymirc::errors;
use ymirc::global::state;
use ymirc::syntax::declaration::module;
use ymirc::syntax::visitor::implem;

use std::fs::_;

@final
pub class SyntaxCache {

    // Whether the trees are kept, a cache that keeps none reading every file
    let _enabled: bool;

    // By file, the content and the active versions a tree was read with, and the tree
    let mut _trees: [Path => mut ([c8], [[c8]], &ModuleDecl)] = copy [];

    // The number of trees reused
    let mut _hits: usize = 0us;

    /**
     * @params:
     *    - enabled: whether the trees are kept
     */
    pub self (enabled: bool = false)
        with _enabled = enabled
    {}

    /**
     * @returns: the number of trees that were reused rather than read
     */
    pub fn hits(self)-> usize {
        self._hits
    }

    /**
     * Read the syntax tree of the file `path`, the one kept for it if neither
     * its content nor the active versions the lexer depends on changed; a tree
     * with syntax errors is never kept
     *
     * @returns: the tree, and the syntax errors it was read in spite of, cf. `SyntaxVisitor::recoveredError`
     * @throws:
     *    - FsError: if the file cannot be read
     *    - ErrorMsg: if the file has syntax errors
     */
    pub fn read(mut self, path: Path)-> (&ModuleDecl, (&ErrorMsg)?)
        throws ErrorMsg, FsError
    {
        if (!self._enabled) {
            let dmut visitor = copy SyntaxVisitor(path);
            let tree = visitor:.read();
            return (tree, visitor.recoveredError());
        }

        let content = readSource(path);
        let versions = state::activeVersions();
        if let Ok(kept) = self._trees[path] && (kept._0 == content && sameVersions(kept._1, versions)) {
            self._hits += 1us;
            return (kept._2, none);
        }

        let dmut visitor = copy SyntaxVisitor::fromStr(path.toStr(), content);
        let tree = visitor:.read();
        let recovered = visitor.recoveredError();
        if let Ok(_) = recovered {
            return (tree, recovered);
        }

        self._trees[path] = (content, versions, tree);
        (tree, recovered)
    }
}

/**
 * @returns: true if `kept` holds the same identifiers as `active`, the active versions
 */
fn sameVersions(kept: [[c8]], active: [[c8]])-> bool {
    if (kept.len != active.len) return false;
    for v in kept {
        if (!state::isVersionActive(v)) return false;
    }

    true
}
