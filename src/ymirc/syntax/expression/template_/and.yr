in and;

use std::stream;
use ymirc::syntax::expression::template_::ofvar;

use ymirc::lexing::keys;
use ymirc::lexing::{word, tokens};
use ymirc::utils::{format, comparison};

/**
 * A template and expression, defining a And constraint between multiple OfVar constraints
 *
 */
@final
pub class TemplateAndExpr over TemplateExpr {

    /*! Public fields */
    pub {
        let inners: [&TemplateOfVarExpr];
    }

    /**
     * @params:
     *    - loc: the location and name of the variable
     *    - inners: the template specialization to check
     * */
    pub self (loc: &Word, inners: [&TemplateOfVarExpr])
        with super (loc)
        , inners = inners
    {}

    /**
     * @returns: the name of the variable
     * */
    @field
    pub fn name(self)-> &Word {
        return self.loc;
    }

    impl Comparable!{&Expression};
    impl Streamable;
    impl Formattable {
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(self.name.str);
            for i, elem in self.inners {
                if i != 0 {
                    stream:.write(' ', Tokens::DAND);
                }

                stream:.write(' ', elem.kind, ' ');
                stream:.entabing();
                elem.spec.format(alias stream);
                stream:.detabing();
            }
        }
    }

}
