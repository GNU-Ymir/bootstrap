in var;

use std::stream;

use ymirc::lexing::{word, tokens};
use ymirc::utils::{format, comparison};

/**
 * Syntaxic representation of a var literal.
 *
 */
@final
pub class VarExpr over LiteralExpr {

    pub {
        // True iff the variable is written as a back quoted string
        let isQuoted: bool;
    }

    /**
     * @params:
     *    - name:     the name of the var literal
     *    - isQuoted: true iff the variable is written as a back quoted string
     */
    pub self (name: &Word, isQuoted: bool)
        with super (name)
        , isQuoted = isQuoted
    {}

    /**
     * @returns: the name of the variable
     * */
    @field
    pub fn name(self)-> &Word {
        self.loc
    }

    impl Comparable!{&Expression};
    impl Streamable;
    impl Formattable {

        pub over format(self, dmut stream: &Formatter) {
            if self.isQuoted {
                stream:.write(Token::BACK_QUOTE, self.loc.str, Token::BACK_QUOTE);
            }
            else {
                stream:.write(self.loc.str);
            }
        }
    }

}
