in yield_;

use ymirc::lexing::{keys, word};
use ymirc::syntax::expression::empty;
use ymirc::utils::{comparison, format};

use std::stream;

/**
 * Syntaxic node representation of a yield expression
 *
 */
@final
pub class YieldExpr over InstructionExpr {

    /*! Public fields */
    pub {
        // The value that is yielded, or the generator whose values are yielded
        let value: &Expression;

        // True iif every value of the generator `value` is yielded, `yield in value`
        let isIn: bool;
    }

    /**
     * @params:
     *    - loc: the location of the yield
     *    - value: the value of the yield
     *    - isIn: the yield hands over every value of the generator `value`
     */
    pub self (loc: &Word, value: &Expression, isIn: bool = false)
        with super (loc)
        , value = value
        , isIn = isIn
    {}

    impl Comparable!{&Expression};
    impl Streamable;
    impl Formattable {

        /**
         * Pretty formatting of the yield
         */
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(Keys::YIELD);
            if self.isIn {
                stream:.write(' ', Keys::IN);
            }

            if self.value !of EmptyExpr {
                stream:.entabing();
                stream:.write(' ', self.value);
                stream:.detabing();
            }
        }
    }

}
