in mapfor;

use ymirc::lexing::{keys, tokens, word};
use ymirc::syntax::expression::{empty, instruction};
use ymirc::utils::{comparison, format};

use std::stream;

/**
 * Syntaxic representation of a map allocation using a list comprehension
 *
 */
@final
pub class MapForAllocatorExpr over ComposeExpr {

    pub {
        // The location of the 'for' keyword
        let forLoc: &Word;

        // The key to construct at each iteration
        let key: &Expression;

        // The value to attach to the key at each iteration
        let value: &Expression;

        // The iteration variables
        let vars: [&VarDeclExpr];

        // The iterated value
        let iter: &Expression;

        // The test selecting the iterations producing a pair, EMPTY_EXPR when there is none
        let filter: &Expression;
    }

    /**
     * @params:
     *    - loc: the location of the allocator
     *    - key: the key to construct at each iteration
     *    - value: the value to attach to the key at each iteration
     *    - vars: the variables used to iterate
     *    - iter: the value being iterated
     *    - filter: the test selecting the iterations producing a pair
     */
    pub self (loc: &Word, forLoc: &Word, key: &Expression, value: &Expression, vars: [&VarDeclExpr], iter: &Expression, filter: &Expression = EMPTY_EXPR)
        with super (loc)
        , forLoc = forLoc
        , key = key
        , value = value
        , vars = vars
        , iter = iter
        , filter = filter
    {}


    impl Comparable!{&Expression};
    impl Streamable;
    impl Formattable {
        pub over format(self, dmut stream: &Formatter) {            
            stream:.write(Tokens::LCRO, ' ');        
            stream:.entabing();
            self.key.format(alias stream);
            stream:.write(' ', Tokens::DARROW, ' ');
            self.value.format(alias stream);

            stream:.write(' ', Keys::FOR, ' ');
            for i, elem in self.vars {
                if (i != 0us) stream:.write(", ");
                elem.format(alias stream);
            }
            stream:.write(' ', Keys::IN, ' ');
            self.iter.format(alias stream);

            if self.filter !of EmptyExpr {
                stream:.write(' ', Keys::IF, ' ');
                self.filter.format(alias stream);
            }
            stream:.detabing();
            
            stream:.write(Tokens::RCRO);
        }
    }

}
