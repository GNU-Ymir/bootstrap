in ident;

use ymirc::lexing::{tokens, word};
use ymirc::syntax::expression::literal;
use ymirc::utils::{comparison, format};

use std::stream;

/**
 * A macro ident is a named identifier in a macro rule.
 *
 */
@final
pub class MacroIdentExpr over MacroRuleExpr {

    /*! Public fields */
    pub {
        // The values the ident is restricted to, empty if it accepts them all
        let filters: [&StringExpr];
    }

    /**
     * @params:
     *    - loc:     the location of the ident
     *    - filters: the values the ident is restricted to
     */
    pub self (name: &Word, filters: [&StringExpr] = [])
        with super (name)
        , filters = filters
    {}

    @field
    pub fn name(self)-> &Word {
        self.loc
    }

    impl Comparable!{&Expression};
    impl Streamable;
    impl Formattable {
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(self.name.str);
            if (self.filters.len != 0) {
                stream:.write(Tokens::LCRO);
                for i, f in self.filters {
                    if (i != 0) stream:.write(' ', Tokens::PIPE, ' ');
                    f.format(alias stream);
                }
                stream:.write(Tokens::RCRO);
            }
        }
    }

}
