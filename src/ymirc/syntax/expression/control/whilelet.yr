in whilelet;

use ymirc::syntax::expression::empty;

use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::{format, comparison};

use std::stream;

/**
 * Syntaxic representation of a while let loop control structure
 *
 */
@final
pub class WhileLetLoopExpr over ControlExpr {

    pub {
        // The test of the while
        let test: &Expression;

        // Guard expression
        let guard: &Expression;

        // The block of the loop
        let block: &Expression;
        
    }

    /**
     * @params: 
     *   - loc: the location of the expression
     *   - test: the test of the expression
     *   - guard:   the guard expression (added to the test part)
     *   - block: the block of the expression     
     */
    pub self (loc:   &Word,
              test:  &Expression,
              guard: &Expression,
              block: &Expression)
        
        with super (loc)
        , test = test
        , guard = guard
        , block = block        
    {}

    impl Comparable!{&Expression};
    impl Streamable;
    impl Formattable {
        pub over format (self, dmut stream: &Formatter) {            
            stream:.write (Keys::WHILE, ' ', Keys::LET, ' ');
            stream:.entabing ();
            self.test.format (alias stream);
            stream:.write (' ');
            if self.guard !of EmptyExpr {
                stream:.write (Tokens::DAND, " ");
                self.guard.format (alias stream);
            }
            
            stream:.detabing ();
            self.block.format (alias stream);        
        }
    }
    
}
