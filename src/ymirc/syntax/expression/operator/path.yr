in path;

use std::stream;

use ymirc::lexing::{word, tokens};
use ymirc::utils::{format, comparison};
use ymirc::syntax::expression::literal; // VarExpr

use std::{stream, fs::path};


/**
 * Syntaxic representation of a path expression.
 *
 */
@final
pub class PathExpr over OperatorExpr {

    /*! Public fields */
    pub {
        // The left operand, EMPTY_EXPR iif this is a root path
        let left: &Expression;

        // The right operand
        let right: &Expression;

        // True iif the path starts at the root of the package ('::right'), in that case there is no left operand
        let isRoot: bool = false;
    }

    /**
     * @params:
     *    - loc: the location and operator of the expression
     *    - left: the left operand of the binary expression
     *    - right: the right operand of the binary expression
     *    - isRoot: true iif the path starts at the root of the package
     */
    pub self (loc: &Word, left: &Expression, right: &Expression, isRoot: bool = false)
        with super (loc)
        , left = left
        , right = right
        , isRoot = isRoot
    {}

    /**
     * @returns: a std path
     */
    pub fn toStdPath(self)-> Path {
        let mut res = Path("");
        if (self.isRoot) { // '::right', there is no left part in the path
            return res.push(self.right.loc.str);
        }

        match self.left {
            p: &PathExpr => {
                res = res.push(p.toStdPath());
            }
            v: &VarExpr => {
                res = res.push(v.name.str);
            }
            _ => {
                res = res.push(self.left.loc.str);
            }
        }

        match self.right {
            p: &PathExpr => {
                res = res.push(p.toStdPath());
            }
            v: &VarExpr => {
                res = res.push(v.name.str);
            }
            _ => {
                res = res.push(self.right.loc.str);
            }
        }

        res
    }

    /**
     * @returns: the location of the different component of the path
     * */
    pub fn getLocs(self)-> [&Word] {
        if (self.isRoot) { // '::right', the left part has no location
            return copy [self.right.loc];
        }

        let l = match self.left {
            p: &PathExpr => {
                p.getLocs()
            }
            _ => {
                copy [self.left.loc]
            }
        };

        let r = match self.right {
            p: &PathExpr => {
                p.getLocs()
            }
            _ => {
                copy [self.right.loc]
            }
        };

        l ~ r
    }

    /**
     * @returns: the location of the file part of the path
     * */
    pub fn getFileLoc(self)-> &Word {
        match self.right {
            p: &PathExpr => {
                p.getFileLoc()
            }
            _ => { self.right.loc }
        }
    }

    impl Comparable!{&Expression};
    impl Streamable;
    impl Formattable {
        pub over format(self, dmut stream: &Formatter) {
            if (!self.isRoot) {
                self.left.format(alias stream);
            }

            stream:.write(Tokens::DCOLON);
            self.right.format(alias stream);
        }
    }

}
