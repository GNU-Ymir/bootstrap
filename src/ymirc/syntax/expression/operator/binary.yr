in binary;

use std::stream;

use ymirc::lexing::{word, tokens, keys};
use ymirc::utils::{format, comparison};


/**
 * Transform the string into a binary operator
 * @warning: panic if does not exists
 * */
fn toOp(str: [c8])-> BinaryOperators {
    for o in BinaryOperators::__members__ {
        if o == str {
            return o;
        }
    }

    std::io::eprintln("internal syntax error: invalid binary operator, ", str);
    panic;
}

/**
 * @returns: the precedence level of a binary operator, its index in
 * `BinaryOperatorsLevels` -- the higher, the tighter it binds
 * @info: the operators absent from that table('.', '?.', '::') are read at the
 * operand level, which binds tighter than any of the levels in it
 * */
fn levelOf(op: BinaryOperators)-> u32 {
    for i, level in BinaryOperatorsLevels::__members__ {
        for o in level {
            if o == op {
                return cast!{u32} (i);
            }
        }
    }

    cast!{u32} (BinaryOperatorsLevels::__members__.len)
}

/**
 * Write an operand of a binary operation, parenthesized when its own operator binds
 * less tightly than the operation containing it -- source parentheses are not kept as
 * a node, so `a * (b % c)` would otherwise print as `a * b % c`, which reads back as a
 * different tree.
 * @params:
 *    - level:   the precedence level of the operation containing the operand
 *    - isRight: true if the operand is on the right of that operation
 * @info: the parser is left associative(cf. ExpressionVisitor::readExpressionComplex),
 * so an operand of *equal* precedence only needs parentheses on the right: `a - b - c`
 * is `(a - b) - c`, and printing `a - (b - c)` unparenthesized would flip it
 * */
fn formatOperand(dmut stream: &Formatter, operand: &Expression, level: u32, isRight: bool) {
    let mut parenthesized = false;
    if let inner: &BinaryExpr = operand {
        let innerLevel = levelOf(inner.op);
        parenthesized = innerLevel < level || (innerLevel == level && isRight);
    }

    if parenthesized stream:.write(Tokens::LPAR);
    operand.format(alias stream);
    if parenthesized stream:.write(Tokens::RPAR);
}

/**
 * Syntaxic representation of a binary expression
 *
 */
@final
pub class BinaryExpr over OperatorExpr {

    /*! Public fields */
    pub {
        // The operator
        let op: BinaryOperators;

        // The left operand
        let left: &Expression;

        // The right operand
        let right: &Expression;
    }

    /**
     * @params:
     *    - op:    the location and operator of the expression
     *    - left:  the left operand of the binary expression
     *    - right: the right operand of the binary expression
     */
    pub self (op: &Word, left: &Expression, right: &Expression)
        with super (op)
        , op = toOp(op.str)
        , left = left
        , right = right
    {}

    impl Comparable!{&Expression};
    impl Streamable;
    impl Formattable {

        pub over format(self, dmut stream: &Formatter) {
            let level = levelOf(self.op);

            formatOperand(alias stream, self.left, level, isRight-> false);
            match self.op {
                BinaryOperators::DOT | BinaryOperators::DOT_AND | BinaryOperators::DCOLON =>
                    stream:.write(self.op);
                _ =>
                    stream:.write(' ', self.op, ' ');
            }

            formatOperand(alias stream, self.right, level, isRight-> true);
        }
    }
}
