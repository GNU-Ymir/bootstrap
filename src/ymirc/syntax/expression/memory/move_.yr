in move_;


use std::stream;

use ymirc::lexing::{keys, tokens, word};
use ymirc::utils::{format, comparison};

/**
 * A move expression applying an move of a value
 *
 * The move names the constructor that resets the moved value, and the
 * arguments to call it with. An empty rename selects the unnamed ctor.
 */
@final
pub class MoveExpr over MemoryExpr {

    pub {
        // The name of the reset ctor, EOF if the ctor is unnamed
        let rename: &Word;

        // The arguments passed to the reset ctor
        let params: [&Expression];
    }

    /**
     * @params:
     *    - loc:     the location of the move operator
     *    - content: the value being moved
     *    - rename:  the name of the reset ctor
     *    - params:  the arguments of the reset ctor
     * */
    pub self (loc: &Word, content: &Expression, rename: &Word = EOF_WORD, params: [&Expression] = [])
        with super (loc, content)
        , rename = rename
        , params = params
    {}

    impl Comparable!{&Expression};
    impl Streamable;
    impl Formattable {
        pub over format(self, dmut stream: &Formatter) {
            stream:.write(Keys::MOVE);

            if !self.rename.isEof {
                stream:.write(Tokens::DCOLON, self.rename.str);
            }

            if !self.rename.isEof || self.params.len != 0us {
                stream:.write(Tokens::LPAR);
                stream:.entabing();
                for i, p in self.params {
                    if (i != 0us) stream:.write(", ");
                    p.format(alias stream);
                }
                stream:.detabing();
                stream:.write(Tokens::RPAR);
            }

            stream:.write(' ');
            stream:.entabing();
            self.content.format(alias stream);
            stream:.detabing();
        }
    }


}
