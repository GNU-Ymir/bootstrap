/*
 * Parser — main driver of the Ymir compiler frontend.
 * The Parser orchestrates the entire compilation pipeline:
 *
 *   1. Syntax step:
 *        - lexing and parsing of the root module,
 *        - construction of the syntax tree(Declaration nodes).
 *
 *   2. Validation step:
 *        - symbol declaration,
 *        - type validation,
 *        - semantic checks,
 *        - generator construction.
 *
 *   3. Expansion step:
 *        - lowering of semantic generators into YIL nodes,
 *        - operator desugaring,
 *        - control-flow normalization,
 *        - destructor scheduling,
 *        - type finalization,
 *        - optional YIL export.
 *
 * The Parser also handles:
 *
 *   - command-line arguments,
 *   - version flags,
 *   - include directories,
 *   - debug/dump modes,
 *   - external package loading,
 *   - dependency graph generation.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::parser
 * @File: ymirc/parser.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2021-11-12
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in parser;

use ymirc::{errors, utils::_};
use ymirc::doc::visitor;
use ymirc::lexing::{lexer, word};
use ymirc::lint::{expander, node::_, optimizer, serialize};
use ymirc::semantic::{declarator, generator, symbol, validator};
use ymirc::syntax::{_, declaration::_, expression::_};

use std::{conv, env, fs::_, io};


/**
 * Parser
 *
 * Main entry point of the Ymir compiler frontend. Coordinates:
 *
 *   - syntax parsing,
 *   - semantic validation,
 *   - YIL expansion,
 *   - optional YIL export,
 *   - optional documentation generation,
 *   - optional dependency graph generation.
 *
 * Stores:
 *   - syntax tree,
 *   - semantic generators,
 *   - expanded YIL nodes,
 *   - expanded YIL types.
 */
@final
pub class Parser {

    // Options passed to the parser
    let _args: YmirArguments;

    // The syntaxic node read during syntax step
    let mut _syntNode: &Declaration = EMPTY_BLOCK_DECL;

    // The list of generators created during validation
    let mut _semGenerators: [&Generator] = [];

    // The list of generator created after expansion / finalization, before optimization
    let mut _expNodes: [&YILNode] = [];

    // The list of generator created after optimization (identical to _expNodes at -O0)
    let mut _optNodes: [&YILNode] = [];

    // The list of complex types created during expansion
    let mut _expTypes: [&YILType] = [];

    // The root module symbol produced during validationStep()
    let mut _modSym: &Symbol = symbol::EMPTY_SYMBOL;

    /**
     * Construct a parser with the given command‑line arguments.
     *
     * Initializes:
     *   - version flags,
     *   - include directories,
     *   - debug/dump modes.
     */
    pub self (args: YmirArguments)
        with _args = args
    {
        if (args.fdump) {
            global::state::activateYmirDumping();
        }

        for i in args.fversion {
            global::state::addVersion(i.(std::conv::to)![c8] ());
        }

        for d in args.includes {
            global::state::addIncludeDir(d.(std::conv::to)![c8] ());
        }

        if (args.debug) {
            global::state::activateDebug();
        }

        global::state::setOptLevel(args.optLevel);

        if (args.fdumpYilOpt) {
            global::state::activateYilOptDumping();
        }

        if (args.fdumpYilOptEach) {
            global::state::activateYilOptDumpingEach();
        }

        if (args.foptStats) {
            global::state::activateOptStats();
        }

        if (args.fverifyYil) {
            global::state::activateYilVerify();
        }

        for p in args.enabledPasses {
            global::state::forceEnablePass(p.(std::conv::to)![c8] ());
        }

        for p in args.disabledPasses {
            global::state::forceDisablePass(p.(std::conv::to)![c8] ());
        }

        for f in args.fdumpCfg {
            global::state::activateCfgDumping(f.(std::conv::to)![c8] ());
        }

        for f in args.fdumpDataflow {
            global::state::activateDataflowDumping(f.(std::conv::to)![c8] ());
        }
    }

    /*!
     * ============================================================================
     * ============================================================================
     * =========================          GETTERS        ==========================
     * ============================================================================
     * ============================================================================
     */

    /**
     * @returns:
     *   - the root syntax node produced by syntaxStep().
     */
    pub fn getSyntaxModule(self)-> &Declaration {
        self._syntNode
    }

    /**
     * @returns:
     *   - the list of semantic generators produced by validationStep().
     */
    pub fn getSemGenerators(self)-> [&Generator] {
        self._semGenerators
    }

    /**
     * @returns:
     *   - the list of expanded YIL nodes produced by expansionStep(), as the
     *     Expander built them, before any optimization pass ran.
     *
     * This is the raw expander output whatever the optimization level, so a
     * golden written against it stays valid at every `-O`.
     */
    pub fn getExpYILNodes(self)-> [&YILNode] {
        self._expNodes
    }

    /**
     * @returns:
     *   - the list of YIL nodes produced by expansionStep() after the
     *     optimization passes ran.
     *
     * This is what is dumped, exported and handed to the backend. At `-O0` no
     * pass runs, so it is exactly getExpYILNodes().
     */
    pub fn getOptYILNodes(self)-> [&YILNode] {
        self._optNodes
    }

    /**
     * @returns:
     *   - the list of YIL types produced during expansion.
     */
    pub fn getExpYILTypes(self)-> [&YILType] {
        self._expTypes
    }

    /**
     * @returns:
     *   - the root module symbol produced by validationStep(), or EMPTY_SYMBOL
     *     if semantic validation was skipped(`-fno-sem`).
     */
    pub fn getModuleSymbol(self)-> &Symbol {
        self._modSym
    }

    /*!
     * ============================================================================
     * ============================================================================
     * =========================          PARSING        ==========================
     * ============================================================================
     * ============================================================================
     */

    /**
     * Parse the root file and its package.
     *
     * Behavior:
     *   - resolves absolute path,
     *   - sets package and root module in global state,
     *   - calls parsePackage().
     *
     * Throws:
     *   - ErrorMsg on syntax or validation errors.
     */
    pub fn parseAll(mut self)
        throws ErrorMsg
    {
        let mut path = Path(self._args.file);
        let mut package = path.parent();
        if (!path.isAbsolute()) {
            path = env::currentDir().push(path);
            package = path.parent();
        }

        global::state::setPackage(package);
        global::state::setRootModule(path);
        self:.parsePackage(path);
    }

    /**
     * Parse a package starting from the given file.
     *
     * Pipeline:
     *   - syntaxStep(),
     *   - validationStep(),
     *   - expansionStep().
     *
     * Stores:
     *   - syntax tree,
     *   - semantic generators,
     *   - expanded YIL nodes(pre and post optimization),
     *   - expanded YIL types.
     */
    fn parsePackage(mut self, file: Path)
        throws ErrorMsg
    {
        logging::info("Compile package %", file.toStr());
        let s1 = self:.syntaxStep(file);
        self._syntNode = s1;

        let (modules, s2, modSym) = self:.validationStep(file, s1);
        self._semGenerators = s2;
        self._modSym = modSym;

        let (s3, s4, s5) = self:.expansionStep(file, modules, s2);
        self._expNodes = s3;
        self._optNodes = s4;
        self._expTypes = s5;
    }

    /*!
     * ============================================================================
     * ============================================================================
     * =========================          SYNTAX        ===========================
     * ============================================================================
     * ============================================================================
     */

    /**
     * Parse the root module file into a ModuleDecl.
     *
     * Uses SyntaxVisitor to perform lexing and parsing.
     *
     * Throws:
     *   - NO_SUCH_FILE,
     *   - syntax errors.
     */
    fn syntaxStep(mut self, file: Path)-> &ModuleDecl
        throws ErrorMsg
    {
        (copy SyntaxVisitor(file)):.read()
    } catch {
        err: &ErrorMsg => throw err;
        _: &FsError => {
            throw copy ErrorMsg::fatal(EOF_WORD, format(DeclareErrorMessage::NO_SUCH_FILE, file.toStr()), oneLine-> true);
        }
    }

    /*!
     * ============================================================================
     * ============================================================================
     * =======================          VALIDATION        =========================
     * ============================================================================
     * ============================================================================
     */

    /**
     * Validate a module:
     *
     *   - declare symbols,
     *   - validate types,
     *   - perform semantic checks,
     *   - generate semantic generators,
     *   - detect missing generators,
     *   - optionally dump declarations and semantic trees,
     *   - optionally dump documentation.
     *
     * Returns:
     *   - (.0) list of compiled modules,
     *   - (.1) list of semantic generators,
     *   - (.2) the root module symbol.
     *
     * Throws:
     *   - ErrorMsg on validation errors.
     */
    fn validationStep(mut self, file: Path, modSynt: &ModuleDecl)-> ([Path], [&Generator], &Symbol)
        throws ErrorMsg
    {
        if (self._args.noSem) return ([], [], symbol::EMPTY_SYMBOL);

        let dmut declarator = copy Declarator(packageDir-> file.parent());
        self:.importExternPackages(alias declarator);

        let dmut modSym = declarator:.declareGlobal(modSynt, global::state::package());
        if (global::state::isYmirDumpingActive()) {
            {
                let dmut f = File::create(file.addExtension("ydump-decls.1"), write-> true);
                let dmut formatter = copy Formatter();
                modSym.formatSymTree(alias formatter);
                f:.write(formatter[]);
            } catch {
                err: &FsError => println( err );
            }
        }

        let dmut valid = copy ValidationContext(alias declarator);
        SymbolValidation::validate(alias valid, alias modSym);

        if (global::state::isYmirDumpingActive()) {
            {
                {
                    let dmut f = File::create(file.addExtension("ydump-decls.2"), write-> true);
                    let dmut formatter = copy Formatter();
                    modSym.formatSymTree(alias formatter);
                    f:.write(formatter[]);
                }
                {
                    let dmut f = File::create(file.addExtension("ydump-sem"), write-> true);
                    for i in valid.getGenerators() {
                        f:.write(format("%\n", i, tags-> FormatTags(withVarIds-> true)));
                    }
                }
            } catch {
                err: &FsError => println( err );
            }
        }

        // Validation succeeded to generate symbols, but some were failing for aside reasons
        if (valid.getMissingGenerators().len != 0us) {
            throw copy ErrorMsg::list(valid.getMissingGenerators());
        }

        if (global::state::isDocDumpingActive()) {
            {
                let dmut f = File::create(global::state::docDumpFile(), write-> true);
                let dmut docVisitor = DocVisitor(packageDir-> global::state::package());
                let js = docVisitor.dump(modSym);
                f:.write(std::config::json::dump(js));
            } catch {
                err: &FsError => { println(err); }
            }
        }

        return (valid.getCompiledModules(), valid.getGenerators(), modSym);
    }

    /**
     * Import all external packages specified via:
     *   - core package(unless standalone),
     *   - include directories.
     *
     * Behavior:
     *   - loads extern modules,
     *   - declares extern symbols,
     *   - finalizes extern declarations,
     *   - aggregates errors.
     *
     * Throws:
     *   - list of ErrorMsg.
     */
    fn importExternPackages(mut self, dmut declarator: &Declarator)
        throws ErrorMsg
    {
        let mut errors: [&ErrorMsg] = [];
        if (!global::state::isStandalone()) {
            {
                self:.importExternPackage(alias declarator, global::state::corePath());
                declarator:.computeCoreUseDecls();
            } catch {
                err: &ErrorMsg => { errors ~= [err]; }
            }
        }

        for dir in global::state::includeDirs() {
            {
                self:.importExternPackage(alias declarator, dir);
            } catch {
                err: &ErrorMsg => { errors ~= [err]; }
            }
        }

        {
            declarator:.finalizeExternDeclaration();
        } catch {
            err: &ErrorMsg => { errors ~= [err]; }
        }

        if (errors.len != 0us) {
            throw copy ErrorMsg::list(errors);
        }
    }

    /**
     * Import a single external package.
     *
     * Behavior:
     *   - resolves __lib__.yr for directories,
     *   - parses the module,
     *   - declares extern symbols.
     *
     * Throws:
     *   - IMPORT_EXTERN_PACKAGE.
     */
    fn importExternPackage(mut self, dmut declarator: &Declarator, path: Path)
        throws ErrorMsg
    {
        let (file, pack) = if (fs::sys::isDir(path)) {
            (path.push("__lib__.yr"), path)
        } else {
            (path, path.parent())
        };

        logging::info("Loading external package %", file.toStr());
        {
            let modSynt = (copy SyntaxVisitor(file)):.read();
            declarator:.declareExtern(modSynt, pack);
        } catch {
            err: &ErrorMsg => {
                throw copy ErrorMsg::fatal(EOF_WORD, format(DeclareErrorMessage::IMPORT_EXTERN_PACKAGE, path.toStr()), oneLine-> true, notes-> copy [err]);
            }
            _: &FsError => {
                throw copy ErrorMsg::fatal(EOF_WORD, format(DeclareErrorMessage::IMPORT_EXTERN_PACKAGE, path.toStr()), oneLine-> true,
                                           notes-> copy [copy ErrorMsg::fatal(EOF_WORD, format(DeclareErrorMessage::NO_SUCH_FILE, file.toStr()), oneLine-> true)]);
            }
        }
    }

    /*!
     * ============================================================================
     * ============================================================================
     * =======================          GENERATION        =========================
     * ============================================================================
     * ============================================================================
     */

    /**
     * Expand semantic generators into YIL nodes.
     *
     * Behavior:
     *   - constructs an Expander,
     *   - finalizes all generators,
     *   - retrieves all generated types,
     *   - optionally dumps YIL,
     *   - optionally exports YIL bytecode,
     *   - optionally dumps module dependencies.
     *
     * Returns:
     *   - (.0) list of YIL symbols as expanded, before optimization,
     *   - (.1) list of YIL symbols after optimization(identical to (.0) at -O0),
     *   - (.2) list of YIL types.
     */
    fn expansionStep(mut self, file: Path, compiled: [Path], gens: [&Generator])-> ([&YILNode], [&YILNode], [&YILType])
        throws ErrorMsg
    {
        if (self._args.noLint) return ([], [], []);

        let dmut exp = copy Expander();
        let expanded = exp:.finalize(gens);
        let types = exp.getTypes();

        // Optimization runs before the dump and the export, so that the YIL
        // written to disk and handed to the backend is the optimized YIL. At
        // -O0 the optimizer runs no pass and returns `expanded` untouched.
        let dmut opt = copy Optimizer(level-> global::state::optLevel());
        {
            let dmut copyProp = copy CopyPropagationPass();
            opt:.addPass(alias copyProp);
        }

        {
            // copy propagation leaves the copies it renamed the reads of behind,
            // and the temporaries it coalesced without a reader: what makes
            // those disappear is the dead code, and what the dead code removes
            // are the blocks the folded jumps stopped reaching
            let dmut dce = copy DeadCodePass();
            opt:.addPass(alias dce);
        }

        let finals = opt:.optimize(expanded, dumpPath-> file);

        if (global::state::isYmirDumpingActive()) {
            {
                use std::algorithm::sorting;
                let dmut f = File::create(file.addExtension("ydump-yil"), write-> true);
                for t in sort(copy types, |a, b| => { a.uid < b.uid }) {
                    f:.write(format("%;\n", t, tags-> FormatTags(withParams-> true)));
                }

                for fi in finals {
                    f:.write(format("%\n", fi, tags-> FormatTags(withVarIds-> true)));
                }
            } catch {
                err: &FsError => println(err);
            }
        }

        if (global::state::isExportYIL()) {
            let mut yilExp = YILExporter(packageDir-> file.parent());
            yilExp:.registerTypes(types);
            yilExp:.registerSymbols(finals);
            yilExp:.writeFiles(compiled);
        }

        if (global::state::isDumpDependenciesActive()) {
            self.writeModuleDependencies(file, compiled, finals);
        }

        (expanded, finals, types)
    }

    /**
     * Write dependency files for each module.
     *
     * Produces:
     *   - <module>.deps: list of dependent modules,
     *   - <module>.syms: list of symbols defined in the module.
     *
     * Behavior:
     *   - reconstructs dependency graph from symbol references,
     *   - groups symbols by module,
     *   - writes files into dependencyDumpDir().
     */
    pub fn writeModuleDependencies(self, file: Path, modules: [Path], nodes: [&YILSymbol]) {
        logging::info("Export module dependencies");

        let mut symbols: [[c8] => mut(bool, &YILSymbol)] = copy [];
        let dmut exportSymbols: [Path => [[c8] => ()]] = copy [];
        let dmut exportDeps: [Path => [Path => ()]] = copy [];

        let packageDir = file.parent();

        for sym in nodes {
            symbols[sym.name] = (sym.isWeak, sym);
        }

        for sym in nodes {
            let loc = sym.path;
            let where = loc.removePrefix(packageDir).stripExtension();
            let dmut symTable = if let Ok(dmut table) = alias exportSymbols[where] {
                alias table
            } else {
                copy []
            };

            let dmut depTable = if let Ok(dmut table) = alias exportDeps[where] {
                alias table
            } else {
                copy []
            };

            self.addSymbol(sym, packageDir, symbols, alias symTable, alias depTable);
            exportSymbols[where] = alias symTable;
            exportDeps[where] = alias depTable;
        }

        let root = global::state::dependencyDumpDir();
        if (!fs::sys::isDir(root)) {
            {
                fs::sys::createDir(root);
            } catch {
                err => {
                    logging::failure("Failed to write dependency file\n\t => ", err);
                    return;
                }
            }
        }

        for m in modules {
            if let (Ok(symTable), Ok(depTable)) = (exportSymbols[m], exportDeps[m]) {
                self.produceDependencyFile(root, m, symTable, depTable);
            }
        }
    }

    /**
     * Add a symbol to the dependency graph.
     *
     * Behavior:
     *   - avoids duplicates,
     *   - records symbol name,
     *   - records module dependencies,
     *   - recursively includes weak dependencies.
     */
    fn addSymbol(self, sym: &YILSymbol, packageDir: Path, allSyms: [[c8] => (bool, &YILSymbol)], dmut syms: [[c8] => ()], dmut deps: [Path => ()]) {
        if sym.name in syms {
            return;
        }

        syms[sym.name] = ();
        for s, loc in sym.references {
            deps[loc] = ();

            if let Ok(touch) = allSyms[s] {
                if touch._0 {
                    self.addSymbol(touch._1, packageDir, allSyms, alias syms, alias deps);
                }
            }
        }
    }

    /**
     * Write the .deps and .syms files for a module.
     *
     * Layout:
     *   - .deps: list of dependent modules,
     *   - .syms: list of symbol names.
     *
     * Overwrites existing files.
     */
    fn produceDependencyFile(self, root: Path, module: Path, symTable: [[c8] => ()], depTable: [Path => ()]) {
        {
            {
                let p = root.push(module.toStr(sep-> "_")).addExtension("deps");
                if (fs::sys::isFile(p)) {
                    fs::sys::removeFile(p);
                }

                let dmut f = File::create(p, write-> true);
                for z in depTable {
                    f:.write(z.addExtension("yr").toStr());
                    f:.write("\n");
                }
            }

            {
                let p = root.push(module.toStr(sep-> "_")).addExtension("syms");
                if (fs::sys::isFile(p)) {
                    fs::sys::removeFile(p);
                }

                let dmut f = File::create(p, write-> true);
                for z in symTable {
                    f:.write(z);
                    f:.write("\n");
                }
            }
        } catch {
            err => {
                logging::failure("Failed to write dependency file\n\t => ", err);
                return;
            }
        }
    }
}
