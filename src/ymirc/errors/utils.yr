in utils;


use std::algorithm::sorting;
use ymirc::errors::message;

/**
 * Flatten a list of diagnostic nodes.
 *
 * This function recursively expands all `ErrorMsg::list` nodes inside `notes`,
 * producing a flat list of ErrorMsg objects. Non-list errors are preserved as
 * they are. Empty one-line errors are ignored.
 *
 * Deduplication is performed using the stable error ID assigned by the
 * compiler. This ensures that the same diagnostic is never emitted twice, even
 * if it appears multiple times in the tree.
 *
 * If `sort` is true, the resulting list is sorted by source location:
 *   - primary key:   begin line,
 *   - secondary key: end line (EOF locations are placed last).
 *
 * If `sort` is false, the original order is preserved.
 *
 * @params:
 *   - notes: the list of ErrorMsg nodes to flatten.
 *   - sort:  if true, sort the flattened list by location.
 *
 * @returns:
 *   - a flat, deduplicated list of ErrorMsg nodes.
 *
 * @example:
 *   Given:
 *     A -> [ B, list([C, D]), E ]
 *
 *   flatten([A], false) returns:
 *     [A, B, C, D, E]
 *
 *   flatten([A], true) returns the same list, sorted by location.
 */
pub fn flatten(notes: [&ErrorMsg], sort: bool)-> [&ErrorMsg] {
    let mut res: [mut &ErrorMsg] = [];
    let mut already: [usize => mut()] = copy [];
    for i in notes {
        if (i.isList) {
            let d = flatten(i.notes, sort-> true);
            for j in d if j.id !in already {
                res ~= [j];
                already[j.id] = ();
            }
        } else if !i.isEmpty && i.id !in already {
            res ~= [i];
            already[i.id] = ();
        }
    }

    if sort {
        return sorting::sort(alias res, |x, y| => {
            if (x.loc.line < y.loc.line) return true;
            if (x.loc.line == y.loc.line) {
                if x.endLoc.isEof { return false; }
                if y.endLoc.isEof { return true; }
                return x.endLoc.line < y.endLoc.line;
            }

            return false;
        });
    }

    return res;
}
