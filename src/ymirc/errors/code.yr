/*
 * Declares the Error record, pairing a diagnostic message with the stable code
 * identifying it.
 *
 * A diagnostic is named twice: by the catalogue entry it is written as
 * (`ValidateErrorMessage::CLASS_NO_METHOD`), which is the anchor the compiler
 * source uses, and by a code (`E4132`), which is the anchor the user, a bug
 * report and the documentation use. The two are written on the same line of the
 * catalogue so a rewording can never desynchronize them.
 *
 * A code is allocated once and never reused, never renumbered. A deleted
 * message retires its code rather than freeing it. Codes are namespaced by the
 * pipeline stage that raises them, so the code alone says where the check lives:
 *
 *   ```text
 *   E1xxx  lexing          (LexingErrorMessage)
 *   E2xxx  syntax          (SyntaxErrorMessage)
 *   E3xxx  declaration     (DeclareErrorMessage)
 *   E4xxx  validation      (ValidateErrorMessage)
 *   E5xxx  lowering / YIL  (SerializeYILErrorMessage)
 *   ```
 *
 * `NO_CODE` is the code of a message that is never a diagnostic of its own: a
 * context note ("when validating %(y)"), a rewriting hint, a candidate list
 * entry. Those hang under a coded diagnostic and are not worth documenting
 * separately, so they are deliberately left uncoded rather than given a code
 * nothing would ever look up.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::errors::code
 * @File: ymirc/errors/code.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-09-05
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in code;

use std::conv;

/**
 * The code of a message carrying no code of its own.
 */
pub def NO_CODE = 0;

/**
 * @returns:
 *   a code as it is written in a diagnostic ("E4132"), empty for `NO_CODE`.
 */
pub fn codeStr(code: i32)-> [c8] {
    if (code == NO_CODE) return "";

    "E" ~ code.to!{[c8]} ()
}

/**
 * Error - a diagnostic message and the stable code identifying it.
 *
 * This is the value type of every message catalogue enumeration
 * (`LexingErrorMessage`, `SyntaxErrorMessage`, `DeclareErrorMessage`,
 * `ValidateErrorMessage`, `SerializeYILErrorMessage`).
 *
 * The `msg` field is a format string, not a rendered message: it still holds
 * the `%`, `%(y)` and `@(y=)` directives `utils::format` substitutes. Applying
 * that formatting returns another Error, carrying the same code, so a code
 * survives from the catalogue to the rendered diagnostic without any throw site
 * having to name it.
 */
pub record Error {

    // The stable code of the diagnostic, NO_CODE for a context note
    pub let code: i32;

    // The message, as a format string
    pub let msg: [c8];

    /**
     * @params:
     *   - code: the stable code of the diagnostic, NO_CODE if it has none,
     *   - msg:  the message format string.
     */
    pub self (code: i32, msg: [c8])
        with code = code
        , msg = msg
    {}

    /**
     * @returns: true iif the message carries a code.
     */
    pub fn hasCode(self)-> bool {
        self.code != NO_CODE
    }

    /**
     * @returns:
     *   the code as it is written in a diagnostic ("E4132"), empty if the
     *   message carries no code.
     */
    pub fn codeStr(self)-> [c8] {
        codeStr (self.code)
    }
}
