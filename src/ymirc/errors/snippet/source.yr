in source;

use ymirc::utils::_;

use ymirc::errors::snippet::{label, piece};

/**
 * The minimum width of the line number cell.
 */
pub def GUTTER = 3us;

/**
 * One line of an excerpt, cut into the runs its labels split it into.
 *
 * `gaps` holds one entry more than `labels`: `gaps[i]` is what is printed
 * before `labels[i]`, and the last one what follows the last label. Reading
 * them alternately gives the line back.
 *
 * `gutter` is the line number cell and `padd` a blank of the same width, the
 * two cells every row of the excerpt starts with.
 */
pub record SourceLine {
    pub let gaps: [Piece];
    pub let labels: [Label];
    pub let gutter: [c8];
    pub let padd: [c8];

    // True iif the source line carries its own line return
    pub let trailingNewline: bool;

    // True iif the lines standing between this one and the one above were
    // dropped, the renderer writing an "..." separator in their place
    pub let elided: bool;

    // Where the line sits in the region a span crossing lines covers
    pub let margin: MarginKind;

    pub self (num: u64, gaps: [Piece], labels: [Label], trailingNewline: bool, width: usize,
              elided: bool = false, margin: MarginKind = MarginKind::NONE)
        with gaps = gaps
        , labels = labels
        , gutter = center(format("%", num), width)
        , padd = center("", width)
        , trailingNewline = trailingNewline
        , elided = elided
        , margin = margin
    {}
}

/**
 * One source excerpt: the file it comes from, the coordinates its header
 * cites, and the lines to show.
 *
 * There is one per file a diagnostic points into, and every line it shows —
 * labelled or context — is written under the same `width` wide gutter, so a
 * column of the excerpt is a column of the file. The coordinates are the ones
 * of the *primary* label, which is what the diagnostic is reported at,
 * wherever that sits among the lines shown.
 */
pub record Snippet {
    pub let file: [c8];
    pub let line: u64;
    pub let col: u64;
    pub let lines: [SourceLine];

    // The width of the line number cell shared by every line of the excerpt
    pub let width: usize;

    // True iif one of the lines is covered by a span crossing lines, every row
    // of the excerpt then starting with the margin column that region is drawn in
    pub let withMargin: bool;

    pub self (file: [c8], line: u64, col: u64, lines: [SourceLine], width: usize = GUTTER)
        with file = file
        , line = line
        , col = col
        , lines = lines
        , width = width
        , withMargin = anyMargin(lines)
    {}
}

/**
 * @returns: true iif one of the lines is reached by a region.
 */
fn anyMargin(lines: [SourceLine])-> bool {
    for l in lines {
        if (l.margin != MarginKind::NONE) return true;
    }

    false
}

/**
 * @returns:
 *   the width of the line number cell the excerpts share, GUTTER when there is
 *   none. This is what the report indents its sub notes by, so that they line
 *   up with the excerpt they hang under.
 */
pub fn gutterOf(snippets: [Snippet])-> usize {
    let mut res = GUTTER;
    for s in snippets {
        if (s.width > res) res = s.width;
    }

    res
}

/**
 * @returns: the width of the line number cell an excerpt reaching `max` needs.
 */
pub fn gutterWidth(max: u64)-> usize {
    let str = format("%", max);
    if (str.len > GUTTER) return str.len;

    GUTTER
}
