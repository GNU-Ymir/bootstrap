in diagnostic;

use ymirc::errors::snippet::{label, source, suggestion};

/**
 * The header of a diagnostic: what it is, and what it says.
 */
pub record Header {
    pub let severity: Severity;

    // The stable code of the diagnostic, NO_CODE when it carries none
    pub let code: i32;

    pub let msg: [c8];

    // The per run deduplication key, printed under --with-error-ids
    pub let id: usize;

    // True iif the severity is written before the message
    pub let withSeverity: bool;

    pub self (severity: Severity, code: i32, msg: [c8], id: usize, withSeverity: bool)
        with severity = severity
        , code = code
        , msg = msg
        , id = id
        , withSeverity = withSeverity
    {}
}

/**
 * One frame of the context trace of a report.
 *
 * A frame says what was being validated, not what went wrong, so it carries no
 * severity: the report it belongs to is the diagnostic, the frames are the
 * path that reached it. It cites its location inline rather than showing it —
 * a chain of them would otherwise drag one excerpt per enclosing symbol into a
 * report about a single line.
 */
pub record TraceFrame {
    pub let text: [c8];
    pub let loc: (InlineLoc)?;

    pub self (text: [c8], loc: (InlineLoc)? = none)
        with text = text
        , loc = loc
    {}
}

/**
 * One report, as it is going to be printed: what went wrong, where, what is
 * worth adding, and how the compiler got there.
 *
 * Either it shows its source excerpts, or it is a one-line node citing its
 * location inline — never both, so at most one of `snippets` and `inlineLoc`
 * is filled.
 *
 * There is no sub report: a diagnostic tree is flattened into a flat list of
 * these before anything is written (`ErrorMsg::reports`), every place it names
 * having become a label of an excerpt, a trailing note, or a frame of the
 * trace. Nothing recurses at print time, so no source line is ever written
 * twice.
 */
pub record Diagnostic {
    pub let header: Header;
    pub let snippets: [Snippet];
    pub let inlineLoc: (InlineLoc)?;

    // What the report adds and cannot point at, in the order it was declared in
    pub let notes: [LabelMsg];

    // The edits it proposes, each already applied to the line it edits
    pub let fixes: [Fix];

    // What was being validated when it was raised, innermost frame first
    pub let trace: [TraceFrame];

    pub self (header: Header,
              snippets: [Snippet] = [],
              inlineLoc: (InlineLoc)? = none,
              notes: [LabelMsg] = [],
              fixes: [Fix] = [],
              trace: [TraceFrame] = [])
        with header = header
        , snippets = snippets
        , inlineLoc = inlineLoc
        , notes = notes
        , fixes = fixes
        , trace = trace
    {}
}
