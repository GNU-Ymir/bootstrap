 */

in utils;

use ymirc::lexing::word;

/**
 * @returns: true iif there is something to show of the given location.
 */
pub fn isShowable(loc: &Word)-> bool {
    if (loc.isEof) return false;

    getLineAtLoc(loc).len != 0us
}

/**
 * Extract the full line of source text containing the given Word.
 *
 * Behavior:
 *   - returns the slice starting at loc.lineSeek up to the next '\n',
 *   - includes the trailing '\n' if present,
 *   - returns an empty string if fileContent is empty or lineSeek is out of range.
 *
 * No file I/O is performed; the Word must contain fileContent.
 *
 * @returns:
 *   - [c8]: the line slice.
 */
pub fn getLineAtLoc(loc: &Word)-> [c8] {
    if (loc.lineSeek >= loc.fileContent.len) return "";

    let res = loc.fileContent[loc.lineSeek .. $];
    let mut max = 0;
    for i in res {
        if (i == '\n') return res[0 .. max + 1];
        else
            max += 1;
    }

    return res;
}

/**
 * @returns: true iif the text of `loc` crosses a line.
 */
pub fn isMultiLine(loc: &Word)-> bool {
    for i in loc.str {
        if (i == '\n') return true;
    }

    false
}

/**
 * @returns: the location of the first byte of `loc`, `loc` itself when its
 *           text does not cross a line.
 */
pub fn spanOpen(loc: &Word)-> &Word {
    if (!isMultiLine(loc)) return loc;

    loc.locate(loc.str[0us .. 1us], loc.line, loc.col, loc.lineSeek)
}

/**
 * @returns: the location of the last byte of `loc`, `loc` itself when its text
 *           does not cross a line.
 */
pub fn spanClose(loc: &Word)-> &Word {
    if (!isMultiLine(loc)) return loc;

    let begin = loc.lineSeek + cast!usize(loc.col) - 1us;
    let mut line = loc.line;
    let mut col = loc.col;
    let mut seek = loc.lineSeek;

    for i in 0us .. loc.str.len - 1us {
        if (loc.str[i] == '\n') {
            line += 1u64;
            col = 1u64;
            seek = begin + i + 1us;
        } else {
            col += 1u64;
        }
    }

    loc.locate(loc.str[$ - 1us .. $], line, col, seek)
}

/**
 * The line of `content` following the one that starts at `seek`.
 *
 * @returns:
 *   - .0: where that line starts, the end of the content when there is none,
 *   - .1: its text, its own line return included, empty when there is none.
 */
pub fn lineAfter(content: [c8], seek: usize)-> (usize, [c8]) {
    let mut i = seek;
    while i < content.len && content[i] != '\n' {
        i += 1us;
    }

    if (i >= content.len) return (content.len, "");

    let start = i + 1us;
    let mut j = start;
    while j < content.len && content[j] != '\n' {
        j += 1us;
    }

    if (j < content.len) return (start, content[start .. j + 1us]);

    (start, content[start .. $])
}

/**
 * @returns: the line without the line return it carries, if it carries one.
 *
 * A pair of lines writes its own, so the source one would come out as a blank
 * row between the two halves of the edit.
 */
pub fn withoutNewline(line: [c8])-> [c8] {
    if (line.len != 0us && line[$ - 1us] == '\n') return line[0us .. $ - 1us];

    line
}
