 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in suggestion;

use ymirc::utils::_;
use ymirc::lexing::word;

use ymirc::errors::snippet::{label, utils};
use ymirc::errors::code;

/**
 * One splice of an edit: a span of the source, and the text standing in for it.
 *
 * The span is anchored on a word, so it is one of two things: the empty span
 * before that word, or the word itself. Nothing else is something the location
 * can vouch for, and a splice disagreeing with what the file holds is dropped
 * rather than applied, cf. `applyEdit`.
 */
pub record Splice {
    pub let loc: &Word;

    // The number of bytes of `loc` the replacement stands in for, 0 for an
    // insertion before it
    pub let len: usize;

    pub let replacement: [c8];

    pub self (loc: &Word, replacement: [c8], len: usize = 0us)
        with loc = loc
        , len = len
        , replacement = replacement
    {}
}

/**
 * The edit a diagnostic proposes, before it is laid out.
 *
 * An edit is an edit and not a sentence: its splices say where it applies and
 * what stands in for what, so what it proposes can be *applied* rather than
 * only read. That is what an LSP quick fix consumes, and it is what the
 * `-`/`+` pair is derived from: the rendering restates nothing, cf.
 * `applyEdit`.
 *
 */
pub record Edit {
    // Where the edit applies and what it writes there, in no particular order
    pub let splices: [Splice];

    // What the edit achieves, printed as the "help:" line above the pair
    pub let msg: [c8];

    pub self (loc: &Word, replacement: [c8], msg: [c8], len: usize = 0us)
        with splices = copy [Splice(loc, replacement-> replacement, len-> len)]
        , msg = msg
    {}

    /**
     * Build an edit from a catalogue message.
     *
     * A suggestion is not a failure of its own, so the code the entry may
     * carry is deliberately dropped: only the diagnostic the edit fixes is
     * codified. Same rule as ErrorMsg::note, and same reason — it lets a throw
     * site hand over the catalogue entry it was already formatting.
     */
    pub self (loc: &Word, replacement: [c8], msg: code::Error, len: usize = 0us)
        with splices = copy [Splice(loc, replacement-> replacement, len-> len)]
        , msg = msg.msg
    {}

    /**
     * The edit writing each of two words where the other one is.
     *
     */
    pub self (fst: &Word, snd: &Word, msg: [c8])
        with splices = copy [Splice(fst, replacement-> snd.str, len-> fst.len),
                             Splice(snd, replacement-> fst.str, len-> snd.len)]
        , msg = msg
    {}

    /// The same edit, from a catalogue message, cf. the single word ctor.
    pub self (fst: &Word, snd: &Word, msg: code::Error)
        with splices = copy [Splice(fst, replacement-> snd.str, len-> fst.len),
                             Splice(snd, replacement-> fst.str, len-> snd.len)]
        , msg = msg.msg
    {}
}

/**
 * A proposed edit, as the pair of lines it is printed as.
 *
 */
pub record Fix {
    pub let msg: [c8];

    // The line number cell, and a blank of the same width, shared with the
    // excerpts of the report so the pair reads under the same column
    pub let gutter: [c8];
    pub let padd: [c8];

    pub let before: [c8];
    pub let after: [c8];

    pub self (msg: [c8], num: u64, before: [c8], after: [c8], width: usize)
        with msg = msg
        , gutter = center(format("%", num), width)
        , padd = center("", width)
        , before = before
        , after = after
    {}
}

/**
 * How many pairs one report prints, the rest of what it proposes staying
 * prose.
 *
 */
pub def MAX_FIXES = 3us;

/**
 * Lay the edits a diagnostic proposes out into the pairs of lines they print
 * as.
 * 
 * @params:
 *   - edits: the edits, in the order they were proposed,
 *   - width: the width of the line number cell of the report.
 *
 * @returns:
 *   - .0: the pairs, in that same order, at most MAX_FIXES of them,
 *   - .1: what the edits that were not printed as a pair say.
 */
pub fn layoutFixes(edits: [Edit], width: usize)-> ([Fix], [LabelMsg]) {
    let mut fixes: [Fix] = [];
    let mut notes: [LabelMsg] = [];

    for e in edits {
        if (fixes.len == MAX_FIXES) {
            notes ~= [LabelMsg(Severity::NOTE, e.msg)];
            continue;
        }

        match applyEdit(e, width-> width) {
            Ok(f: Fix) => { fixes ~= [f]; }
            _ => { notes ~= [LabelMsg(Severity::NOTE, e.msg)]; }
        }
    }

    (fixes, notes)
}

/**
 * Splice an edit into the line it applies to.
 *
 * @params:
 *   - e:     the edit,
 *   - width: the width of the line number cell of the report.
 *
 * @returns: the pair of lines, none when the edit cannot be applied.
 */
pub fn applyEdit(e: Edit, width: usize)-> (Fix)? {
    if (e.splices.len == 0us) return none;

    let anchor = e.splices[0].loc;
    if (!isShowable(anchor)) return none;

    let line = withoutNewline(getLineAtLoc(anchor));

    // right to left, so a splice lands at the column the source line puts it at
    let ordered = sortedByColumn(e.splices);
    let mut after = line;
    let mut lastBegin = line.len + 1us;

    for s in ordered {
        if (s.loc.filename != anchor.filename || s.loc.lineSeek != anchor.lineSeek) return none;

        let col = cast!usize(s.loc.col);
        if (col == 0us || col - 1us + s.len > line.len) return none;

        let begin = col - 1us;

        // a splice is anchored on a word, so a span of its own is the word
        // itself: one that says otherwise is pointing at something the file
        // does not hold
        if (s.len != 0us && (s.len != s.loc.len || line[begin .. begin + s.len] != s.loc.str)) {
            return none;
        }

        // two splices over the same bytes are two edits of one region
        if (begin + s.len > lastBegin) return none;
        lastBegin = begin;

        after = after[0us .. begin] ~ s.replacement ~ after[begin + s.len .. $];
    }

    (Fix(e.msg, anchor.line, line, after, width-> width))?
}

/**
 * The splices of an edit, from the last column to the first.
 *
 * An edit holds two of them at most, so this is an insertion sort and not a
 * merge one.
 */
fn sortedByColumn(splices: [Splice])-> [Splice] {
    let mut res: [Splice] = [];
    for s in splices {
        let mut i = 0us;
        while i < res.len && res[i].loc.col > s.loc.col {
            i += 1us;
        }

        res = res[0us .. i] ~ [s] ~ res[i .. $];
    }

    res
}
