/*
 * snippet — the shape of a diagnostic, between ErrorMsg and the terminal.
 *
 * A diagnostic is rendered in two steps: this module says *what* is printed,
 * `ymirc::errors::format` says what it looks like. Nothing here writes a color
 * escape, and nothing there decides a width:
 *
 *   - `Diagnostic` is one node of the report — its header, the source snippets
 *     it points at, and the location a one-line node cites inline,
 *   - `Snippet` is one excerpt: a file, the coordinates of its header, and the
 *     source lines to show,
 *   - `SourceLine` is one line already cut at its labelled spans, each run
 *     shortened if it is too long, the elision *marked* rather than written,
 *   - `Label` is one such span: what it covers, what it is, and the messages
 *     hanging under its caret.
 *
 * The point of the split is that a column is a column here: a run carries no
 * escape sequence, so `Piece::width` counts what a terminal shows without
 * having to step over anything, and the caret alignment follows from it. The
 * styling is applied when the runs are written, cf. `format::writePiece`.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::errors::snippet
 * @File: ymirc/errors/snippet.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-09-08
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in snippet;

use ymirc::utils::_;
use ymirc::global::state;
use ymirc::lexing::word;

/**
 * The marker standing for the middle of a run that was too long to print.
 *
 * It is plain text, so it is five columns wide wherever it appears; the
 * renderer is the one deciding it is written in bold.
 */
pub def ELISION = "[...]";

/**
 * The number of bytes past which a run of a source line is elided.
 */
pub def MAX_RUN = 100us;

/**
 * The minimum width of the line number cell.
 */
pub def GUTTER = 3us;

/**
 * The number of unlabelled lines an excerpt shows between two labelled ones
 * before it elides them to an "..." separator.
 *
 * One. A single line of context costs exactly what the separator standing for
 * it would, and reading it is worth more than reading "..."; two already cost
 * more. This is the threshold rustc settles on, and the one YMI-68 sketched
 * the target rendering with.
 */
pub def MAX_GAP = 1u64;

/**
 * The severity of a diagnostic, independent of the color it is written in.
 */
pub enum Severity
| ERROR   = 0
| WARNING = 1
| NOTE    = 2;

/**
 * What a labelled span is to the diagnostic it belongs to.
 *
 * PRIMARY is the span the diagnostic is reported at, SECONDARY a span that
 * explains it — the closing delimiter of an unbalanced pair, or the
 * declaration a call does not match, for instance.
 *
 * The renderer underlines the first with `^` and the second with `-`, cf.
 * format::formatSourceLine: a diagnostic points at one place and explains
 * itself with the others, and the two read differently.
 */
pub enum LabelKind
| PRIMARY   = 0
| SECONDARY = 1;

/**
 * A location cited inline, without an excerpt.
 *
 * The path is the one that is printed, already made relative to the package,
 * so the renderer has no file system question left to ask.
 */
pub record InlineLoc {
    pub let file: [c8];
    pub let line: u64;
    pub let col: u64;

    pub self (file: [c8], line: u64, col: u64)
        with file = file
        , line = line
        , col = col
    {}
}

/**
 * @returns: the location of `loc` as it is cited, none when it is EOF.
 */
pub fn inlineLocOf(loc: &Word)-> (InlineLoc)? {
    if (loc.isEof) return none;

    (InlineLoc(state::relativePath(loc.filename), loc.line, loc.col))?
}

/**
 * A message hanging under the caret of a label.
 *
 * The severity is kept as such rather than as the word that stands for it: a
 * nested error inlined under a caret keeps being an error, and the renderer is
 * the one turning that into "error" and into the color it is written in.
 *
 * `loc` is the fallback of a message that names a place of its own and cannot
 * be shown there - the place is normally a label of the excerpt instead, cf.
 * ErrorMsg::gather.
 */
pub record LabelMsg {
    pub let severity: Severity;
    pub let text: [c8];
    pub let loc: (InlineLoc)?;

    pub self (severity: Severity, text: [c8], loc: (InlineLoc)? = none)
        with severity = severity
        , text = text
        , loc = loc
    {}
}

/**
 * A run of source text as it is laid out.
 *
 * A run too long to print keeps its two ends and drops the middle. What is
 * dropped is recorded, not replaced: `head` and `tail` are source, and the
 * marker between them is written by the renderer. That is what makes `width`
 * answerable without walking escape sequences.
 */
pub record Piece {
    pub let head: [c8];
    pub let tail: [c8];
    pub let elided: bool;

    pub self (head: [c8], tail: [c8] = "", elided: bool = false)
        with head = head
        , tail = tail
        , elided = elided
    {}

    /**
     * @returns: the number of columns the run takes once printed.
     */
    pub fn width(self)-> usize {
        let mark = if (self.elided) { ELISION.len } else { 0us };

        visibleWidth(self.head) + mark + visibleWidth(self.tail)
    }
}

/**
 * Cut a run of source text down to `max` bytes, marking the elision.
 *
 * @params:
 *   - str: the run,
 *   - max: the number of bytes past which it is cut.
 *
 * @returns:
 *   - the run itself when it is short enough, its two ends otherwise.
 */
pub fn elide(str: [c8], max: usize = MAX_RUN)-> Piece {
    if (str.len < max) return Piece(str);

    let xIndex = max / 2us - (ELISION.len / 2us);
    let yIndex = str.len - (max / 2us) + (ELISION.len - (ELISION.len / 2us));

    Piece(str[0us .. xIndex], tail-> str[yIndex .. $], elided-> true)
}

/**
 * A span of a source line to label, before the line is cut at it.
 *
 * The bounds are byte offsets in the line, `begin` included and `end`
 * excluded.
 */
pub record Span {
    pub let begin: usize;
    pub let end: usize;
    pub let kind: LabelKind;
    pub let msgs: [LabelMsg];

    pub self (begin: usize, end: usize, kind: LabelKind = LabelKind::PRIMARY, msgs: [LabelMsg] = [])
        with begin = begin
        , end = end
        , kind = kind
        , msgs = msgs
    {}
}

/**
 * A labelled span of a source line, once the line was cut at it.
 */
pub record Label {
    pub let text: Piece;
    pub let kind: LabelKind;
    pub let msgs: [LabelMsg];

    pub self (text: Piece, kind: LabelKind = LabelKind::PRIMARY, msgs: [LabelMsg] = [])
        with text = text
        , kind = kind
        , msgs = msgs
    {}
}

/**
 * One line of an excerpt, cut into the runs its labels split it into.
 *
 * `gaps` holds one entry more than `labels`: `gaps[i]` is what is printed
 * before `labels[i]`, and the last one what follows the last label. Reading
 * them alternately gives the line back.
 *
 * `gutter` is the line number cell and `padd` a blank of the same width, the
 * two cells every row of the excerpt starts with.
 */
pub record SourceLine {
    pub let gaps: [Piece];
    pub let labels: [Label];
    pub let gutter: [c8];
    pub let padd: [c8];

    // True iif the source line carries its own line return
    pub let trailingNewline: bool;

    // True iif the lines standing between this one and the one above were
    // dropped, the renderer writing an "..." separator in their place
    pub let elided: bool;

    pub self (num: u64, gaps: [Piece], labels: [Label], trailingNewline: bool, width: usize, elided: bool = false)
        with gaps = gaps
        , labels = labels
        , gutter = center(format("%", num), width)
        , padd = center("", width)
        , trailingNewline = trailingNewline
        , elided = elided
    {}
}

/**
 * One source excerpt: the file it comes from, the coordinates its header
 * cites, and the lines to show.
 *
 * There is one per file a diagnostic points into, and every line it shows —
 * labelled or context — is written under the same `width` wide gutter, so a
 * column of the excerpt is a column of the file. The coordinates are the ones
 * of the *primary* label, which is what the diagnostic is reported at,
 * wherever that sits among the lines shown.
 */
pub record Snippet {
    pub let file: [c8];
    pub let line: u64;
    pub let col: u64;
    pub let lines: [SourceLine];

    // The width of the line number cell shared by every line of the excerpt
    pub let width: usize;

    pub self (file: [c8], line: u64, col: u64, lines: [SourceLine], width: usize = GUTTER)
        with file = file
        , line = line
        , col = col
        , lines = lines
        , width = width
    {}
}

/**
 * The header of a diagnostic: what it is, and what it says.
 */
pub record Header {
    pub let severity: Severity;

    // The stable code of the diagnostic, NO_CODE when it carries none
    pub let code: i32;

    pub let msg: [c8];

    // The per run deduplication key, printed under --with-error-ids
    pub let id: usize;

    // True iif the severity is written before the message
    pub let withSeverity: bool;

    pub self (severity: Severity, code: i32, msg: [c8], id: usize, withSeverity: bool)
        with severity = severity
        , code = code
        , msg = msg
        , id = id
        , withSeverity = withSeverity
    {}
}

/**
 * One frame of the context trace of a report.
 *
 * A frame says what was being validated, not what went wrong, so it carries no
 * severity: the report it belongs to is the diagnostic, the frames are the
 * path that reached it. It cites its location inline rather than showing it —
 * a chain of them would otherwise drag one excerpt per enclosing symbol into a
 * report about a single line.
 */
pub record TraceFrame {
    pub let text: [c8];
    pub let loc: (InlineLoc)?;

    pub self (text: [c8], loc: (InlineLoc)? = none)
        with text = text
        , loc = loc
    {}
}

/**
 * One report, as it is going to be printed: what went wrong, where, what is
 * worth adding, and how the compiler got there.
 *
 * Either it shows its source excerpts, or it is a one-line node citing its
 * location inline — never both, so at most one of `snippets` and `inlineLoc`
 * is filled.
 *
 * There is no sub report: a diagnostic tree is flattened into a flat list of
 * these before anything is written (`ErrorMsg::reports`), every place it names
 * having become a label of an excerpt, a trailing note, or a frame of the
 * trace. Nothing recurses at print time, so no source line is ever written
 * twice.
 */
pub record Diagnostic {
    pub let header: Header;
    pub let snippets: [Snippet];
    pub let inlineLoc: (InlineLoc)?;

    // What the report adds and cannot point at, in the order it was declared in
    pub let notes: [LabelMsg];

    // What was being validated when it was raised, innermost frame first
    pub let trace: [TraceFrame];

    pub self (header: Header,
              snippets: [Snippet] = [],
              inlineLoc: (InlineLoc)? = none,
              notes: [LabelMsg] = [],
              trace: [TraceFrame] = [])
        with header = header
        , snippets = snippets
        , inlineLoc = inlineLoc
        , notes = notes
        , trace = trace
    {}
}

/**
 * A place in the source a diagnostic points at, before it is laid out.
 *
 * This is what the collect step produces, one per location the node carries -
 * its own two, and the one of every note that names a place of its own. Which
 * excerpt each of them lands in, and in what order, is decided by `layout`:
 * the throw site says what it points at, not how it is arranged.
 */
pub record Mark {
    pub let loc: &Word;
    pub let kind: LabelKind;
    pub let msgs: [LabelMsg];

    pub self (loc: &Word, kind: LabelKind = LabelKind::PRIMARY, msgs: [LabelMsg] = [])
        with loc = loc
        , kind = kind
        , msgs = msgs
    {}
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================         LAYOUT          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * Lay the places a diagnostic points at out into the excerpts to print.
 *
 * A file yields at most two excerpts: the run of lines around the place the
 * diagnostic is *reported* at, and everything else it names in that file. The
 * first comes first, so the line the header cites is the line the reader lands
 * on, and the declarations explaining it follow under a header of their own
 * rather than above it.
 *
 * That split is what a single excerpt could not give. Lines are shown in source
 * order, so a declaration written before the failing call is shown before it,
 * and the reader met two "candidate" labels before reaching the caret that is
 * the error - which is only marked by being a `^` rather than a `-`. Reordering
 * the lines was not an option: an excerpt whose line numbers do not increase is
 * not an excerpt. Splitting keeps both, at the cost of one `-->` line.
 *
 * Both excerpts of a file share one gutter width, so the file reads as one
 * column across the split. The file of the first mark comes first — the primary
 * one, so the excerpt the reader starts on is the one the diagnostic is
 * reported in.
 *
 * A place nothing can be shown of — an EOF location, or a file whose content
 * is not loaded — is dropped rather than laid out empty: the coordinate alone
 * is what YMI-70 set out to remove, and the caller keeps a way to cite it,
 * cf. isShowable.
 *
 * @params:
 *   - marks: the places the diagnostic points at, in no particular order.
 *
 * @returns:
 *   - the excerpts, in the order they are printed.
 */
pub fn layout(marks: [Mark])-> [Snippet] {
    let mut usable: [Mark] = [];
    for m in marks {
        if (isShowable(m.loc)) usable ~= [m];
    }

    if (usable.len == 0us) return [];

    let mut res: [Snippet] = [];
    let mut done: [[c8]] = [];
    for m in usable {
        if (seen(done, m.loc.filename)) continue;
        done ~= [m.loc.filename];

        let mut group: [Mark] = [];
        for o in usable {
            if (o.loc.filename == m.loc.filename) group ~= [o];
        }

        let sorted = sortByPosition(group);
        let width = gutterWidth(sorted[$ - 1us].loc.line);
        let (head, rest) = splitAtPrimary(sorted);

        if (head.len != 0us) res ~= [fileSnippet(head, width)];
        if (rest.len != 0us) res ~= [fileSnippet(rest, width)];
    }

    res
}

/**
 * Cut the places named in one file into the run holding the primary one and
 * everything else.
 *
 * The run is the block of labelled lines around the primary that would have
 * been printed without an "..." separator between them: a label near enough to
 * the failure to be read with it stays with it, one far enough to need a
 * separator is a place of its own and goes to the second excerpt.
 *
 * @params:
 *   - sorted: the places named in that file, ordered by (line, col).
 *
 * @returns:
 *   - .0: the run holding the primary place, empty when the file holds none,
 *   - .1: everything else, in source order.
 */
fn splitAtPrimary(sorted: [Mark])-> ([Mark], [Mark]) {
    let mut at = sorted.len;
    for i in 0us .. sorted.len {
        match sorted[i].kind {
            LabelKind::PRIMARY => { at = i; break; }
        }
    }

    if (at == sorted.len) return ([], sorted);

    let mut lo = at;
    while lo > 0us && isJoined(sorted[lo - 1us], sorted[lo]) {
        lo -= 1us;
    }

    let mut hi = at;
    while hi + 1us < sorted.len && isJoined(sorted[hi], sorted[hi + 1us]) {
        hi += 1us;
    }

    (sorted[lo .. hi + 1us], sorted[0us .. lo] ~ sorted[hi + 1us .. $])
}

/**
 * @returns:
 *   true iif the two places are close enough to be shown in one excerpt, which
 *   is the question `fileSnippet` asks before writing an "..." between them.
 */
fn isJoined(a: Mark, b: Mark)-> bool {
    if (b.loc.line <= a.loc.line) return true;

    b.loc.line - a.loc.line - 1u64 <= MAX_GAP
}

/**
 * @returns: true iif there is something to show of the given location.
 */
pub fn isShowable(loc: &Word)-> bool {
    if (loc.isEof) return false;

    getLineAtLoc(loc).len != 0us
}

/**
 * @returns: true iif `f` is one of the file names already laid out.
 */
fn seen(files: [[c8]], f: [c8])-> bool {
    for i in files {
        if (i == f) return true;
    }

    false
}

/**
 * Lay the places a diagnostic names in one file out into its excerpt.
 *
 * The marks are ordered by (line, col) first, so what the excerpt shows reads
 * the way the file does whatever order the throw site built its notes in.
 * Every mark naming the same line then shares that line, one label each.
 *
 * Two labelled lines that are not neighbours are joined by the lines between
 * them when there are at most MAX_GAP of those, and separated by an "..."
 * otherwise.
 *
 * @params:
 *   - marks: the places named in that file, at least one, all showable,
 *   - width: the width of the line number cell, shared by every excerpt of the
 *            file so that the two sides of a split read as one column.
 *
 * @returns:
 *   - the excerpt.
 */
fn fileSnippet(marks: [Mark], width: usize)-> Snippet {
    let sorted = sortByPosition(marks);

    // the header cites the place the diagnostic is reported at, which is not
    // necessarily the first line the excerpt shows
    let mut head = sorted[0];
    for m in sorted {
        match m.kind {
            LabelKind::PRIMARY => { head = m; break; }
        }
    }

    let mut lines: [SourceLine] = [];
    let mut prevLine = 0u64;
    let mut prevSeek = 0us;

    // the content the lines between two labelled ones are read from, which is
    // the one of the mark they are counted from rather than the one of the
    // group: two words naming one file are not obliged to carry the same
    // reading of it
    let mut prevContent = "";

    let mut i = 0us;
    while i < sorted.len {
        let num = sorted[i].loc.line;
        let mut j = i;
        while j < sorted.len && sorted[j].loc.line == num {
            j += 1us;
        }

        let mut elided = false;
        if (prevLine != 0u64 && num > prevLine + 1u64) {
            if (num - prevLine - 1u64 <= MAX_GAP) {
                let mut seek = prevSeek;
                for c in prevLine + 1u64 .. num {
                    let (next, txt) = lineAfter(prevContent, seek);
                    seek = next;
                    if (txt.len != 0us) lines ~= [contextLine(c, txt, width)];
                }
            } else {
                elided = true;
            }
        }

        lines ~= [labelledLine(sorted[i .. j], width, elided)];

        prevLine = num;
        prevSeek = sorted[i].loc.lineSeek;
        prevContent = sorted[i].loc.fileContent;
        i = j;
    }

    Snippet(state::relativePath(head.loc.filename), head.loc.line, head.loc.col, lines, width-> width)
}

/**
 * Order the places named in one file by the position they name.
 *
 * Insertion sort, keeping the order the marks arrived in among equals: the
 * primary one is built first, so it stays the first label of its line.
 */
fn sortByPosition(marks: [Mark])-> [Mark] {
    let mut res: [Mark] = [];
    for m in marks {
        let mut at = res.len;
        while at > 0us && isAfter(res[at - 1us], m) {
            at -= 1us;
        }

        res = res[0us .. at] ~ [m] ~ res[at .. $];
    }

    res
}

/**
 * @returns: true iif `a` names a strictly later position than `b`.
 */
fn isAfter(a: Mark, b: Mark)-> bool {
    if (a.loc.line != b.loc.line) return a.loc.line > b.loc.line;

    a.loc.col > b.loc.col
}

/**
 * @returns: the width of the line number cell an excerpt reaching `max` needs.
 */
fn gutterWidth(max: u64)-> usize {
    let str = format("%", max);
    if (str.len > GUTTER) return str.len;

    GUTTER
}

/**
 * The line of `content` following the one that starts at `seek`.
 *
 * @returns:
 *   - .0: where that line starts, the end of the content when there is none,
 *   - .1: its text, its own line return included, empty when there is none.
 */
fn lineAfter(content: [c8], seek: usize)-> (usize, [c8]) {
    let mut i = seek;
    while i < content.len && content[i] != '\n' {
        i += 1us;
    }

    if (i >= content.len) return (content.len, "");

    let start = i + 1us;
    let mut j = start;
    while j < content.len && content[j] != '\n' {
        j += 1us;
    }

    if (j < content.len) return (start, content[start .. j + 1us]);

    (start, content[start .. $])
}

/**
 * An unlabelled line of an excerpt, shown for the context it gives.
 */
fn contextLine(num: u64, line: [c8], width: usize)-> SourceLine {
    SourceLine(num,
               copy [elide(line)],
               [],
               trailingNewline-> line[$ - 1us] == '\n',
               width-> width)
}

/**
 * Lay every place naming one line out into that line of the excerpt.
 *
 * A mark whose span does not fit the line it names has nothing to underline,
 * so it contributes its messages to the label preceding it rather than a label
 * of its own — and the line comes out unlabelled when none of them fits, cf.
 * outOfRange. Two spans that overlap are merged the same way: there is one run
 * of source under them, so there is one caret.
 *
 * @params:
 *   - marks:  the places naming that line, ordered by column,
 *   - width:  the width of the line number cell of the excerpt,
 *   - elided: true iif an "..." separator stands before the line.
 */
fn labelledLine(marks: [Mark], width: usize, elided: bool)-> SourceLine {
    let line = getLineAtLoc(marks[0].loc);
    let mut spans: [Span] = [];

    for m in marks {
        let col = cast!usize(m.loc.col);
        let len = spanLen(line, col, m.loc);

        if (col > line.len || col + len > line.len) {
            spans = withMsgs(spans, m.msgs);
            continue;
        }

        let begin = col - 1us;
        if (spans.len != 0us && begin < spans[$ - 1us].end) {
            spans = withMsgs(spans, m.msgs);
            continue;
        }

        spans ~= [Span(begin, col + len - 1us, kind-> m.kind, msgs-> m.msgs)];
    }

    if (spans.len == 0us) return outOfRange(marks, line, width, elided);

    cut(marks[0].loc.line, line, spans,
        trailingNewline-> line[$ - 1us] == '\n',
        width-> width,
        elided-> elided)
}

/**
 * @returns: the spans, the last of them carrying `msgs` as well.
 */
fn withMsgs(spans: [Span], msgs: [LabelMsg])-> [Span] {
    if (msgs.len == 0us) return spans;
    if (spans.len == 0us) return spans;

    let last = spans[$ - 1us];

    spans[0us .. $ - 1us] ~ [Span(last.begin, last.end, kind-> last.kind, msgs-> last.msgs ~ msgs)]
}

/**
 * The line of an excerpt none of whose spans falls inside it.
 *
 * The whole line is shown, unshortened, and the label covers nothing: there is
 * no column to point at, so the caret line stays empty and the messages hang
 * at the gutter.
 */
fn outOfRange(marks: [Mark], line: [c8], width: usize, elided: bool)-> SourceLine {
    let mut msgs: [LabelMsg] = [];
    for m in marks {
        msgs ~= m.msgs;
    }

    SourceLine(marks[0].loc.line,
               copy [Piece(line), Piece("")],
               copy [Label(Piece(""), kind-> marks[0].kind, msgs-> msgs)],
               trailingNewline-> line[$ - 1us] == '\n',
               width-> width,
               elided-> elided)
}

/**
 * The number of bytes of `line` a location covers.
 *
 * A location whose span does not fit the line it names, or does not start on
 * the byte it says it does, is narrowed to a single byte: the excerpt is what
 * the file holds, and a span disagreeing with it would be underlining
 * something else.
 */
fn spanLen(line: [c8], col: usize, loc: &Word)-> usize {
    if (col > line.len || col + loc.len > line.len || loc.len == 0us || line[col - 1us] != loc.str[0]) {
        return 1us;
    }

    loc.len
}

/**
 * Cut a source line at the given spans.
 *
 * @params:
 *   - num:             the line number,
 *   - line:            the line, its own line return included,
 *   - spans:           the byte ranges to label, in order and non overlapping,
 *   - trailingNewline: true iif the excerpt ends with a line return of its own,
 *                      the renderer adding one when it does not,
 *   - width:           the width of the line number cell of the excerpt,
 *   - elided:          true iif an "..." separator stands before the line.
 *
 * @returns:
 *   - the line as the alternation of its unlabelled runs and its labels, each
 *     run elided when it is too long to print.
 */
fn cut(num: u64, line: [c8], spans: [Span], trailingNewline: bool, width: usize, elided: bool)-> SourceLine {
    let mut gaps: [Piece] = [];
    let mut labels: [Label] = [];
    let mut at = 0us;

    for s in spans {
        gaps ~= [elide(line[at .. s.begin])];
        labels ~= [Label(elide(line[s.begin .. s.end]), kind-> s.kind, msgs-> s.msgs)];
        at = s.end;
    }

    gaps ~= [elide(line[at .. $])];

    SourceLine(num, gaps, labels, trailingNewline-> trailingNewline, width-> width, elided-> elided)
}

/**
 * @returns:
 *   the width of the line number cell the excerpts share, GUTTER when there is
 *   none. This is what the report indents its sub notes by, so that they line
 *   up with the excerpt they hang under.
 */
pub fn gutterOf(snippets: [Snippet])-> usize {
    let mut res = GUTTER;
    for s in snippets {
        if (s.width > res) res = s.width;
    }

    res
}

/**
 * Extract the full line of source text containing the given Word.
 *
 * Behavior:
 *   - returns the slice starting at loc.lineSeek up to the next '\n',
 *   - includes the trailing '\n' if present,
 *   - returns an empty string if fileContent is empty or lineSeek is out of range.
 *
 * No file I/O is performed; the Word must contain fileContent.
 *
 * @returns:
 *   - [c8]: the line slice.
 */
pub fn getLineAtLoc(loc: &Word)-> [c8] {
    if (loc.lineSeek >= loc.fileContent.len) return "";

    let res = loc.fileContent[loc.lineSeek .. $];
    let mut max = 0;
    for i in res {
        if (i == '\n') return res[0 .. max + 1];
        else
            max += 1;
    }

    return res;
}
