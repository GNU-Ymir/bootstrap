/*
 * snippet — the shape of a diagnostic, between ErrorMsg and the terminal.
 *
 * A diagnostic is rendered in two steps: this package says *what* is printed,
 * `ymirc::errors::format` says what it looks like. Nothing here writes a color
 * escape, and nothing there decides a width.
 *
 * The submodules split along that same line, records first and the one
 * decision maker last:
 *
 *   - `piece` is a run of source text, shortened if it is too long, the
 *     elision *marked* rather than written,
 *   - `label` is the places a report points at — a `Mark` before they are laid
 *     out, a `Span` and a `Label` after — and the messages hanging under them,
 *   - `source` is one excerpt: a file, the coordinates of its header, and the
 *     lines to show,
 *   - `diagnostic` is one whole report,
 *   - `layout` arranges the places a report names into its excerpts,
 *   - `utils` reads the source those excerpts are cut out of.
 *
 * The point of the split between this package and the renderer is that a
 * column is a column here: a run carries no escape sequence, so `Piece::width`
 * counts what a terminal shows without having to step over anything, and the
 * caret alignment follows from it. The styling is applied when the runs are
 * written, cf. `format::formatPiece`.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::errors::snippet
 * @File: ymirc/errors/snippet.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2026-09-08
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in snippet;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SUBMODS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

pub mod ::diagnostic;
pub mod ::label;
pub mod ::layout;
pub mod ::piece;
pub mod ::source;
pub mod ::utils;
