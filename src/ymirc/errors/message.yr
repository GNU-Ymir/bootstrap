/*
 * message — structured compiler diagnostics, and the report they are printed as.
 *
 * This module defines the ErrorMsg class, the central diagnostic container used
 * throughout the compiler. ErrorMsg instances represent:
 *
 *   - fatal errors,
 *   - warnings,
 *   - notes,
 *   - lists of errors,
 *   - multi-location spans,
 *   - context frames ("when validating X"),
 *   - one-line and multi-line messages.
 *
 * ErrorMsg is the only type thrown by the compiler frontend and middle-end.
 * All diagnostics are normalized into this structure before printing.
 *
 * A thrown ErrorMsg is a *tree*, because a tree is what the throw sites build:
 * a validator catches what it was told and rethrows it wrapped in what it was
 * doing. It is not what a diagnostic *is*, and it is not printed as one. Before
 * anything is written, `reports` flattens the tree into the failures it holds,
 * each one carrying:
 *
 *   - the places it names, as labels of a shared excerpt, in source order,
 *   - what it has to add and cannot point at, as trailing notes,
 *   - the enclosing symbols it was reached through, as a trace at the bottom.
 *
 * So nothing recurses at print time and no source line is written twice.
 * `ymirc::errors::snippet` is the shape that comes out, and
 * `ymirc::errors::format` writes it.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::errors::message
 * @File: ymirc/errors/message.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2021-11-20
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in message;

use ymirc::utils::_;
use ymirc::errors::{code, format, snippet, utils};
use ymirc::global::state;
use ymirc::lexing::word;

use std::{conv, env, io, stream};
use std::fs::path;


extern (C) fn _yrt_exc_resolve_stack_trace(trc: [*void])-> [c8];

pub lazy dmut __GLOB_ERR_ID__: [usize] = copy [0us];
pub lazy EMPTY_ERROR = copy ErrorMsg::list([]);

/**
 * The number of reports a run prints before it stops listing them.
 *
 * This caps the *breadth* of a diagnostic - how many independent failures are
 * worth reading at once - which flattening does not address and does not make
 * less useful: a compilation raising forty errors is one whose first error is
 * what the reader has to fix. It is unrelated to the depth suppression YMI-71
 * removed, which hid the explanation of an error the reader was already
 * reading.
 */
def MAX_REPORTS = 3us;

fn generateUniqErrorId()-> usize {
    __GLOB_ERR_ID__[0] += 1us;
    __GLOB_ERR_ID__[0]
}

/**
 * ErrorMsg — one node of a diagnostic, as the throw sites build it.
 *
 * Represents a compiler diagnostic with:
 *
 *   - a primary message,
 *   - an optional location span(begin/end),
 *   - a list of sub-notes,
 *   - severity flags(fatal, warning, note),
 *   - one-line formatting mode,
 *   - stable unique ID,
 *   - captured stack trace.
 *
 * ErrorMsg instances form a tree, which says how a diagnostic was built and not
 * how it is printed: `reports` flattens it into the failures it holds before
 * anything is written.
 *
 * ErrorMsg is the only exception type thrown by the compiler.
 */
@final
pub class ErrorMsg over Exception {

    // The stack trace of the error
    let mut _movingTrace: [*void] = [];

    // The sub note of the error
    let _notes: [&ErrorMsg];

    // The location of the error
    let _begin: &Word = EOF_WORD;

    // The end location of the error
    let _end: &Word = EOF_WORD;

    // The message
    let _msg: [c8] = "";

    // If true, only prints an error on one line
    let _oneLine: bool = false;

    // If true prints the location of the error in the one line format
    let _oneLineWithLoc: bool = false;

    // True iif its a note
    let _isNote: bool = false;

    // True iif its a warning
    let _isWarning: bool = false;

    // True iif this is just a list of errors
    let _isList: bool = false;

    // The id of the error
    let _id: usize;

    // The stable code of the diagnostic, NO_CODE when it carries none
    let _code: i32 = code::NO_CODE;

    // True if print notes even if not verbose
    let _forceVerbose: bool = false;

    // True iif the message says what was being validated rather than what went
    // wrong, cf. code::Error::isContext
    let _isContext: bool = false;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          CTORS          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Construct a fatal error.
     *
     * Fatal errors print with the "Error:" prefix. They may include:
     *   - a location span(loc..end),
     *   - nested notes,
     *   - one-line or multi-line formatting,
     *   - forced verbose mode.
     *
     * @params:
     *   - loc:         begin location,
     *   - end:         end location(optional),
     *   - notes:       list of sub-errors,
     *   - oneLine:     if true, suppress source excerpt,
     *   - msg:         error message,
     *   - forceVerbose: force printing of all notes.
     */
    pub self fatal(loc: &Word,
                   end: &Word = EOF_WORD,
                   notes: [&ErrorMsg] = [],
                   oneLine: bool = false,
                   msg: [c8],
                   forceVerbose: bool = false)

        with _msg = msg
        , _notes = flatten(notes, false)
        , _begin = (if (loc.isBefore(end)) loc else end)
        , _end = (if (loc.isBefore(end)) end else loc)
        , _oneLine = oneLine
        , _id = generateUniqErrorId()
        , _forceVerbose = forceVerbose
    {
        self._movingTrace = self.super.trace;
    }

    /**
     * Construct a fatal error from a catalogue message.
     *
     * The message carries the stable code of the diagnostic, so nothing at the
     * throw site has to name it. Everything else behaves as the `[c8]` overload.
     *
     * @params:
     *   - loc:         begin location,
     *   - end:         end location(optional),
     *   - notes:       list of sub-errors,
     *   - oneLine:     if true, suppress source excerpt,
     *   - msg:         the catalogue message, code included,
     *   - forceVerbose: force printing of all notes.
     */
    pub self fatal(loc: &Word,
                   end: &Word = EOF_WORD,
                   notes: [&ErrorMsg] = [],
                   oneLine: bool = false,
                   msg: code::Error,
                   forceVerbose: bool = false)

        with _msg = msg.msg
        , _code = msg.code
        , _notes = flatten(notes, false)
        , _begin = (if (loc.isBefore(end)) loc else end)
        , _end = (if (loc.isBefore(end)) end else loc)
        , _oneLine = oneLine
        , _id = generateUniqErrorId()
        , _forceVerbose = forceVerbose
        , _isContext = msg.isContext
    {
        self._movingTrace = self.super.trace;
    }

    /**
     * Construct a note.
     *
     * Notes print with the "Note:" prefix. They may be:
     *   - one-line(no source excerpt),
     *   - multi-line(with source excerpt),
     *   - optionally printed without location.
     *
     * @params:
     *   - loc:      begin location,
     *   - end:      end location,
     *   - notes:    nested notes,
     *   - oneLine:  one-line formatting,
     *   - withLoc:  include location in one-line mode,
     *   - msg:      note message.
     */
    pub self note(loc: &Word,
                  end: &Word = EOF_WORD,
                  notes: [&ErrorMsg] = [],
                  oneLine: bool = false,
                  withLoc: bool = false,
                  msg: [c8])
        with _msg = msg
        , _begin = (if (loc.isBefore(end)) loc else end)
        , _end = (if (loc.isBefore(end)) end else loc)
        , _notes = flatten(notes, false)
        , _oneLine = oneLine
        , _oneLineWithLoc = withLoc
        , _isNote = true
        , _id = generateUniqErrorId()
    {
        self._movingTrace = self.super.trace;
    }

    /**
     * Construct a note from a catalogue message.
     *
     * A note is a context message hanging under a diagnostic, so the code the
     * catalogue entry may carry is deliberately not kept: only the diagnostic
     * the note hangs off is codified.
     *
     * @params:
     *   - loc:      begin location,
     *   - end:      end location,
     *   - notes:    nested notes,
     *   - oneLine:  one-line formatting,
     *   - withLoc:  include location in one-line mode,
     *   - msg:      the catalogue message.
     */
    pub self note(loc: &Word,
                  end: &Word = EOF_WORD,
                  notes: [&ErrorMsg] = [],
                  oneLine: bool = false,
                  withLoc: bool = false,
                  msg: code::Error)
        with _msg = msg.msg
        , _begin = (if (loc.isBefore(end)) loc else end)
        , _end = (if (loc.isBefore(end)) end else loc)
        , _notes = flatten(notes, false)
        , _oneLine = oneLine
        , _oneLineWithLoc = withLoc
        , _isNote = true
        , _id = generateUniqErrorId()
        , _isContext = msg.isContext
    {
        self._movingTrace = self.super.trace;
    }

    /**
     * Construct a warning.
     *
     * Warnings print with the "Warning:" prefix. They behave like fatal errors
     * except for severity.
     *
     * @params:
     *   - loc:      begin location,
     *   - end:      end location,
     *   - notes:    nested notes,
     *   - oneLine:  one-line formatting,
     *   - msg:      warning message.
     */
    pub self warn(loc: &Word,
                  end: &Word = EOF_WORD,
                  notes: [&ErrorMsg] = [],
                  oneLine: bool = false,
                  msg: [c8])
        with _msg = msg
        , _begin = (if (loc.isBefore(end)) loc else end)
        , _end = (if (loc.isBefore(end)) end else loc)
        , _notes = flatten(notes, false)
        , _oneLine = oneLine
        , _isWarning = true
        , _id = generateUniqErrorId()
    {
        self._movingTrace = self.super.trace;
    }

    /**
     * Construct a warning from a catalogue message.
     *
     * Like the fatal overload, the warning keeps the code of the message.
     *
     * @params:
     *   - loc:     begin location,
     *   - end:     end location,
     *   - notes:   nested notes,
     *   - oneLine: one-line formatting,
     *   - msg:     the catalogue message, code included.
     */
    pub self warn(loc: &Word,
                  end: &Word = EOF_WORD,
                  notes: [&ErrorMsg] = [],
                  oneLine: bool = false,
                  msg: code::Error)
        with _msg = msg.msg
        , _code = msg.code
        , _begin = (if (loc.isBefore(end)) loc else end)
        , _end = (if (loc.isBefore(end)) end else loc)
        , _notes = flatten(notes, false)
        , _oneLine = oneLine
        , _isWarning = true
        , _id = generateUniqErrorId()
        , _isContext = msg.isContext
    {
        self._movingTrace = self.super.trace;
    }

    /**
     * Construct a list of errors.
     *
     * A list error contains only notes and no primary message. Used to group
     * multiple diagnostics under a single node.
     *
     * @params:
     *   - lst: list of ErrorMsg nodes.
     */
    pub self list(lst: [&ErrorMsg])
        with _notes = flatten(lst, sort-> true)
        , _isList = true
        , _id = generateUniqErrorId()
    {
        self._movingTrace = self.super.trace;
    }

    /**
     * Internal constructor to specifiy all fields
     */
    prv self all(loc: &Word,
                 end: &Word,
                 notes: [&ErrorMsg],
                 oneLine: bool,
                 msg: [c8],
                 isNote: bool,
                 isWarning: bool,
                 isList: bool,
                 code: i32,
                 isContext: bool)

        with _msg = msg
        , _code = code
        , _begin = (if (loc.isBefore(end)) loc else end)
        , _end = (if (loc.isBefore(end)) end else loc)
        , _notes = flatten(notes, sort-> isList)
        , _oneLine = oneLine
        , _isNote = isNote
        , _isWarning = isWarning
        , _isList = isList
        , _id = generateUniqErrorId()
        , _isContext = isContext
    {
        self._movingTrace = self.super.trace;
    }

    /*!
     * ================================================================================
     * ================================================================================
     * =========================           GETTERS            =========================
     * ================================================================================
     * ================================================================================
     */

    /**
     * @returns: the list of sub errors
     */
    @field
    pub fn notes(self)-> [&ErrorMsg] {
        self._notes
    }

    /**
     * @returns: the message of the error
     */
    @field
    pub fn msg(self)-> [c8] {
        self._msg
    }

    /**
     * @returns: the id of the error
     * */
    @field
    pub fn id(self)-> usize {
        self._id
    }

    /**
     * @returns:
     *   the stable code of the diagnostic, NO_CODE if it carries none. This is
     *   the documented identifier of the diagnostic, unrelated to `id`, which
     *   is the per-run deduplication key.
     * */
    @field
    pub fn code(self)-> i32 {
        self._code
    }

    /**
     * @returns: the begin location of the error
     */
    @field
    pub fn loc(self)-> &Word {
        self._begin
    }

    /**
     * @returns: the end location of the error
     */
    @field
    pub fn endLoc(self)-> &Word {
        self._end
    }

    /**
     * @returns: true iif this is just a list of errors
     */
    @field
    pub fn isList(self)-> bool {
        self._isList
    }

    /**
     * @returns: true iif the error message does not display source code location
     * */
    @field
    pub fn isOneLine(self)-> bool {
        self._oneLine
    }

    /**
     * @returns: true iif the error message is empty
     * */
    @field
    pub fn isEmpty(self)-> bool {
        self._oneLine && !self._oneLineWithLoc && self._msg == ""
    }

    /**
     * @returns: true iif the error message is a note
     * */
    @field
    pub fn isNote(self)-> bool {
        self._isNote
    }

    /**
     * @returns: true iif the error message is a fatal error
     * */
    @field
    pub fn isFatal(self)-> bool {
        !self._isNote && !self._isWarning && !self._isList
    }

    /**
     * @returns: true iif the error message is a warning
     * */
    @field
    pub fn isWarning(self)-> bool {
        self._isWarning
    }

    /**
     * @returns: all the stack traces of the errors
     */
    pub fn getRecursiveTrace(self)-> [[c8]] {
        let mut traces: mut[[c8]] = [];
        for i in self._notes {
            traces ~= i.getRecursiveTrace();
            break;
        }

        return traces ~ [_yrt_exc_resolve_stack_trace(self._movingTrace)];
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          TRANSFORMATION          =================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Convert this diagnostic into a fatal error, preserving:
     *   - locations,
     *   - notes,
     *   - one-line mode,
     *   - message,
     *   - verbose flag.
     */
    pub fn asFatal(self)-> &ErrorMsg {
        copy ErrorMsg::fatal(self._begin,
                             end-> self._end,
                             notes-> self._notes,
                             oneLine-> self._oneLine,
                             msg-> code::Error(self._code, self._msg, isContext-> self._isContext),
                             forceVerbose-> self._forceVerbose)
    }

    /*!
     * ================================================================================
     * ================================================================================
     * =========================          SUB NOTES           =========================
     * ================================================================================
     * ================================================================================
     */

    /**
     * Return a new error with additional notes appended.
     *
     * If alone = true, replace existing notes with the given ones.
     */
    pub fn withNote(self, notes: [&ErrorMsg], alone: bool = false)-> &ErrorMsg {
        if !alone {
            let dmut ret = copy ErrorMsg::all(self._begin, self._end, self._notes ~ notes, self._oneLine, self._msg, self._isNote, self._isWarning, self._isList, self._code, self._isContext);
            ret._movingTrace = self._movingTrace;
            return ret;
        }

        let dmut ret = copy ErrorMsg::all(self._begin, self._end, notes, self._oneLine, self._msg, self._isNote, self._isWarning, self._isList, self._code, self._isContext);
        ret._movingTrace = self._movingTrace;
        return ret;
    }

    /**
     * Insert an intermediate note above existing notes.
     *
     * Example:
     *   A-> [B, C]
     *   A.subbingNote(D) => A-> [D-> [B, C]]
     */
    pub fn subbingNote(self, note: &ErrorMsg)-> &ErrorMsg {
        let dmut ret = copy ErrorMsg::all(self._begin, self._end, copy [note.withNote(self._notes, alone-> true)], self._oneLine, self._msg, self._isNote, self._isWarning, self._isList, self._code, self._isContext);
        ret._movingTrace = self._movingTrace;
        return ret;
    }

    /**
     * Append notes to the first note in the list, recursively.
     *
     * Used to maintain stable left-biased note trees.
     */
    pub fn appendNotes(self, notes: [&ErrorMsg])-> &ErrorMsg {
        if (self._notes.len == 0u64) {
            let dmut ret = copy ErrorMsg::all(self._begin, self._end, notes, self._oneLine, self._msg, self._isNote, self._isWarning, self._isList, self._code, self._isContext);
            ret._movingTrace = self._movingTrace;
            return ret;
        }

        let aux = self._notes[0].appendNotes(notes);
        let dmut ret =  copy ErrorMsg::all(self._begin, self._end, copy [aux] ~ self._notes[1us .. $], self._oneLine, self._msg, self._isNote, self._isWarning, self._isList, self._code, self._isContext);
        ret._movingTrace = self._movingTrace;
        return ret;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================        FLATTENING        ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Flatten the diagnostic tree into the reports to print.     
     *
     * @params:
     *   - trace: the frames this node was reached through, innermost first.
     *
     * @returns:
     *   - the reports this node prints, in the order they are printed.
     */
    fn reports(self, trace: [TraceFrame])-> [Diagnostic] {
        if (self._isList) {
            let mut res: [Diagnostic] = [];
            for i in self._notes {
                res ~= i.reports(trace);
            }

            return res;
        }

        if (self._isContext && self._notes.len != 0us) {
            let inner = copy [TraceFrame(self._msg, loc-> inlineLocOf(self._begin))] ~ trace;
            let mut res: [Diagnostic] = [];
            for i in self._notes {
                res ~= i.reports(inner);
            }

            return res;
        }

        copy [self.collect(trace)]
    }

    /**
     * Collect one failure and everything hanging under it into the report it
     * prints.
     *
     * @params:
     *   - trace: the frames this node was reached through, innermost first.
     *
     * @returns:
     *   - the node, and its whole subtree, as one report.
     */
    fn collect(self, trace: [TraceFrame])-> Diagnostic {
        let header = Header(self.getSeverity(),
                            if (self._isNote) { code::NO_CODE } else { self._code },
                            self._msg,
                            self._id,
                            self._isNote || self._isWarning || self._msg != "");

        let mut caret: [LabelMsg] = [];
        let mut endCaret: [LabelMsg] = [];
        let mut marks: [Mark] = [];
        let mut notes: [LabelMsg] = [];

        let mut frames: [TraceFrame] = [];
        for i in self._notes {
            let (msgs, m, n, f) = i.gather(false);
            marks ~= m;
            notes ~= n;
            frames ~= f;

            let atEnd = !self._end.isEof
                && !i._begin.isSameLoc(self._begin)
                && i._begin.isSameLoc(self._end);

            if (atEnd) { endCaret ~= msgs; } else { caret ~= msgs; }
        }

        if (self._oneLine) {
            if (self._oneLineWithLoc && isShowable(self._begin)) {
                let own = copy [Mark(self._begin, msgs-> caret ~ endCaret)];

                return Diagnostic(header,
                                  snippets-> layout(own ~ marks),
                                  notes-> notes,
                                  trace-> frames ~ trace);
            }

            let mut inline: (InlineLoc)? = none;
            if (self._oneLineWithLoc) {
                inline = inlineLocOf(self._begin);
            }

            // there is no caret to hang them under, so what was written there
            // is written at the bottom instead rather than dropped
            return Diagnostic(header,
                              snippets-> layout(marks),
                              inlineLoc-> inline,
                              notes-> caret ~ endCaret ~ notes,
                              trace-> frames ~ trace);
        }

        // An error running to EOF points at one place only
        let own = if (self._end.isEof) {
            copy [Mark(self._begin, msgs-> caret ~ endCaret)]
        } else {
            copy [Mark(self._begin, msgs-> caret),
                  Mark(self._end, kind-> LabelKind::SECONDARY, msgs-> endCaret)]
        };

        Diagnostic(header, snippets-> layout(own ~ marks), notes-> notes, trace-> frames ~ trace)
    }

    /**
     * Collect one node of a report's subtree, and its own subtree under it.
     *     
     * @params:
     *   - underNote: true iif the nearest place this hangs under is a note that
     *                became a label of the excerpt.
     *
     * @returns:
     *   - .0: what it and its subtree leave for the caret of the caller,
     *   - .1: the places it and its subtree label, in tree order - which is not
     *         the order they are printed in, `snippet::layout` sorts them,
     *   - .2: the notes it and its subtree leave for the bottom of the report,
     *   - .3: the frames it and its subtree were reached through.
     */
    fn gather(self, underNote: bool)-> ([LabelMsg], [Mark], [LabelMsg], [TraceFrame]) {
        let mut own: [LabelMsg] = [];
        if (self._msg != "") {
            own = copy [LabelMsg(self.getSeverity(), self._msg)];
        }

        // what this node is of the four, decided before its children are
        // walked: they need to know whether they hang under a label of this
        // node or under whatever this one hangs under
        let folds = (self._oneLine && !self._oneLineWithLoc) || (underNote && own.len != 0us);
        let labels = !self._isContext && !folds && isShowable(self._begin);

        let childUnder = if (labels) { self._isNote } else { underNote };

        let mut inline: [LabelMsg] = [];
        let mut marks: [Mark] = [];
        let mut notes: [LabelMsg] = [];
        let mut frames: [TraceFrame] = [];

        for i in self._notes {
            let (ins, m, n, f) = i.gather(childUnder);
            inline ~= ins;
            marks ~= m;
            notes ~= n;
            frames ~= f;
        }

        // a context frame is a frame wherever it is found, cf. `reports`. One
        // deeper than the failure was reached through the failure, so it is a
        // deeper frame than the ones that led to the report itself
        if (self._isContext) {
            return (inline, marks, notes, frames ~ copy [TraceFrame(self._msg, loc-> inlineLocOf(self._begin))]);
        }

        if (folds) {
            return (own ~ inline, marks, notes, frames);
        }

        if (labels) {
            let mine = Mark(self._begin, kind-> LabelKind::SECONDARY, msgs-> own ~ inline);

            return ([], copy [mine] ~ marks, notes, frames);
        }

        if (own.len != 0us) {
            let mut loc: (InlineLoc)? = none;
            if (self._oneLineWithLoc) {
                loc = inlineLocOf(self._begin);
            }

            return (inline, marks, copy [LabelMsg(own[0].severity, own[0].text, loc-> loc)] ~ notes, frames);
        }

        (inline, marks, notes, frames)
    }

    /**
     * @returns: the severity of the diagnostic, a list counting as an error.
     */
    fn getSeverity(self)-> Severity {
        if (self._isNote) return Severity::NOTE;
        if (self._isWarning) return Severity::WARNING;

        Severity::ERROR
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          MISC          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Streamable;
    impl ErrorFormattable {

        /**
         * Print the whole diagnostic tree, flattened into its reports.
         *
         * Responsibilities:
         *   - flatten the tree into the failures it holds, cf. `reports`,
         *   - deduplicate repeated failures via ID tracking,
         *   - cap the number of them listed outside verbose mode,
         *   - write each of them, cf. `format::formatDiagnostic`.
         *
         * This is the main entry point for diagnostic rendering.
         */
        pub over format(self, dmut stream: &Formatter, root: bool) {
            let verbose = (global::state::isVerboseActive() || stream.tags.verbose || self._forceVerbose);

            let mut written = 0us;
            for r in self.reports([]) {
                if (stream.hasWrittenError(r.header.id)) {
                    if (written != 0us || !root) continue;

                    if (stream.tags.withErrorIds) {
                        stream:.writef("%(b) : previous error(#%(B))", "Note", r.header.id.to!{[c8], 36us} ());
                    } else {
                        stream:.writef("%(b) : previous error", "Note");
                    }

                    written += 1us;
                    continue;
                }

                if (!verbose && written == MAX_REPORTS) {
                    stream:.write('\n'c8);
                    stream:.writef("%(b) : other errors in list, user -v or --verbose to show them", "Note");
                    break;
                }

                if (written != 0us) stream:.write('\n'c8);

                stream:.registerError(r.header.id);
                stream:.wroteErrors(true);
                formatDiagnostic(alias stream, r);

                written += 1us;
            }
        }
    }
}
