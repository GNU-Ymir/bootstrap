/*
 * message — structured compiler diagnostics and hierarchical error reporting.
 *
 * This module defines the ErrorMsg class, the central diagnostic container used
 * throughout the compiler. ErrorMsg instances represent:
 *
 *   - fatal errors,
 *   - warnings,
 *   - notes,
 *   - lists of errors,
 *   - multi-location spans,
 *   - nested diagnostic trees,
 *   - one-line and multi-line messages,
 *   - inline caret messages extracted from one-line notes.
 *
 * The formatter supports:
 *
 *   - multi-span location printing,
 *   - inline caret messages,
 *   - nested notes with depth suppression,
 *   - verbose and non-verbose modes,
 *   - stable error IDs,
 *   - stack-trace capture for debugging.
 *
 * ErrorMsg is the only type thrown by the compiler frontend and middle-end.
 * All diagnostics are normalized into this structure before printing.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::errors::message
 * @File: ymirc/errors/message.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2021-11-20
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in message;

use std::{io, stream, fs::path, conv, env};
use ymirc::lexing::word;
use ymirc::errors::{format, utils};
use ymirc::errors::code;
use ymirc::global::state;
use ymirc::utils::_;


extern (C) fn _yrt_exc_resolve_stack_trace(trc: [*void])-> [c8];

pub lazy dmut __GLOB_ERR_ID__: [usize] = copy [0us];
pub lazy EMPTY_ERROR = copy ErrorMsg::list([]);

fn generateUniqErrorId()-> usize {
    __GLOB_ERR_ID__[0] += 1us;
    __GLOB_ERR_ID__[0]
}

/**
 * ErrorMsg — hierarchical diagnostic node.
 *
 * Represents a compiler diagnostic with:
 *
 *   - a primary message,
 *   - an optional location span(begin/end),
 *   - a list of sub-notes,
 *   - severity flags(fatal, warning, note),
 *   - one-line formatting mode,
 *   - stable unique ID,
 *   - captured stack trace,
 *   - inverse depth for verbose suppression.
 *
 * ErrorMsg instances form a tree. The root error is printed first, then its
 * notes, recursively. One-line notes may be extracted and displayed inline as
 * caret messages.
 *
 * ErrorMsg is the only exception type thrown by the compiler.
 */
@final
pub class ErrorMsg over Exception {

    // The stack trace of the error
    let mut _movingTrace: [*void] = [];

    // The sub note of the error
    let _notes: [&ErrorMsg];

    // The location of the error
    let _begin: &Word = EOF_WORD;

    // The end location of the error
    let _end: &Word = EOF_WORD;

    // The message
    let _msg: [c8] = "";

    // If true, only prints an error on one line
    let _oneLine: bool = false;

    // If true prints the location of the error in the one line format
    let _oneLineWithLoc: bool = false;

    // True iif its a note
    let _isNote: bool = false;

    // True iif its a warning
    let _isWarning: bool = false;

    // True iif this is just a list of errors
    let _isList: bool = false;

    // The id of the error
    let _id: usize;

    // The stable code of the diagnostic, NO_CODE when it carries none
    let _code: i32 = code::NO_CODE;

    // True if print notes even if not verbose
    let _forceVerbose: bool = false;

    // The inverse depth of the error
    let mut _inverseDepth: u32 = 0;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          CTORS          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Construct a fatal error.
     *
     * Fatal errors print with the "Error:" prefix. They may include:
     *   - a location span(loc..end),
     *   - nested notes,
     *   - one-line or multi-line formatting,
     *   - forced verbose mode.
     *
     * @params:
     *   - loc:         begin location,
     *   - end:         end location(optional),
     *   - notes:       list of sub-errors,
     *   - oneLine:     if true, suppress source excerpt,
     *   - msg:         error message,
     *   - forceVerbose: force printing of all notes.
     */
    pub self fatal(loc: &Word,
                   end: &Word = EOF_WORD,
                   notes: [&ErrorMsg] = [],
                   oneLine: bool = false,
                   msg: [c8],
                   forceVerbose: bool = false)

        with _msg = msg
        , _notes = flatten(notes, false)
        , _begin = (if (loc.isBefore(end)) loc else end)
        , _end = (if (loc.isBefore(end)) end else loc)
        , _oneLine = oneLine
        , _id = generateUniqErrorId()
        , _forceVerbose = forceVerbose
    {
        self._movingTrace = self.super.trace;
        self:.computeInverseDepth();
    }

    /**
     * Construct a fatal error from a catalogue message.
     *
     * The message carries the stable code of the diagnostic, so nothing at the
     * throw site has to name it. Everything else behaves as the `[c8]` overload.
     *
     * @params:
     *   - loc:         begin location,
     *   - end:         end location(optional),
     *   - notes:       list of sub-errors,
     *   - oneLine:     if true, suppress source excerpt,
     *   - msg:         the catalogue message, code included,
     *   - forceVerbose: force printing of all notes.
     */
    pub self fatal(loc: &Word,
                   end: &Word = EOF_WORD,
                   notes: [&ErrorMsg] = [],
                   oneLine: bool = false,
                   msg: code::Error,
                   forceVerbose: bool = false)

        with _msg = msg.msg
        , _code = msg.code
        , _notes = flatten(notes, false)
        , _begin = (if (loc.isBefore(end)) loc else end)
        , _end = (if (loc.isBefore(end)) end else loc)
        , _oneLine = oneLine
        , _id = generateUniqErrorId()
        , _forceVerbose = forceVerbose
    {
        self._movingTrace = self.super.trace;
        self:.computeInverseDepth();
    }

    /**
     * Construct a note.
     *
     * Notes print with the "Note:" prefix. They may be:
     *   - one-line(no source excerpt),
     *   - multi-line(with source excerpt),
     *   - optionally printed without location.
     *
     * @params:
     *   - loc:      begin location,
     *   - end:      end location,
     *   - notes:    nested notes,
     *   - oneLine:  one-line formatting,
     *   - withLoc:  include location in one-line mode,
     *   - msg:      note message.
     */
    pub self note(loc: &Word,
                  end: &Word = EOF_WORD,
                  notes: [&ErrorMsg] = [],
                  oneLine: bool = false,
                  withLoc: bool = false,
                  msg: [c8])
        with _msg = msg
        , _begin = (if (loc.isBefore(end)) loc else end)
        , _end = (if (loc.isBefore(end)) end else loc)
        , _notes = flatten(notes, false)
        , _oneLine = oneLine
        , _oneLineWithLoc = withLoc
        , _isNote = true
        , _id = generateUniqErrorId()
    {
        self._movingTrace = self.super.trace;
        self:.computeInverseDepth();
    }

    /**
     * Construct a note from a catalogue message.
     *
     * A note is a context message hanging under a diagnostic, so the code the
     * catalogue entry may carry is deliberately not kept: only the diagnostic
     * the note hangs off is codified.
     *
     * @params:
     *   - loc:      begin location,
     *   - end:      end location,
     *   - notes:    nested notes,
     *   - oneLine:  one-line formatting,
     *   - withLoc:  include location in one-line mode,
     *   - msg:      the catalogue message.
     */
    pub self note(loc: &Word,
                  end: &Word = EOF_WORD,
                  notes: [&ErrorMsg] = [],
                  oneLine: bool = false,
                  withLoc: bool = false,
                  msg: code::Error)
        with _msg = msg.msg
        , _begin = (if (loc.isBefore(end)) loc else end)
        , _end = (if (loc.isBefore(end)) end else loc)
        , _notes = flatten(notes, false)
        , _oneLine = oneLine
        , _oneLineWithLoc = withLoc
        , _isNote = true
        , _id = generateUniqErrorId()
    {
        self._movingTrace = self.super.trace;
        self:.computeInverseDepth();
    }

    /**
     * Construct a warning.
     *
     * Warnings print with the "Warning:" prefix. They behave like fatal errors
     * except for severity.
     *
     * @params:
     *   - loc:      begin location,
     *   - end:      end location,
     *   - notes:    nested notes,
     *   - oneLine:  one-line formatting,
     *   - msg:      warning message.
     */
    pub self warn(loc: &Word,
                  end: &Word = EOF_WORD,
                  notes: [&ErrorMsg] = [],
                  oneLine: bool = false,
                  msg: [c8])
        with _msg = msg
        , _begin = (if (loc.isBefore(end)) loc else end)
        , _end = (if (loc.isBefore(end)) end else loc)
        , _notes = flatten(notes, false)
        , _oneLine = oneLine
        , _isWarning = true
        , _id = generateUniqErrorId()
    {
        self._movingTrace = self.super.trace;
        self:.computeInverseDepth();
    }

    /**
     * Construct a warning from a catalogue message.
     *
     * Like the fatal overload, the warning keeps the code of the message.
     *
     * @params:
     *   - loc:     begin location,
     *   - end:     end location,
     *   - notes:   nested notes,
     *   - oneLine: one-line formatting,
     *   - msg:     the catalogue message, code included.
     */
    pub self warn(loc: &Word,
                  end: &Word = EOF_WORD,
                  notes: [&ErrorMsg] = [],
                  oneLine: bool = false,
                  msg: code::Error)
        with _msg = msg.msg
        , _code = msg.code
        , _begin = (if (loc.isBefore(end)) loc else end)
        , _end = (if (loc.isBefore(end)) end else loc)
        , _notes = flatten(notes, false)
        , _oneLine = oneLine
        , _isWarning = true
        , _id = generateUniqErrorId()
    {
        self._movingTrace = self.super.trace;
        self:.computeInverseDepth();
    }

    /**
     * Construct a list of errors.
     *
     * A list error contains only notes and no primary message. Used to group
     * multiple diagnostics under a single node.
     *
     * @params:
     *   - lst: list of ErrorMsg nodes.
     */
    pub self list(lst: [&ErrorMsg])
        with _notes = flatten(lst, sort-> true)
        , _isList = true
        , _id = generateUniqErrorId()
    {
        self._movingTrace = self.super.trace;
        self:.computeInverseDepth();
    }

    /**
     * Internal constructor to specifiy all fields
     */
    prv self all(loc: &Word,
                 end: &Word,
                 notes: [&ErrorMsg],
                 oneLine: bool,
                 msg: [c8],
                 isNote: bool,
                 isWarning: bool,
                 isList: bool,
                 code: i32)

        with _msg = msg
        , _code = code
        , _begin = (if (loc.isBefore(end)) loc else end)
        , _end = (if (loc.isBefore(end)) end else loc)
        , _notes = flatten(notes, sort-> isList)
        , _oneLine = oneLine
        , _isNote = isNote
        , _isWarning = isWarning
        , _isList = isList
        , _id = generateUniqErrorId()
    {
        self._movingTrace = self.super.trace;
        self:.computeInverseDepth();
    }

    /*!
     * ================================================================================
     * ================================================================================
     * =========================           GETTERS            =========================
     * ================================================================================
     * ================================================================================
     */

    /**
     * @returns: the list of sub errors
     */
    @field
    pub fn notes(self)-> [&ErrorMsg] {
        self._notes
    }

    /**
     * @returns: the message of the error
     */
    @field
    pub fn msg(self)-> [c8] {
        self._msg
    }

    /**
     * @returns: the id of the error
     * */
    @field
    pub fn id(self)-> usize {
        self._id
    }

    /**
     * @returns:
     *   the stable code of the diagnostic, NO_CODE if it carries none. This is
     *   the documented identifier of the diagnostic, unrelated to `id`, which
     *   is the per-run deduplication key.
     * */
    @field
    pub fn code(self)-> i32 {
        self._code
    }

    /**
     * @returns: the begin location of the error
     */
    @field
    pub fn loc(self)-> &Word {
        self._begin
    }

    /**
     * @returns: the end location of the error
     */
    @field
    pub fn endLoc(self)-> &Word {
        self._end
    }

    /**
     * @returns: true iif this is just a list of errors
     */
    @field
    pub fn isList(self)-> bool {
        self._isList
    }

    /**
     * @returns: true iif the error message does not display source code location
     * */
    @field
    pub fn isOneLine(self)-> bool {
        self._oneLine
    }

    /**
     * @returns: true iif the error message is empty
     * */
    @field
    pub fn isEmpty(self)-> bool {
        self._oneLine && !self._oneLineWithLoc && self._msg == ""
    }

    /**
     * @returns: true iif the error message is a note
     * */
    @field
    pub fn isNote(self)-> bool {
        self._isNote
    }

    /**
     * @returns: true iif the error message is a fatal error
     * */
    @field
    pub fn isFatal(self)-> bool {
        !self._isNote && !self._isWarning && !self._isList
    }

    /**
     * @returns: true iif the error message is a warning
     * */
    @field
    pub fn isWarning(self)-> bool {
        self._isWarning
    }

    /**
     * @returns: all the stack traces of the errors
     */
    pub fn getRecursiveTrace(self)-> [[c8]] {
        let mut traces: mut[[c8]] = [];
        for i in self._notes {
            traces ~= i.getRecursiveTrace();
            break;
        }

        return traces ~ [_yrt_exc_resolve_stack_trace(self._movingTrace)];
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          TRANSFORMATION          =================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Convert this diagnostic into a fatal error, preserving:
     *   - locations,
     *   - notes,
     *   - one-line mode,
     *   - message,
     *   - verbose flag.
     */
    pub fn asFatal(self)-> &ErrorMsg {
        copy ErrorMsg::fatal(self._begin,
                             end-> self._end,
                             notes-> self._notes,
                             oneLine-> self._oneLine,
                             msg-> code::Error (self._code, self._msg),
                             forceVerbose-> self._forceVerbose)
    }

    /*!
     * ================================================================================
     * ================================================================================
     * =========================          SUB NOTES           =========================
     * ================================================================================
     * ================================================================================
     */

    /**
     * Return a new error with additional notes appended.
     *
     * If alone = true, replace existing notes with the given ones.
     */
    pub fn withNote(self, notes: [&ErrorMsg], alone: bool = false)-> &ErrorMsg {
        if !alone {
            let dmut ret = copy ErrorMsg::all(self._begin, self._end, self._notes ~ notes, self._oneLine, self._msg, self._isNote, self._isWarning, self._isList, self._code);
            ret._movingTrace = self._movingTrace;
            return ret;
        }

        let dmut ret = copy ErrorMsg::all(self._begin, self._end, notes, self._oneLine, self._msg, self._isNote, self._isWarning, self._isList, self._code);
        ret._movingTrace = self._movingTrace;
        return ret;
    }

    /**
     * Insert an intermediate note above existing notes.
     *
     * Example:
     *   A-> [B, C]
     *   A.subbingNote(D) => A-> [D-> [B, C]]
     */
    pub fn subbingNote(self, note: &ErrorMsg)-> &ErrorMsg {
        let dmut ret = copy ErrorMsg::all(self._begin, self._end, copy [note.withNote(self._notes, alone-> true)], self._oneLine, self._msg, self._isNote, self._isWarning, self._isList, self._code);
        ret._movingTrace = self._movingTrace;
        return ret;
    }

    /**
     * Append notes to the first note in the list, recursively.
     *
     * Used to maintain stable left-biased note trees.
     */
    pub fn appendNotes(self, notes: [&ErrorMsg])-> &ErrorMsg {
        if (self._notes.len == 0u64) {
            let dmut ret = copy ErrorMsg::all(self._begin, self._end, notes, self._oneLine, self._msg, self._isNote, self._isWarning, self._isList, self._code);
            ret._movingTrace = self._movingTrace;
            return ret;
        }

        let aux = self._notes[0].appendNotes(notes);
        let dmut ret =  copy ErrorMsg::all(self._begin, self._end, copy [aux] ~ self._notes[1us .. $], self._oneLine, self._msg, self._isNote, self._isWarning, self._isList, self._code);
        ret._movingTrace = self._movingTrace;
        return ret;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          DEPTH          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Compute the inverse depth of the diagnostic tree.
     *
     * Used to suppress deep notes in non-verbose mode.
     */
    fn computeInverseDepth(mut self) {
        self._inverseDepth = 0;

        let add = if self._isList { 0u32 } else { 1u32 };
        for i in self._notes {
            if i._inverseDepth + add > self._inverseDepth {
                self._inverseDepth = i._inverseDepth + add;
            }
        }
    }

    /**
     * Extract the sub diagnostics to write next to the caret.
     *
     * One goes there when it carries no sub note of its own, and either is
     * one-line, or points at one of the two locations the error points at. It
     * keeps its own label there - "note", "error" or "warning" - a nested
     * error written as "note:" would silently be demoted to one.
     *
     * @info
     *   Every sub diagnostic that qualifies is taken, not only the first one.
     *   A list of them - the candidates of an ambiguous call, for instance -
     *   is written as a block hanging under the caret, cf.
     *   formatCaretMessages. Inlining only the first would glue it to the
     *   caret and leave its siblings below as plain notes, reading as if it
     *   were of a different nature.
     *
     *   A note pointing at the end location hangs under the end excerpt, not
     *   under the begin one. Both locations are sorted by source position at
     *   construction, so the location an error was actually reported at ends
     *   up being the second one about as often as the first, and hanging its
     *   notes under the begin excerpt would point them at an unrelated line.
     *
     *   Nothing is inlined when the error has no excerpt to hang them under,
     *   the caret messages would be dropped on printing.
     *
     * @returns:
     *   - .0: the diagnostics hanging under the begin caret, each being its
     *         colored label and its text, in the order they were declared in,
     *   - .1: the diagnostics hanging under the end caret, likewise,
     *   - .2: the notes left to print, never losing any.
     */
    fn getNoteListForFormat(self)-> ([([c8], [c8])], [([c8], [c8])], [&ErrorMsg]) {
        if (self._oneLine || self._begin.isEof || self._notes.len == 0) return ([], [], self._notes);

        let mut caret: [([c8], [c8])] = [];
        let mut endCaret: [([c8], [c8])] = [];
        let mut rest: [&ErrorMsg] = [];
        for i in self._notes {
            let atBegin = i._begin.isSameLoc(self._begin);
            let atEnd = !atBegin && !self._end.isEof && i._begin.isSameLoc(self._end);
            let inlinable = i._oneLine || atBegin || atEnd;

            if (inlinable && i._notes.len == 0) {
                let dmut msg = copy Formatter();
                msg:.write(i._msg);
                if (i._oneLineWithLoc) {
                    formatLocationNoLineReturn(alias msg, i._begin);
                }

                let label = if (i._isNote) { Colors::BLUE ~ "note" }
                            else if (i._isWarning) { Colors::YELLOW ~ "warning" }
                            else { Colors::RED ~ "error" };

                if (atEnd) {
                    endCaret ~= [(label, msg[])];
                } else {
                    caret ~= [(label, msg[])];
                }
            } else {
                rest ~= [i];
            }
        }

        return (caret, endCaret, rest);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          MISC          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Format a list of notes into the formatter.
     *
     * Handles:
     *   - verbose suppression,
     *   - multi-line vs one-line notes,
     *   - indentation by depth,
     *   - stable ordering,
     *   - multi-span location printing.
     *
     * @returns:
     *   - .0: true if multi-line notes were printed,
     *   - .1: maximum line number among printed notes.
     */
    fn formatNotes(self, dmut stream: &Formatter, notes: [&ErrorMsg], depth: u32, root: bool = false)-> (bool, u64) {
        let mut notOneLine = true;
        let mut max_padd = 0u64;
        let innerRoot = if (self._isList) { root } else { false };

        let mut j = 0us;
        let verbose = (global::state::isVerboseActive() || stream.tags.verbose || self._forceVerbose);
        for  i in notes {
            if (!verbose && j == 3us) {
                stream:.write('\n'c8);
                stream:.writef("%(b) : other errors in list, user -v or --verbose to show them", "Note");
                stream:.write('\n'c8, ' 'c8);
                break;
            }

            let dmut innerStream = copy Formatter::from(alias stream);
            i.format(alias innerStream, root-> innerRoot, depth-> depth + 1);
            notOneLine = !i._oneLine || i._notes.len != 0u64;

            max_padd = i._begin.line;
            if (i._end.line > max_padd) {
                max_padd = i._end.line;
            }

            if (innerStream.hasWrittenSomeErrors() && innerStream[].len != 0) {
                if (j != 0us) stream:.write('\n'c8);
                stream:.write(innerStream[]);
                stream:.wroteErrors(true);
            }

            if (innerStream[].len != 0us) j += 1us;
        }

        return (notOneLine, max_padd);
    }

    /**
     * Format the primary diagnostic line.
     *
     * Prints:
     *   - severity prefix,
     *   - message,
     *   - location excerpt,
     *   - inline caret message(if extracted from a one-line note).
     */
    fn formatCode(self, dmut stream: &Formatter) {
        if (self._code == code::NO_CODE) return;

        stream:.writef("[%(B)]", code::codeStr (self._code));
    }

    fn formatText(self, dmut stream: &Formatter, caretMessages: [([c8], [c8])], endCaretMessages: [([c8], [c8])]) {
        if (self._isNote || self._isWarning || self._msg != "") {
            if (self._isNote) {
                stream:.writef("%(b)", "Note");
            } else if (self._isWarning) {
                stream:.writef("%(y)", "Warning");
                self.formatCode(alias stream);
            } else {
                stream:.writef("%(r)", "Error");
                self.formatCode(alias stream);
            }

            if (stream.tags.withErrorIds) {
                stream:.writef(" (#%(B))", self._id.to!{[c8], 36us} ());
            }
        }

        if (!self._oneLine) {
            stream:.writef(" : %", self._msg);
            if (self._end.isEof) {
                formatLocation(alias stream, self._begin, messages-> caretMessages);
            } else {
                formatLocation(alias stream, self._begin, self._end, messages-> caretMessages, endMessages-> endCaretMessages);
            }
        } else {
            stream:.writef(" : %", self._msg);
            if (self._oneLineWithLoc) {
                formatLocationNoLineReturn(alias stream, self._begin);
            }
        }
    }

    impl Streamable;
    impl ErrorFormattable {

        /**
         * Pretty-print the entire diagnostic tree.
         *
         * Responsibilities:
         *   - deduplicate repeated errors via ID tracking,
         *   - handle verbose suppression,
         *   - extract inline caret messages,
         *   - print primary diagnostic,
         *   - print notes recursively,
         *   - draw closing tree connectors.
         *
         * This is the main entry point for diagnostic rendering.
         */
        pub over format(self, dmut stream: &Formatter, root: bool, depth: u32 = 0) {
            if (stream.hasWrittenError(self._id)) {
                if (!root) {
                    if (stream.tags.withErrorIds) {
                        stream:.writef("%(b) : previous error(#%(B))", "Note", self._id.to!{[c8], 36us} ());
                    } else {
                        stream:.writef("%(b) : previous error", "Note");
                    }
                }
                return;
            }

            let verbose = (global::state::isVerboseActive() || stream.tags.verbose || self._forceVerbose);

            if (self._isList) {
                self.formatNotes(alias stream, self._notes, root-> root, depth-> depth);
                return;
            }

            else if (!verbose && (self._inverseDepth >= 4 && depth > 3) && !root) {
                let dmut innerStream = copy Formatter::from(alias stream);
                self.formatNotes(alias innerStream, self._notes, root-> false, depth);

                if innerStream.hasWrittenSomeErrors() {
                    if self._inverseDepth == 4 {
                        stream:.writef("%(b) : deep errors, user -v or --verbose to show them", "Note");
                        stream:.write('\n'c8, ' 'c8);
                    }

                    stream:.write(innerStream[]);
                    stream:.wroteErrors(true);
                }

                return;
            }

            stream:.registerError(self._id);
            stream:.wroteErrors(true);


            let (caretMessages, endCaretMessages, remainingNotes) = self.getNoteListForFormat();
            self.formatText(alias stream, caretMessages, endCaretMessages);

            let max_line = if (self._end.isEof) { self._begin.line } else { self._end.line };
            let leftLine = center(format("%", max_line), 3u64);
            let padd = center("", leftLine.len);
            let l = format("%% ┃ %", Colors::BOLD, padd, Colors::RESET);

            stream:.entabing(txt-> l);
            let (notOneLine, max_padd) = if (remainingNotes.len != 0us) {
                let dmut innerStream = copy Formatter::from(alias stream);
                let res = self.formatNotes(alias innerStream, remainingNotes, root-> false, depth);

                if (root || innerStream.hasWrittenSomeErrors()) && innerStream[].len != 0 {
                    stream:.write("\n");
                    stream:.write(innerStream[]);
                } else if root {
                    stream:.writef("\n%(b) : previous errors", "Note");
                }

                res
            } else {
                (false, 0u64)
            };
            stream:.detabing();

            if (remainingNotes.len != 0u64) {
                let leftLine2 = center(format("%", max_padd), 3u64, concat-> '0');
                let padd2 = center32(""s32, leftLine2.len, concat-> '━'c32);

                if (notOneLine) {
                    stream:.writef("\n%% ┗━%━┻━ %", Colors::BOLD, padd, padd2, Colors::RESET);
                } else {
                    stream:.writef("\n%% ┗━%━━ %", Colors::BOLD, padd, padd2, Colors::RESET);
                }
            } else if (!self._oneLine && (!self._begin.isEof || !self._end.isEof)) {
                stream:.writef("\n%% ┗━━━━━━━ %", Colors::BOLD, padd, padd, Colors::RESET);
            }
        }
    }
}
