/*
 * format — writing a laid out diagnostic to the terminal.
 *
 * This module is the second half of the error renderer: it takes the
 * `Diagnostic` that `ymirc::errors::snippet` produced and writes it, applying
 * the styling on the way. It takes no layout decision of its own — every width
 * it needs was counted on plain source text, before any escape sequence
 * existed:
 *
 *   - a run of the excerpt knows its own width(`Piece::width`), so the caret
 *     line is indented by columns without having to step over anything,
 *   - the elision marker is written here and measured there, so the two cannot
 *     disagree,
 *   - a severity arrives as a severity, and the word and the color standing
 *     for it are chosen here.
 *
 * All functions write into a Formatter. No file I/O is performed; the source
 * text was extracted when the diagnostic was laid out.
 *
 * <hr>
 *
 * @Package: ymirc
 * @Module: ymirc::errors::format
 * @File: ymirc/errors/format.yr
 * @Author(s):
 *   - Emile Cadorel <ecadorel@gmail.com>
 *
 * @Created(YYYY-MM-DD): 2021-11-20
 * @Copyright(C) 2021–2026 GNU-Ymir
 * @License
 *   ```text
 *   This file is part of the Ymir language project.
 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in format;

use ymirc::utils::_;
use ymirc::errors::{code, snippet};

use std::{conv, env, io, stream};
use std::fs::path;

/**
 * Write a diagnostic node: its header, the excerpts it points at, and the
 * location it cites when it has no excerpt.
 *
 * The sub notes of the node are not written here, they are diagnostics of
 * their own, cf. ErrorMsg::format.
 *
 * @params:
 *   - stream: output formatter,
 *   - diag:   the laid out diagnostic.
 */
pub fn formatDiagnostic(dmut stream: &Formatter, diag: Diagnostic) {
    formatHeader(alias stream, diag.header);

    for s in diag.snippets {
        formatSnippet(alias stream, s);
    }

    match diag.inlineLoc {
        Ok(l: InlineLoc) => { formatInlineLoc(alias stream, l); }
    }
}

/**
 * Write the header of a diagnostic: what it is, the code identifying it, and
 * what it says.
 *
 * The severity is what picks both the word and the color it is written in. A
 * note carries no code, cf. Header.
 */
fn formatHeader(dmut stream: &Formatter, header: Header) {
    if (header.withSeverity) {
        match header.severity {
            Severity::NOTE => { stream:.writef("%(b)", "Note"); }
            Severity::WARNING => { stream:.writef("%(y)", "Warning"); }
            _ => { stream:.writef("%(r)", "Error"); }
        }

        if (header.code != code::NO_CODE) {
            stream:.writef("[%(B)]", code::codeStr(header.code));
        }

        if (stream.tags.withErrorIds) {
            stream:.writef(" (#%(B))", header.id.to!{[c8], 36us} ());
        }
    }

    stream:.writef(" : %", header.msg);
}

/**
 * Write a source excerpt: its header, and the lines it shows.
 *
 * There is one per file the diagnostic points into, so an excerpt starting on
 * a line the previous one did not reach is a file of its own and says so with
 * its header. The "..." standing for the lines dropped *inside* one is written
 * by the line that follows them, cf. formatSourceLine.
 */
fn formatSnippet(dmut stream: &Formatter, snip: Snippet) {
    if (snip.lines.len == 0us) return;

    stream:.writef("\n% --> %:(%,%)%\n",
                   Colors::BOLD,
                   snip.file,
                   snip.line,
                   snip.col,
                   Colors::RESET);

    // a labelled line ends on its caret row and an unlabelled one on the
    // source itself, so where the next line starts is not the same question
    let mut atStart = true;
    for l in snip.lines {
        if (!atStart) stream:.write('\n');

        formatSourceLine(alias stream, l);
        atStart = l.labels.len == 0us;
    }
}

/**
 * Write one line of an excerpt: the source itself, the caret line under it,
 * and the messages hanging under the carets.
 *
 * The line was cut at its labels, so writing it is reading its runs
 * alternately, and the caret line is the same walk with a blank standing for
 * every run that is not labelled.
 */
fn formatSourceLine(dmut stream: &Formatter, line: SourceLine) {
    if (line.elided) {
        stream:.writef("%%...%\n", Colors::BOLD, line.padd, Colors::RESET);
    }

    stream:.writef("%% ┃ %", Colors::BOLD, line.gutter, Colors::RESET);

    for i in 0us .. line.labels.len {
        formatPiece(alias stream, line.gaps[i]);
        stream:.write(Colors::UNDERLINE);
        stream:.writef("%(y)", styledPiece(line.labels[i].text));
        stream:.write(Colors::RESET);
    }

    formatPiece(alias stream, line.gaps[$ - 1us]);
    if (!line.trailingNewline) stream:.write('\n');

    // a line shown for the context it gives points at nothing, so it has no
    // caret row of its own
    if (line.labels.len == 0us) return;

    stream:.writef("%% ╋ %", Colors::BOLD, line.padd, Colors::RESET);

    for i in 0us .. line.labels.len {
        let width = line.labels[i].text.width();
        if (width != 0us) {
            formatIndent(alias stream, line.gaps[i]);
            stream:.write(center("", width, concat-> markerOf(line.labels[i].kind)));
        }
    }

    formatLabelMessages(alias stream, line);
}

/**
 * @returns:
 *   the character a span is underlined with. The diagnostic is reported at the
 *   primary one and explained by the others, so the two do not read the same.
 */
fn markerOf(kind: LabelKind)-> c8 {
    match kind {
        LabelKind::SECONDARY => { '-' }
        _ => { '^' }
    }
}

/**
 * Write the messages the labels of a line carry, each block hanging under the
 * caret of the label it belongs to.
 *
 * When one label of the line does the talking, its first message lands on the
 * caret line itself and the following ones on a line of their own, connected
 * to its column, so that the list reads as a single block:
 *
 * ```text
 * 21  ┃     let _ = foo(true);
 *     ╋                 ^  note: candidate test8::foo(z: bool)-> i32
 *     ┃                 ┣━ note: candidate test8::bar(z: bool)-> i32
 *     ┃                 ┗━ note: candidate test8::inner::foo(x: bool)-> i32
 * ```
 *
 * When several of them do, nothing is written on the caret line: a message
 * sitting there would be read as belonging to the last caret, and each block
 * goes under its own instead.
 *
 * ```text
 * 5   ┃     pub self (b: i32) with b = b {}
 *     ╋         ----
 *     ┃         ┗━ note: candidate test7::Base::self (b: i32)
 * ```
 */
fn formatLabelMessages(dmut stream: &Formatter, line: SourceLine) {
    let mut talking = 0us;
    for l in line.labels {
        if (l.msgs.len != 0us) talking += 1us;
    }

    if (talking == 0us) return;

    for i in 0us .. line.labels.len {
        let msgs = line.labels[i].msgs;
        if (msgs.len == 0us) continue;

        let mut j = 0us;
        if (talking == 1us) {
            stream:.write(' ');
            formatOneMessage(alias stream, msgs[0]);
            j = 1us;
        }

        while j < msgs.len {
            stream:.write('\n');
            stream:.writef("%% ┃ %", Colors::BOLD, line.padd, Colors::RESET);
            formatLabelIndent(alias stream, line, i);

            let connector = if (j == msgs.len - 1us) { "┗━" } else { "┣━" };
            stream:.writef("%%%", Colors::BOLD, connector, Colors::RESET);
            formatOneMessage(alias stream, msgs[j]);

            j += 1us;
        }
    }
}

/**
 * Write the blank a message block of the given label is indented by, so that
 * its connector lands under the last column of that label's caret.
 *
 * A label with no width to point at carries no caret either, so there is
 * nothing to hang the block under and it starts at the gutter.
 */
fn formatLabelIndent(dmut stream: &Formatter, line: SourceLine, idx: usize) {
    let width = line.labels[idx].text.width();
    if (width == 0us) return;

    for i in 0us .. idx {
        formatIndent(alias stream, line.gaps[i]);
        formatIndent(alias stream, line.labels[i].text);
    }

    formatIndent(alias stream, line.gaps[idx]);

    for _ in 1us .. width {
        stream:.write(' ');
    }
}

/**
 * Write one message of a caret block: its severity, and what it says.
 *
 * It keeps its own severity there - "note", "error" or "warning" - a nested
 * error written as "note" would silently be demoted to one.
 */
fn formatOneMessage(dmut stream: &Formatter, msg: LabelMsg) {
    let label = match msg.severity {
        Severity::WARNING => { Colors::YELLOW ~ "warning" }
        Severity::ERROR => { Colors::RED ~ "error" }
        _ => { Colors::BLUE ~ "note" }
    };

    let dmut text = copy Formatter();
    text:.write(msg.text);
    match msg.loc {
        Ok(l: InlineLoc) => { formatInlineLoc(alias text, l); }
    }

    stream:.writef(" %: %%%%", label, Colors::RESET, Colors::BOLD, text[], Colors::RESET);
}

/**
 * Write a compact location annotation, without the source line.
 *
 * Output example:
 *     " -- (<file>:<line>,<col>)"
 *
 * Used for inline messages where the full excerpt is not required.
 */
fn formatInlineLoc(dmut stream: &Formatter, loc: InlineLoc) {
    stream:.writef(" -- (%%:(%,%)%)",
                   Colors::BOLD,
                   loc.file,
                   loc.line,
                   loc.col,
                   Colors::RESET);
}

/**
 * Write a run of the excerpt, the elision marker styled.
 */
fn formatPiece(dmut stream: &Formatter, piece: Piece) {
    stream:.write(styledPiece(piece));
}

/**
 * @returns: a run of the excerpt as it is printed, elision marker included.
 */
fn styledPiece(piece: Piece)-> [c8] {
    if (!piece.elided) return piece.head;

    piece.head ~ Colors::BOLD ~ ELISION ~ Colors::RESET ~ piece.tail
}

/**
 * Write the blank standing for a run of the excerpt, so that whatever is
 * written next lands under the column that run ends at.
 *
 * One space is written per *column*, not per byte: a multi byte character is
 * one column, and the elision marker is five whatever the styling wraps it in.
 * Tabs are written back as tabs, the terminal is the one deciding how wide
 * they are.
 */
fn formatIndent(dmut stream: &Formatter, piece: Piece) {
    formatBlank(alias stream, piece.head);

    if (piece.elided) {
        for _ in 0us .. ELISION.len {
            stream:.write(' ');
        }
    }

    formatBlank(alias stream, piece.tail);
}

/**
 * Write one blank per column of `txt`, tabs excepted.
 */
fn formatBlank(dmut stream: &Formatter, txt: [c8]) {
    for i in 0us .. txt.len {
        if (txt[i] == '\t') {
            stream:.write('\t');
        } else if ((cast!u8(txt[i]) & 0xC0u8) != 0x80u8) {
            stream:.write(' ');
        }
    }
}
