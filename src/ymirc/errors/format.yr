 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in format;

use ymirc::lexing::word;
use ymirc::utils::_;
use ymirc::global::state;

use std::{io, env, fs::path, stream};

/**
 * Write the diagnostics attached to a caret.
 *
 * The first one is written on the caret line itself, the following ones on a
 * line of their own, connected to the caret column, so that a list of them
 * reads as a single block hanging under the caret:
 *
 * ```text
 * 21  ┃     let _ = foo(true);
 *     ╋                 ^  note: candidate test8::foo(z: bool)-> i32
 *     ┃                 ┣━ note: candidate test8::bar(z: bool)-> i32
 *     ┃                 ┗━ note: candidate test8::inner::foo(x: bool)-> i32
 * ```
 *
 * @params:
 *   - stream:   output formatter,
 *   - messages: the diagnostics to write, possibly none, each being its
 *               already colored label(note, error, warning) and its text,
 *   - padd:     the padding standing for the line number gutter,
 *   - indent:   the source text preceding the caret, only its width is used.
 */
fn formatCaretMessages(dmut stream: &Formatter, messages: [([c8], [c8])], padd: [c8], indent: [c8], caretSize: usize) {
    if (messages.len != 0us) {
        stream:.write(' ');
        stream:.writef(" %: %%%%", messages[0].0, Colors::RESET, Colors::BOLD, messages[0].1, Colors::RESET);

        for i in 1us .. messages.len {
            stream:.write('\n');
            stream:.writef("%% ┃ %", Colors::BOLD, padd, Colors::RESET);
            for c in indent {
                if (c == '\t') {
                    stream:.write('\t');
                } else stream:.write(' ');
            }

            for _ in 1 .. caretSize {
                stream:.write (' ');
            }
            
            let connector = if (i == messages.len - 1us) { "┗━" } else { "┣━" };
            stream:.writef("%%%", Colors::BOLD, connector, Colors::RESET);
            stream:.writef(" %: %%%%", messages[i].0, Colors::RESET, Colors::BOLD, messages[i].1, Colors::RESET);
        }
    }
}

/**
 * Format a single-location error.
 *
 * Behavior:
 *   - prints:
 *       "<file>:<line>,<col>"
 *   - prints the source line with the error span underlined,
 *   - prints a caret line aligned with the error column,
 *   - writes the caret notes, cf. formatCaretMessages,
 *   - handles tabs correctly,
 *   - gracefully handles out-of-range spans,
 *   - ignores EOF locations.
 *
 * @params:
 *   - stream:   output formatter,
 *   - loc:      location to highlight,
 *   - messages: the notes to hang under the caret.
 *
 * @returns:
 *   - &Formatter
 */
pub fn formatLocation(dmut stream: &Formatter, loc: &Word, messages: [([c8], [c8])] = [])-> dmut &Formatter {
    if (loc.isEof) {
        return alias stream;
    }

    let line = getLineAtLoc(loc);
    if (line.len == 0) return alias stream;

    let leftLine = center(format("%", loc.line), 3u64);
    let padd = center("", leftLine.len);
    stream:.writef("\n% --> %:(%,%)%\n",
                   Colors::BOLD,
                   state::relativePath(loc.filename),
                   loc.line,
                   loc.col,
                   Colors::RESET);

    let mut col = cast!usize(loc.col);
    let mut len = loc.len;
    if (col > line.len || col + loc.len > line.len || loc.len == 0 || line[col - 1] != loc.str[0]) {
        len = 1;
    }

    let (begin, wstr, between) = if (col <= line.len && col + len <= line.len) {
        let begin = shorten(line[0 .. col - 1]);
        let wstr = shorten(line[col - 1 .. col + len - 1]);
        let between = shorten(line[col + len - 1 .. $]);
        (begin, wstr, between)
    } else {
        (line, [], [])
    };

    col = begin.len + 1;
    stream:.writef("%% ┃ %%%%(y)%%",
                   Colors::BOLD, leftLine, Colors::RESET,
                   begin,
                   Colors::UNDERLINE,
                   wstr,
                   Colors::RESET,
                   between);

    if (line[$ - 1] != '\n') stream:.write('\n');
    stream:.writef("%% ╋ %", Colors::BOLD, padd, Colors::RESET);

    if (wstr.len != 0) {
        for c in begin {
            if (c == '\t') {
                stream:.write('\t');
            } else stream:.write(' ');
        }

        stream:.write(center("", wstr.len, concat-> '^'));
    }

    formatCaretMessages(alias stream, messages, padd, if (wstr.len != 0) { begin } else { "" }, wstr.len);

    return alias stream;
}

/**
 * Format an error spanning two different lines or files.
 *
 * Behavior:
 *   - prints the first location via formatLocation(),
 *   - prints an ellipsis line,
 *   - prints the second location via formatLocation().
 *
 * Each excerpt gets its own caret notes, a note hangs under the location it
 * points at, not systematically under the first one.
 *
 * Used for errors like:
 *   - mismatched parentheses across lines,
 *   - multi-line constructs with separate begin/end markers.
 */
pub fn formatLocationTwoLines(dmut stream: &Formatter, begin: &Word, end: &Word, messages: [([c8], [c8])] = [], endMessages: [([c8], [c8])] = [])-> dmut &Formatter {
    let leftLine = center(format("%", begin.line), 3);
    let padd = center("", leftLine.len);

    formatLocation(alias stream, begin, messages-> messages);
    stream:.writef("\n%%...%", Colors::BOLD, padd, Colors::RESET);
    formatLocation(alias stream, end, messages-> endMessages);

    return alias stream;
}

/**
 * Format a compact location annotation without printing the source line.
 *
 * Output example:
 *     " -- (<file>:<line>,<col>)"
 *
 * Used for inline error messages where the full excerpt is not required.
 */
pub fn formatLocationNoLineReturn(dmut stream: &Formatter, begin: &Word)-> dmut &Formatter {
    if (!begin.isEof) {
        stream:.writef(" -- (%%:(%,%)%)",
                       Colors::BOLD,
                       state::relativePath(begin.filename),
                       begin.line,
                       begin.col,
                       Colors::RESET);
    }

    return alias stream;
}

/**
 * Format an error spanning two locations on the same line.
 *
 * Behavior:
 *   - prints the file/line header,
 *   - prints the full line with two underlined spans,
 *   - prints a caret line with two caret groups,
 *   - handles tabs and multi-byte spans.
 *
 * Used for errors like:
 *   - mismatched delimiters on the same line,
 *   - invalid ranges,
 *   - incorrect slice boundaries.
 */
pub fn formatLocationOneLine(dmut stream: &Formatter, begin: &Word, end: &Word, messages: [([c8], [c8])] = [])-> dmut &Formatter {
    let line = getLineAtLoc(begin);
    if (line.len == 0) return alias stream;

    let leftLine = center(format("%", begin.line), 3);
    let padd = center("", leftLine.len);
    stream:.writef("\n% --> %:(%,%)%\n",
                   Colors::BOLD,
                   state::relativePath(begin.filename),
                   begin.line,
                   begin.col,
                   Colors::RESET);

    let col = cast!usize(begin.col);
    let col2 = cast!usize(end.col);

    let mut len = begin.len;
    if (col > line.len || col + begin.len > line.len || begin.len == 0 || line[col - 1] != begin.str[0]) {
        len = 1;
    }

    let mut len2 = end.len;
    if (col2 > line.len || col2 + end.len > line.len || end.len == 0 || line[col2 - 1] != end.str[0]) {
        len2 = 1;
    }

    let bstr = shorten(line[0 .. col - 1]);
    let wstr = shorten(line[col - 1 .. col + len - 1]);
    let between = shorten(line[col + len - 1 .. col2 - 1]);

    let wstr2 = shorten(line[col2 - 1 .. col2 + len2 - 1]);
    let estr = shorten(line[col2 + len2 - 1 .. $]);
    stream:.writef("%% ┃ %%%%(y)%%%%(y)%%",
                   Colors::BOLD, leftLine, Colors::RESET,
                   bstr,
                   Colors::UNDERLINE,
                   wstr,
                   Colors::RESET,
                   between,
                   Colors::UNDERLINE,
                   wstr2,
                   Colors::RESET,
                   estr);

    if (estr.len == 0 || estr[$ - 1] != '\n') stream:.write('\n');

    stream:.writef("%% ╋ %", Colors::BOLD, padd, Colors::RESET);
    if wstr.len != 0 {
        for c in bstr {
            if (c == '\t') {
                stream:.write('\t');
            } else stream:.write(' ');
        }

        stream:.write(center("", wstr.len, concat-> '^'));
    }

    if wstr2.len != 0 {
        for c in between {
            if (c == '\t') {
                stream:.write('\t');
            } else stream:.write(' ');
        }

        stream:.write(center("", wstr2.len, concat-> '^'));
    }

    formatCaretMessages(alias stream, messages, padd, if (wstr.len != 0) { bstr } else { "" }, wstr2.len);

    return alias stream;
}

/**
 * Format a multi-location error.
 *
 * Dispatches to:
 *   - formatLocationTwoLines() if begin/end are on different lines/files,
 *   - formatLocation()         if end is before begin,
 *   - formatLocationOneLine()  otherwise.
 *
 * @params:
 *   - messages:    the notes hanging under the begin caret,
 *   - endMessages: the notes hanging under the end caret. Only the two lines
 *                  form draws two caret lines, the other ones write a single
 *                  one and both lists are hung under it.
 */
pub fn formatLocation(dmut stream: &Formatter, begin: &Word, end: &Word, messages: [([c8], [c8])] = [], endMessages: [([c8], [c8])] = [])-> dmut &Formatter {
    if (begin.line != end.line || begin.filename != end.filename) {
        formatLocationTwoLines(alias stream, begin, end, messages-> messages, endMessages-> endMessages);
    } else if (end.col <= begin.col) {
        formatLocation(alias stream, begin, messages-> messages ~ endMessages);
    } else {
        formatLocationOneLine(alias stream, begin, end, messages-> messages ~ endMessages);
    }

    alias stream
}

/**
 * Format an EOF location.
 *
 * Behavior:
 *   - prints:
 *       "<file>: EOF"
 *   - prints a placeholder line with "EOF" marker.
 *
 * Used when the parser reaches the end of file unexpectedly.
 */
pub fn formatEof(dmut stream: &Formatter, loc: &Word)-> dmut &Formatter {
    let leftLine = center(format("%", 0), 3);
    let padd = center("", leftLine.len);
    stream:.writef("\n% --> %%\n%% ┃ %\tEOF",
                   Colors::BOLD,
                   state::relativePath(loc.filename),
                   Colors::RESET,
                   Colors::BOLD,
                   padd,
                   Colors::RESET);

    return alias stream;
}

/**
 * Extract the full line of source text containing the given Word.
 *
 * Behavior:
 *   - returns the slice starting at loc.lineSeek up to the next '\n',
 *   - includes the trailing '\n' if present,
 *   - returns an empty string if fileContent is empty or lineSeek is out of range.
 *
 * No file I/O is performed; the Word must contain fileContent.
 *
 * @returns:
 *   - [c8]: the line slice.
 */
pub fn getLineAtLoc(loc: &Word)-> [c8] {
    if (loc.lineSeek >= loc.fileContent.len) return "";

    let res = loc.fileContent[loc.lineSeek .. $];
    let mut max = 0;
    for i in res {
        if (i == '\n') return res[0 .. max + 1];
        else
            max += 1;
    }

    return res;
}
