in place;

use ymirc::lexing::word;

/**
 * @returns: true iif `loc` is a place of a source file the client can show.
 */
pub fn isPlaced(loc: &Word)-> bool {
    !loc.isEof && loc.line != 0u64 && loc.col != 0u64 && loc.fileContent.len != 0us
        && loc.lineSeek + cast!usize(loc.col) - 1us <= loc.fileContent.len
}
