in json;

use std::config::data;

/**
 * Writes the diagnostics as the JSON objects a language server publishes.
 */
pub mod JsonExporting {

    /**
     * @returns: the LSP `Diagnostic` object of `d`, its quick fixes carried as
     *           code actions in its `data`. The file it is published for is
     *           `d.loc.file`, which the object does not repeat.
     */
    pub fn dump(d: LspDiagnostic)-> &Config {
        let dmut res = copy Dict();
        res["range"] = JsonExporting::dumpRange(d.loc);
        res["severity"] = copy Int(cast!i64(d.severity));
        res["source"] = copy Str("ymirc");
        res["message"] = copy Str(d.msg);
        if (d.code != code::NO_CODE) {
            res["code"] = copy Str(code::codeStr(d.code));
        }

        if (d.related.len != 0us) {
            let dmut related = copy Array();
            for r in d.related {
                let dmut info = copy Dict();
                info["location"] = JsonExporting::dumpLocation(r.loc);
                info["message"] = copy Str(r.msg);
                related:.push(info);
            }

            res["relatedInformation"] = related;
        }

        if (d.fixes.len != 0us) {
            let dmut actions = copy Array();
            for f in d.fixes {
                actions:.push(JsonExporting::dumpQuickFix(f));
            }

            let dmut data = copy Dict();
            data["fixes"] = actions;
            res["data"] = data;
        }

        res
    }

    /**
     * @returns: the `file` URI of an absolute path, percent-encoding every byte
     *           that is not unreserved.
     */
    pub fn uri(path: [c8])-> [c8] {
        let hex = "0123456789ABCDEF";
        let mut res = "file://";
        for c in path {
            let b = cast!u8(c);
            let keep = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')
                || c == '/' || c == '-' || c == '.' || c == '_' || c == '~';

            if (keep) {
                res ~= [c];
            } else {
                res ~= ['%'c8, hex[cast!usize(b >> 4u8)], hex[cast!usize(b & 0x0Fu8)]];
            }
        }

        res
    }

    /**
     * @returns: the LSP `CodeAction` of a quick fix.
     */
    fn dumpQuickFix(f: QuickFix)-> &Config {
        let mut byFile: [[c8] => mut [&Config]] = copy [];
        for e in f.edits {
            let dmut edit = copy Dict();
            edit["range"] = JsonExporting::dumpRange(e.loc);
            edit["newText"] = copy Str(e.newText);

            let uri = JsonExporting::uri(e.loc.file);
            let prev = if let Ok(a) = byFile[uri] { a } else { [] };
            byFile[uri] = prev ~ [edit];
        }

        let dmut changes = copy Dict();
        for uri, edits in byFile {
            let dmut arr = copy Array();
            for x in edits {
                arr:.push(x);
            }

            changes[uri] = arr;
        }

        let dmut workspace = copy Dict();
        workspace["changes"] = changes;

        let dmut res = copy Dict();
        res["title"] = copy Str(f.title);
        res["kind"] = copy Str("quickfix");
        res["edit"] = workspace;
        res
    }

    fn dumpLocation(loc: Location)-> &Config {
        let dmut res = copy Dict();
        res["uri"] = copy Str(JsonExporting::uri(loc.file));
        res["range"] = JsonExporting::dumpRange(loc);
        res
    }

    fn dumpRange(loc: Location)-> &Config {
        let dmut res = copy Dict();
        res["start"] = JsonExporting::dumpPosition(loc.start);
        res["end"] = JsonExporting::dumpPosition(loc.end);
        res
    }

    fn dumpPosition(p: Position)-> &Config {
        let dmut res = copy Dict();
        res["line"] = copy Int(cast!i64(p.line));
        res["character"] = copy Int(cast!i64(p.character));
        res
    }
}
