in location;

use ymirc::errors::lsp::place;
use ymirc::lexing::word;

/**
 * A range of a file, `end` exclusive, in an empty `file` when the diagnostic
 * names no place of the source.
 */
@data
pub record Location {
    let file: [c8];
    let start: Position;
    let end: Position;

    /**
     * The range from the start of `first` to the end of `last`, the end of
     * `first` when `last` is not a place of the same file.
     */
    pub self (first: &Word, last: &Word, encoding: PositionEncoding)
        with file = fileOf(first)
        , start = startOf(first, encoding)
        , end = endOf(first, last, encoding)
    {}
}

/**
 * @returns: the file of the range starting at `first`.
 */
fn fileOf(first: &Word)-> [c8] {
    if (!isPlaced(first)) return "";
    first.filename
}

/**
 * @returns: the start of the range starting at `first`.
 */
fn startOf(first: &Word, encoding: PositionEncoding)-> Position {
    if (!isPlaced(first)) return Position(0u64, 0u64);
    Position(first, 0us, encoding)
}

/**
 * @returns: the end of the range from `first` to `last`.
 */
fn endOf(first: &Word, last: &Word, encoding: PositionEncoding)-> Position {
    if (!isPlaced(first)) return Position(0u64, 0u64);
    if (isPlaced(last) && last.filename == first.filename && !last.isSameLoc(first)) {
        return Position(last, last.len, encoding);
    }

    Position(first, first.len, encoding)
}
