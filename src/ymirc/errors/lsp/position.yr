in position;

use ymirc::lexing::word;

/**
 * A position in a file, both zero based.
 */
@data
pub record Position {
    let line: u64;
    let character: u64;

    /**
     * The position `offset` bytes after the start of `loc`, never past the end
     * of the file.
     */
    pub self (loc: &Word, offset: usize, encoding: PositionEncoding)
        with line = loc.line - 1u64 + countLines(loc.fileContent[startOf(loc) .. stopOf(loc, offset)])
        , character = countUnits(loc.fileContent[lineStartOf(loc, offset) .. stopOf(loc, offset)], encoding)
    {}
}

/**
 * @returns: the offset of the start of `loc` in its file.
 */
fn startOf(loc: &Word)-> usize {
    loc.lineSeek + cast!usize(loc.col) - 1us
}

/**
 * @returns: the offset `offset` bytes after the start of `loc`, never past the
 *           end of the file.
 */
fn stopOf(loc: &Word, offset: usize)-> usize {
    let stop = startOf(loc) + offset;
    if (stop > loc.fileContent.len) { loc.fileContent.len } else { stop }
}

/**
 * @returns: the offset of the start of the line `stopOf(loc, offset)` is in.
 */
fn lineStartOf(loc: &Word, offset: usize)-> usize {
    let begin = startOf(loc);
    let mut i = stopOf(loc, offset);
    while i > begin {
        if (loc.fileContent[i - 1us] == '\n') return i;
        i -= 1us;
    }

    loc.lineSeek
}

/**
 * @returns: the number of line breaks in `txt`.
 */
fn countLines(txt: [c8])-> u64 {
    let mut res = 0u64;
    for c in txt if c == '\n' {
        res += 1u64;
    }

    res
}

/**
 * @returns: the number of code units `txt` is made of in `encoding`.
 */
fn countUnits(txt: [c8], encoding: PositionEncoding)-> u64 {
    if (encoding == PositionEncoding::UTF8) return cast!u64(txt.len);

    // a code point encoded on four bytes is a surrogate pair
    let mut res = 0u64;
    for c in txt {
        let b = cast!u8(c);
        if ((b & 0xC0u8) != 0x80u8) {
            res += if (b >= 0xF0u8) { 2u64 } else { 1u64 };
        }
    }

    res
}
