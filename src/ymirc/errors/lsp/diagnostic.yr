in diagnostic;

/**
 * One failure of a diagnostic tree, as an LSP `Diagnostic`.
 */
@data
pub record LspDiagnostic {
    let loc: Location;
    let severity: DiagnosticSeverity;

    // The stable code of the diagnostic, NO_CODE when it carries none
    let code: i32;

    let msg: [c8];

    // The places the notes and the context frames name, innermost first
    let related: [RelatedInfo];

    let fixes: [QuickFix];
}
