 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in diagnostic;

use ymirc::errors::message;
use ymirc::global::state;
use ymirc::utils::_;

use std::io;

/**
 * The diagnostics reported since the last reset.
 *
 * They are kept after being printed, so that a driver, or a test, can read
 * back what the compilation warned about.
 */
lazy dmut __REPORTED__: [[&message::ErrorMsg]] = copy [[]];

/**
 * @params:
 *   - err: a raised diagnostic
 * @returns: true if 'err' must abort the compilation
 */
pub fn isFatal(err: &message::ErrorMsg)-> bool {
    !(err.isWarning && state::isDebugActive())
}

/**
 * Report a non fatal diagnostic: print it, and keep it for 'reported'.
 */
pub fn report(err: &message::ErrorMsg) {
    __REPORTED__[0] = __REPORTED__[0] ~ [err];
    eprintln(format("%", err));
}

/**
 * Raise a diagnostic, throwing it if it is fatal, reporting it otherwise.
 * @throws:
 *   - &ErrorMsg: if 'err' aborts the compilation
 */
pub fn raise(err: &message::ErrorMsg)
    throws message::ErrorMsg
{
    if isFatal(err) throw err;
    report(err);
}

/**
 * Report the non fatal diagnostics of 'errs'.
 * @returns: the ones that are left to be thrown
 */
pub fn raiseAll(errs: [&message::ErrorMsg])-> [&message::ErrorMsg] {
    let mut fatals: [&message::ErrorMsg] = [];
    for e in errs {
        if isFatal(e) { fatals ~= [e]; }
        else { report(e); }
    }

    fatals
}

/**
 * @returns: the diagnostics reported since the last reset
 */
pub fn reported()-> [&message::ErrorMsg] {
    __REPORTED__[0]
}

/**
 * Forget the reported diagnostics, at the start of a compilation.
 */
pub fn resetToDefault() {
    __REPORTED__[0] = [];
}
