 *
 *   Ymir is free software: you can redistribute it and/or modify it
 *   under the terms of the GNU General Public License as published by
 *   the Free Software Foundation, either version 3 of the License, or
 *   (at your option) any later version.
 *
 *   Ymir is distributed in the hope that it will be useful,
 *   but WITHOUT ANY WARRANTY; without even the implied warranty of
 *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 *   GNU General Public License for more details.
 *
 *   You should have received a copy of the GNU General Public License
 *   along with Ymir.  If not, see <https://www.gnu.org/licenses/>.
 *   ```
 */

in diagnostic;

use ymirc::global::state;
use ymirc::lexing::word;
use ymirc::utils::format;

use std::io;

/**
 * The message of the error stopping a cancelled compilation.
 */
pub def CANCELLED = "the compilation was cancelled";

/**
 * The diagnostics reported since the last reset.
 *
 * They are kept after being printed, so that a driver, or a test, can read
 * back what the compilation warned about.
 *
 * @info: thread local, a compilation reading back the diagnostics it reported
 * itself rather than those of a compilation running beside it.
 */
@thread
lazy mut __REPORTED__: [mut [&message::ErrorMsg]] = copy [[]];

/**
 * The fatal errors the compilation carried on past since the last reset, cf.
 * 'defer'.
 *
 * @info: thread local, cf. __REPORTED__.
 */
@thread
lazy mut __DEFERRED__: [mut [&message::ErrorMsg]] = copy [[]];

/**
 * @params:
 *   - err: a raised diagnostic
 * @returns: true if 'err' must abort the compilation
 */
pub fn isFatal(err: &message::ErrorMsg)-> bool {
    !(err.isWarning && state::isDebugActive())
}

/**
 * Report a non fatal diagnostic: print it, and keep it for 'reported'.
 * @info: printed in a single write, so that it is not interleaved with the
 * diagnostics of a compilation sharing the same stderr.
 */
pub fn report(err: &message::ErrorMsg) {
    __REPORTED__[0] = __REPORTED__[0] ~ [err];
    eprint(format("%", err) ~ "\n");
}

/**
 * Raise a diagnostic, throwing it if it is fatal, reporting it otherwise.
 * @throws:
 *   - &ErrorMsg: if 'err' aborts the compilation
 */
pub fn raise(err: &message::ErrorMsg)
    throws message::ErrorMsg
{
    if isFatal(err) throw err;
    report(err);
}

/**
 * Report the non fatal diagnostics of 'errs'.
 * @returns: the ones that are left to be thrown
 */
pub fn raiseAll(errs: [&message::ErrorMsg])-> [&message::ErrorMsg] {
    let mut fatals: [&message::ErrorMsg] = [];
    for e in errs {
        if isFatal(e) { fatals ~= [e]; }
        else { report(e); }
    }

    fatals
}

/**
 * Defer a fatal error to the end of the compilation, which carries on past it
 * and fails once over.
 */
pub fn defer(err: &message::ErrorMsg) {
    __DEFERRED__[0] = __DEFERRED__[0] ~ [err];
}

/**
 * @returns: the errors deferred since the last reset, in the order they were raised
 */
pub fn deferred()-> [&message::ErrorMsg] {
    __DEFERRED__[0]
}

/**
 * @returns: the diagnostics reported since the last reset
 */
pub fn reported()-> [&message::ErrorMsg] {
    __REPORTED__[0]
}

/**
 * @returns: the reported and the deferred diagnostics, to be restored by `restore`
 */
pub fn save()-> ([&message::ErrorMsg], [&message::ErrorMsg]) {
    (__REPORTED__[0], __DEFERRED__[0])
}

/**
 * Restore the reported and the deferred diagnostics `save` returned
 */
pub fn restore(saved: ([&message::ErrorMsg], [&message::ErrorMsg])) {
    __REPORTED__[0] = saved._0;
    __DEFERRED__[0] = saved._1;
}

/**
 * @returns: the error stopping the compilation, if it was asked to stop, cf. `state::CancellationToken`
 */
pub fn cancellation()-> (&message::ErrorMsg)? {
    if (state::isCancelled()) {
        return (copy message::ErrorMsg::fatal(word::EOF_WORD, CANCELLED, oneLine-> true))?;
    }

    none
}

/**
 * Stop the compilation if it was asked to, cf. `state::CancellationToken`
 * @throws:
 *   - &ErrorMsg: if the compilation was cancelled
 */
pub fn checkCancelled()
    throws message::ErrorMsg
{
    if let Ok(err) = cancellation() {
        throw err;
    }
}

/**
 * Forget the reported and deferred diagnostics, at the start of a compilation.
 */
pub fn resetToDefault() {
    __REPORTED__[0] = [];
    __DEFERRED__[0] = [];
}
