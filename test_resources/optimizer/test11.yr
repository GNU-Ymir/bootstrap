// the environment is dropped at a handler boundary (YMI-78): the guard is
// entered from anywhere in the part it protects, `bar` throwing before `b = a`
// ran, so what the body it protects knows is not known in the guard.
fn bar ()
    throws AssertError;

fn baz (i : i32);

fn foo (x : i32)
    throws AssertError
{
    let mut a = x + 1;
    let mut b = 0;

    {
        bar ();
        b = a;
    } exit {
        baz (b);
    }

    baz (b);
}
