// devirtualization (YMI-19): the receiver is reassigned in a branch, the instance
// the call is made on is not the one it was allocated with, the call stays virtual
class A {
    pub self () {}
    pub fn foo (self)-> i32 { 1 }
}

class B over A {
    pub self () {}
    pub over foo (self)-> i32 { 2 }
}

fn foo (c : bool)-> i32 {
    let mut a : &A = copy A ();
    if (c) {
        a = copy B ();
    }

    a.foo ()
}
