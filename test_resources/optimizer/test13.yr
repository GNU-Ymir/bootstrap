// a read through a pointer is not moved (YMI-78): nothing says what writes the
// memory it reads, and `bar` is free to write it, so the temporary holding the
// read stays before the call.
fn bar ()-> i32;

fn add (a : i32, b : i32)-> i32 {
    a + b
}

fn foo ()-> i32 {
    let mut v = 12;
    let p = &v;

    add (unsafe { *p }, bar ())
}
