// constant folding (YMI-21): what traps or is undefined at runtime is left to the
// runtime, a division by zero, the overflowing division and a shift past the width
fn foo ()-> i32 {
    let mut x = 1, mut z = 0;
    x / z
}

fn bar ()-> i32 {
    let mut x = -2147483648, mut y = -1;
    x / y
}

fn baz ()-> u32 {
    let mut x = 1u32, mut s = 32u32;
    x << s
}
