// dead code elimination and CFG cleanup (YMI-79): the store to 'dead' is never
// read, both arms of the branch return so the jumps to the block joining them
// are never taken and the label naming it is named by nothing left
fn foo (x : i32)-> i32 {
    let mut dead = 42;

    if x > 0 {
        dead = 12;
        return x;
    } else {
        return 0;
    }
}
