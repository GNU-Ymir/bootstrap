// bounds check elimination behind a negated guard (YMI-161): a negated bool is a
// `^ 1`, on both edges the guard still bounds the index
fn foo (a : [i32], i : usize)-> i32 {
    if (!(i < a.len)) { return 0; }
    a [i]
}

fn bar (a : [i32], i : usize)-> i32 {
    if (!(i >= a.len)) { return a [i]; }
    0
}
