// devirtualization (YMI-19): the instance is allocated at each iteration, always
// with the same vtable, the call made on it is direct
class A {
    pub self () {}
    pub fn foo (self)-> i32 { 1 }
}

fn foo (n : i32)-> i32 {
    let mut s = 0;
    for _ in 0 .. n {
        let a = copy A ();
        s += a.foo ();
    }

    s
}
