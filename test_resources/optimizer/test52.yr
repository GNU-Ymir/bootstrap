// no elision of a copy of an array of another type (YMI-184): the elements of the
// array are written as the class it holds, and read through the slice as its ancestor
class A {
    pub self () {}
}

class B over A {
    pub self () {}
}

fn foo (b: &B)-> &A {
    let s: [&A] = copy [b];
    s[0]
}
