// destructor and try/finally elision (YMI-17): the destructor of the entity
// does nothing, so the block scheduling it schedules nothing, and the finally
// part that block was the whole of goes with it
entity Handle {
    pub let value : i32;

    pub self (v : i32) with value = v {}

    __dtor (mut self) {}
}

fn foo ()-> i32 {
    let h = Handle (42);

    h.value
}
