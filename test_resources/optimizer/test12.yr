// a division is not moved (YMI-78): the trap it raises when `x` is zero must
// not cross the call the second argument makes, so the temporary holding it
// stays where it is written.
fn bar ()-> i32;

fn add (a : i32, b : i32)-> i32 {
    a + b
}

fn foo (x : i32)-> i32 {
    add (100 / x, bar ())
}
