// the exception the handler rethrows is still assigned (YMI-95): the edge a
// handler is entered by leaves from the middle of the closing instruction, so
// the liveness carries what that instruction writes back over it -- but what it
// reads it reads before it can throw, so `err` is live at the top of the block
// rethrowing it, and the store defining it is not a dead one.
class MyErr over Exception {
    pub self () {}
}

fn inner ()
    throws MyErr
{
    throw copy MyErr ();
}

fn foo ()
    throws MyErr
{
    {
        inner ();
    } catch {
        err : &MyErr => {
            throw err;
        }
    } exit {
        _yrt_nothing ();
    }
}

extern (C) fn _yrt_nothing ();
