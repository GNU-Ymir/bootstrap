// destructor and try/finally elision (YMI-17): `compute` is a frame of another
// module, so the region can be left by an exception, and the pad running the
// destructor on that way out is one the frame does need
entity Handle {
    pub let value : i32;

    pub self (v : i32) with value = v {}

    __dtor (mut self) {
        release ();
    }
}

fn release ();

fn compute ()-> i32;

fn foo ()-> i32 {
    let h = Handle (42);

    h.value + compute ()
}
