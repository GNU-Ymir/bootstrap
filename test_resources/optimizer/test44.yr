// comparison folding (YMI-21): a folded condition is a jump dead code elimination
// decides, except on a literal other than 0 and 1, which the backend narrows
fn foo ()-> i32 {
    let mut n = 3;
    if (n < 2) { return 1; }
    0
}

fn bar ()-> i32 {
    let mut b = true;
    if (!b) { return 1; }
    0
}
