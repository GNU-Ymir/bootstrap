// no elision across a refill (YMI-18): the literal is refilled on each iteration
// while the copy an earlier one made is still read
fn foo ()-> i32 {
    let mut prev = copy [0];
    let mut s = 0;
    for i in 0 .. 3 {
        let dmut b = copy [1, 2, 3];
        b[0] = i;
        if (i == 0) { prev = b; }
        s = s + prev[0];
    }

    s
}
