// destructor and try/finally elision (YMI-17): the destructor does something,
// so the block scheduling it stays -- but nothing the region it protects does
// can throw, and the block is then only ever reached on the normal path, which
// is the pad and not the scheduling being what the frame does not need
entity Handle {
    pub let value : i32;

    pub self (v : i32) with value = v {}

    __dtor (mut self) {
        release ();
    }
}

fn release ();

fn foo ()-> i32 {
    let h = Handle (42);

    h.value
}
