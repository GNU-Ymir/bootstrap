// no stack promotion of a slice of another type (YMI-184): its elements are written
// as the class they repeat, and read through the slice as its ancestor
class A {
    pub self () {}
}

class B over A {
    pub self () {}
}

fn foo (b: &B)-> &A {
    let n = 4us;
    let s: [&A] = copy [b; n];
    s[0]
}
