// the environment is dropped at a label and at a jump (YMI-78): `b` holds `a`
// where the loop is entered, and no longer holds it where it is left, so the
// test of the loop and the read behind it name `b`.
fn foo (x : i32)-> i32 {
    let mut a = x + 1;
    let mut b = a;

    while b < 100 {
        b = b + a;
    }

    b
}
