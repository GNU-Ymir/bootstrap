// devirtualization (YMI-19): the receiver is handed by reference to a function that
// may reassign it, the call stays virtual
class A {
    pub self () {}
    pub fn foo (self)-> i32 { 1 }
}

class B over A {
    pub self () {}
    pub over foo (self)-> i32 { 2 }
}

fn reset (ref mut a : &A) {
    a = copy B ();
}

fn foo ()-> i32 {
    let mut a : &A = copy A ();
    reset (ref a);

    a.foo ()
}
