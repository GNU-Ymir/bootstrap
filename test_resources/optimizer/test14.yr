// a value is not moved into a destination of another type (YMI-78): YIL types
// are looser than the backend's, the address arithmetic an index computes is
// not typed the way the pointer it is assigned to is, and substituting one for
// the other would move that difference to a place nothing checked it in.
fn foo (a : [i32])-> i32 {
    a [0]
}
