// no elision of a copy made in a loop (YMI-18): the array is filled once, before
// the loop, and every iteration writes to the copy it made
fn foo ()-> i32 {
    let a = [1, 2, 3];
    let mut s = 0;
    for _ in 0 .. 3 {
        let dmut b = copy a;
        s = s + b[0];
        b[0] = 9;
    }

    s
}
