// cast simplification (YMI-21): a chain of integer casts one cast does the same
// as is merged, a sign extension widened again is not, a literal is converted
fn foo (x : u8)-> u64 {
    cast!u64 (cast!u32 (x))
}

fn bar (x : u64)-> u8 {
    cast!u8 (cast!u32 (x))
}

fn baz (x : i8)-> u64 {
    cast!u64 (cast!u32 (x))
}

fn qux ()-> u8 {
    let mut x = 300u32;
    cast!u8 (x)
}
