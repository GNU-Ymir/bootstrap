// no coalescing of a value reading a global (YMI-78): the frame does not track
// `X`, so no write to it is ever recorded as a def, and nothing would invalidate
// a remembered `X + 1`. The temporary holding it must stay where it is written,
// before the assignment to `X` the second argument makes.
extern (C) static mut X : i32;

fn add (a : i32, b : i32)-> i32 {
    a + b
}

fn foo ()-> i32 {
    add (X + 1, { X = 5; 2 })
}
