// constant folding (YMI-21): a literal propagated into an operation is folded,
// wrapped around the width of its type the way the runtime wraps it
fn foo ()-> u8 {
    let mut x = 250u8;
    x + 10u8
}

fn bar ()-> i8 {
    let mut x = 127i8;
    x + 1i8
}

fn baz ()-> i32 {
    let mut x = -7;
    (x / 2) + (x % 2) + (x >> 1)
}
