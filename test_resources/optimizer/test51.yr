// indirect call promotion (YMI-19): a delegate the frame built is called by name,
// the one a function receives as a parameter is still called through its pointer
fn apply (f : dg (i32)-> i32, x : i32)-> i32 {
    f (x)
}

fn foo (y : i32)-> i32 {
    let f : dg (i32)-> i32 = copy |x : i32| => x + y;

    f (2) + apply (f, 3)
}
