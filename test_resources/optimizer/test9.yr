// no substitution under a `&` (YMI-78): the reads of `b` are renamed to the `a`
// it was copied from, but `&b` names the storage of `b`, and the storage of a
// copy of a variable is another one than the storage of the variable.
fn foo (x : i32)-> i32 {
    let mut a = x;
    let mut b = a;

    let p = &b;
    b = 7;

    unsafe { *p }
}
