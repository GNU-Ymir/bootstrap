// The cast composes with the other implicit casts: a record field that
// is itself a record, a record inside a tuple, an option, and the
// value of a block or of a conditional.

@data
record X {
    let x: i32;
    let y: f32;
}

@data
record Y {
    let a: X;
    let b: i32;
}

fn cond ()-> bool {
    true
}

fn main () {
    let a: Y = ((1, 2.0f), 3);
    let b: (X, i32) = ((4, 5.0f), 6);
    let c: X? = (7, 8.0f)?;

    let d: X = {
        let z = 9;
        (z, 10.0f)
    };

    let e: X = if (cond ()) { (11, 12.0f) } else { (13, 14.0f) };

    a.b;
    b.1;
    c;
    d.x;
    e.x;
}
