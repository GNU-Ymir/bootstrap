// The cast applies to the arguments of a call, to the value of a
// closure and to the element of an iterated collection.

@data
record X {
    let x: i32;
    let y: f32;
}

fn bar (v: X)-> i32 {
    v.x
}

fn main () {
    bar ((1, 2.0f));

    let t = (3, 4.0f);
    bar (t);

    let f = |x: i32| => {
        let r: X = (x, 5.0f);
        r
    };
    f (6);

    for i in [(7, 8.0f), (9, 10.0f)] {
        let e: X = i;
        e.x;
    }
}
