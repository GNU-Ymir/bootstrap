// The cast applies wherever an implicit cast applies: variable
// declaration, assignment, and from a tuple that is not a literal.

record X {
    pub let mut x: i32;
    pub let mut y: f32;

    pub self;
}

fn main () {
    let a: X = (1, 2.0f);

    let t = (3, 4.0f);
    let b: X = t;

    let mut c = X (0, 0.0f);
    c = (5, 6.0f);

    a.x;
    b.x;
    c.x;
}
