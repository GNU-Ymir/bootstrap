// The tuple must match a constructor exactly: the arity is the arity of
// the constructor (defaulted fields included), and no implicit
// conversion is invented between the element types and the parameters.

@data
record X {
    let x: i32;
    let y: f32;
}

@data
record D {
    let x: i32 = 8;
    let y: f32 = 3.0f;
}

fn main () {
    let a: X = (1, 2.0f, 3);
    let b: X = (1, "hello");
    let c: X = (1, 2);
    let d: D = (1,);

    a;
    b;
    c;
    d;
}
