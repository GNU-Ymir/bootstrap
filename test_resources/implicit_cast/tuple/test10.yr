// The memory model is not bypassed by the cast: a tuple holding a
// mutable slice cannot be given to a record borrowing it without an
// explicit alias on the element.

record X {
    pub let dmut b: [i32];

    pub self (dmut b: [i32]) with b = alias b {}
}

fn main () {
    let dmut s = copy [1, 2, 3];
    let t = (alias s,);

    let a: X = t;

    a;
}
