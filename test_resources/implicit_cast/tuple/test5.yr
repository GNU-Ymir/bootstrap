// The tuple is passed to a constructor, so the constructor is what
// decides the meaning of each element: a user defined constructor may
// reorder them, and overloads are resolved on the element types.

record P {
    pub let x: i32;
    pub let y: f32;

    // the tuple elements are matched against the ctor parameters, not
    // against the fields, so (2.0f, 1) builds x = 1, y = 2.0f
    pub self (y: f32, x: i32) with x = x, y = y {}
}

record O {
    pub let x: i32;
    pub let y: f32;

    pub self (x: i32, y: f32) with x = x, y = y {}
    pub self (y: f32, x: i32) with x = x, y = y {}
}

@data
record S {
    let x: i32;
}

fn main () {
    let a: P = (2.0f, 1);
    let b: O = (3, 4.0f);
    let c: O = (5.0f, 6);
    let d: S = (7,);

    a.x;
    b.x;
    c.x;
    d.x;
}
