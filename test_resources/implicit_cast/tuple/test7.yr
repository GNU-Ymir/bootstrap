// The cast goes through the constructor, so the memory model is
// enforced on the elements: a mutable slice must be explicitly aliased
// inside the tuple to be given to the record.

record X {
    pub let a: i32;
    pub let dmut b: [i32];

    pub self (a: i32, dmut b: [i32])
        with a = a
        , b = alias b
    {}
}

fn main () {
    let dmut s = copy [1, 2, 3];
    let x: X = (4, alias s);

    x.a;
}
