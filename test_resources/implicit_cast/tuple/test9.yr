// Only a record is built from a tuple, and only from a tuple: a class
// and an entity are left alone, and a record is not built from another
// record of the same shape.

class C {
    pub let x: i32;
    pub let y: f32;

    pub self (x: i32, y: f32) with x = x, y = y {}
}

entity E {
    pub let x: i32 = 0;
}

@data
record X {
    let x: i32;
    let y: f32;
}

@data
record Y {
    let x: i32;
    let y: f32;
}

fn main () {
    let a: &C = (1, 2.0f);
    let b: E = (3,);
    let c: Y = X (4, 5.0f);

    a;
    b;
    c;
}
