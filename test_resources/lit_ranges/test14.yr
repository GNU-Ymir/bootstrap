// membership follows the direction of the step, as iteration does
fn main () {
    cte assert (3 in 0 .. 4);
    cte assert (4 !in 0 .. 4);
    cte assert (4 in 0 ... 4);
    cte assert (3 !in 10 .. 4);

    cte assert (9 in (0 .. 10).reverse ());
    cte assert (0 in (0 .. 10).reverse ());
    cte assert (10 !in (0 .. 10).reverse ());
}
