// a range never iterates backwards: its bounds going down make it empty
fn main () {
    cte assert ((10 .. 0).len == 0us);
    cte assert ((10 ... 0).len == 0us);
    cte assert ((0 .. 0).len == 0us);
    cte assert ((0 ... 0).len == 1us);
    cte assert ((-5 .. 5).len == 10us);
    cte assert ((-5 ... 5).len == 11us);

    for i in 4us .. 0us {
        i;
    }
}
