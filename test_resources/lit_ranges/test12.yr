// reverse yields the same elements, from the last one reached down to the first
fn main () {
    cte assert ((0 .. 10).reverse ().fst == 9);
    cte assert ((0 .. 10).reverse ().scd == 0);
    cte assert ((0 .. 10).reverse ().len == 10us);

    cte assert ((0 ... 10).reverse ().fst == 10);
    cte assert ((0 ... 10).reverse ().len == 11us);

    cte assert ((-5 .. 5).reverse ().fst == 4);
    cte assert ((-5 .. 5).reverse ().scd == -5);

    cte assert ((0 .. 10).reverse ().reverse ().fst == 0);
    cte assert ((0 .. 10).reverse ().reverse ().scd == 9);
    cte assert ((0 .. 10).reverse ().reverse ().len == 10us);
}
