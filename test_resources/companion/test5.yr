in test5;

class X {
    prv let _x: i32;

    pub self (x: i32)
        with _x = x
    {}
}

@companion
mod X {
    pub fn viaLambda (x: &X)-> i32 {
        let f = |y: &X| => y._x;
        f (x)
    }

    pub mod Inner {
        pub fn get (x: &X)-> i32 {
            x._x
        }
    }
}

fn main () {
    let x = copy X (1);
    let _ : i32 = X::viaLambda (x) + X::Inner::get (x);
}
