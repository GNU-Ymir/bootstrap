in test4;

class Base {
    prot let _b: i32;

    pub self (b: i32)
        with _b = b
    {}
}

class X over Base {
    prv let _x: i32;

    pub self (b: i32, x: i32)
        with super (b), _x = x
    {}
}

@companion
mod X {
    pub fn sum (x: &X)-> i32 {
        x._x + x._b
    }
}

fn main () {
    let _ : i32 = X::sum (copy X (1, 2));
}
