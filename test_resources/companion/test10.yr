in test10;

class Base {
    prv let _b: i32;

    pub self (b: i32)
        with _b = b
    {}
}

class X over Base {
    pub self (b: i32)
        with super (b)
    {}
}

@companion
mod X {
    pub fn get (x: &X)-> i32 {
        x._b
    }
}

fn main () {
    let _ : i32 = X::get (copy X (1));
}
