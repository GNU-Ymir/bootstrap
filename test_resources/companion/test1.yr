in test1;

class X {
    prv let _x: i32;

    prv self (x: i32)
        with _x = x
    {}

    prv fn secret (self)-> i32 {
        self._x
    }
}

@companion
mod X {
    pub fn new (x: i32)-> &X {
        copy X (x)
    }

    pub fn get (x: &X)-> i32 {
        x._x + x.secret ()
    }
}

fn main () {
    let x = X::new (12);
    let _ : i32 = X::get (x);
}
