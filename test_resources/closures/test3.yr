// a value with a destructor cannot be enclosed, however deep the closure capturing it
entity Handle {
    pub let x: i32 = 1;
    pub self () {}
    __dtor (mut self) {}
}

fn main () {
    let h = Handle ();
    let f = copy |x: i32| => {
        let g = copy |y: i32| => h.x + y;
        g (x)
    };
    let _: i32 = f (2);
}
