// a local captured three levels down, through a closure that does not use it,
// and a local used by both the outer and the inner closure, captured once by each
fn main () {
    let k = 3;
    let j = 4;
    let f = copy |x: i32| => {
        let g = copy |y: i32| => {
            let h = copy |z: i32| => x + y + z + j + k;
            h (y) + k
        };
        g (1) + k
    };
    let _: i32 = f (2);
}
