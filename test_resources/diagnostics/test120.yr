// an impl block overriding a method that is not part of the trait
trait Shape {
    pub fn area (self)-> i32;
}

class Square {
    pub self () {}
    pub fn side (self)-> i32 { 1 }

    impl Shape {
        pub over area (self)-> i32 { 1 }
        pub over side (self)-> i32 { 2 }
    }
}

fn main () {
    let _ = copy Square ();
}
