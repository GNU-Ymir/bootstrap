// a catch pattern for an exception the guarded block cannot throw
class First over Exception {
    pub self () {}
}

class Second over Exception {
    pub self () {}
}

class Other over Exception {
    pub self () {}
}

fn foo (i : i32)-> i32
    throws First, Second;

fn main () {
    let _ = {
        foo (0)
    } catch {
        Other () => { 1 }
        First () => { 2 }
        Second () => { 3 }
    };
}
