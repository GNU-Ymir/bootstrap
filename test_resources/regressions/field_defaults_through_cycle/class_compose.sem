frame: test2::compose::Compose::self (mut self: mut &(mut test2::compose::Compose), next: (dg ()-> void)[nullable])-> void {
    {
        self._x = 0u32;
        if (next.func != null) (next.func)(next.closure)
    };
    <unit-value>
}
frame: test2::compose::Compose::render (self: &(test2::compose::Compose), n: &(test2::node::Node))-> u32 return {
    (self._x + test2::node::Node::depth(n))
}
