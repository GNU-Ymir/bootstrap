in test1;

/**
 * An enum may use another enum as its proxy type. Unwrapping such a chain
 * down to the innermost non-enum type must terminate, whatever its depth.
 */

enum Base : [c8]
| A = "a";

enum Mid : Base
| B = Base::A;

enum Top : Mid
| C = Mid::B;

class Z {
    pub let f : Top = Top::C;

    pub self () {}
}

fn main () {
    let _ = copy Z ();
}
