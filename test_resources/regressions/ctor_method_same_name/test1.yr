class A {
    let mut x: i32 = 0;

    pub self make () {
        self:.make ();
    }

    prv fn make (mut self) {
        self.x = 1;
    }
}

class B {
    let mut x: i32 = 0;

    prv fn make (mut self) {
        self.x = 2;
    }

    pub self make () {
        self:.make ();
    }
}

fn main () {
    let _ = A::make ();
    let _ = B::make ();
}
