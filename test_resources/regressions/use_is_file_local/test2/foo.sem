frame: foo::bar::inBar ()-> void {
    std::io::println!{[c8]}::println ("in bar"s8);
    <unit-value>
}
frame: [weak] std::io::println!{[c8]}::println (a: [c8])-> void {
    std::io::utils::flockfile (std::io::utils::_yrt_stdout ());
    std::io::print (a);
    std::io::utils::putc ('\n'c8, std::io::utils::_yrt_stdout ());
    std::io::utils::funlockfile (std::io::utils::_yrt_stdout ());
    <unit-value>
}
