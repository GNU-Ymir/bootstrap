record X {
    pub let a : i32;
    pub let b : i32;

    pub self (a : i32, b : i32)
        with a = a
        , b = b
    {}
}

fn foo (a : i32) {
    a;
}

fn main () {
    let x = X (1, 2);

    // 'typeof (x)' is a full operand, the '::' and '.' apply to the type it produces
    cte for i in 0us .. typeof (x)::field_infos.len {
        foo (__pragma!field (x, cte {typeof (x)::field_infos [i].name}));
    }

    // no parenthesis, the operand of the typeof is the whole expression 'x.a'
    let _a_ : typeof x.a = 12;

    let _b_ = typeof (x)::typeid;
    let _c_ = (typeof (x.a))::size;
}
