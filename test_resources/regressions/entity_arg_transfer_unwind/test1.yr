fn release (_ : i32);

fn mightThrow ()-> i32
    throws AssertError
{
    throw copy AssertError ("");
}

entity A {
    pub let ptr : i32 = 0;
    pub self () {}
    pub self (i : i32) with ptr = i {}
    __dtor (mut self) { release (self.ptr); }
}

fn consume (mut a : A, i : i32)-> i32 {
    release (a.ptr);
    i
}

fn main ()
    throws AssertError
{
    let mut a = A (10);

    // 'move a' hands the original contents to a temporary, then 'mightThrow' runs before
    // the call is entered: the temporary must still be destroyed if it escapes there.
    release (consume (move a, mightThrow ()));
}
