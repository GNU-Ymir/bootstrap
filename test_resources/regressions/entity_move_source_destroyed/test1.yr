fn release (_ : i32);

entity A {
    pub let ptr : i32 = 0;

    pub self () {}

    pub self (i : i32)
        with ptr = i
    {}

    __dtor (mut self) {
        release (self.ptr);
    }
}

fn main () {
    let mut a = A (10);
    let b = move a; // b = a; a = A ();

    release (b.ptr);
    // 'a' has been reconstructed by the reset ctor, so both 'a' and 'b' are destroyed here
}
