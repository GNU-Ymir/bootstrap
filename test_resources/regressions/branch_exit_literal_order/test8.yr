in test8;

class MyErr over Exception {
    pub self () {}
}

fn bar (b : bool, c : bool)
    throws AssertError, MyErr
{
    if c { throw copy MyErr (); }
    assert (b);
}

fn foo (n : i64, b : bool)-> i64 {
    let z = {
        bar (b, !b);
        1
    } catch {
        _ : &MyErr => { 2 }
        _ : &AssertError => { n }
    };

    z
}
