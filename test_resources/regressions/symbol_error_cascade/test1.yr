// every class using the failing one fails as well, but only the failure of Word is reported
@abstract
class Word {
    pub self () {}
    pub over nothing (self)-> bool { true }
}

class A {
    pub let w: &Word;
    pub self (w: &Word) with w = w {}
}

class B {
    pub let w: &Word;
    pub self (w: &Word) with w = w {}
}

fn main () {
    let _a_: (&A)? = none;
    let _b_: (&B)? = none;
}
