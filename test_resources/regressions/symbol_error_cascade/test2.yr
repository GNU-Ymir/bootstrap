// each class fails through the previous one, and only the failure they all wrap is reported
@abstract
class Word {
    pub self () {}
    pub over nothing (self)-> bool { true }
}

class A {
    pub let w: &Word;
    pub self (w: &Word) with w = w {}
}

class B {
    pub let a: &A;
    pub self (a: &A) with a = a {}
}

class C {
    pub let b: &B;
    pub self (b: &B) with b = b {}
}

fn main () {
    let _c_: (&C)? = none;
}
