/*
 * Every keyword that introduces a declaration(GlobalDeclKeys ~ extern ~ use), written as a
 * string literal in statement position. None of them opens a declaration.
 */
fn main () {
    "def";
    "enum";
    "macro";
    "mod";
    "trait";
    "__test";
    "class";
    "fn";
    "lazy";
    "record";
    "static";
    "entity";
    "union";
    "extern";
    "use";
}
