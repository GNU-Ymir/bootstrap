fn kindOf (value: [c8])-> i32 {
    if value == "class" {
        1
    } else if value == "record" {
        2
    } else {
        0
    }
}

fn main() {
    // keyword contents in statement position, they are string literals, not declarations
    "use";
    "extern";
    "fn";
    "let";

    kindOf("record");
}
