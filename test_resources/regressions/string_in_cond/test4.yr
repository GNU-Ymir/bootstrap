/*
 * Backquoted identifiers are lexed as string words too, so they go through the same keyword
 * dispatch. A symbol named after a keyword is an identifier, not that keyword.
 */
fn `record` ()-> i32 {
    42
}

fn main () {
    let `class` = `record` ();
    let `use` = `class` + 1;

    `use`;
}
