/*
 * Strings whose content is a token rather than a keyword. They must not be accepted by the
 * token readers(readIf/readTokens) as the token they spell.
 */
fn main () {
    let opening = "{";
    let closing = "}";

    let lst = ["(", ")", ";", ",", "::", "=>", "->", "|", "!"];

    // '#' only opens a version block when it is a token, never inside a string
    let version = "#if X86_64";
    let endVersion = "#end";

    (opening, closing, lst, version, endVersion);
}
