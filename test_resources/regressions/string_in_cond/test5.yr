/*
 * Keyword contents in nested expression positions: call arguments, array and tuple literals,
 * match patterns and nested blocks.
 */
fn takes (value: [c8])-> [c8] {
    value
}

fn main () {
    let called = takes ("record");
    let array = ["class", "enum", "trait"];
    let tuple = ("static", "lazy");

    let nested = {
        "entity";
        takes ("union")
    };

    let matched = match called {
        "record" => { 1 }
        "class" => { 2 }
        _ => { 0 }
    };

    (called, array, tuple, nested, matched);
}
