in test4;

class Base {
    prv let _p : i32;
    prot let _q : i32;

    prv fn secret (self)-> i32 {
        self._p
    }

    prot fn helper (self)-> i32 {
        self._q
    }

    pub self (p : i32, q : i32)
        with _p = p, _q = q
    {}
}

class Mid over Base {
    pub self (p : i32, q : i32)
        with super (p, q)
    {}
}

class Leaf over Mid {
    pub self (p : i32, q : i32)
        with super (p, q)
    {}

    pub fn access (self)-> i32 {
        self._q + self.helper ()
    }

    pub fn accessPrivateField (self)-> i32 {
        self._p
    }

    pub fn callPrivateMethod (self)-> i32 {
        self.secret ()
    }
}

fn main () {
    let l = copy Leaf (1, 2);
    let _ = l.access ();
}
