in test3;

class Base {
    prv let _p : i32;

    prv fn secret (self)-> i32 {
        self._p
    }

    pub self (p : i32)
        with _p = p
    {}
}

class Child over Base {
    pub self (p : i32)
        with super (p)
    {}

    pub fn access (self)-> i32 {
        self._p
    }

    pub fn callSecret (self)-> i32 {
        self.secret ()
    }
}

fn main () {
    let c = copy Child (1);
    let _ = c.access ();
    let _ = c.callSecret ();
}
