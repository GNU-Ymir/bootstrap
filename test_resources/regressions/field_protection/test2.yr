in test2;

class Base {
    prot let _q : i32;
    let _r : i32;

    prot fn helper (self)-> i32 {
        self._q
    }

    fn util (self)-> i32 {
        self._r
    }

    pub self (q : i32, r : i32)
        with _q = q, _r = r
    {}
}

class Child over Base {
    pub self (q : i32, r : i32)
        with super (q, r)
    {}

    pub fn access (self)-> i32 {
        self._q + self._r + self.helper () + self.util ()
    }
}

fn main () {
    let c = copy Child (1, 2);
    let _ = c.access ();
}
