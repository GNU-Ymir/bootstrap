in wiring;

use test5::node;

use std::uuid;

pub fn connect(source: &Node, byId: [Uuid => &Node])-> [[c8]] {
    let mut errors: [[c8]] = [];
    for c in source.connections {
        let target = if let Ok(t) = byId[c.target] { t } else {
            errors ~= [f"${c.signal} is connected to #${c.target}"];
            continue;
        };

        let slot = if let Ok(s) = target.slotOf(c.slot) { s } else {
            errors ~= [f"no slot '${c.slot}'"];
            continue;
        };

        errors ~= [slot];
    }

    errors
}
