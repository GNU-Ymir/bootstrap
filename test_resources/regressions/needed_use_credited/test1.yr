// a core type only nameable through a use of a submodule of a core module credits that
// use, in the field of a data record and in a signature
in test1;

use ::core::types::info;

@data
pub record Holder {
    pub let types: [TypeInfo] = [];
}

pub fn first(h: Holder)-> (TypeInfo)? {
    if h.types.len == 0us { return none; }
    (h.types[0])?
}
