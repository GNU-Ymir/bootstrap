fn release (_ : i32);

entity A {
    pub let mut ptr : i32 = 0;

    pub self (i : i32) with ptr = i {}

    __dtor (mut self) { release (self.ptr); }
}

fn make (i : i32)-> i32
    throws AssertError
{
    if (i == 0) throw copy AssertError ("");
    i
}

fn main ()
    throws AssertError
{
    let mut a = A (1);

    // the argument of the reset ctor is evaluated after the source is marked dead, so if
    // 'make' escapes the moved content must be destroyed through its new owner only.
    let mut b = move (make (2)) a;
    release (b.ptr);
}
