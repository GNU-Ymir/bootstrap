// A default value of a method constructing its own class validates the class
// again from within its validation: the ctors keep their default values.

class C {
    let _v: i32;
    pub self (v: i32 = 1) with _v = v {}
    pub fn add (self, c: &C = copy C (v-> 2))-> i32 { self._v + c._v }
}

fn main () {
    let _ = (copy C ()).add ();
}
