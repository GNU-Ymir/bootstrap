// A field assign method and a field of that name that both fail report
// both errors, the field's first.

class A {
    prv let x : i32 = 0;
    pub self () {}
}

class B over A {
    pub self () {}

    @field
    pub fn x (mut self, _ : i32) {}
}

fn main () {
    let dmut b = copy B ();
    b.x = "r";
}
