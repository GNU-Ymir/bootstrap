in info;

pub enum TypeIDs: u32
| ARRAY        = 1u32
| BOOL         = 2u32
| CHAR         = 3u32
| CLOSURE      = 4u32
| FLOAT        = 5u32
| FUNC_PTR     = 6u32
| SIGNED_INT   = 7u32
| UNSIGNED_INT = 8u32
| POINTER      = 9u32
| SLICE        = 10u32
| STRUCT       = 11u32
| TUPLE        = 12u32
| OBJECT       = 13u32
| VOID         = 14u32
| MAP          = 15u32;

pub record TypeInfo {
    pub let typeid: u32;
    pub let size: usize;
    pub let inner: [TypeInfo];
    pub let name: [c8];

    pub self (typeid: u32, size: usize, inner: [TypeInfo], name: [c8])
        with typeid = typeid
        , size = size
        , inner = inner
        , name = name
    {}
}
