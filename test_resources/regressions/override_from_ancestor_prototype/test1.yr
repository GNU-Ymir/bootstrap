in test1;

mod ::word;

use test1::word;

class Expr {
    pub let loc: &Word;
    pub self (loc: &Word) with loc = loc {}
}

class Gen {
    pub let loc: &Word;
    pub self (loc: &Word) with loc = loc {}
}

fn main ()
    throws AssertError
{
    let e = Expr (copy LocWord ("a"));
    let g = Gen (e.loc);
    assert (g.loc.locate () == e.loc);
}
