in test2;

/**
 * Wrapping the runtime test in a plain `else` block takes it out of the
 * `cte if` chain, which is how a single-alternative fallback must be written.
 */

fn check {R...} (x : [c8], lst : R)-> bool {
    cte if (R,)::arity > 1 {
        for z in lst if x == z {
            return true;
        }
    } else {
        if lst == x {
            return true;
        }
    }

    return false;
}

fn main () {
    let _ = check ("a", "b");
}
