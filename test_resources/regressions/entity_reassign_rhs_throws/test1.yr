fn release (_ : i32);

entity A {
    pub let mut ptr : i32 = 0;
    pub self () {}
    pub self (i : i32) with ptr = i {}
    __dtor (mut self) { release (self.ptr); }
}

fn make (i : i32)-> A
    throws AssertError
{
    if (i == 0) throw copy AssertError ("");
    A (i)
}

fn main ()
    throws AssertError
{
    let mut a = A (1);

    // the old 'a' is destroyed before the right operand is evaluated, so if 'make' escapes
    // 'a' must be marked dead and not destroyed a second time by the frame's finally.
    a = make (2);
    release (a.ptr);
}
