// two classes whose prototypes read the fields of each other
in test3;

class A {
    pub let x: i32;
    pub let b: &B;
    pub self (b: &B) with x = 1, b = b {}
    pub fn get (self)-> typeof (self.b.y) { self.b.y }
}

class B {
    pub let y: i64;
    pub let a: &A;
    pub self (a: &A) with y = 2, a = a {}
    pub fn get (self)-> typeof (self.a.x) { self.a.x }
}

fn foo (a: &A)-> i64 {
    a.get ()
}

fn bar (b: &B)-> i32 {
    b.get ()
}
