// the same, Sym being first reached through the field of another class
in test2;

trait Comparable {T} {
    pub fn opEquals (self, o: T)-> bool;
}

@abstract
class Sym {
    pub self () {}
    pub fn unit (self)-> &USym { copy USym () }
    pub fn list (self)-> &List { copy List () }
    pub fn reach (self)-> [&Sym] { let l = self.list (); l[] }
    impl Comparable!{&Sym} {
        pub over opEquals (self, o: &Sym)-> bool { self is o }
    }
    impl Hashable { pub over toHash (self)-> u64 { 0u64 } }
}

@final
class List {
    let mut _set: [&Sym => &Sym] = copy [];
    pub self () {}
    pub fn opIndex (self)-> [&Sym] { copy [s for _, s in self._set] }
}

class USym over Sym {
    pub self () with super () {}
}
class Holder {
    pub let s: &Sym;
    pub self (s: &Sym) with s = s {}
}

fn main () {
    let h = Holder (copy USym ());
    let _ = h.s.reach ();
}
