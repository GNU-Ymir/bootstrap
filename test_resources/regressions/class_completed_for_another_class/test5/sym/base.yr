in base;

use test5::sym::cmp;

@abstract
pub class Sym {
    let mut _units: [&USym] = [];

    pub self () {}

    pub fn insertUnit (mut self, u: &USym) {
        self._units ~= [u];
    }

    @field
    pub fn units (self)-> [&USym] {
        self._units
    }

    @field
    pub fn fullName (self)-> &SymPath {
        self.computeFullName ()
    }

    pub fn reach (self)-> [&Sym] {
        let dmut l = copy SymList ();
        l:.insert (self);
        l[]
    }

    pub fn lists (self, dmut l: &SymList) {
        l:.insert (self);
    }

    prot fn computeFullName (self)-> &SymPath {
        copy SymPath ("sym")
    }

    impl Comparable!{&Sym} {
        pub over opEquals (self, o: &Sym)-> bool { self is o }
    }

    impl Hashable {
        pub over toHash (self)-> u64 { 0u64 }
    }
}
