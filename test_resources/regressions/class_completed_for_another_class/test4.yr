// two classes whose prototypes call the methods of each other
in test4;

class A {
    pub let x: i32 = 1;
    pub self () {}
    pub fn get (self, b: &B)-> typeof (b.get (self)) { b.get (self) }
}

class B {
    pub let y: i64 = 2;
    pub self () {}
    pub fn get (self, a: &A)-> typeof (a.x) { a.x }
}

fn main () {
    let a = copy A ();
    let _ : i32 = a.get (copy B ());
}
