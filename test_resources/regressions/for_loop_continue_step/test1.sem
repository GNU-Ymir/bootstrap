frame: test1::main ()-> void {
    let mut sum: mut i32 = 0;
    {
        let #_value: [i32] = {.len = 3us, .ptr = &([1, 2, 3])};
        let mut #_index: usize = 0us;
        while (#_index < 3us) {
            let v: i32 = #_value [#_index];
            {
                if (v == 1) continue;
                sum = (sum + v);
                <unit-value>
            }
        } step #_index = (#_index + 1us)
    };
    {
        let mut #_iter: usize = 0us;
        let #_nb_iters: usize = 4us;
        while (#_iter < #_nb_iters) {
            let mut i: i32 = 0;
            i = cast!{i32}(#_iter);
            {
                if (i == 2) continue;
                sum = (sum + i);
                <unit-value>
            }
        } step #_iter = (#_iter + 1us)
    }
}
