fn release (_ : i32);

entity A {
    pub let ptr : i32 = 0;
    pub self () {}
    pub self (i : i32) with ptr = i {}
    __dtor (mut self) { release (self.ptr); }
}

// Enough locals that a hash-map iteration order cannot pass for reverse declaration order
// by accident: they must be destroyed a9, a8, ... a1.
fn main () {
    let a1 = A (1);
    let a2 = A (2);
    let a3 = A (3);
    let a4 = A (4);
    let a5 = A (5);
    let a6 = A (6);
    let a7 = A (7);
    let a8 = A (8);
    let a9 = A (9);
    release (a1.ptr + a2.ptr + a3.ptr + a4.ptr + a5.ptr + a6.ptr + a7.ptr + a8.ptr + a9.ptr);
}
