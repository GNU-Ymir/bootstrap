class MyErr over Exception {
    pub self () {}
}

fn wrap (e: &Exception, fail: bool)-> i32? {
    {
        if (fail) throw e;
        12
    }?
}

fn wrapT {T} (e: &Exception, fail: bool)-> T? {
    {
        if (fail) throw e;
        T::init
    }?
}

fn main () {
    let e: &Exception = copy MyErr ();
    let _a_ = wrap (e, true);
    let _b_ = wrapT!{f64} (e, true);
}
