class A {
    let mut _n: i64 = 0;

    pub self () {}

    pub fn finish (mut self)-> i64 {
        self._n += 1;
        self._n
    }
}

class B {
    let dmut _a: &A;

    pub self () with _a = copy A () {}

    pub fn finish (mut self)-> typeof (self._a:.finish ()) {
        self._a:.finish ()
    }
}

fn main () {
    let dmut b = copy B ();
    let _ : i64 = b:.finish ();
}
