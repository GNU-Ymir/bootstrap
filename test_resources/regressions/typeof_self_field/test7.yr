class H {
    pub self () {}

    pub fn finish (mut self)-> i64 {
        1
    }
}

class Hmac {class T} {
    let dmut _inner: T;

    pub self () with _inner = copy T () {}

    pub fn finish (mut self)-> typeof ({ let dmut h = copy T (); h:.finish () }) {
        self._inner:.finish ()
    }
}

fn main () {
    let dmut h = copy Hmac!{&H} ();
    let _ : i64 = h:.finish ();
}
