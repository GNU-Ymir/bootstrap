in test1;

/**
 * The minimum of a signed integer type, written as a literal.
 *
 * The lexer reads the magnitude on its own and the unary minus after it, so
 * the literal used to be bounded by its own type's maximum: the minimum of
 * every signed width was one past that, and unwritable.
 */
fn main () {
    let _i8_  = -128i8;
    let _i16_ = -32768i16;
    let _i32_ = -2147483648i32;
    let _i64_ = -9223372036854775808i64;

    // without a suffix, the literal defaults to i32
    let _dft_ = -2147483648;

    // through the declared type of the variable
    let _typ_ : i8 = -128;

    // the other bases reach the same bound
    let _hex_ = -0x80000000i32;
    let _bin_ = -0b10000000i8;
    let _oct_ = -0o200i8;

    // and the value is the one the property gives
    let _eq8_  : bool = (-128i8 == i8::min);
    let _eq32_ : bool = (-2147483648 == i32::min);

    // what was already accepted is unchanged
    let _one_ = -1i32;
    let _max_ = -2147483647i32;
}
