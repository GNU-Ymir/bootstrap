/*
 * A module reached through a *sibling* import ('mod .fmt;' in base) is inserted next to
 * the module importing it, not under it. When 'base' itself is only loaded lazily -- it
 * does not pass the '-fmodule' filter, but something the filter did keep reaches it --
 * 'fmt' therefore lands outside the subtree the lazy loader finalizes, and its own 'use'
 * declarations were never resolved: 'Helper' below came out as an undefined symbol.
 */

in test1;

mod ::base;
mod ::helper;
mod ::user;
