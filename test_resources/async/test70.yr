// An async lambda passed to a template function, the value it completes with solving
// the template, and a copied async lambda capturing a value.

fn call {T} (f: dg (i32)-> (async-> T))-> T {
    f (1).run ()
}

fn main () {
    let k = 41;
    let _a_: i32 = call (async |x: i32|-> i32 => x + k);

    let s = "ok";
    let g = copy async || => s;
    let _b_: [c8] = g ().run ();
}
