// A template async method, specialized twice, and an async method returning nothing.

class A {
    pub self () {}

    pub async echo {T} (self, x: T)-> T {
        await;
        x
    }

    pub async tick (self) {
        await;
    }
}

async outer ()-> i32 {
    let a = A ();
    let _s_ = await a.echo ("s");
    await a.tick ();
    await a.echo (1)
}

fn main () {
    let _r_: i32 = outer ().run ();
}
