// poll of an async-> void is a void?, its waker being any delegate, a method one included.

class Waker {
    pub let mut woken: i32 = 0;

    pub self () {}

    pub fn wake (mut self) {
        self.woken += 1;
    }
}

async touch (n: i32) {
    let _x_ = n + 1;
    await;
}

fn main () {
    let dmut w = copy Waker ();
    let h = touch (1);
    let r: void? = h.poll (&w:.wake);
    let _ = r;
}
