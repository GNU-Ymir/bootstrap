// A parameter and a field of type async-> T hold no value until one is
// assigned, the return type of the handle being any complete type, void included.
// The handle is movable, so the field is the one of an entity.

entity Holder {
    pub let handle: async-> [i32];

    pub self (handle: async-> [i32]) with handle = move handle {}
}

fn take (_: async-> i32, _: async-> void, dmut _: async-> [i32]) {}

fn keep (h: Holder)-> [i32] {
    h.handle.run ()
}

fn main () {}
