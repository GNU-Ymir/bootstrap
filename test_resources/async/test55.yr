// A record implementing the async method of a trait.

trait Task {
    pub async step (self)-> i32;
}

record R {
    pub let n: i32;

    pub self (n: i32) with n = n {}

    impl Task {
        pub over async step (self)-> i32 {
            self.n
        }
    }
}

async outer ()-> i32 {
    await R (1).step ()
}

fn main () {
    let _r_: i32 = outer ().run ();
}
