// await cannot be inside a try block of an async lambda.

class Err over Exception {
    pub self () {}
}

fn mayThrow ()
    throws Err
{
    throw copy Err ();
}

async one ()-> i32 {
    1
}

fn main () {
    let _ = async || {
        {
            mayThrow ();
            await one ()
        } catch {
            _: &Err => { 0 }
        }
    };
}
