// An async method of a class, awaited from an async.

class A {
    let n: i32;

    pub self (n: i32) with n = n {}

    pub async count (self, k: i32)-> i32 {
        for _ in 0 .. k {
            await;
        }

        self.n + k
    }
}

async outer (a: &A)-> i32 {
    await a.count (2)
}

fn main () {
    let _r_: i32 = outer (A (3)).run ();
}
