frame: test86::main ()-> i32 return {
    (init test86::chain (4)).run()
}
frame: test86::chain (n: i32)-> (async-> i32) return {
    let mut sum: mut i32 = 0;
    {
        let mut #_iter: usize = 0us;
        let #_nb_iters: usize = if (0 > n) 0 else n;
        while (#_iter < #_nb_iters) {
            let mut i: i32 = 0;
            i = cast!{i32}(#_iter);
            {
                sum = (sum + await init test86::double (i));
                <unit-value>
            }
        } step #_iter = (#_iter + 1us)
    };
    sum
}
frame: test86::double (x: i32)-> (async-> i32) return (x * 2)
