// An async lambda completing with nothing, and one whose return completes it, not the
// function declaring it.

async apply (f: dg (i32)-> (async-> i32), x: i32)-> i32 {
    await f (x)
}

fn first (x: i32)-> [c8] {
    let f = async || {
        await;
    };
    f ().run ();

    let g = async |y: i32|-> i32 {
        if y > 0 { return y; }
        0
    };

    let _a_: i32 = g (x).run ();
    let _b_: i32 = apply (g, x).run ();
    let _c_: i32 = apply (async |y|-> i32 {
        if y > 0 { return y; }
        0
    }, x).run ();
    "done"
}

fn main () {
    let _ = first (1);
}
