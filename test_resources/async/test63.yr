// An entity cannot take the default async of a trait, its frame would hold a movable.

trait Task {
    pub async step (self)-> i32 {
        0
    }
}

entity E {
    pub let n: i32;

    pub self (n: i32) with n = n {}

    __dtor (mut self) {}

    impl Task;
}

fn main () {
    let _ = E (1);
}
