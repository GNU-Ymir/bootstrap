// await c, with c a class whose method poll (waker: dg ()-> void)-> U? is mutable, polls it
// at each resumption until it has a value, typed U, the aliased class crossing the suspension.

class Countdown {
    let mut _n: i32;

    pub self (n: i32)
        with _n = n
    {}

    pub fn poll (mut self, waker: dg ()-> void)-> i32? {
        if self._n == 0 {
            return (42)?;
        }

        self._n -= 1;
        waker ();
        none
    }
}

async outer ()-> i32 {
    let dmut c = copy Countdown (3);
    let r: i32 = await alias c;
    r + 1
}

fn main () {
    let _ = outer ().run ();
}
