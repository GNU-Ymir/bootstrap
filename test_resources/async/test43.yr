// await c, with a constant poll returning void?, is typed void, the class being created once
// before the first poll.

class Ready {
    pub self () {}

    pub fn poll (self, waker: dg ()-> void)-> void? {
        waker ();
        none
    }
}

fn make ()-> &Ready {
    copy Ready ()
}

async outer (x: i32)-> i32 {
    await make ();
    x
}

fn main () {
    let _ = outer (1).run ();
}
