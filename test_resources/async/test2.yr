// The template parameter of an async-> T parameter is solved from the
// return type of the handle passed to it.

fn sizeOf {T} (_: async-> T)-> usize {
    T::size
}

fn both {T, U} (_: async-> T, _: async-> U)-> (usize, usize) {
    (T::size, U::size)
}

fn use_ (a: async-> i64, b: async-> [c8], c: async-> i64) {
    let s: usize = sizeOf (move a);
    let (x : usize, y : usize) = both (move c, move b);
    s; x; y;
}

fn main () {}
