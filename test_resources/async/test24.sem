frame: test24::one (i: i32)-> (async-> i32) return i
frame: test24::main ()-> void {
    let _: i32 = (init test24::total (3)).run();
    <unit-value>
}
frame: test24::total (n: i32)-> (async-> i32) return {
    let mut acc: mut i32 = 0;
    {
        let mut #_iter: usize = 0us;
        let #_nb_iters: usize = if (0 > n) 0 else n;
        while (#_iter < #_nb_iters) {
            let mut i: i32 = 0;
            i = cast!{i32}(#_iter);
            {
                acc = (acc + await init test24::one (i));
                await;
                <unit-value>
            }
        } step #_iter = (#_iter + 1us)
    };
    acc
}
