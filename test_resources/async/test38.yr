// await f, with f: future-> U, registers the waker of the current async on the thread,
// suspends while it runs, and reads the value it computed, typed U.

fn compute (x: i32)-> i32 {
    x * 2
}

async outer (x: i32)-> i32 {
    let f = spawn compute (x);
    let r: i32 = await f;
    r + 1
}

fn main () {
    let _ = outer (3).run ();
}
