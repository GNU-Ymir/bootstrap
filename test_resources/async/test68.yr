// An async lambda capturing nothing is a function pointer, converted to a delegate when
// one is expected.

async apply (f: dg (i32)-> (async-> i32), x: i32)-> i32 {
    await f (x)
}

fn main () {
    let f: fn (i32)-> (async-> i32) = async |x: i32| => x + 1;
    let _a_: i32 = f (1).run ();

    let _b_: i32 = apply (f, 2).run ();
    let _c_: i32 = apply (async |x| => x + 3, 3).run ();
}
