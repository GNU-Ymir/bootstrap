// await e, with e: async-> U, resumes e with the waker of the current async, suspends
// while e is pending, and is typed U.

async double (x: i32)-> i32 {
    x * 2
}

async outer (x: i32)-> i32 {
    let h = double (x);
    let r: i32 = await h;
    r + 1
}

fn main () {
    let _ = outer (3).run ();
}
