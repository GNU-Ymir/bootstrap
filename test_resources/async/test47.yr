// A mutable method poll is only called on an aliased class: await alias c.

class Countdown {
    let mut _n: i32 = 1;

    pub self () {}

    pub fn poll (mut self, waker: dg ()-> void)-> i32? {
        self._n -= 1;
        waker ();
        none
    }
}

async outer ()-> i32 {
    let dmut c = copy Countdown ();
    await c
}
