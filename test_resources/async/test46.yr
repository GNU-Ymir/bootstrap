// The method poll of an awaited class cannot throw, an async never throws.

class Throwing {
    let _n: i32 = 0;

    pub self () {}

    pub fn poll (self, waker: dg ()-> void)-> i32?
        throws AssertError
    {
        assert (self._n > 0);
        waker ();
        none
    }
}

async outer ()-> i32 {
    await copy Throwing ()
}
