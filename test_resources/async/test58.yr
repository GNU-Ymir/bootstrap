// The async method of a trait must be implemented by an async.

async answer ()-> i32 {
    1
}

trait Task {
    pub async step (self)-> i32;
}

class A {
    pub self () {}
    impl Task {
        pub over step (self)-> (async-> i32) {
            answer ()
        }
    }
}

fn main () {
    let _ = A ();
}
