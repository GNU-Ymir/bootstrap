// An await in a loop suspends the body at each iteration, the counter crossing the
// suspension.

async one (i: i32)-> i32 {
    i
}

async total (n: i32)-> i32 {
    let mut acc = 0;
    for i in 0 .. n {
        acc += await one (i);
        await;
    }

    acc
}

fn main () {
    let _ = total (3).run ();
}
