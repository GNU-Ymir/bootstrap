// An async lambda capturing a local by value, awaited in a loop.

async sum (n: i32)-> i32 {
    let base = 10;
    let f = async |x: i32| {
        await;
        x + base
    };

    let mut s = 0;
    for i in 0 .. n {
        s += await f (i);
    }

    s
}

fn main () {
    let _r_: i32 = sum (3).run ();
}
