// An async method overridden, awaited through a reference to the ancestor.

class A {
    pub self () {}

    pub async value (self)-> i32 {
        1
    }
}

class B over A {
    pub self () {}

    pub over async value (self)-> i32 {
        await;
        2
    }
}

async outer (a: &A)-> i32 {
    await a.value ()
}

fn main () {
    let _r_: i32 = outer (B ()).run ();
}
