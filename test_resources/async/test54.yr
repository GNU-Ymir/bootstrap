// An async method of a record, whose frame holds a copy of self.

record R {
    pub let n: i32;

    pub self (n: i32) with n = n {}

    pub async get (self)-> i32 {
        await;
        self.n
    }
}

fn make ()-> (async-> i32) {
    let r = R (3);
    r.get ()
}

async outer ()-> i32 {
    await make ()
}

fn main () {
    let _r_: i32 = outer ().run ();
}
