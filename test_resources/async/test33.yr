// poll resumes an async once with the given waker: an empty option while it is pending,
// the value it completed with once it is over.

async steps (n: i32)-> i32 {
    await;
    await;
    await;
    n * 2
}

fn main () {
    let h = steps (3);
    let mut pendings = 0;
    let mut value = 0;
    loop {
        if let Ok (r) = h.poll (|| => {}) {
            value = r;
            break;
        }
        pendings += 1;
    }

    let _ = value + pendings;
}
