// A chain of three asyncs, each awaiting the next one, the innermost giving control back.

async leaf (x: i32)-> i32 {
    await;
    x + 1
}

async middle (x: i32)-> i32 {
    await leaf (x) * 2
}

async root (x: i32)-> i32 {
    let r = await middle (x);
    r - 3
}

fn main () {
    let _ = root (5).run ();
}
