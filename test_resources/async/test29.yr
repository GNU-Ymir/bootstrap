// await cannot be inside a try block or a catch, the resumption jumping back into a
// region whose handler would not be installed again.

class Err over Exception {
    pub self () {}
}

fn mayThrow ()
    throws Err
{
    throw copy Err ();
}

async one ()-> i32 {
    1
}

async outer ()-> i32 {
    {
        mayThrow ();
        await one ()
    } catch {
        _: &Err => { 0 }
    }
}
