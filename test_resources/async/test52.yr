// A trait with a default async method, kept by one class and overridden by the other.

trait Task {
    pub async step (self)-> i32 {
        0
    }
}

class A {
    pub self () {}
    impl Task;
}

class B {
    pub self () {}
    impl Task {
        pub over async step (self)-> i32 {
            await;
            1
        }
    }
}

async outer ()-> i32 {
    let x = await A ().step ();
    x + await B ().step ()
}

fn main () {
    let _r_: i32 = outer ().run ();
}
