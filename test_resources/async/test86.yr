// an await of a direct call in a loop initializes the same reserved frame at each iteration
async double (x: i32)-> i32 {
    x * 2
}

async chain (n: i32)-> i32 {
    let mut sum = 0;
    for i in 0 .. n {
        sum += await double (i);
    }

    sum
}

fn main ()-> i32 {
    chain (4).run ()
}
