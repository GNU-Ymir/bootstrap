// the trait of the submodule is implemented, so the module is fully validated
// and the use its methods never resolve through is reported

in test22;

mod ::helpers;
mod ::tr;

use test22::tr;

class Impl {
    pub self () {}
    impl Doer;
}

fn main () {
    let c = copy Impl ();
    let _a_ = c.doIt ();
}
