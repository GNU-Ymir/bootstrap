// a record construction and a template call credit the use that offered the
// candidate they settled on, never the one that only offered a loser

in test16;

mod ::alpha;
mod ::beta;

use test16::alpha;
use test16::beta;

fn main () {
    let _a_ = Point (1, 2);
    let _b_ : i64 = conv!{i64} (12);
}
