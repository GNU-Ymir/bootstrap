// handing a variable out consumes all the mutability it declares, whatever the
// receiver does with it, and receiving an alias needs it as well
class A {
    pub let mut x : i32 = 0;
    pub self () {}
    pub fn set (mut self) { self.x = 1; }
}

fn foo (dmut x : [i32]) { x; }

fn bar (ref mut x : [i32]) { x = copy [1]; }

fn main () {
    let dmut a = copy [1, 2];
    foo (alias a);

    let dmut b = copy [1, 2, 3];
    foo (alias b [1 .. $]);

    let dmut c = copy A ();
    c:.set ();

    let mut d = copy [1, 2];
    bar (ref d);

    let dmut e = copy [1, 2];
    let p = &e;
    p;

    let dmut f = copy [1, 2];
    let dmut g = alias f;
    g;

    let dmut h = copy [1, 2];
    let dmut i = copy [3];
    h = alias i;
    h;

    let dmut k : [&A] = [];
    let dmut l = copy [copy A ()];
    k ~= l;
    k [0]:.set ();
}
