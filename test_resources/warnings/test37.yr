// one reachable mutation justifies the level it consumes, be it in a single branch
// or in a closure the variable is enclosed in
fn foo (cond: bool) {
    let mut a = copy [1, 2];
    if cond { a = copy [3]; }
    a;

    let dmut b = copy [1, 2];
    let f = copy |x: i32| => { b [0] = x; };
    f (3);
}

fn main () {
    foo (true);
}
