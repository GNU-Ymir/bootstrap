// a declared mutability level that no mutation consumes warns: `dmut` where only
// the variable is rebound, and any decorator where nothing is mutated, but the one
// keeping a literal from being folded at compile time
fn main () {
    let dmut a = copy [1, 2, 3];
    a [0] = 1;

    let dmut b = copy [1, 2, 3];
    b = copy [1];

    let dmut c = copy [1, 2, 3];
    c;

    let mut d = 12;
    d;

    let dmut e = [1, 2];
    e = [3, 4];
}
