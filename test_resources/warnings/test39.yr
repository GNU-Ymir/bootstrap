// writing an element of a variable consumes `dmut`, but for a field of a record,
// which is as mutable as the record
class A {
    pub let mut x : i32 = 0;
    pub self () {}
}

record R {
    pub let mut x : i32;
    pub self (x : i32) with x = x {}
}

fn main ()
    throws EmptyValOption
{
    let dmut a = [1, 2, 3];
    a [0] = 4;

    let dmut t = (1, 2);
    t._0 = 3;

    let dmut c = copy A ();
    c.x = 1;

    let dmut s = copy [1, 2];
    s [0] = 3;

    let dmut m = copy [1 => copy [1]];
    m [1].value [0] = 2;

    let dmut n = copy [1 => 2];
    n [1] = 3;

    let dmut p = &a;
    unsafe { *p = [4, 5, 6]; }

    let mut r = R (1);
    r.x = 2;
}
