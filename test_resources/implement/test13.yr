trait X {T} {
    pub fn foo (self, _ : T)-> i32 {
        42
    }
}

// The method a templated trait gives to a class is a weak symbol. An abstract class has no
// vtable, so nothing else here refers to it - it must be kept all the same: this is the only
// place where its body is known, the heirs of the class only ever refer to it.
@abstract
class A {
    pub self () {}
    impl X!{i32};
}
