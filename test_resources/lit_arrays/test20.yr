// the address of an element of a static array is the one of the element, of a scalar, a record, a nested array and an array field

record Point {
    pub let mut x : i32;
    pub let mut y : i32;
    pub self (x : i32, y : i32) with x = x, y = y {}
}

record Grid {
    pub let dmut cells : [i32 ; 3];
    pub self (cells : [i32 ; 3]) with cells = cells {}
}

fn put (dmut p : *i32, v : i32) {
    unsafe { *p = v; }
}

fn scalar (i : usize)-> i32 {
    let dmut a = [0 ; 4];
    put (alias &a[i], 7);
    a[i]
}

fn point (i : usize)-> i32 {
    let dmut a = [Point (0, 0) ; 2];
    let dmut p = alias &a[i];
    unsafe { (*p).y = 7; }
    put (alias &a[i].x, 3);
    a[i].x + a[i].y
}

fn nested (i : usize, j : usize)-> i32 {
    let dmut a = [[0 ; 2] ; 3];
    put (alias &a[i][j], 7);
    a[i][j]
}

fn field (i : usize)-> i32 {
    let dmut g = Grid ([0 ; 3]);
    put (alias &g.cells[i], 7);
    g.cells[i]
}

fn main () {
    scalar (1us);
    point (1us);
    nested (2us, 1us);
    field (2us);
}
