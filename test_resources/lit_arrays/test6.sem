frame: test6::foo (_: i32)-> void {
    <unit-value>
}
frame: test6::main ()-> void {
    let a: [i32 ; 4us] = [1, 2, 3, 4];
    {
        let mut #_iter: usize = 0us;
        let #_nb_iters: usize = 4us;
        while (#_iter < #_nb_iters) {
            let mut i: usize = 0us;
            i = #_iter;
            {
                test6::foo (#{
                        if (4us <= i) panic;
                        a [i]
                    #});
                <unit-value>
            };
            #_iter = (#_iter + 1us)
        }
    }
}
