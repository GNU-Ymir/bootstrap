in test24;

/**
 * The `is` operator on operands that are not comparable class pointers.
 *
 * BinaryClassValidation::validateImpl rejects a struct outright, and reports
 * the failure of the common type inference as a note under UNDEFINED_BIN_OP
 * when the two classes are unrelated.
 */
class A {
    pub self () {}
}

class B {
    pub self () {}
}

record R {
    pub let a : i32;

    pub self (a : i32) with a = a {}
}

fn main () {
    let a = copy A ();
    let b = copy B ();
    let r = R (1);
    let i = 12i32;

    r is r;
    a is b;
    a !is i;
}
