in test39;

enum K : u32
| A = 0u32
;

/**
 * The const component of a copied row no longer blocks the append, but the
 * data a row borrows still does: a const or unaliased slice in the row is
 * refused, whether the append is written `~=` or rewritten from `r = r ~ ...`.
 */
fn appendConst () {
    let a : [i32] = copy [1];
    let dmut r : [([i32], u32)] = [];
    r ~= [(a, K::A)];
}

fn concatConst () {
    let a : [i32] = copy [1];
    let dmut r : [([i32], u32)] = [];
    r = r ~ [(a, K::A)];
}

fn appendUnaliased () {
    let dmut a = copy [1];
    let dmut t = (alias a, K::A);
    let dmut r : [([i32], u32)] = [];
    r ~= [t];
}

fn main () {
    appendConst ();
    concatConst ();
    appendUnaliased ();
}
