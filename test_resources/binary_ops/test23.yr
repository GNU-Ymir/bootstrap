in test23;

/**
 * The `of` operator against the pointer type of a struct.
 *
 * BinaryTypeValidation::validateImpl compares a value against a class *ref*
 * type. A class pointer on the right is only accepted when it wraps a struct,
 * in which case it is unwrapped to its inner ref type first.
 */
record R {
    pub let a : i32;

    pub self (a : i32) with a = a {}
}

fn main () {
    let r = R (1);

    let _t1_ = r of typeof (r);
    let _t2_ = r !of typeof (r);
}
