in test20;

/**
 * Mixed integer/char arithmetic.
 *
 * BinaryMathValidation::validateIntLeft has a char branch for `int + char`,
 * and validateCharLeft handles `char + int`. Both only accept `+` and `-`,
 * and only against an unsigned integer of the char's own width.
 */
fn main () {
    // char on the right of an unsigned int of the same width
    let _i1_ = 12u8 + 'a'c8;
    let _i2_ = 12u32 + 'a'c32;
    let _i3_ = 'z'c8 - 12u8;

    // char on the left
    let a = 'a'c8;
    let _c1_ = a + 12u8;
    let _c2_ = a - 12u8;

    // float ^^ float goes through the core FFPOW helper
    let f = 3.0f;
    let _p1_ = f ^^ 2.0f;
}
