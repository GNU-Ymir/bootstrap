in test42;

/**
 * Pointer arithmetic on a pointer to mutable data.
 *
 * The offset of a `dmut *T` is a `dmut *T`, by a binary operator and by a
 * compound assignment, so the address it computes can be written through.
 */
fn next (dmut p: *u64)-> dmut *u64 {
    alias p + 8us
}

fn prev (dmut p: *u64)-> dmut *u64 {
    alias p - 8us
}

fn main () {
    let dmut a = [1u64, 2u64, 3u64];
    let dmut p: *u64 = unsafe { alias &a[0] };

    let dmut q = next (alias p);
    unsafe { *q = 4u64; }

    let dmut r = alias p;
    r += 16us;
    unsafe { *r = 5u64; }

    let dmut s = prev (alias r);
    unsafe { *s = 6u64; }
}
