in test21;

/**
 * Arithmetic on chars and pointers outside of what they define.
 *
 * validateCharLeft only accepts `+` and `-`, and only against an unsigned
 * integer of its own width; validatePointerLeft has the same operator
 * restriction. A char operation that leaves the representable range is
 * reported by the compile time interpreter rather than by the validator.
 */
fn main () {
    let mut i = 12i32;
    let a = 'a'c8;
    let p = &i;

    a * 12u8;
    a + 12i32;
    p * 1us;
}
