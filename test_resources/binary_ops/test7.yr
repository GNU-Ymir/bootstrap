in test7;

/**
 * Function pointer and delegate equality.
 *
 * BinaryComparisonValidation::validateFuncPtrLeft and validateDGPtrLeft only
 * accept `==` and `!=`; the right operand is inferred to the left type, so a
 * lambda literal compares against a delegate variable.
 */
fn foo (x: i32)-> i32 { x }
fn bar (x: i32)-> i32 { x + 1 }

fn main () {
    let f: fn (i32)-> i32 = &foo;
    let g: fn (i32)-> i32 = &bar;

    let _f1_ = f == g;
    let _f2_ = f != g;
    let _f3_ = f == &foo;

    let d: dg (i32)-> i32 = |x: i32| => x + 1;
    let e: dg (i32)-> i32 = |x: i32| => x + 2;

    let _d1_ = d == e;
    let _d2_ = d != e;
}
