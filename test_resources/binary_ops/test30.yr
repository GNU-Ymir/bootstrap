in test30;

/**
 * A class with no operator overload on the *right* of a binary operator.
 *
 * The right match of validateImpl does pick the class arm up, and the failure
 * to resolve opBinaryRight is what fills the second note of the final error.
 */
class Plain {
    pub self () {}
}

fn main () {
    let c = copy Plain ();

    1 & c;
    true && c;
    0 .. c;
}
