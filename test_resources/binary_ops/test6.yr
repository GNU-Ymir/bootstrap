in test6;

/**
 * Pointer arithmetic and pointer comparison.
 *
 * BinaryMathValidation::validatePointerLeft accepts a usize offset and a
 * second pointer(equal pointee, or either side pointing to void);
 * BinaryComparisonValidation::validatePointerLeft compares two pointers,
 * inferring a common type when they differ.
 */
fn main () {
    let mut a = 12i32;
    let mut b = 5i32;

    let pa = &a;
    let pb = &b;

    // pointer + offset
    let _o1_ = pa + 1us;
    let _o2_ = pa - 1us;

    // pointer +/- pointer of the same pointee
    let _d1_ = pa - pb;
    let _d2_ = pa + pb;

    // comparison of two identical pointer types
    let _c1_ = pa == pb;
    let _c2_ = pa != pb;
    let _c3_ = pa < pb;
    let _c4_ = pa >= pb;
}
