in test43;

/**
 * Pointer arithmetic on a pointer to immutable data.
 *
 * The offset of a `*T` stays a `*T`, by a binary operator and by a compound
 * assignment: it cannot be returned as a `dmut *T`, nor written through. The
 * offset of a `dmut *T` that is not aliased is an implicit alias.
 */
fn next (p: *u64)-> dmut *u64 {
    p + 8us
}

fn implicit (dmut p: *u64)-> dmut *u64 {
    p + 8us
}

fn write (p: *u64) {
    let q = p + 8us;
    unsafe { *q = 4u64; }

    let mut r = p;
    r += 8us;
    unsafe { *r = 5u64; }
}
