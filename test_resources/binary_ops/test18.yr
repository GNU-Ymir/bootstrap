in test18;

/**
 * Comparison operators that a type accepts only for equality.
 *
 * validateBoolLeft and validateTupleLeft reject every operator but `==` and
 * `!=`; validateTupleLeft additionally requires both tuples to have the same
 * arity.
 */
fn main () {
    let b = true;
    let t = (1, 2);

    b < b;
    t < t;
    t == (1, 2, 3);
}
