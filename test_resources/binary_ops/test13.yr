in test13;

/**
 * Concatenation overloaded by a class.
 *
 * Reaches BinaryValidation::validateClassLeft/validateClassRight from
 * BinaryConcatValidation, whose class arms nothing else exercises.
 */
class Rope {
    pub self () {}

    pub fn opBinary {"~"} (self, x : i32)-> i32 {
        x
    }

    pub fn opBinaryRight {"~"} (self, x : [c8])-> usize {
        x.len
    }
}

fn main () {
    let r = copy Rope ();

    let _l_ : i32 = r ~ 1;
    let _r_ : usize = "ab" ~ r;
}
