in test38;

enum K : u32
| A = 0u32
;

/**
 * The elements are copied by the append, so a const component, such as an enum
 * value in a tuple literal, is accepted whether the append is written `~=` or
 * rewritten from `r = r ~ ...`, and only the data they borrow keep their
 * mutability(cf. test39).
 */
fn main () {
    let x = 1u32;
    let dmut r : [(u32, u32)] = copy [(x, K::A)];
    r ~= [(x, K::A)];
    r ~= [(K::A, K::A)];
    r = r ~ [(x, K::A)];
    r = r ~ [(K::A, K::A)];
    r[0]._1 = 2u32;

    let mut m : [(u32, u32)] = [];
    m ~= [(x, K::A)];
    m ~= r;

    let dmut a = copy [1];
    let dmut b : [([i32], u32)] = [];
    b ~= [(alias a, K::A)];
    b = b ~ [(alias a, K::A)];
    b ~= alias [(alias a, K::A)];
    let dmut t = (alias a, K::A);
    b ~= [alias t];
    b[0]._0[0] = 3;

    let c : [i32] = copy [2];
    let mut d : [([i32], u32)] = [];
    d ~= [(c, K::A)];
    d = d ~ [(c, K::A)];
}
