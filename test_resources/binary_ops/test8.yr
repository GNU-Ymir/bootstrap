in test8;

/**
 * Void and null pointers.
 *
 * BinaryMathValidation::validatePointerLeft has a dedicated branch for each
 * side pointing to void; BinaryComparisonValidation::validatePointerLeft
 * infers a common pointer type when the two sides are not already equal,
 * which is what a null literal on either side needs.
 */
fn main () {
    let mut a = 12i32;

    let pa = &a;
    let pv: *void = null;

    // one side points to void
    let _v1_ = pa + pv;
    let _v2_ = pv + pa;

    // a null literal unifies with any pointer, through inferValuesForBranch
    let _c1_ = pa == null;
    let _c2_ = null != pa;
    let _c3_ = pv == null;
}
