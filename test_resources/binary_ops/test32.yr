in test32;

/**
 * Slice comparison between two slices of unrelated element types.
 *
 * validateSliceOrArrayLeft tries the equality helper first for `==`, keeps its
 * failure as a note, then tries the ordering one and keeps that failure too.
 */
fn main () {
    let sli: [i32] = copy [1, 2];
    let str: [[c8]] = copy ["a"];

    sli == str;
}
