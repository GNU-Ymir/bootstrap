in test34;

/**
 * The last operand shapes each family rejects from inside its own handler.
 *
 * A class on the *left* of a logical operator resolves opBinary and fails,
 * validateArrayLeft wants an array or a slice on the right of `~`, and
 * validatePointerLeft rejects two pointers with unrelated pointees.
 */
class Plain {
    pub self () {}
}

fn main () {
    let c = copy Plain ();
    let arr = [1, 2];
    let mut i = 12i32;
    let mut f = 3.14f;

    c && true;
    arr ~ 1;
    &i + &f;
}
