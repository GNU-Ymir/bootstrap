in test35;

/**
 * Lexicographic comparison of string literals at compile time, the operands
 * having different lengths.
 */
fn main () {
    cte assert ("ab" < "abc");
    cte assert ("abc" > "ab");
    cte assert ("b" > "abc");
    cte assert ("abc" <= "abc");
    cte assert ("" < "a");

    cte assert ("ab"s16 < "abc"s16);
    cte assert ("hé"s32 < "héllo"s32);
    cte assert ("héllp"s32 > "héllo"s32);
}
