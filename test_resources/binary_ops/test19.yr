in test19;

/**
 * Ordering comparisons on the types that only define equality.
 *
 * validateRangeLeft, validateFuncPtrLeft and validateDGPtrLeft each throw on
 * any operator other than `==` and `!=`.
 */
fn foo (x: i32)-> i32 { x }

fn main () {
    let r = 0 .. 10;
    let f: fn (i32)-> i32 = &foo;
    let d: dg (i32)-> i32 = |x: i32| => x;

    r < r;
    f < f;
    d >= d;
}
