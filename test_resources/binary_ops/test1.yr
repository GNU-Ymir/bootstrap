in test1;

/**
 * Bitwise operators on integers.
 *
 * Covers both operand shapes of BinaryBitwiseValidation::validateIntLeft: the
 * fast path where both sides already share signedness and size, and the
 * inference path where they do not.
 */
fn main () {
    // same signedness, same size: no inference needed
    let a = 12u32;
    let b = 5u32;

    let _and_ = a & b;
    let _or_  = a | b;
    let _xor_ = a ^ b;
    let _shl_ = a << b;
    let _shr_ = a >> b;

    // signed operands
    let c = 12i16;
    let d = 5i16;
    let _sand_ = c & d;
    let _sshl_ = c << d;

    // operands of different sizes: goes through inferValuesForBranch
    let e = 12u8;
    let _mix1_ = e & 5u64;
    let _mix2_ = 12i32 | 5i64;
    let _mix3_ = 12u16 ^ 5u64;

    // the only bitwise affectation operators
    let mut g = 12u32;
    g <<= 1u32;
    g >>= 1u8;
}
