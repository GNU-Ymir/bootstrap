in test15;

/**
 * Range construction overloaded by the class on the *right*.
 *
 * BinaryRangeValidation::validateClassRight resolves opRangeRight, passing the
 * inclusiveness of the operator as its template argument, which is what tells
 * `..` and `...` apart.
 */
class A {
    pub self () {}

    pub fn opRangeRight {true} (self, b : i32)-> ..i32 {
        b ... 10
    }

    pub fn opRangeRight {false} (self, b : i32)-> ..i32 {
        b .. 10
    }
}

fn main () {
    let a = copy A ();

    let _r1_ = 0 .. a;
    let _r2_ = 0 ... a;
}
