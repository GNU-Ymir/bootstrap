in test28;

/**
 * Equality on a class that only defines an ordering.
 *
 * validateClassLeftOrRight tries opEquals first for `==` and `!=`; when the
 * class does not define one, the failure is kept as a note and the comparison
 * falls back to opCmp against zero.
 */
class Ordered {
    pub let v : i32;

    pub self (v : i32) with v = v {}

    pub fn opCmp (self, o : &Ordered)-> i32 {
        self.v - o.v
    }
}

fn main () {
    let a = copy Ordered (1);
    let b = copy Ordered (2);

    let _e1_ = a == b;
    let _e2_ = a != b;
    let _e3_ = a < b;
}
