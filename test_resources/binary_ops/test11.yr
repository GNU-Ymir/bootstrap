in test11;

/**
 * Containment on a right operand that is not a container.
 *
 * None of the arms of BinaryContainsValidation::validateImpl match, so the
 * collected notes are attached to an UNDEFINED_BIN_OP error. The last case
 * does match the map arm, but fails inside it: the left operand cannot be
 * inferred to the key type of the map.
 */
fn main () {
    let i = 12i32;
    let map = copy [1 => "one"];

    i in i;
    i !in true;
    "a" in map;
}
