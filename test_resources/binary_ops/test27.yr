in test27;

/**
 * Comparisons whose left operand matches an arm of validateImpl but whose
 * right operand does not fit it.
 *
 * validateCharLeft, validateFloatLeft and validatePointerLeft each throw when
 * the right operand is not of their own family, and no class arm picks the
 * expression up afterwards.
 */
fn main () {
    let mut i = 12i32;
    let a = 'a'c8;
    let f = 3.14f;
    let p = &i;

    a == 12u8;
    f < i;
    p == 1us;
}
