in test10;

/**
 * Containment overloaded by a class.
 *
 * BinaryContainsValidation::validateClassRight resolves opContains on the
 * right operand, and negates the result for `!in`.
 */
class Bag {
    pub self () {}

    pub fn opContains (self, x : i32)-> bool {
        x == 1
    }
}

fn main () {
    let b = copy Bag ();

    let _c1_ = 1 in b;
    let _c2_ = 1 !in b;
}
