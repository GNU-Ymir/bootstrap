in test37;

/**
 * The appends test36 refuses, once the rows are aliased, or once the slice
 * only gives const access to them.
 */
fn main () {
    let dmut row = copy [1, 2];
    let dmut b: [[i32]] = [];
    b ~= [alias row];
    b = b ~ [alias row];
    b[0][0] = 5;

    let a: [[i32]] = copy [copy [1, 2]];
    let mut c: [[i32]] = [];
    c ~= a;
    c ~= [row];
    c = c ~ a;

    let dmut d: [i32] = [];
    d ~= [1, 2];
    d = d ~ row;
    d[0] = 3;
}
