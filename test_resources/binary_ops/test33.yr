in test33;

/**
 * Comparison of two pointers whose pointees cannot be unified.
 *
 * validatePointerLeft falls back to inferValuesForBranch when the two pointer
 * types are not already equal, and reports its failure as a note.
 */
fn main () {
    let mut i = 12i32;
    let mut f = 3.14f;

    &i == &f;
}
