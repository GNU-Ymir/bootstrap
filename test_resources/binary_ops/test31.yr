in test31;

/**
 * Right operands that match an arm of their operator but do not fit it.
 *
 * Concatenation resolves opBinaryRight on the class and fails, the char
 * branch of validateIntLeft only accepts `+` and `-`, and a slice compares
 * against nothing but another slice or array.
 */
class Plain {
    pub self () {}
}

fn main () {
    let c = copy Plain ();
    let sli: [i32] = copy [1, 2];

    "a" ~ c;
    12u8 * 'a'c8;
    sli == 1;
}
