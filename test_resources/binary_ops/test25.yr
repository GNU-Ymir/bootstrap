in test25;

/**
 * The `of` operator against the pointer type of a class.
 *
 * Unlike a struct, a class pointer on the right of `of` is rejected with
 * CLASS_THROW_PTR: the operator wants the class type, not the type of an
 * instance of it.
 */
class A {
    pub self () {}
}

fn main () {
    let a = copy A ();

    a of typeof (a);
    a !of typeof (a);
}
