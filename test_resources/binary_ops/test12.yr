in test12;

/**
 * Concatenation of arrays and slices.
 *
 * BinaryConcatValidation::validateArrayLeft builds a new static array element
 * by element when both sides are arrays, and falls back to the slice path as
 * soon as one side is a slice; validateSliceOrArrayLeft aliases a static array
 * into a slice before concatenating.
 */
fn main () {
    let arr = [1, 2];
    let brr = [3, 4];
    let sli: [i32] = copy [5, 6];

    // array ~ array: a new static array
    let _aa_ = arr ~ brr;

    // two empty arrays: the result has no element type to take
    let _ee_ = [] ~ [];

    // array ~ slice, and slice ~ array: both go through the slice path
    let _as_ = arr ~ sli;
    let _sa_ = sli ~ arr;

    // slice ~ slice
    let _ss_ = sli ~ sli;

    // affectation form
    let dmut acc = copy [1, 2];
    acc ~= sli;
    acc ~= arr;
}
