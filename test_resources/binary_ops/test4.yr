in test4;

/**
 * Logical operators applied to operands that define none.
 *
 * Exercises the failure path of BinaryLogicalValidation::validateImpl, and the
 * guard of its bool arm: the arm only matches when *both* operands are bool.
 */
fn main () {
    let i = 12u32;
    let b = true;

    i && b;
    b || i;
    i && i;
}
