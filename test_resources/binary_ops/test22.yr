in test22;

/**
 * Char arithmetic that leaves the range the type can represent.
 *
 * CharInterpret::verifyOverflow reports both ends: a sum above the last code
 * point of the width, and a subtraction that goes below zero.
 */
fn main () {
    let _under_ = 12u8 - 'a'c8;
    let _over_  = 200u8 + 'a'c8;
}
