in test16;

/**
 * Range construction over operands that cannot bound a range.
 *
 * BinaryRangeValidation::validateIntLeft infers a common type for the two
 * bounds and rejects it when it is not an integer; the other operand shapes
 * match no arm of validateImpl at all.
 */
fn main () {
    let f = 3.14f;
    let b = true;

    f .. f;
    b ... b;
    "a" .. "b";
}
