in test9;

/**
 * Containment over maps and ranges.
 *
 * BinaryContainsValidation dispatches on the type of the *right* operand:
 * maps build a MapContainsValue directly, ranges go through the core range
 * helper. `!in` wraps either of them in a negation.
 */
fn main () {
    let map = copy [1 => "one", 2 => "two"];
    let rng = 0 .. 10;

    // map
    let _m1_ = 1 in map;
    let _m2_ = 1 !in map;

    // range
    let _r1_ = 1 in rng;
    let _r2_ = 1 !in rng;
    let _r3_ = 1 in 0 .. 10;
}
