in test41;

enum E
| A = 1
;

enum F
| A = 1
;

/**
 * A map keyed by an enum type is tested against a value of that enum only: neither
 * a value of another enum nor one of the proxy type is accepted(cf. test40).
 */
fn main () {
    let m : [F => u8] = copy [F::A => 1u8];
    let a = E::A in m;
    let b = 1 in m;
    if (a && b) {}
}
