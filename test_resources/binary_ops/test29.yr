in test29;

/**
 * Comparisons that fail on both sides of validateImpl.
 *
 * The left match either finds no arm or throws inside one, and the right match
 * cannot resolve an overload on the class either. Operands of the same class
 * are only tried from the left, so their failures are reported once.
 */
class Plain {
    pub self () {}
}

fn main () {
    let p = copy Plain ();

    1 == p;
    true < p;
    p < p;
}
