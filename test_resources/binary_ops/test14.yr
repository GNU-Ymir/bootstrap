in test14;

/**
 * Concatenation of operands that define none.
 *
 * Neither match of BinaryConcatValidation::validateImpl produces a value, so
 * the collected notes are attached to an UNDEFINED_BIN_OP error. The last case
 * matches the array arm but fails inside it, on the element types.
 */
fn main () {
    let i = 12i32;
    let arr = [1, 2];

    i ~ i;
    true ~ arr;
    arr ~ ["a", "b"];
}
