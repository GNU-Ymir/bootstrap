in test17;

/**
 * Comparisons of the operand families that binary_int and binary_float leave
 * untouched: chars of different widths, tuples, and booleans.
 */
fn main () {
    // char comparison, same width then through inferValuesForBranch
    let a = 'a'c8;
    let _c1_ = a == 'b'c8;
    let _c2_ = a < 'b'c8;
    let _c3_ = 'a'c32 <= 'b'c32;

    // bool equality is the only comparison a bool accepts
    let b = true;
    let _b1_ = b == false;
    let _b2_ = b != false;

    // tuples compare field by field, folded with && for == and || for !=
    let t = (1, 'a'c8);
    let _t1_ = t == (2, 'b'c8);
    let _t2_ = t != (2, 'b'c8);
}
