in test36;

/**
 * Appending to a deeply mutable slice of slices gives mutable access to the
 * appended rows, so a row that is not aliased, or const, is refused whether
 * the append is written `~=` or rewritten from `b = b ~ ...`.
 */
fn appendRow () {
    let dmut row = copy [1, 2];
    let dmut b: [[i32]] = [];
    b ~= [row];
}

fn concatRow () {
    let dmut row = copy [1, 2];
    let dmut b: [[i32]] = [];
    b = b ~ [row];
}

fn appendConst () {
    let a: [[i32]] = copy [copy [1, 2]];
    let dmut b: [[i32]] = [];
    b ~= a;
}

fn main () {
    appendRow ();
    concatRow ();
    appendConst ();
}
