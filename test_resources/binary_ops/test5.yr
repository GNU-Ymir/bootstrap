in test5;

/**
 * Congruence operators on operands that are not both floats.
 *
 * The first guard of BinaryComparisonValidation::validateImpl rejects a
 * non-float left operand outright; validateFloatSpecial rejects a non-float
 * right operand.
 */
fn main () {
    let i = 12u32;
    let f = 3.14f;
    let b = true;

    i <=> i;
    f <=> i;
    b <!> b;
}
