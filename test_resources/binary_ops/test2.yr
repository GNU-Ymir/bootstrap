in test2;

/**
 * Bitwise operators applied to operand types that define none.
 *
 * Exercises the failure path of BinaryBitwiseValidation::validateImpl: neither
 * the left match nor the right match produces a value, so the collected notes
 * are attached to an UNDEFINED_BIN_OP error.
 */
fn main () {
    let i = 12u32;
    let f = 1.0f;
    let b = true;

    i & b;
    f ^ f;
    b >> b;
}
