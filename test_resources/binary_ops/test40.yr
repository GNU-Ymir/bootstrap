in test40;

enum E
| A = 1
| B = 2
;

enum S
| A = "a"
| B = "b"
;

/**
 * An enum value, a field access or a variable, is tested as itself against a map
 * keyed by its enum type, or a slice or an array of it, whether the enum is
 * integral or a string. Against a container of the proxy type, it is implicitly
 * cast to it, and an enum container is tested as its underlying value.
 */
fn main () {
    let m : [E => u8] = copy [E::A => 1u8];
    let s : [E] = copy [E::A];
    let r : [E ; 2] = [E::A, E::B];
    let k : E = E::B;
    let a = E::A in m && k !in m && E::A in s && k !in s && k in r && E::A !in r[1 .. 2];

    let sm : [S => u8] = copy [S::A => 1u8];
    let ss : [S] = copy [S::A];
    let sk : S = S::B;
    let b = S::A in sm && sk !in sm && S::A in ss && sk !in ss;

    let pm : [i32 => u8] = copy [1 => 1u8];
    let ps : [[c32]] = copy ["a"];
    let c = E::A in pm && 2 !in pm && k in 0 .. 3 && S::A in ps && 'a' in S::A;

    if (a && b && c) {}
}
