in test26;

/**
 * Slice and class comparison.
 *
 * validateSliceOrArrayLeft aliases a static array into a slice, tries the
 * dedicated equality helper for `==`/`!=` first and falls back to the
 * lexicographic one; validateClassLeftOrRight resolves opEquals for equality
 * and opCmp for ordering, on whichever side carries the class.
 */
class Boxed {
    pub let v : i32;

    pub self (v : i32) with v = v {}

    pub fn opEquals (self, o : &Boxed)-> bool {
        self.v == o.v
    }

    pub fn opCmp (self, o : &Boxed)-> i32 {
        self.v - o.v
    }
}

fn main () {
    let sli: [i32] = copy [1, 2];
    let arr = [1, 2];

    // equality goes through the fast helper, ordering through the slow one
    let _s1_ = sli == sli;
    let _s2_ = sli != sli;
    let _s3_ = sli < sli;
    let _s4_ = sli >= sli;

    // a static array is aliased to a slice first
    let _a1_ = arr == arr;
    let _a2_ = arr < sli;

    let b = copy Boxed (1);
    let c = copy Boxed (2);

    let _b1_ = b == c;
    let _b2_ = b != c;
    let _b3_ = b < c;
    let _b4_ = b >= c;
}
