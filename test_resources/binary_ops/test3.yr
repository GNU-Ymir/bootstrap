in test3;

/**
 * Class overloads of the bitwise and logical operators.
 *
 * Reaches BinaryValidation::validateClassLeft/validateClassRight from
 * BinaryBitwiseValidation and BinaryLogicalValidation, which the math
 * operators were the only ones to exercise.
 */
class A {
    pub self () {}

    pub fn opBinary {"&"} (self, x : i32)-> i32 {
        x & 1
    }

    pub fn opBinary {"&&"} (self, b : bool)-> bool {
        b
    }

    pub fn opBinaryRight {"|"} (self, x : i32)-> i32 {
        x | 1
    }

    pub fn opBinaryRight {"||"} (self, b : bool)-> bool {
        b
    }
}

fn main () {
    let a = copy A ();

    let _l1_ : i32 = a & 2;
    let _l2_ : bool = a && true;

    let _r1_ : i32 = 2 | a;
    let _r2_ : bool = true || a;
}
