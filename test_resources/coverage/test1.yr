in test1;

/**
 * Multi-term '&&' over indexed slices: the short circuit and the three bounds checks are
 * lowering details, only the 'if' itself is a branch, and each source line is one line entry
 */
fn multiTerm (s : [c8])-> bool {
    if (s.len > 2us && s[0] == 'a'c8 && s[1] == 'b'c8) {
        return true;
    }

    return false;
}

/**
 * An 'if' without an 'else': the not-taken path has no source line of its own
 */
fn withoutElse (i : i32)-> i32 {
    let mut r = 0;
    if (i > 0) {
        r = i;
    }

    return r;
}

/**
 * A complete 'if'/'else', and a ternary on a single line
 */
fn withElse (i : i32)-> i32 {
    let t = if (i > 0) { 1 } else { 2 };
    if (i > 10) {
        return t;
    } else {
        return -t;
    }
}

/**
 * A loop: entering the body and falling out of it are the two outcomes
 */
fn loop_ (n : usize)-> usize {
    let mut acc = 0us;
    for i in 0us .. n {
        acc += i;
    }

    return acc;
}

/**
 * An 'assert': its taken branch is the panic, never reached in a passing run
 */
fn asserting (i : i32)-> i32
    throws AssertError
{
    assert (i > 0);

    return i;
}
