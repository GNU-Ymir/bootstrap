in test2;

/**
 * A class, only there to give the functions below something to end a statement on
 */
class Acc {
    pub let mut value: i32 = 0;

    pub self () {}
}

/**
 * A body ending on an assignment: the ';' closing it produces a unit value located on EOF, and
 * the block is located on its last value
 */
fn endsOnAssign (dmut a: &Acc, i: i32) {
    a.value = i;
}

/**
 * A body ending on a call, same shape
 */
fn endsOnCall (dmut a: &Acc, i: i32) {
    endsOnAssign (alias a, i);
}

/**
 * A body ending on a return: the return is the last value of the block, and has a file
 */
fn endsOnReturn (a: &Acc)-> i32 {
    return a.value;
}

/**
 * A body ending on a value, same
 */
fn endsOnValue (a: &Acc)-> i32 {
    a.value
}
