/*
 * With error recovery, a function whose body starts with a broken local
 * declaration is still validated, from the declarations and instructions
 * following it.
 */

in test7;

fn foo ()-> i32 {
    fn inner ( {}
    fn other ()-> i32 { 1 }
    let x: i32 = "not an int";
    x + other ()
}

fn fine ()-> i32 {
    foo ()
}
