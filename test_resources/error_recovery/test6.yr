/*
 * With error recovery, a local module with a syntax error is still
 * validated: the symbols declared around the broken declaration are found.
 */

in test6;

mod M {
    pub fn first ()-> i32 { 1 }

    fn broken ( {
    }

    pub fn second ()-> i32 { 2 }
}

fn wrong ()-> i32 {
    "not an int"
}

fn fine ()-> i32 {
    M::first () + M::second ()
}
