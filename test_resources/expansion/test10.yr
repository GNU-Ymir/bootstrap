record Window {
    pub let start : usize;

    pub self (start : usize)
        with start = start
    {}
}

fn volume (width : i32, depth : i32, height : i32)-> i32 {
    width * depth * height
}

fn around (values : [i32], n : usize)-> i32 {
    volume (expand values [n - 1us .. n + 2us])
}

fn shifted (values : [i32], n : i32)-> i32 {
    volume (expand values [n + 1 .. 4 + n])
}

fn window (values : [i32], w : Window)-> i32 {
    volume (expand values [w.start .. w.start + 3us])
}

fn width (values : [i32], n : usize)-> usize {
    values [n .. n + 3us].len
}

fn main () {
    let slc = copy [2, 3, 4, 5, 6];
    let _ = around (slc, 1us);
    let _ = shifted (slc, 0);
    let _ = window (slc, Window (1us));
    let _ = width (slc, 1us);
}
