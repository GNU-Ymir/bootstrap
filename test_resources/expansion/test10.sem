frame: test10::main ()-> void {
    let slc: [i32] = copy ({.len = 5us, .ptr = &([2, 3, 4, 5, 6])});
    let _: i32 = test10::around (slc, 1us);
    let _: i32 = test10::shifted (slc, 0);
    let _: i32 = test10::window (slc, test10::Window::self(new, 1us));
    let _: usize = test10::width (slc, 1us);
    <unit-value>
}
frame: test10::width (values: [i32], n: usize)-> usize return {
    #{
        if ((values.len < (n + 3us)) || ((n + 3us) < n)) panic;
        3us
    #}
}
frame: test10::Window::self (mut ref self: mut test10::Window, start: usize)-> void {
    self.start = start;
    <unit-value>
}
frame: test10::around (values: [i32], n: usize)-> i32 return {
    test10::volume (#{
            if ((values.len < (n + 2us)) || ((n + 2us) < (n - 1us))) panic;
            {.len = 3us, .ptr = (values.ptr + ((n - 1us) * 4us)), .blk = values.blk_info}
        #} [0us], #{
            if ((values.len < (n + 2us)) || ((n + 2us) < (n - 1us))) panic;
            {.len = 3us, .ptr = (values.ptr + ((n - 1us) * 4us)), .blk = values.blk_info}
        #} [1us], #{
            if ((values.len < (n + 2us)) || ((n + 2us) < (n - 1us))) panic;
            {.len = 3us, .ptr = (values.ptr + ((n - 1us) * 4us)), .blk = values.blk_info}
        #} [2us])
}
frame: test10::volume (width: i32, depth: i32, height: i32)-> i32 return ((width * depth) * height)
frame: test10::window (values: [i32], w: test10::Window)-> i32 return {
    test10::volume (#{
            if ((values.len < (w.start + 3us)) || ((w.start + 3us) < w.start)) panic;
            {.len = 3us, .ptr = (values.ptr + (w.start * 4us)), .blk = values.blk_info}
        #} [0us], #{
            if ((values.len < (w.start + 3us)) || ((w.start + 3us) < w.start)) panic;
            {.len = 3us, .ptr = (values.ptr + (w.start * 4us)), .blk = values.blk_info}
        #} [1us], #{
            if ((values.len < (w.start + 3us)) || ((w.start + 3us) < w.start)) panic;
            {.len = 3us, .ptr = (values.ptr + (w.start * 4us)), .blk = values.blk_info}
        #} [2us])
}
frame: test10::shifted (values: [i32], n: i32)-> i32 return {
    test10::volume (#{
            if ((values.len < cast!{usize}((4 + n))) || (cast!{usize}((4 + n)) < cast!{usize}((n + 1)))) panic;
            {.len = 3us, .ptr = (values.ptr + (cast!{usize}((n + 1)) * 4us)), .blk = values.blk_info}
        #} [0us], #{
            if ((values.len < cast!{usize}((4 + n))) || (cast!{usize}((4 + n)) < cast!{usize}((n + 1)))) panic;
            {.len = 3us, .ptr = (values.ptr + (cast!{usize}((n + 1)) * 4us)), .blk = values.blk_info}
        #} [1us], #{
            if ((values.len < cast!{usize}((4 + n))) || (cast!{usize}((4 + n)) < cast!{usize}((n + 1)))) panic;
            {.len = 3us, .ptr = (values.ptr + (cast!{usize}((n + 1)) * 4us)), .blk = values.blk_info}
        #} [2us])
}
