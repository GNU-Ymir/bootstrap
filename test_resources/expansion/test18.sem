frame: test18::main ()-> void {
    let _: [i32 ; 3us] = test18::show (2, 1us);
    <unit-value>
}
frame: test18::make (x: i32)-> [i32 ; 5us] return [x, 3, 4, 5, 6]
frame: test18::show (x: i32, n: usize)-> [i32 ; 3us] return {
    #{
        if ((5us < (n + 3us)) || ((n + 3us) < n)) panic;
        [test18::make (x) [n], test18::make (x) [(n + 1us)], test18::make (x) [(n + 2us)]]
    #}
}
