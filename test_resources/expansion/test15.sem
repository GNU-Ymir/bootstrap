frame: test15::main ()-> void {
    let _: i32 = test15::show ([2, 3, 4, 5, 6], 1us);
    let _: [i32 ; 2us] = test15::part ([2, 3, 4, 5, 6], 1);
    <unit-value>
}
frame: test15::part (values: [i32 ; 5us], n: i32)-> [i32 ; 2us] return {
    #{
        if ((5us < cast!{usize}((n + 1))) || (cast!{usize}((n + 1)) < cast!{usize}((n - 1)))) panic;
        [values [cast!{usize}((n - 1))], values [(cast!{usize}((n - 1)) + 1us)]]
    #}
}
frame: test15::show (values: [i32 ; 5us], n: usize)-> i32 return {
    test15::volume (#{
            if ((5us < (n + 3us)) || ((n + 3us) < n)) panic;
            [values [n], values [(n + 1us)], values [(n + 2us)]]
        #} [0us], #{
            if ((5us < (n + 3us)) || ((n + 3us) < n)) panic;
            [values [n], values [(n + 1us)], values [(n + 2us)]]
        #} [1us], #{
            if ((5us < (n + 3us)) || ((n + 3us) < n)) panic;
            [values [n], values [(n + 1us)], values [(n + 2us)]]
        #} [2us])
}
frame: test15::volume (width: i32, depth: i32, height: i32)-> i32 return ((width * depth) * height)
