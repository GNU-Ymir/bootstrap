// copy, dcopy and alias all read after the expansion, never before it
fn bar (_ : i32, _ : i32) {}

fn baz (dmut _ : [i32], _ : [i32]) {}

fn main () {
    let x = [1, 2];
    bar (copy expand x);
    bar (dcopy expand x);

    let mut z : (mut [mut i32], [i32]) = alias (copy [1, 2], copy [3, 4]);
    baz (alias expand z);
}
