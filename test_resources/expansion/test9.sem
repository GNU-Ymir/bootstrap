frame: test9::show (values: [i32], n: usize)-> (i32, i32) return {
    (test9::volume (#{
                if (values.len < 3us) panic;
                {.len = 3us, .ptr = (values.ptr + (0us * 4us)), .blk = values.blk_info}
            #} [0us], #{
                if (values.len < 3us) panic;
                {.len = 3us, .ptr = (values.ptr + (0us * 4us)), .blk = values.blk_info}
            #} [1us], #{
                if (values.len < 3us) panic;
                {.len = 3us, .ptr = (values.ptr + (0us * 4us)), .blk = values.blk_info}
            #} [2us]), test9::volume (#{
                if ((values.len < (n + 3us)) || ((n + 3us) < n)) panic;
                {.len = 3us, .ptr = (values.ptr + (n * 4us)), .blk = values.blk_info}
            #} [0us], #{
                if ((values.len < (n + 3us)) || ((n + 3us) < n)) panic;
                {.len = 3us, .ptr = (values.ptr + (n * 4us)), .blk = values.blk_info}
            #} [1us], #{
                if ((values.len < (n + 3us)) || ((n + 3us) < n)) panic;
                {.len = 3us, .ptr = (values.ptr + (n * 4us)), .blk = values.blk_info}
            #} [2us]))
}
