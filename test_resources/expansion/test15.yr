fn volume (width : i32, depth : i32, height : i32)-> i32 {
    width * depth * height
}

fn show (values : [i32 ; 5], n : usize)-> i32 {
    volume (expand values [n .. n + 3us])
}

fn part (values : [i32 ; 5], n : i32)-> [i32 ; 2] {
    values [n - 1 .. n + 1]
}

fn main () {
    let _ = show ([2, 3, 4, 5, 6], 1us);
    let _ = part ([2, 3, 4, 5, 6], 1);
}
