fn bar ();
fn baz ();
fn qux ();

// a scope guard whose body holds another one, whose own body holds a jump: the
// finally part of the inner guard is built once per copy of the finally part of
// the outer one, and every one of those copies is a region of its own
fn foo (c : bool) {
    {
        bar ();
    } exit {
        {
            baz ();
        } exit {
            if (c) {
                qux ();
            }
        }
    }
}
