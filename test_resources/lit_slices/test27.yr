in test27;

/*
 * A repeated value of a size known at runtime is deep copied once allocated,
 * so the elements it repeats are copied even inside a deep copied literal
 */

fn main (args: [[c8]]) {
    let n = args.len + 2us;

    let dmut a = dcopy [[[0 ; 2] ; n], [[0 ; 2] ; n]];
    let dmut b = dcopy [[0 ; n] ; 3];

    a[1][0][0] = 5;
    b[1][0] = 5;
}
