in test26;

/*
 * The repeated value of a deep copy is evaluated once, and every element is a
 * deep copy of it, the value itself being borrowed
 */

fn row (x: [i32])-> [i32] {
    x
}

fn main () {
    let x = copy [0, 0];
    let dmut a: [[i32]] = dcopy [row (x) ; 3];
    a[1][0] = 5;

    let dmut b = dcopy [[x ; 2] ; 2];
    b[1][0][0] = 5;
}
