in test23;

/*
 * Range slicing of an array of records, the offset of the sub slice must
 * be computed using the size of the record
 */

record R {
    pub let mut v: [c8] = "";
    pub let mut w: i32 = 0;

    pub self (v: [c8]) with v = v {}
}

fn main () {
    let a = copy [R("one"), R("two")];

    let b = a[1 .. 2];
    let c = a[1];

    b; c;
}
