frame: test11::main ()-> void {
    let mut a: mut [mut i32] = copy ({.len = 4us, .ptr = &([1, 2, 3, 4])});
    #{
        let #_dst: mut [mut i32] = #{
                if ((a.len < 3us) || (3us < 0us)) panic;
                {.len = 3us, .ptr = (a.ptr + (0us * 4us)), .blk = a.blk_info}
            #};
        let #_src: mut [mut i32] = #{
                if (a.len < 4us) panic;
                {.len = 3us, .ptr = (a.ptr + (1us * 4us)), .blk = a.blk_info}
            #};
        if (#_dst.ptr > #_src.ptr) {
            let mut #_index: usize = #_dst.len;
            while (0us < #_index) {
                #_index = (#_index - 1us);
                #_dst [#_index] = #_src [#_index]
            }
        } else {
            let mut #_index: usize = 0us;
            while (#_index < #_dst.len) {
                #_dst [#_index] = #_src [#_index]
            } step #_index = (#_index + 1us)
        };
        <unit-value>
    #};
    <unit-value>
}
