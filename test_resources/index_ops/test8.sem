frame: test8::fill (mut a: mut [mut i32], x: usize, b: [i32])-> void {
    #{
        let #_dst: mut [mut i32] = #{
                if ((a.len < x) || (x < 0us)) panic;
                {.len = x, .ptr = (a.ptr + (0us * 4us)), .blk = a.blk_info}
            #};
        let #_src: [i32] = b;
        if (#_dst.len != #_src.len) panic;
        if (#_dst.ptr > #_src.ptr) {
            let mut #_index: usize = #_dst.len;
            while (0us < #_index) {
                #_index = (#_index - 1us);
                #_dst [#_index] = #_src [#_index]
            }
        } else {
            let mut #_index: usize = 0us;
            while (#_index < #_dst.len) {
                #_dst [#_index] = #_src [#_index]
            } step #_index = (#_index + 1us)
        };
        <unit-value>
    #};
    <unit-value>
}
frame: test8::main ()-> void {
    let mut a: mut [mut i32] = copy ({.len = 3us, .ptr = &([1, 2, 3])});
    let b: [i32] = copy ({.len = 2us, .ptr = &([7, 8])});
    test8::fill (alias (a), 2us, b);
    <unit-value>
}
