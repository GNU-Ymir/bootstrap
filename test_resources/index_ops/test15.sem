frame: test15::scatter (mut a: mut [mut i32], s: [i32])-> void {
    #{
        if (2us != s.len) panic;
        let #_src: [i32 ; 2us] = [s [0us], s [1us]];
        #{
            if (a.len <= 0us) panic;
            a [0us]
        #} = #_src [0us];
        #{
            if (a.len <= 1us) panic;
            a [1us]
        #} = #_src [1us];
        <unit-value>
    #};
    <unit-value>
}
