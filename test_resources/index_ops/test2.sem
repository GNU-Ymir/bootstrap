                    a [2us]
                #}])});
    if !core::types::array::opEquals!{[i32], i32}::opEquals (b, {.len = 3us, .ptr = &([0, 7, 2])}) throw core::exception::assertion::AssertError::self(new, ""s8);
    test2::gather (a, 3us);
    <unit-value>
}
