/**
 * A tag declaration with no use: its globals are validated, one per tag, its
 * `apply` overloads of each kind and its `self` overloads are not, being
 * templates instantiated for a tag site.
 * */

in test1;

tag truc (param: [c8], times: i32 = 1) {
    lazy mut COUNT: i32 = 0;

    pub lazy NAMES: [[c8]] = copy ["truc"];

    pub fn apply {F: fn (T)-> i32, T...} (x: i32, other: T)-> i32 {
        F (expand other) + x * times
    }

    pub class apply {class C} {
        pub fn route (self)-> [c8] {
            param
        }
    }

    pub enum apply {enum E}
    | EXTRA = 0;

    pub union apply {union U}
    | f64;

    pub self {F: fn ()-> i32} () {
        COUNT += F ();
    }

    pub {
        self () {
            COUNT += 1;
        }
    }
}

/**
 * A tag without parameters, nor anything in it
 * */
pub tag registered {}

fn main () {}
