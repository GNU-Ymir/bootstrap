// The `self` overload of a tag sees the private fields of the class it constructs for only, not those of another class

in test109;

class Bar {
    let mut _x: i32 = 0;
    pub self () {}
}

tag t {
    pub self {class C} () {
        let _x_: __pragma!field_type (Bar, "_x") = 0;
    }
}

#[t]
class Foo {
    pub self () {}
}

fn main () {}
