/**
 * An `apply` overload sees the class as written: a conditional block of the
 * overload asking whether the class has a member the overload itself declares
 * sees it without that member.
 * */

in test43;

tag defaulted {
    pub class apply {class C} {
        cte if (!__pragma!compile ({ let c = copy C (); c.value () })) {
            pub fn value (self)-> i32 {
                0
            }
        }
    }
}

#[defaulted]
class Foo {
    pub self () {}
}

#[defaulted]
class Bar {
    pub self () {}

    pub fn value (self)-> i64 {
        1i64
    }
}

fn main () {
    let _x_: i32 = (copy Foo ()).value ();
    let _y_: i64 = (copy Bar ()).value ();
}
