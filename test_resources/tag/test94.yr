/*
 * A `fn` template parameter outside of a tag receives a function pointer
 * given explicitly, a function, a lambda or an enum value, `fn (...)` in a
 * template parameter list still being a function pointer type.
 */

in test94;

fn one ()-> i32 { 1 }

fn greet (name: [c8])-> [c8] { "hello " ~ name }

enum Callbacks : fn ()-> i32
| ONE = &one;

fn call {fn F} ()-> __pragma!return_type (F) {
    F ()
}

fn apply {fn F} (a: __pragma!parameter_type (F, 0us))-> __pragma!return_type (F) {
    F (a)
}

fn typed {F: fn (i32)-> i32} (x: i32)-> i32 { F (x) }

fn main () {
    let _a_: i32 = call!{&one} ();
    let _b_: [c8] = apply!{&greet} ("you");
    let _c_: i32 = apply!{|x: i32| => x + 1} (2);
    let _d_: i32 = call!{Callbacks::ONE} ();
    let _e_: i32 = typed!{|x: i32| => x * 2} (3);
}
