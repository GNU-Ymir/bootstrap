/**
 * The instance of the `apply` overload a tag site selects for a union appends
 * its member types to the union, after the written ones, whose indexes are
 * unchanged. A method every member declares, the appended one included, is
 * callable on the union.
 * */

in test51;

record Circle {
    pub let r: i32;

    pub self (r: i32) with r = r {}

    pub fn area (self)-> i32 { 3 * self.r * self.r }
}

record Square {
    pub let side: i32;

    pub self (side: i32) with side = side {}

    pub fn area (self)-> i32 { self.side * self.side }
}

record Empty {
    pub self () {}

    pub fn area (self)-> i32 { 0 }
}

tag emptied {
    pub union apply {union U}
    | Empty;
}

#[emptied]
union Shape
| Circle
| Square;

fn area (s: Shape)-> i32 {
    match s {
        c: Circle => { c.r }
        q: Square => { q.side }
        _: Empty  => { -1 }
    }
}

fn main () {
    let s: Shape = Empty ();
    let _x_ = s.area () + area (s) + area (Circle (2));
}
