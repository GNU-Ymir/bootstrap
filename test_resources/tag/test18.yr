/**
 * The tag sites of a template are resolved for each of its specializations,
 * their arguments rewritten with the template parameters of the specialization.
 * */

in test18;

tag sized (size: usize) {
    pub fn apply {F: fn (T)-> T, T} (x: T)-> T {
        F (x)
    }
}

#[sized (T::size)]
fn identity {T} (x: T)-> T { x }

fn main () {
    let _x_ = identity (2) + cast!i32 (identity (3u8));
}
