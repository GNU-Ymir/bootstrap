/**
 * `__pragma!tag` and `__pragma!field_tag` read the arguments of the single site
 * of a tag on a symbol or on a field: a record holding a field per parameter of
 * the tag, named after it, given positionally, by name or defaulted. Its
 * fields are compile-time values, usable in a cte if or as a template argument.
 * */

in test96;

tag rename (name: [c8], prefix: [c8] = "", n: i32 = 1) {}

tag serial (version: i32, strict: bool = false) {}

#[serial (2)]
record Foo {
    #[rename ("a-field")]
    pub let a_field: i32 = 0;

    #[rename (n-> 3, name-> "b-field", prefix-> "_")]
    pub let b_field: i32 = 0;
}

fn twice {N: i32} ()-> i32 { N * 2 }

fn main () {
    let params = __pragma!tag (Foo, serial);
    let _version_ = params.version;
    let _strict_ = cte if (__pragma!tag (Foo, serial).strict) { "strict" } else { "lax" };

    let a = __pragma!field_tag (Foo, "a_field", rename);
    let _a_ = (a.name, a.prefix, a.n);

    let b = __pragma!field_tag (Foo, "b_field", rename);
    let _b_ = (b.name, b.prefix, b.n);
    let _twice_ = twice!{__pragma!field_tag (Foo, "b_field", rename).n} ();
}
