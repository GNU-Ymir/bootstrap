/**
 * The instance of the `apply` overload a tag site selects for a class is not a
 * class of its own: its members are declared into the tagged class, which
 * keeps its name, its ancestor and its written members. The fields it declares
 * are laid out after the written ones, and reach the scope of the tag.
 * */

in test39;

class Base {
    pub let id: i32;

    pub self (id: i32)
        with id = id
    {}
}

tag counted (start: i32) {
    lazy STEP: i32 = 1;

    pub class apply {class C} {
        pub let mut count: i32 = start;
        pub let step: i32 = STEP;

        pub fn incr (mut self)-> i32 {
            self.count += self.step;
            self.count
        }
    }
}

#[counted (10)]
class Foo over Base {
    pub let name: [c8];

    pub self (name: [c8])
        with super (1), name = name
    {}
}

fn main () {
    let dmut f = copy Foo ("foo");
    let _x_ = f:.incr () + f.id;
}
