// a match covering the written values of an enum is not complete once a tag
// appends one

tag extended {
    pub enum apply {enum E}
    | BLUE = 2;
}

#[extended]
enum Color
| RED = 0
| GREEN = 1;

fn name (c: Color)-> [c8] {
    match c {
        Color::RED   => { "red" }
        Color::GREEN => { "green" }
    }
}

fn main () {
    let _n_ = name (Color::RED);
}
