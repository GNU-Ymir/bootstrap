/**
 * A `yield apply` turns the function it receives into a generator: the merged
 * function is a generator whatever the kind of the function as written.
 * */

in test68;

tag t {
    pub yield apply {F: fn (i32)-> i32} (n: i32)-> i32 {
        for i in 0 .. n { yield F (i); }
    }
}

#[t]
fn sq (n: i32)-> i32 { n * n }

fn main () {
    let _lst_ = copy [i for i in sq (3)];
}
