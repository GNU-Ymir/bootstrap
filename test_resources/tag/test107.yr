// A parameter of a tag does not replace the name of a method called with `:.`, nor the right of a `::` path

in test107;

enum E
| name = "member";

tag t (name: [c8]) {
    pub class apply {class C} {
        pub fn names (mut self)-> ([c8], [c8], [c8]) {
            (self:.name (), E::name, name)
        }
    }
}

#[t ("param")]
class Foo {
    let mut _n: [c8] = "method";
    pub self () {}

    pub fn name (mut self)-> [c8] {
        self._n
    }
}

fn main () {
    let dmut foo = copy Foo ();
    let _names_ = foo:.names ();
}
