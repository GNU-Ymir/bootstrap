/*
 * An `apply {fn F}` overload receives a tagged function whatever its
 * signature: its parameter and return types are read from F, and F calls it.
 * A `yield apply {fn F}` receives a tagged generator the same way.
 */

in test91;

tag forwarded {
    pub fn if (__pragma!is_function (F)) apply {fn F} (a: __pragma!parameter_type (F, 0us))-> __pragma!return_type (F) {
        F (a)
    }
}

tag doubled {
    pub yield apply {fn F} (n: __pragma!parameter_type (F, "n"))-> __pragma!return_type (F) {
        for i in F (n) { yield i * 2; }
    }
}

#[forwarded]
fn ints (x: i32)-> i32 { x + 1 }

#[forwarded]
fn floats (x: f64)-> f64 { x * 2.0 }

#[forwarded]
fn length (x: [c8])-> usize { x.len }

#[doubled]
yield count (n: i32)-> i32 {
    for i in 0 .. n { yield i; }
}

fn main () {
    let _a_: i32 = ints (1);
    let _b_: f64 = floats (2.0);
    let _c_: usize = length ("three");
    let _d_ = copy [i for i in count (3)];
}
