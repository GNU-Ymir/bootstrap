/*
 * A `fn` template parameter only receives a function: a tagged class does
 * not reach an `apply {fn F}` overload, nor does a type or a value that is
 * not a function given explicitly.
 */

in test93;

tag plain {
    pub fn apply {fn F} ()-> __pragma!return_type (F) {
        F ()
    }
}

#[plain]
class A {
    pub self () {}
}

fn call {fn F} ()-> __pragma!return_type (F) {
    F ()
}

fn main () {
    let _a_ = call!{i32} ();
    let _b_ = call!{12} ();
}
