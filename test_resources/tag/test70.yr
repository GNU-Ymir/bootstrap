/**
 * A `fn apply` whose return type is left open passes the handle of a tagged
 * generator through, its return type being bound to `yield-> i32`.
 * */

in test70;

tag shift {
    pub fn apply {F: fn (i32)-> R, R} (n: i32)-> R { F (n + 1) }
}

#[shift]
yield count (n: i32)-> i32 {
    for i in 0 .. n { yield i; }
}

fn main () {
    let _lst_ = copy [i for i in count (3)];
}
