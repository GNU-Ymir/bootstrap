/**
 * `__pragma!method_infos` gives the FunctionInfo of each method a class
 * declares, its implementations included, by the name `__pragma!method`
 * reaches it: neither the methods of its ancestors nor the templates of
 * methods, and only the ones the scope of the pragma can access.
 * */

in test112;

trait Named {
    pub fn name (self)-> [c8];
}

class Base {
    pub self () {}

    pub fn inherited (self) {}
}

class Foo over Base {
    pub self () with super () {}

    pub fn one (self, _: i32)-> i32 { 1 }

    pub fn one (self)-> i32 { 1 }

    prv fn secret (self) {}

    prot fn shared (mut self) {}

    pub yield values (self)-> i32 { yield 1; }

    pub fn tmpl {T} (self, _: T) {}

    impl Named {
        pub over name (self)-> [c8] { "foo" }
    }

    pub fn inside (self)-> usize {
        __pragma!method_infos (Foo).len
    }
}

fn main () {
    let mut names = "";
    cte for m in __pragma!method_infos (Foo) {
        names = names ~ "/" ~ m.name ~ ":" ~ m.kind;
    }

    let _names_ = names;
    let _arity_ = (__pragma!method_infos (Foo)[0].arity, __pragma!method_infos (Foo)[1].arity, __pragma!method_infos (Foo)[0].isMethod);
    let _inside_ = (Foo ()).inside ();
}
