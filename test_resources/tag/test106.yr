// A parameter of a tag does not replace the name of a field accessed with `.` inside the tag

in test106;

tag t (name: [c8]) {
    pub class apply {class C} {
        pub fn fields (self)-> [[c8]] {
            let mut res: [[c8]] = copy [name];
            cte for i in 0us .. C::field_infos.len {
                res ~= [C::field_infos[i].name];
            }

            res
        }
    }
}

#[t ("Foo")]
class Foo {
    let mut _x: i32 = 0;
    pub self () {}
}

fn main () {
    let _fields_ = (copy Foo ()).fields ();
}
