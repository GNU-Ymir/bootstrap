// The field tag pragmas name a field the class or the record declares, a tag, and take three parameters

in test104;

tag route (path: [c8]) {}

fn notATag () {}

record Foo {
    #[route ("/x")]
    pub let x: i32 = 0;
}

fn a () { let _x_ = __pragma!field_has_tag (Foo, "z", route); }

fn b () { let _x_ = __pragma!field_tag (i32, "x", route); }

fn c () { let _x_ = __pragma!field_tags (Foo, "x", notATag); }

fn d () { let _x_ = __pragma!field_has_tag (Foo, "x"); }

fn e () { let _x_ = __pragma!tag (Foo, notATag); }

fn f () { let _x_ = __pragma!tags (Foo); }

fn g () { let _x_ = __pragma!tag (i32, route); }

fn main () {
    a ();
    b ();
    c ();
    d ();
    e ();
    f ();
    g ();
}
