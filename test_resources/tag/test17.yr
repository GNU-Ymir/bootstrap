/**
 * Each tag site is resolved for the symbol it tags: its arguments, named or
 * defaulted, are bound to the parameters of the tag as compile-time values,
 * and the `apply` and `self` overloads whose first template parameter receives
 * the symbol are selected, a `self` taking no template parameter applying to
 * any symbol. A tag without overloads only registers the symbol.
 * */

in test17;

tag truc (param: [c8], times: i32 = 1) {
    pub fn apply {F: fn ()-> i32} ()-> i32 {
        F () * times
    }

    pub fn apply {F: fn (T)-> i32, T...} (x: i32, other: T)-> i32 {
        F (expand other) + x * times
    }

    pub class apply {class C} {}

    pub record apply {record R} {}

    pub enum apply {enum E}
    | EXTRA = 0;

    pub union apply {union U}
    | Extra;

    pub self {F: fn ()-> i32} () {}

    pub self () {}
}

tag registered (n: i32) {}

#[truc ("/foo")]
fn foo (x: i32)-> i32 { x }

#[truc ("/zero")]
fn zero ()-> i32 { 0 }

#[truc ("/bar", times-> 2 * 4)]
class Bar {
    pub self () {}
}

#[truc (param-> "/baz")]
record Baz {}

record Qux {}

record Extra {}

#[truc ("/color")]
enum Color
| RED = 0
| GREEN = 1;

#[truc ("/value"), registered (2 + 3)]
union Value
| Baz
| Qux;

fn main () {
    let _x_ = foo (1, 2) + zero ();
    let _b_ = copy Bar ();
}
