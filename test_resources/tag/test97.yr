/**
 * `__pragma!tags` and `__pragma!field_tags` read the arguments of every site of
 * a tag on a symbol or on a field, in the order they are written, as a static
 * array iterated by a cte for, empty when there is none. Every site of a tag
 * shares one record type, whatever it is written on.
 * */

in test97;

tag route (path: [c8]) {}

tag plain {}

tag sized {N: usize} (names: [[c8] ; N]) {}

#[route ("/a"), plain, route ("/b")]
fn handler ()-> i32 { 1 }

#[route ("/c")]
fn single ()-> i32 { 2 }

fn bare ()-> i32 { 3 }

record Foo {
    #[route ("/x"), route ("/y")]
    pub let x: i32 = 0;

    #[route ("/z")]
    pub let z: i32 = 0;

    pub let w: i32 = 0;
}

fn main () {
    let mut joined = "";
    cte for r in __pragma!tags (handler, route) {
        joined = joined ~ r.path;
    }

    let mut fields = "";
    cte for r in __pragma!field_tags (Foo, "x", route) {
        fields = fields ~ r.path;
    }

    let _joined_ = (joined, fields);
    let _counts_ = (__pragma!tags (handler, route).len, __pragma!tags (single, route).len, __pragma!tags (bare, route).len, __pragma!tags (bare, sized).len);
    let _fields_ = (__pragma!field_tags (Foo, "x", route).len, __pragma!field_tags (Foo, "z", route).len, __pragma!field_tags (Foo, "w", route).len);
    let _plain_ = __pragma!tags (handler, plain);
    let _empty_ = __pragma!field_tags (Foo, "w", route);

    let mut site = __pragma!tag (single, route);
    site = __pragma!tags (handler, route)[1];
    site = __pragma!field_tag (Foo, "z", route);
    let _site_ = site.path;
}
