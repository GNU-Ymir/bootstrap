/*
 * An `apply` overload constrained by a signature is preferred to an
 * `apply {fn F}` one when both receive the tagged function, the generic one
 * receiving the functions the constrained one does not.
 */

in test92;

tag described {
    pub fn apply {F: fn (i32)-> i32} (x: i32)-> [c8] {
        if (F (x) > 0) { "positive" } else { "negative" }
    }

    pub fn apply {fn F} (x: __pragma!parameter_type (F, 0us))-> __pragma!return_type (F) {
        F (x)
    }
}

#[described]
fn twice (x: i32)-> i32 { x * 2 }

#[described]
fn half (x: f64)-> f64 { x / 2.0 }

fn main () {
    let _a_: [c8] = twice (1);
    let _b_: f64 = half (1.0);
}
