/**
 * `__pragma!has_tag` tells at compile time whether a tag is written on top of a
 * function, a class, a record, an enum, a union, a template or one of its
 * specializations. The tag is resolved by the usual lookup, and compared with
 * the one each site names from the scope of the symbol. A tagged function
 * carries its tags whether it is named or untagged.
 * */

in test65;

tag a {}

tag b (x: i32) {}

mod web {
    pub tag route (path: [c8]) {}
}

tag doubled {
    pub fn apply {F: fn (i32)-> i32} (x: i32)-> i32 {
        F (x) * 2
    }
}

#[doubled, a]
fn foo (x: i32)-> i32 { x + 1 }

fn bar ()-> i32 { 2 }

#[b (1), web::route ("/baz")]
class Baz {
    pub self () {}
}

#[a]
record Rec {}

record Qux {}

#[a]
enum Color
| RED = 0
| GREEN = 1;

#[web::route ("/value")]
union Value
| Rec
| Qux;

#[a]
fn generic {T} (x: T)-> T { x }

fn describe {T} ()-> [c8] {
    cte if __pragma!has_tag (T, web::route) { "routed" } else { "plain" }
}

fn main () {
    let _foo_ = (__pragma!has_tag (foo, doubled), __pragma!has_tag (foo, a), __pragma!has_tag (foo, b), __pragma!has_tag (__pragma!untagged (foo), a));
    let _bar_ = __pragma!has_tag (bar, a);
    let _class_ = (__pragma!has_tag (Baz, b), __pragma!has_tag (Baz, web::route), __pragma!has_tag (Baz, a));
    let _record_ = (__pragma!has_tag (Rec, a), __pragma!has_tag (Qux, a));
    let _enum_ = (__pragma!has_tag (Color, a), __pragma!has_tag (Color, b));
    let _union_ = (__pragma!has_tag (Value, web::route), __pragma!has_tag (Value, a));
    let _template_ = (__pragma!has_tag (generic, a), __pragma!has_tag (generic!{i32}, a), __pragma!has_tag (generic, b));
    let _described_ = (describe!{&Baz} (), describe!{Rec} (), describe!{Value} ());

    let _x_ = foo (1) + bar () + generic (3);
    let _b_ = copy Baz ();
}
