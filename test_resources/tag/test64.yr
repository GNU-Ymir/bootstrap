/**
 * A site written outside the tags merging an instance into a function receives
 * that instance under the identity of the function, the name its frame takes.
 * */

in test64;

lazy mut SUM: i32 = 0;

tag offset (by: i32) {
    pub fn apply {F: fn (i32)-> i32} (x: i32, y: i32)-> i32 {
        F (x) + y + by
    }
}

tag registered {
    pub self {F: fn (i32, i32)-> i32} () {
        SUM += F (1, 2);
    }
}

#[registered, offset (10)]
fn foo (x: i32)-> i32 { x * 2 }

fn main () {
    let _x_ = foo (1, 2) + SUM;
}
