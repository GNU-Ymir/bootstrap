/**
 * Stacked tags are merged into a class from the innermost to the outermost,
 * each seeing the members the previous ones declared, the written ones
 * included. The members an `apply` overload declares see the scope of their
 * tag besides the one of the class: the globals of the tag.
 * */

in test42;

tag inner {
    pub class apply {class C} {
        pub fn base (self)-> i32 {
            self.x
        }
    }
}

tag outer {
    lazy mut CALLS: i32 = 0;

    pub class apply {class C} {
        cte if (__pragma!compile ({ let c = C (); c.base () })) {
            pub fn twice (self)-> i32 {
                CALLS += 1;
                self.base () * 2
            }
        }
    }
}

#[outer, inner]
class Foo {
    pub let x: i32 = 3;

    pub self () {}
}

fn main () {
    let _x_ = (copy Foo ()).twice ();
}
