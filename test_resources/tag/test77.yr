// An `async apply` follows the rules of an async, and cannot take a ref parameter

in test77;

tag t {
    pub async apply {F: fn (ref i32)-> i32} (ref n: i32)-> i32 {
        F (ref n)
    }
}

#[t]
fn sq (ref n: i32)-> i32 { n * n }

fn main () {
    let mut x = 4;
    let _r_ = sq (ref x).run ();
}
