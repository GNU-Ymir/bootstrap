/**
 * A tagged generator reaches an `apply` overload typed with its handle, here
 * re-yielded by a `yield apply`.
 * */

in test69;

tag doubled {
    pub yield apply {F: fn (i32)-> yield-> R, R} (n: i32)-> R {
        for i in F (n) { yield i * 2; }
    }
}

#[doubled]
yield count (n: i32)-> i32 {
    for i in 0 .. n { yield i; }
}

fn main () {
    let _lst_ = copy [i for i in count (3)];
}
