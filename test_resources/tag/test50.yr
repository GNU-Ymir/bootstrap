/**
 * Stacked tags are merged into an enum from the innermost: each one sees the
 * values the previous ones appended, and appends its own after them.
 * */

in test50;

tag a {
    pub enum apply {enum E}
    | A_SEEN = E::__members__.len;
}

tag b {
    pub enum apply {enum E}
    | B_SEEN = E::__members__.len;
}

#[a, b]
enum Sizes : usize
| SMALL = 1us
| LARGE = 8us;

fn main () {
    let _a_: usize = Sizes::A_SEEN;
    let _b_: usize = Sizes::B_SEEN;
    let _members_ = Sizes::__names__;
}
