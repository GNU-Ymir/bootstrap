/**
 * The tag sites construct their tags at program start: the package
 * constructor of the module calls, for each site in the order the sites are
 * written, the instance of the `self` overload it selected. The overload
 * receives the tagged symbol as written, the function before its merge and
 * the class merged, its parameters and those of the tag bound to the site.
 * A tag declaring no `self` overload constructs nothing.
 * */

in test60;

lazy mut SUM: i32 = 0;

lazy mut N: i32 = 0;

tag route (path: [c8]) {
    pub fn apply {F: fn ()-> i32} (x: i32)-> i32 {
        F () + x
    }

    pub class apply {class C} {
        pub fn id (self)-> i32 {
            cast!i32 (path.len)
        }
    }

    pub self {F: fn ()-> i32} () {
        SUM += F ();
    }

    pub self {class C} () {
        SUM += (copy C ()).id ();
    }
}

tag count {
    pub self () {
        N += 1;
    }
}

tag plain {}

fn main () {
    let _x_ = bar (1) + SUM + N;
}

#[route ("/foo"), count]
fn foo ()-> i32 { 12 }

#[count, plain]
#[route ("/bar")]
class Bar {
    pub self () {}
}

#[route ("/bar")]
fn bar ()-> i32 { 3 }
