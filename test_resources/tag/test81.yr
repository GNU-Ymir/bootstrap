/**
 * The compile-time values of the arguments of a tag site, given or defaulted,
 * are those of the parameters of the instances it constructs: an option set
 * or unset, a null pointer, a range and an enum field.
 * */

in test81;

enum Color
| RED = 1
| GREEN = 2;

lazy mut SUM: i32 = 0;

tag t (o: (i32)? = none, p: *i32 = null, r: ..i32 = 0 .. 3, c: Color = Color::RED) {
    pub self {class C} () {
        let _p_: *i32 = p;
        SUM += (o ?? 0) + c;
        for i in r {
            SUM += i;
        }
    }
}

#[t]
class A {
    pub self () {}
}

#[t (o-> (3)?, r-> 1 ... 4, c-> Color::GREEN)]
class B {
    pub self () {}
}

fn main () {
    let _x_ = SUM;
}
