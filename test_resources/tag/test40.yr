/**
 * An `apply` overload declares into the class it is merged into a ctor, the
 * implementation of a trait, and the implementation of an abstract method of
 * its ancestor.
 * */

in test40;

trait Named {
    pub fn name (self)-> [c8];
}

@abstract
class Shape {
    pub self () {}

    pub fn area (self)-> i32;
}

tag square (side: i32) {
    pub class apply {class C} {
        pub self (scale: i32)
            with super (), scale = scale
        {}

        pub over area (self)-> i32 {
            side * side * self.scale
        }

        impl Named {
            pub over name (self)-> [c8] {
                "square"
            }
        }
    }
}

#[square (3)]
class Square over Shape {
    let scale: i32 = 1;

    pub self ()
        with super ()
    {}
}

fn main () {
    let s: &Shape = copy Square (2);
    let _a_ = s.area ();
    let _n_ = (copy Square ()).name ();
}
