// a method every written member of a union declares is no longer callable on
// it when a tag appends a member declaring none

record Circle {
    pub self () {}

    pub fn area (self)-> i32 { 3 }
}

record Square {
    pub self () {}

    pub fn area (self)-> i32 { 4 }
}

record Empty {
    pub self () {}
}

tag emptied {
    pub union apply {union U}
    | Empty;
}

#[emptied]
union Shape
| Circle
| Square;

fn main () {
    let s: Shape = Circle ();
    let _x_ = s.area ();
}
