/**
 * `__pragma!method_has_tag`, `__pragma!method_tag` and `__pragma!method_tags`
 * read the tags of the methods of a class, a record and an entity, wherever
 * the method is declared: in a protection block, in a conditional block, as a
 * template, as an overload whose sites follow the ones of the methods of the
 * same name written before it, in each specialization of a template class, its
 * arguments rewritten, and on a method declared by the `apply` overload of a
 * tag, the arguments of its site bound in them.
 * */

in test110;

tag slot (signal: [c8], times: i32 = 1) {}

tag skip {}

tag size (bytes: usize) {}

tag generated (label: [c8]) {
    pub class apply {class C} {
        #[slot (label)]
        pub fn gen (self) {}
    }
}

#[generated ("gen")]
class Door {
    let mut opened: bool = false;

    pub self () {}

    #[slot ("open")]
    pub fn open (mut self) { self.opened = true; }

    #[slot ("open-at", times-> 2)]
    pub fn open (mut self, _: i32) { self.opened = true; }

    pub fn close (mut self) { self.opened = false; }

    pub {
        #[skip, slot ("toggle")]
        fn toggle (mut self) { self.opened = !self.opened; }
    }

    cte if (i32::size == 4us) {
        #[slot ("four")]
        prv fn four (self) {}
    }

    #[slot ("set")]
    pub fn set {T} (mut self, _: T) {}

    #[skip]
    pub yield values (self)-> i32 { yield 1; }
}

class SubDoor over Door {
    pub self () with super () {}

    #[slot ("sub-open")]
    pub over open (mut self) {}
}

record Box {T} {
    #[size (T::size)]
    pub fn get (self) {}
}

entity Switch {
    #[slot ("pressed")]
    pub fn press (self) {}
}

fn main () {
    let mut opens = "";
    cte for s in __pragma!method_tags (Door, "open", slot) {
        opens = opens ~ "/" ~ s.signal;
    }

    let _opens_ = (opens, __pragma!method_tags (Door, "open", slot).len, __pragma!method_tags (Door, "open", slot)[1].times);
    let _has_ = (__pragma!method_has_tag (Door, "open", slot), __pragma!method_has_tag (Door, "close", slot), __pragma!method_has_tag (Door, "toggle", skip));
    let _members_ = (__pragma!method_tag (Door, "toggle", slot).signal, __pragma!method_tag (Door, "four", slot).signal, __pragma!method_tag (Door, "set", slot).signal);
    let _generated_ = (__pragma!method_tag (Door, "gen", slot).signal, __pragma!method_has_tag (Door, "values", skip));
    let _sub_ = (__pragma!method_tag (SubDoor, "open", slot).signal, __pragma!method_tags (SubDoor, "open", slot).len);
    let _box_ = (__pragma!method_tag (Box!{i32}, "get", size).bytes, __pragma!method_tag (Box!{i64}, "get", size).bytes);
    let _switch_ = __pragma!method_tag (Switch, "press", slot).signal;
    let _empty_ = __pragma!method_tags (Door, "close", slot);
}
