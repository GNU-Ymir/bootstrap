/**
 * A class tag lists the methods of its class with `__pragma!method_infos`,
 * reads the tag of each of them, and calls the one whose slot is named by a
 * run-time string with `__pragma!method` on an aliased object, the private
 * methods included, as the members the tag declares into the class reach them.
 * */

in test111;

tag slot (signal: [c8]) {}

tag actor {
    pub class apply {class C} {
        pub fn slots (self)-> [c8] {
            let mut res = "";
            cte for i in 0us .. __pragma!method_infos (C).len {
                cte if (__pragma!method_has_tag (C, __pragma!method_infos (C)[i].name, slot)) {
                    res = res ~ "/" ~ __pragma!method_tag (C, __pragma!method_infos (C)[i].name, slot).signal;
                }
            }

            res
        }

        pub fn receive (mut self, signal: [c8])-> bool {
            cte for i in 0us .. __pragma!method_infos (C).len {
                cte if (__pragma!method_has_tag (C, __pragma!method_infos (C)[i].name, slot)) {
                    if (signal == __pragma!method_tag (C, __pragma!method_infos (C)[i].name, slot).signal) {
                        __pragma!method (alias self, __pragma!method_infos (C)[i].name) ();
                        return true;
                    }
                }
            }

            false
        }
    }
}

#[actor]
class Door {
    let mut _opened: bool = false;

    pub self () {}

    #[slot ("open")]
    pub fn open (mut self) { self._opened = true; }

    #[slot ("close")]
    prv fn close (mut self) { self._opened = false; }

    pub fn isOpened (self)-> bool { self._opened }
}

fn main () {
    let dmut door = copy Door ();
    let _slots_ = door.slots ();
    let _received_ = (door:.receive ("open"), door.isOpened (), door:.receive ("close"), door:.receive ("ring"));
}
