/**
 * An `async apply` stacked on a `yield apply`: the inner tag turns the function
 * into a generator, that the outer one consumes in an async.
 * */

in test74;

tag upTo {
    pub yield apply {F: fn (i32)-> i32} (n: i32)-> i32 {
        for i in 0 .. n { yield F (i); }
    }
}

tag summed {
    pub async apply {F: fn (i32)-> yield-> i32} (n: i32)-> i32 {
        let mut s = 0;
        for i in F (n) {
            s += i;
            await;
        }
        s
    }
}

#[summed, upTo]
fn sq (n: i32)-> i32 { n * n }

fn main () {
    let _r_ = sq (4).run ();
}
