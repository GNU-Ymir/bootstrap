// a match covering the written members of a union is not complete once a tag
// appends one

record Circle {
    pub self () {}
}

record Square {
    pub self () {}
}

record Empty {
    pub self () {}
}

tag emptied {
    pub union apply {union U}
    | Empty;
}

#[emptied]
union Shape
| Circle
| Square;

fn sides (s: Shape)-> i32 {
    match s {
        _: Circle => { 0 }
        _: Square => { 4 }
    }
}

fn main () {
    let _x_ = sides (Circle ());
}
