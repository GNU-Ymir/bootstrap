/**
 * The instance of the `apply` overload a tag site selects replaces the tagged
 * function: the name means the instance, whose prototype is the one of the
 * overload, under the name of the function. The function as written moves to
 * a hidden name, only reached through the first template parameter of the
 * overload.
 * */

in test32;

tag offset (by: i32) {
    pub fn apply {F: fn (i32)-> i32} (x: i32, y: i32)-> i32 {
        F (x) + y + by
    }
}

#[offset (10)]
fn foo (x: i32)-> i32 { x * 2 }

fn main () {
    let _x_ = foo (1, 2);
}
