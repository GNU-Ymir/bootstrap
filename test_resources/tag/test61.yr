/**
 * The sites binding the same parameters share the instance of their `self`
 * overload, called once per site. The sites of a module declared in the file
 * are constructed along with those of the file, those of a module written in a
 * file of its own by the package constructor of that file, and the sites of a
 * template once per specialization.
 * */

in test61;

mod .registry;

lazy mut N: i32 = 0;

tag count {
    pub self () {
        N += 1;
    }
}

#[count]
fn a () {}

#[count]
fn b () {}

mod inner {
    #[count]
    pub fn c () {}
}

#[count]
fn identity {T} (x: T)-> T { x }

fn main () {
    a ();
    b ();
    inner::c ();
    let _x_ = identity (1) + cast!i32 (identity (2us)) + N + registry::d ();
}
