// An `async apply` follows the rules of an async, and cannot throw

in test76;

tag t {
    pub async apply {F: fn (i32)-> i32} (n: i32)-> i32
        throws AssertError
    {
        assert (n > 0);
        F (n)
    }
}

#[t]
fn sq (n: i32)-> i32 { n * n }

fn main () {
    let _r_ = sq (4).run ();
}
