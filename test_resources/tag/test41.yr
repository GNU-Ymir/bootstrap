/**
 * A final class and a record merge the members of their tags the same way,
 * the record keeping its fields on the stack.
 * */

in test41;

tag described (what: [c8]) {
    pub class apply {class C} {
        pub fn describe (self)-> [c8] {
            what
        }
    }

    pub record apply {record R} {
        pub let tag: [c8] = what;

        pub fn describe (self)-> [c8] {
            self.tag
        }
    }
}

#[described ("final")]
@final
class Foo {
    pub self () {}
}

#[described ("record")]
record Bar {
    pub let x: i32;

    pub self (x: i32)
        with x = x
    {}
}

fn main () {
    let _f_ = (copy Foo ()).describe ();
    let b = Bar (1);
    let _b_ = b.describe ();
    let _x_ = b.x;
}
