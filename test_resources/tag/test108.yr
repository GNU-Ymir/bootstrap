// The `self` overload of a tag sees the class it constructs for as its `apply` overload does: every field, the private and protected ones included, with their tags, their types and their offsets

in test108;

tag export {}

lazy mut NAMES: [[c8]] = [];

tag t {
    pub self {class C} () {
        cte for i in 0us .. C::field_infos.len {
            cte if (__pragma!field_has_tag (C, C::field_infos [i].name, export)) {
                NAMES ~= [C::field_infos [i].name];
            }
        }

        let _x_: __pragma!field_type (C, "_x") = 0;
        let _offsets_ = (C::field_infos [0us].offset, C::field_infos [1us].offset);
    }
}

#[t]
class Foo {
    #[export]
    let mut _x: i32 = 0;

    #[export]
    prot let _z: i32 = 0;

    pub let w: i32 = 0;

    #[export]
    pub let y: i32 = 0;

    pub self () {}
}

fn main () {}
