/**
 * The instance of the `apply` overload a tag site selects for an enum appends
 * its values to the enum, after the written ones, whose order is unchanged.
 * Inside the overload, the enum is seen as written: its members are the
 * written values only. The appended values are of the type of the enum, reach
 * each other by their names, and reach the parameters of the tag.
 * */

in test49;

tag counted (step: i32) {
    pub enum apply {enum E}
    | COUNT = cast!{i32} (E::__members__.len)
    | NEXT = COUNT + step;
}

#[counted (10)]
enum Color
| RED = 0
| GREEN = 1;

fn main () {
    let _count_: i32 = Color::COUNT;
    let _next_: i32 = Color::NEXT;
    let _len_ = Color::__members__.len;
    let _names_ = Color::__names__;
}
