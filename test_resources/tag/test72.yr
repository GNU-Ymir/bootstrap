/**
 * An `async apply` merges a tagged async into an async, which awaits the
 * function as written. The merged function is run as any async, and
 * `__pragma!untagged` reaches the async as written.
 * */

in test72;

tag plusOne {
    pub async apply {F: fn (i32)-> async-> i32} (n: i32)-> i32 {
        (await F (n)) + 1
    }
}

#[plusOne]
async twice (n: i32)-> i32 { n * 2 }

fn main () {
    let _r_ = twice (3).run ();
    let _u_ = __pragma!untagged (twice) (3).run ();
}
