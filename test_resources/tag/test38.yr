/**
 * The prototype of a tagged function is validated before its tags are merged
 * into it, so it cannot use the function, whose name means the merge.
 * */

in test38;

tag doubled {
    pub fn apply {F: fn (i32)-> i32} (x: i32)-> i32 {
        F (x) * 2
    }
}

#[doubled]
fn foo (x: i32)-> typeof (foo (x)) { x }

fn main () {
    let _x_ = foo (1);
}
