/**
 * `__pragma!field_has_tag` tells at compile time whether a tag is written on
 * top of a field of a class or a record, the tag resolved by the usual lookup
 * and compared with the one each site names from the scope of the type.
 * */

in test95;

tag rename (name: [c8]) {}

tag skip {}

mod web {
    pub tag route (path: [c8]) {}
}

record Foo {
    #[rename ("a-field")]
    pub let a_field: i32 = 0;

    #[skip, web::route ("/b")]
    pub let b_field: i32 = 0;

    pub let c_field: i32 = 0;
}

class Bar {
    #[rename ("x")]
    prv let x: i32;

    pub self () with x = 1 {}
}

fn main () {
    let _a_ = (__pragma!field_has_tag (Foo, "a_field", rename), __pragma!field_has_tag (Foo, "a_field", skip));
    let _b_ = (__pragma!field_has_tag (Foo, "b_field", skip), __pragma!field_has_tag (Foo, "b_field", web::route), __pragma!field_has_tag (Foo, "b_field", rename));
    let _c_ = __pragma!field_has_tag (Foo, "c_field", rename);
    let _bar_ = (__pragma!field_has_tag (Bar, "x", rename), __pragma!field_has_tag (&Bar, "x", rename));
}
