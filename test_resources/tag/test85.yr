/**
 * The template parameters of a tag can be given explicitly at a site, the
 * others being inferred from its arguments.
 * */

in test85;

tag pair {T, N: usize} (values: [T ; N], scale: T) {
    pub fn apply {F: fn ()-> T} ()-> T {
        let mut s = F ();
        for v in values {
            s += v * scale;
        }

        s
    }
}

#[pair!{i64} ([1, 2], 3)]
fn foo ()-> i64 { 0 }

#[pair!{i32, 3us} ([1, 2, 3], 1)]
fn bar ()-> i32 { 0 }

fn main () {
    let _x_ = foo () + cast!i64 (bar ());
}
