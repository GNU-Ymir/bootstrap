/**
 * A tag declaring a `yield apply` and a `fn apply` tells them apart by the
 * pattern of the function they receive, a generator selecting the overload
 * typed fn (i32)-> yield-> R.
 * */

in test75;

tag t {
    pub yield apply {F: fn (i32)-> yield-> R, R} (n: i32)-> R {
        for i in F (n) { yield i + 1; }
    }

    pub fn apply {F: fn (i32)-> i32} (n: i32)-> i32 {
        F (n) + 1
    }
}

#[t]
yield count (n: i32)-> i32 {
    for i in 0 .. n { yield i; }
}

#[t]
fn sq (n: i32)-> i32 { n * n }

fn main () {
    let _lst_ = copy [i for i in count (3)];
    let _x_ = sq (3);
}
