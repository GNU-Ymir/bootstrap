// The candidates of a failed selection name the yield and async overloads as such

in test79;

tag t {
    pub yield apply {F: fn (i32)-> yield-> i32} (n: i32)-> i32 {
        for i in F (n) { yield i; }
    }

    pub async apply {F: fn (i32)-> async-> i32} (n: i32)-> i32 {
        await F (n)
    }

    pub fn apply {F: fn (i32)-> i32} (n: i32)-> i32 {
        F (n)
    }
}

#[t]
fn foo (x: f32)-> f32 { x }

fn main () {
    let _x_ = foo (1.0f);
}
