/**
 * `__pragma!untagged` reaches a tagged function as written, before any of its
 * tags were merged into it, whatever their number.
 * */

in test35;

tag doubled {
    pub fn apply {F: fn (i32)-> i32} (x: i32)-> i32 {
        F (x) * 2
    }
}

#[doubled]
fn foo (x: i32)-> i32 { x + 1 }

#[doubled, doubled]
fn bar (x: i32)-> i32 { x + 2 }

fn main () {
    let _x_ = foo (1) + __pragma!untagged (foo) (1);
    let _y_ = bar (1) + __pragma!untagged (bar) (1);
}
