/**
 * The template parameters of a tag are inferred from the arguments of each
 * site, as for a call, and bound next to its parameters: every `apply` and
 * `self` overload sees them. Two sites of different lengths construct
 * distinct instances, and both carry the tag.
 * */

in test83;

lazy mut LEN: usize = 0us;

tag ren {N: usize} (names: [[c8] ; N]) {
    pub class apply {class C} {
        pub fn count (self)-> usize {
            N
        }

        pub fn last (self)-> [c8] {
            names[N - 1us]
        }
    }

    pub self {class C} () {
        for i in 0us .. N {
            LEN += names[i].len;
        }
    }
}

#[ren (["_a=a", "_b=b"])]
class A {
    pub self () {}
}

#[ren (["_x=x", "_y=y", "_z=z"])]
class B {
    pub self () {}
}

fn main () {
    cte assert (__pragma!has_tag (A, ren) && __pragma!has_tag (B, ren));

    let a = copy A ();
    let b = copy B ();
    let _x_ = a.count () + b.count () + LEN;
    let _y_ = a.last () ~ b.last ();
}
