/**
 * The name of a tagged function means the instance merged into it, even
 * inside its own body: a recursive call goes through the `apply` overload.
 * */

in test33;

tag counted {
    lazy mut CALLS: i32 = 0;

    pub fn apply {F: fn (i32)-> i64} (n: i32)-> i64 {
        CALLS += 1;
        F (n)
    }
}

#[counted]
fn fib (n: i32)-> i64 {
    if (n < 2) {
        cast!i64 (n)
    } else {
        fib (n - 1) + fib (n - 2)
    }
}

fn main () {
    let _x_ = fib (10);
}
