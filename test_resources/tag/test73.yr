/**
 * An `async apply` turns a plain function into an async, whose body can await
 * before calling it.
 * */

in test73;

tag deferred {
    pub async apply {F: fn (i32)-> i32} (n: i32)-> i32 {
        await;
        F (n)
    }
}

#[deferred]
fn sq (n: i32)-> i32 { n * n }

async user (n: i32)-> i32 {
    (await sq (n)) + 1
}

fn main () {
    let _r_ = sq (4).run ();
    let _u_ = user (2).run ();
}
