/**
 * A tag can be put on a function, a class, a record, an enum, a union, and on
 * a template of one of them, its path being resolved from the scope of the
 * tagged declaration. The tags are only kept on the tagged symbols, they do
 * not change them yet.
 * */

in test2;

tag a {}

tag b (x: i32) {}

mod web {
    pub tag route (path: [c8]) {}
}

#[a]
fn foo ()-> i32 { 1 }

#[a, b (12)]
#[web::route ("/bar")]
class Bar {
    pub self () {}
}

#[a]
record Baz {}

record Qux {}

#[a]
enum Color
| RED = 0
| GREEN = 1;

#[a]
union Value
| Baz
| Qux;

#[web::route (path-> "/generic")]
fn generic {T} (x: T)-> T { x }

pub {
    #[a]
    fn inBlock ()-> i32 { 2 }
}

mod local {
    #[a]
    pub fn inModule ()-> i32 { 3 }
}

fn main () {
    let _x_ = foo () + generic (2) + inBlock () + local::inModule ();
    let _b_ = copy Bar ();
}
