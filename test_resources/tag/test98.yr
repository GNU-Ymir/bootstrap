/**
 * A serialization through tags: the `apply` overload of a tag on a record
 * iterates its fields with `__pragma!field_infos`, and reads the tags written
 * on each of them; another tag of the record reads the arguments of the first
 * one with `__pragma!tag`. The tags of the fields only register them.
 * */

in test98;

tag rename (name: [c8]) {}

tag skip {}

tag Serializable (version: i32 = 1) {
    pub record apply {record R} {
        pub fn keys (self)-> [c8] {
            let mut res = "";
            cte for i in 0us .. R::field_infos.len {
                cte if (!__pragma!field_has_tag (R, R::field_infos [i].name, skip)) {
                    res = res ~ "/" ~ keyOf!{R, R::field_infos [i].name} ();
                }
            }

            res
        }
    }
}

tag Deserializable {
    pub record apply {record R} {
        pub fn version (self)-> i32 {
            __pragma!tag (R, Serializable).version
        }
    }
}

fn keyOf {R, F: [c8]} ()-> [c8] {
    cte if (__pragma!field_has_tag (R, F, rename)) {
        __pragma!field_tag (R, F, rename).name
    } else {
        F
    }
}

#[Serializable (version-> 3), Deserializable]
record Foo {
    #[rename ("a-field")]
    pub let mut a_field: i32 = 1;

    #[skip]
    pub let mut cache: i32 = 2;

    pub let mut anotherField: u32 = 3u32;

    pub self () {}
}

fn main () {
    let foo = Foo ();
    let _keys_ = foo.keys ();
    let _version_ = foo.version ();
}
