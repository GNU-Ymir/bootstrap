/**
 * A type template parameter of a tag is inferred from the argument of a site,
 * and an `apply` overload can match the tagged symbol against it.
 * */

in test84;

tag offset {T} (by: T) {
    pub fn apply {F: fn (T)-> T} (x: T)-> T {
        F (x) + by
    }
}

#[offset (1)]
fn foo (x: i32)-> i32 { x }

#[offset (0.5f)]
fn bar (x: f32)-> f32 { x }

fn main () {
    let _x_ = foo (1);
    let _y_ = bar (1.0f);
}
