/**
 * The instance of a `self` overload is validated for the site it constructs,
 * an error in it being noted with that site.
 * */

in test63;

lazy mut NAMES: [[c8]] = [];

tag a (name: [c8]) {
    pub self {F: fn ()-> T, T} () {
        let x: [c8] = F ();
        NAMES = NAMES ~ [name, x];
    }
}

#[a ("foo")]
fn foo ()-> [c8] { "foo" }

#[a ("bar")]
fn bar ()-> i32 { 1 }

fn main () {
    let _x_ = foo () ~ NAMES[0];
    let _y_ = bar ();
}
