/**
 * The tags of a template class are merged into each of its specializations.
 * A template method an `apply` overload declares sees the scope of its tag in
 * each of its own specializations.
 * */

in test48;

tag boxed (factor: i32) {
    lazy mut UNBOXED: i32 = 0;

    pub class apply {class C} {
        pub fn scaled {U} (self, by: U)-> U {
            UNBOXED += 1;
            by * cast!U (factor)
        }
    }
}

#[boxed (T::size)]
class Box {T} {
    pub let value: T;

    pub self (value: T)
        with value = value
    {}
}

fn main () {
    let _x_ = (copy Box!{i32} (1)).scaled (2) + (copy Box!{u8} (1u8)).scaled (3);
    let _y_ = (copy Box!{i32} (1)).scaled (2u64);
}
