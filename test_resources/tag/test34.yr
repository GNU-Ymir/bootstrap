/**
 * Stacked tags are merged from the innermost to the outermost, `#[a, b] fn foo`
 * being `a(b(foo))`: each site selects its `apply` overload for the function
 * the previous merge produced, and the name means the outermost instance, even
 * inside the body of the function.
 * */

in test34;

tag inner {
    pub fn apply {F: fn (i32)-> i32} (x: i32, y: i32)-> i32 {
        F (x) + y
    }
}

tag outer {
    pub fn apply {F: fn (i32, i32)-> i32} (x: i32)-> i32 {
        F (x, x) * 2
    }
}

#[outer, inner]
fn foo (x: i32)-> i32 {
    if (x > 0) {
        return foo (x - 1);
    }

    x
}

fn main () {
    let _x_ = foo (3);
}
