// The arguments of a tag on a field bind the parameters of the tag, as compile-time values

in test101;

tag rename (name: [c8], n: i32 = 1) {}

lazy NAME: [c8] = "c";

record Foo {
    #[rename (1)]
    pub let a: i32 = 0;

    #[rename ()]
    pub let b: i32 = 0;

    #[rename (NAME)]
    pub let c: i32 = 0;

    #[rename ("d", m-> 2)]
    pub let d: i32 = 0;

    pub self () {}
}

fn main () {
    let _f_ = Foo ();
}
