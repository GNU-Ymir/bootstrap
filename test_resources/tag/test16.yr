/**
 * A template module holding a tag and a tagged function: its specialization
 * rewrites both, the tag site naming the tag of the specialization.
 * */

in test16;

mod Wrapped {T} {
    pub tag a (x: T) {
        lazy mut COUNT: T = T::init;

        pub fn apply {F: fn ()-> T} ()-> T { F () }

        pub self {F: fn ()-> T} () {}
    }

    #[a (T::init)]
    pub fn foo ()-> T { T::init }
}

fn main () {
    let _x_ = Wrapped!{i32}::foo ();
}
