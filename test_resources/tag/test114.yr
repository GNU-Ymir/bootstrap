// The method tag pragmas read the methods of a class named by a string, a single site being read where there is exactly one

in test114;

tag slot (signal: [c8]) {}

class Foo {
    pub let x: i32 = 0;

    pub self () {}

    #[slot ("a")]
    pub fn twice (self) {}

    #[slot ("b")]
    pub fn twice (self, _: i32) {}

    pub fn never (self) {}
}

fn a () { let _x_ = __pragma!method_tag (Foo, "twice", slot); }

fn b () { let _x_ = __pragma!method_tag (Foo, "never", slot); }

fn c () { let _x_ = __pragma!method_has_tag (Foo, "x", slot); }

fn d () { let _x_ = __pragma!method_tags (i32, "x", slot); }

fn e () { let _x_ = __pragma!method_tag (Foo, "never"); }

fn f () { let _x_ = __pragma!method_has_tag (Foo, "never", Foo); }

fn g () { let _x_ = __pragma!method_infos ([i32]); }

fn h () { let _x_ = __pragma!method_infos (Foo, Foo); }

fn main () {
    a ();
    b ();
    c ();
    d ();
    e ();
    f ();
    g ();
    h ();
}
