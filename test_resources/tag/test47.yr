// a field declared by an apply overload clashes with a method written in the class

tag counted {
    pub class apply {class C} {
        pub let count: i32 = 0;
    }
}

#[counted]
class Foo {
    pub self () {}

    pub fn count (self)-> i32 {
        2
    }
}

fn main () {
    let _f_ = copy Foo ();
}
