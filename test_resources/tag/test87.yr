// A template parameter of a tag that is not inferred, and an argument the inference fails on

in test87;

tag t {N: usize, T} (names: [[c8] ; N]) {
    pub self {class C} () {}
}

tag u {N: usize} (names: [[c8] ; N]) {
    pub self {class C} () {}
}

#[t (["a"])]
class A {
    pub self () {}
}

#[u (1)]
class B {
    pub self () {}
}

fn main () {}
