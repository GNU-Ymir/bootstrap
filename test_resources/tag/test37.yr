/**
 * The tags of a template function are merged into each of its specializations,
 * the instance taking the name of the specialization: a call is checked
 * against the prototype of the instance, not the one of the function as written.
 * */

in test37;

tag sized (size: usize) {
    pub fn apply {F: fn (T)-> T, T} (x: T, y: T)-> T {
        F (x) + y + cast!T (size)
    }
}

#[sized (T::size)]
fn grow {T} (x: T)-> T { x * cast!T (2) }

fn main () {
    let _x_ = grow (2, 1) + cast!i32 (grow (3u8, 1u8));
}
