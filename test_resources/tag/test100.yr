// The path of a tag on a field names a tag, resolved from the scope of the type

in test100;

tag rename (name: [c8]) {}

fn notATag () {}

record Foo {
    #[unknown]
    pub let a: i32 = 0;

    #[notATag, rename ("b")]
    pub let b: i32 = 0;

    pub self () {}
}

fn main () {
    let _f_ = Foo ();
}
