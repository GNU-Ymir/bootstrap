/**
 * The tags of a field are kept wherever the field is declared: in a protection
 * block, in a conditional block, in each specialization of a template, its
 * arguments rewritten, and on a field declared by the `apply` overload of a
 * tag, the arguments of its site bound in them.
 * */

in test99;

tag size (bytes: usize) {}

tag rename (name: [c8]) {}

tag generated (label: [c8]) {
    pub record apply {record R} {
        #[rename (label)]
        pub let gen: i32 = 0;
    }
}

record Box {T} {
    #[size (T::size)]
    pub let value: T;

    pub self (value: T) with value = value {}
}

#[generated ("gen")]
record Holder {
    pub {
        #[rename ("first")]
        let a: i32 = 0;

        let b: i32 = 0;
    }

    cte if (i32::size == 4us) {
        #[rename ("four")]
        prv let c: i32 = 0;
    }

    pub self () {}
}

class Base {
    #[rename ("p")] prot let p: i32 = 0;

    pub self () {}
}

fn main () {
    let _box_ = (__pragma!field_tag (Box!{i32}, "value", size).bytes, __pragma!field_tag (Box!{i64}, "value", size).bytes);
    let _holder_ = (__pragma!field_tag (Holder, "a", rename).name, __pragma!field_has_tag (Holder, "b", rename), __pragma!field_tag (Holder, "c", rename).name);
    let _gen_ = __pragma!field_tag (Holder, "gen", rename).name;
    let _base_ = __pragma!field_tag (Base, "p", rename).name;
}
