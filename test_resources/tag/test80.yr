/**
 * A static array is a compile-time value like any other parameter of a tag:
 * two sites binding different arrays construct distinct instances of the
 * `self` overload and of the `apply` overload.
 * */

in test80;

lazy mut LEN: usize = 0us;

tag ren (names: [[c8] ; 2]) {
    pub class apply {class C} {
        pub fn renamed (self)-> [c8] {
            names[0] ~ "," ~ names[1]
        }
    }

    pub self {class C} () {
        LEN += names[0].len + names[1].len;
    }
}

#[ren (["_a=a", "_b=b"])]
class A {
    pub self () {}
}

#[ren (["_x=x", "_y=y"])]
class B {
    pub self () {}
}

fn main () {
    let _a_ = (copy A ()).renamed ();
    let _b_ = (copy B ()).renamed ();
    let _l_ = LEN;
}
