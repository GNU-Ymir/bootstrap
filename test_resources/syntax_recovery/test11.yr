/*
 * A malformed tag list is reported, the declaration it is written before being
 * read as if it were not there: the error of that declaration is reported as
 * well, and so is the one of the next malformed list.
 */

in test11;

#[a b]
fn first () {
    let x = ;
}

#[a (]
fn second () {}

#[
    a,
    "b"
]
fn third () {}

#[]
fn fourth () {}

#[a,]
fn fifth () {}

#[a::]
fn sixth () {}
