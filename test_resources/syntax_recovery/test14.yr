/*
 * In a type, only a field or a method carries tags, written before its
 * protection and its attributes, never before a protection block, a ctor, a
 * dtor nor at the end of a block.
 */

in test14;

record ProtectionBlock {
    #[skip]
    pub {
        let a: i32;
    }
}

record AfterProtection {
    pub #[skip] let b: i32;
}

record Dangling {
    let c: i32;

    #[skip]
}

class Ctor {
    #[skip]
    self () {}
}

class Dtor {
    #[skip]
    __dtor (mut self) {}
}

record Valid {
    #[skip]
    let d: i32;

    #[skip]
    pub fn foo (self) {}
}
