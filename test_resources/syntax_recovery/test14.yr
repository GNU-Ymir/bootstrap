/*
 * In a type, only a field carries tags, written before its protection and its
 * attributes, never before a protection block nor at the end of a block.
 */

in test14;

record Method {
    #[skip]
    pub fn foo (self) {}
}

record ProtectionBlock {
    #[skip]
    pub {
        let a: i32;
    }
}

record AfterProtection {
    pub #[skip] let b: i32;
}

record InProtectionBlock {
    pub {
        #[skip]
        fn foo (self) {}
    }
}

record Dangling {
    let c: i32;

    #[skip]
}

class Ctor {
    #[skip]
    self () {}
}

record Valid {
    #[skip]
    let d: i32;
}
