// a test run once per parameter set, yielded by a generator
yield lengths ()-> (i32, [c8]) {
    yield (3, "foo");
    for i in 0 .. 4 {
        yield (i, "abcd" [0 .. cast!usize (i)]);
    }
}

@parameters (lengths ())
__test named (len: i32, text: [c8]) {
    assert (text.len == cast!usize (len));
}
