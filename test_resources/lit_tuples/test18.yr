record S {
    pub let mut x: i32;
    pub let mut y: i32;

    pub self (x: i32, y: i32)
        with x = x, y = y
    {}
}

fn foo ()-> (i32, i32) {
    (1, 2)
}

fn main () {
    let dmut s = S (0, 0);
    let dmut t = copy [0, 0];
    let mut c = 0;

    (s.x, t[0]) = foo ();
    ((s.y, t[1]), c) = (foo (), 3);

    s; t; c;
}
