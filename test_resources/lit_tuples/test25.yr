fn main () {
    let dmut a = copy [1];
    let dmut b = copy [2];

    // an element of a literal carries its own aliaser, no outer alias is needed
    (a, b) = (copy [3], copy [4]);

    let dmut x = copy [5];
    let dmut y = copy [6];
    (a, b) = (alias x, alias y);

    // an alias on the whole right operand distributes over the elements
    (a, b) = alias (copy [7], copy [8]);

    let dmut t = (copy [9], copy [10]);
    (a, b) = alias t;

    a; b; x; y; t;
}
