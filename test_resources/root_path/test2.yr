mod A {
    pub record R {
        pub let x : i32;
        pub self (x : i32) with x = x {}
    }
}

mod B {
    mod A {
        pub record R {
            pub let y : f64;
            pub self (y : f64) with y = y {}
        }
    }

    pub fn foo ()-> ::test2::A::R {
        ::test2::A::R (12)
    }
}

fn main () {
    let r = B::foo ();
    r.x;
}
