mod A {
    pub class Base {
        pub self () {}
    }
}

mod B {
    mod A {
        pub class Base {
            pub self () {}
        }
    }

    pub class Derived over ::test9::A::Base {
        pub self () {}
    }
}

fn main () {
    let d : &::test9::A::Base = copy B::Derived ();
    d;
}
