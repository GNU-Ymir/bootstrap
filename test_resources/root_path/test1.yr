mod A {
    pub fn foo ()-> i32 { 12 }
}

mod B {
    mod A {
        pub fn foo ()-> f64 { 12.0 }
    }

    // 'A::foo' would be ambiguous here, 'test1::A' and 'test1::B::A' are both visible (cf. test7.yr)
    pub fn bar ()-> i32 {
        ::test1::A::foo ()
    }
}

fn main () {
    let a = B::bar ();
    a;
}
