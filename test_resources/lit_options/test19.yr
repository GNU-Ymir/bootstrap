// the '??' operator unwraps an option, or evaluates its right operand when it is empty
fn foo (x : bool)-> i32? {
    if (x) { 12? } else { none }
}

fn main () {
    let _a_ : i32 = foo (false) ?? 42;
    let _b_ : i32 = foo (true) ?? 42;

    // the left operand is known at cte, only one of the two branches is kept
    let _c_ : i32 = none ?? 42;
    let _d_ : i32 = (12)? ?? 42;
}
