// a throwing left operand is caught by '??', 'main' is not a thrower
class A { pub self () {} }
class B over A { pub self () {} }

fn bar (x : bool)-> i32
    throws AssertError
{
    if (x) throw copy AssertError ("");
    12
}

fn baz (x : bool)-> (&B)? {
    if (x) { (copy B ())? } else { none }
}

fn main () {
    let _a_ : i32 = bar (false) ?? 42;

    // the two branches are unified, the right operand keeps its own type
    let _b_ : &A = baz (false) ?? copy A ();
}
