fn using(x: i32);

fn foo(x: bool)-> i32
    throws AssertError
{
    if (x) throw AssertError("");
    12
}

fn bar() {
    let _a_ = foo(false) ?? { return; };    
}

fn baz() {
    let _z_ = loop {
        let _a_ = foo(false) ?? { break 90; };
    };
    using(_z_);
}

fn main() {
    let _a_ = foo(false) ?? { panic; };
    let _b_ = foo(true) ?? { panic; };
}
