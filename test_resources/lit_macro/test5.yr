/*
 * Named rules ('fn' rules) called from a constructor, the built-in rules
 * (__ident, __literal), and the '::__len' access of the rewriter
 */

macro decl {
    self (v=varDecl others=(v=varDecl)*) skips (" " | "\n" | "\t") #{
        #(v)
        #(for i in others) {
            #(i::v)
        }

        let count = #(others::__len);
        count
    }

    fn varDecl (name=__ident "=" value=__literal ";") skips (" " | "\n" | "\t") #{
        let __#(name)__ = #(value);
    }
}

fn foo ()-> i32 {
    decl#{
        a = 1;
        b = 2;
        c = 3;
    }
}
