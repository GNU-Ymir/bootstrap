/*
 * The capture of a '?' multiplier holds one element when the optional part
 * is present, and none otherwise, so '::__len' and the 'for' loop of the
 * rewriter both see the difference
 */

macro opt {
    self (a=__operand rest=("," b=__operand)?) skips (" ") #{
        let dmut res = #(a);
        #(for i in rest) {
            res += #(i::b);
        }

        let count = #(rest::__len);
        res + count
    }
}

fn foo ()-> i32 {
    opt#{ 1, 2 }
}

fn bar ()-> i32 {
    opt#{ 3 }
}
