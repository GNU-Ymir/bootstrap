/*
 * The '+' multiplier (one or more repetitions), captured in a variable
 * and traversed by the 'for' loop of the rewriter
 */

macro sum {
    self (first=__operand others=("+" inner=__operand)+) skips (" " | "\n" | "\t") #{
        let dmut res = #(first);
        #(for i in others) {
            res += #(i::inner);
        }

        res
    }
}

fn foo ()-> i32 {
    sum#{ 1 + 2 + 3 }
}

fn bar ()-> i32 {
    sum#{ 7 + 8 }
}
