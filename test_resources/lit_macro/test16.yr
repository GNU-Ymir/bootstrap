/*
 * '__index' is the depth of the rule being rewritten: 0 in the body of a
 * constructor, and one more for each named rule called from there
 */

macro depth {
    self (a=lvl1) skips (" ") #{
        #(a) + #(__index)
    }

    fn lvl1 (b=lvl2) skips (" ") #{
        #(b) + #(__index)
    }

    fn lvl2 (c=__operand) skips (" ") #{
        #(c) + #(__index)
    }
}

fn foo ()-> i32 {
    depth#{ 100 }
}
