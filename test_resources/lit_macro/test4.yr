/*
 * Macro repetitions ('*') and the 'for' loop of the rewriter,
 * used to generate one instruction per captured element
 */

macro list {
    self (first=__expr others=("," inner=__expr)*) skips (" " | "\n" | "\t") #{
        let dmut res = copy [#(first)];
        #(for i in others) {
            res ~= [#(i::inner)];
        }

        res
    }
}

fn foo ()-> [i32] {
    list#{ 1, 2, 3 }
}

fn bar ()-> [i32] {
    list#{ 8 }
}
