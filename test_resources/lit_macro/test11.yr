/*
 * A '+' multiplier is not satisfied when the repeated rule does not
 * match at least once
 */

macro sum {
    self (first=__operand others=("+" inner=__operand)+) skips (" ") #{
        let dmut res = #(first);
        #(for i in others) {
            res += #(i::inner);
        }

        res
    }
}

fn foo ()-> i32 {
    sum#{ 1 }
}
