/*
 * The content generated by a macro is inserted in a block of its own, the
 * variables it declares are thus not visible from the caller
 */

macro decl {
    self (a=__operand) skips (" ") #{
        let hidden = #(a);
        hidden
    }
}

fn foo ()-> i32 {
    let x = decl#{ 1 };
    x + hidden
}
