/*
 * '__uid' is unique for each expansion of a macro, and is the way a macro
 * declares variables that cannot collide with those of another expansion
 */

macro twice {
    self (a=__operand) skips (" ") #{
        let inner_#(__uid) = #(a);
        inner_#(__uid) + inner_#(__uid)
    }
}

fn foo ()-> i32 {
    twice#{ 1 } + twice#{ 2 }
}
