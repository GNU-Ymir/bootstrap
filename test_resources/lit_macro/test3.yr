/*
 * Multiple constructors in a single macro, chosen by pattern matching,
 * and substitution of captured variables inside the macro body
 */

macro arith {
    self ("add" a=__operand b=__operand) skips (" " | "\n" | "\t") #{
        #(a) + #(b)
    }

    self ("mul" a=__operand b=__operand) skips (" " | "\n" | "\t") #{
        #(a) * #(b)
    }
}

fn foo () {
    let x = arith#{ add 1 2 };
    let y = arith#{ mul 3 4 };

    x; y;
}
