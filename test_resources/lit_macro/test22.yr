/*
 * '\#' escapes a macro opening inside the body of a macro, the opening
 * being written as is in the generated content instead of being evaluated.
 * That is the way a macro generates the call of another macro
 */

macro inner {
    self (a=__operand) skips (" ") #{
        #(a) * 2
    }
}

macro outer {
    self (a=__operand b=__operand) skips (" ") #{
        inner\#{ #(a) } + inner\#{ #(b) }
    }
}

fn foo ()-> i32 {
    outer#{ 3 4 }
}
