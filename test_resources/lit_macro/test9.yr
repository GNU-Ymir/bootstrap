/*
 * Indexed access of a repeated capture inside the body of a macro,
 * from the beginning ('[i]') and from the end ('[$-i]')
 */

macro pick {
    self (first=__operand others=("," v=__operand)*) skips (" ") #{
        let a = #(first);
        let b = #(others[0]::v);
        let c = #(others[$-1]::v);

        a + b + c
    }
}

fn foo ()-> i32 {
    pick#{ 1, 2, 3 }
}
