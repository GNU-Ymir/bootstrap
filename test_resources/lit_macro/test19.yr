/*
 * Nested repetitions, and the nested 'for' loops of the rewriter that
 * traverse them
 */

macro grid {
    self (rows=(r=(v=__operand)+ ";")+) skips (" " | "\n" | "\t") #{
        let dmut res = 0;
        #(for i in rows) {
            #(for j in i::r) {
                res += #(j::v);
            }
        }

        res
    }
}

fn foo ()-> i32 {
    grid#{
        1 2 3 ;
        4 5 ;
    }
}
