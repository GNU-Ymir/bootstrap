/*
 * Two named rules sharing the same name and accepting the same content,
 * the rule call is thus ambiguous
 */

macro amb {
    self (v=entry) skips (" ") #{
        #(v)
    }

    fn entry (a=__operand) skips (" ") #{
        #(a)
    }

    fn entry (b=__literal) skips (" ") #{
        #(b)
    }
}

fn foo ()-> i32 {
    amb#{ 1 }
}
