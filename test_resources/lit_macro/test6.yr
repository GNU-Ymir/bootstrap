/*
 * A macro call whose content does not match any of the constructors
 * of the macro
 */

macro arith {
    self ("add" a=__operand b=__operand) skips (" ") #{
        #(a) + #(b)
    }

    self ("mul" a=__operand b=__operand) skips (" ") #{
        #(a) * #(b)
    }
}

fn foo () {
    let x = arith#{ sub 1 2 };

    x;
}
