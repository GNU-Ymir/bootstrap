/*
 * The '?' multiplier (zero or one repetition), used with and without
 * the optional part being present in the macro call
 */

macro opt {
    self (a=__operand rest=("," b=__operand)?) skips (" ") #{
        let x = #(a);
        x
    }
}

fn foo ()-> i32 {
    opt#{ 1, 2 }
}

fn bar ()-> i32 {
    opt#{ 3 }
}
