/*
 * The '__key' rule, matching a keyword as a whole token and not the
 * beginning of an identifier(e.g. 'null' in 'nullable')
 */

macro value {
    self (__key ":" v=__literal) skips (" ") #{
        #(v)
    }

    self (i=__ident ":" v=__literal) skips (" ") #{
        #(i) + #(v)
    }
}

fn foo ()-> i32 {
    value#{ null : 12 }
}

fn bar ()-> i32 {
    let nullable = 30;
    value#{ nullable : 12 }
}
