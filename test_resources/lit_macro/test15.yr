/*
 * The built-in rules matching raw pieces of content: '__any' (a single
 * character, whatever it is), '__char' (a single character, unescaped) and
 * '__token' (any token of the language)
 */

macro raw {
    self (a=__any b=__char c=__token) #{
        42
    }
}

macro tok {
    self (op=__token) #{
        1
    }
}

fn foo ()-> i32 {
    raw#{ab+}
}

fn bar ()-> i32 {
    tok#{<=>}
}
