in macro_lib;

/*
 * A public macro, and a private one, both used from another package by
 * test_resources/lit_macro/test31.yr and test32.yr
 */

pub macro exported {
    self (a=__operand b=__operand) skips (" ") #{
        #(a) + #(b)
    }
}

macro hidden {
    self (a=__operand) skips (" ") #{
        #(a)
    }
}
