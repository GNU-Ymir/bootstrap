/*
 * A macro is callable with the three kinds of macro openings, '#{}', '#()'
 * and '#[]', the content being read the same way in the three cases
 */

macro triple {
    self (a=__operand "," b=__operand) skips (" ") #{
        #(a) + #(b)
    }
}

fn withAcc ()-> i32 {
    triple#{ 1, 2 }
}

fn withPar ()-> i32 {
    triple#( 3, 4 )
}

fn withCro ()-> i32 {
    triple#[ 5, 6 ]
}
