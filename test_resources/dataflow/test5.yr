entity A {
    pub let own : i32 = 0;

    pub self (i : i32)
        with own = i
    {}

    __dtor (mut self) {
        bar ();
    }
}

fn bar ();

fn foo (x : bool) -> i32 {
    let a = A (1);
    a.own;
    {
        let b = A (2);
        b.own;
        if (x) {
            return 1;
        }
    }

    return 2;
}
