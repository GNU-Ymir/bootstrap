// A no_move ctor is skipped by the move operator, an only_move ctor by any other call.

entity Foo {
    pub let x : i32;

    @no_move
    pub self ()
        with x = 0
    {}

    @only_move
    pub self (x : i32)
        with x = x
    {}

    pub self (x : i32, y : i32)
        with x = x + y
    {}
}

fn main () {
    let mut _a_ = Foo ();
    let mut b = Foo (1, 2);
    let mut _c_ = move (12) b;
}
