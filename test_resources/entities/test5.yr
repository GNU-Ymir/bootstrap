fn baz (_ : [c8]);

entity A {
    pub self () {}

    __dtor (mut self) {
        baz ("Exit");
    }
}

entity B {
    pub self () {}

    let mut a : A = A ();

    pub fn foo (mut self)-> A {
        move self.a
    }
}

entity C {
    pub self () {}

    let mut b : B = B ();

    pub fn foo (mut self)-> B {
        move self.b
    }

    __dtor (mut self) {
        baz ("dtor C");
    }

}

fn main () {
    let _ = {
        let mut _b_ = C ();
        _b_:.foo ()
    };

    baz ("here");
}
