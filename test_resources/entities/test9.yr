// The move operator calls the reset ctor it names, with the arguments it carries.

entity Foo {
    pub let x : i32;

    pub self ()
        with x = 0
    {}

    pub self (x : i32)
        with x = x
    {}

    pub self open (x : i32, y : i32)
        with x = x + y
    {}
}

fn main () {
    let mut a = Foo (12);
    let mut _b_ = move (42) a;

    let mut c = Foo (23);
    let mut _d_ = move c;

    let mut e = Foo (1);
    let mut _f_ = move (x-> 7) e;

    let mut g = Foo (2);
    let mut _h_ = move::open (9, 3) g;
}
