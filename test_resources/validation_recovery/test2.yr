/*
 * The members, calls and indexes of a value that failed to validate report
 * nothing.
 */

in test2;

fn bar (a: i32)-> i32 {
    a
}

fn foo () {
    let x = undefined_a;
    let a = x.field;
    let b = x [0];
    let c = bar (x);
    let d = x (1, 2);
    let e: [c8] = x;
    if x {
        undefined_b;
    }

    undefined_c;
}
