/*
 * A variable whose value fails to validate can be referenced and aliased,
 * and moved to a value that needs an explicit alias.
 */

in test7;

fn bar (ref mut a: i32) {
    a = 1;
}

fn baz ()-> mut [mut i32] {
    let x = undefined_a;
    return x;
}

fn foo () {
    let mut c = undefined_b;
    bar (ref c);
    let mut a: mut [mut i32] = c;
    let p = &c;
    undefined_c;
}
