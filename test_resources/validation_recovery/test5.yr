/*
 * An operation over a value that failed to validate still throws what its
 * operands throw, so the catchers and the guards around it report nothing.
 */

in test5;

class A over Exception { pub self () {} }

fn mayThrow ()-> i32 throws A;

fn bar (a: i32, b: i32)-> i32 {
    a + b
}

fn foo () {
    let x = undefined_a;
    {
        x + mayThrow ();
    } catch {
        A () => {}
    }

    {
        bar (x, mayThrow ());
    } failure {}

    {
        let _: i32 = { mayThrow (); x };
    } catch {
        A () => {}
    }

    undefined_b;
}
