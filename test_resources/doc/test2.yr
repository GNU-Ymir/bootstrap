in test2;

// Plain top-level declarations: exercised through the "validated" doc-dump
// path, which already named symbols correctly before YMI-145 (via
// Symbol::path). Kept as a regression guard against the refactor.

pub def MaxSize = 42;

pub enum Color : i32
| RED = 0
| GREEN = 1
;

pub trait Greeter {
    pub fn greet(self)-> [c8];
}

pub class Widget {
    pub let val: i32;

    pub self (val: i32)
        with val = val
    {}

    pub fn get(self)-> i32 {
        return self.val;
    }
}

pub fn identity(a: i32)-> i32 {
    return a;
}

pub fn main () {
    let w = Widget(3);
    let _ = identity(w.get()) + MaxSize;
}
