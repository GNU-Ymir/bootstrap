/**
 * A companion module, and a template one never specialized, which stays on the
 * unvalidated doc-dump path.
 * */
in test3;

pub class X {
    prv let _x: i32 = 0;

    pub self () {}
}

@companion
pub mod X {
    pub fn get (x: &X)-> i32 {
        x._x
    }
}

@companion
pub mod X {T} {
    pub fn add (x: &X, t: T)-> T {
        cast!T (x._x) + t
    }
}

fn main () {
    let _ : i32 = X::get (copy X ());
}
