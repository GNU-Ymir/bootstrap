in test1;

// Everything under this template module is never specialized, so it stays
// on the "unvalidated" doc-dump path (the one that used to name every
// symbol after its introducing keyword instead of its identifier).
mod Wrapped {Unused} {

    pub static counter: i32 = 0;

    pub def MaxSize = 42;

    pub enum Color : i32
    | RED = 0
    | GREEN = 1
    ;

    pub trait Greeter {
        pub fn greet(self)-> [c8];
    }

    pub class Widget {T} {
        pub let val: T;

        pub self (val: T)
            with val = val
        {}

        pub fn tplMethod {U} (self, u: U)-> U {
            return u;
        }
    }

    pub fn tplFn {T} (a: T)-> T {
        return a;
    }

    macro Stringify {
        self (a=__expr) skips(" ") #{ #{a} }
        fn wrap (a=__expr) skips(" ") #{ #{a} }
    }
}

pub fn main () {}
