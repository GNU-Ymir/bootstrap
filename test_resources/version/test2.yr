// version_value is the value of a version as a string, the text after the first '='
in test2;

fn main () {
    cte assert (__pragma!version_value(MODE) == "fast");
    cte assert (__pragma!version_value(mode) != "slow");
    cte assert (__pragma!version_value(FOO) == "12");
    cte assert (__pragma!version_value(FOO) == __pragma!version_value(ALSO_TWELVE));
    cte assert (__pragma!version_value(EQ) == "a=b");
    cte assert (__pragma!version_value(EMPTY) == "");
    cte assert (__pragma!version_value(TWICE) == "2");

    let s: [c8] = __pragma!version_value(MODE);
    let _ = s;
}
