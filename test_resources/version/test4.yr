// version_value guarded by has_version, the branch of an unset version never validated
in test4;

use std::conv;

fn main () {
    let x = cte if __pragma!has_version(NOPE) {
        cte to!{i32}(__pragma!version_value(NOPE))
    } else {
        0
    };

    let y = cte if __pragma!has_version(FOO) {
        cte to!{i32}(__pragma!version_value(FOO))
    } else {
        0
    };

    let _: i32 = x + y;
}
