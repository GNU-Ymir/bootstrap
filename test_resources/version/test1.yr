// has_version is true for a set version, valued or not and in any case, as __version, and #if tests that it is set whatever its value
in test1;

fn main () {
    cte assert (__pragma!has_version(FOO));
    cte assert (__pragma!has_version(foo));
    cte assert (__pragma!has_version(BARE));
    cte assert (__pragma!has_version(MODE) && __pragma!has_version(BARE));
    cte assert (!__pragma!has_version(NOPE));
    cte assert (__version!FOO == __pragma!has_version(FOO));
    cte assert (__version!BARE == __pragma!has_version(BARE));
    cte assert (__version!NOPE == __pragma!has_version(NOPE));
    let x: bool = __pragma!has_version(PI);
    let _ = x;

#if FOO
    let y: i32 = 1;
#else
    let y: [c8] = "";
#end
    let _: i32 = y;
}
