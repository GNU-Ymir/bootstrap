// a version not set, or set without a value, has no value, and the pragmas take a single identifier
in test5;

fn unset () {
    let _ = __pragma!version_value(NOPE);
}

fn bare () {
    let _ = __pragma!version_value(BARE);
}

fn reset () {
    let _ = __pragma!version_value(RESET);
}

fn noName () {
    let _ = __pragma!version_value();
}

fn notAnIdentifier () {
    let _ = __pragma!has_version("FOO");
}

fn twoNames () {
    let _ = __pragma!has_version(FOO, BARE);
}
