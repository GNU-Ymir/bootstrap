// the value of a version converted at compile time by std::conv::to
in test3;

use std::conv;

fn main () {
    cte assert (to!{i32}(__pragma!version_value(FOO)) == 12);
    cte assert (to!{u8}(__pragma!version_value(FOO)) > 11u8);
    cte assert (to!{f64}(__pragma!version_value(PI)) == 1.5);

    let y = cte if to!{i32}(__pragma!version_value(FOO)) == 12 { 1 } else { "" };
    let _: i32 = y;
}
