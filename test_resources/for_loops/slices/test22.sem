frame: test22::main ()-> void {
    let mut prices: mut [mut i32] = copy ({.len = 2us, .ptr = &([10, 20])});
    test22::scale (alias (prices), 3);
    <unit-value>
}
frame: test22::scale (mut values: mut [mut i32], factor: i32)-> void {
    {
        let mut #_value: mut [mut i32] = values;
        let mut #_index: usize = 0us;
        while (#_index < #_value.len) {
            let ref mut v: mut i32 = ref (#_value [#_index]);
            {
                v = (v * factor);
                <unit-value>
            }
        } step #_index = (#_index + 1us)
    };
    {
        let mut #_value: mut [mut i32] = values;
        let mut i: usize = 0us;
        while (i < #_value.len) {
            let ref mut v: mut i32 = ref (#_value [i]);
            {
                v = (v + cast!{i32}(i));
                <unit-value>
            }
        } step i = (i + 1us)
    }
}
