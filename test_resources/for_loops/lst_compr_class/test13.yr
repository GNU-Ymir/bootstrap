// A class iterator says when it is done, not how many times: its comprehension
// has no compile time length either.
class CIterator {

    let _x : [i32];
    let mut _index : usize;

    pub self (index : usize, x : [i32])
        with _index = index
        , _x = x
    {}

    pub fn get {0us, 1us} (mut self)-> i32 {
        self._x [self._index]
    }

    impl Iterable {
        pub over next (mut self) {
            self._index += 1;
        }
    }

    pub fn opEquals (self, o : usize)-> bool {
        self._index == o
    }

}

class A {

    let _items : [i32] = copy [1, 2, 3];

    pub self () {}

    pub fn begin (self)-> dmut &CIterator {
        copy CIterator (0us, self._items)
    }

    pub fn end (self)-> usize {
        self._items.len
    }

}

fn main () {
    let a = copy A ();

    let _ = [i for i in a];
}
