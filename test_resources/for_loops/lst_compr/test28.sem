frame: test28::main ()-> void {
    let _: [i32] = {
            let #_iter: (yield-> i32) = test28::count (5);
            let mut #_yielded: mut i32;
            let mut #_value: mut [mut i32] = copy [<unit-value> ; 0us];
            while (#_iter).next(#_yielded) {
                let x: i32 = #_yielded;
                if (x != 2) #_value ~= {.len = 1us, .ptr = &([x])}
            };
            #_value
        };
    <unit-value>
}
frame: test28::count (n: i32)-> (yield-> i32) {
    {
        let mut #_iter: usize = 0us;
        let #_nb_iters: usize = if (0 > n) 0 else n;
        while (#_iter < #_nb_iters) {
            let mut i: i32 = 0;
            i = cast!{i32}(#_iter);
            {
                yield i
            }
        } step #_iter = (#_iter + 1us)
    }
}
