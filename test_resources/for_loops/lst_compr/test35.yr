// a tuple has a compile time arity and its filter is computed at compile time,
// so unlike a range an array comprehension over one can be filtered
fn main () {
    let _a_ = [x for x in (1, 2, 3) if x != 2];
    let _b_ = [x for i, x in (1, 2, 3) if i != 0us];
    let _c_ = [x for x in (1, 2, 3) if x > 10];
}
