fn describe (day: i32, month: i32)-> [c8] {
    match (day, month) {
        (25, 12) => "Christmas",
        (1, 1) => "New Year's Day",
        _ => "an ordinary day",
    }
}

fn sum (a: [i32])-> i32 {
    match a {
        [x, y] => x + y,
        [x] => { x }
        _ => 0
    }
}

fn log (day: i32, month: i32) {
    match (day, month) {
        (1, 1) => describe (day, month);
        _ => {}
    }
}

fn mayFail (i: i32)-> i32
    throws AssertError
{
    if (i < 0) throw copy AssertError ("negative");
    i
}

fn recover (i: i32)-> i32 {
    {
        mayFail (i)
    } catch {
        _: &AssertError => 0,
    }
}

fn main () {
    let _d_ = describe (25, 12);
    let s = copy [1, 2];
    let _i_ = sum (s);
    log (1, 1);
    let _r_ = recover (1);
}
