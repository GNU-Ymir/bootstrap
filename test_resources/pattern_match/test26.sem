frame: test26::main ()-> void {
    test26::describe (copy ({.len = 3us, .ptr = &([1, 2, 3])}));
    <unit-value>
}
frame: test26::describe (values: [i32])-> i32 {
    {
        let mut #_value: [i32] = values;
        if ((#_value.len == 1us) && #{
            let x: i32 = #_value [0us];
            true
        #}) {
            return x;
        } else if ((#_value.len == 2us) && #{
            let a: i32 = #_value [0us];
            let b: i32 = #_value [1us];
            true
        #}) {
            return (a + b);
        } else if #{
            let rest: [i32] = {.len = #_value.len, .ptr = (#_value.ptr + (0us * 4us)), .blk = #_value.blk_info};
            true
        #} {
            return cast!{i32}(rest.len);
        };
    };
}
