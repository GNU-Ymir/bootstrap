in test1;

/**
 * A package exercising, in one compilation, every YIL construct the serializer has a case for:
 * the three symbol kinds, every instruction, every value and every type.
 */

// a global variable, a mutable one, and a thread local one
lazy counter : i32 = 7;
lazy dmut buffer : [i32] = copy [0, 0, 0];
@thread
lazy local : i32 = 1;

record Point {
    pub let x : i32;
    pub let y : f64;

    pub self (x : i32, y : f64)
        with x = x
        , y = y
    {}
}

class Shape {
    pub self () {}

    pub fn area (self)-> f64 {
        0.0
    }
}

class Square over Shape {
    let side : f64;

    pub self (side : f64)
        with side = side
    {}

    pub over area (self)-> f64 {
        self.side * self.side
    }
}

// int and float binaries, and a call
fn add (a : i32, b : i32)-> i32 {
    a + b
}

fn scale (a : f64, b : f64)-> f64 {
    a * b
}

// an indirect call through a function pointer
fn apply (f : fn (i32, i32)-> i32, a : i32, b : i32)-> i32 {
    f (a, b)
}

// conditional jumps, labels and gotos
// the range is a usize one on purpose, see FINDINGS.md: an 'i32' range lowers to a literal that
// does not fit its type, which the exporter then writes out as another number
fn sum (n : usize)-> i32 {
    let mut acc = 0;
    for i in 0us .. n {
        if (i % 2us == 0us) {
            acc += cast!i32 (i);
        } else {
            acc -= cast!i32 (i);
        }
    }

    while (acc < 0) {
        acc += 10;
    }

    return acc;
}

// unary operators
fn negate (x : i32, b : bool)-> i32 {
    if (!b) { -x } else { x }
}

// casts between scalar types
fn casting (x : i32)-> f64 {
    cast!f64 (cast!i64 (x))
}

// array literals, slicing and indexing
fn arrays ()-> i32 {
    let a = [1, 2, 3, 4];
    let b = a [1 .. 3];

    b [0]
}

// a string literal, and a char one
fn strings (c : c8)-> [c8] {
    if (c == 'a'c8) { "hello" } else { "world" }
}

// tuple values, and a tuple type
fn tuples ()-> (i32, f64) {
    let t = (1, 2.0);

    (t.0, t.1)
}

// a record, hence a struct typed value passed around by address
fn records ()-> f64 {
    let p = Point (1, 2.0);

    scale (cast!f64 (p.x), p.y)
}

// a virtual call through a vtable, and a class allocation
fn classes ()-> f64 {
    let s : &Shape = copy Square (3.0);

    s.area ()
}

// references, taking the address of a variable and reading through it
fn references (ref mut x : i32) {
    x = x + 1;
}

fn throwing (i : i32)-> i32
    throws AssertError
{
    assert (i > 0);

    return i;
}

// a try/catch, so a landing pad and a catch entry
fn catching (i : i32)-> i32 {
    { throwing (i) } catch { _ : &AssertError => { 0 } }
}

// a scope guard, so a try/finally, and a write into a global slice
fn guarded ()-> i32 {
    let mut r = 0;
    {
        r = 1;
    } exit {
        buffer [0] = 2;
    }

    return r;
}

fn main () {
    let mut x = 1;
    references (ref x);

    let mut acc = add (x, local) + counter;
    acc += apply (&add, 1, 2);
    acc += sum (10);
    acc += negate (3, false);
    acc += arrays ();
    acc += cast!i32 (casting (2));
    acc += cast!i32 (classes ());
    acc += cast!i32 (records ());
    acc += catching (-1);
    acc += guarded ();
    acc += tuples ().0;
    acc += cast!i32 (strings ('a'c8).len);

    { acc += throwing (1); } catch { _ : &AssertError => {} }

    buffer [1] = acc;
}
