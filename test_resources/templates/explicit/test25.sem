frame: [weak] test25::sum!{[[1, 2], [3, 4]]}::sum (i: usize)-> i32 return {
    (((#{
        if (2us <= i) panic;
        [[1, 2], [3, 4]] [i]
    #} [0us] + 2) + 3) + 4)
}
