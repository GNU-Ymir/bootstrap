class X {
    pub let mut a : [c8] = "";
    pub self () {}
}

record A {
    pub let dmut x : &X = copy X ();
    pub self () {}
}

record B {
    pub let x : &X = copy X ();
    pub self () {}
}

fn main () {
    cte assert (!(template!{B}{alias U}));    
    cte assert (template!{A}{alias U});
}
