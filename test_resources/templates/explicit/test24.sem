frame: test24::main (args: [[c8]])-> void {
    let _x_: [c8] = test24::names!{["_a"s8, "a"s8]}::names (#{
                if (args.len <= 0us) panic;
                args [0us]
            #});
    let _y_: [c8] = test24::names!{["a long name, hashed"s8, "a"s8]}::names (#{
                if (args.len <= 0us) panic;
                args [0us]
            #});
    <unit-value>
}
frame: [weak] test24::names!{["_a"s8, "a"s8]}::names (sep: [c8])-> [c8] return "_a"s8 ~ sep ~ "a"s8
frame: [weak] test24::names!{["a long name, hashed"s8, "a"s8]}::names (sep: [c8])-> [c8] return "a long name, hashed"s8 ~ sep ~ "a"s8
