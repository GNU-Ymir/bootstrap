// Arrays of the same values but another element type, and tuples, are distinct instances

fn foo {X: T, T} (i: usize)-> usize {
    i + T::size
}

fn bar {X: [i32 ; 2]} (i: usize)-> i32 {
    X[i]
}

fn main (args: [[c8]]) {
    let _a_ = foo!{[1, 2]} (args.len);
    let _b_ = foo!{[1i8, 2i8]} (args.len);
    let _c_ = foo!{(1, 2)} (args.len);
    let _d_ = foo!{[1, 3]} (args.len);
    let _e_ = foo!{[1, 2]} (args.len);

    let _f_ = bar!{[1, 2]} (args.len) + bar!{[1, 3]} (args.len) + bar!{[1, 2]} (args.len);
}
