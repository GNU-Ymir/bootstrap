class Foo{T} {
    pub self{Z} (a: Z) {
        a;
    }
}

class Bar {
    pub self{Z} (a: Z) {
        a;
    }
}

class Baz {
    pub self named{Z} (a: Z) {
        a;
    }
}

fn main () {
    let x = copy Foo!{i32}(1.0f);
    let y = copy Bar(1.0f);
    let z = Baz::named(1.0f);
    (x, y, z);
}
