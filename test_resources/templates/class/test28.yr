class A {T} {
    let dmut _values : [T] = [];

    pub self () {}

    pub fn push (mut self, a : T) {
        self._values ~= [a];
    }

    pub fn len (self)-> usize {
        self._values.len
    }
}

fn main () {
    let dmut a = copy A ();
    a:.push (12);
    a:.push (13);

    let l : usize = a.len ();
    l;
}
