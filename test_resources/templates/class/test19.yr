class A {U, V} {
    pub let a : U;
    pub let f : fn (U)-> V;

    pub self (a : U, f : fn (U)-> V)
        with a = a, f = f
    {}
}

fn main () {
    let x : &A!{i32, f64} = copy A (1, |i: i32| => cast!f64 (i));
    let y : &A!{i32, i32} = copy A (2, |i| => i + 1);
    x.f (x.a);
    y.f (y.a);
}
