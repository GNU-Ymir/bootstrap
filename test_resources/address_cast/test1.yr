// an unsafe context casts a pointer to its address, a usize, and an address back to a pointer, through which it writes

in test1;

pub fn page (p : *u8)-> usize {
    unsafe {
        cast!usize (p) >> 13us
    }
}

pub fn at (addr : usize)-> *u8 {
    unsafe {
        cast!{*u8} ((addr >> 13us) << 13us)
    }
}

record Cell {
    pub let mut value : usize;
}

pub fn set (addr : usize, v : usize) {
    unsafe {
        let dmut c = cast!{*Cell} (addr);
        (*c).value = v;
    }
}
