// an element that is not known at compile time leaves the comparison unfolded
in test6;

fn element (i : i32) {
    cte assert ([1, i] == [1, 2]);
}

fn slice_ (s : [i32]) {
    cte assert (s == [1, 2]);
}

fn ordering (i : i32) {
    cte assert ([1, i] < [1, 3]);
}

fn stringElement (s : [c8]) {
    cte assert ([s] < ["abc"]);
}
