// the equality of two array literals, folded at compile time, the sub-slice of
// an array being one such literal
in test5;

fn main () {
    cte assert ([1, 2] == [1, 2]);
    cte assert ([1, 2] != [1, 3]);
    cte assert ([1, 2] != [1, 2, 3]);
    cte assert (['a', 'b'] == ['a', 'b']);
    cte assert ([1.5, 2.5] == [1.5, 2.5]);
    cte assert ([true, false] != [true, true]);
    cte assert ([[1, 2], [3, 4]] == [[1, 2], [3, 4]]);
    cte assert (["ab", "c"] == ["ab", "c"]);

    let s : [i32 ; 3] = [1, 2, 3];
    cte assert (s [0 .. 2] == [1, 2]);
    cte assert (s [1 .. 3] == [2, 3]);
    cte assert (s [0 .. 3] != [1, 2]);
}
