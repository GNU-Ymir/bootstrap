// the lexicographic comparison of two array literals, folded at compile time,
// the shorter operand ordering first when it is a prefix of the other
in test7;

fn main () {
    cte assert ([1, 2] < [1, 3]);
    cte assert ([2] > [1, 9]);
    cte assert ([1, 2] < [1, 2, 3]);
    cte assert ([1, 2, 3] > [1, 2]);
    cte assert ([1, 2] <= [1, 2]);
    cte assert ([1, 2] >= [1, 2]);
    cte assert (['a', 'b'] < ['a', 'c']);
    cte assert ([1.5, 2.0] < [1.5, 2.5]);
    cte assert ([[1, 2], [3, 4]] < [[1, 2], [3, 5]]);
    cte assert (["ab", "c"] < ["ab", "d"]);
    cte assert (["ab"] < ["abc"]);
    cte assert (["b"] > ["abc"]);
    cte assert ([""] < ["a"]);
    cte assert (["ab"s32] < ["abc"s32]);

    let s : [i32 ; 3] = [1, 2, 3];
    cte assert (s [0 .. 2] < s [1 .. 3]);
    cte assert (s [0 .. 2] < [2, 0]);
}
