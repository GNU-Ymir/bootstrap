// the bitwise operators over two integer literals, folded at compile time, a
// shift left dropping the bits it moves out of the type
in test8;

fn main () {
    cte assert ((0b0101u32 | 0b0011u32) == 0b0111u32);
    cte assert ((0b0101u32 & 0b0011u32) == 0b0001u32);
    cte assert ((0b0101u32 ^ 0b0011u32) == 0b0110u32);
    cte assert ((1u32 << 4u32) == 16u32);
    cte assert ((0x80u32 >> 7u32) == 1u32);

    cte assert ((-4 | 1) == -3);
    cte assert ((-4 & 7) == 4);
    cte assert ((-1 ^ 5) == -6);
    cte assert ((3 << 2) == 12);
    cte assert ((-8 >> 1) == -4);
    cte assert ((-1 >> 31) == -1);

    cte assert ((0xFFu8 << 4u8) == 0xF0u8);
    cte assert ((0xF0u8 >> 4u8) == 0x0Fu8);
    cte assert ((1i8 << 7i8) == -128i8);
    cte assert ((0x40000000i32 << 2) == 0);
    cte assert ((1u64 << 63u64) == 0x8000000000000000u64);
    cte assert ((1us << 3us) == 8us);
    cte assert (((1 << 3) | (1 << 1)) == 10);
}
