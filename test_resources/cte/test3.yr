// an index or a range bound that is not known at compile time leaves the
// access unfolded
in test3;

fn index (i : usize) {
    cte assert ("hello" [i] == 'l');
}

fn rangeEnd (i : usize) {
    cte assert ("hello" [0us .. i] == "he");
}

fn mutated () {
    let mut s = "hello";
    s = "worldly";
    cte assert (s.len == 7us);
}
