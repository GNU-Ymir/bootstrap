// the same folding through an immutable binding, and for the utf16 and utf32
// encodings, whose length counts code units
in test2;

fn main () {
    let s = "hello";
    cte assert (s.len == 5us);
    cte assert (s [4] == 'o');
    cte assert (s [1 .. 3] == "el");

    let narrow = "héllo";
    cte assert (narrow.len == 6us);
    cte assert (narrow [3 .. 6] == "llo");

    let wide = "héllo"s16;
    cte assert (wide.len == 5us);
    cte assert (wide [0 .. 2] == "hé"s16);

    let full = "héllo"s32;
    cte assert (full.len == 5us);
    cte assert (full [1] == 'é'c32);
    cte assert (full [0 .. 2] == "hé"s32);
}
