// the length, the indexing and the range slicing of a string literal, folded
// at compile time
in test1;

fn main () {
    cte assert ("hello".len == 5us);
    cte assert ("hello" [1] == 'e');
    cte assert ("hello" [1 .. 3] == "el");
    cte assert ("hello" [0 .. 5] == "hello");
    cte assert ("hello" [2 .. 2] == "");
    cte assert ("hello" [1 .. 3].len == 2us);
    cte assert ("hello" [1 .. 4] [1] == 'l');
    cte assert (("hello" ~ " world") [6 .. 11] == "world");
    cte assert ((copy "hello").len == 5us);
}
