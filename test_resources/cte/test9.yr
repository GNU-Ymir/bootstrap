// the bitwise operators over the values of an integer enum, folded through the
// enum proxy, and so usable as a tag argument or a template value
in test9;

pub enum K : u32
| A = 0b001u32
| B = 0b010u32
| C = 0b100u32;

tag t (m: u32 = K::A) {
    pub self {fn F} () {
        let _ = m;
    }
}

#[t (m-> K::A | K::B)]
fn d ()-> i32 { 1 }

#[t (m-> 0b01u32 | 0b10u32)]
fn a ()-> i32 { 1 }

fn mask {M: u32} ()-> u32 {
    cte assert (M == 0b101u32);
    M
}

fn main () {
    cte assert ((K::A | K::B) == 0b011u32);
    cte assert ((K::A | K::A) == K::A);
    cte assert (((K::A | K::B | K::C) & K::B) == K::B);
    cte assert ((K::A ^ K::C) == 0b101u32);
    cte assert ((K::B << 1u32) == K::C);
    cte assert ((K::C >> 2u32) == K::A);

    let _ = mask!{K::A | K::C} ();
    let _ = d () + a ();
}
