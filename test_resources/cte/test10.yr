// a shift count out of the width of the type, caught at compile time
in test10;

fn left () {
    cte assert ((1u32 << 32u32) == 0u32);
}

fn right () {
    cte assert ((1i64 >> 64i64) == 0i64);
}

fn negative () {
    cte assert ((1 << -1) == 0);
}

fn size () {
    cte assert ((1us << 64us) == 0us);
}
