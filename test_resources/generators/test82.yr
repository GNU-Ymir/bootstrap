// a template generator method, specialized twice
class A {
    pub self () {}

    pub yield repeat {T} (self, x: T, n: i32)-> T {
        for _ in 0 .. n {
            yield x;
        }
    }
}

fn main () {
    let a = A ();
    for i in a.repeat (1, 3) { let _ = i; }
    for s in a.repeat ("s", 2) { let _ = s; }
}
