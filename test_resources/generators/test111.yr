// the fields of the frame of a generator are laid out by decreasing alignment, leaving no padding between them
class Box {
    pub let v: u32;

    pub self (v: u32)
        with v = v
    {}
}

yield mixed (n: u32)-> u32 {
    let small = cast!u8 (n);
    let first = Box (n);
    let flag = cast!u8 (n + 1u32);
    let second = Box (n + 2u32);
    let count = n + 3u32;

    yield first.v + cast!u32 (small);
    yield second.v + cast!u32 (flag) + count;
}

fn main ()-> i32 {
    let mut sum = 0u32;
    for x in mixed (3u32) {
        sum += x;
    }

    cast!i32 (sum)
}
