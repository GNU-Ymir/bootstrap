// a record implementing the generator of a trait
trait Seq {
    pub yield each (self)-> i32;
}

record R {
    pub let n: i32;

    pub self (n: i32) with n = n {}

    impl Seq {
        pub over yield each (self)-> i32 {
            yield self.n;
        }
    }
}

fn main () {
    for i in R (1).each () { let _ = i; }
}
