// two generators yielding in each other: the frame of one embeds the other, which allocates the first
yield even (n: i32)-> i32 {
    if n > 0 {
        yield n;
        yield in odd (n - 1);
    }
}

yield odd (n: i32)-> i32 {
    if n > 0 {
        yield n;
        yield in even (n - 1);
    }
}

fn main ()-> i32 {
    let mut sum = 0;
    for i in even (4) {
        sum += i;
    }

    sum
}
