// the generator of a trait must be implemented by a generator
yield gen ()-> i32 {
    yield 1;
}

trait Seq {
    pub yield each (self)-> i32;
}

class A {
    pub self () {}
    impl Seq {
        pub over each (self)-> (yield-> i32) {
            gen ()
        }
    }
}

fn main () {
    let _ = A ();
}
