// the alias is unnecessary when the enclosing generator does not yield mutable borrowed values
yield rows (n: i32)-> dmut [i32] {
    for i in 0 .. n {
        yield copy [i, i];
    }
}

yield all (n: i32)-> [i32] {
    let dmut g = rows (n);
    yield in alias g;
}

fn main () {
    for x in all (3) {
        x;
    }
}
