// a generator method overridden, called through a reference to the ancestor
class A {
    pub self () {}

    pub yield each (self)-> i32 {
        yield 1;
    }
}

class B over A {
    pub self () {}

    pub over yield each (self)-> i32 {
        yield 2;
        yield 3;
    }
}

fn sum (a: &A)-> i32 {
    let mut s = 0;
    for i in a.each () {
        s += i;
    }
    s
}

fn main () {
    let _ = sum (B ());
}
