// the alias operator borrows the values of a generator mutably
yield rows (n: i32)-> dmut [i32] {
    for i in 0 .. n {
        yield copy [i, i];
    }
}

fn main ()
    throws AssertError
{
    let dmut g = rows (3);
    let dmut n = g:.next ();

    if let Ok (dmut x) = alias n {
        x[0] = 12;
        assert (x[0] == 12);
    }
}
