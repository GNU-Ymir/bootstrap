// the loops over a map of a generator never release their iterator, a yield may suspend any of them
yield flat (m: [i32 => [i32]])-> i32 {
    for _, v in m {
        for s in v {
            yield s;
        }
    }
}

yield inCompr (m: [i32 => i32])-> i32 {
    let a = copy [{ yield k; v } for k, v in m];
    let b = copy [k => { yield v; k } for k, v in m];
    let _ = (a, b);
}

fn main () {
    for _ in flat (copy [1 => copy [2, 3]]) {}
    for _ in inCompr (copy [1 => 2]) {}
    for _ in (yield v for _, v in copy [1 => 2]) {}
}
