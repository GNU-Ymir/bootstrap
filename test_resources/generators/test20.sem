frame: test20::main ()-> void {
    {
        let #_iter: (yield-> (i32, test20::Point)) = test20::points (3);
        let mut #_yielded: (i32, test20::Point);
        while (#_iter).next(#_yielded) {
            let t: (i32, test20::Point) = #_yielded;
            {
                #{
                    let i: i32 = t.0;
                    let p: test20::Point = t.1
                #};
                <unit-value>
            }
        }
    }
}
frame: test20::Point::self (mut ref self: mut test20::Point, x: i32, y: i32)-> void {
    {
        self.x = x;
        self.y = y
    };
    <unit-value>
}
frame: test20::points (n: i32)-> (yield-> (i32, test20::Point)) {
    {
        let mut #_iter: usize = 0us;
        let #_nb_iters: usize = if (0 > n) 0 else n;
        while (#_iter < #_nb_iters) {
            let mut i: i32 = 0;
            i = cast!{i32}(#_iter);
            {
                let p: test20::Point = test20::Point::self(new, i, (i * i));
                yield (i, p)
            }
        } step #_iter = (#_iter + 1us)
    }
}
