// yield in alias borrows the values of a generator mutably
yield rows (n: i32)-> dmut [i32] {
    for i in 0 .. n {
        yield copy [i, i];
    }
}

yield all (n: i32)-> dmut [i32] {
    let dmut g = rows (n);
    yield in alias g;
}

fn main () {
    let dmut g = all (3);
    for dmut x in alias g {
        x[0] = 12;
    }
}
