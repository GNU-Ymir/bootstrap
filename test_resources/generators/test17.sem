frame: test17::sum (g: (yield-> i32))-> i32 return {
    let mut s: mut i32 = 0;
    {
        let #_iter: (yield-> i32) = g;
        let mut #_yielded: mut i32;
        while (#_iter).next(#_yielded) {
            let x: i32 = #_yielded;
            {
                s = (s + (x * 2));
                <unit-value>
            }
        }
    };
    s
}
frame: test17::main ()-> void {
    let _: i32 = test17::sum (test17::count (4));
    <unit-value>
