// a loop over a map yielding leaves its iterator to the GC, a yield leaving the loop without ending it
yield pairs (m: [i32 => i32])-> i32 {
    for k, v in m {
        yield k + v;
    }
}

fn sum (m: [i32 => i32])-> i32 {
    let mut s = 0;
    for _, v in m {
        s += v;
    }
    s
}

fn main () {
    let m = copy [1 => 2];
    for _ in pairs (m) {}
    let _ = sum (m);
}
