// a generator yielding a tuple of a record
record Point {
    pub let x: i32;
    pub let y: i32;

    pub self (x: i32, y: i32) with x = x, y = y {}
}

yield points (n: i32)-> (i32, Point) {
    for i in 0 .. n {
        let p = Point (i, i * i);
        yield (i, p);
    }
}

fn main () {
    for t in points (3) {
        let (i, p) = t;
        let _ = i + p.x + p.y;
    }
}
