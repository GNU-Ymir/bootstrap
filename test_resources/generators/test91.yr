// a generator method of a record, whose frame holds a copy of self
record R {
    pub let n: i32;

    pub self (n: i32) with n = n {}

    pub yield each (self)-> i32 {
        for i in 0 .. self.n {
            yield i;
        }
    }
}

fn make ()-> (yield-> i32) {
    let r = R (3);
    r.each ()
}

fn main () {
    for i in make () { let _ = i; }
}
