// a function returning the handle of a generator, consumed by two loops
yield gen (s: [i32])-> i32 {
    for x in s {
        yield x;
    }
}

fn make ()-> (yield-> i32) {
    let arr = copy [1, 2, 3];
    return gen (arr);
}

fn main () {
    let g = make ();
    for i in g { let _ = i; break; }
    for z in g { let _ = z; break; }
}
