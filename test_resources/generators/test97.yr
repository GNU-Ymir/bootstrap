// a generator overriding a generator cannot yield an ancestor of the yielded class
class Z {
    pub self () {}
}

class U over Z {
    pub self () {}
}

@abstract
class A {
    pub self () {}

    pub yield foo (self)-> &U;
}

class B over A {
    pub self () {}

    pub over yield foo (self)-> &Z {
        yield U ();
    }
}

fn main () {
    let _ = B ();
}
