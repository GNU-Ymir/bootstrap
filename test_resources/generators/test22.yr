// a loop borrowing mutably the values of a generator, by alias
yield rows (dmut a: [i32])-> dmut [i32] {
    yield alias a;
}

fn main ()
    throws AssertError
{
    let dmut arr = copy [1, 2];
    let dmut g = rows (alias arr);
    for dmut x in alias g {
        x[0] = 12;
    }
    assert (arr[0] == 12);
}
