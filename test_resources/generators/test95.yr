// an entity cannot take the default generator of a trait, its frame would hold a movable
trait Seq {
    pub yield each (self)-> i32 {
        yield 0;
    }
}

entity E {
    pub let n: i32;

    pub self (n: i32) with n = n {}

    __dtor (mut self) {}

    impl Seq;
}

fn main () {
    let _ = E (1);
}
