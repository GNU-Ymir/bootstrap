// a variable whose address is taken stays a field of the frame, even when only the pointer is read after the yield
yield pointee (n: i32)-> i32 {
    let mut x = n * 10;
    let p = &x;
    x += 1;

    yield 0;
    yield unsafe { *p };
}

fn main ()-> i32 {
    let mut sum = 0;
    for x in pointee (3) {
        sum += x;
    }

    sum
}
