// a method returning the handle of a generator is not a generator itself
yield gen (n: i32)-> i32 {
    for i in 0 .. n {
        yield i;
    }
}

class A {
    pub self () {}

    pub fn make (self)-> (yield-> i32) {
        return gen (3);
    }
}

fn main () {
    for i in A ().make () { let _ = i; }
}
