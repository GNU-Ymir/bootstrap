// generator comprehensions over a generator, and inside a generator
yield upto (n: i32)-> i32 {
    for i in 0 .. n {
        yield i;
    }
}

yield evens (n: i32)-> i32 {
    for x in (yield y * 2 for y in upto (n)) {
        yield x;
    }
}

fn main () {
    for x in evens (3) {
        let _: i32 = x;
    }
}
