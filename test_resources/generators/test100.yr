// the inner comprehension of a generator of generators captures a local of the
// function in its element, through the outer comprehension
fn main () {
    let k = 3;
    let g = (yield (yield x + k + y for y in 0 .. x) for x in 0 .. 3);
    for inner in g {
        for y in inner {
            let _: i32 = y;
        }
    }
}
