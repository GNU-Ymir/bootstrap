// a template generator, one frame per instantiation
yield repeat {T} (value: T, times: i32)-> T {
    for _ in 0 .. times {
        yield value;
    }
}

fn main ()
    throws AssertError
{
    let ints = copy [x for x in repeat (1, 3)];
    let strs = copy [s for s in repeat ("a", 2)];
    assert (ints.len == 3us && strs.len == 2us);
}
