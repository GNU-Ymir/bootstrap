frame: test4::two ()-> (yield-> [c8]) {
    yield "first"s8;
    yield "second"s8
}
frame: test4::main ()-> void {
    let lst: [[c8]] = {
            let #_iter: (yield-> [c8]) = test4::two ();
            let mut #_yielded: mut [c8];
            let mut #_value: mut [mut [c8]] = copy [<unit-value> ; 0us];
            while (#_iter).next(#_yielded) {
                let s: [c8] = #_yielded;
                #_value ~= {.len = 1us, .ptr = &([s])}
            };
            #_value
        };
    if !(lst.len == 2us) throw core::exception::assertion::AssertError::self(new, ""s8);
    <unit-value>
}
