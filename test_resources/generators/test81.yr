// a trait with a default generator method, kept by one class and overridden by the other
trait Seq {
    pub yield each (self)-> i32 {
        yield 0;
    }
}

class A {
    pub self () {}
    impl Seq;
}

class B {
    pub self () {}
    impl Seq {
        pub over yield each (self)-> i32 {
            yield 1;
            yield 2;
        }
    }
}

fn main () {
    for i in A ().each () { let _ = i; }
    for i in B ().each () { let _ = i; }
}
