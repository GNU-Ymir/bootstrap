// a lazy pipeline whose second stage takes no callback needs no explicit template argument
yield src ()-> i32 {
    for i in 0 .. 10 { yield i; }
}

yield filter {U} (g: yield-> U, f: dg (U)-> bool)-> U {
    for x in g {
        if f (x) { yield x; }
    }
}

yield take {U} (g: yield-> U, n: usize)-> U {
    let mut k = 0us;
    for x in g {
        if k >= n { return; }
        yield x;
        k += 1us;
    }
}

fn main ()
    throws AssertError
{
    let r = copy [x for x in src ().filter (|x: i32| => x % 2 == 0).take (2us)];
    assert (r == [0, 2]);
}
