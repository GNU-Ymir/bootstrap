// a filtered comprehension over a generator, into a slice and into a map
yield count (n: i32)-> i32 {
    for i in 0 .. n { yield i; }
}

fn main ()
    throws AssertError
{
    assert (copy [x for x in count (5) if x != 2] == [0, 1, 3, 4]);

    let dmut m = copy [x => x * 2 for x in count (4) if x != 1];
    assert (m.len == 3us);
}
