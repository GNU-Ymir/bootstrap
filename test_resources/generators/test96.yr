// a generator overriding a generator can yield a subclass of the yielded class
class Z {
    pub self () {}
}

class U over Z {
    pub self () {}
}

@abstract
class A {
    pub self () {}

    pub yield foo (self)-> &Z;
}

class B over A {
    pub self () {}

    pub over yield foo (self)-> &U {
        yield U ();
    }
}

fn bar (a: &A)-> [&Z] {
    copy [x for x in a.foo ()]
}

fn main () {
    let _ = bar (B ());
}
