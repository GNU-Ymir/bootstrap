// yield in yields every value of other generators, one after the other
yield evens (a: [i32])-> i32 {
    for x in a {
        if x % 2 == 0 {
            yield x;
        }
    }
}

yield all (a: [i32], b: [i32])-> i32 {
    yield in evens (a);
    yield in evens (b);
}

fn main ()
    throws AssertError
{
    let lst = copy [x for x in all (copy [1, 2, 3, 4], copy [6, 7, 8])];
    assert (lst == [2, 4, 6, 8]);
}
