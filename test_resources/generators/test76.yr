// a generator parameter destructured by an of specialization binds both names
yield src ()-> i32 {
    yield 1;
    yield 2;
}

fn collect {T of (yield-> U), U} (g: T)-> [U] {
    copy [x for x in g]
}

fn main ()
    throws AssertError
{
    let r: [i32] = collect (src ());
    assert (r == [1, 2]);
}
