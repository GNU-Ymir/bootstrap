// the handle of a generator yielding borrowable data is moved immutably without alias
yield rows (n: i32)-> dmut [i32] {
    for i in 0 .. n {
        yield copy [i, i];
    }
}

fn main () {
    let g = rows (3);
    let h = rows (3);
    let g2 = move g;
    let g3: yield-> [i32] = move h;
    for x in g2 {
        x;
    }
    for x in g3 {
        x;
    }
}
