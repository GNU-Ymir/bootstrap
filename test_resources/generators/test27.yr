// the handle of a generator yielding borrowable data is copied immutably without alias
yield rows (n: i32)-> dmut [i32] {
    for i in 0 .. n {
        yield copy [i, i];
    }
}

fn main () {
    let dmut g = rows (3);
    let g2 = g;
    let g3: yield-> [i32] = g;
    for x in g2 {
        x;
    }
    for x in g3 {
        x;
    }
}
