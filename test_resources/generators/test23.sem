frame: test23::rows (n: i32)-> (yield-> mut [mut i32]) {
    {
        let mut #_iter: usize = 0us;
        let #_nb_iters: usize = if (0 > n) 0 else n;
        while (#_iter < #_nb_iters) {
            let mut i: i32 = 0;
            i = cast!{i32}(#_iter);
            {
                yield copy ({.len = 2us, .ptr = &([i, i])})
