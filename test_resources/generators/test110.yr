// a loop over a generator, nested in a loop, reinitializes the same frame at each iteration
yield count (n: i32)-> i32 {
    for i in 0 .. n {
        yield i;
    }
}

fn main ()-> i32 {
    let mut sum = 0;
    for j in 0 .. 3 {
        for i in count (j) {
            sum += i;
        }
    }

    sum
}
