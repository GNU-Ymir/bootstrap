// a bare return ends the generator
yield upTo (limit: i32)-> i32 {
    let mut i = 0;
    loop {
        if i == limit {
            return;
        }

        yield i;
        i += 1;
    }
}

fn main ()
    throws AssertError
{
    let mut sum = 0;
    for i in upTo (5) {
        sum += i;
    }
    assert (sum == 10);
}
