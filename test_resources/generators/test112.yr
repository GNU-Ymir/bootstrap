// only the variables read after a yield, or in a loop containing one, are fields of the frame, the others are locals of the resume function
yield steps (n: i32)-> i32 {
    let before = n * 2;
    let square = n * n;
    yield square + 1;

    let mut acc = 0;
    for i in 0 .. n {
        let sq = i * i;
        acc += sq;
        yield acc + before;
    }
}

fn main ()-> i32 {
    let mut sum = 0;
    for x in steps (3) {
        sum += x;
    }

    sum
}
