// an overriding generator yields the same type as the generator it overrides
class A {
    pub self () {}

    pub yield f (self)-> i32 {
        yield 1;
    }
}

class B over A {
    pub self () {}

    pub over yield f (self)-> i64 {
        yield 2i64;
    }
}

fn main () {
    let _ = B ();
}
