// an abstract class taking a generator method from a template trait
trait Seq {T} {
    pub yield each (self, x: T)-> T {
        yield x;
    }
}

@abstract
class A {
    pub self () {}
    impl Seq!{i32};
}

class B over A {
    pub self () {}
}

fn main () {
    for i in B ().each (1) { let _ = i; }
}
