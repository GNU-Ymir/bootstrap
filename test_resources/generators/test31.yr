// a generator consumed by hand, up to its end
yield range (i: i32, j: i32)-> i32 {
    for n in i .. j {
        yield n;
    }
}

fn sum (g: yield-> i32)-> i32 {
    let mut acc = 0;
    loop {
        match g.next () {
            Ok (x: i32) => { acc += x; }
            _ => break;
        }
    }

    acc
}

fn main ()
    throws AssertError
{
    let r = range (0, 3);
    if let Ok (z) = r.next () {
        assert (z == 0);
    }

    assert (sum (range (0, 3)) == 3);
    assert (range (0, 1).next () == 0?);
}
