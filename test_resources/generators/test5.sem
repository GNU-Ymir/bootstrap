frame: test5::main ()-> void {
    let ints: [i32] = {
            let #_iter: (yield-> i32) = test5::repeat!{i32}::repeat (1, 3);
            let mut #_yielded: mut i32;
            let mut #_value: mut [mut i32] = copy [<unit-value> ; 0us];
            while (#_iter).next(#_yielded) {
                let x: i32 = #_yielded;
                #_value ~= {.len = 1us, .ptr = &([x])}
            };
            #_value
        };
    let strs: [[c8]] = {
            let #_iter: (yield-> [c8]) = test5::repeat!{[c8]}::repeat ("a"s8, 2);
            let mut #_yielded: mut [c8];
            let mut #_value: mut [mut [c8]] = copy [<unit-value> ; 0us];
            while (#_iter).next(#_yielded) {
                let s: [c8] = #_yielded;
                #_value ~= {.len = 1us, .ptr = &([s])}
            };
            #_value
        };
    if !((ints.len == 3us) && (strs.len == 2us)) throw core::exception::assertion::AssertError::self(new, ""s8);
    <unit-value>
}
frame: [weak] test5::repeat!{[c8]}::repeat (value: [c8], times: i32)-> (yield-> [c8]) {
    {
        let mut #_iter: usize = 0us;
        let #_nb_iters: usize = if (0 > times) 0 else times;
        while (#_iter < #_nb_iters) {
            {
                yield value
            }
        } step #_iter = (#_iter + 1us)
    }
}
