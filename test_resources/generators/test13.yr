// locals of the same name in sibling blocks, and a lambda called from a loop over a generator
yield fib (n: i32)-> u64 {
    let mut a = 0u64, mut b = 1u64;
    for _ in 0 .. n {
        yield a;
        let c = a + b;
        a = b;
        b = c;
    }
}

yield evens (src: [i32])-> i32 {
    for x in src {
        if x % 2 == 0 {
            let doubled = x * 2;
            yield doubled / 2;
        } else {
            let doubled = x;
            doubled;
        }
    }
}

fn main ()
    throws AssertError
{
    let f = copy [x for x in fib (10)];
    let e = copy [x for x in evens (copy [1, 2, 3, 4])];
    let add = |x| => x + 1;
    for i in fib (3) {
        add (i);
    }
    assert (f.len == 10us && e.len == 2us);
}
