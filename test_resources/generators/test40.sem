frame: [weak] core::types::array::opEquals!{[i32], i32}::opEquals (a: [i32], b: [i32])-> bool return {
    if (a.len != b.len) {
        return false;
    };
    {
        let mut #_iter: usize = 0us;
        let #_nb_iters: usize = a.len;
        while (#_iter < #_nb_iters) {
            let mut i: usize = 0us;
            i = #_iter;
            {
                if (#{
                    if (a.len <= i) panic;
                    a [i]
                #} != #{
                    if (b.len <= i) panic;
                    b [i]
                #}) return false
            }
        } step #_iter = (#_iter + 1us)
    };
    true
}
