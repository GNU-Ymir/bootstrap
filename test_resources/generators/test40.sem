frame: test40::evens (a: [i32])-> (yield-> i32) {
    {
        let #_value: [i32] = a;
        let mut #_index: usize = 0us;
        while (#_index < #_value.len) {
            let x: i32 = #_value [#_index];
            {
                if ((x % 2) == 0) {
                    yield x
                }
            }
        } step #_index = (#_index + 1us)
    }
}
