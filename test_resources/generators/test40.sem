            let #_iter: (yield-> i32) = test40::all (copy ({.len = 4us, .ptr = &([1, 2, 3, 4])}), copy ({.len = 3us, .ptr = &([6, 7, 8])}));
            let mut #_yielded: mut i32;
            let mut #_value: mut [mut i32] = copy [<unit-value> ; 0us];
            while (#_iter).next(#_yielded) {
