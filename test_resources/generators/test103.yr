// a generator whose handle escapes its consumer allocates its own frame
yield count (n: i32)-> i32 {
    for i in 0 .. n {
        yield i;
    }
}

fn make (n: i32)-> (yield-> i32) {
    count (n)
}

fn main ()-> i32 {
    let mut sum = 0;
    let g = count (3);
    for i in g {
        sum += i;
    }

    for i in make (2) {
        sum += i;
    }

    sum
}
