// a generator looping over itself cannot embed its own frame, the recursive call allocates it
yield down (n: i32)-> i32 {
    if n > 0 {
        yield n;
        for i in down (n - 1) {
            yield i;
        }
    }
}

fn main ()-> i32 {
    let mut sum = 0;
    for i in down (3) {
        sum += i;
    }

    sum
}
