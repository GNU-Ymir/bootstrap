// yield in inside a template generator, and mixed with yields and returns
yield repeat {T} (value: T, times: i32)-> T {
    for _ in 0 .. times {
        yield value;
    }
}

yield around {T} (first: T, value: T, last: T, stop: bool)-> T {
    yield first;
    yield in repeat (value, 2);
    if stop {
        return;
    }

    yield last;
}

fn main ()
    throws AssertError
{
    let lst = copy [x for x in around (1, 2, 3, false)];
    assert (lst == [1, 2, 2, 3]);

    let stopped = copy [x for x in around ("a", "b", "c", true)];
    assert (stopped == ["a", "b", "b"]);
}
