// the values of a generator of a child class are yielded as their ancestor
class Base {
    pub self () {}
}

class Child over Base {
    pub self () with super () {}
}

yield children (n: i32)-> &Child {
    for _ in 0 .. n {
        yield copy Child ();
    }
}

yield bases (n: i32)-> &Base {
    yield copy Base ();
    yield in children (n);
}

fn main ()
    throws AssertError
{
    let lst = copy [b for b in bases (2)];
    assert (lst.len == 3us);
}
