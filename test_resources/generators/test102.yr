// a yield in over a direct call embeds the frame of the inner generator in the outer one
yield count (n: i32)-> i32 {
    for i in 0 .. n {
        yield i;
    }
}

yield twice (n: i32)-> i32 {
    yield in count (n);
    yield in count (n + 1);
}

fn main ()-> i32 {
    let mut sum = 0;
    for i in twice (2) {
        sum += i;
    }

    sum
}
