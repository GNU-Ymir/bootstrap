// a generator method of a class, iterated by a for loop
class A {
    let n: i32;

    pub self (n: i32) with n = n {}

    pub yield each (self)-> i32 {
        for i in 0 .. self.n {
            yield i;
        }
    }
}

fn sum (a: &A)-> i32 {
    let mut s = 0;
    for i in a.each () {
        s += i;
    }
    s
}

fn main () {
    let _ = sum (A (3));
}
