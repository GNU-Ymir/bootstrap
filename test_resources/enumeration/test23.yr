// An enum is taken apart by a match, which is complete once every field is
// named, so its arms may produce a value with no default arm.

enum X
| A = 1
| B = 2
| C = 3;

fn get (x : X)-> i32 {
    match x {
        X::A => { 1 }
        X::B => { 2 }
        X::C => { 3 }
    }
}

fn main () {
    get (X::A);
}
