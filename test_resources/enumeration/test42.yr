// The fields a tag appends to an enum are looked up too, at compile time and at
// run time.

tag counted (step: i32) {
    pub enum apply {enum E}
    | COUNT = cast!{i32} (E::__members__.len)
    | NEXT = COUNT + step;
}

#[counted (10)]
enum Color
| RED = 0
| GREEN = 1;

fn get (name: [c8])-> (Color)? {
    Color::__valueOf__ (name)
}

fn main () {
    let _count_ = Color::__valueOf__ ("COUNT");
    let _ = get ("NEXT");
}
