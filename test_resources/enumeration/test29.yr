// A field read out of the matched value decides the arm on that value alone,
// so it does not cover the field of the enum being matched.

enum X
| A = 1
| B = 2;

fn get (t : (X, i32))-> i32 {
    match t {
        (X::A, _) => { 1 }
        (X::B, _) => { 2 }
    }
}

fn main () {
    get ((X::A, 1));
}
