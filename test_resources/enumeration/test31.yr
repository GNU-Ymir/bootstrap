// An arm names a field whatever the type the enum proxies, the comparison of
// the values being the business of that type.

class Z {
    pub let a : i32;

    pub self (a : i32)
        with a = a
    {}

    pub fn opEquals (self, o : &Z)-> bool {
        self.a == o.a
    }
}

enum F
| A = copy Z (1)
| B = copy Z (2);

fn get (f : F)-> i32 {
    match f {
        F::A => { 1 }
        F::B => { 2 }
    }
}

fn main () {
    get (F::A);
}
