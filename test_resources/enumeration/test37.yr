// A name the compile-time interpreter reduces is folded too, and so is the
// call, usable where a compile-time value is expected.

enum Color
| RED = 0
| GREEN = 1;

def NAME = "GREEN";
def FOLDED = Color::__valueOf__ ("RE" ~ "D");

fn main () {
    let _x_ = Color::__valueOf__ (NAME);
    let _y_ = FOLDED;
    let _z_ = cte Color::__valueOf__ ("GREEN");
}
