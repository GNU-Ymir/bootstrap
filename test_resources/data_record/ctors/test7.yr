// A field borrowing mutable data is set from its parameter by an alias, the
// generated ctor does not discard the mutability it is given.
class Foo {
    pub self () {}
}

@data
record Bar {
    pub let dmut foo: &Foo;
    pub let dmut values: [i32];
}

fn main() {
    let dmut f = copy Foo ();
    let dmut v = copy [1, 2, 3];
    let b = Bar (alias f, alias v);
    b.foo; b.values;
}
