// The static typeinfo and size of a union of records are the ones of the union
// object, built at compile time: the index, the vtable, then the overlay of the
// members, sized by the biggest one.

record X {
    pub let x : i8;

    pub self () with x = 0i8 {}
}

record Y {
    pub let a : i64;
    pub let b : i64;

    pub self () with a = 0i64, b = 0i64 {}
}

union U
| X
| Y;

fn foo (u : U) {
    cte assert ((typeof u)::size == 32u32);
    cte assert (U::size == 32u32);
    let _info_ = typeof (u)::typeinfo;
    let _static_ = U::typeinfo;
}
