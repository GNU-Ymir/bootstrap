// A union declared before its members, whose first member refers back to it
// from a field and from the prototype of a method.

union C
| N
| T;

class N {
    pub let op : (&C)?;

    pub self (op : (&C)?) with op = op {}

    pub fn get (self)-> (&C)? { self.op }
}

class T {
    pub self () {}

    pub fn wrap (self)-> &C { copy N ((copy T ())?) }
}

fn foo ()-> &C {
    let t = copy T ();
    t.wrap ()
}
