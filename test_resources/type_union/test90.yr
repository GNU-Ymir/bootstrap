// A member of a union of classes holds the union, alone or in a slice: the
// union is reached through a pointer, so its members do not depend on it.

@abstract
class I {
    prot self () {}

    pub fn line (self)-> i32;
}

@final
class T over I {
    pub self () {}

    pub over line (self)-> i32 { 1 }
}

@final
class N over I {
    pub let op : &C;

    pub self (op : &C) with op = op {}

    pub over line (self)-> i32 { 2 }
}

@final
class A over I {
    pub let ops : [&C];

    pub self (ops : [&C]) with ops = ops {}

    pub over line (self)-> i32 { 3 }
}

union C over I
| T
| N
| A;

fn make ()-> &C {
    let t : &C = copy T ();
    let a : &C = copy A (copy [t, t]);
    copy N (a)
}

fn foo ()-> usize {
    match make () {
        n : &N => {
            match n.op {
                a : &A => return a.ops.len;
                _ => {}
            }
        }
        _ => {}
    }

    0us
}
