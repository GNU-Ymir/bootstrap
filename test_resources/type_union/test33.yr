// A union declaring a base dispatches through the vtable the member carries,
// so a member overriding a method of the base dispatches its own.

class Base {
    pub self () {}
    pub fn foo (self)-> i32 { 0 }
}

class A over Base {
    pub self () {}
    pub over foo (self)-> i32 { 1 }
}

class B over Base {
    pub self () {}
}

union U over Base
| A
| B;

fn take (u : &U)-> i32 {
    u.foo ()
}

fn main ()-> i32 {
    take (A ())
}
