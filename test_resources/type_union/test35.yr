// A union of classes that is deeply mutable borrows the member it is made to
// hold, which is therefore aliased explicitly.

class A {
    pub self () {}
}

class B {
    pub self () {}
}

union U
| A
| B;

fn take (dmut u : &U) {
    u;
}

fn main () {
    let dmut a = A ();
    take (alias a);
}
