// A union declaring a base implements the traits of that base.

trait Show {
    pub fn show (self)-> i32;
}

class Base {
    pub self () {}
    impl Show {
        pub over show (self)-> i32 { 0 }
    }
}

class A over Base {
    pub self () {}
    impl Show {
        pub over show (self)-> i32 { 1 }
    }
}

class B over Base {
    pub self () {}
}

union U over Base
| A
| B;

fn foo {T impl Show} (a : T)-> i32 {
    a.show ()
}

fn bar (u : &U)-> i32 {
    foo (u)
}
