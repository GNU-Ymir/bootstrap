// A member widens into a union on assignment, whichever kind of member the
// union lists.

record RA {
    pub let a : i32;

    pub self (a : i32)
        with a = a
    {}
}

record RB {
    pub let b : i32;

    pub self (b : i32)
        with b = b
    {}
}

union R
| RA
| RB;

class CA {
    pub self () {}
}

class CB {
    pub self () {}
}

union C
| CA
| CB;

fn main () {
    let mut r : R = RA (1);
    r = RB (2);
    r;

    let mut c : &C = CA ();
    c = CB ();
    c;
}
