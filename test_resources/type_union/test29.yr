// Each method the members share gets a slot of its own, whatever the order
// they declare them in; a method only one member declares gets none.

class A {
    pub self () {}
    pub fn alone (self)-> i32 { 0 }
    pub fn foo (self)-> i32 { 1 }
    pub fn bar (self)-> i32 { 2 }
}

class B {
    pub self () {}
    pub fn bar (self)-> i32 { 20 }
    pub fn foo (self)-> i32 { 10 }
}

union U
| A
| B;

fn callFoo (u : &U)-> i32 {
    u.foo ()
}

fn callBar (u : &U)-> i32 {
    u.bar ()
}
