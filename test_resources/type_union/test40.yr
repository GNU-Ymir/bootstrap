// A member is matched exactly: a subclass of a member is not widened in, the
// table the union dispatches through binding the implementation the member
// declares.

class A {
    pub self () {}
}

class B {
    pub self () {}
}

class C over A {
    pub self () {}
}

union U
| A
| B;

fn take (u : &U) {
    u;
}

fn main () {
    take (C ());
}
