// The typeid of a union of records is the name of the member it holds, read
// out of the typeinfo the vtable of the union carries.

record X {
    pub self () {}
}

record Y {
    pub let y : i32;

    pub self (y : i32)
        with y = y
    {}
}

union U
| X
| Y;

fn make ()-> U {
    Y (1)
}

fn foo (u : U) {
    let _id_ : [c8] = u.__typeid;
    let _static_ : [c8] = typeof (u)::typeid;
}

fn bar () {
    let _id_ : [c8] = make ().typeid;
}
