// A template parameter declared 'union T' binds the union it is given.

record A {
    pub let a : i32;

    pub self (a : i32)
        with a = a
    {}
}

record B {
    pub let b : f64;

    pub self (b : f64)
        with b = b
    {}
}

union U
| A
| B;

fn keep {union T} (u : T)-> T {
    u
}

fn main () {
    let u : U = A (1);
    let v : U = keep (u);
    let w : U = keep!{U} (u);
    v;
    w;
}
