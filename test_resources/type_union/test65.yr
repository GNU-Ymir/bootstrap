// A union of records whose members all implement a trait implements it, and the
// trait's method is dispatched to the member held.

trait Show {
    pub fn show (self)-> i32;
}

record A {
    pub let a : i32;
    impl Show {
        pub over show (self)-> i32 { self.a }
    }
}

record B {
    impl Show {
        pub over show (self)-> i32 { 2 }
    }
}

union U
| A
| B;

fn foo {T impl Show} (a : T)-> i32 {
    a.show ()
}

fn bar (u : U)-> i32 {
    foo (u)
}
