// A specialization written 'of U!{T}' recovers the arguments the union was
// instantiated with.

record A {T} {
    pub let a : T;

    pub self (a : T)
        with a = a
    {}
}

record B {
    pub let b : f64;

    pub self (b : f64)
        with b = b
    {}
}

union U {T}
| A!{T}
| B;

fn foo {J of U!{T}, T} (u : J, t : T)-> T {
    u;
    t
}

fn main () {
    let u : U!{i32} = A!{i32} (1);
    let x : i32 = foo (u, 12);
    x;
}
