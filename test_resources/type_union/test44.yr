// A union of classes is taken apart the same way, the member being named with
// the '&' its type is written with.

class A {
    pub let a : i32;

    pub self (a : i32)
        with a = a
    {}
}

class B {
    pub let b : i32;

    pub self (b : i32)
        with b = b
    {}
}

union U
| A
| B;

fn get (u : &U)-> i32 {
    match u {
        a : &A => { a.a }
        b : &B => { b.b }
    }
}

fn main () {
    get (A (1));
}
