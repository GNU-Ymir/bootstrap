// The widening of a member into the union does not drive the deduction, which
// reads the type it is given.

record A {T} {
    pub let a : T;

    pub self (a : T)
        with a = a
    {}
}

record B {
    pub let b : f64;

    pub self (b : f64)
        with b = b
    {}
}

union U {T}
| A!{T}
| B;

fn foo {J of U!{T}, T} (u : J, t : T) {
    u;
    t;
}

fn main () {
    foo (A!{i32} (1), 12);
}
