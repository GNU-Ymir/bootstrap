// A compound field assignment on a union reads through the field method, then
// writes through the field assign method.

record A {
    let mut _i : i32 = 0;
    pub self () {}

    @field
    pub fn foo (self)-> i32 { self._i }

    @field
    pub fn foo (mut self, i : i32) { self._i = i; }
}

record B {
    let mut _i : i32 = 0;
    pub self () {}

    @field
    pub fn foo (self)-> i32 { self._i }

    @field
    pub fn foo (mut self, i : i32) { self._i = i; }
}

union U
| A
| B;

fn main () {
    let mut x : U = A ();
    x.foo = 89;
    x.foo += 1;
}
