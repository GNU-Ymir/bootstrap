// A union of records is index assigned as well.

record A {
    let mut _i : i32 = 0;
    pub self () {}
    pub fn opIndex (self, i : i32)-> i32 { self._i + i }
    pub fn opIndexAssign (mut self, i : i32, x : i32) { self._i = i + x; }
}

record B {
    let mut _i : i32 = 0;
    pub self () {}
    pub fn opIndex (self, i : i32)-> i32 { self._i - i }
    pub fn opIndexAssign (mut self, i : i32, x : i32) { self._i = i - x; }
}

union U
| A
| B;

fn main ()-> i32 {
    let mut x : U = B ();
    x [0] = 4;
    x [1]
}
