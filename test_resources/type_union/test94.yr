// A def aliases a union of classes, reached through a pointer as the union
// itself.

class I {
    pub self () {}
}

class A over I {
    pub self () {}
}

class B over I {
    pub self () {}
}

union U over I
| A
| B;

def V : U;

fn make ()-> &V {
    copy A ()
}

fn foo ()-> i32 {
    let u : &U = make ();
    match u {
        _ : &A => return 1;
        _ => {}
    }

    0
}
