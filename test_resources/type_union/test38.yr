// A union reads as the base it declares without a match, every member
// descending from it, so the conversion needs no test.

class Base {
    pub self () {}
}

class A over Base {
    pub self () {}
}

class B over Base {
    pub self () {}
}

union U over Base
| A
| B;

fn take (u : &U)-> &Base {
    u
}

fn main () {
    take (A ());
}
