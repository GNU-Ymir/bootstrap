// A member of a union of classes widens into the union, whose synthesized
// vtable the widening is the only reference to.

class A {
    pub self () {}
    pub fn foo (self)-> i32 { 1 }
}

class B {
    pub self () {}
    pub fn foo (self)-> i32 { 2 }
}

union U
| A
| B;

fn take (u : &U)-> i32 {
    u.foo ()
}

fn main ()-> i32 {
    take (A ()) + take (B ())
}
