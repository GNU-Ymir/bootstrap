// A union whose object is not mutable cannot be index assigned.

class A {
    let mut _i : i32 = 0;
    pub self () {}
    pub fn opIndexAssign (mut self, i : i32, x : i32) { self._i = i + x; }
}

class B {
    let mut _i : i32 = 0;
    pub self () {}
    pub fn opIndexAssign (mut self, i : i32, x : i32) { self._i = i - x; }
}

union U
| A
| B;

fn set (u : &U) {
    u [1] = 2;
}
