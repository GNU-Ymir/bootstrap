// The base does not convert back to the union, a base value naming no member
// of it.

class Base {
    pub self () {}
}

class A over Base {
    pub self () {}
}

class B over Base {
    pub self () {}
}

union U over Base
| A
| B;

fn take (u : &U) {
    u;
}

fn main () {
    let b : &Base = A ();
    take (b);
}
