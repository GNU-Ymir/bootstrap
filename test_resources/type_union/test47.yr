// A match leaving a member out is not complete, so its arms cannot produce a
// value, and the member no arm names is reported.

record X {
    pub let a : i32;

    pub self (a : i32)
        with a = a
    {}
}

record Y {
    pub let b : i32;

    pub self (b : i32)
        with b = b
    {}
}

union U
| X
| Y;

fn get (u : U)-> i32 {
    match u {
        x : X => { x.a }
    }
}

fn main () {
    get (X (1));
}
