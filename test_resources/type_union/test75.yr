// The index operators every member declares are callable on the union.

class A {
    let mut _i : i32 = 0;
    pub self () {}
    pub fn opIndex (self, i : i32)-> i32 { self._i + i }
    pub fn opIndexAssign (mut self, i : i32, x : i32) { self._i = i + x; }
}

class B {
    let mut _i : i32 = 0;
    pub self () {}
    pub fn opIndex (self, i : i32)-> i32 { self._i - i }
    pub fn opIndexAssign (mut self, i : i32, x : i32) { self._i = i - x; }
}

union U
| A
| B;

fn get (u : &U)-> i32 {
    u [1]
}

fn set (dmut u : &U) {
    u [1] = 2;
    u [1] += 3;
}
