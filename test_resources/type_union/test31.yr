// A member of a union of records widens into the union: as an argument, as the
// value of a variable, and as a returned value.

record A {
    pub let a : i32;

    pub self (a : i32)
        with a = a
    {}
}

record B {
    pub let b : f64;

    pub self (b : f64)
        with b = b
    {}
}

union U
| A
| B;

fn take (u : U) {
    u;
}

fn give ()-> U {
    B (2.0)
}

fn main () {
    take (A (1));
    let u : U = A (2);
    u;
}
