// A member of a union of classes is named by a call pattern without the '&',
// as its constructor is, and binds the fields it filters.

class A {
    pub let a : i32;

    pub self (a : i32)
        with a = a
    {}
}

class B {
    pub self () {}
}

union U
| A
| B;

fn main () {
    let u : &U = A (1);
    match u {
        A (a-> x : i32) => { x; }
        _ => {}
    }
}
