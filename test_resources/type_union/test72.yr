// A field assign method every member declares is reached by assigning the union.

class A {
    let mut _i : i32 = 0;
    pub self () {}

    @field
    pub fn foo (mut self, i : i32) { self._i = i; }
}

class B {
    let mut _i : i32 = 0;
    pub self () {}

    @field
    pub fn foo (mut self, i : i32) { self._i = i + 1; }
}

union U
| A
| B;

fn bar (dmut u : &U) {
    u.foo = 89;
}
