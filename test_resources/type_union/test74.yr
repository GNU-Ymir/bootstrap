// A field assign method one of the members does not declare is not reachable
// on the union.

class A {
    let mut _i : i32 = 0;
    pub self () {}

    @field
    pub fn foo (mut self, i : i32) { self._i = i; }
}

class B {
    pub self () {}
}

union U
| A
| B;

fn bar (dmut u : &U) {
    u.foo = 89;
}
