// A member of a union of records holds a slice of the union, the union being
// validated before its members.

union C
| L
| R;

fn make ()-> C {
    let a : C = L (1);
    let b : C = L (2);
    R (copy [a, b])
}

record L {
    pub let v : i32;

    pub self (v : i32) with v = v {}
}

record R {
    pub let ops : [C];

    pub self (ops : [C]) with ops = ops {}
}
