// A member named by a call pattern filtering nothing decides the arm on its
// own, so it covers that member as a declaration naming it does.

record X {
    pub let a : i32;

    pub self (a : i32)
        with a = a
    {}
}

record Y {
    pub self () {}
}

union U
| X
| Y;

fn get (u : U)-> i32 {
    match u {
        X () => { 1 }
        Y () => { 2 }
    }
}

fn main () {
    get (X (1));
}
