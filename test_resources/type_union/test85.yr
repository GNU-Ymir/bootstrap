// The typeid and the typeinfo of a union of classes are the ones of the
// runtime class of the object it holds, with or without a base; its static
// typeid is the name of the union.

class A {
    pub self () {}
}

class B over A {
    pub self () {}
}

class C over A {
    pub self () {}
}

union U
| B
| C;

union V over A
| B
| C;

fn foo (u : &U) {
    let _id_ : [c8] = u.__typeid;
    let _name_ : [c8] = u.typeinfo.name;
    let _static_ : [c8] = typeof (u)::typeid;
}

fn bar (v : &V) {
    let _id_ : [c8] = v.typeid;
    let _info_ = v.__typeinfo__;
}
