// A call pattern filtering a field decides the arm too, so it does not cover
// the member it names.

record X {
    pub let a : i32;

    pub self (a : i32)
        with a = a
    {}
}

record Y {
    pub self () {}
}

union U
| X
| Y;

fn get (u : U)-> i32 {
    match u {
        X (a-> 1) => { 1 }
        Y () => { 2 }
    }
}

fn main () {
    get (X (1));
}
