// A union declaring a base compares through the operators of that base, so a
// member overriding one of them dispatches its own.

class Base {
    pub self () {}
    pub fn opEquals (self, o : i32)-> bool { o == 0 }
}

class A over Base {
    pub self () {}
    pub over opEquals (self, o : i32)-> bool { o == 1 }
}

class B over Base {
    pub self () {}
}

union U over Base
| A
| B;

fn eq (u : &U)-> bool {
    u == 1
}

fn main () {
    eq (A ());
}
