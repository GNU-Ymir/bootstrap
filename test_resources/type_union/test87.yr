// The typeinfo of a union of records is the one of the member it holds, read
// out of the first slot of its vtable, which shifts the slots of its methods.

record X {
    pub self () {}

    pub fn size (self)-> i32 {
        1
    }
}

record Y {
    pub self () {}

    pub fn size (self)-> i32 {
        2
    }
}

union U
| X
| Y;

fn foo (u : U) {
    let _info_ = u.__typeinfo;
    let _name_ : [c8] = u.typeinfo.name;
    let _size_ : i32 = u.size ();
}
