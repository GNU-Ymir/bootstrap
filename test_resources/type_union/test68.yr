// A trait implemented by every member with the same arguments solves the
// template parameters of an explicit specialization.

trait R {I} {}

record A {
    impl R!i32;
}

record B {
    impl R!i32;
}

union U
| A
| B;

fn foo {T impl X!{I}, X, I} ()-> I {
    0
}

fn bar ()-> i32 {
    foo!{U} ()
}
