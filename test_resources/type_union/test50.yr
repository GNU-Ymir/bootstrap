// A deeply mutable union binds the member it holds mutably, the member living
// inside the union object.

record X {
    pub let mut a : i32;

    pub self (a : i32)
        with a = a
    {}
}

record Y {
    pub self () {}
}

union U
| X
| Y;

fn main () {
    let dmut u : U = X (1);
    match ref u {
        ref mut x : X => { x.a = 2; }
        y : Y => { y; }
    }
}
