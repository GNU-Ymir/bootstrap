// The arguments of a dispatched call are evaluated before its vtable slot is
// read, as they are for a class.

record A {
    pub let a : i32;
    pub fn add (self, x : i32)-> i32 { self.a + x }
}

record B {
    pub let b : i32;
    pub fn add (self, x : i32)-> i32 { self.b + x }
}

union U
| A
| B;

fn side (k : i32)-> i32 { k + 1 }

fn bar (u : U, k : i32)-> i32 {
    u.add (side (k))
}
