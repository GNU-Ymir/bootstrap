// An arm naming the base a union declares matches whichever member is held, so
// it completes the match on its own.

class Base {
    pub self () {}
}

class A over Base {
    pub self () {}
}

class B over Base {
    pub self () {}
}

union U over Base
| A
| B;

fn main () {
    let u : &U = A ();
    match u {
        b : &Base => { b; }
    }
}
