// A union of records is taken apart by a match, which is complete once every
// member is named, so its arms may produce a value with no default arm.

record X {
    pub let a : i32;

    pub self (a : i32)
        with a = a
    {}
}

record Y {
    pub let b : i32;

    pub self (b : i32)
        with b = b
    {}
}

union U
| X
| Y;

fn get (u : U)-> i32 {
    match u {
        x : X => { x.a }
        y : Y => { y.b }
    }
}

fn main () {
    get (X (1));
}
