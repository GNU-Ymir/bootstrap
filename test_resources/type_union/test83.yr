// A match over a union must be complete even when its arms produce nothing, so
// the member no arm names is reported.

record X {
    pub let a : i32;

    pub self (a : i32)
        with a = a
    {}
}

record Y {
    pub let b : i32;

    pub self (b : i32)
        with b = b
    {}
}

union U
| X
| Y;

fn run (u : U) {
    match u {
        _ : X => {}
    }
}

fn main () {
    run (X (1));
}
