// A specialization over a union is more precise than an unconstrained one, so
// it is the one selected.

record A {T} {
    pub let a : T;

    pub self (a : T)
        with a = a
    {}
}

record B {
    pub let b : f64;

    pub self (b : f64)
        with b = b
    {}
}

union U {T}
| A!{T}
| B;

fn foo {J of U!{T}, T} (u : J)-> i32 {
    u;
    0
}

fn foo {J} (u : J)-> f64 {
    u;
    0.0
}

fn main () {
    let u : U!{i32} = A!{i32} (1);
    let x : i32 = foo (u);
    x;
}
