frame: test30::A::add (ref self: test30::A, x: i32)-> i32 return (self.a + x)
frame: test30::B::add (ref self: test30::B, x: i32)-> i32 return (self.b + x)
frame: test30::bar (u: test30::U, k: i32)-> i32 return {
    test30::U::add(u, test30::side (k))
}
frame: test30::side (k: i32)-> i32 return (k + 1)
