// The T recovered from the union is the one the specialization binds, so a
// second argument of another type has no candidate.

record A {T} {
    pub let a : T;

    pub self (a : T)
        with a = a
    {}
}

record B {
    pub let b : f64;

    pub self (b : f64)
        with b = b
    {}
}

union U {T}
| A!{T}
| B;

fn foo {J of U!{T}, T} (u : J, t : T) {
    u;
    t;
}

fn main () {
    let u : U!{i32} = A!{i32} (1);
    foo (u, 1.0);
}
