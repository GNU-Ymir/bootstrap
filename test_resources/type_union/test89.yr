// The static typeinfo of a union of classes is the one of a pointer to the
// union object, as for a class; the union object lists its members.

class A {
    pub self () {}
}

class B over A {
    pub self () {}
}

class C over A {
    pub self () {}
}

union U over A
| B
| C;

fn foo (u : &U) {
    cte assert ((typeof u)::size == 8u32);
    cte assert (U::size == 24u32);
    let _info_ = typeof (u)::typeinfo;
    let _static_ = U::typeinfo;
}
