// A match over a union naming every member is complete, whatever its arms
// produce.

record X {
    pub let a : i32;

    pub self (a : i32)
        with a = a
    {}
}

record Y {
    pub let b : i32;

    pub self (b : i32)
        with b = b
    {}
}

union U
| X
| Y;

fn run (u : U) {
    match u {
        _ : X => {}
        _ : Y => {}
    }
}

fn main () {
    run (X (1));
}
