// A union of classes without a base implements the traits all its members
// implement, a default method of the trait included.

trait Show {
    pub fn show (self)-> i32 { 3 }
}

class A {
    pub self () {}
    impl Show;
}

class B {
    pub self () {}
    impl Show {
        pub over show (self)-> i32 { 2 }
    }
}

union U
| A
| B;

fn foo {T impl Show} (a : T)-> i32 {
    a.show ()
}

fn bar (u : &U)-> i32 {
    foo (u)
}
