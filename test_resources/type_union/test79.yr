// The comparison operators every member declares are callable on the union,
// whichever side of the operator it stands.

class A {
    pub self () {}
    pub fn opEquals (self, o : i32)-> bool { o == 1 }
    pub fn opCmp (self, o : i32)-> i32 { 1 - o }
}

class B {
    pub self () {}
    pub fn opEquals (self, o : i32)-> bool { o == 2 }
    pub fn opCmp (self, o : i32)-> i32 { 2 - o }
}

union U
| A
| B;

fn eq (u : &U)-> bool {
    u == 1 && u != 2 && 3 != u
}

fn cmp (u : &U)-> bool {
    u < 1 && 2 >= u
}
