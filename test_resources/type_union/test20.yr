// A mutable method of a union is called through the class alias operator.

class A {
    let mut _i : i32 = 0;
    pub self () {}
    pub fn foo (mut self, i : i32) { self._i = i; }
}

class B {
    let mut _i : i32 = 0;
    pub self () {}
    pub fn foo (mut self, i : i32) { self._i = i; }
}

union U
| A
| B;

fn bar (dmut u : &U) {
    u:.foo (12);
}
