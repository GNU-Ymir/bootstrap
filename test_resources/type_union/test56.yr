// A union declared with a template parameter list instantiates like any other
// symbol, its members rewritten under the mapper.

record A {T} {
    pub let a : T;

    pub self (a : T)
        with a = a
    {}
}

record B {
    pub let b : f64;

    pub self (b : f64)
        with b = b
    {}
}

union U {T}
| A!{T}
| B;

fn take {T} (u : U!{T}) {
    u;
}

fn main () {
    let u : U!{i32} = A!{i32} (1);
    take (u);
    take (A!{i32} (1));
}
