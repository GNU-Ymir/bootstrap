// An arm whose guard decides whether it is taken does not cover the member it
// names.

record X {
    pub let a : i32;

    pub self (a : i32)
        with a = a
    {}
}

record Y {
    pub let b : i32;

    pub self (b : i32)
        with b = b
    {}
}

union U
| X
| Y;

fn get (u : U)-> i32 {
    match u {
        x : X if x.a > 0 => { x.a }
        y : Y => { y.b }
    }
}

fn main () {
    get (X (1));
}
