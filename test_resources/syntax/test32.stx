in test32;
tag ren {N: usize} (names: [[c8] ; N]) {
    pub template self {class C} {
        self ()
        {
        }

    }
}

tag if N > 0us sized {T, N: usize = 1us} (values: [T ; N], scale: T = T::init) {
    template apply {class C} {
        class apply {
        }

    }
}

tag plain () {
    template apply {class C} {
        class apply {
        }

    }
}

tag noargs {T} () {
    template self {class C} {
        self ()
        {
        }

    }
}

#[ren (["a", "b"]), sized!{i32} ([1]), noargs!{i32}, plain]
class A {
}

fn main () {
}

