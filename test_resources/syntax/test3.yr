/**
 * Memory transformation expressions: copy, dcopy, alias, ref, move and expand.
 * */

class Foo {
    pub let mut a: i32 = 0;

    pub self () {}
}

entity Owned {
    let own: i32 = 0;

    pub self (i: i32)
        with own = i
    {}

    __dtor (mut self) {}
}

fn byRef (ref dmut x: [i32]) {
    x [0] = 12;
}

fn two (_a_: i32, _b_: i32) {}

fn tup ()-> (i32, i32) {
    (1, 2)
}

fn take (mut _o_: Owned) {}

fn main () {
    let dmut _cpy_ = copy Foo ();
    let dmut _dcp_ = dcopy [[1, 2], [3, 4]];

    let dmut f = copy Foo ();
    let dmut _als_ = alias f;

    let dmut arr = copy [1, 2, 3];
    byRef (ref arr);

    two (expand tup ());

    let mut o = Owned (1);
    take (move o);
}
