/**
 * The content of a for loop: a block, an `if` or `if let` filter guarding a
 * block, a nested loop, itself filtered or not, and a `match`, in a run-time
 * and in a `cte` loop.
 * */

in test24;

fn main () {
    let mut sum = 0;
    for i in 0 .. 4 {
        sum += i;
    }

    for i in 0 .. 4 if i % 2 == 0 {
        sum += i;
    }

    for i in [0, 1, 2] if let 1 = i {
        sum += i;
    }

    let m = copy [1 => 10, 2 => 20];
    for i in 0 .. 4 if let Ok(v) = m[i] && v > sum {
        sum += v;
    }

    for i in 0 .. 4 for j in 0 .. 4 {
        sum += i * j;
    }

    for i in 0 .. 4 for j in 0 .. 4 if i != j {
        sum += i - j;
    }

    for i in 0 .. 4 match i {
        0 => { sum += 1; }
        _ => { sum -= i; }
    }

    for i in 0 .. 4 for j in 0 .. 4 match (i, j) {
        (0, 0) => { sum += 1; }
        _ => { sum += i * j; }
    }

    cte for i in (1, 2, 3) if i != sum {
        sum += i;
    }

    let _s_ = sum;
}
