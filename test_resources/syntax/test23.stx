trait Seq {
    pub yield each (self)-> i32;

}

class A {
    pub self ()
    {
    }
    pub yield gen (self)-> i32 {
        yield 1
    }
    impl Seq {
        pub over yield each (self)-> i32 {
            yield 2
        }
    }

}

class B over A {
    pub self ()
    {
    }
    pub over yield gen (self)-> i32 {
        yield 3
    }
}

