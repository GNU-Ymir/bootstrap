/**
 * Literal expressions, one of each kind the lexer can produce.
 * */

class A {
    pub self () {}
}

fn main () {
    let _dec_ = 12;
    let _suf_ = 12u32;
    let _chr_ = 'a';
    let _chs_ = 'a'c8;
    let _flt_ = 1.5;
    let _fsu_ = 1.5f;
    let _fex_ = 1.5e+10;
    let _fem_ = 1.5e-10;
    let _str_ = "hello";
    let _sts_ = "hello"s8;
    let _tru_ = true;
    let _fls_ = false;
    let _non_ : (i32)? = none;
    let _nul_ : *void = null;
    let _ver_ = __version!LINUX;

    let arr = [1, 2, 3];
    let _dol_ = arr [$ - 1us];
}
