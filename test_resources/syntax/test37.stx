in test37;
fn a (p: *(u64))-> u64 {
    let mut s = 0u64;
    for i in 0u64 .. unsafe{
                *(p)
            } {
        s += i;
    };
    s
}

fn b (p: *(u64))-> u64 {
    let mut s = 0u64;
    for i in unsafe{
                *(p)
            } .. 10u64 {
        s += i;
    };
    s
}

