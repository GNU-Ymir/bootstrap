in test35;
tag slot (signal: [c8]) {
}

tag skip () {
}

class Door {
    let opened : bool = false;
    pub self ()
    {
    }
    pub #[slot ("open")]
    fn open (mut self) {
        self.opened = true;
    }
    pub #[skip, slot ("close")]
    @{final}
    fn close (mut self) {
        self.opened = false;
    }
    pub {
        #[slot ("toggle"), skip]
        fn toggle (mut self) {
            self.opened = !(self.opened);
        }
        fn isOpen (self)-> bool {
            self.opened
        }
    }
    cte if true{
        prv #[skip]
        fn hidden (self) {
        }
    }
    else{
        prv {
        }
    }
    pub #[slot ("set")]
    template set {T} {
        fn set (mut self, value: T) {
            self.opened = cast !{bool}(value);
        }

    }
    pub #[skip]
    yield values (self)-> i32 {
        yield 1
    }
    pub #[skip]
    async later (self)-> i32 {
        2
    }
}

class SubDoor over Door {
    pub self ()
        with super() {
    }
    pub #[slot ("open")]
    over open (mut self) {
    }
}

record Lamp {
    pub #[slot ("on")]
    fn on (self) {
    }
}

entity Switch {
    pub #[skip]
    fn press (self) {
    }
}

