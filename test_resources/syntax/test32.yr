/**
 * Tag declarations with template parameters, a template test, and a body that
 * opens with `{` as the template parameters do; and tag sites giving template
 * arguments explicitly, called or not.
 * */

in test32;

tag ren {N: usize} (names: [[c8] ; N]) {
    pub self {class C} () {}
}

tag if (N > 0us) sized {T, N: usize = 1us} (values: [T ; N], scale: T = T::init) {
    class apply {class C} {}
}

tag plain {
    class apply {class C} {}
}

tag noargs {T} () {
    self {class C} () {}
}

#[ren (["a", "b"]), sized!{i32} ([1]), noargs!{i32}, plain]
class A {}

fn main () {}
