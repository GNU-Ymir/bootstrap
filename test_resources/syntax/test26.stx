in test26;
lazy ENDPOINTS : [[c8] => fn ()-> i32] = copy [];

tag truc (param: [c8], times: i32 = 1) {
    lazy COUNT : i32 = 0;
    pub template apply {F: fn (_: T)-> i32, T...} {
        fn apply (x: i32, other: T)-> i32 {
            F (expand other) + x * times
        }

    }
    pub template apply {class C} {
        class apply {
            pub fn route (self)-> [c8] {
                param
            }
        }

    }
    pub template apply {enum E} {
        enum apply
        | EXTRA = 0
        ;

    }
    pub template apply {union U} {
        union apply
        | f64
        ;

    }
    pub template self {F: fn ()-> i32} {
        self ()
        {
            ENDPOINTS [param] = F;
        }

    }
    pub {
        self ()
            throws&(AssertError)
        {
            COUNT += 1;
        }
        template apply {F: fn ()-> i32} {
            yield apply ()-> i32 {
                yield F ()
            }

        }
    }
    prv template apply {record R} {
        record apply {
        }

    }
    prv template apply {F: fn ()-> i64} {
        @{inline}
        fn apply ()-> i64 {
            F ()
        }

    }
}

pub tag registered () {
    template self {F} {
        self ()
        {
        }

    }
}

fn main () {
}

