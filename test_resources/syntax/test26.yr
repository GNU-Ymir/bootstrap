/**
 * Tag declarations: the parameters, given or not, and a body holding globals,
 * `apply` overloads of each kind they can tag, and `self` overloads, protected
 * one by one or by a block. The overloads are only validated once instantiated
 * for a tag site, but for the `self` overload declaring throwers, refused as
 * run at program start -- the point of the case is the syntax tree they produce.
 * */

in test26;

lazy dmut ENDPOINTS: [[c8] => fn ()-> i32] = copy [];

tag truc (param: [c8], times: i32 = 1) {
    lazy mut COUNT: i32 = 0;

    pub fn apply {F: fn (T)-> i32, T...} (x: i32, other: T)-> i32 {
        F (expand other) + x * times
    }

    pub class apply {class C} {
        pub fn route (self)-> [c8] {
            param
        }
    }

    pub enum apply {enum E}
    | EXTRA = 0;

    pub union apply {union U}
    | f64;

    pub self {F: fn ()-> i32} () {
        ENDPOINTS [param] = F;
    }

    pub {
        self () throws &AssertError {
            COUNT += 1;
        }

        yield apply {F: fn ()-> i32} ()-> i32 {
            yield F ();
        }

        async apply {F: fn ()-> f32} ()-> f32 {
            await;
            F ()
        }
    }

    pub async apply {F: fn ()-> async-> R, R} ()-> R {
        await F ()
    }

    prv record apply {record R} {}

    @inline
    prv fn apply {F: fn ()-> i64} ()-> i64 { F () }
}

/**
 * A tag without parameters
 * */
pub tag registered {
    self {F} () {}
}

fn main () {}
