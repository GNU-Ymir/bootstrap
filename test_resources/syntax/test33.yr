/**
 * A `fn` template parameter, receiving a function whatever its signature, next
 * to a function pointer type starting with `fn` in a template parameter list,
 * and to a template parameter constrained by a signature.
 * */

in test33;

tag t {
    pub fn apply {fn F} ()-> __pragma!return_type (F) { F () }
}

fn call {fn F, G: fn (i32)-> i32} (x: i32)-> i32 { G (F (x)) }

fn spec {T of fn (i32)-> i32} (f: T)-> i32 { f (1) }

fn pattern {fn (i32)-> i32} ()-> i32 { 1 }

fn main () {}
