/**
 * Compose expressions: lambdas, array/tuple/map literals, list comprehensions,
 * slices, ranges and try expressions.
 * */

fn apply (f: fn (i32)-> i32, x: i32)-> i32 {
    f (x)
}

fn mayFail (i: i32)-> i32
    throws AssertError
{
    if (i < 0) throw copy AssertError ("negative");
    i
}

fn main ()
    throws AssertError
{
    let short = |x: i32| => x + 1;
    let block = |x: i32| {
        x + 2
    };
    let typed = |x: i32|-> i32 => x + 3;
    let _ap_ = apply (short, 1) + apply (block, 2) + apply (typed, 3);

    let _arr_ = [1, 2, 3];
    let _tpl_ = (1, "two", '3');
    let _one_ = (1,);
    let _map_ = copy ["a"s8 => 1, "b"s8 => 2];

    let src = [1, 2, 3, 4];
    let _lst_ = [x * 2 for x in src];
    let _tup_ = (x * 2 for x in [1, 2]);
    let _tpc_ = (x * 2 for x in [1, 2],);

    let _sli_ = src [1 .. 3];
    let _rng_ = 0 .. 10;

    let _try_ = mayFail (1)?;
    match _try_ {
        Ok (x: i32) => { assert (x == 1); }
        Err () => {}
    }
}
