in test28;
class Item {
    pub let tag : i32;
    pub self (tag: i32)
        with tag = tag
    {
    }
}

fn tag (tag: i32)-> i32 {
    tag
}

fn local ()-> i32 {
    let mut tag = 1;
    tag += 1;
    tag
}

fn main () {
    let item = copy Item (12);
    let _x_ = tag (item.tag) + local ();
}

