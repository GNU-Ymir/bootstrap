/**
 * Tags on the fields of a class, a record and an entity: before the `let` of
 * the field, before the protection of a single field, inside a protection
 * block and a conditional block, written twice, and next to attributed methods.
 * */

in test34;

tag rename (name: [c8]) {}

tag skip {}

record Foo {
    #[rename ("a-field")]
    pub let mut a_field: i32;

    #[skip] #[rename ("b")]
    let b: i32 = 1;

    pub {
        #[rename ("c"), rename ("cc")]
        let c: i32;

        let d: i32;
    }

    cte if (true) {
        #[skip]
        prv let e: i32;
    }

    @field
    pub fn get (self)-> i32 { self.a_field }
}

class Bar {
    #[skip] prot let x: i32;

    prot {
        #[rename ("y")]
        let y: i32;
    }

    @final
    pub fn getY (self)-> i32 { self.y }
}

entity Baz {
    #[skip]
    let z: i32;
}
