/**
 * The `if` filter of a comprehension, in the four forms a comprehension takes,
 * the point of the case is the syntax tree it produces.
 * */

in test22;

fn main () {
    let src = [1, 2, 3, 4];
    let _lst_ = copy [x * 2 for i, x in src if i != 0us];
    let _tup_ = (x for x in 0 .. 4 if x != 1,);
    let _mfr_ = copy [x => x * 2 for x in src if x != 3];
    let _gen_ = (yield x for x in src if x != 4);
}
