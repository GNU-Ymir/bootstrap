/**
 * An unsafe block in the test of an if and of a while written without
 * parentheses, compared and alone.
 * */

in test38;

fn a (p: *u64)-> bool {
    if unsafe { *p } == 0u64 {
        return true;
    }
    false
}

fn b (p: *bool)-> i32 {
    if unsafe { *p } { 1 } else { 0 }
}

fn c (p: *u64)-> u64 {
    let mut n = 0u64;
    while unsafe { *p } != n {
        n += 1u64;
    }
    n
}
