/**
 * Tags on the methods of a class, a record and an entity: before the `fn`,
 * `over`, `yield` or `async` of the method, before its attributes, before the
 * protection of a single method, inside a protection block and a conditional
 * block, on a template method, and written twice.
 * */

in test35;

tag slot (signal: [c8]) {}

tag skip {}

class Door {
    let mut opened: bool = false;

    pub self () {}

    #[slot ("open")]
    pub fn open (mut self) { self.opened = true; }

    #[skip] #[slot ("close")]
    @final
    pub fn close (mut self) { self.opened = false; }

    pub {
        #[slot ("toggle"), skip]
        fn toggle (mut self) { self.opened = !self.opened; }

        fn isOpen (self)-> bool { self.opened }
    }

    cte if (true) {
        #[skip]
        prv fn hidden (self) {}
    }

    #[slot ("set")]
    pub fn set {T} (mut self, value: T) { self.opened = cast!bool (value); }

    #[skip]
    pub yield values (self)-> i32 { yield 1; }

    #[skip]
    pub async later (self)-> i32 { 2 }
}

class SubDoor over Door {
    pub self () with super () {}

    #[slot ("open")]
    pub over open (mut self) {}
}

record Lamp {
    #[slot ("on")]
    pub fn on (self) {}
}

entity Switch {
    #[skip]
    pub fn press (self) {}
}
