in test30;
trait Task {
    pub async run_ (self)-> i32;

    prv async step (self)-> i32 {
        await;
        0
    }

}

class A {
    pub self ()
    {
    }
    pub async compute (self, x: i32)-> i32 {
        await;
        x
    }
    prot async half (self)-> i32 {
        1
    }
    impl Task {
        pub over async run_ (self)-> i32 {
            await self.compute (2)
        }
    }

}

class B over A {
    pub self ()
    {
    }
    pub over async compute (self, x: i32)-> i32 {
        x + 1
    }
}

record R {
    let v : i32;
    pub self (v: i32)
        with v = v
    {
    }
    pub async get (self)-> i32 {
        self.v
    }
    prv async twice (self)-> i32 {
        self.v * 2
    }
}

