in test29;
async count (n: i32)-> i32 {
    for _ in 0 .. n {
        await;
    };
    n
}

template twice {T} {
    async twice (value: T)-> (T, T) {
        await;
        (value, value)
    }

}

async main_ ()-> i32 {
    let c = count (3);
    let x = await c;
    let _p_ = await twice (x);
    x + await count (2)
}

