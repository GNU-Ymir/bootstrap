in test8;
trait Printable {
    pub fn name (self)-> [c8];

    pub fn described (self)-> [c8] {
        self.name ()
    }

}

enum Small
| A = 0
| B = 1
;

enum Color: [c8]
| RED: [c8] = "red"
| BLUE: [c8] = "blue"
;

record Point {
    pub let x : i32;
    pub let y : i32;
    pub self (x: i32, y: i32)
        with x = x
        , y = y
    {
    }
}

@{abstract}
class Shape {
    prot self ()
    {
    }
    pub fn area (self)-> i32;
}

class Square over Shape {
    prv let side : i32;
    pub self (side: i32)
        with super()
        , side = side
    {
    }
    pub self dup (other: &(Square))
        with super()
        , side = other.side
    {
    }
    pub over area (self)-> i32 {
        self.side * self.side
    }
    impl Printable {
        pub over name (self)-> [c8] {
            "square"
        }
    }

}

class Circle over Shape {
    pub self ()
        with super() {
    }
    pub over area (self)-> i32 {
        0
    }
}

template Boxed {T} {
    class Boxed {
        pub let value : T;
        cte assert (true, "T must be usable");
        pub self (value: T)
            with value = value
        {
        }
    }

}

entity Handle {
    let id : i32 = 0;
    pub self (id: i32)
        with id = id
    {
    }
    __dtor(mut self)
    {
    }
}

fn main () {
    let s = copy Square (2);
    let _ar_ = s.area ();
    let _nm_ = s.name ();
    let _ds_ = s.described ();
    let _cp_ = copy Square::dup (s);
    let _sm_ = Small::A;
    let _cl_ = Color::RED;
    let _pt_ = Point (1, 2);
    let _bx_ = copy Boxed!{i32} (12);
    let _ci_ = copy Circle ();
    let _hd_ = Handle (1);
}

