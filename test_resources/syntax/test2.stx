mod inner{
    pub fn add (a: i32, b: i32)-> i32 {
        a + b
    }

    pub lazy CST = 42;


}

template tmpl {T} {
    fn tmpl (x: T)-> T {
        x
    }

}

fn main () {
    let a = 12;
    let b = 5;
    let _ari_ = a + b - a * b / (b % a);
    let _cmp_ = a < b || a > b && !(a == b) || a <= b != (a >= b);
    let _bit_ = a & b | (a ^ b) << 1 >> 1;
    let _neg_ = -(a);
    let _not_ = !(a == b);
    let _rng_ = 0 .. 10;
    let _irg_ = 0 ... 10;
    let _cal_ = inner::add (a -> 1, b -> 2);
    let _pth_ = inner::CST;
    let arr = [1, 2, 3];
    let _idx_ = arr [0];
    let _sli_ = arr [0 .. 2];
    let _cas_ = cast !{f64}(a);
    let _casp_ = cast !{dg (_: i32, _: i32)-> i32}(&(inner::add)) (1, 2);
    let _tpl_ = tmpl!{i32} (12);
    let _cte_ = cte 12 + 30;
    let _chk_ = template!{i32}{U of i32};
    let _prg_ = __pragma!compile({
                a + b
            });
    let _prgf_ = __pragma!field_infos((i32, i32)).len;
}

