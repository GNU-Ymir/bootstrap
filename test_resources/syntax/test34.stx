in test34;
tag rename (name: [c8]) {
}

tag skip () {
}

record Foo {
    pub #[rename ("a-field")]
    let a_field : i32;
    #[skip, rename ("b")]
    let b : i32 = 1;
    pub {
        #[rename ("c"), rename ("cc")]
        let c : i32;
        let d : i32;
    }
    cte if true{
        prv #[skip]
        let e : i32;
    }
    else{
        prv {
        }
    }
    pub @{field}
    fn get (self)-> i32 {
        self.a_field
    }
}

class Bar {
    prot #[skip]
    let x : i32;
    prot #[rename ("y")]
    let y : i32;
    pub @{final}
    fn getY (self)-> i32 {
        self.y
    }
}

entity Baz {
    #[skip]
    let z : i32;
}

