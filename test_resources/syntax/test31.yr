// The syntax tree of async lambdas, with and without parameters, a return type, a block
// or an expression body, copied, and next to the type async-> T they share their keyword with.

fn main () {
    let _a_ = async || => 1;
    let b = async |x| => x + 1;
    let c = async |x: i32, y: i32|-> i32 {
        await;
        x + y
    };
    let _d_ = copy async | | {
        await c (1, 2)
    };
    let _e_: async-> i32 = b (1);
    let _f_: dg (i32)-> (async-> i32) = async |x| => x;
}
