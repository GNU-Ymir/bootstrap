/**
 * Generator comprehensions, of a value and of a pair, beside a tuple of a
 * generator type, which is still a type.
 * */

in test21;

fn pairs (n: i32)-> (yield-> (i32, i32)) {
    (yield (i, i * 2) for i in 0 .. n)
}

fn main () {
    let squares = (yield x * x for x in 0 .. 10);
    let t: (yield-> i32, i32) = (squares, 1);
    for a, b in pairs (3) {
        let _ = a + b + t.1;
    }
}
