/**
 * Async declarations: a function and a template function introduced by `async`,
 * an `await` with a value and the `await;` giving control back, both read as
 * instructions and inside an expression.
 * */

in test29;

async count (n: i32)-> i32 {
    for _ in 0 .. n {
        await;
    }

    n
}

async twice {T} (value: T)-> (T, T) {
    await;
    (value, value)
}

async main_ ()-> i32 {
    let c = count (3);
    let x = await c;
    let _p_ = await twice (x);

    x + await count (2)
}
