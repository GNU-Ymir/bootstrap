/**
 * Concurrency expressions: spawn, future types and atomic blocks.
 * */

in test10;

class Lock {
    pub self () {}
}

fn compute (i: i32)-> i32 {
    i * 2
}

fn main ()
    throws AssertError
{
    let th: (future-> i32) = spawn compute (10);
    let _fi_ = th.finished;
    assert (th.value == 20);

    let mut shared = 0;
    let lock = copy Lock ();
    atomic lock {
        shared += 1;
    }

    assert (shared == 1);
}
