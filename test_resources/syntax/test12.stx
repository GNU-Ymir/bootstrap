in test12;
template Sized {T} {
    trait Sized {
        cte if template!{T}{U of i32}{
            pub fn size (self)-> usize {
                4us
            }
        }
        else{
            prv pub fn size (self)-> usize {
                0us
            }
        }

    }

}

template Holder {T} {
    class Holder {
        pub let value : T;
        pub self (value: T)
            with value = value
        {
        }
        cte if template!{T}{U of i32}{
            pub fn kind (self)-> i32 {
                1
            }
        }
        else{
            cte if template!{T}{U of f64}{
                pub fn kind (self)-> i32 {
                    2
                }
            }
            else{
                prv pub fn kind (self)-> i32 {
                    3
                }
            }
        }
        impl Sized!{T};
    }

}

fn main ()
    throws AssertError
{
    let i = copy Holder!{i32} (12);
    let f = copy Holder!{f64} (1.0);
    let s = copy Holder!{[c8]} ("x");
    assert (i.kind () == 1);
    assert (f.kind () == 2);
    assert (s.kind () == 3);
    assert (i.size () == 4us);
    assert (s.size () == 0us);
}

