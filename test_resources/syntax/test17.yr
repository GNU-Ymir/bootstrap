/**
 * Parameters that can only be passed by name(the `@` marker), in the three
 * prototype forms accepting one: a function, a method and a constructor,
 * alone and combined with the other parameter modifiers.
 * */

in test17;

fn freeFunc (@a: i32, b: i32)-> i32 {
    a + b
}

fn withModifiers (ref mut @a: i32, lazy @b: i32)-> i32 {
    a = a + 1;
    a + b
}

class C {
    prv let v: i32;

    pub self (@value: i32)
        with v = value
    {}

    pub fn method (self, @factor: i32)-> i32 {
        self.v * factor
    }
}

fn main () {
    let mut m = 1;
    let _a_ = freeFunc (2, a-> 1);
    let _b_ = withModifiers (a-> ref m, b-> lazy 3);
    let c = copy C (value-> 2);
    let _c_ = c.method (factor-> 3);
}
