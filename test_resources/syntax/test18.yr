/**
 * Attributes carrying arguments, and the unittest form consuming them: the
 * parenthesised attribute alone and inside a brace list, and a `__test`
 * declaring parameters, named and unnamed.
 * */

in test18;

yield params ()-> (i32, [c8]) {
    yield (3, "foo");
    yield (2, "bar");
}

@parameters (params ())
__test named (len: i32, text: [c8]) {
    assert (text.len == cast!usize (len));
}

@{parameters ((yield i for i in 1 ... 3))}
__test (value: i32) {
    assert (value > 0);
}
