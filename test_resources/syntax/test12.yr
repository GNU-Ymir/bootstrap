/**
 * Conditional declaration blocks: `cte if` inside a class body and inside a
 * trait body, with and without an else branch. The three-way chain of `Holder`
 * also pins which test each block of the chain is built with -- an `else if`
 * used to be wrapped with the *last* test of the chain rather than its own.
 * */

in test12;

trait Sized {T} {
    cte if template!{T}{U of i32} {
        pub fn size (self)-> usize {
            4us
        }
    } else {
        pub fn size (self)-> usize {
            0us
        }
    }
}

class Holder {T} {
    pub let value: T;

    pub self (value: T)
        with value = value
    {}

    cte if template!{T}{U of i32} {
        pub fn kind (self)-> i32 {
            1
        }
    } else if template!{T}{U of f64} {
        pub fn kind (self)-> i32 {
            2
        }
    } else {
        pub fn kind (self)-> i32 {
            3
        }
    }

    impl Sized!{T};
}

fn main ()
    throws AssertError
{
    let i = copy Holder!{i32} (12);
    let f = copy Holder!{f64} (1.0);
    let s = copy Holder!{[c8]} ("x");

    assert (i.kind () == 1);
    assert (f.kind () == 2);
    assert (s.kind () == 3);
    assert (i.size () == 4us);
    assert (s.size () == 0us);
}
