/**
 * Generators and asynchronous types: `await`, `async-> T`, `yield-> T` and the
 * `yield` instruction, with and without a value. Those parse, but the validator
 * does not implement them yet -- the point of the case is the syntax tree they
 * produce.
 *
 * `yield 1; yield;` is also what makes the block accept two instructions that
 * read their own ';' in a row(cf. SyntaxVisitor::needClosingExpr) -- unlike the
 * other such instructions, a `yield` does not end the scope, so the statement
 * that follows it is reachable.
 * */

in test15;

fn compute (i: i32)-> i32 {
    i * 2
}

fn generator ()-> i32 {
    yield 1;
    yield;

    2
}

fn main () {
    let th = spawn compute (10);
    let _aw_ = await th;
    let _yt_: yield-> i32 = 12;
    let _at_: async-> i32 = 12;
}
