in test19;
yield range (n: i32)-> i32 {
    for i in 0 .. n {
        yield i
    }
}

template repeat {T} {
    yield repeat (value: T, times: i32)-> T {
        for _ in 0 .. times {
            yield value
        }
    }

}

fn main () {
    let g: yield-> (i32) = range (3);
    for i in g {
        let _ = i;
    };
    let _lst_ = copy [ x for x in repeat (1, 2)];
}

