/**
 * Companion modules, of a class and of a template class, template or not.
 * */

in test25;

class X {
    prv let _x: i32 = 0;

    pub self () {}
}

@companion
mod X {
    pub fn get (x: &X)-> i32 {
        x._x
    }
}

class Y {T} {
    prv let _y: T;

    pub self (y: T)
        with _y = y
    {}
}

@companion
mod Y {
    pub fn get {T} (y: &Y!{T})-> T {
        y._y
    }
}

class Z {T} {
    prv let _z: T;

    pub self (z: T)
        with _z = z
    {}
}

@companion
mod Z {U} {
    pub fn get (z: &Z!U)-> U {
        z._z
    }
}

fn main () {
    let _ : i32 = X::get (copy X ());
    let _ : i32 = Y::get (copy Y!{i32} (1));
    let _ : i32 = Z!{i32}::get (copy Z!{i32} (1));
}
