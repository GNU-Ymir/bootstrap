/**
 * Tag lists before declarations: every bracket form, a list of several tags and
 * several lists, paths and named arguments, a list written on several lines,
 * before the protection and the attributes, and before each kind of
 * declaration of a module. Most of them cannot take a tag, the first refusing
 * it stops the compilation -- the point of the case is the syntax tree.
 * */

in test27;

#[a]
fn bracket ()-> i32 { 1 }

#(a)
fn parenthesis ()-> i32 { 2 }

#{a}
fn brace ()-> i32 { 3 }

#[a ("x"), b]
#[web::route (path-> "/f", 12)]
fn stacked ()-> i32 { 4 }

/**
 * A doc comment written before the tags
 * */
#[
    web::route ("/multi"),
    b
]
@inline
pub fn protected ()-> i32 { 5 }

#[a]
class Bar {
    pub fn handle (self)-> i32 { 1 }
}

#[a]
record Baz {T} {}

#[a]
enum Color
| RED = 0
| GREEN = 1;

#[a]
union Value
| i32
| f64;

#[a]
static mut GLOB: i32 = 0;

#[a]
def Alias: i32;

#[a]
fn generic {T} (x: T)-> T { x }

pub {
    #[a]
    fn inBlock () {}
}

mod Local {
    #[a]
    fn inModule () {}
}

#[a]
extern (C) fn puts (s: &c8)-> i32;

extern (C) {
    #[a]
    fn putchar (c: i32)-> i32;
}

#[a]
tag tagged {}

fn main () {}
