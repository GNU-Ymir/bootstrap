/**
 * Module level declarations: named module, submodule, imports, aliases,
 * globals, extern blocks and unit tests.
 * */

in test7;

use std::io;

mod .sub7;

mod sub {
    pub lazy INNER = 12;

    pub fn nested ()-> i32 {
        INNER
    }
}

def Alias: i32;
def VALUE = 42;

lazy LAZY_GLOBAL = 12;

extern (C) {
    static STATIC_GLOBAL: i32;

    fn abs (x: i32)-> i32;
}

fn proto (x: i32)-> i32;

fn templated {T} (x: T)-> T {
    x
}

__test {
    let v = sub::nested ();
    assert (v == 12);
}

fn main () {
    let _a_: Alias = VALUE;
    let _b_ = sub::nested () + sub7::helper () + LAZY_GLOBAL + STATIC_GLOBAL;
    let _c_ = templated!{i32} (1);
}
