/**
 * Instruction expressions: variable and pattern declarations, assert, break,
 * continue, return, throw and panic.
 * */

fn early (i: i32)-> i32 {
    if (i < 0) {
        return 0;
    }

    return i;
}

fn noValue () {
    return;
}

fn thrower ()
    throws AssertError
{
    throw copy AssertError ("boom");
}

fn panicker ()-> i32 {
    panic;
}

fn withMsg ()-> i32 {
    panic "unreachable"s8;
}

fn main ()
    throws AssertError
{
    let simple = 12;
    let mut mutable = 12;
    let typed: i64 = 12i64;
    let dmut deep = copy [1, 2, 3];
    let (a, b) = (1, 2);
    let (c, (d, e)) = (1, (2, 3));

    mutable += a + b + c + d + e + simple + cast!{i32} (typed) + deep [0];

    let mut i = 0;
    loop {
        i += 1;
        if (i % 2 == 0) continue;
        if (i > 10) break {};
    }

    assert (i > 0);
    assert (i > 0, "i must be positive");

    noValue ();
    let _r_ = early (mutable);

    {
        thrower ();
    } catch {
        _: &AssertError => {}
    }

    let _p_ = panicker ();
    let _m_ = withMsg ();
}
