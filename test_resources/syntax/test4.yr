/**
 * Control structures: conditionals, loops, pattern matching and the block
 * flavours(unsafe, atomic, lazy, scope guards).
 * */

in test4;

class Base {
    pub self () {}
}

class Derived over Base {
    pub let v: i32 = 0;

    pub self (v: i32)
        with v = v
    {}
}

class Lock {
    pub self () {}
}

fn opt (i: i32)-> (i32)? {
    if (i > 0) {
        i?
    } else {
        none
    }
}

fn mayFail (i: i32)-> i32
    throws AssertError
{
    if (i < 0) throw copy AssertError ("negative");

    i
}

fn lazily (lazy x: i32)-> i32 {
    x
}

fn onExit ();
fn onSucc ();
fn onFail ();

fn main () {
    let mut i = 0;

    if (i == 0) {
        i = 1;
    } else if (i == 1) {
        i = 2;
    } else {
        i = 3;
    }

    while i < 10 {
        i += 1;
    }

    loop {
        i += 1;
        if (i > 20) break;
    }

    for j in 0 .. 10 {
        i += j;
    }

    for j in [1, 2, 3] {
        i += j;
    }

    let arr = [1, 2, 3];
    for j, v in arr {
        i += cast!{i32} (j) + v;
    }

    if let Ok (x) = opt (i) {
        i = x;
    }

    let mut count = 0;
    while let Ok (z) = opt (count) && z < 5 {
        count += 1;
    }

    let b: &Base = copy Derived (12);
    match b {
        d: &Derived => { i += d.v; }
        _ => { i = 0; }
    }

    match (1, 2) {
        (1, x: i32) => { i += x; }
        _ => {}
    }

    let _lz_ = lazily (lazy (i + 1));

    let p = &i;
    let _un_ = unsafe {
        *p
    };

    let lock = copy Lock ();
    atomic lock {
        i += 1;
    }

    let _ = {
        mayFail (i)
    } catch {
        _: &AssertError => {
            0
        }
    } failure {
        onFail ();
    } success {
        onSucc ();
    } exit {
        onExit ();
    };
}
