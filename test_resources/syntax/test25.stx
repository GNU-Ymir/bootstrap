in test25;
class X {
    prv let _x : i32 = 0;
    pub self ()
    {
    }
}

@{companion}
mod X{
    pub fn get (x: &(X))-> i32 {
        x._x
    }


}

template Y {T} {
    class Y {
        prv let _y : T;
        pub self (y: T)
            with _y = y
        {
        }
    }

}

@{companion}
mod Y{
    pub template get {T} {
        fn get (y: &(Y!{T}))-> T {
            y._y
        }

    }


}

template Z {T} {
    class Z {
        prv let _z : T;
        pub self (z: T)
            with _z = z
        {
        }
    }

}

template Z {U} {
    @{companion}
    mod Z{
        pub fn get (z: &(Z!{U}))-> U {
            z._z
        }


    }

}

fn main () {
    let _: i32 = X::get (copy X ());
    let _: i32 = Y::get (copy Y!{i32} (1));
    let _: i32 = Z!{i32}::get (copy Z!{i32} (1));
}

