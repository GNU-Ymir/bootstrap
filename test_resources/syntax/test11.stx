in test11;
macro list {
    self (first=__expr others=("," inner=__expr)*)skips (" " | "\n" | "\t")#{    let dmut res = copy [#(first)];
        #(for i in others) {
            res ~= [#(i::inner)];
        }
        res
    }
    fn varDecl (name=__ident "=" value=__literal ";")skips (" " | "\n" | "\t")#{    let __#(name)__ = #(value);
    }

}

fn main () {
    let _a_ = list#{ 1, 2, 3 };
    let _b_ = list#{ 8 };
}

