// a handle is stored in the field of an entity, constructed and assigned with a move
yield gen (n: i32)-> i32 {
    for i in 0 .. n { yield i; }
}

entity Holder {
    pub let mut handle: yield-> i32;

    pub self (h: yield-> i32) with handle = move h {}
}

fn main () {
    let g = gen (3);
    let mut holder = Holder (move g);

    let g2 = gen (2);
    holder.handle = move g2;
    for x in holder.handle {
        let _: i32 = x;
    }
}
