// a local generator passed to an adaptor by value must be moved
yield gen (n: i32)-> i32 {
    for i in 0 .. n { yield i; }
}

yield apply {T of (yield-> U), U} (a: T, f: dg (U)-> U)-> U {
    for x in a { yield f (x); }
}

fn main () {
    let g = gen (3);
    for x in apply (g, |x: i32| => x * 2) {
        let _: i32 = x;
    }
}
