// a generator moved by a branch of a conditional cannot be used after it
yield gen (n: i32)-> i32 {
    for i in 0 .. n { yield i; }
}

fn consume (g: yield-> i32) {
    for x in g {
        let _: i32 = x;
    }
}

fn pick (b: bool) {
    let g = gen (3);
    if b {
        consume (move g);
    }

    for x in g {
        let _: i32 = x;
    }
}

fn main () {
    pick (true);
}
