// a for loop, a yield in and next borrow the generator they resume, which can be resumed
// and moved afterwards
yield gen (n: i32)-> i32 {
    for i in 0 .. n { yield i; }
}

yield twice (a: yield-> i32)-> i32 {
    yield in a;
    yield in a;
}

fn main () {
    let g = gen (3);
    for x in g {
        let _: i32 = x;
    }

    let _: i32? = g.next ();
    for x in g {
        let _: i32 = x;
    }

    let h = move g;
    for x in twice (move h) {
        let _: i32 = x;
    }
}
