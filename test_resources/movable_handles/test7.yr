// a generator comprehension takes its iterated generator, and a for loop over a generator
// of generators owns each of them
yield gen (n: i32)-> i32 {
    for i in 0 .. n { yield i; }
}

fn consume (g: yield-> i32) {
    for x in g {
        let _: i32 = x;
    }
}

fn main () {
    let g = gen (3);
    for x in (yield x * 2 for x in move g) {
        let _: i32 = x;
    }

    let outer = (yield gen (x) for x in 0 .. 3);
    for inner in outer {
        consume (move inner);
    }
}
