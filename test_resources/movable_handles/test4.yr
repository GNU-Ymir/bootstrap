// a handle is returned from a function: a call as is, a local or a parameter moved
yield gen (n: i32)-> i32 {
    for i in 0 .. n { yield i; }
}

fn direct ()-> yield-> i32 {
    gen (2)
}

fn local ()-> yield-> i32 {
    let g = gen (2);
    move g
}

fn pass (g: yield-> i32)-> yield-> i32 {
    move g
}

fn main () {
    for x in pass (direct ()) {
        let _: i32 = x;
    }

    let l = local ();
    for x in pass (move l) {
        let _: i32 = x;
    }
}
