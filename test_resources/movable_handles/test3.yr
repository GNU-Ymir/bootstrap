// await, run and poll borrow the async they resume, a local one stays owned by its variable
async compute (x: i32)-> i32 {
    x + 1
}

async twice ()-> i32 {
    let h = compute (1);
    let a = await h;
    a + 1
}

fn main () {
    let h = twice ();
    let r: i32 = h.run ();

    let p = compute (r);
    loop {
        if let Ok (v) = p.poll (|| => {}) {
            let _: i32 = v;
            break;
        }
    }
}
