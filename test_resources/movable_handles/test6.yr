// a branch does not see what another one moved, and a moved variable holds a value
// again once it is assigned, in a loop included
yield gen (n: i32)-> i32 {
    for i in 0 .. n { yield i; }
}

yield inc (a: yield-> i32)-> i32 {
    for x in a { yield x + 1; }
}

fn consume (g: yield-> i32) {
    for x in g {
        let _: i32 = x;
    }
}

fn pick (b: bool) {
    let g = gen (3);
    if b {
        consume (move g);
    } else {
        for x in g {
            let _: i32 = x;
        }
    }

    let h = gen (3);
    if b {
        consume (move h);
        return;
    }

    consume (move h);
}

fn reassign () {
    let mut g = gen (3);
    consume (move g);
    g = gen (2);
    for _ in 0 .. 3 {
        g = inc (move g);
    }

    consume (move g);
}

fn matched (n: i32) {
    let g = gen (3);
    match n {
        0 => { consume (move g); }
        _ => { for x in g { let _: i32 = x; } }
    }
}

fn main () {
    pick (true);
    reassign ();
    matched (1);
}
