// a local generator is moved into an adaptor whose template parameter is solved to a
// handle, or into a terminal operation, a call creating one is passed as is
yield gen (n: i32)-> i32 {
    for i in 0 .. n { yield i; }
}

yield apply {T of (yield-> U), U} (a: T, f: dg (U)-> U)-> U {
    for x in a { yield f (x); }
}

fn count {T of (yield-> U), U} (a: T)-> usize {
    let mut n = 0us;
    for _ in a { n += 1us; }
    n
}

fn main () {
    let g = gen (3);
    for x in apply (move g, |x: i32| => x * 2) {
        let _: i32 = x;
    }

    for x in apply (gen (3), |x: i32| => x + 1) {
        let _: i32 = x;
    }

    let h = gen (3);
    let _: usize = (move h).count ();
    let _: usize = gen (3).count ();
}
