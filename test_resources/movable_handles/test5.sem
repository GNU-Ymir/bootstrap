frame: test5::gen (n: i32)-> (yield-> i32) {
    {
        let mut #_iter: usize = 0us;
        let #_nb_iters: usize = if (0 > n) 0 else n;
        while (#_iter < #_nb_iters) {
            let mut i: i32 = 0;
            i = cast!{i32}(#_iter);
            {
                yield i
            }
        } step #_iter = (#_iter + 1us)
    }
}
frame: test5::main ()-> void {
    let g: (yield-> i32) = test5::gen (3);
    let mut holder: mut test5::Holder = test5::Holder::self(new, move (g));
    let g2: (yield-> i32) = test5::gen (2);
    holder.handle = move (g2);
    {
        let #_iter: (yield-> i32) = holder.handle;
        let mut #_yielded: mut i32;
        while (#_iter).next(#_yielded) {
            let x: i32 = #_yielded;
            {
                let _: i32 = x;
                <unit-value>
            }
        }
    }
}
frame: test5::Holder::self (mut ref self: mut test5::Holder, h: (yield-> i32))-> void {
    self.handle = move (h);
    <unit-value>
}
