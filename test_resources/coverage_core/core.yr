in core;

/**
 * A plain core function, with a branch to instrument
 */
pub fn coreFn (i: i32)-> i32 {
    if (i > 0) {
        return i;
    }

    return 0;
}

/**
 * A core template, instantiated outside of core: its instantiation is emitted in the module that
 * uses it, but the frame is still declared by core
 */
pub fn coreTemplate {T} (x: T, y: T)-> T {
    if (x == y) {
        return x;
    }

    return y;
}
