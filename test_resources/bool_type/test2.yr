in test2;

// the negation of a bool is a `^ 1`, so true gives 0 and not 0xFE; an integer's stays a bitwise not
class A {
    pub self () {}
}

class B over A {
    pub self () {}
}

fn notBool (b : bool)-> bool {
    !b
}

fn notOf (a : &A)-> bool {
    a !of B
}

fn notInt (x : u8)-> u8 {
    !x
}

fn main () {
    notBool (true);
    notOf (copy A ());
    notInt (1u8);
}
