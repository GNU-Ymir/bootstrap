/*
 * A tag, its global and its parameter, and the tag sites naming it, by its name or by a path.
 */

in test10;

tag a {
    lazy mut COUNT: i32 = 0;
}

mod web {
    pub tag route (path: [c8]) {}
}

#[a, web::route ("/f")]
fn foo ()-> i32 { 1 }

#[a]
class Bar {
    pub self () {}
}

fn main ()-> i32 {
    foo ()
}
