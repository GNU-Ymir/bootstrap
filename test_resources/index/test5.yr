/*
 * A template instantiated implicitly and explicitly, and overloaded functions.
 */

in test5;

fn twice{T} (x: T)-> T {
    x + x
}

fn f (a: i32)-> i32 { a }
fn f (a: bool)-> bool { a }

fn main () {
    let _ = twice (1);
    let _ = twice!{i64} (2i64);
    let _ = f (1);
    let _ = f (true);
}
