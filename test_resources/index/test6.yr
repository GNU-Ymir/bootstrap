/*
 * A recursive function called before its declaration, a captured variable, and enum members.
 */

in test6;

enum Color
| RED = 1
| GREEN = RED + 1
;

fn main ()-> i32 {
    let base = 3;
    let add = copy |y: i32| => base + y;
    fact (add (1))
}

fn fact (n: i32)-> i32 {
    if n <= 1 { 1 } else { n * fact (n - 1) }
}
