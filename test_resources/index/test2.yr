/*
 * The fields and methods of a class, and the class named as a type.
 */

in test2;

class Point {
    pub let x: i32;
    pub let y: i32;

    pub self (x: i32, y: i32) with x = x, y = y {}

    pub fn norm (self)-> i32 {
        self.x * self.x + self.y * self.y
    }
}

fn make ()-> &Point {
    let p: &Point = copy Point (1, 2);
    p.norm ();
    p
}
