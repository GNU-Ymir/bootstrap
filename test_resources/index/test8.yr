/*
 * A declaration of every kind of symbol, templated or not, and the instances of the templates.
 */

in test8;

use CONV = std::conv;

mod inner {
    pub fn add (a: i32, b: i32)-> i32 {
        a + b
    }
}

mod tinner {T} {
    pub fn get (x: T)-> T {
        x
    }
}

def Alias: i32;
def VALUE = 42;
def TAlias {T} : T;

lazy LAZY = 12;

extern (C) {
    static STATIC: i32;
    fn abs (x: i32)-> i32;
}

trait Named {
    pub fn name (self)-> [c8];
}

trait TNamed {T} {
    pub fn tname (self, x: T)-> T {
        x
    }
}

enum Small
| A = 0
| B = 1;

enum TEnum {T}
| C = cast!{T} (0);

record Point {
    pub let x: i32;

    pub self (x: i32) with x = x {}
}

record TPoint {T} {
    pub let x: T;

    pub self (x: T) with x = x {}
}

union U
| Point
| TPoint!{i64};

union TU {T}
| TPoint!{T}
| Point;

class Shape {
    pub let side: i32;

    pub self (side: i32) with side = side {}

    pub self dup (other: &Shape) with side = other.side {}

    pub self tdup {T} (x: T) with side = cast!{i32} (x) {}

    __dtor (mut self) {}

    pub fn area (self)-> i32 {
        self.side * self.side
    }

    pub fn tarea {T} (self, x: T)-> T {
        x
    }

    pub yield gen (self)-> i32 {
        yield 1;
    }

    impl Named {
        pub over name (self)-> [c8] {
            "shape"
        }
    }

    impl TNamed!{i32};
}

class TBox {T} {
    pub let v: T;

    pub self (v: T) with v = v {}

    pub fn get (self)-> T {
        self.v
    }
}

macro list {
    self (first=__expr) skips (" ") #{
        [#(first)]
    }

    fn one (x=__expr) skips (" ") #{
        #(x)
    }
}

fn twice {T} (x: T)-> T {
    x + x
}

yield count ()-> i32 {
    yield 1;
}

__test named {
    assert (LAZY == 12);
}

fn main () {
    let _a_: Alias = VALUE;
    let _b_: TAlias!{i32} = LAZY + inner::add (1, 2) + tinner!{i32}::get (1);
    let _c_ = CONV::to!{[c8]} (VALUE);
    let _d_ = Small::A;
    let _e_ = TEnum!{i32}::C;
    let _f_ = Point (1);
    let _g_ = TPoint!{i32} (1);
    let _h_: U = Point (1);
    let _i_: TU!{i32} = Point (1);
    let s = copy Shape (1);
    let _j_ = copy Shape::dup (s);
    let _k_ = copy Shape::tdup (2.0);
    let _l_ = s.area () + s.tarea (1) + s.tname (2);
    let _m_ = s.name ();
    let _n_ = copy TBox!{i32} (1);
    let _o_ = list#{ 1 };
    let _q_ = twice (1);
    for _ in count () {}
    for _ in s.gen () {}
}
