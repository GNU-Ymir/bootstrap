// a destructor can be @nogc, its frame is then lowered as a @nogc one, and a @nogc function can run it

in test9;

extern (C) fn printf (c: *c8, ...);

entity A {
    @nogc
    pub self () {}

    @nogc
    __dtor (mut self) {
        printf ("dtor\n".ptr);
    }
}

@nogc
pub fn run () {
    let _ = A ();
}
