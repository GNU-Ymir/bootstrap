// a @nogc destructor cannot allocate on the GC heap (the empty .yil golden makes the case reach the lowering stage)

in test10;

extern (C) fn printf (c: *c8, ...);

entity A {
    pub self () {}

    @nogc
    __dtor (mut self) {
        let x = copy [1, 2, 3];
        printf ("%d\n".ptr, cast!{i32} (x.len));
    }
}

pub fn run () {
    let _ = A ();
}
