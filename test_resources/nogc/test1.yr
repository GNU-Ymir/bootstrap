// a @nogc function works on records and raw memory, and calls the @nogc functions and the C functions declared without a body

in test1;

extern (C) fn malloc (size: usize)-> dmut *void;
extern (C) fn free (ptr: *void);

record Span {
    pub let base : usize;
    pub let len : usize;

    @nogc
    pub self (base : usize, len : usize) with base = base, len = len {}

    @nogc
    pub fn end (self)-> usize {
        self.base + self.len
    }
}

@nogc
fn grow (s : Span, n : usize)-> Span {
    Span (s.base, s.len + n)
}

@nogc
pub fn reserve (n : usize)-> usize {
    let s = grow (Span (0us, n), 8us);
    let p = malloc (s.end ());
    free (p);
    s.len
}
