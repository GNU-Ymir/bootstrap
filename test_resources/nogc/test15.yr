// the destructor an entity gets for its fields is @nogc when theirs are, a @nogc function can then run it

in test15;

entity A {
    @nogc
    pub self () {}

    @nogc
    __dtor (mut self) {}
}

entity B {
    let _a : A;

    @nogc
    pub self () with _a = A () {}
}

@nogc
pub fn run () {
    let _ = B ();
}
