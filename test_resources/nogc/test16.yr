// the destructor an entity gets for its fields is not @nogc when one of theirs is not, a @nogc function cannot run it

in test16;

entity A {
    @nogc
    pub self () {}

    __dtor (mut self) {}
}

entity B {
    let _a : A;

    @nogc
    pub self () with _a = A () {}
}

@nogc
pub fn run () {
    let _ = B ();
}
