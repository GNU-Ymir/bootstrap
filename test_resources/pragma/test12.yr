/*
 * Malformed arities of the value producing pragmas.
 */

record X {
    pub let a : i32;

    pub self (a : i32) with a = a {}
}

fn fieldTooFew () {
    let x = X (1);
    let _y_ = __pragma!field (x);
}

fn fieldTooMany () {
    let x = X (1);
    let _y_ = __pragma!field (x, "a", "a");
}

fn fieldInfosTooMany () {
    let _y_ = __pragma!field_infos (X, X);
}

fn hasSuperTooMany () {
    let _y_ = __pragma!has_super (X, X);
}

fn operatorTooFew () {
    let _y_ = __pragma!operator ("+");
}

fn operatorTooMany () {
    let _y_ = __pragma!operator ("+", i32, i32, i32);
}
