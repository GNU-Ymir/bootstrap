/*
 * `__pragma!field` reads the fields of a class, `__pragma!method` its methods:
 * called, addressed as a delegate, as a field method, as a template method inferred by
 * its call, on an aliased object for a mutable method as `:.` does, and on a
 * union, whose meta-fields are fields.
 */

in test31;

class Counter {
    pub let mut count: i32 = 0;

    pub self () {}

    pub fn get (self)-> i32 { self.count }

    pub fn incr (mut self) { self.count += 1; }

    pub fn add (mut self, n: i32) { self.count += n; }

    @field
    pub fn twice (self)-> i32 { self.count * 2 }

    pub fn same {T} (self, x: T)-> T { x }
}

record A {
    pub self () {}

    pub fn name (self)-> [c8] { "a" }
}

record B {
    pub self () {}

    pub fn name (self)-> [c8] { "b" }
}

union AB
| A
| B;

fn main () {
    let dmut c = copy Counter ();
    __pragma!method (alias c, "incr") ();
    __pragma!method (alias c, "add") (2);

    let getter = &__pragma!method (c, "get");
    let adder = &__pragma!method (alias c, "add");
    adder (3);

    let _values_ = (__pragma!field (c, "count"), __pragma!method (c, "get") (), getter (), __pragma!method (c, "twice"), __pragma!method (c, "same") (1u8));

    let u: AB = A ();
    let _union_ = (__pragma!method (u, "name") (), __pragma!field (u, "typeid"));
}
