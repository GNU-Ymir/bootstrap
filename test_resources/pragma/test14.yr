/*
 * The ancestor pragmas only accept classes, and `super` needs the class to
 * actually have an ancestor.
 */

class A {
    pub self () {}
}

fn noSuperClass ()-> __pragma!super (&A) {
    12
}

fn superNotAClass ()-> __pragma!super (i32) {
    12
}

fn rootSuperNotAClass ()-> __pragma!root_super ([c8]) {
    12
}

fn hasSuperNotAClass () {
    let _x_ = __pragma!has_super (f64);
}

// a class name without the `&` is an incomplete type, and says so
fn superMissingRef ()-> __pragma!super (A) {
    12
}

fn rootSuperMissingRef ()-> __pragma!root_super (A) {
    12
}

fn hasSuperMissingRef () {
    let _x_ = __pragma!has_super (A);
}
