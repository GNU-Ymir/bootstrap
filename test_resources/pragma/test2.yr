/*
 * __pragma!operator : is an operator valid for the given operand types ?
 * Two forms, unary(op, T) and binary(op, T1, T2). Never emits a diagnostic,
 * the answer is the boolean.
 */

class A {
    pub self () {}

    pub fn opBinary {"+"} (self, other : &A)-> &A {
        other
    }
}

class B {
    pub self () {}
}

fn main () {
    // binary, native types
    cte assert (__pragma!operator ("+", i32, i32));
    cte assert (!__pragma!operator ("+", i32, f64)); // no implicit promotion between int and float
    cte assert (__pragma!operator ("<", i32, i32));
    cte assert (__pragma!operator ("~", [i32], [i32]));
    cte assert (!__pragma!operator ("+", i32, [c8]));
    cte assert (!__pragma!operator ("/", bool, bool));

    // unary
    cte assert (__pragma!operator ("-", i32));
    cte assert (__pragma!operator ("!", bool));
    cte assert (!__pragma!operator ("-", bool));

    // operator overloading is taken into account
    cte assert (__pragma!operator ("+", &A, &A));
    cte assert (!__pragma!operator ("+", &B, &B));
    cte assert (!__pragma!operator ("-", &A, &A));
}
