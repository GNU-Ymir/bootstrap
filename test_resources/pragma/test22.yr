/*
 * __pragma!vtable takes a single class type, neither a type that is not a
 * class nor a trait.
 */

trait Tr {}

class A {
    pub self () {}
}

fn notAClass () {
    let _i_ = __pragma!vtable (i32);
    let _t_ = __pragma!vtable (Tr);
}

fn malformed () {
    let _m_ = __pragma!vtable (&A, &A);
}
