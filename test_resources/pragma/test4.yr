/*
 * __pragma!field (value, "name") : access a field whose name is known only at
 * compile time. The object is enum unwrapped first, and a delegate exposes its
 * two implementation fields `func` and `closure`.
 */

mod A {
    pub fn foo () {}
}

record X {
    pub let a : i32;
    pub let b : [c8];

    pub self (a : i32, b : [c8]) with a = a, b = b {}
}

enum XEnum : X
| VAL = X (12, "b");

fn main () {
    let x = X (1, "str");

    // the field is selected by a compile time string
    cte assert (__pragma!compile ({ let _v_ : i32 = __pragma!field (x, "a"); }));
    cte assert (__pragma!compile ({ let _v_ : [c8] = __pragma!field (x, "b"); }));

    // the type of the field is the type of the access
    cte assert (!__pragma!compile ({ let _v_ : [c8] = __pragma!field (x, "a"); }));

    // unknown field
    cte assert (!__pragma!compile ({ __pragma!field (x, "c") }));

    // the object is unwrapped from its enum proxy
    cte assert (__pragma!compile ({ let _v_ : i32 = __pragma!field (XEnum::VAL, "a"); }));

    // delegates expose func/closure
    let d : dg ()-> void = &A::foo;
    cte assert (__pragma!compile ({ __pragma!field (d, "func") }));
    cte assert (__pragma!compile ({ __pragma!field (d, "closure") }));
    cte assert (!__pragma!compile ({ __pragma!field (d, "not_a_field") }));
}
