/*
 * __pragma!decl : the class, record, entity or trait the pragma is written in,
 * and __pragma!function inside a method and a constructor.
 */

class Foo {
    pub self () {
        cte assert (__pragma!decl () == "test17::Foo");
        cte assert (__pragma!function () == "test17::Foo::self");
    }

    pub fn method (self) {
        cte assert (__pragma!decl () == "test17::Foo");
        cte assert (__pragma!function () == "test17::Foo::method");
    }
}

record Rec {
    pub let a : i32;

    pub self (a : i32) with a = a {}

    pub fn name (self)-> [c8] {
        cte assert (__pragma!decl () == "test17::Rec");
        __pragma!decl ()
    }
}

trait Named {
    pub fn declName (self)-> [c8] {
        cte assert (__pragma!decl () == "test17::Named");
        __pragma!decl ()
    }
}

class Impl {
    pub self () {}

    impl Named;
}
