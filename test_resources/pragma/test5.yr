/*
 * __pragma!field_infos (T) : the list of the fields of a class, a struct or a
 * tuple; the same value as the `T::field_infos` path.
 *
 * A pragma is an operand like any other, `.` and `[` apply to its result.
 */

record X {
    pub let a : i32;
    pub let b : [c8];

    pub self (a : i32, b : [c8]) with a = a, b = b {}
}

class A {
    pub let x : i32 = 0;
    pub let y : f64 = 0.0;

    pub self () {}
}

fn main () {
    cte assert (__pragma!field_infos (X).len == 2us);
    cte assert (__pragma!field_infos (X) [0].name == "a");
    cte assert (__pragma!field_infos (X) [1].name == "b");

    cte assert (__pragma!field_infos (&A).len == 2us);
    cte assert (__pragma!field_infos (&A) [0].name == "x");

    cte assert (__pragma!field_infos ((i32, [c8], f64)).len == 3us);

    // types with no field
    cte assert (!__pragma!compile ({ __pragma!field_infos (i32) }));
}
