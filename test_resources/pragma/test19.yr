/*
 * __pragma!vtable (C) : the address of the vtable of a class, written &C or C,
 * unwrapped from an enum proxy, from a template, a class template, and the self
 * overload of a tag, which receives the class merged.
 */

class A {
    pub self () {}

    pub fn id (self)-> i32 { 1 }
}

class B over A {
    pub self () with super () {}

    pub over id (self)-> i32 { 2 }
}

class T {X} {
    pub let x : X;

    pub self (x : X) with x = x {}
}

enum BE : &B
| VAL = copy B ();

lazy mut VTABLES : [*void] = [];

tag registered {
    pub self {class C} () {
        VTABLES ~= [__pragma!vtable (C)];
    }
}

#[registered]
class R {
    pub self () {}
}

fn vtableOf {class C} ()-> *void {
    __pragma!vtable (C)
}

fn main () {
    let a : *void = __pragma!vtable (&A);
    let b : *void = __pragma!vtable (B);
    let e : *void = __pragma!vtable (BE);
    let t : *void = __pragma!vtable (&T!{i32});
    let c : *void = vtableOf!{&A} ();

    let _same_ = (a == c, b == e, a != b, t != a);
}
