/*
 * __pragma!super (T) : the direct ancestor of the class T, as a type.
 */

class A {
    pub self () {}
}

class B over A {
    pub self () {}
}

class C over B {
    pub self () {}
}

enum CE : &C
| VAL = copy C ();

fn main () {
    // `U of X` is a subtyping check, so it only says the ancestor is a &B or
    // below; the assignments below pin it to exactly &B
    cte assert (template!{__pragma!super (&C)}{U of &B});
    cte assert (template!{__pragma!super (&B)}{U of &A});

    // a &B is assignable to it : it is not a strict subclass of B
    cte assert (__pragma!compile ({ let _x_ : __pragma!super (&C) = copy B (); }));

    // an ancestor of B is not : it is not &A either
    cte assert (!__pragma!compile ({ let _x_ : __pragma!super (&C) = copy A (); }));

    // the type is unwrapped from its enum proxy first
    cte assert (template!{__pragma!super (CE)}{U of &B});

    // usable as any other type
    cte assert (__pragma!compile ({ let _x_ : __pragma!super (&C) = copy C (); }));
}
