/*
 * __pragma!is_function is false, and never throws, for what is not a
 * function: a class, a record, an enum, a scalar, a slice, a tuple, a class
 * template, and a value of a type that is not callable.
 */

in test24;

class A {
    pub self () {}
}

record R {}

enum Color
| RED = 0
| GREEN = 1;

class B {T} {
    pub self () {}
}

fn ofType {T} ()-> bool {
    __pragma!is_function (T)
}

fn main () {
    cte assert (!__pragma!is_function (A));
    cte assert (!__pragma!is_function (&A));
    cte assert (!__pragma!is_function (R));
    cte assert (!__pragma!is_function (Color));
    cte assert (!__pragma!is_function (Color::RED));
    cte assert (!__pragma!is_function (i32));
    cte assert (!__pragma!is_function ([c8]));
    cte assert (!__pragma!is_function ((i32, f64)));
    cte assert (!__pragma!is_function (B));
    cte assert (!__pragma!is_function (1));
    cte assert (!__pragma!is_function ("foo"));

    let a = copy A ();
    cte assert (!__pragma!is_function (a));

    let t = (1, 2.0);
    cte assert (!__pragma!is_function (t));

    cte assert (!ofType!{i32} ());
    cte assert (!ofType!{&A} ());
}
