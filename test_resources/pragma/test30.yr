/*
 * The function reflection pragmas need a single function whose parameters are
 * known: an overload set, a function template, a lambda whose parameters are
 * untyped and anything that is not callable are rejected.
 */

in test30;

fn over (x: i32)-> i32 { x }
fn over (x: f64)-> f64 { x }

fn tmpl {T} (x: T)-> T { x }

class A {
    pub self () {}
}

fn main () {
    let _a_: __pragma!return_type (over) = 1;
    let _b_: __pragma!return_type (tmpl) = 1;
    let _c_: __pragma!return_type (|x| => x) = 1;
    let _d_: __pragma!return_type (A) = 1;
    let _e_: __pragma!return_type (12) = 1;
    let _f_: __pragma!return_type () = 1;
}
