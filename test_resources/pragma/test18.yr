/*
 * The location pragmas take no argument, and the three walking out to an
 * enclosing symbol report when there is none to reach.
 */

enum NoFunction
| A = __pragma!function ();

fn noDecl () {
    let _a_ = __pragma!decl ();
}

fn withParams () {
    let _b_ = __pragma!file (12);
    let _c_ = __pragma!module (i32);
}
