/*
 * __pragma!msg : print its parameters at compile time, and evaluate to unit.
 * String literals are decoded according to their encoding, anything else is
 * dumped through the generator formatter.
 */

fn main () {
    __pragma!msg ("pragma msg : utf8\n"s8);
    __pragma!msg ("pragma msg : utf16\n"s16);
    __pragma!msg ("pragma msg : utf32\n");
    __pragma!msg ("pragma msg : ", "multiple parameters\n"s8);

    // not a string, formatted as a generator
    __pragma!msg (12);
    __pragma!msg (1 + 2);
}
