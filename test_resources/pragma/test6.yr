/*
 * __pragma!has_super (T) : does the class T declare an ancestor ?
 */

class A {
    pub self () {}
}

class B over A {
    pub self () {}
}

class C over B {
    pub self () {}
}

enum BE : &B
| VAL = copy B ();

// a record is a class type too(a value one), it simply never has an ancestor
record R {
    pub let a : i32;

    pub self (a : i32) with a = a {}
}

fn main () {
    cte assert (!__pragma!has_super (&A));
    cte assert (__pragma!has_super (&B));
    cte assert (__pragma!has_super (&C));

    // the type is unwrapped from its enum proxy first
    cte assert (__pragma!has_super (BE));

    cte assert (!__pragma!has_super (R));
}
