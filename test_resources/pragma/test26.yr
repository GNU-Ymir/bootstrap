/*
 * __pragma!is_function guarding the apply overload of a tag, and inside its
 * body on the function it receives.
 */

in test26;

tag plusOne {
    pub fn if (__pragma!is_function (F)) apply {F: fn (i32)-> i32} (x: i32)-> i32 {
        cte assert (__pragma!is_function (F));
        F (x) + 1
    }
}

#[plusOne]
fn twice (x: i32)-> i32 { x * 2 }

fn main () {
    let _r_: i32 = twice (3);
}
