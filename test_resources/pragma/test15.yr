/*
 * Field errors : unknown names, protections, and out of range tuple indexes.
 */

class A {
    prv let _priv_ : i32 = 0;
    prot let _prot_ : i32 = 0;
    pub let pub_ : i32 = 0;

    pub self () {}
}

fn unknownField ()-> __pragma!field_type (&A, "nope") {
    12
}

fn privateField ()-> __pragma!field_type (&A, "_priv_") {
    12
}

fn protectedField ()-> __pragma!field_type (&A, "_prot_") {
    12
}

fn tupleOverflow ()-> __pragma!field_type ((i32, i32), 2) {
    12
}

fn tupleUnderflow ()-> __pragma!field_type ((i32, i32), -3) {
    12
}

fn noFieldType ()-> __pragma!field_type (i32, "x") {
    12
}

fn noFieldInfos () {
    let _x_ = __pragma!field_infos (i32);
}
