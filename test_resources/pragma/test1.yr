/*
 * __pragma!compile : compile-time probe of an expression or a type.
 * Yields true when every parameter validates(as a value or as a type), false
 * as soon as one of them does not.
 */

record X {
    pub let a : i32;

    pub self (a : i32) with a = a {}
}

fn foo (a : i32)-> i32 { a }

fn main () {
    // values
    cte assert (__pragma!compile ({ 1 + 2 }));
    cte assert (__pragma!compile ({ foo (12) }));
    cte assert (__pragma!compile ({ X (1) }));

    // types
    cte assert (__pragma!compile (i32));
    cte assert (__pragma!compile (X));
    cte assert (__pragma!compile ([i32]));

    // ill formed values
    cte assert (!__pragma!compile ({ __undefined_symbol__ + 1 }));
    cte assert (!__pragma!compile ({ foo ("not an int") }));
    cte assert (!__pragma!compile ({ X (1, 2, 3) }));

    // ill formed types
    cte assert (!__pragma!compile (__undefined_type__));

    // every parameter must compile
    cte assert (__pragma!compile ({ 1 + 2 }, i32, { foo (1) }));
    cte assert (!__pragma!compile ({ 1 + 2 }, __undefined_type__));
}
