/*
 * __pragma!is_function is true for a function, an overload set, a function
 * template, a generator, an async, a lambda, a closure, a delegate on a
 * method, a value of a callable type, a template value bound to a function,
 * and the function pointer, delegate, closure and lambda types, through an
 * enum proxy.
 */

in test23;

fn foo (x: i32)-> i32 { x }

fn over (x: i32)-> i32 { x }
fn over (x: f64)-> f64 { x }

fn tmpl {T} (x: T)-> T { x }

yield gen ()-> i32 {
    yield 1;
}

async later ()-> i32 { 1 }

enum Callbacks : fn (i32)-> i32
| FOO = &foo;

class A {
    pub self () {}

    pub fn method (self)-> i32 { 1 }
}

fn bound {F: fn (i32)-> i32} ()-> i32 {
    cte assert (__pragma!is_function (F));
    F (1)
}

fn ofType {T} ()-> bool {
    __pragma!is_function (T)
}

fn main () {
    cte assert (__pragma!is_function (foo));
    cte assert (__pragma!is_function (over));
    cte assert (__pragma!is_function (tmpl));
    cte assert (__pragma!is_function (gen));
    cte assert (__pragma!is_function (later));
    cte assert (__pragma!is_function (|x| => x + 1));
    cte assert (__pragma!is_function (fn (i32)-> i32));
    cte assert (__pragma!is_function (dg (i32)-> i32));
    cte assert (__pragma!is_function (Callbacks));
    cte assert (__pragma!is_function (Callbacks::FOO));

    let f = &foo;
    cte assert (__pragma!is_function (f));
    cte assert (__pragma!is_function (typeof (f)));

    let k = 2;
    let c = copy |x: i32| => x + k;
    cte assert (__pragma!is_function (c));
    cte assert (__pragma!is_function (typeof (c)));

    let a = copy A ();
    cte assert (__pragma!is_function (&a.method));

    let _b_ = bound!{&foo} ();
    cte assert (ofType!{fn (i32)-> i32} ());
    cte assert (ofType!{dg ()-> void} ());
}
