/*
 * __pragma!parameter_type and __pragma!return_type give the types of the
 * signature of a function, a generator, an async, a method reached through a
 * delegate, a function pointer, a delegate type and an enum of function
 * pointers, by index and by name, and a wrapper forwarding them.
 */

in test28;

fn foo (x: i32, ref mut y: [c8], @z: f64, w: u8 = 1u8)-> bool {
    y = "foo";
    x > 0 && z > 0.0 && w > 0u8
}

fn nothing (_: u16) {}

yield gen (n: u64)-> i32 {
    yield cast!i32 (n);
}

async later (s: [c8])-> u8 {
    cast!u8 (s.len)
}

class A {
    pub self () {}

    pub fn method (self, c: c8)-> i64 {
        if (c == 'a') { 1i64 } else { 2i64 }
    }
}

enum Callbacks : fn (i32, ref mut [c8], f64, u8)-> bool
| FOO = &foo;

fn wrap {F} (f: F, a: __pragma!parameter_type (F, 0us))-> __pragma!return_type (F) {
    f (a)
}

fn alsoNothing ()-> __pragma!return_type (nothing) {}

fn main () {
    let _a_: __pragma!parameter_type (foo, 0us) = 1;
    let _b_: __pragma!parameter_type (foo, "y") = "b";
    let _c_: __pragma!parameter_type (foo, "z") = 2.0;
    let _d_: __pragma!return_type (foo) = true;
    let _e_: __pragma!parameter_type (foo, "w") = 2u8;
    let _f_: __pragma!parameter_type (gen, "n") = 3u64;
    let _g_: __pragma!return_type (gen) = 4;
    let _h_: __pragma!parameter_type (later, 0us) = "h";
    let _i_: __pragma!return_type (later) = 5u8;

    let x = copy A ();
    let _j_: __pragma!parameter_type (&x.method, "c") = 'j';
    let _k_: __pragma!return_type (&x.method) = 6i64;

    let ptr = &foo;
    let _l_: __pragma!parameter_type (ptr, 1us) = "l";
    let _m_: __pragma!return_type (typeof (ptr)) = false;
    let _n_: __pragma!parameter_type (dg (u32)-> f32, 0us) = 7u32;
    let _o_: __pragma!return_type (dg (u32)-> f32) = 8.0f;
    let _p_: __pragma!parameter_type (Callbacks, 2us) = 9.0;
    let _q_: __pragma!return_type (Callbacks::FOO) = true;

    let _r_: i32 = wrap (|y: i32| => y + 1, 10);
    wrap (&nothing, 11u16);
    alsoNothing ();
}
