/*
 * A single `apply {fn F}` overload tags functions of three arities, calling
 * each through F with as many arguments as __pragma!parameter_infos counts,
 * typed by __pragma!parameter_type.
 */

in test5;

mod .core;

tag command {
    pub fn apply {fn F} (args: [i64])-> __pragma!return_type (F) {
        cte if (__pragma!parameter_infos (F).len == 0us) {
            let _n_ = args.len;
            F ()
        } else cte if (__pragma!parameter_infos (F).len == 1us) {
            F (cast!{__pragma!parameter_type (F, 0us)} (args[0]))
        } else {
            F (cast!{__pragma!parameter_type (F, 0us)} (args[0]),
               cast!{__pragma!parameter_type (F, 1us)} (args[1]))
        }
    }
}

#[command]
fn zero ()-> i32 { 0 }

#[command]
fn one (a: i32)-> i32 { a }

#[command]
fn two (a: i8, b: u16)-> u64 { cast!u64 (a) + cast!u64 (b) }

fn main () {
    let args: [i64] = copy [1i64, 2i64];
    let _a_: i32 = zero (args);
    let _b_: i32 = one (args);
    let _c_: u64 = two (args);
}
