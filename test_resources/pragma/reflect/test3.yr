/*
 * __pragma!function_infos describes the kind, the attributes and the arity of
 * a function, a generator, an async, a throwing function, a method, a C
 * variadic function, a lambda and a function pointer, and selects code with
 * a cte if on the kind.
 */

in test3;

mod .core;

class Err over core::exception::Exception {
    pub self () {}
}

@unsafe
fn raw (x: *i32)-> i32 { *x }

@inline
fn fast ()-> i32 { 1 }

fn failing (x: i32)-> i32
    throws Err
{
    if (x == 0) throw copy Err ();
    x
}

yield gen ()-> i32 {
    yield 1;
}

async later ()-> i32 { 2 }

extern (C) fn printf (format: *c8, ...)-> i32;

class A {
    pub self () {}

    pub fn method (self, a: i32, b: i32)-> i32 { a + b }
}

fn kindOf {F: fn ()-> i32} ()-> i32 {
    cte if (__pragma!function_infos (F).kind == "fn") {
        F ()
    } else {
        0
    }
}

fn main () {
    cte assert (__pragma!function_infos (raw).name == "test3::raw");
    cte assert (__pragma!function_infos (raw).kind == "fn");
    cte assert (__pragma!function_infos (raw).isUnsafe);
    cte assert (!__pragma!function_infos (raw).isInline);
    cte assert (__pragma!function_infos (raw).arity == 1us);
    cte assert (__pragma!function_infos (fast).isInline);
    cte assert (__pragma!function_infos (fast).arity == 0us);
    cte assert (__pragma!function_infos (failing).isThrowing);
    cte assert (!__pragma!function_infos (raw).isThrowing);
    cte assert (__pragma!function_infos (gen).kind == "yield");
    cte assert (__pragma!function_infos (later).kind == "async");
    cte assert (__pragma!function_infos (printf).isCVariadic);
    cte assert (__pragma!function_infos (printf).arity == 1us);

    let a = copy A ();
    cte assert (__pragma!function_infos (&a.method).isMethod);
    cte assert (__pragma!function_infos (&a.method).name == "test3::A::method");
    cte assert (__pragma!function_infos (&a.method).arity == 2us);
    cte assert (!__pragma!function_infos (raw).isMethod);

    cte assert (__pragma!function_infos (|x: i32| => x).name == "");
    cte assert (__pragma!function_infos (&fast).name == "test3::fast");

    let ptr = &fast;
    cte assert (__pragma!function_infos (ptr).name == "");
    cte assert (__pragma!function_infos (ptr).kind == "fn");
    cte assert (__pragma!function_infos (ptr).arity == 0us);
    cte assert (!__pragma!function_infos (ptr).isInline);

    let info = __pragma!function_infos (gen);
    let _i_ = info;
    let _k_: i32 = kindOf!{&fast} ();
}
