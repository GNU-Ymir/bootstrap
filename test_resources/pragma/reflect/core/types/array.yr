/*
 * The slice comparison of midgard's core::types::array, the names of the
 * reflected parameters being compared at compile time.
 */

in array;

pub fn opEquals (a: [c8], b: [c8])-> bool {
    if a.len != b.len {
        return false;
    }

    for i in 0us .. a.len {
        if (a[i] != b[i]) return false;
    }

    true
}
