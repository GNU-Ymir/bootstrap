/*
 * midgard's core::types::info, with the records the function reflection
 * pragmas fold to.
 */

in info;

/**
 * This module list all the possible type info, and the system to compare type at runtime
 */


pub enum TypeIDs: u32
| ARRAY        = 1u32
| BOOL         = 2u32
| CHAR         = 3u32
| CLOSURE      = 4u32
| FLOAT        = 5u32
| FUNC_PTR     = 6u32
| SIGNED_INT   = 7u32
| UNSIGNED_INT = 8u32
| POINTER      = 9u32
| SLICE        = 10u32
| STRUCT       = 11u32
| TUPLE        = 12u32
| OBJECT       = 13u32
| VOID         = 14u32
| MAP          = 15u32
| UNION_RECORD = 16u32
| UNION_CLASS  = 17u32;


extern (C) fn _yrt_type_equals(a: TypeInfo, b: TypeInfo)-> bool;

pub record FieldInfo {
    pub let name: [c8];
    pub let offset: usize;
    pub let size: usize;

    pub self (name: [c8], offset: usize, size: usize)
        with name = name
        , offset = offset
        , size = size
    {}
}

pub record TypeInfo {
    pub let typeid: u32;
    pub let size: usize;
    pub let inner: [TypeInfo];
    pub let name: [c8];

    pub self (typeid: u32, size: usize, inner: [TypeInfo], name: [c8])
        with typeid = typeid
        , size = size
        , inner = inner
        , name = name
    {}

    /**
     * @returns: true iif `left` is the same type as `right`.
     */
    pub fn opEquals(self, right: TypeInfo)-> bool {
        _yrt_type_equals(self, right)
    }
}

pub record ParamInfo {
    pub let name: [c8];
    pub let isMutable: bool;
    pub let isRef: bool;
    pub let isLazy: bool;
    pub let isNamed: bool;
    pub let hasDefault: bool;

    pub self (name: [c8], isMutable: bool, isRef: bool, isLazy: bool, isNamed: bool, hasDefault: bool)
        with name = name
        , isMutable = isMutable
        , isRef = isRef
        , isLazy = isLazy
        , isNamed = isNamed
        , hasDefault = hasDefault
    {}
}

pub record FunctionInfo {
    pub let name: [c8];
    pub let kind: [c8];
    pub let isUnsafe: bool;
    pub let isInline: bool;
    pub let isCVariadic: bool;
    pub let isThrowing: bool;
    pub let isMethod: bool;
    pub let arity: usize;

    pub self (name: [c8], kind: [c8], isUnsafe: bool, isInline: bool, isCVariadic: bool, isThrowing: bool, isMethod: bool, arity: usize)
        with name = name
        , kind = kind
        , isUnsafe = isUnsafe
        , isInline = isInline
        , isCVariadic = isCVariadic
        , isThrowing = isThrowing
        , isMethod = isMethod
        , arity = arity
    {}
}
