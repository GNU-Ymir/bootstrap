/*
 * __pragma!function_infos takes a single function whose parameters are known,
 * and exactly one parameter.
 */

in test4;

mod .core;

fn over (x: i32)-> i32 { x }
fn over (x: f64)-> f64 { x }

fn tmpl {T} (x: T)-> T { x }

fn main () {
    let _a_ = __pragma!function_infos (over);
    let _b_ = __pragma!function_infos (tmpl);
    let _c_ = __pragma!function_infos (12);
    let _d_ = __pragma!function_infos ();
}
