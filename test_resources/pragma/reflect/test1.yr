/*
 * __pragma!parameter_infos describes every kind of parameter of a function, a
 * generator, an async, a method reached through a delegate and a lambda, the
 * nameless ones of a function pointer, a delegate type and an enum proxy, the
 * number of parameters being a template argument and the names unrolled by a
 * cte for.
 */

in test1;

mod .core;

fn foo (x: i32, mut y: [mut i32], ref z: i32, lazy w: i32, @n: i32, d: i32 = 1)-> i32 {
    y[0] = z;
    x + w + n + d
}

yield gen (a: i32, b: i32)-> i32 {
    yield a + b;
}

async later (s: [c8])-> usize {
    s.len
}

class A {
    pub self () {}

    pub fn method (self, c: c8)-> c8 { c }
}

enum Callbacks : fn (ref i32, lazy i32)-> i32
| FOO = &bar;

fn bar (ref a: i32, lazy b: i32)-> i32 { a + b }

fn arity {N: usize} ()-> usize { N }

fn sum (left: i32, right: i32)-> i32 { left + right }

fn names {F: fn (i32, i32)-> i32} ()-> [c8] {
    let mut result = "";
    cte for i in 0us .. __pragma!parameter_infos (F).len {
        result = result ~ cte { __pragma!parameter_infos (F)[i].name } ~ ";";
    }
    result
}

fn main () {
    let infos = __pragma!parameter_infos (foo);
    cte assert (__pragma!parameter_infos (foo).len == 6us);
    cte assert (__pragma!parameter_infos (foo)[0].name == "x");
    cte assert (!__pragma!parameter_infos (foo)[0].isMutable);
    cte assert (__pragma!parameter_infos (foo)[1].isMutable);
    cte assert (__pragma!parameter_infos (foo)[2].isRef);
    cte assert (__pragma!parameter_infos (foo)[3].isLazy);
    cte assert (__pragma!parameter_infos (foo)[4].isNamed);
    cte assert (__pragma!parameter_infos (foo)[5].hasDefault);
    cte assert (!__pragma!parameter_infos (foo)[5].isNamed);

    cte assert (__pragma!parameter_infos (gen)[1].name == "b");
    cte assert (__pragma!parameter_infos (later)[0].name == "s");

    let a = copy A ();
    cte assert (__pragma!parameter_infos (&a.method).len == 1us);
    cte assert (__pragma!parameter_infos (&a.method)[0].name == "c");

    cte assert (__pragma!parameter_infos (|k: i32| => k + 1)[0].name == "k");
    cte assert (__pragma!parameter_infos (&bar)[0].name == "a");

    let ptr = &bar;
    cte assert (__pragma!parameter_infos (ptr)[0].name == "");
    cte assert (__pragma!parameter_infos (ptr)[0].isRef);
    cte assert (__pragma!parameter_infos (ptr)[1].isLazy);
    cte assert (__pragma!parameter_infos (dg (i32, f64)-> void).len == 2us);
    cte assert (__pragma!parameter_infos (Callbacks)[0].isRef);
    cte assert (__pragma!parameter_infos (Callbacks::FOO)[1].isLazy);

    let _n_: usize = arity!{__pragma!parameter_infos (foo).len} ();
    let _s_: [c8] = names!{&sum} ();
    let _u_ = infos;
}
