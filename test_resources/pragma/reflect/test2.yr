/*
 * __pragma!parameter_infos takes a single function whose parameters are
 * known, and exactly one parameter.
 */

in test2;

mod .core;

fn over (x: i32)-> i32 { x }
fn over (x: f64)-> f64 { x }

fn tmpl {T} (x: T)-> T { x }

record R {}

fn main () {
    let _a_ = __pragma!parameter_infos (over);
    let _b_ = __pragma!parameter_infos (tmpl);
    let _c_ = __pragma!parameter_infos (R);
    let _d_ = __pragma!parameter_infos (tmpl, over);
}
