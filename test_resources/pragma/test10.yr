/*
 * __pragma!field_type (T, x) : the type of a field of a class(x being its name)
 * or of a tuple(x being its index, possibly negative to count from the end).
 */

class A {
    pub let x : i32 = 0;
    pub let y : [c8] = "";

    pub self () {}
}

fn main () {
    // classes, by name
    cte assert (template!{__pragma!field_type (&A, "x")}{U of i32});
    cte assert (template!{__pragma!field_type (&A, "y")}{U of [c8]});
    cte assert (!template!{__pragma!field_type (&A, "x")}{U of [c8]});

    // tuples, by index
    cte assert (template!{__pragma!field_type ((i32, [c8], f64), 0)}{U of i32});
    cte assert (template!{__pragma!field_type ((i32, [c8], f64), 1)}{U of [c8]});

    // negative indexes count from the end
    cte assert (template!{__pragma!field_type ((i32, [c8], f64), -1)}{U of f64});
    cte assert (template!{__pragma!field_type ((i32, [c8], f64), -3)}{U of i32});
}
