/*
 * __pragma!unproxied (T) : the type hidden behind an enumeration proxy, going
 * down every level; any other type is returned unchanged.
 */

record R {
    pub let a : i32;

    pub self (a : i32) with a = a {}
}

enum E
| A = 1;

enum E2 : E
| B = E::A;

enum ER : R
| C = R (12);

fn main () {
    cte assert (template!{__pragma!unproxied (E)}{U of i32});

    // every level of proxy is unwrapped
    cte assert (template!{__pragma!unproxied (E2)}{U of i32});
    cte assert (!template!{__pragma!unproxied (E2)}{U of E});

    cte assert (template!{__pragma!unproxied (ER)}{U of R});

    // not an enumeration, unchanged
    cte assert (template!{__pragma!unproxied (i32)}{U of i32});
    cte assert (template!{__pragma!unproxied ([c8])}{U of [c8]});
}
