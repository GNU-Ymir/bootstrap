/*
 * __pragma!file, !line, !module and !function : the place the pragma is written
 * in, each folding to a constant at validation time.
 */

fn main () {
    cte assert (__pragma!file () == "test_resources/pragma/test16.yr");
    cte assert (__pragma!line () == 8u64);
    cte assert (__pragma!module () == "test16");
    cte assert (__pragma!function () == "test16::main");
}

fn inBlock () {
    {
        cte assert (__pragma!function () == "test16::inBlock");
        cte assert (__pragma!line () == 16u64);
    }
}

fn identity {T} (x : T)-> T {
    cte assert (__pragma!module () == "test16");
    cte assert (__pragma!function () == "test16::identity!{i32}::identity");
    x
}

fn callIdentity () {
    let _ = identity (12);
}
