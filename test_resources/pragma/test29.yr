/*
 * __pragma!parameter_type selects an existing parameter: an index out of
 * bounds, a negative one, and an unknown name are rejected, the parameters of
 * a callable type having no name.
 */

in test29;

fn foo (x: i32, y: [c8])-> i32 {
    x + cast!i32 (y.len)
}

fn main () {
    let _a_: __pragma!parameter_type (foo, 2us) = 1;
    let _b_: __pragma!parameter_type (foo, -1) = 1;
    let _c_: __pragma!parameter_type (foo, "z") = 1;
    let _d_: __pragma!parameter_type (fn (i32)-> i32, "x") = 1;
    let _e_: __pragma!parameter_type (foo) = 1;
}
