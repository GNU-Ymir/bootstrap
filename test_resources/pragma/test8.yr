/*
 * __pragma!root_super (T) : the topmost ancestor of the class T; T itself when
 * it has no ancestor at all.
 */

class A {
    pub self () {}
}

class B over A {
    pub self () {}
}

class C over B {
    pub self () {}
}

enum CE : &C
| VAL = copy C ();

fn main () {
    // `U of X` is a subtyping check, so the assignment below is what pins the
    // root to exactly &A : only &A accepts a plain A
    cte assert (template!{__pragma!root_super (&C)}{U of &A});
    cte assert (template!{__pragma!root_super (&B)}{U of &A});
    cte assert (__pragma!compile ({ let _x_ : __pragma!root_super (&C) = copy A (); }));

    // a class with no ancestor is its own root
    cte assert (template!{__pragma!root_super (&A)}{U of &A});
    cte assert (__pragma!compile ({ let _x_ : __pragma!root_super (&A) = copy A (); }));

    // the type is unwrapped from its enum proxy first
    cte assert (template!{__pragma!root_super (CE)}{U of &A});
    cte assert (__pragma!compile ({ let _x_ : __pragma!root_super (CE) = copy A (); }));
}
