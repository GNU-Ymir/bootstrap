/*
 * __pragma!is_function as the test of a template selects between two
 * overloads, the one taking a function returning an i32, the other a [c8].
 */

in test25;

fn foo (x: i32)-> i32 { x }

fn if (__pragma!is_function (F)) describe {F} (_: F)-> i32 {
    1
}

fn if (!__pragma!is_function (F)) describe {F} (_: F)-> [c8] {
    "not a function"
}

fn main () {
    let k = 3;
    let _a_: i32 = describe (&foo);
    let _b_: i32 = describe (|x: i32| => x * 2);
    let _c_: i32 = describe (copy |x: i32| => x + k);
    let _d_: [c8] = describe (1);
    let _e_: [c8] = describe ("foo");
}
