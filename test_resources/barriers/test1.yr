// a store of a class reference into a field of an object is preceded by its write barrier, except in a @nogc function

in test1;

class Inner {
    pub self () {}
}

class Box {
    pub let mut value : &Inner;

    pub self (v : &Inner) with value = v {}

    pub fn set (mut self, v : &Inner) {
        self.value = v;
    }

    @nogc
    pub fn setNoGC (mut self, v : &Inner) {
        self.value = v;
    }
}
