// a store into a local of the frame, or of a value holding no pointer, needs no write barrier

in test3;

class Counter {
    pub let mut n : i32;

    pub self () with n = 0 {}

    pub fn incr (mut self) {
        self.n = self.n + 1;
    }
}

pub fn pick (a : [i32], b : [i32], first : bool)-> [i32] {
    let mut x = a;
    if (!first) {
        x = b;
    }

    x
}
