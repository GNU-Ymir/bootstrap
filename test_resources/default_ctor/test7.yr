// The generated ctor calls the ctor of the ancestor with no argument, so a class
// whose ancestor has no such ctor cannot ask for it.
class Base {
    pub let b: i32;
    pub self (b: i32) with b = b {}
}

class Foo over Base {
   pub let x: i32;
   pub self;
}

fn main () {
    let a = copy Foo (1);
    a.x;
}
