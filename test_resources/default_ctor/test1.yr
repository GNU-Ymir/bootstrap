// The ctor generated from the fields of a class: every public field is a
// parameter, in declaration order, and a field carrying a value gives its
// parameter a default value.
class Foo {
   pub {
     let x: i32;
     let mut y: i32;
     let mut z: i32 = 98;
   }

   pub self;
}

fn main () {
    let a = copy Foo (1, 2);
    let b = copy Foo (y-> 2, 1, z-> 3);
    a.x; b.y;
}
