// A `self;` sets a field borrowing mutable data from its parameter by an alias,
// as a ctor written by hand has to.
class Foo {
    pub self () {}
}

class Bar {
    pub let dmut foo: &Foo;
    pub let dmut values: [i32];

    pub self;
}

fn main () {
    let dmut f = copy Foo ();
    let dmut v = copy [1, 2, 3];
    let b = copy Bar (alias f, alias v);
    b.foo; b.values;
}
