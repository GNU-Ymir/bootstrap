// a method called on a @final class is direct, whatever its ancestors: the instance
// is always of that very class. One called on an instance the frame allocated is
// direct at -O1, even through a variable of an ancestor type
class A {
    pub self () {}
    pub fn foo (self)-> i32 { 1 }
    pub fn bar (self)-> i32 { 2 }
}

@final
class B over A {
    pub self () {}
    pub over foo (self)-> i32 { 3 }
}

fn onFinal (b : &B)-> i32 {
    b.foo () + b.bar ()
}

fn onBase (a : &A)-> i32 {
    a.foo ()
}

fn main () {
    let a : &A = copy B ();
    let _x_ = a.foo () + onFinal (copy B ()) + onBase (a);
}
