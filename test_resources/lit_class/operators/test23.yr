class A {
    let mut _i : i32 = 0;

    pub self () {}

    pub fn opIndex (mut self, i : i32)-> i32 {
        self._i + i
    }

    pub fn opIndexAssign (mut self, i : i32, x : i32) {
        self._i = i + x;
    }

}

fn main () {
    let dmut a = copy A ();

    // read position, the alias operator is still valid there
    let _ = a:[0];

    // affect position, the alias is implicit
    a [0] = 1;

    // and thus the alias operator is prohibited
    a:[0] = 1;
    a:[0] += 1;
}
