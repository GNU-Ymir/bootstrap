in test3;

mod ::lib;
mod ::aux;

use test3::lib;

trait Show {
    pub fn show (self)-> i32;
}

class Counter {
    prv let mut _n: i32;

    pub self () with _n = 0 {}

    pub fn inc (mut self) {
        self._n += 1;

    }

    prv fn hidden (self)-> i32 { self._n }

    pub fn get {T} (self)-> T { cast!T (self._n) }

    impl Show {
        pub over show (self)-> i32 { self.hidden () }
    }
}

class Box {T} {
    pub let v: T;
    pub self (v: T) with v = v {}
}

fn id {T} (x: T)-> T { x }

fn main () {
    let dmut c = copy Counter ();
    c:.inc ();
    for i in 0 .. 3 {
        let _ = i;
    }

    let s = id (1) + aux::two () + value () + c.get!{i32} () + c.show ();
    let t = id ("s");
    let _ = (s, t, copy Box!{i32} (s));
}
