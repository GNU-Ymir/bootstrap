in test1;

/**
 * Adds two numbers
 */
fn add (a: i32, b: i32)-> i32 {
    let sum = a + b;
    sum
}

class Point {
    pub let x: i32;
    pub let y: i32;

    pub self (x: i32, y: i32) with x = x, y = y {}

    pub fn norm (self)-> i32 {
        self.x * self.x + self.y * self.y
    }
}

fn main () {
    let p = copy Point (1, 2);
    let total = add (p.x, p.norm ());
    {
        let inner = total;
    }

}
