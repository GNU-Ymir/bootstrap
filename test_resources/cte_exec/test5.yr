// user functions executed at compile time: mutable locals, loops, break and
// continue, recursion, a parameter passed by reference, a function declared after its use
in test5;

fn sumOdd (n: u32)-> u32 {
    let mut s = 0u32;
    for i in 0u32 .. n {
        if (i % 2u32 == 0u32) continue;
        s = s + i;
    }
    s
}

fn firstSquareAbove (n: i32)-> i32 {
    let mut i = 0;
    loop {
        if (i * i > n) break i;
        i = i + 1;
    }
}

fn fact (n: u64)-> u64 {
    if (n <= 1u64) return 1u64;
    n * fact (n - 1u64)
}

fn incr (ref mut x: i32, by: i32) {
    x = x + by;
}

fn twice (x: i32)-> i32 {
    let mut y = x;
    incr (ref y, x);
    y
}

fn arr {N: u64} ()-> u64 {
    N
}

fn main () {
    cte assert (sumOdd (10u32) == 25u32);
    cte assert (firstSquareAbove (50) == 8);
    cte assert (fact (10u64) == 3628800u64);
    cte assert (twice (21) == 42);
    cte assert (later ("abc") == 3us);

    let _ = arr!{fact (5u64)} ();
}

fn later (s: [c8])-> usize {
    let mut n = 0us;
    for _ in s {
        n = n + 1us;
    }
    n
}
