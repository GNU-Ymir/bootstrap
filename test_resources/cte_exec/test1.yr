// the conversions of std::conv from a string to an integer, executed at compile time
in test1;

use std::conv;

fn base {N: i64} ()-> i64 {
    N
}

fn main () {
    cte assert (("12").to!{i32} () == 12);
    cte assert (("-128").to!{i8} () == -128i8);
    cte assert (("255").to!{u8} () == 255u8);
    cte assert (("ff").to!{i64, 16} () == 255i64);
    cte assert (("-0x1F").to!{i32, "x"} () == -31);
    cte assert (("0b101").to!{u32, "b"} () == 5u32);

    let x = cte ("42").to!{u64} ();
    let y = base!{("-7").to!{i64} ()} ();
    let _ = cast!i64 (x) + y;
}
