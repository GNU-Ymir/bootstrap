// a panic of the executed code, and a value the execution cannot compute
in test8;

extern (C) fn rand ()-> i32;

fn at (s: [c8], i: usize)-> c8 {
    s [i]
}

fn random ()-> i32 {
    rand ()
}

fn outOfBounds () {
    cte assert (at ("abc", 5us) == 'a');
}

fn external () {
    cte assert (random () == 4);
}

fn runtime (x: i32) {
    cte assert (x == 4);
}
