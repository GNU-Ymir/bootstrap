// an execution that does not terminate exceeds the limits of the compile-time execution
in test7;

fn forever ()-> i32 {
    let mut i = 0us;
    loop {
        i = i + 1us;
        if (i == 0us) break;
    }
    cast!i32 (i)
}

fn deep (n: i32)-> i32 {
    deep (n + 1)
}

fn loops () {
    cte assert (forever () == 0);
}

fn recurses () {
    cte assert (deep (0) == 0);
}
