frame: test5::sumOdd (n: u32)-> u32 return {
    let mut s: mut u32 = 0u32;
    {
        let mut #_iter: usize = 0us;
        let #_nb_iters: usize = n;
        while (#_iter < #_nb_iters) {
            let mut i: u32 = 0u32;
            i = cast!{u32}(#_iter);
            {
                if ((i % 2u32) == 0u32) continue;
                s = (s + i);
                <unit-value>
            }
        } step #_iter = (#_iter + 1us)
    };
    s
}
