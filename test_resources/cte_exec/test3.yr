// the conversions of std::conv from a string to a float, executed at compile time
in test3;

use std::conv;

fn main () {
    cte assert (("1.5").to!{f64} () == 1.5);
    cte assert (("-0.25").to!{f32} () == -0.25f);
    cte assert (("1e3").to!{f64} () == 1000.0);

    let x = cte ("2.5").to!{f64} ();
    let _ = x;
}
