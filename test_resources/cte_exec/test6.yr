// a catch executed at compile time dispatches on the class of the thrown exception
in test6;

use std::conv;

class Small over core::exception::Exception {
    pub self () {}
}

class Big over core::exception::Exception {
    pub self () {}
}

fn check (x: i32)-> i32
    throws Small, Big
{
    if (x < 0) throw copy Small ();
    if (x > 100) throw copy Big ();
    x
}

fn clamp (x: i32)-> i32 {
    {
        check (x)
    } catch {
        _: &Small => 0
        _: &Big => 100
    }
}

fn parseOr (s: [c8], d: i32)-> i32 {
    {
        s.to!{i32} ()
    } catch {
        _: &CastFailure => d
    }
}

fn main () {
    cte assert (clamp (-5) == 0);
    cte assert (clamp (500) == 100);
    cte assert (clamp (42) == 42);
    cte assert (parseOr ("12", 7) == 12);
    cte assert (parseOr ("nope", 7) == 7);
}
