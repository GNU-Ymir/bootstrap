record A {
    pub let i : i32;

    pub self (i : i32) with i = i {}

    pub fn foo (self, j : i32)-> i32
        throws AssertError
    {
        assert (j > 0);
        self.i + j
    }
}

fn main () {
    let a = A (12);

    // as for '&', the record is enclosed by copy, and the copy has to be explicit
    let f : dg (i32)-> (i32)? = copy &?a.foo;
    f;
}
