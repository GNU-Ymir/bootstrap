fn foo (i : i32)-> i32
    throws AssertError
{
    assert (i > 0);
    i + 1
}

fn main () {
    // '&?' creates a delegate calling 'foo' inside a catcher, where '&' refuses to
    // create a function pointer from a throwing function
    let f : dg (i32)-> (i32)? = &?foo;
    let r : (i32)? = f (12);
    match r {
        Ok (v : i32) => { v; }
        Err (e : &AssertError) => { e; }
        _ => {}
    }
}
