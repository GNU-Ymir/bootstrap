// A default argument is evaluated at each call site that omits it, and never
// shared between two of them, whatever kind of callable declares it: main
// below calls next() once per call, not once per prototype. next() is extern
// so that the interpreter cannot fold the default away.
extern (C) fn next ()-> i32;

record R {
    pub let v: i32;
    pub self (v: i32 = next ()) with v = v {}
    pub fn m (self, v: i32 = next ())-> i32 { v }
}

class C {
    let _v: i32;
    pub self (v: i32 = next ()) with _v = v {}
    pub fn v (self)-> i32 { self._v }
}

fn f (v: i32 = next ())-> i32 { v }

fn main () {
    let a = R ();
    let b = R ();
    let c = (copy C ()).v ();
    let d = (copy C ()).v ();

    let _ = a.v + b.v + a.m () + b.m () + c + d + f () + f ();
}
