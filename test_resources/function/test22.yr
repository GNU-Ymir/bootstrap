// A parameter that declares a default value is passed by name or not at all, so
// it is not a slot a positional argument can land in. The three arity errors
// below are told apart: only the ones with too many positional arguments name
// the defaulted parameter, and none of them compares two equal counts.

fn foo (x : i32, y : i32, z : i32 = 98)-> i32 {
    x + y + z
}

// a defaulted parameter that is not the last one
fn bar (x : i32 = 1, y : i32)-> i32 {
    x + y
}

fn main () {
    // z is defaulted, so 2 positional arguments are expected, not 3
    foo (1, 2, 3);

    // one too many even once z is set by name
    foo (1, 2, 3, z-> 4);

    // x is defaulted, y is not: 1 positional argument is expected
    bar (1, 2);

    // a genuine shortfall: x has no default, and naming z here would point at
    // the wrong parameter
    foo (1);
}
