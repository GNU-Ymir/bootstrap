// A default value still sees the symbols of the module, and the private
// symbols of the class declaring the function.

fn two ()-> i32 { 2 }

class C {
    let _v: i32;
    pub self (v: i32 = two ()) with _v = v {}
    self hidden (v: i32) with _v = v {}

    pub fn add (self, c: &C = copy C::hidden (5))-> i32 { self._v + c._v }
}

fn add (a: i32, b: i32 = two ())-> i32 {
    a + b
}

fn main () {
    let c = copy C ();
    let _ = add (1) + c.add ();
}
