class A {
    pub self () {}

    pub fn foo (self, i : i32)-> i32
        throws AssertError
    {
        assert (i > 0);
        i + 1
    }
}

fn main () {
    let a = copy A ();

    // the method delegate is what the generated delegate encloses, the vtable is read
    // where '&?' is written, not at every call
    let f : dg (i32)-> (i32)? = &?a.foo;
    let r : (i32)? = f (12);
    match r {
        Ok (v : i32) => { v; }
        _ => {}
    }
}
