fn foo (ref mut i : i32, lazy z : i32)-> i32
    throws AssertError
{
    i = z;
    assert (i > 0);
    i
}

fn main () {
    // the generated delegate forwards the reference and lazy parameters of 'foo'
    let f : dg (ref mut i32, lazy i32)-> (i32)? = &?foo;
    let mut a = 0;
    let r : (i32)? = f (ref a, lazy { 12 });
    match r {
        Ok (v : i32) => { v; }
        _ => {}
    }
}
